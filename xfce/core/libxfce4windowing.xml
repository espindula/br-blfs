<sect1 id="libxfce4windowing" xreflabel="libxfce4windowing-&libxfce4windowing-version;">
  <?dbhtml filename="libxfce4windowing.html"?>


  <title>libxfce4windowing-&libxfce4windowing-version;</title>

  <indexterm zone="libxfce4windowing">
    <primary sortas="a-libxfce4windowing">libxfce4windowing</primary>
  </indexterm>

  <sect2 role="package">
    <title>Introdução ao libxfce4windowing</title>

    <para>
      O pacote <application>libxfce4windowing</application> contém uma biblioteca
de abstração de conceito de janelas para X11 e Wayland.
    </para>

    &lfs123_checked;

    <bridgehead renderas="sect3">Informação do Pacote</bridgehead>
    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Transferência (HTTP): <ulink url="&libxfce4windowing-download-http;"/>
        </para>
      </listitem>
      <listitem>
        <para>
          Transferência (FTP): <ulink url="&libxfce4windowing-download-ftp;"/>
        </para>
      </listitem>
      <listitem>
        <para>
          Soma de verificação MD5 da transferência: &libxfce4windowing-md5sum;
        </para>
      </listitem>
      <listitem>
        <para>
          Tamanho da transferência: &libxfce4windowing-size;
        </para>
      </listitem>
      <listitem>
        <para>
          Espaço em disco estimado exigido: &libxfce4windowing-buildsize;
        </para>
      </listitem>
      <listitem>
        <para>
          Tempo de construção estimado: &libxfce4windowing-time;
        </para>
      </listitem>
    </itemizedlist>

    <bridgehead renderas="sect3">Dependências do libxfce4windowing</bridgehead>

    <bridgehead renderas="sect4">Exigidas</bridgehead>
    <para role="required">
      <xref linkend="gtk3"/>, <xref linkend="libdisplay-info"/>, <xref
linkend="libwnck"/> e <xref linkend="xfce4-dev-tools"/>
    </para>

    <bridgehead renderas="sect4">Opcionais</bridgehead>
    <para role="optional">
      <xref linkend="gtk-doc"/>
    </para>

  </sect2>

  <sect2 role="installation">
    <title>Instalação do libxfce4windowing</title>

    <para>
      Instale <application>libxfce4windowing</application> executando os seguintes
comandos:
    </para>

<screen><userinput>./configure --prefix=/usr     \
            --sysconfdir=/etc \
            --enable-x11      \
            --disable-debug   &amp;&amp;
make</userinput></screen>

    <para>
      Esse pacote não vem com uma suíte de teste.
    </para>

    <para>
      Agora, como o(a) usuário(a) <systemitem class="username">root</systemitem>:
    </para>

<screen role="root"><userinput>make install</userinput></screen>

  </sect2>

