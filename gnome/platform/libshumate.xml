<sect1 id="libshumate" xreflabel="libshumate-&libshumate-version;">
  <?dbhtml filename="libshumate.html"?>

  <title>libshumate-&libshumate-version;</title>

  <indexterm zone="libshumate">
    <primary sortas="a-libshumate">libshumate</primary>
  </indexterm>

  <sect2 role="package">
    <title>Introdução ao libshumate</title>

    <para>
      O pacote <application>libshumate</application> contém uma pequena engenhoca
GTK-4 para exibir mapas.
    </para>

    &lfs123_checked;

    <bridgehead renderas="sect3">Informação do Pacote</bridgehead>
    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Transferência (HTTP): <ulink url="&libshumate-download-http;"/>
        </para>
      </listitem>
      <listitem>
        <para>
          Transferência (FTP): <ulink url="&libshumate-download-ftp;"/>
        </para>
      </listitem>
      <listitem>
        <para>
          Soma de verificação MD5 da transferência: &libshumate-md5sum;
        </para>
      </listitem>
      <listitem>
        <para>
          Tamanho da transferência: &libshumate-size;
        </para>
      </listitem>
      <listitem>
        <para>
          Espaço em disco estimado exigido: &libshumate-buildsize;
        </para>
      </listitem>
      <listitem>
        <para>
          Tempo de construção estimado: &libshumate-time;
        </para>
      </listitem>
    </itemizedlist>

    <bridgehead renderas="sect3">Dependências do libshumate</bridgehead>

    <bridgehead renderas="sect4">Exigidas</bridgehead>
    <para role="required">
      <xref linkend="gtk4"/>, <xref linkend="libsoup3"/> e <xref
linkend="protobuf-c"/>
    </para>

    <bridgehead renderas="sect4">Recomendadas</bridgehead>
    <para role="recommended">
      &gobject-introspection; (exigido para gnome-maps)
    </para>

    <bridgehead renderas="sect4">Opcionais</bridgehead>
    <para role="optional">
      <xref linkend="gi-docgen"/>, <xref linkend="valgrind"/> e <ulink
url="&sysprof-url;">sysprof</ulink>
    </para>

  </sect2>

  <sect2 role="installation">
    <title>Instalação do libshumate</title>

    <para>
      Instale o <application>libshumate</application> executando os seguintes
comandos:
    </para>

<screen><userinput>mkdir build &amp;&amp;
cd    build &amp;&amp;

meson setup --prefix=/usr          \
            --buildtype=release    \
            --wrap-mode=nodownload \
            -D gtk_doc=false       \
            ..                     &amp;&amp;
ninja</userinput></screen>

    <para>
      Se você tiver <xref linkend='gi-docgen'/> instalado e desejar construir a
documentação da API para esse pacote, emita:
    </para>

<screen remap='doc'><userinput>sed -e 's/lib_version/version/' \
    -i ../docs/meson.build      &amp;&amp;
meson configure -D gtk_doc=true &amp;&amp;
ninja</userinput></screen>

    <para>
      Para testar os resultados, emita: <command>ninja test</command>.
    </para>



    <!--
    <para>

      The test suite requires this package to be built with special options.
      If you wish to run the tests, follow the instructions after installation.
    </para>
-->
<para>
      Agora, como o(a) usuário(a) <systemitem class="username">root</systemitem>:
    </para>

<!--
    <para>

      If you wish to run the tests, issue:
    </para>

<screen><userinput>meson configure - -buildtype=debug &amp;&amp;
ninja test</userinput></screen>
-->
<screen role="root"><userinput>ninja install</userinput></screen>



  </sect2>

