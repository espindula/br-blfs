<sect1 id="gnome-connections" xreflabel="gnome-connections-&gnome-connections-version;">
  <?dbhtml filename="gnome-connections.html"?>

  <title>gnome-connections-&gnome-connections-version;</title>

  <indexterm zone="gnome-connections">
    <primary sortas="a-gnome-connections">gnome-connections</primary>
  </indexterm>

  <sect2 role="package">
    <title>Introdução ao gnome-connections</title>

    <para>
      <application>gnome-connections</application> é um cliente VNC e RDP para
área de trabalho do <application>GNOME</application>.
    </para>

    &lfs124_checked;

    <bridgehead renderas="sect3">Informação do Pacote</bridgehead>
    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Transferência (HTTP): <ulink url="&gnome-connections-download-http;"/>
        </para>
      </listitem>
      <listitem>
        <para>
          Transferência (FTP): <ulink url="&gnome-connections-download-ftp;"/>
        </para>
      </listitem>
      <listitem>
        <para>
          Soma de verificação MD5 da transferência: &gnome-connections-md5sum;
        </para>
      </listitem>
      <listitem>
        <para>
          Tamanho da transferência: &gnome-connections-size;
        </para>
      </listitem>
      <listitem>
        <para>
          Espaço em disco estimado exigido: &gnome-connections-buildsize;
        </para>
      </listitem>
      <listitem>
        <para>
          Tempo de construção estimado: &gnome-connections-time;
        </para>
      </listitem>
    </itemizedlist>

    <bridgehead renderas="sect3">Dependências do gnome-connections</bridgehead>

    <bridgehead renderas="sect4">Exigidas</bridgehead>
    <para role="required">
      <xref linkend="appstream"/>, <xref linkend="freerdp"/>, <xref
linkend="gtk-vnc"/>, <xref linkend="itstool"/>, <xref linkend="libhandy1"/>,
<xref linkend="libsecret"/> e <xref linkend="vala"/>
    </para>

  </sect2>

  <sect2 role="installation">
    <title>Instalação do gnome-connections</title>

    <para>
      Instale <application>gnome-connections</application> executando os seguintes
comandos:
    </para>

<screen><userinput>mkdir build &amp;&amp;
cd    build &amp;&amp;

meson setup --prefix=/usr --buildtype=release .. &amp;&amp;
ninja</userinput></screen>

    <para>
      Para testar os resultads, emita: <command>ninja test</command>
    </para>

    <para>
      Agora, como o(a) usuário(a) <systemitem class="username">root</systemitem>:
    </para>

<screen role="root"><userinput>ninja install</userinput></screen>

  </sect2>

  <sect2 role="content">
    <title>Conteúdo</title>

    <segmentedlist>
      <segtitle>Aplicativos Instalados</segtitle>
      <segtitle>Bibliotecas Instaladas</segtitle>
      <segtitle>Diretórios Instalados</segtitle>

      <seglistitem>
        <seg>
          gnome-connections
        </seg>
        <seg>
          Nenhum(a)
        </seg>
        <seg>
          /usr/include/gnome-connections, /usr/lib/gnome-connections,
/usr/share/gnome-connections e /usr/share/help/*/gnome-connections
        </seg>
      </seglistitem>
    </segmentedlist>

    <variablelist>
      <bridgehead renderas="sect3">Descrições Curtas</bridgehead>
      <?dbfo list-presentation="list"?> <?dbhtml list-presentation="table"?>

      <varlistentry id="gnome-connections-prog">
        <term><command>gnome-connections</command></term>
        <listitem>
          <para>
            é um visualizador de área de trabalho remota para a área de trabalho do
<application>GNOME</application>
          </para>
          <indexterm zone="gnome-connections gnome-connections-prog">
            <primary sortas="b-gnome-connections">gnome-connections</primary>
          </indexterm>
        </listitem>
      </varlistentry>

    </variablelist>

  </sect2>

