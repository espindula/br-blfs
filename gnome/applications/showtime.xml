<sect1 id="showtime" xreflabel="Showtime-&showtime-version;">
  <?dbhtml filename="showtime.html"?>

  <title>Showtime-&showtime-version;</title>

  <indexterm zone="showtime">
    <primary sortas="a-Showtime">Showtime</primary>
  </indexterm>

  <sect2 role="package">
    <title>Introdução ao Showtime</title>

    <para>
      <application>Showtime</application> é um aplicativo usado para reproduzir
arquivos de áudio e vídeo na área de trabalho do
<application>GNOME</application>.
    </para>

    &lfs124_checked;

    <bridgehead renderas="sect3">Informação do Pacote</bridgehead>
    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Transferência (HTTP): <ulink url="&showtime-download-http;"/>
        </para>
      </listitem>
      <listitem>
        <para>
          Transferência (FTP): <ulink url="&showtime-download-ftp;"/>
        </para>
      </listitem>
      <listitem>
        <para>
          Soma de verificação MD5 da transferência: &showtime-md5sum;
        </para>
      </listitem>
      <listitem>
        <para>
          Tamanho da transferência: &showtime-size;
        </para>
      </listitem>
      <listitem>
        <para>
          Espaço em disco estimado exigido: &showtime-buildsize;
        </para>
      </listitem>
      <listitem>
        <para>
          Tempo de construção estimado: &showtime-time;
        </para>
      </listitem>
    </itemizedlist>

    <bridgehead renderas="sect3">Dependências do Showtime</bridgehead>

    <bridgehead renderas="sect4">Exigidas</bridgehead>
    <para role="required">
      <xref linkend="blueprint-compiler"/>, <xref linkend="gst10-plugins-base"/>,
<xref linkend="libadwaita1"/> e <xref linkend="pygobject3"/>
    </para>

  </sect2>

  <sect2 role="installation">
    <title>Instalação do Showtime</title>

    <para>
      Instale <application>Showtime</application> executando os seguintes
comandos:
    </para>

<screen><userinput>mkdir build &amp;&amp;
cd    build &amp;&amp;

meson setup --prefix=/usr       \
            --buildtype=release \
            ..                  &amp;&amp;
ninja</userinput></screen>

    <para>
      Esse pacote não vem com uma suíte de teste.
    </para>

    <para>
      Agora, como o(a) usuário(a) <systemitem class="username">root</systemitem>:
    </para>

<screen role="root"><userinput>ninja install</userinput></screen>

  </sect2>

