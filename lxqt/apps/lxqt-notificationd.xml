<sect1 id="lxqt-notificationd" xreflabel="lxqt-notificationd-&lxqt-notificationd-version;">
  <?dbhtml filename="lxqt-notificationd.html"?>


  <title>lxqt-notificationd-&lxqt-notificationd-version;</title>

  <indexterm zone="lxqt-notificationd">
    <primary sortas="a-lxqt-notificationd">lxqt-notificationd</primary>
  </indexterm>

  <sect2 role="package">
    <title>Introdução ao lxqt-notificationd</title>

    <para>
      O pacote <application>lxqt-notificationd</application> é o processo de
segundo plano de notificação do <application>LXQt</application>.
    </para>

    &lfs124_checked;

    <bridgehead renderas="sect3">Informação do Pacote</bridgehead>
    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Transferência (HTTP): <ulink url="&lxqt-notificationd-download-http;"/>
        </para>
      </listitem>
      <listitem>
        <para>
          Transferência (FTP): <ulink url="&lxqt-notificationd-download-ftp;"/>
        </para>
      </listitem>
      <listitem>
        <para>
          Soma de verificação MD5 da transferência: &lxqt-notificationd-md5sum;
        </para>
      </listitem>
      <listitem>
        <para>
          Tamanho da transferência: &lxqt-notificationd-size;
        </para>
      </listitem>
      <listitem>
        <para>
          Espaço em disco estimado exigido: &lxqt-notificationd-buildsize;
        </para>
      </listitem>
      <listitem>
        <para>
          Tempo de construção estimado: &lxqt-notificationd-time;
        </para>
      </listitem>
    </itemizedlist>

    <bridgehead renderas="sect3">Dependências do lxqt-notificationd</bridgehead>

    <bridgehead renderas="sect4">Exigidas</bridgehead>
    <para role="required">
      <xref linkend="liblxqt"/>
    </para>

  </sect2>

  <sect2 role="installation">
    <title>Instalação do lxqt-notificationd</title>

    <para>
      Instale o <application>lxqt-notificationd</application> executando os
seguintes comandos:
    </para>

<screen><userinput>mkdir build &amp;&amp;
cd    build &amp;&amp;

cmake -D CMAKE_BUILD_TYPE=Release  \
      -D CMAKE_INSTALL_PREFIX=/usr \
      ..                           &amp;&amp;
make</userinput></screen>

    <para>
      Esse pacote não vem com uma suíte de teste.
    </para>

    <para>
      Agora, como o(a) usuário(a) <systemitem class="username">root</systemitem>:
    </para>

<screen role="root"><userinput>make install</userinput></screen>

  </sect2>

