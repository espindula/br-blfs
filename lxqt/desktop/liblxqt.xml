<sect1 id="liblxqt" xreflabel="liblxqt-&lxqt-version;">
  <?dbhtml filename="liblxqt.html"?>


  <title>liblxqt-&lxqt-version;</title>

  <indexterm zone="liblxqt">
    <primary sortas="a-liblxqt">liblxqt</primary>
  </indexterm>

  <sect2 role="package">
    <title>Introdução ao liblxqt</title>

    <para>
      A <application>liblxqt</application> é a biblioteca principal de utilitários
para todos os componentes do <application>LXQt</application>.
    </para>

    &lfs122_checked;

    <bridgehead renderas="sect3">Informação do Pacote</bridgehead>
    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Transferência (HTTP): <ulink url="&liblxqt-download-http;"/>
        </para>
      </listitem>
      <listitem>
        <para>
          Transferência (FTP): <ulink url="&liblxqt-download-ftp;"/>
        </para>
      </listitem>
      <listitem>
        <para>
          Soma de verificação MD5 da transferência: &liblxqt-md5sum;
        </para>
      </listitem>
      <listitem>
        <para>
          Tamanho da transferência: &liblxqt-size;
        </para>
      </listitem>
      <listitem>
        <para>
          Espaço em disco estimado exigido: &liblxqt-buildsize;
        </para>
      </listitem>
      <listitem>
        <para>
          tempo de construção estimado: &liblxqt-time;
        </para>
      </listitem>
    </itemizedlist>

    <bridgehead renderas="sect3">Dependências do liblxqt</bridgehead>

    <bridgehead renderas="sect4">Exigidas</bridgehead>
    <para role="required">
      <xref linkend="libqtxdg"/>, <xref linkend="lxqt-kwindowsystem"/> e <xref
linkend="polkit-qt"/>
    </para>
  </sect2>

  <sect2 role="installation">
    <title>Instalação do liblxqt</title>

    <para>
      Instale o <application>liblxqt</application> executando os seguintes
comandos:
    </para>

<screen><userinput>mkdir build &amp;&amp;
cd    build &amp;&amp;

cmake -D CMAKE_INSTALL_PREFIX=/usr \
      -D CMAKE_BUILD_TYPE=Release  \
      ..                           &amp;&amp;
make</userinput></screen>

    <para>
      Esse pacote não vem com uma suíte de teste.
    </para>

    <para>
      Agora, como o(a) usuário(a) &root;:
    </para>

<screen role="root"><userinput>make install</userinput></screen>

  </sect2>

