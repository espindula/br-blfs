  <indexterm zone="muparser">
    <primary sortas="a-muparser">muparser</primary>
  </indexterm>

  <sect2 role="package">
    <title>Introdução ao muparser</title>

    <para>
      O pacote <application>muparser</application> é uma biblioteca de analisador
matemático rápido para C e C++.
    </para>

    &lfs130_checked;

    <bridgehead renderas="sect3">Informação do Pacote</bridgehead>
    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Transferência (HTTP): <ulink url="&muparser-download-http;"/>
        </para>
      </listitem>
      <listitem>
        <para>
          Transferência (FTP): <ulink url="&muparser-download-ftp;"/>
        </para>
      </listitem>
      <listitem>
        <para>
          Soma de verificação MD5 da transferência: &muparser-md5sum;
        </para>
      </listitem>
      <listitem>
        <para>
          Tamanho da transferência: &muparser-size;
        </para>
      </listitem>
      <listitem>
        <para>
          Espaço em disco estimado exigido: &muparser-buildsize;
        </para>
      </listitem>
      <listitem>
        <para>
          Tempo de construção estimado: &muparser-time;
        </para>
      </listitem>
    </itemizedlist>

    <bridgehead renderas="sect3">Dependências do muparser</bridgehead>

    <bridgehead renderas="sect4">Exigidas</bridgehead>
    <para role="required">
      <xref linkend="cmake"/>
    </para>

  </sect2>

  <sect2 role="installation">
    <title>Instalação do muparser</title>

    <para>
      Instale o <application>muparser</application> executando os seguintes
comandos:
    </para>

<screen><userinput>mkdir -v build &amp;&amp;
cd       build &amp;&amp;

cmake -D CMAKE_INSTALL_PREFIX=/usr \
      -D CMAKE_BUILD_TYPE=Release  \
      ..                           &amp;&amp;
make</userinput></screen>

    <para>
      Para testar os resultados, emita: <command>make test</command>.
    </para>

    <para>
      Agora, como o(a) usante &root;:
    </para>

<screen role="root"><userinput>make install</userinput></screen>

  </sect2>

