  <sect2 role="package">
    <title>Introdução ao libsysstat</title>

    <para>
      O pacote <application>libsysstat</application> contém uma biblioteca usada
para consultar informações e estatísticas do sistema.
    </para>

    &lfs130_checked;

    <bridgehead renderas="sect3">Informação do Pacote</bridgehead>
    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Transferência (HTTP): <ulink url="&libsysstat-download-http;"/>
        </para>
      </listitem>
      <listitem>
        <para>
          Transferência (FTP): <ulink url="&libsysstat-download-ftp;"/>
        </para>
      </listitem>
      <listitem>
        <para>
          Soma de verificação MD5 da transferência: &libsysstat-md5sum;
        </para>
      </listitem>
      <listitem>
        <para>
          Tamanho da transferência: &libsysstat-size;
        </para>
      </listitem>
      <listitem>
        <para>
          Espaço em disco estimado exigido: &libsysstat-buildsize;
        </para>
      </listitem>
      <listitem>
        <para>
          Tempo de construção estimado: &libsysstat-time;
        </para>
      </listitem>
    </itemizedlist>

    <bridgehead renderas="sect3">Dependências do libsysstat</bridgehead>

    <bridgehead renderas="sect4">Exigidas</bridgehead>
