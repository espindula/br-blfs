<sect1 id="lxqt-wayland-session" xreflabel="lxqt-wayland-session-&lxqt-session-version;">
  <?dbhtml filename="lxqt-wayland-session.html"?>


  <title>lxqt-wayland-session-&lxqt-wayland-session-version;</title>

  <indexterm zone="lxqt-wayland-session">
    <primary sortas="a-lxqt-wayland-session">lxqt-wayland-session</primary>
  </indexterm>

  <sect2 role="package">
    <title>Introdução ao lxqt-wayland-session</title>

    <para>
      O pacote <application>lxqt-wayland-session</application> contém o
gerenciador de sessão baseado em Wayland para
<application>LXQt</application>.
    </para>

    &lfs130_checked;

    <bridgehead renderas="sect3">Informação do Pacote</bridgehead>
    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Transferência (HTTP): <ulink url="&lxqt-wayland-session-download-http;"/>
        </para>
      </listitem>
      <listitem>
        <para>
          Transferência (FTP): <ulink url="&lxqt-wayland-session-download-ftp;"/>
        </para>
      </listitem>
      <listitem>
        <para>
          Soma de verificação MD5 da transferência: &lxqt-wayland-session-md5sum;
        </para>
      </listitem>
      <listitem>
        <para>
          Tamanho da transferência: &lxqt-wayland-session-size;
        </para>
      </listitem>
      <listitem>
        <para>
          Espaço em disco estimado exigido: &lxqt-wayland-session-buildsize;
        </para>
      </listitem>
      <listitem>
        <para>
          Tempo de construção estimado: &lxqt-wayland-session-time;
        </para>
      </listitem>
    </itemizedlist>

    <bridgehead renderas="sect3">Dependências do lxqt-wayland-session</bridgehead>

    <bridgehead renderas="sect4">Exigidas</bridgehead>
    <para role="required">
      <xref linkend="lxqt-session"/>, <xref linkend="lxqt-layer-shell-qt"/> e
<xref linkend="qtxdg-tools"/>
    </para>

  </sect2>

  <sect2 role="installation">
    <title>Instalação do lxqt-wayland-session</title>

    <para>
      Instale <application>lxqt-wayland-session</application> executando os
seguintes comandos:
    </para>

<screen><userinput>mkdir build &amp;&amp;
cd    build &amp;&amp;

cmake -D CMAKE_INSTALL_PREFIX=/usr \
      -D CMAKE_BUILD_TYPE=Release  \
      ..                           &amp;&amp;
make</userinput></screen>

    <para>
      Esse pacote não vem com uma suíte de teste.
    </para>

    <para>
      Agora, como o(a) usuário(a) &root;:
    </para>

<screen role="root"><userinput>make install</userinput></screen>

  </sect2>

