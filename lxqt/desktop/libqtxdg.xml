        </para>
      </listitem>
    </itemizedlist>

    <bridgehead renderas="sect3">Dependências do libqtxdg</bridgehead>

    <bridgehead renderas="sect4">Exigidas</bridgehead>
    <para role="required">
      <xref linkend="cmake"/> e &qt5-deps;
    </para>

