  <sect2 role="package">
    <title>Introdução ao libqtxdg</title>

    <para>
      O <application>libqtxdg</application> é uma implementação Qt das
especificações XDG da freedesktop.org.
    </para>

    &lfs122_checked;

    <bridgehead renderas="sect3">Informação do Pacote</bridgehead>
    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Transferência (HTTP): <ulink url="&libqtxdg-download-http;"/>
        </para>
      </listitem>
      <listitem>
        <para>
          Transferência (FTP): <ulink url="&libqtxdg-download-ftp;"/>
        </para>
      </listitem>
      <listitem>
        <para>
          Soma de verificação MD5 da transferência: &libqtxdg-md5sum;
        </para>
      </listitem>
      <listitem>
        <para>
          Tamanho da transferência: &libqtxdg-size;
        </para>
      </listitem>
      <listitem>
        <para>
          Espaço em disco estimado exigido: &libqtxdg-buildsize;
        </para>
      </listitem>
      <listitem>
        <para>
          Tempo de construção estimado: &libqtxdg-time;
        </para>
      </listitem>
    </itemizedlist>

    <bridgehead renderas="sect3">Dependências do libqtxdg</bridgehead>

    <bridgehead renderas="sect4">Exigidas</bridgehead>
    <para role="required">
      <xref linkend="cmake"/> e <xref linkend="qt6"/>
    </para>

    <bridgehead renderas="sect4">Opcionais (tempo de execução)</bridgehead>
    <para role="optional">
      <xref role="runtime" linkend="gtk3"/> (para
<command>gtk-update-icon-cache</command>)
    </para>


