<sect1 id="lxqt-policykit" xreflabel="lxqt-policykit-&lxqt-version;">
  <?dbhtml filename="lxqt-policykit.html"?>


  <title>lxqt-policykit-&lxqt-version;</title>

  <indexterm zone="lxqt-policykit">
    <primary sortas="a-lxqt-policykit">lxqt-policykit</primary>
  </indexterm>

  <sect2 role="package">
    <title>Introdução ao lxqt-policykit</title>

    <para>
      O pacote <application>lxqt-policykit</application> é o agente PolicyKit do
<application>LXQt</application>.
    </para>

    &lfs121_checked;

    <bridgehead renderas="sect3">Informação do Pacote</bridgehead>
    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Transferência (HTTP): <ulink url="&lxqt-policykit-download-http;"/>
        </para>
      </listitem>
      <listitem>
        <para>
          Transferência (FTP): <ulink url="&lxqt-policykit-download-ftp;"/>
        </para>
      </listitem>
      <listitem>
        <para>
          Soma de verificação MD5 da transferência: &lxqt-policykit-md5sum;
        </para>
      </listitem>
      <listitem>
        <para>
          Tamanho da transferência: &lxqt-policykit-size;
        </para>
      </listitem>
      <listitem>
        <para>
          Espaço em disco estimado exigido: &lxqt-policykit-buildsize;
        </para>
      </listitem>
      <listitem>
        <para>
          Tempo de construção estimado: &lxqt-policykit-time;
        </para>
      </listitem>
    </itemizedlist>

    <bridgehead renderas="sect3">Dependências do lxqt-policykit</bridgehead>

    <bridgehead renderas="sect4">Exigidas</bridgehead>
    <para role="required">
      <xref linkend="liblxqt"/> e <xref linkend="polkit-qt"/>
    </para>

  </sect2>

  <sect2 role="installation">
    <title>Instalação do lxqt-policykit</title>

    <para>
      Instale o <application>lxqt-policykit</application> executando os seguintes
comandos:
    </para>

<screen><userinput>mkdir -v build &amp;&amp;
cd       build &amp;&amp;

cmake -DCMAKE_INSTALL_PREFIX=/usr \
      -DCMAKE_BUILD_TYPE=Release  \
      ..                          &amp;&amp;
make</userinput></screen>

    <para>
      Esse pacote não vem com uma suíte de teste.
    </para>

    <para>
      Agora, como o(a) usuário(a) &root;:
    </para>

<screen role="root"><userinput>make install</userinput></screen>

  </sect2>

