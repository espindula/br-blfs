<sect1 id="obconf-qt" xreflabel="obconf-qt-&obconf-qt-version;">
  <?dbhtml filename="obconf-qt.html"?>


  <title>obconf-qt-&obconf-qt-version;</title>

  <indexterm zone="obconf-qt">
    <primary sortas="a-obconf-qt">obconf-qt</primary>
  </indexterm>

  <sect2 role="package">
    <title>Introdução ao obconf-qt</title>

    <para>
      O pacote <application>obconf-qt</application> é uma ferramenta de
configuração baseada em Qt para o <application>Openbox</application>.
    </para>

    &lfs130_checked;

    <bridgehead renderas="sect3">Informação do Pacote</bridgehead>
    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Transferência (HTTP): <ulink url="&obconf-qt-download-http;"/>
        </para>
      </listitem>
      <listitem>
        <para>
          Transferência (FTP): <ulink url="&obconf-qt-download-ftp;"/>
        </para>
      </listitem>
      <listitem>
        <para>
          Soma de verificação MD5 da transferência: &obconf-qt-md5sum;
        </para>
      </listitem>
      <listitem>
        <para>
          Tamanho da transferência: &obconf-qt-size;
        </para>
      </listitem>
      <listitem>
        <para>
          Espaço em disco estimado exigido: &obconf-qt-buildsize;
        </para>
      </listitem>
      <listitem>
        <para>
          Tempo de construção estimado: &obconf-qt-time;
        </para>
      </listitem>
    </itemizedlist>

    <bridgehead renderas="sect3">Dependências do obconf-qt</bridgehead>

    <bridgehead renderas="sect4">Exigidas</bridgehead>
    <para role="required">
      <xref linkend="hicolor-icon-theme"/>, <xref linkend="lxqt-build-tools"/>,
<xref linkend="openbox"/> e <xref linkend="qt6"/>
    </para>

  </sect2>

  <sect2 role="installation">
    <title>Instalação do obconf-qt</title>

    <para>
       Instale o <application>obconf-qt</application> executando os seguintes
comandos:
    </para>

<screen><userinput>mkdir build &amp;&amp;
cd    build &amp;&amp;

cmake -D CMAKE_INSTALL_PREFIX=/usr \
      -D CMAKE_BUILD_TYPE=Release  \
      ..                           &amp;&amp;
make</userinput></screen>

    <para>
      Esse pacote não vem com uma suíte de teste.
    </para>

    <para>
      Agora, como o(a) usuário(a) &root;:
    </para>

<screen role="root"><userinput>make install</userinput></screen>

  </sect2>

