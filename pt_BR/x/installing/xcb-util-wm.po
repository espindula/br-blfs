#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/installing/xcb-util-wm.xml:30
#, xml-text
msgid ""
"The <application>xcb-util-wm</application> package contains libraries which "
"provide client and window-manager helpers for EWMH and ICCCM."
msgstr ""
"O pacote &quot;<application>xcb-util-wm</application>&quot; contém "
"bibliotecas que fornecem auxiliares de cliente e gerenciador de janelas para"
" &quot;EWMH&quot; e &quot;ICCCM&quot;."

