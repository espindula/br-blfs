#. type: Content of: <sect2><sect3><title>
#: blfs-en/x/installing/libinput.xml:33
#, xml-text
msgid "Introduction to Libinput"
msgstr "Introdução ao Libinput"

#. type: Content of: <sect2><sect3><para>
#: blfs-en/x/installing/libinput.xml:36
#, xml-text
msgid ""
"<application>libinput</application> is a library that handles input devices "
"for display servers and other applications that need to directly deal with "
"input devices."
msgstr ""
"<application>libinput</application> é uma biblioteca que manuseia "
"dispositivos de entrada para servidores de exibição e outras aplicações que "
"precisam lidar diretamente com dispositivos de entrada."

