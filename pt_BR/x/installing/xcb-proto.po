#. type: Content of: <sect1><sect2><title>
#: blfs-en/x/installing/xcb-proto.xml:87
#, xml-text
msgid "Installation of xcb-proto"
msgstr "Instalação do xcb-proto"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/installing/xcb-proto.xml:90
#, xml-text
msgid ""
"Install <application>xcb-proto</application> by running the following "
"commands:"
msgstr ""
"Instale o &quot;<application>xcb-proto</application>&quot; executando os "
"seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/x/installing/xcb-proto.xml:94
#, no-wrap, xml-text
msgid "<userinput>PYTHON=python3 ./configure $XORG_CONFIG</userinput>"
msgstr "<userinput>PYTHON=python3 ./configure $XORG_CONFIG</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/installing/xcb-proto.xml:97
#, xml-text
msgid "To test the results, issue: <command>make check</command>."
msgstr "Para testar os resultados, emita: <command>make check</command>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/installing/xcb-proto.xml:101
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) &quot;<systemitem "
"class=\"username\">root</systemitem>&quot;:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/x/installing/xcb-proto.xml:104
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/installing/xcb-proto.xml:107
#, xml-text
msgid ""
"If you are upgrading from version 1.15.1 or lower, the old pkgconfig file "
"needs to be removed. Issue, as the <systemitem "
"class=\"username\">root</systemitem> user:"
msgstr ""
"Se você estiver atualizando a partir da versão 1.15.1 ou inferior, [então] o"
" arquivo antigo do &quot;pkgconfig&quot; precisará ser removido. Emita, como"
" o(a) usuário(a) &quot;<systemitem "
"class=\"username\">root</systemitem>&quot;:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/x/installing/xcb-proto.xml:112
#, no-wrap, xml-text
msgid "<userinput>rm -f $XORG_PREFIX/lib/pkgconfig/xcb-proto.pc</userinput>"
msgstr "<userinput>rm -f $XORG_PREFIX/lib/pkgconfig/xcb-proto.pc</userinput>"

