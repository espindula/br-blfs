#, xml-text
msgid "Downloading Xorg Legacy"
msgstr "Baixando o Legado do Xorg"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/installing/x7legacy.xml:129
#, xml-text
msgid ""
"First, create a list of files to be downloaded. This file will also be used "
"to verify the integrity of the downloads when complete:"
msgstr ""
"Primeiro, crie uma lista de arquivos a serem baixados. Esse arquivo também "
"será usado para verificar a integridade das transferências quando "
"completadas:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/x/installing/x7legacy.xml:133
#, no-wrap, xml-text
msgid ""
"<userinput>cat &gt; legacy.dat &lt;&lt; \"EOF\"\n"
"<literal>&bdftopcf-md5sum; util/ bdftopcf-&bdftopcf-version;.tar.xz\n"
"&font-adobe-100dpi-md5sum; font/ font-adobe-100dpi-&font-adobe-100dpi-version;.tar.xz\n"
"&font-adobe-75dpi-md5sum; font/ font-adobe-75dpi-&font-adobe-75dpi-version;.tar.xz\n"
"&font-jis-misc-md5sum; font/ font-jis-misc-&font-jis-misc-version;.tar.xz\n"
"&font-daewoo-misc-md5sum; font/ font-daewoo-misc-&font-daewoo-misc-version;.tar.xz\n"
"&font-isas-misc-md5sum; font/ font-isas-misc-&font-isas-misc-version;.tar.xz\n"
"&font-misc-misc-md5sum; font/ font-misc-misc-&font-misc-misc-version;.tar.xz</literal>\n"
"EOF</userinput>"
msgstr ""
"<userinput>cat &gt; legacy.dat &lt;&lt; \"EOF\"\n"
"<literal>&bdftopcf-md5sum; util/ bdftopcf-&bdftopcf-version;.tar.xz\n"
"&font-adobe-100dpi-md5sum; font/ font-adobe-100dpi-&font-adobe-100dpi-version;.tar.xz\n"
"&font-adobe-75dpi-md5sum; font/ font-adobe-75dpi-&font-adobe-75dpi-version;.tar.xz\n"
"&font-jis-misc-md5sum; font/ font-jis-misc-&font-jis-misc-version;.tar.xz\n"
"&font-daewoo-misc-md5sum; font/ font-daewoo-misc-&font-daewoo-misc-version;.tar.xz\n"
"&font-isas-misc-md5sum; font/ font-isas-misc-&font-isas-misc-version;.tar.xz\n"
"&font-misc-misc-md5sum; font/ font-misc-misc-&font-misc-misc-version;.tar.xz</literal>\n"
"EOF</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/installing/x7legacy.xml:144
#, xml-text
msgid ""
"To download the needed files using <xref linkend='wget'/>, use the following"
" commands:"
msgstr ""
"Para baixar os arquivos necessários usando o <xref linkend='wget'/>, use os "
"seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/x/installing/x7legacy.xml:148
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir legacy &amp;&amp;\n"
"cd    legacy &amp;&amp;\n"
"grep -v '^#' ../legacy.dat | awk '{print $2$3}' | wget -i- -c \\\n"
"     -B &xorg-download-http;/ &amp;&amp;\n"
"grep -v '^#' ../legacy.dat | awk '{print $1 \" \" $3}' > ../legacy.md5 &amp;&amp;\n"
"md5sum -c ../legacy.md5</userinput>"
msgstr ""
"<userinput>mkdir legacy &amp;&amp;\n"
"cd     legacy &amp;&amp;\n"
"grep -v '^#' ../legacy.dat | awk '{print $2$3}' | wget -i- -c \\\n"
"     -B &xorg-download-http;/ &amp;&amp;\n"
"grep -v '^#' ../legacy.dat | awk '{print $1 \" \" $3}' > ../legacy.md5 &amp;&amp;\n"
"md5sum -c ../legacy.md5</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/x/installing/x7legacy.xml:158
#, xml-text
msgid "Installation of Xorg Legacy"
msgstr "Instalação do Legado do Xorg"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/installing/x7legacy.xml:163
#, xml-text
msgid "First, start a subshell that will exit on error:"
msgstr "Primeiro, inicie um sub &quot;shell&quot; que sairá em caso de erro:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/x/installing/x7legacy.xml:166
#, no-wrap, xml-text
msgid "<userinput>bash -e</userinput>"
msgstr "<userinput>bash -e</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/installing/x7legacy.xml:169
#, xml-text
msgid "Install all of the packages by running the following commands:"
msgstr "Instale todos os pacotes executando os seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/x/installing/x7legacy.xml:172
#, no-wrap, xml-text
msgid ""
"<userinput>for package in $(grep -v '^#' ../legacy.md5 | awk '{print $2}')\n"
"do\n"
"  packagedir=${package%.tar.?z*}\n"
"  tar -xf $package\n"
"  pushd $packagedir\n"
"    ./configure $XORG_CONFIG\n"
"    make\n"
"    as_root make install\n"
"  popd\n"
"  rm -rf $packagedir\n"
"  as_root /sbin/ldconfig\n"
"done</userinput>"
msgstr ""
"<userinput>for package in $(grep -v '^#' ../legacy.md5 | awk '{print $2}')\n"
"do\n"
"  packagedir=${package%.tar.?z*}\n"
"  tar -xf $package\n"
"  pushd $packagedir\n"
"    ./configure $XORG_CONFIG\n"
"    make\n"
"    as_root make install\n"
"  popd\n"
"  rm -rf $packagedir\n"
"  as_root /sbin/ldconfig\n"
"done</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/installing/x7legacy.xml:186
#, xml-text
msgid "Finally, exit the shell that was started earlier:"
msgstr "Finalmente, saia do &quot;shell&quot; que foi iniciado anteriormente:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/x/installing/x7legacy.xml:189
#, no-wrap, xml-text
msgid "<userinput>exit</userinput>"
msgstr "<userinput>exit</userinput>"

