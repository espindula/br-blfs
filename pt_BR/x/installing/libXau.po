#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/installing/libXau.xml:29
#, xml-text
msgid ""
"The <application>libXau</application> package contains a library "
"implementing the X11 Authorization Protocol. This is useful for restricting "
"client access to the display."
msgstr ""
"O pacote &quot;<application>libXau</application>&quot; contém uma biblioteca"
" que implementa o Protocolo de Autorização X11. Isso é útil para restringir "
"o acesso do cliente ao monitor."

