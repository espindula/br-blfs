#: blfs-en/x/installing/libXau.xml:80
#, xml-text
msgid "Installation of libXau"
msgstr "Instalação do libXau"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/installing/libXau.xml:83
#, xml-text
msgid ""
"Install <application>libXau</application> by running the following commands:"
msgstr ""
"Instale o &quot;<application>libXau</application>&quot; executando os "
"seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/x/installing/libXau.xml:87
#, no-wrap, xml-text
msgid ""
"<userinput>./configure $XORG_CONFIG &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>./configure $XORG_CONFIG &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/installing/libXau.xml:91
#, xml-text
msgid "To test the results, issue: <command>make check</command>."
msgstr "Para testar os resultados, emita: <command>make check</command>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/installing/libXau.xml:95
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) &quot;<systemitem "
"class=\"username\">root</systemitem>&quot;:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/x/installing/libXau.xml:98
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

