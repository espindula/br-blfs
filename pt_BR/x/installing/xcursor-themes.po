#. type: Content of: <sect1><sect2><title>
#: blfs-en/x/installing/xcursor-themes.xml:79
#, xml-text
msgid "Installation of xcursor-themes"
msgstr "Instalação do xcursor-themes"

#. type: Content of: <sect1><sect2><note><para>
#: blfs-en/x/installing/xcursor-themes.xml:83
#, xml-text
msgid ""
"We explicitly install the cursor themes in /usr instead of "
"<envar>$XORG_PREFIX</envar> so non-Xorg desktop environments can find them."
msgstr ""
"Nós instalamos explicitamente os temas de cursor em &quot;/usr&quot; em vez "
"de &quot;<envar>$XORG_PREFIX</envar>&quot;, de forma que ambientes de área "
"de trabalho não &quot;Xorg&quot; consigam encontrá-los."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/installing/xcursor-themes.xml:90
#, xml-text
msgid ""
"Install <application>xcursor-themes</application> by running the following "
"commands:"
msgstr ""
"Instale o &quot;<application>xcursor-themes</application>&quot; executando "
"os seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/x/installing/xcursor-themes.xml:94
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>./configure --prefix=/usr &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/installing/xcursor-themes.xml:98
#, xml-text
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/installing/xcursor-themes.xml:102
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) &quot;<systemitem "
"class=\"username\">root</systemitem>&quot;:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/x/installing/xcursor-themes.xml:105
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

