#. type: Content of: <sect1><sect2><title>
#: blfs-en/x/installing/libxcb.xml:93
#, xml-text
msgid "Installation of libxcb"
msgstr "Instalação do libxcb"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/installing/libxcb.xml:96
#, xml-text
msgid ""
"Install <application>libxcb</application> by running the following commands:"
msgstr ""
"Instale o &quot;<application>libxcb</application>&quot; executando os "
"seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/x/installing/libxcb.xml:100
#, no-wrap, xml-text
msgid ""
"<userinput>./configure $XORG_CONFIG      \\\n"
"            --without-doxygen \\\n"
"            --docdir='${datadir}'/doc/libxcb-&libxcb-version; &amp;&amp;\n"
"LC_ALL=en_US.UTF-8 make</userinput>"
msgstr ""
"<userinput>./configure $XORG_CONFIG      \\\n"
"            --without-doxygen \\\n"
"            --docdir='${datadir}'/doc/libxcb-&libxcb-version; &amp;&amp;\n"
"LC_ALL=en_US.UTF-8 make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/installing/libxcb.xml:106
#, xml-text
msgid "To test the results, issue: <command>make check</command>."
msgstr "Para testar os resultados, emita: <command>make check</command>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/installing/libxcb.xml:110
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) &quot;<systemitem "
"class=\"username\">root</systemitem>&quot;:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/x/installing/libxcb.xml:113
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/installing/libxcb.xml:116
#, xml-text
msgid ""
"If the package was built as a non-&root; user, the installed documentation "
"is now owned by this user.  As the &root; user, fix the ownership:"
msgstr ""
"Se o pacote foi construído como um(a) usuário(a) não-&root;, a documentação "
"instalada agora é titularizada por esse usuário(a). Como o(a) usuário(a) "
"&root;, corrija a titularidade da propriedade:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/x/installing/libxcb.xml:121
#, no-wrap, xml-text
msgid ""
"<userinput>chown -Rv root:root $XORG_PREFIX/share/doc/libxcb-&libxcb-"
"version;</userinput>"
msgstr ""
"<userinput>chown -Rv root:root $XORG_PREFIX/share/doc/libxcb-&libxcb-"
"version;</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/x/installing/libxcb.xml:126
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/installing/libxcb.xml:130
#, xml-text
msgid ""
"<envar>LC_ALL=en_US.UTF-8</envar>: Some Python 3 script in the building "
"system of this package may fail with certain system locale settings.  This "
"environment variable forces a locale setting known to work."
msgstr ""
"<envar>LC_ALL=en_US.UTF-8</envar>: Alguns conjuntos de comandos sequenciais "
"do Python 3 no sistema de construção desse pacote possivelmente falhem com "
"certas configurações de localidades do sistema. Essa variável de ambiente "
"força uma configuração de localidade conhecida por funcionar."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/installing/libxcb.xml:137
#, xml-text
msgid ""
"<parameter>--without-doxygen</parameter>: Do not use doxygen to generate API"
" documentation (default: auto). Without it, if <xref linkend=\"doxygen\"/> "
"is installed, the API documentation will be generated and installed."
msgstr ""
"<parameter>--without-doxygen</parameter>: Não use &quot;doxygen&quot; para "
"gerar documentação da &quot;API&quot; (padrão: automático). Sem ele, se o "
"&quot;<xref linkend=\"doxygen\"/>&quot; estiver instalado, [então] a "
"documentação da &quot;API&quot; será gerada e instalada."

