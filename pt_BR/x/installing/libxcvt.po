#: blfs-en/x/installing/libxcvt.xml:26
#, xml-text
msgid "Introduction to libxcvt"
msgstr "Introdução ao libxcvt"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/installing/libxcvt.xml:29
#, xml-text
msgid ""
"<application>libxcvt</application> is a library providing a standalone "
"version of the X server implementation of the VESA CVT standard timing "
"modelines generator. It is meant to be a direct replacement to the version "
"formerly provided by the Xorg server."
msgstr ""
"&quot;<application>libxcvt</application>&quot; é uma biblioteca que fornece "
"uma versão autônoma da implementação do servidor &quot;X&quot; do gerador de"
" modelos de temporização padrão &quot;VESA&quot; &quot;CVT&quot;. Ela "
"pretende ser uma substituição direta da versão anteriormente fornecida pelo "
"servidor &quot;Xorg&quot;."

