#. type: Content of: <sect2><sect3><title>
#: blfs-en/x/installing/x7driver-evdev.xml:113
#, xml-text
msgid "Installation of Xorg Evdev Driver"
msgstr "Instalação do Controlador Evdev do Xorg"

#. type: Content of: <sect2><sect3><para>
#: blfs-en/x/installing/x7driver-evdev.xml:116
#, xml-text
msgid ""
"Install <application>Xorg Evdev Driver</application> by running the "
"following commands:"
msgstr ""
"Instale o <application>Controlador &quot;Evdev&quot; do&quot; "
"Xorg&quot;</application> executando os seguintes comandos:"

#. type: Content of: <sect2><sect3><screen>
#: blfs-en/x/installing/x7driver-evdev.xml:120
#, no-wrap, xml-text
msgid ""
"<userinput>./configure $XORG_CONFIG &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>./configure $XORG_CONFIG &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect2><sect3><para>
