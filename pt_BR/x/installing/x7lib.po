#: blfs-en/x/installing/x7lib.xml:117
#, xml-text
msgid "Xorg Libraries"
msgstr "Bibliotecas do Xorg"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/x/installing/x7lib.xml:121
#, xml-text
msgid "Introduction to Xorg Libraries"
msgstr "Introdução às Bibliotecas do Xorg"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/installing/x7lib.xml:124
#, xml-text
msgid ""
"The <application>Xorg</application> libraries provide library routines that "
"are used within all X Window applications."
msgstr ""
"As bibliotecas do &quot;<application>Xorg</application>&quot; fornecem "
"rotinas de biblioteca que são usadas em todos os aplicativos do Janelas "
"&quot;X&quot;."

#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/x/installing/x7lib.xml:130
#, xml-text
msgid "Package Information"
msgstr "Informação do Pacote"

#. type: Content of: <sect1><sect2><itemizedlist><listitem><para>
#: blfs-en/x/installing/x7lib.xml:134
#, xml-text
msgid "Download (HTTP): <ulink url=\"&x7libs-download-http;\"/>"
msgstr "Transferência (HTTP): <ulink url=\"&x7libs-download-http;\"/>"

#. type: Content of: <sect1><sect2><itemizedlist><listitem><para>
#: blfs-en/x/installing/x7lib.xml:139
#, xml-text
msgid "Download (FTP): <ulink url=\"&x7libs-download-ftp;\"/>"
msgstr "Transferência (FTP): <ulink url=\"&x7libs-download-ftp;\"/>"

#. type: Content of: <sect1><sect2><itemizedlist><listitem><para>
#: blfs-en/x/installing/x7lib.xml:144
#, xml-text
msgid "Download size: &x7libs-size;"
msgstr "Tamanho da transferência: &x7libs-size;"

#. type: Content of: <sect1><sect2><itemizedlist><listitem><para>
#: blfs-en/x/installing/x7lib.xml:149
#, xml-text
msgid "Estimated disk space required: &x7libs-buildsize;"
msgstr "Espaço em disco estimado exigido: &x7libs-buildsize;"

#. type: Content of: <sect1><sect2><itemizedlist><listitem><para>
#: blfs-en/x/installing/x7lib.xml:154
#, xml-text
msgid "Estimated build time: &x7libs-time;"
msgstr "Tempo de construção estimado: &x7libs-time;"

#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/x/installing/x7lib.xml:159
#, xml-text
msgid "Xorg Libraries Dependencies"
msgstr "Dependências das Bibliotecas do Xorg"

#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/x/installing/x7lib.xml:161
#, xml-text
msgid "Required"
msgstr "Exigidas"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/installing/x7lib.xml:163
#, xml-text
msgid "<xref linkend=\"fontconfig\"/> and <xref linkend=\"libxcb\"/>"
msgstr "<xref linkend=\"fontconfig\"/> e <xref linkend=\"libxcb\"/>"

#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/x/installing/x7lib.xml:172
#, xml-text
msgid "Optional"
msgstr "Opcionais"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/installing/x7lib.xml:174
#, xml-text
msgid ""
"<xref linkend=\"asciidoc\"/>, <xref linkend=\"xmlto\"/> with one or more of "
"the following: <xref linkend=\"fop\"/>, <xref linkend=\"Links\"/>, <xref "
"linkend=\"lynx\"/>, <ulink "
"url=\"https://github.com/vapier/ncompress\">ncompress</ulink> (for some "
"tests), and <ulink url=\"&w3m-url;\">W3m</ulink> (to generate additional PDF"
" or text documentation for the libXfont package)."
msgstr ""
"<xref linkend=\"asciidoc\"/>, <xref linkend=\"xmlto\"/> com um ou mais do "
"seguinte: <xref linkend=\"fop\"/>, <xref linkend=\"Links\"/>, <xref "
"linkend=\"lynx\"/>, <ulink "
"url=\"https://github.com/vapier/ncompress\">ncompress</ulink> (para alguns "
"testes) e <ulink url=\"&w3m-url;\">W3m</ulink> (para gerar documentação "
"adicional &quot;PDF&quot; ou texto para o pacote &quot;libXfont&quot;)."

#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/x/installing/x7lib.xml:184
#, xml-text
msgid "Recommended at runtime"
msgstr "Recomendadas em tempo de execução"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/installing/x7lib.xml:186
#, xml-text
msgid "<xref role=\"runtime\" linkend=\"dbus\"/>"
msgstr "<xref role=\"runtime\" linkend=\"dbus\"/>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/x/installing/x7lib.xml:192
#, xml-text
msgid "Downloading Xorg Libraries"
msgstr "Transferindo as Bibliotecas do Xorg"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/installing/x7lib.xml:195
#, xml-text
msgid ""
"First, create a list of files to be downloaded. This file will also be used "
"to verify the integrity of the downloads when complete:"
msgstr ""
"Primeiro, crie uma lista de arquivos a serem baixados. Este arquivo também "
"será usado para verificar a integridade das transferências quando "
"concluídas:"

