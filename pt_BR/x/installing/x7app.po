#. type: Content of: <sect1><title>
#: blfs-en/x/installing/x7app.xml:123 blfs-en/x/installing/x7app.xml:127
#, xml-text
msgid "Xorg Applications"
msgstr "Aplicativos do Xorg"

#. type: Content of: <sect1><indexterm><primary>
#: blfs-en/x/installing/x7app.xml:130
#, xml-text
msgid "Xorg-&xorg-version; Applications"
msgstr "Aplicativos do Xorg-&xorg-version;"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/x/installing/x7app.xml:134
#, xml-text
msgid "Introduction to Xorg Applications"
msgstr "Introdução aos Aplicativos do Xorg"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/installing/x7app.xml:137
#, xml-text
msgid ""
"The <application>Xorg</application> applications provide the expected "
"applications available in previous X Window implementations."
msgstr ""
"Os aplicativos do &quot;<application>Xorg</application>&quot; fornecem os "
"aplicativos esperados disponíveis em implementações anteriores do Janelas "
"&quot;X&quot;."

#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/x/installing/x7app.xml:143
#, xml-text
msgid "Package Information"
msgstr "Informação do Pacote"

#. type: Content of: <sect1><sect2><itemizedlist><listitem><para>
#: blfs-en/x/installing/x7app.xml:147
#, xml-text
msgid "Download (HTTP): <ulink url=\"&x7apps-download-http;\"/>"
msgstr "Transferência (HTTP): <ulink url=\"&x7apps-download-http;\"/>"

#. type: Content of: <sect1><sect2><itemizedlist><listitem><para>
#: blfs-en/x/installing/x7app.xml:152
#, xml-text
msgid "Download (FTP): <ulink url=\"&x7apps-download-ftp;\"/>"
msgstr "Transferência (FTP): <ulink url=\"&x7apps-download-ftp;\"/>"

#. type: Content of: <sect1><sect2><itemizedlist><listitem><para>
#: blfs-en/x/installing/x7app.xml:157
#, xml-text
msgid "Download size: &x7apps-size;"
msgstr "Tamanho da transferência: &x7apps-size;"

#. type: Content of: <sect1><sect2><itemizedlist><listitem><para>
#: blfs-en/x/installing/x7app.xml:162
#, xml-text
msgid "Estimated disk space required: &x7apps-buildsize;"
msgstr "Espaço em disco estimado exigido: &x7apps-buildsize;"

#. type: Content of: <sect1><sect2><itemizedlist><listitem><para>
#: blfs-en/x/installing/x7app.xml:167
#, xml-text
msgid "Estimated build time: &x7apps-time;"
msgstr "Tempo de construção estimado: &x7apps-time;"

#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/x/installing/x7app.xml:172
#, xml-text
msgid "Xorg Applications Dependencies"
msgstr "Dependências dos Aplicativos do &quot;Xorg&quot;"

#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/x/installing/x7app.xml:174
#, xml-text
msgid "Required"
msgstr "Exigidas"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/installing/x7app.xml:176
#, xml-text
msgid ""
"<xref linkend=\"libpng\"/>, <xref linkend=\"mesa\"/>, <xref "
"linkend=\"xbitmaps\"/>, and <xref linkend=\"xcb-util\"/>"
msgstr ""
"<xref linkend=\"libpng\"/>, <xref linkend=\"mesa\"/>, <xref "
"linkend=\"xbitmaps\"/> e <xref linkend=\"xcb-util\"/>"

#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/x/installing/x7app.xml:182
#, xml-text
msgid "Optional"
msgstr "Opcionais"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/installing/x7app.xml:184
#, xml-text
msgid ""
"<xref linkend=\"linux-pam\"/> and both <ulink "
"url=\"https://www.cairographics.org/releases/\">cairo-5c</ulink> and <ulink "
"url=\"https://nickle.org/\">Nickle</ulink> (only if you wish to try to run "
"the undocumented <command>xkeyhost</command> script)."
msgstr ""
"<xref linkend=\"linux-pam\"/> e ambos <ulink "
"url=\"https://www.cairographics.org/releases/\">cairo-5c</ulink> e <ulink "
"url=\"https://nickle.org/\">Nickle</ulink> (somente se você desejar tentar "
"executar o não documentado conjunto de comandos sequenciais "
"<command>xkeyhost</command>)."

#. type: Content of: <sect1><sect2><title>
#: blfs-en/x/installing/x7app.xml:193
#, xml-text
msgid "Downloading Xorg Applications"
msgstr "Transferindo os Aplicativos do Xorg"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/installing/x7app.xml:196
#, xml-text
msgid ""
"First, create a list of files to be downloaded. This file will also be used "
"to verify the integrity of the downloads when complete:"
msgstr ""
"Primeiro, crie uma lista de arquivos a serem transferidos. Esse arquivo "
"também será usado para verificar a integridade das transferências quando "
"concluídas:"

