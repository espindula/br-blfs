#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/installing/xbitmaps.xml:82
#, xml-text
msgid ""
"Install <application>xbitmaps</application> by running the following "
"commands:"
msgstr ""
"Instale o &quot;<application>xbitmaps</application>&quot; executando os "
"seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/x/installing/xbitmaps.xml:86
#, no-wrap, xml-text
msgid "<userinput>./configure $XORG_CONFIG</userinput>"
msgstr "<userinput>./configure $XORG_CONFIG</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/installing/xbitmaps.xml:89
#, xml-text
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/installing/xbitmaps.xml:93
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) &quot;<systemitem "
"class=\"username\">root</systemitem>&quot;:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/x/installing/xbitmaps.xml:96
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

