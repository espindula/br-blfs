#. type: Content of: <sect2><sect3><title>
#: blfs-en/x/installing/intel-media-driver.xml:98
msgid "Installation of intel-media-driver"
msgstr "Instalação do intel-media-driver"

#. type: Content of: <sect2><sect3><note><para>
#: blfs-en/x/installing/intel-media-driver.xml:102
msgid ""
"This package takes a long time to build because it compiles code specific to "
"each individual generation of Intel GPUs and for a variety of media codecs."
msgstr ""
"Este pacote leva muito tempo para construir porque compila código específico "
"para cada geração individual de GPUs Intel e para uma variedade de "
"codificadores de mídia."

#. type: Content of: <sect2><sect3><para>
#: blfs-en/x/installing/intel-media-driver.xml:109
msgid ""
"Install <application>intel-media-driver</application> by running the "
"following commands:"
msgstr ""
"Instale o <application>intel-media-driver</application> executando os "
"seguintes comandos:"

#. type: Content of: <sect2><sect3><screen>
#: blfs-en/x/installing/intel-media-driver.xml:113
#, no-wrap
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -DCMAKE_INSTALL_PREFIX=/usr   \\\n"
"      -DINSTALL_DRIVER_SYSCONF=OFF  \\\n"
"      -DBUILD_TYPE=Release          \\\n"
"      -Wno-dev ..                   &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -DCMAKE_INSTALL_PREFIX=/usr   \\\n"
"      -DINSTALL_DRIVER_SYSCONF=OFF  \\\n"
"      -DBUILD_TYPE=Release          \\\n"
"      -Wno-dev ..                   &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect2><sect3><para>
#: blfs-en/x/installing/intel-media-driver.xml:123
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect2><sect3><para>
#: blfs-en/x/installing/intel-media-driver.xml:127
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem class=\"username\">root</systemitem>:"

#. type: Content of: <sect2><sect3><screen>
#: blfs-en/x/installing/intel-media-driver.xml:130
#, no-wrap
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

