#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/installing/xcb-util-keysyms.xml:88
#, xml-text
msgid ""
"Install <application>xcb-util-keysyms</application> by running the following"
" commands:"
msgstr ""
"Instale o &quot;<application>xcb-util-keysyms</application>&quot; executando"
" os seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/x/installing/xcb-util-keysyms.xml:92
#, no-wrap, xml-text
msgid ""
"<userinput>./configure $XORG_CONFIG &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>./configure $XORG_CONFIG &amp;&amp;\n"
"make</userinput>"

#. To test the results, issue:
#.       <command>
#. LD_LIBRARY_PATH=$XORG_PREFIX/lib make check</command>.
#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/installing/xcb-util-keysyms.xml:96
#, xml-text
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/installing/xcb-util-keysyms.xml:102
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) &quot;<systemitem "
"class=\"username\">root</systemitem>&quot;:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/x/installing/xcb-util-keysyms.xml:105
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

