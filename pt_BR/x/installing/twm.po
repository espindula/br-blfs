#. type: Content of: <sect1><sect2><title>
#: blfs-en/x/installing/twm.xml:87
#, xml-text
msgid "Installation of twm"
msgstr "Instalação do twm"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/installing/twm.xml:90
#, xml-text
msgid ""
"Install <application>twm</application> by running the following commands:"
msgstr ""
"Instale o &quot;<application>twm</application>&quot; executando os seguintes"
" comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/x/installing/twm.xml:94
#, no-wrap, xml-text
msgid ""
"<userinput>sed -i -e '/^rcdir =/s,^\\(rcdir = \\).*,\\1/etc/X11/app-defaults,' src/Makefile.in &amp;&amp;\n"
"./configure $XORG_CONFIG &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>sed -i -e '/^rcdir =/s,^\\(rcdir = \\).*,\\1/etc/X11/app-defaults,' src/Makefile.in &amp;&amp;\n"
"./configure $XORG_CONFIG &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/installing/twm.xml:99
#, xml-text
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/installing/twm.xml:103
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) &quot;<systemitem "
"class=\"username\">root</systemitem>&quot;:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/x/installing/twm.xml:106
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/x/installing/twm.xml:111
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/installing/twm.xml:113
#, xml-text
msgid ""
"<command>sed -i -e '/^rcdir =/s...</command>: This command ensures the "
"<application>twm</application> configuration file gets installed in the "
"proper location."
msgstr ""
"<command>sed -i -e '/^rcdir =/s...</command>: Esse comando garante que o "
"arquivo de configuração do &quot;<application>twm</application>&quot; seja "
"instalado no local apropriado."

