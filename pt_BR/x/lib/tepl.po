#. type: Content of: <sect1><sect2><title>
#: blfs-en/x/lib/tepl.xml:90
#, xml-text
msgid "Installation of Tepl"
msgstr "Instalação do Tepl"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/lib/tepl.xml:93
#, xml-text
msgid ""
"Install <application>Tepl</application> by running the following commands:"
msgstr ""
"Instale o &quot;<application>Tepl</application>&quot; executando os "
"seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/x/lib/tepl.xml:97
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir tepl-build &amp;&amp;\n"
"cd    tepl-build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr       \\\n"
"            --buildtype=release \\\n"
"            -Dgtk_doc=false     \\\n"
"            .. &amp;&amp;\n"
"ninja</userinput>"
msgstr ""
"<userinput>mkdir tepl-build &amp;&amp;\n"
"cd     tepl-build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr       \\\n"
"            --buildtype=release \\\n"
"            -Dgtk_doc=false     \\\n"
"            .. &amp;&amp;\n"
"ninja</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/lib/tepl.xml:107
#, xml-text
msgid "To test the results, issue: <command>ninja test</command>."
msgstr "Para testar os resultados, emita: <command>ninja test</command>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/lib/tepl.xml:111
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) &quot;<systemitem "
"class=\"username\">root</systemitem>&quot;:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/x/lib/tepl.xml:114
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr "<userinput>ninja install</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/x/lib/tepl.xml:118
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/lib/tepl.xml:124
#, xml-text
msgid ""
"<parameter>-Dgtk_doc=false</parameter>: Disables building the API "
"documentation. Remove if you have <xref linkend=\"gtk-doc\"/> installed and "
"wish to build the API documentation."
msgstr ""
"<parameter>-Dgtk_doc=false</parameter>: Desabilita a construção da "
"documentação da &quot;API&quot;. Remova se você tiver o &quot;<xref "
"linkend=\"gtk-doc\"/>&quot; instalado e desejar construir a documentação da "
"&quot;API&quot;."

