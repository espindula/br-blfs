#. type: Content of: <sect1><sect2><title>
#: blfs-en/x/lib/tepl.xml:27
#, xml-text
msgid "Introduction to Tepl"
msgstr "Introdução ao Tepl"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/lib/tepl.xml:30
#, xml-text
msgid ""
"The <application>Tepl</application> package contains a library that eases "
"the development of GtkSourceView-based text editors and IDEs."
msgstr ""
"O pacote &quot;<application>Tepl</application>&quot; contém uma biblioteca "
"que facilita o desenvolvimento de editores de texto e &quot;IDEs&quot; "
"baseados em &quot;GtkSourceView&quot;."

