#. type: Content of: <sect1><sect2><title>
#: blfs-en/x/lib/gtksourceview.xml:98
#, xml-text
msgid "Installation of GtkSourceView"
msgstr "Instalação do GtkSourceView"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/lib/gtksourceview.xml:101
#, xml-text
msgid ""
"Install <application>GtkSourceView</application> by running the following "
"commands:"
msgstr ""
"Instale o &quot;<application>GtkSourceView</application>&quot; executando os"
" seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/x/lib/gtksourceview.xml:105
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>./configure --prefix=/usr &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/lib/gtksourceview.xml:110
#, xml-text
msgid ""
"To test the results, issue <command>make check</command>. The tests need to "
"be run in a graphical environment."
msgstr ""
"Para testar os resultados, emita &quot;<command>make check</command>&quot;. "
"Os testes precisam ser executados em um ambiente gráfico."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/lib/gtksourceview.xml:115
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) &quot;<systemitem "
"class=\"username\">root</systemitem>&quot;:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/x/lib/gtksourceview.xml:118
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

