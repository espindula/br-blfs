#. type: Content of: <sect1><sect2><title>
#: blfs-en/x/lib/kcolorpicker.xml:81
#, xml-text
msgid "Installation of kColorPicker"
msgstr "Instalação do kColorPicker"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/lib/kcolorpicker.xml:84
#, xml-text
msgid ""
"Install <application>kColorPicker</application> by running the following "
"commands:"
msgstr ""
"Instale o &quot;<application>kColorPicker</application>&quot; executando os "
"seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/x/lib/kcolorpicker.xml:88
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -DCMAKE_INSTALL_PREFIX=/usr \\\n"
"      -DCMAKE_BUILD_TYPE=Release  \\\n"
"      -DBUILD_SHARED_LIBS=ON      \\\n"
"      -DBUILD_WITH_QT6=ON         \\\n"
"      .. &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -DCMAKE_INSTALL_PREFIX=/usr \\\n"
"      -DCMAKE_BUILD_TYPE=Release  \\\n"
"      -DBUILD_SHARED_LIBS=ON      \\\n"
"      -DBUILD_WITH_QT6=ON         \\\n"
"      .. &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/lib/kcolorpicker.xml:99
#, xml-text
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/lib/kcolorpicker.xml:103
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
