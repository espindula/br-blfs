#: blfs-en/x/lib/kimageannotator.xml:78
#, xml-text
msgid "Installation of kImageAnnotator"
msgstr "Instalação do kImageAnnotator"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/lib/kimageannotator.xml:81
#, xml-text
msgid ""
"Install <application>kImageAnnotator</application> by running the following "
"commands:"
msgstr ""
"Instale o &quot;<application>kImageAnnotator</application>&quot; executando "
"os seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/x/lib/kimageannotator.xml:85
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr \\\n"
"      -D CMAKE_BUILD_TYPE=Release  \\\n"
"      -D BUILD_SHARED_LIBS=ON      \\\n"
"      -D BUILD_WITH_QT6=ON         \\\n"
"      .. &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr \\\n"
"      -D CMAKE_BUILD_TYPE=Release  \\\n"
"      -D BUILD_SHARED_LIBS=ON      \\\n"
"      -D BUILD_WITH_QT6=ON         \\\n"
"      .. &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/lib/kimageannotator.xml:96
#, xml-text
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/lib/kimageannotator.xml:100
#, xml-text
msgid "Now, as the &root; user:"
msgstr "Agora, como o(a) usuário(a) &root;:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/x/lib/kimageannotator.xml:103
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

