#. type: Content of: <sect1><sect2><title>
#: blfs-en/x/lib/colord-gtk.xml:94
#, xml-text
msgid "Installation of Colord GTK"
msgstr "Instalação do Colord GTK"

#. type: Content of: <sect1><sect2><warning><para>
#: blfs-en/x/lib/colord-gtk.xml:98
#, xml-text
msgid ""
"If building the documentation <command>ninja -j1</command> must be used."
msgstr ""
"Se construir a documentação, [então] &quot;<command>ninja "
"-j1</command>&quot; precisa ser usado."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/lib/colord-gtk.xml:103
#, xml-text
msgid ""
"Install <application>Colord GTK</application> by running the following "
"commands:"
msgstr ""
"Instale o &quot;<application>Colord GTK</application>&quot; executando os "
"seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/x/lib/colord-gtk.xml:107
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr       \\\n"
"            --buildtype=release \\\n"
"            -Dgtk4=true         \\\n"
"            -Dvapi=true         \\\n"
"            -Ddocs=false        \\\n"
"            -Dman=false         \\\n"
"            ..                  &amp;&amp;\n"
"ninja</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr       \\\n"
"            --buildtype=release \\\n"
"            -Dgtk4=true         \\\n"
"            -Dvapi=true         \\\n"
"            -Ddocs=false        \\\n"
"            -Dman=false         \\\n"
"            ..                  &amp;&amp;\n"
"ninja</userinput>"

#.  on an ASUS 32" IPS display, I have a color profile and it works
#.            properly. On the other hand, with a Dell SP2208WFP LCD,
#.            no color profile is available and the tests fail. It seems to
#.            depend on the system/display.
#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/lib/colord-gtk.xml:120
#, xml-text
msgid ""
"To test the results, issue: <command>ninja test</command>.  The tests need "
"to be run from an X session, and may require a color profile for your "
"primary display."
msgstr ""
"Para testar os resultados, emita: &quot;<command>ninja test</command>&quot;."
" Os testes precisam ser executados a partir de uma sessão do &quot;X&quot; e"
" possivelmente exijam um perfil de cores para o teu monitor principal."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/lib/colord-gtk.xml:130
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) &quot;<systemitem "
"class=\"username\">root</systemitem>&quot;:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/x/lib/colord-gtk.xml:133
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr "<userinput>ninja install</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/x/lib/colord-gtk.xml:137
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/lib/colord-gtk.xml:143
#, xml-text
msgid ""
"<parameter>-Dvapi=true</parameter>: This switch enables building of the Vala"
" bindings. Remove this switch if you don't have <xref linkend=\"vala\" "
"role=\"nodep\"/> installed."
msgstr ""
"<parameter>-Dvapi=true</parameter>: Essa chave habilita a construção das "
"ligações &quot;Vala&quot;. Remova essa chave se você não tiver o &quot;<xref"
" linkend=\"vala\" role=\"nodep\"/>&quot; instalado."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/lib/colord-gtk.xml:149
#, xml-text
msgid ""
"<parameter>-Dgtk4=true</parameter>: This switch enables building the GTK-4 "
"bindings for colord. Set this option to 'false' if you do not have <xref "
"linkend=\"gtk4\" role=\"nodep\"/> installed."
msgstr ""
"<parameter>-Dgtk4=true</parameter>: Essa chave habilita construir as "
"ligações &quot;GTK-4&quot; para &quot;colord&quot;. Configure essa opção "
"como &quot;false&quot; se você não tiver o &quot;<xref linkend=\"gtk4\" "
"role=\"nodep\"/>&quot; instalado."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/lib/colord-gtk.xml:155
#, xml-text
msgid ""
"<parameter>-Ddocs=false</parameter>: This switch disables building gtk-doc "
"based documentation. Even if gtk-doc is installed, you will need the "
"namespaced versions of the Docbook XSL stylesheets."
msgstr ""
"<parameter>-Ddocs=false</parameter>: Essa chave desabilita a construção de "
"documentação baseada em &quot;gtk-doc&quot;. Mesmo se o &quot;gtk-doc&quot; "
"estiver instalado, você precisará das versões com &quot;namespace&quot; das "
"folhas de estilo &quot;XSL&quot; do &quot;Docbook&quot;."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/lib/colord-gtk.xml:161
#, xml-text
msgid ""
"<parameter>-Dman=false</parameter>: This switch disables generating the "
"manual pages for this package. Remove this switch if you have namespaced "
"versions of the Docbook XSL stylesheets installed."
msgstr ""
"<parameter>-Dman=false</parameter>: Essa chave desabilita a geração de "
"páginas de manual para esse pacote. Remova essa chave se você tiver versões "
"com &quot;namespace&quot; das folhas de estilo &quot;XSL&quot; do "
"&quot;Docbook&quot; instaladas."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/lib/colord-gtk.xml:167
#, xml-text
msgid ""
"<option>-Dgtk2=true</option>: This switch enables building the GTK+-2 "
"bindings for colord. However since gtk2 is deprecated it is not recommended "
"to build these bindings."
msgstr ""
"<option>-Dgtk2=true</option>: Essa chave habilita construir as ligações "
"GTK+-2 para colord. Entretanto, como gtk2 está obsoleto, não é recomendado "
"construir essas ligações."

