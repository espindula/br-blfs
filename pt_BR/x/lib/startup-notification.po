#. type: Content of: <sect1><sect2><title>
#: blfs-en/x/lib/startup-notification.xml:84
#, xml-text
msgid "Installation of startup-notification"
msgstr "Instalação do startup-notification"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/lib/startup-notification.xml:87
#, xml-text
msgid ""
"Install <application>startup-notification</application> by running the "
"following commands:"
msgstr ""
"Instale o &quot;<application>startup-notification</application>&quot; "
"executando os seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/x/lib/startup-notification.xml:91
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr --disable-static &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>./configure --prefix=/usr --disable-static &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/lib/startup-notification.xml:95
#, xml-text
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/lib/startup-notification.xml:99
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) &quot;<systemitem "
"class=\"username\">root</systemitem>&quot;:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/x/lib/startup-notification.xml:102
#, no-wrap, xml-text
msgid ""
"<userinput>make install &amp;&amp;\n"
"install -v -m644 -D doc/startup-notification.txt \\\n"
"    /usr/share/doc/startup-notification-&startup-notification-version;/startup-notification.txt</userinput>"
msgstr ""
"<userinput>make install &amp;&amp;\n"
"install -v -m644 -D doc/startup-notification.txt \\\n"
"     /usr/share/doc/startup-notification-&startup-notification-version;/startup-notification.txt</userinput>"

