#. type: Content of: <sect1><sect2><title>
#: blfs-en/x/lib/vulkan-loader.xml:87
#, xml-text
msgid "Installation of Vulkan-Loader"
msgstr "Instalação do Vulkan-Loader"

#. type: Content of: <sect1><sect2><note><para>
#: blfs-en/x/lib/vulkan-loader.xml:91
#, xml-text
msgid ""
"If this package is being installed on a system where Mesa has already been "
"installed previously, please rebuild <xref linkend=\"mesa\"/> after this "
"package to install Vulkan graphics drivers."
msgstr ""
"Se esse pacote estiver sendo instalado em um sistema onde Mesa já tenha sido "
"instalado anteriormente, por favor, reconstrua <xref linkend=\"mesa\"/> "
"depois desse pacote para instalar os controladores gráficos do Vulkan."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/lib/vulkan-loader.xml:98
#, xml-text
msgid ""
"Install <application>Vulkan-Loader</application> by running the following "
"commands:"
msgstr ""
"Instale <application>Vulkan-Loader</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/x/lib/vulkan-loader.xml:102
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -DCMAKE_INSTALL_PREFIX=/usr       \\\n"
"      -DCMAKE_BUILD_TYPE=Release        \\\n"
"      -DCMAKE_SKIP_RPATH=TRUE           \\\n"
"      -G Ninja .. &amp;&amp;\n"
"ninja</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -DCMAKE_INSTALL_PREFIX=/usr       \\\n"
"      -DCMAKE_BUILD_TYPE=Release        \\\n"
"      -DCMAKE_SKIP_RPATH=TRUE           \\\n"
"      -G Ninja .. &amp;&amp;\n"
"ninja</userinput>"

#.  To run the tests, we need to follow a complex process to download a
#.       customized copy of googletest.
#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/lib/vulkan-loader.xml:112
#, xml-text
msgid "This package does not come with a working test suite."
msgstr "Esse pacote não vem com uma suíte de teste funcional."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/lib/vulkan-loader.xml:118
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/x/lib/vulkan-loader.xml:121
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr "<userinput>ninja install</userinput>"

