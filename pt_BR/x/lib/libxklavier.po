#: blfs-en/x/lib/libxklavier.xml:93
#, xml-text
msgid "Installation of libxklavier"
msgstr "Instalação do libxklavier"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/lib/libxklavier.xml:96
#, xml-text
msgid ""
"Install <application>libxklavier</application> by running the following "
"commands:"
msgstr ""
"Instale o &quot;<application>libxklavier</application>&quot; executando os "
"seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/x/lib/libxklavier.xml:100
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr --disable-static &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>./configure --prefix=/usr --disable-static &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/lib/libxklavier.xml:104
#, xml-text
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/lib/libxklavier.xml:108
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) &quot;<systemitem "
"class=\"username\">root</systemitem>&quot;:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/x/lib/libxklavier.xml:111
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

