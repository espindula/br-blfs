"\n"
"# Termina /etc/profile.d/qt5.sh</literal>\n"
"EOF</userinput>"

#. type: Content of: <sect1><sect2><sect3><bridgehead>
#: blfs-en/x/lib/qt5.xml:561
#, xml-text
