#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/x/lib/xdg-desktop-portal.xml:76
#, xml-text
msgid "xdg-desktop-portal Dependencies"
msgstr "Dependências do xdg-desktop-portal"

#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/x/lib/xdg-desktop-portal.xml:78
#, xml-text
msgid "Required"
msgstr "Exigidas"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/lib/xdg-desktop-portal.xml:80
#, xml-text
msgid ""
"<xref linkend=\"fuse3\"/>, <xref linkend=\"gdk-pixbuf\"/>, <xref "
"linkend=\"json-glib\"/>, <xref linkend=\"pipewire\"/>, and <xref "
"role=\"runtime\" linkend=\"dbus\"/> (at runtime).  Furthermore, a backend is"
" needed at runtime for this package to be of any use, either <xref "
"role=\"runtime\" linkend=\"xdg-desktop-portal-gtk\"/> or <xref "
"role=\"nodep\" linkend=\"xdg-desktop-portal-gnome\"/> or <xref "
"role=\"nodep\" linkend=\"xdg-desktop-portal-lxqt\"/>"
msgstr ""
"<xref linkend=\"fuse3\"/>, <xref linkend=\"gdk-pixbuf\"/>, <xref linkend"
"=\"json-glib\"/>, <xref linkend=\"pipewire\"/> e <xref role=\"runtime\" "
"linkend=\"dbus\"/> (em tempo de execução). Além disso, uma estrutura de "
"retaguarda é necessária em tempo de execução para esse pacote ser de algum "
"uso, seja <xref role=\"runtime\" linkend=\"xdg-desktop-portal-gtk\"/>, seja "
"<xref role=\"nodep\" linkend=\"xdg-desktop-portal-gnome\"/> ou <xref role="
"\"nodep\" linkend=\"xdg-desktop-portal-lxqt\"/>"

