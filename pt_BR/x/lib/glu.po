#: blfs-en/x/lib/glu.xml:79
#, xml-text
msgid "Installation of GLU"
msgstr "Instalação do GLU"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/lib/glu.xml:82
#, xml-text
msgid ""
"Install <application>GLU</application> by running the following commands:"
msgstr ""
"Instale o &quot;<application>GLU</application>&quot; executando os seguintes"
" comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/x/lib/glu.xml:86
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup ..              \\\n"
"      --prefix=$XORG_PREFIX \\\n"
"      -Dgl_provider=gl      \\\n"
"      --buildtype=release   &amp;&amp;\n"
"ninja</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup ..              \\\n"
"      --prefix=$XORG_PREFIX \\\n"
"      -Dgl_provider=gl      \\\n"
"      --buildtype=release   &amp;&amp;\n"
"ninja</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/lib/glu.xml:96
#, xml-text
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/lib/glu.xml:100
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) &quot;<systemitem "
"class=\"username\">root</systemitem>&quot;:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/x/lib/glu.xml:103
#, no-wrap, xml-text
msgid ""
"<userinput>ninja install &amp;&amp;\n"
"rm -vf /usr/lib/libGLU.a</userinput>"
msgstr ""
"<userinput>ninja install &amp;&amp;\n"
"rm -vf /usr/lib/libGLU.a</userinput>"

