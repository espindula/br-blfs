#. type: Content of: <sect1><sect2><title>
#: blfs-en/x/lib/libei.xml:25
#, xml-text
msgid "Introduction to libei"
msgstr "Introdução ao libei"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/lib/libei.xml:28
#, xml-text
msgid ""
"The <application>libei</application> package contains a set of libraries for"
" handling emulated inputs. It is primarily aimed at the Wayland stack."
msgstr ""
"O pacote <application>libei</application> contém um conjunto de bibliotecas "
"para manusear entradas emuladas. Destina-se principalmente para a pilha do "
"Wayland."

