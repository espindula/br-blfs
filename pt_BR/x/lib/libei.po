#. type: Content of: <sect1><sect2><title>
#: blfs-en/x/lib/libei.xml:86
#, xml-text
msgid "Installation of libei"
msgstr "Instalação do libei"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/lib/libei.xml:89
#, xml-text
msgid ""
"Install <application>libei</application> by running the following commands:"
msgstr ""
"Instale <application>libei</application> executando os seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/x/lib/libei.xml:93
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr --buildtype=release -Dtests=disabled .. &amp;&amp;\n"
"ninja</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr --buildtype=release -Dtests=disabled .. &amp;&amp;"
"\n"
"ninja</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/lib/libei.xml:100
#, xml-text
msgid ""
"This package does come with a test suite, but it requires an external "
"dependency. If you have <ulink "
"url=\"https://github.com/nemequ/munit\">munit</ulink> installed and wish to "
"run the test suite, run the following commands:"
msgstr ""
"Esse pacote vem com uma suíte de teste, mas ele exige uma dependência "
"externa. Se você tiver o <ulink url=\"https://github.com/nemequ/munit\""
">munit</ulink> instalado e desejar executar a suíte de teste, execute os "
"seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/x/lib/libei.xml:106
#, no-wrap, xml-text
msgid ""
"<userinput>meson configure -Dtests=enabled .. &amp;&amp;\n"
"ninja test</userinput>"
msgstr ""
"<userinput>meson configure -Dtests=enabled .. &amp;&amp;\n"
"ninja test</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/lib/libei.xml:110
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/x/lib/libei.xml:113
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr "<userinput>ninja install</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/x/lib/libei.xml:118
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/lib/libei.xml:124
#, xml-text
msgid ""
"<parameter>-Dtests=disabled</parameter>: This switch avoids a dependency on "
"<ulink url=\"https://github.com/nemequ/munit\">munit</ulink>. Remove this "
"switch if you have <application>munit</application> installed and wish to "
"run the test suite."
msgstr ""
"<parameter>-Dtests=disabled</parameter>: Essa chave evita uma dependência em "
"relação a <ulink url=\"https://github.com/nemequ/munit\">munit</ulink>. "
"Remova essa chave se você tiver o <application>munit</application> instalado "
"e desejar executar a suíte de teste."

