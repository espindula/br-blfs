#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/lib/gtk4.xml:85
#, xml-text
msgid ""
"<xref linkend=\"adwaita-icon-theme\"/> (default for some gtk4 settings "
"keys), <xref linkend=\"gst10-plugins-bad\"/>, <xref role='runtime' "
"linkend=\"gst10-plugins-good\"/> (runtime, built with <xref role='nodep' "
"linkend='libvpx'/>), <xref linkend=\"hicolor-icon-theme\"/> (needed for "
"tests and for defaults), and <xref linkend=\"librsvg\"/>"
