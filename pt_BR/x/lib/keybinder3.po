#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/lib/keybinder3.xml:30
#, xml-text
msgid ""
"The <application>keybinder-3.0</application> package contains a utility "
"library registering global <application>X</application> keyboard shortcuts "
"for <application>GTK+-3</application>."
msgstr ""
"O pacote &quot;<application>keybinder-3.0</application>&quot; contém uma "
"biblioteca de utilitários registrando atalhos globais de teclado do "
"&quot;<application>X</application>&quot; para o "
"&quot;<application>GTK+-3</application>&quot;."

