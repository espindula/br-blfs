#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/lib/keybinder3.xml:94
#, xml-text
msgid ""
"Install <application>keybinder-3.0</application> by running the following "
"commands:"
msgstr ""
"Instale o &quot;<application>keybinder-3.0</application>&quot; executando os"
" seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/x/lib/keybinder3.xml:98
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>./configure --prefix=/usr &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/lib/keybinder3.xml:102
#, xml-text
msgid "This package does not come with a test suite."
