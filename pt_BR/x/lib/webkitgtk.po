#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/lib/webkitgtk.xml:29
#, xml-text
msgid ""
"The <application>WebKitGTK</application> package is a port of the portable "
"web rendering engine <application>WebKit</application> to the "
"<application>GTK+ 3</application> and <application>GTK 4</application> "
"platforms."
msgstr ""
"O pacote &quot;<application>WebKitGTK</application>&quot; é uma porta do "
"mecanismo de renderização &quot;web&quot; portável "
"&quot;<application>WebKit</application>&quot; para as plataformas "
"&quot;<application>GTK+ 3</application>&quot; e &quot;<application>GTK "
"4</application>&quot;."

