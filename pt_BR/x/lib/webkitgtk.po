#| "      -DLIB_INSTALL_DIR=/usr/lib  \\\n"
#| "      -DUSE_LIBHYPHEN=OFF         \\\n"
#| "      -DENABLE_GAMEPAD=OFF        \\\n"
#| "      -DENABLE_MINIBROWSER=ON     \\\n"
#| "      -DENABLE_DOCUMENTATION=OFF  \\\n"
#| "      -DUSE_WOFF2=OFF             \\\n"
#| "      -DUSE_GTK4=OFF              \\\n"
#| "      -DUSE_WPE_RENDERER=ON       \\\n"
#| "      -DUSE_JPEGXL=OFF            \\\n"
#| "      -DENABLE_BUBBLEWRAP_SANDBOX=ON \\\n"
#| "      -Wno-dev -G Ninja ..        &amp;&amp;\n"
