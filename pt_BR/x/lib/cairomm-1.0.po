#. type: Content of: <sect1><sect2><title>
#: blfs-en/x/lib/cairomm-1.0.xml:90
#, xml-text
msgid "Installation of libcairomm-1.0"
msgstr "Instalação do libcairomm-1.0"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/lib/cairomm-1.0.xml:93
#, xml-text
msgid ""
"Install <application>Cairomm-1.0</application> by running the following "
"commands:"
msgstr ""
"Instale o &quot;<application>Cairomm-1.0</application>&quot; executando os "
"seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/x/lib/cairomm-1.0.xml:97
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir bld &amp;&amp;\n"
"cd    bld &amp;&amp;\n"
"\n"
"meson setup ..            \\\n"
"      --prefix=/usr       \\\n"
"      --buildtype=release \\\n"
"      -Dbuild-tests=true  \\\n"
"      -Dboost-shared=true &amp;&amp;\n"
"ninja</userinput>"
msgstr ""
"<userinput>mkdir bld &amp;&amp;\n"
"cd    bld &amp;&amp;\n"
"\n"
"meson setup ..            \\\n"
"      --prefix=/usr       \\\n"
"      --buildtype=release \\\n"
"      -Dbuild-tests=true  \\\n"
"      -Dboost-shared=true &amp;&amp;\n"
"ninja</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/lib/cairomm-1.0.xml:108
#, xml-text
msgid "To run the test suite, run: <command>ninja test</command>."
msgstr ""
"Para executar a suíte de teste, execute: &quot;<command>ninja "
"test</command>&quot;."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/lib/cairomm-1.0.xml:112
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) &quot;<systemitem "
"class=\"username\">root</systemitem>&quot;:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/x/lib/cairomm-1.0.xml:115
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr "<userinput>ninja install</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/x/lib/cairomm-1.0.xml:120
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/lib/cairomm-1.0.xml:123
#, xml-text
msgid ""
"<parameter>-Dbuild-tests=true</parameter>: This switch is for building the "
"unit tests. Remove if you have not installed <xref linkend=\"boost\"/>."
msgstr ""
"<parameter>-Dbuild-tests=true</parameter>: Essa chave é para construir os "
"testes de unidade. Remova se você não tiver instalado o &quot;<xref "
"linkend=\"boost\"/>&quot;."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/lib/cairomm-1.0.xml:128
#, xml-text
msgid ""
"<parameter>-Dboost-shared=true</parameter>: This switch has the package use "
"the shared version of boost libraries. It is required if you have not "
"installed the boost static libraries, and you have passed "
"<parameter>-Dbuild-tests=true</parameter>."
msgstr ""
"<parameter>-Dboost-shared=true</parameter>: Essa chave faz o pacote usar a "
"versão compartilhada das bibliotecas &quot;boost&quot;. Ela é exigida se "
"você não tiver instalado as bibliotecas estáticas &quot;boost&quot; e tiver "
"passado &quot;<parameter>-Dbuild-tests=true</parameter>&quot;."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/lib/cairomm-1.0.xml:135
#, xml-text
msgid ""
"<option>-Dbuild-documentation=true</option>: This switch builds the html "
"documentation if doxygen is installed."
msgstr ""
"<option>-Dbuild-documentation=true</option>: Essa chave constrói a "
"documentação &quot;HTML&quot; se o &quot;Doxygen&quot; estiver instalado."

