#. type: Content of: <sect1><sect2><title>
#: blfs-en/x/icons/lxde-icon-theme.xml:80
#, xml-text
msgid "Installation of LXDE Icon Theme"
msgstr "Instalação do Tema de Ícones do LXDE"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/icons/lxde-icon-theme.xml:83
#, xml-text
msgid ""
"Install <application>LXDE Icon Theme</application> by running the following "
"commands:"
msgstr ""
"Instale o &quot;<application>Tema de Ícone do LXDE</application>&quot; "
"executando os seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/x/icons/lxde-icon-theme.xml:87
#, no-wrap, xml-text
msgid "<userinput>./configure --prefix=/usr</userinput>"
msgstr "<userinput>./configure --prefix=/usr</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/icons/lxde-icon-theme.xml:90
#, xml-text
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/icons/lxde-icon-theme.xml:94
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) &quot;<systemitem "
"class=\"username\">root</systemitem>&quot;:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/x/icons/lxde-icon-theme.xml:97
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/icons/lxde-icon-theme.xml:100
#, xml-text
msgid ""
"If you have installed one of the optional dependencies, run the following "
"command as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Se você tiver instalado uma das dependências opcionais, [então] execute o "
"seguinte comando como o(a) usuário(a) &quot;<systemitem "
"class=\"username\">root</systemitem>&quot;:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/x/icons/lxde-icon-theme.xml:104
#, no-wrap, xml-text
msgid ""
"<userinput>gtk-update-icon-cache -qf /usr/share/icons/nuoveXT2</userinput>"
msgstr ""
"<userinput>gtk-update-icon-cache -qf /usr/share/icons/nuoveXT2</userinput>"

