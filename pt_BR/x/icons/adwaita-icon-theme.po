#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/x/icons/adwaita-icon-theme.xml:70
#, xml-text
msgid "Adwaita Icon Theme Dependencies"
msgstr "Dependências do &quot;Tema de Ícone Adwaita&quot;"

#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/x/icons/adwaita-icon-theme.xml:72
#, xml-text
msgid "Required"
msgstr "Exigidas"

#.  Meson now unconditionally runs gtk-update-icon-cache and
#.            gtk-encode-symbolic-svg after installing. See
#.            https://lists.linuxfromscratch.org/sympa/arc/blfs-
#. dev/2023-09/msg00128.html
#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/icons/adwaita-icon-theme.xml:74
#, xml-text
msgid ""
"<xref linkend=\"gtk3\"/> or <xref role=\"nodep\" linkend=\"gtk4\"/>, and "
"<xref linkend=\"librsvg\"/>"
msgstr ""
"<xref linkend=\"gtk3\"/> ou <xref role=\"nodep\" linkend=\"gtk4\"/> e <xref "
"linkend=\"librsvg\"/>"

#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/x/icons/adwaita-icon-theme.xml:81
#, xml-text
msgid "Optional"
msgstr "Opcionais"

#.       <xref linkend="gtk4"/>
#.  or <xref linkend="gtk3"/>
#.       (if present, <xref linkend="librsvg"/> is also
#.       required, and <command>gtk-update-icon-cache
#.       </command> and <command>gtk-encode-symbolic-svg</command> are run
#.       after installing),
#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/icons/adwaita-icon-theme.xml:83
#, xml-text
msgid ""
"<xref linkend=\"git\"/>, <xref linkend=\"inkscape\"/>, and <ulink "
"url=\"https://launchpad.net/icontool/\">Icon Tools</ulink>"
msgstr ""
"<xref linkend=\"git\"/>, <xref linkend=\"inkscape\"/> e <ulink "
"url=\"https://launchpad.net/icontool/\">Ferramentas de Ícones</ulink>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/x/icons/adwaita-icon-theme.xml:98
#, xml-text
msgid "Installation of Adwaita Icon Theme"
msgstr "Instalação do Tema de Ícones Adwaita"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/icons/adwaita-icon-theme.xml:101
#, xml-text
msgid ""
"Install <application>Adwaita Icon Theme</application> by running the "
"following commands:"
msgstr ""
"Instale o &quot;<application>Tema de Ícone Adwaita</application>&quot; "
"executando os seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/x/icons/adwaita-icon-theme.xml:105
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr .. &amp;&amp;\n"
"ninja</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr .. &amp;&amp;\n"
"ninja</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/icons/adwaita-icon-theme.xml:112
#, xml-text
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/icons/adwaita-icon-theme.xml:116
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) &quot;<systemitem "
"class=\"username\">root</systemitem>&quot;:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/x/icons/adwaita-icon-theme.xml:119
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr "<userinput>ninja install</userinput>"

