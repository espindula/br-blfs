#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/icons/adwaita-icon-theme.xml:29
#, xml-text
msgid ""
"The <application>Adwaita Icon Theme</application> package contains an icon "
"theme for <application>GTK+ 3</application> and <application>GTK "
"4</application> applications."
msgstr ""
"O pacote <application>Tema de Ícones Adwaita</application> contém um tema de"
" ícones para aplicativos <application>GTK+ 3</application> e "
"<application>GTK 4</application>."

