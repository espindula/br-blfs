msgstr "Dependências do &quot;oxygen-icons5&quot;"

#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/x/icons/oxygen-icons5.xml:71
msgid "Required"
msgstr "Exigidas"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/icons/oxygen-icons5.xml:73
msgid "<xref linkend=\"extra-cmake-modules\"/> and &qt5-deps;"
msgstr "<xref linkend=\"extra-cmake-modules\"/> e &qt5-deps;"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/x/icons/oxygen-icons5.xml:81
msgid "Installation of oxygen-icons5"
msgstr "Instalação do <quote>oxygen-icons5</quote>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/icons/oxygen-icons5.xml:84
msgid "First, enable scalable icons:"
msgstr "Primeiro, habilite ícones escalonáveis:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/x/icons/oxygen-icons5.xml:87
#, no-wrap
msgid ""
"<userinput>sed -i '/( oxygen/ s/)/scalable )/' CMakeLists.txt</userinput>"
msgstr ""
"<userinput>sed -i '/( oxygen/ s/)/scalable )/' CMakeLists.txt</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/icons/oxygen-icons5.xml:90
msgid ""
"Install <application>oxygen-icons5</application> by running the following "
"commands:"
msgstr ""
"Instale o &quot;<application>oxygen-icons5</application>&quot; executando os"
" seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/x/icons/oxygen-icons5.xml:94
#, no-wrap
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -DCMAKE_INSTALL_PREFIX=/usr -Wno-dev ..</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd     build &amp;&amp;\n"
"\n"
"cmake -DCMAKE_INSTALL_PREFIX=/usr -Wno-dev ..</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/icons/oxygen-icons5.xml:100
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/icons/oxygen-icons5.xml:104
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/x/icons/oxygen-icons5.xml:107
#, no-wrap
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

