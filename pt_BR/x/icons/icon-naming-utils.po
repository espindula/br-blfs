#, xml-text
msgid "Introduction to icon-naming-utils"
msgstr "Introdução ao icon-naming-utils"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/icons/icon-naming-utils.xml:30
#, xml-text
msgid ""
"The <application>icon-naming-utils</application> package contains a "
"<application>Perl</application> script used for maintaining backwards "
"compatibility with current desktop icon themes, while migrating to the names"
" specified in the <ulink url=\"https://specifications.freedesktop.org/icon-"
"naming-spec/latest/\"> Icon Naming Specification</ulink>."
msgstr ""
"O pacote &quot;<application>icon-naming-utils</application>&quot; contém um "
"conjunto de comandos sequenciais &quot;<application>Perl</application>&quot;"
" usado para manter a compatibilidade retroativa com os atuais temas de "
"ícones de área de trabalho, enquanto migra para os nomes especificados na "
"<ulink url=\"https://specifications.freedesktop.org/icon-naming-"
"spec/latest/\">Especificação de Nomenclatura de Ícones</ulink>."

