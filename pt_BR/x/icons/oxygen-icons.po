#. type: Content of: <sect1><sect2><title>
#: blfs-en/x/icons/oxygen-icons.xml:81
#, xml-text
msgid "Installation of oxygen-icons"
msgstr "Instalação do oxygen-icons"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/icons/oxygen-icons.xml:84
#, xml-text
msgid "First, enable scalable icons:"
msgstr "Primeiro, habilite ícones escalonáveis:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/x/icons/oxygen-icons.xml:87
#, no-wrap, xml-text
msgid ""
"<userinput>sed -i '/( oxygen/ s/)/scalable )/' CMakeLists.txt</userinput>"
msgstr ""
"<userinput>sed -i '/( oxygen/ s/)/scalable )/' CMakeLists.txt</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/icons/oxygen-icons.xml:90
#, xml-text
msgid ""
"Install <application>oxygen-icons</application> by running the following "
"commands:"
msgstr ""
"Instale <application>oxygen-icons</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/x/icons/oxygen-icons.xml:94
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -DCMAKE_INSTALL_PREFIX=/usr -Wno-dev ..</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -DCMAKE_INSTALL_PREFIX=/usr -Wno-dev ..</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/icons/oxygen-icons.xml:100
#, xml-text
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/icons/oxygen-icons.xml:104
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/x/icons/oxygen-icons.xml:107
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

