#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/graphlib/potrace.xml:80
#, xml-text
msgid "Installation of Potrace"
msgstr "Instalação do Potrace"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/potrace.xml:83
#, xml-text
msgid ""
"Install <application>Potrace</application> by running the following "
"commands:"
msgstr ""
"Instale <application>Potrace</application> executando os seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/graphlib/potrace.xml:87
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr                        \\\n"
"            --disable-static                     \\\n"
"            --docdir=/usr/share/doc/potrace-&potrace-version; \\\n"
"            --enable-a4                          \\\n"
"            --enable-metric                      \\\n"
"            --with-libpotrace                    &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>./configure --prefix=/usr                       \\\n"
"            --disable-static                     \\\n"
"            --docdir=/usr/share/doc/potrace-&potrace-version; \\\n"
"            --enable-a4                          \\\n"
"            --enable-metric                      \\\n"
"            --with-libpotrace                    &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/potrace.xml:96
#, xml-text
msgid "To run the test suite, issue: <command>make check</command>."
msgstr "Para executar a suíte de teste, emita: <command>make check</command>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/potrace.xml:100
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/graphlib/potrace.xml:103
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/graphlib/potrace.xml:108
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/potrace.xml:111
#, xml-text
msgid "<parameter>--enable-a4</parameter>: Use A4 as the default paper size."
msgstr ""
"<parameter>--enable-a4</parameter>: Use \"A4\" como tamanho padrão de papel."

#.  american spelling as in the configure script
#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/potrace.xml:116
#, xml-text
msgid ""
"<parameter>--enable-metric</parameter>: Use metric units (centimeters)  as "
"default"
msgstr ""
"<parameter>--enable-metric</parameter>: Use unidades métricas (centímetros) "
"como padrão"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/potrace.xml:124
#, xml-text
msgid ""
"<parameter>--with-libpotrace</parameter>: Install the library and headers."
msgstr ""
"<parameter>--with-libpotrace</parameter>: Instale a biblioteca e os "
"cabeçalhos."

