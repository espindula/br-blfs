#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/graphlib/libmng.xml:81
#, xml-text
msgid "Installation of libmng"
msgstr "Instalação do libmng"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/libmng.xml:84
#, xml-text
msgid ""
"Install <application>libmng</application> by running the following commands:"
msgstr ""
"Instale <application>libmng</application> executando os seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/graphlib/libmng.xml:88
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr --disable-static &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>./configure --prefix=/usr --disable-static &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/libmng.xml:92
#, xml-text
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/libmng.xml:96
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/graphlib/libmng.xml:99
#, no-wrap, xml-text
msgid ""
"<userinput>make install &amp;&amp;\n"
"\n"
"install -v -m755 -d        /usr/share/doc/libmng-&libmng-version; &amp;&amp;\n"
"install -v -m644 doc/*.txt /usr/share/doc/libmng-&libmng-version;</userinput>"
msgstr ""
"<userinput>make install &amp;&amp;\n"
"\n"
"install -v -m755 -d       /usr/share/doc/libmng-&libmng-version; &amp;&amp;\n"
"install -v -m644 doc/*.txt /usr/share/doc/libmng-&libmng-version;</userinput>"

