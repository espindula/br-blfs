#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/graphlib/aalib.xml:82
#, xml-text
msgid "Installation of AAlib"
msgstr "Instalação do AAlib"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/aalib.xml:85
#, xml-text
msgid "Fix a minor problem with the included m4 file:"
msgstr "Corrija um pequeno problema com o arquivo \"m4\" incluído:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/graphlib/aalib.xml:88
#, no-wrap, xml-text
msgid ""
"<userinput>sed -i -e '/AM_PATH_AALIB,/s/AM_PATH_AALIB/[&amp;]/' "
"aalib.m4</userinput>"
msgstr ""
"<userinput>sed -i -e '/AM_PATH_AALIB,/s/AM_PATH_AALIB/[&amp;]/' "
"aalib.m4</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/aalib.xml:91
#, xml-text
msgid ""
"Change the default X11 font from <xref linkend='xorg7-legacy'/> to <xref "
"linkend='xorg7-font'/>:"
msgstr ""
"Mude a fonte padrão do X11 de <xref linkend='xorg7-legacy'/> para <xref "
"linkend='xorg7-font'/>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/graphlib/aalib.xml:95
#, no-wrap, xml-text
msgid ""
"<userinput>sed -e 's/8x13bold/-*-luxi mono-bold-r-normal--13-120-*-*-m-*-*-*/' \\\n"
"    -i src/aax.c</userinput>"
msgstr ""
"<userinput>sed -e 's/8x13bold/-*-luxi mono-bold-r-normal--13-120-*-*-m-*-*-*/"
"' \\\n"
"    -i src/aax.c</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/aalib.xml:99
#, xml-text
msgid ""
"Install <application>AAlib</application> by running the following commands:"
msgstr ""
"Instale <application>AAlib</application> executando os seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/graphlib/aalib.xml:103
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr             \\\n"
"            --infodir=/usr/share/info \\\n"
"            --mandir=/usr/share/man   \\\n"
"            --with-ncurses=/usr       \\\n"
"            --disable-static          &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>./configure --prefix=/usr            \\\n"
"            --infodir=/usr/share/info \\\n"
"            --mandir=/usr/share/man   \\\n"
"            --with-ncurses=/usr       \\\n"
"            --disable-static          &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/aalib.xml:111
#, xml-text
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/aalib.xml:115
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/graphlib/aalib.xml:118
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

