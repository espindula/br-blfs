#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/graphlib/libraw.xml:88
#, xml-text
msgid "Installation of libraw"
msgstr "Instalação do libraw"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/libraw.xml:91
#, xml-text
msgid ""
"Install <application>libraw</application> by running the following commands:"
msgstr ""
"Instale <application>libraw</application> executando os seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/graphlib/libraw.xml:95
#, no-wrap, xml-text
msgid ""
"<userinput>autoreconf -fiv              &amp;&amp;\n"
"./configure --prefix=/usr    \\\n"
"            --enable-jpeg    \\\n"
"            --enable-jasper  \\\n"
"            --enable-lcms    \\\n"
"            --disable-static \\\n"
"            --docdir=/usr/share/doc/libraw-&libraw-version; &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>autoreconf -fiv             &amp;&amp;\n"
"./configure --prefix=/usr    \\\n"
"            --enable-jpeg    \\\n"
"            --enable-jasper  \\\n"
"            --enable-lcms    \\\n"
"            --disable-static \\\n"
"            --docdir=/usr/share/doc/libraw-&libraw-version; &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/libraw.xml:105
#, xml-text
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/libraw.xml:109
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/graphlib/libraw.xml:112
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/graphlib/libraw.xml:117
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/libraw.xml:120
#, xml-text
msgid ""
"<parameter>--enable-jpeg</parameter>: This switch enables support for JPEG "
"images. Remove it if you don't have <xref linkend=\"libjpeg\"/> installed."
msgstr ""
"<parameter>--enable-jpeg</parameter>: Essa chave habilita o suporte para "
"imagens JPEG. Remova-a se você não tiver <xref linkend=\"libjpeg\"/> "
"instalado."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/libraw.xml:126
#, xml-text
msgid ""
"<parameter>--enable-jasper</parameter>: This switch enables support for "
"JPEG2000 images. Remove it if you don't have <xref linkend=\"jasper\"/> "
"installed."
msgstr ""
"<parameter>--enable-jasper</parameter>: Essa chave habilita o suporte para "
"imagens JPEG2000. Remova-a se você não tiver <xref linkend=\"jasper\"/> "
"instalado."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/libraw.xml:132
#, xml-text
msgid ""
"<parameter>--enable-lcms</parameter>: This switch enables support for color "
"management. Remove it if you don't have <xref linkend=\"lcms2\"/> installed."
msgstr ""
"<parameter>--enable-lcms</parameter>: Essa chave habilita o suporte para "
"gerenciamento de cores. Remova-a se você não tiver <xref linkend=\"lcms2\"/>"
" instalado."

