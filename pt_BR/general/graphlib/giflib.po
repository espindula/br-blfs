#: blfs-en/general/graphlib/giflib.xml:80
#, xml-text
msgid "Installation of giflib"
msgstr "Instalação do giflib"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/giflib.xml:83
#, xml-text
msgid ""
"Install <application>giflib</application> by running the following commands:"
msgstr ""
"Instale <application>giflib</application> executando os seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/graphlib/giflib.xml:87
#, no-wrap, xml-text
msgid "<userinput>make</userinput>"
msgstr "<userinput>make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/giflib.xml:96
#, xml-text
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/giflib.xml:100
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/graphlib/giflib.xml:103
#, no-wrap, xml-text
msgid ""
"<userinput>make PREFIX=/usr install &amp;&amp;\n"
"\n"
"rm -fv /usr/lib/libgif.a &amp;&amp;\n"
"\n"
"find doc \\( -name Makefile\\* -o -name \\*.1 \\\n"
"         -o -name \\*.xml \\) -exec rm -v {} \\; &amp;&amp;\n"
"\n"
"install -v -dm755 /usr/share/doc/giflib-&giflib-version; &amp;&amp;\n"
"cp -v -R doc/* /usr/share/doc/giflib-&giflib-version;</userinput>"
msgstr ""
"<userinput>make PREFIX=/usr install &amp;&amp;\n"
"\n"
"rm -fv /usr/lib/libgif.a &amp;&amp;\n"
"\n"
"find doc \\( -name Makefile\\* -o -name \\*.1 \\\n"
"        -o -name \\*.xml \\) -exec rm -v {} \\; &amp;&amp;\n"
"\n"
"install -v -dm755 /usr/share/doc/giflib-&giflib-version; &amp;&amp;\n"
"cp -v -R doc/* /usr/share/doc/giflib-&giflib-version;</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/graphlib/giflib.xml:123
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/giflib.xml:126
#, xml-text
msgid ""
"<command>rm -fv /usr/lib/libgif.a</command>: This command removes a static "
"library which is not used by any BLFS package."
msgstr ""
"<command>rm -fv /usr/lib/libgif.a</command>: Esse comando remove uma "
"biblioteca estática que não é usada por nenhum pacote do BLFS."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/giflib.xml:131
#, xml-text
msgid ""
"<command>find doc ... -exec rm -v {} \\;</command>: This command removes "
"<filename>Makefiles</filename>, man and xml files from the documentation "
"directory that would otherwise be installed by the commands that follow."
msgstr ""
"<command>find doc ... -exec rm -v {} \\;</command>: Esse comando remove os "
"arquivos <filename>Makefiles</filename>, man e xml do diretório de "
"documentação que, de outra forma, seriam instalados pelos comandos a seguir."

