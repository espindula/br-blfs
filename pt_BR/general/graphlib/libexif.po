#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/graphlib/libexif.xml:89
#, xml-text
msgid "Installation of libexif"
msgstr "Instalação do \"libexif\""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/libexif.xml:101
#, xml-text
msgid ""
"Install <application>libexif</application> by running the following "
"commands:"
msgstr ""
"Instale <application>libexif</application> executando os seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/graphlib/libexif.xml:105
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr    \\\n"
"            --disable-static \\\n"
"            --with-doc-dir=/usr/share/doc/libexif-&libexif-version; &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>./configure --prefix=/usr   \\\n"
"            --disable-static \\\n"
"            --with-doc-dir=/usr/share/doc/libexif-&libexif-version; &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/libexif.xml:111
#, xml-text
msgid "To test the results, issue: <command>make check</command>."
msgstr "Para testar os resultados, emita: <command>make check</command>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/libexif.xml:115
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/graphlib/libexif.xml:118
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/libexif.xml:121
#, xml-text
msgid ""
"Documentation was built and installed if you have the dependencies shown "
"above installed. If you don't have the dependencies installed, there is a "
"compressed tarball in the source tree <filename "
"class=\"directory\">doc</filename> directory that can be unpacked into "
"/usr/share/doc/libexif-&libexif-version;."
msgstr ""
"A documentação foi construída e instalada se você tiver as dependências "
"mostradas acima instaladas. Se você não tiver as dependências instaladas, "
"[então] existe um \"tarball\" comprimido no diretório <filename "
"class=\"directory\">doc</filename> da árvore do fonte que pode ser "
"desempacotado em /usr/share/doc/libexif-&libexif-version;."

