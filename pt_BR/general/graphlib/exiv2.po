#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/exiv2.xml:29
#, xml-text
msgid ""
"<application>Exiv2</application> is a C++ library and a command line utility"
" for managing image and video metadata."
msgstr ""
"<application>Exiv2</application> é uma biblioteca C++ e um utilitário de "
"linha de comando para gerenciar metadados de imagem e de vídeo."

