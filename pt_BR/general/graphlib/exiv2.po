#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/graphlib/exiv2.xml:110
#, xml-text
msgid "Installation of Exiv2"
msgstr "Instalação do Exiv2"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/exiv2.xml:119
#, xml-text
msgid ""
"Install <application>Exiv2</application> by running the following commands:"
msgstr ""
"Instale <application>Exiv2</application> executando os seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/graphlib/exiv2.xml:123
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -DCMAKE_INSTALL_PREFIX=/usr  \\\n"
"      -DCMAKE_BUILD_TYPE=Release   \\\n"
"      -DEXIV2_ENABLE_VIDEO=yes     \\\n"
"      -DEXIV2_ENABLE_WEBREADY=yes  \\\n"
"      -DEXIV2_ENABLE_CURL=yes      \\\n"
"      -DEXIV2_BUILD_SAMPLES=no     \\\n"
"      -G \"Unix Makefiles\" .. &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd   build &amp;&amp;\n"
"\n"
"cmake -DCMAKE_INSTALL_PREFIX=/usr  \\\n"
"      -DCMAKE_BUILD_TYPE=Release   \\\n"
"      -DEXIV2_ENABLE_VIDEO=yes     \\\n"
"      -DEXIV2_ENABLE_WEBREADY=yes  \\\n"
"      -DEXIV2_ENABLE_CURL=yes      \\\n"
"      -DEXIV2_BUILD_SAMPLES=no     \\\n"
"      -G \"Unix Makefiles\" .. &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/exiv2.xml:136
#, xml-text
msgid "To test the results, issue: <command>make test</command>"
msgstr "Para testar os resultados, emita: <command>make test</command>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/exiv2.xml:140
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/graphlib/exiv2.xml:143
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/graphlib/exiv2.xml:148
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/exiv2.xml:151
#, xml-text
msgid ""
"<parameter>-DEXIV2_ENABLE_VIDEO=yes</parameter>: This switch enables "
"managing video metadata."
msgstr ""
"<parameter>-DEXIV2_ENABLE_VIDEO=yes</parameter>: Essa chave habilita o "
"gerenciamento de metadados de vídeo."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/exiv2.xml:156
#, xml-text
msgid ""
"<parameter>-DEXIV2_ENABLE_WEBREADY=yes</parameter>: This switch enables "
"managing web image metadata."
msgstr ""
"<parameter>-DEXIV2_ENABLE_WEBREADY=yes</parameter>: Essa chave habilita o "
"gerenciamento de metadados de imagem da web."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/exiv2.xml:161
#, xml-text
msgid ""
"<parameter>-DEXIV2_BUILD_SAMPLES=no</parameter>: This switch is necessary to"
" suppress building and installing sample programs.  If the sample programs "
"are built, 34 additional programs are installed in /usr/bin."
msgstr ""
"<parameter>-DEXIV2_BUILD_SAMPLES=no</parameter>: Essa chave é necessária "
"para suprimir a construção e instalação de aplicativos de amostra. Se os "
"aplicativos de amostra forem compilados, 34 aplicativos adicionais serão "
"instalados em /usr/bin."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/exiv2.xml:168
#, xml-text
msgid ""
"<parameter>-DEXIV2_ENABLE_CURL=yes</parameter>: This switch is necessary to "
"enable network/http capabilities."
msgstr ""
"<parameter>-DEXIV2_ENABLE_CURL=yes</parameter>: Essa chave é necessária para"
" habilitar os recursos de rede de comunicação/http."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/exiv2.xml:173
#, xml-text
msgid ""
"<option>-DEXIV2_ENABLE_INIH=no</option>: Use this switch if you have not "
"installed <xref linkend=\"inih\"/>."
msgstr ""
"<option>-DEXIV2_ENABLE_INIH=no</option>: Use essa chave se você não tiver "
"instalado <xref linkend=\"inih\"/>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/exiv2.xml:178
#, xml-text
msgid ""
"<option>-DEXIV2_ENABLE_BROTLI=no</option>: Use this switch if you have not "
"installed <xref linkend=\"brotli\"/>."
msgstr ""
"<option>-DEXIV2_ENABLE_BROTLI=no</option>: Use essa chave se você não tiver "
"instalado <xref linkend=\"brotli\"/>."

