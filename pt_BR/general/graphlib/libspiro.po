#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/graphlib/libspiro.xml:27
#, xml-text
msgid "Introduction to libspiro"
msgstr "Introdução a libspiro"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/libspiro.xml:30
#, xml-text
msgid ""
"<application>Libspiro</application> will take an array of spiro control "
"points and convert them into a series of bezier splines which can then be "
"used in the myriad of ways the world has come to use beziers."
msgstr ""
"<application>Libspiro</application> pegará uma matriz de pontos de controle "
"\"spiro\" e os converterá em uma série de \"splines bezier\" que podem então"
" ser usados em uma miríade de maneiras que o mundo passou a usar "
"\"beziers\"."

