#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/graphlib/libspiro.xml:74
#, xml-text
msgid "Installation of libspiro"
msgstr "Instalação do libspiro"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/libspiro.xml:77
#, xml-text
msgid ""
"Install <application>libspiro</application> by running the following "
"commands:"
msgstr ""
"Instale <application>libspiro</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/graphlib/libspiro.xml:81
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr --disable-static &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>./configure --prefix=/usr --disable-static &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/libspiro.xml:85
#, xml-text
msgid "To test the results, issue: <command>make check</command>."
msgstr "Para testar os resultados, emita: <command>make check</command>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/libspiro.xml:89
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/graphlib/libspiro.xml:92
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

