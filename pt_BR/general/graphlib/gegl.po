#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/graphlib/gegl.xml:147
#, xml-text
msgid "Installation of gegl"
msgstr "Instalação do gegl"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/gegl.xml:150
#, xml-text
msgid ""
"If installing over a previous version of <application>gegl</application>, "
"one module needs to be removed.  As the <systemitem "
"class=\"username\">root</systemitem> user, run:"
msgstr ""
"Se instalar sobre uma versão anterior do <application>gegl</application>, "
"[então] um módulo precisa ser removido. Como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>, execute:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/graphlib/gegl.xml:155
#, no-wrap, xml-text
msgid "<userinput>rm -f /usr/lib/gegl-0.4/vector-fill.so</userinput>"
msgstr "<userinput>rm -f /usr/lib/gegl-0.4/vector-fill.so</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/gegl.xml:158
#, xml-text
msgid ""
"Install <application>gegl</application> by running the following commands:"
msgstr ""
"Instale <application>gegl</application> executando os seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/graphlib/gegl.xml:161
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr --buildtype=release -Dlibav=disabled .. &amp;&amp;\n"
"ninja</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr --buildtype=release -Dlibav=disabled .. &amp;&amp;\n"
"ninja</userinput>"

#. This should
#.       indicate no failures, but will skip many tests depending on optional
#.       dependencies installed on the system.
#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/gegl.xml:168
#, xml-text
msgid ""
"To run the tests, issue: <command>ninja test</command>.  7 tests in the "
"<filename>gegl:ff-load-save</filename> portion of the test suite are known "
"to fail due to incompatibilities with ffmpeg-6.0."
msgstr ""
"Para executar os testes, emita: <command>ninja test</command>. 7 testes na "
"parte <filename>gegl:ff-load-save</filename> da suíte de teste são "
"conhecidos por falharem devido a incompatibilidades com ffmpeg-6.0."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/gegl.xml:176
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/graphlib/gegl.xml:179
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr "<userinput>ninja install</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/graphlib/gegl.xml:183
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/gegl.xml:186
#, xml-text
msgid ""
"<option>-Ddocs=true</option>: Build and install documentation (requires "
"<xref linkend=\"gtk-doc\"/>).  <option>-Dlibav=disabled</option>: Disable "
"FFMpeg support as the build fails with <xref linkend=\"ffmpeg\"/>."
msgstr ""
"<option>-Ddocs=true</option>: Construa e instale documentação (exige <xref "
"linkend=\"gtk-doc\"/>). <option>-Dlibav=disabled</option>: Desabilita "
"suporte ao FFMpeg, pois a construção falha com <xref linkend=\"ffmpeg\"/>."

