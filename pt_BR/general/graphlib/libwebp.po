#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/graphlib/libwebp.xml:98
#, xml-text
msgid "Installation of libwebp"
msgstr "Instalação do libwebp"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/libwebp.xml:107
#, xml-text
msgid ""
"Install <application>libwebp</application> by running the following "
"commands:"
msgstr ""
"Instale <application>libwebp</application> executando os seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/graphlib/libwebp.xml:111
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr           \\\n"
"            --enable-libwebpmux     \\\n"
"            --enable-libwebpdemux   \\\n"
"            --enable-libwebpdecoder \\\n"
"            --enable-libwebpextras  \\\n"
"            --enable-swap-16bit-csp \\\n"
"            --disable-static        &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>./configure --prefix=/usr          \\\n"
"            --enable-libwebpmux     \\\n"
"            --enable-libwebpdemux   \\\n"
"            --enable-libwebpdecoder \\\n"
"            --enable-libwebpextras  \\\n"
"            --enable-swap-16bit-csp \\\n"
"            --disable-static        &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/libwebp.xml:121
#, xml-text
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/libwebp.xml:125
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/graphlib/libwebp.xml:128
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/graphlib/libwebp.xml:133
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/libwebp.xml:137
#, xml-text
msgid ""
"<parameter>--enable-swap-16bit-csp</parameter>: This switch enables byte "
"swap for 16 bit colorspaces."
msgstr ""
"<parameter>--enable-swap-16bit-csp</parameter>: Essa chave habilita a troca "
"de bytes para espaços de cores de 16 bits."

