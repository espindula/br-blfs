#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/lcms.xml:126
msgid ""
"<option>--with-python</option>: Use this parameter if "
"<application>Python</application> and <application>SWIG</application> are "
"installed."
msgstr ""
"<option>--with-python</option>: Use esse parâmetro se "
"<application>Python</application> e <application>SWIG</application> "
"estiverem instalados."

