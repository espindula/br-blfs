#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/graphlib/libmypaint.xml:93
#, xml-text
msgid "Installation of libmypaint"
msgstr "Instalação do libmypaint"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/libmypaint.xml:96
#, xml-text
msgid ""
"Install <application>libmypaint</application> by running the following "
"commands:"
msgstr ""
"Instale <application>libmypaint</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/graphlib/libmypaint.xml:100
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>./configure --prefix=/usr &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/libmypaint.xml:104
#, xml-text
msgid "To test the results, issue: <command>make check</command>."
msgstr "Para testar os resultados, emita: <command>make check</command>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/libmypaint.xml:108
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/graphlib/libmypaint.xml:111
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

