#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/libmypaint.xml:29
#, xml-text
msgid ""
"The <application>libmypaint</application> package, a.k.a. \"brushlib\", is a"
" library for making brushstrokes which is used by MyPaint and other "
"projects."
msgstr ""
"O pacote <application>libmypaint</application>, também conhecido como "
"\"brushlib\", é uma biblioteca para fazer pinceladas que é usada pelo "
"\"MyPaint\" e outros projetos."

