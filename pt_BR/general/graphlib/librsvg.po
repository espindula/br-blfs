#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/librsvg.xml:29
#, xml-text
msgid ""
"The <application>librsvg</application> package contains a library and tools "
"used to manipulate, convert and view Scalable Vector Graphic (SVG) images."
msgstr ""
"O pacote <application>librsvg</application> contém uma biblioteca e "
"ferramentas usadas para manipular, converter e visualizar imagens \"Scalable"
" Vector Graphic\" (\"SVG\")."

