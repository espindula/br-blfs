#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/graphlib/poppler.xml:156
#, xml-text
msgid "Installation of Poppler"
msgstr "Instalação do Poppler"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/poppler.xml:159
#, xml-text
msgid ""
"Install <application>Poppler</application> by running the following "
"commands:"
msgstr ""
"Instale <application>Poppler</application> executando os seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/graphlib/poppler.xml:163
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build                         &amp;&amp;\n"
"cd    build                         &amp;&amp;\n"
"\n"
"cmake  -DCMAKE_BUILD_TYPE=Release   \\\n"
"       -DCMAKE_INSTALL_PREFIX=/usr  \\\n"
"       -DTESTDATADIR=$PWD/testfiles \\\n"
"       -DENABLE_QT6=OFF             \\\n"
"       -DENABLE_UNSTABLE_API_ABI_HEADERS=ON \\\n"
"       ..                           &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>mkdir build                         &amp;&amp;\n"
"cd    build                         &amp;&amp;\n"
"\n"
"cmake  -DCMAKE_BUILD_TYPE=Release   \\\n"
"       -DCMAKE_INSTALL_PREFIX=/usr  \\\n"
"       -DTESTDATADIR=$PWD/testfiles \\\n"
"       -DENABLE_QT6=OFF             \\\n"
"       -DENABLE_UNSTABLE_API_ABI_HEADERS=ON \\\n"
"       ..                           &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/poppler.xml:175
#, xml-text
msgid ""
"In order to run the test suite, some testcases are needed and can be "
"obtained only from a git repository. The command to download them is: "
"<command>git clone --depth 1 https://gitlab.freedesktop.org/poppler/test.git"
" testfiles</command>.  Then issue: <command>LC_ALL=en_US.UTF-8 make "
"test</command>.  One test, check_qt5_signature_basics, is known to fail."
msgstr ""
"Para a finalidade de executar a suíte de teste, alguns casos de teste são "
"necessários e podem ser obtidos somente a partir de um repositório git. O "
"comando para baixá-los é: <command>git clone --depth 1 "
"https://gitlab.freedesktop.org/poppler/test.git testfiles</command>. Em "
"seguida, emita: <command>LC_ALL=en_US.UTF-8 make test</command>. Um teste, "
"check_qt5_signature_basics, é conhecido por falhar."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/poppler.xml:184
#: blfs-en/general/graphlib/poppler.xml:209
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/graphlib/poppler.xml:187
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/poppler.xml:190
#, xml-text
msgid ""
"To install the documentation, run the following commands as <systemitem "
"class=\"username\">root</systemitem>:"
msgstr ""
"Para instalar a documentação, execute os seguintes comandos como <systemitem"
" class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/graphlib/poppler.xml:194
#, no-wrap, xml-text
msgid ""
"<userinput>install -v -m755 -d           /usr/share/doc/poppler-&poppler-version; &amp;&amp;\n"
"cp -vr ../glib/reference/html /usr/share/doc/poppler-&poppler-version;</userinput>"
msgstr ""
"<userinput>install -v -m755 -d          /usr/share/doc/poppler-&poppler-version; &amp;&amp;\n"
"cp -vr ../glib/reference/html /usr/share/doc/poppler-&poppler-version;</userinput>"

#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/general/graphlib/poppler.xml:198
#, xml-text
msgid "Poppler Data"
msgstr "Dados Poppler"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/poppler.xml:201
#, xml-text
msgid ""
"If you downloaded the additional encoding data package, install it by "
"issuing the following commands:"
msgstr ""
"Se você baixou o pacote adicional de dados de codificação, [então] instale-o"
" emitindo os seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/graphlib/poppler.xml:205
#, no-wrap, xml-text
msgid ""
"<userinput>tar -xf ../../poppler-data-&poppler-data-version;.tar.gz &amp;&amp;\n"
"cd poppler-data-&poppler-data-version;</userinput>"
msgstr ""
"<userinput>tar -xf ../../poppler-data-&poppler-data-version;.tar.gz &amp;&amp;\n"
"cd poppler-data-&poppler-data-version;</userinput>"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/graphlib/poppler.xml:212
#, no-wrap, xml-text
msgid "<userinput>make prefix=/usr install</userinput>"
msgstr "<userinput>make prefix=/usr install</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/graphlib/poppler.xml:217
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/poppler.xml:220
#, xml-text
msgid ""
"<parameter>-DCMAKE_BUILD_TYPE=Release</parameter>: This switch is used to "
"apply a higher level of compiler optimizations."
msgstr ""
"<parameter>-DCMAKE_BUILD_TYPE=Release</parameter>: Essa chave é usada para "
"aplicar um nível mais alto de otimizações do compilador."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/poppler.xml:225
#, xml-text
msgid ""
"<parameter>-DTESTDATADIR=$PWD/testfiles</parameter>: Tells the test programs"
" where the auxiliary files are located."
msgstr ""
"<parameter>-DTESTDATADIR=$PWD/testfiles</parameter>: Informa aos aplicativos"
" de teste onde os arquivos auxiliares estão localizados."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/poppler.xml:230
#, xml-text
msgid ""
"<parameter>-DENABLE_QT6=OFF</parameter>: This switch is needed to prevent an"
" error when Qt6 is not installed. Remove it if you have installed <xref "
"linkend=\"qt6\" role=\"nodep\"/>."
msgstr ""
"<parameter>-DENABLE_QT6=OFF</parameter>: Essa chave é necessária para evitar"
" um erro quando o Qt6 não estiver instalado. Remova-a se você tiver "
"instalado <xref linkend=\"qt6\" role=\"nodep\"/>."

#. (e.g. <application>
#. Inkscape</application>).
#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/poppler.xml:236
#, xml-text
msgid ""
"<parameter>-DENABLE_UNSTABLE_API_ABI_HEADERS=ON</parameter>: Installs some "
"old <application>Xpdf</application> headers required by certain programs."
msgstr ""
"<parameter>-DENABLE_UNSTABLE_API_ABI_HEADERS=ON</parameter>: Instala alguns "
"cabeçalhos antigos <application>Xpdf</application> exigidos por certos "
"aplicativos."

#. and Pygments
#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/poppler.xml:242
#, xml-text
msgid ""
"<option>-DENABLE_GTK_DOC=ON</option>: Use this parameter if GTK-Doc is "
"installed and you wish to rebuild and install the API documentation."
msgstr ""
"<option>-DENABLE_GTK_DOC=ON</option>: Use esse parâmetro se o \"GTK-Doc\" "
"estiver instalado e você desejar reconstruir e instalar a documentação da "
"API."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/poppler.xml:248
#, xml-text
msgid ""
"<option>-DENABLE_QT5=OFF</option>: Use this parameter if &qt5-deps; is not "
"installed."
msgstr ""
"<option>-DENABLE_QT5=OFF</option>: Use esse parâmetro se &qt5-deps; não "
"estiver instalado."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/poppler.xml:253
#, xml-text
msgid ""
"<option>-DENABLE_BOOST=OFF</option>: Use this parameter if you have not "
"installed <application>boost</application> (the Splash backend for Qt5 "
"recommends boost)."
msgstr ""
"<option>-DENABLE_BOOST=OFF</option>: Use esse parâmetro se você não tiver "
"instalado o <application>boost</application> (a estrutura de retaguarda "
"\"Splash\" para \"Qt5\" recomenda o \"boost\")."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/poppler.xml:259
#, xml-text
msgid ""
"<option>-DENABLE_NSS3=OFF</option>: Use this parameter if you have not "
"installed <application>nss</application>."
msgstr ""
"<option>-DENABLE_NSS3=OFF</option>: Use esse parâmetro se você não tiver "
"instalado <application>nss</application>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/poppler.xml:264
#, xml-text
msgid ""
"<option>-DENABLE_GPGME=OFF</option>: Use this parameter if you have not "
"installed <application>gpgme</application>."
msgstr ""
"<option>-DENABLE_GPGME=OFF</option>: Use esse parâmetro se você não tiver "
"instalado <application>gpgme</application>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/poppler.xml:269
#, xml-text
msgid ""
"<option>-DENABLE_LIBTIFF=OFF</option>: Use this parameter if you have not "
"installed <application>libtiff</application>."
msgstr ""
"<option>-DENABLE_LIBTIFF=OFF</option>: Use esse parâmetro se você não tiver "
"instalado <application>libtiff</application>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/poppler.xml:274
#, xml-text
msgid ""
"<command>LC_ALL=en_US.UTF-8 make test</command>: Runs the test suite.  The "
"environment variable LC_ALL=en_US.UTF-8 is only needed if the default locale"
" does not include UTF-8."
msgstr ""
"<command>LC_ALL=en_US.UTF-8 make test</command>: Executa a suíte de teste. A"
" variável de ambiente \"LC_ALL=en_US.UTF-8\" só é necessária se o \"locale\""
" padrão não incluir \"UTF-8\"."

#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/graphlib/poppler.xml:282
#, xml-text
msgid "Contents"
msgstr "Conteúdo"

