#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/graphlib/fribidi.xml:26
#, xml-text
msgid "Introduction to FriBidi"
msgstr "Introdução a FriBidi"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/fribidi.xml:29
#, xml-text
msgid ""
"The <application>FriBidi</application> package is an implementation of the "
"<ulink url=\"https://www.unicode.org/reports/tr9/\">Unicode Bidirectional "
"Algorithm (BIDI)</ulink>. This is useful for supporting Arabic and Hebrew "
"alphabets in other packages."
msgstr ""
"O pacote <application>FriBidi</application> é uma implementação do <ulink "
"url=\"https://www.unicode.org/reports/tr9/\">Algoritmo Bidirecional Unicode "
"(BIDI)</ulink>. Isso é útil para suportar os alfabetos árabe e hebraico em "
"outros pacotes."

