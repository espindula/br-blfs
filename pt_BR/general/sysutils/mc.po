#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/sysutils/mc.xml:101
#, xml-text
msgid "Installation of MC"
msgstr "Instalação do \"MC\""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/sysutils/mc.xml:104
#, xml-text
msgid ""
"Install <application>MC</application> by running the following commands:"
msgstr ""
"Instale <application>MC</application> executando os seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/sysutils/mc.xml:108
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr \\\n"
"            --sysconfdir=/etc \\\n"
"            --enable-charset &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>./configure --prefix=/usr \\\n"
"           --sysconfdir=/etc \\\n"
"           --enable-charset &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/sysutils/mc.xml:114
#, xml-text
msgid "To test the results, issue: <command>make check</command>."
msgstr "Para testar os resultados, emita: <command>make check</command>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/sysutils/mc.xml:119
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/sysutils/mc.xml:122
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/sysutils/mc.xml:127
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/sysutils/mc.xml:130
#, xml-text
msgid ""
"<parameter>--sysconfdir=/etc</parameter>: This switch places the global "
"configuration directory in <filename class=\"directory\">/etc</filename>."
msgstr ""
"<parameter>--sysconfdir=/etc</parameter>: Essa chave coloca o diretório "
"global de configuração em <filename class=\"directory\">/etc</filename>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/sysutils/mc.xml:136
#, xml-text
msgid ""
"<parameter>--enable-charset</parameter>: This switch adds support to "
"<command>mcedit</command> for editing files in encodings different from the "
"one implied by the current locale."
msgstr ""
"<parameter>--enable-charset</parameter>: Essa chave adiciona suporte ao "
"<command>mcedit</command> para edição de arquivos em codificações diferentes"
" daquela implícita na localidade atual."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/sysutils/mc.xml:142
#, xml-text
msgid ""
"<parameter>--with-screen=ncurses</parameter>: Use this if you don't have "
"<xref linkend=\"slang\"/> installed."
msgstr ""
"<parameter>--with-screen=ncurses</parameter>: Use isso se você não tiver "
"<xref linkend=\"slang\"/> instalado."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/sysutils/mc.xml:147
#, xml-text
msgid ""
"<option>--with-search-engine=pcre2</option>: Use this switch if you would "
"prefer to use <xref linkend=\"pcre2\" role=\"nodep\"/> instead of GLib for "
"the built-in search engine."
msgstr ""
"<option>--with-search-engine=pcre2</option>: Use essa chave se você "
"preferisse usar <xref linkend=\"pcre2\" role=\"nodep\"/> em vez de GLib para"
" o mecanismo de pesquisa integrado."

