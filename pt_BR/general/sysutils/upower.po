#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/sysutils/upower.xml:192
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/sysutils/upower.xml:195
#, xml-text
msgid ""
"<parameter>-Dgtk-doc=false</parameter>: Prevents building the documentation."
" Remove this if you have <application>GTK-Doc</application> installed and "
"wish to build the documentation."
msgstr ""
"<parameter>-Dgtk-doc=false</parameter>: Impede construir a documentação. "
"Remova isso se você tiver o <application>GTK-Doc</application> instalado e "
"desejar construir a documentação."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/sysutils/upower.xml:201
#, xml-text
msgid ""
"<parameter>-Dman=false</parameter>: Prevents building the manual pages. "
"Remove this if you have <xref linkend='libxslt'/> and <xref "
"linkend='docbook-xsl'/> installed and wish to build the manual pages."
msgstr ""
"<parameter>-Dman=false</parameter>: Impede construir as páginas de manual. "
"Remova isso se você tiver <xref linkend='libxslt'/> e <xref "
"linkend='docbook-xsl'/> instalados e desejar construir as páginas de manual."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/sysutils/upower.xml:208
#, xml-text
msgid ""
"<parameter>-Dsystemdsystemunitdir=no</parameter>: Removes the dependency on "
"<application>systemd</application>."
msgstr ""
"<parameter>-Dsystemdsystemunitdir=no</parameter>: Remove a dependência do "
"<application>systemd</application>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/sysutils/upower.xml:213
#, xml-text
msgid ""
"<parameter>-Dudevrulesdir=/usr/lib/udev/rules.d</parameter>: Tells the build"
" system where to install <application>udev</application> rules because the "
"information is missing in <filename>/usr/lib/pkgconfig/libudev.pc</filename>"
msgstr ""
"<parameter>-Dudevrulesdir=/usr/lib/udev/rules.d</parameter>: Informa ao "
"sistema de construção onde instalar as regras do "
"<application>udev</application> porque as informações estão ausentes em "
"<filename>/usr/lib/pkgconfig/libudev.pc</filename>"

