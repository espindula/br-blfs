#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/sysutils/sysmon-qt.xml:95
#, xml-text
msgid "Installation of sysmon-qt"
msgstr "Instalação do sysmon-qt"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/sysutils/sysmon-qt.xml:98
#, xml-text
msgid ""
"Install <application>sysmon-qt</application> by running the following "
"commands:"
msgstr ""
"Instale <application>sysmon-qt</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/sysutils/sysmon-qt.xml:102
#, no-wrap, xml-text
msgid ""
"<userinput>cd src               &amp;&amp;\n"
"qmake6 sysmon-qt.pro &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>cd src               &amp;&amp;\n"
"qmake6 sysmon-qt.pro &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/sysutils/sysmon-qt.xml:107
#, xml-text
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/sysutils/sysmon-qt.xml:111
#, xml-text
msgid "Now, as the &root; user:"
msgstr "Agora, como o(a) usuário(a) &root;:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/sysutils/sysmon-qt.xml:114
#, no-wrap, xml-text
msgid ""
"<userinput>cp sysmon-qt                 /usr/bin                 &amp;&amp;\n"
"cp ../data/sysmon-qt.desktop /usr/share/applications/ &amp;&amp;\n"
"cp ../data/sysmon-qt.png     /usr/share/pixmaps/</userinput>"
msgstr ""
"<userinput>cp sysmon-qt                 /usr/bin                 &amp;&amp;\n"
"cp ../data/sysmon-qt.desktop /usr/share/applications/ &amp;&amp;\n"
"cp ../data/sysmon-qt.png     /usr/share/pixmaps/</userinput>"

