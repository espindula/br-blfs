#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/sysutils/accountsservice.xml:159
#, xml-text
msgid ""
"Now adapt the shipped mocklibc copy to allow building the test suite with "
"GCC 14 or later:"
msgstr ""
"Agora adapte a cópia de mocklibc enviada para permitir construir a suíte de "
"teste com GCC 14 ou posterior:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/sysutils/accountsservice.xml:163
#, no-wrap, xml-text
msgid ""
"<userinput>grep 'print_indent'     ../subprojects/mocklibc-1.0/src/netgroup.c \\\n"
"     | sed 's/ {/;/' >> ../subprojects/mocklibc-1.0/src/netgroup.h &amp;&amp;\n"
"sed -i '1i#include &lt;stdio.h&gt;'                                      \\\n"
"    ../subprojects/mocklibc-1.0/src/netgroup.h</userinput>"
msgstr ""
"<userinput>grep 'print_indent'     ../subprojects/mocklibc-1.0/src/netgroup.c \\\n"
"     | sed 's/ {/;/' >> ../subprojects/mocklibc-1.0/src/netgroup.h &amp;&amp;\n"
