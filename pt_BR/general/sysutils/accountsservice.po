#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/sysutils/accountsservice.xml:193
#, xml-text
msgid ""
"<parameter>-D admin_group=adm</parameter>: This switch sets the group for "
"administrator accounts."
msgstr ""
"<parameter>-D admin_group=adm</parameter>: Essa chave configura o grupo para"
" contas de administrador(a)."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/sysutils/accountsservice.xml:198
#, xml-text
msgid ""
"<option>-D docbook=true</option>: This switch enables building the D-Bus "
"interface API documentation (needs <xref linkend=\"xmlto\"/>)."
msgstr ""
"<option>-D docbook=true</option>: Essa chave habilita construir a "
"documentação da API da interface do D-Bus (precisa do <xref "
"linkend=\"xmlto\"/>)."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/sysutils/accountsservice.xml:203
#, xml-text
msgid ""
"<option>-D gtk_doc=true</option>: This switch enables building the "
"libaccountsservice API documentation (needs <xref linkend=\"gtk-doc\"/>)."
msgstr ""
"<option>-D gtk_doc=true</option>: Essa chave habilita construir a "
"documentação da API da libaccountsservice (precisa do <xref linkend=\"gtk-"
"doc\"/>)."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/sysutils/accountsservice.xml:209
#, xml-text
msgid ""
"<option>-D vapi=false</option>: This switch disables building the vala "
"bindings. Use it if you have not installed <xref linkend=\"vala\"/>."
msgstr ""
"<option>-D vapi=false</option>: Essa chave desabilita construir as ligações "
"vala. Use-a se você não tiver instalado <xref linkend=\"vala\"/>."

#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/sysutils/accountsservice.xml:217
#, xml-text
msgid "Configuring AccountsService"
msgstr "Configurando \"AccountsService\""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/sysutils/accountsservice.xml:220
#, xml-text
msgid ""
"To allow users in the adm group to be listed as Administrators, execute the "
"following commands as the <systemitem class=\"username\">root</systemitem> "
"user:"
msgstr ""
"Para permitir que os(as) usuários(as) no grupo \"adm\" sejam listados como "
"Administradores(as), execute os seguintes comandos como o(a) usuário(a) "
"<systemitem class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/sysutils/accountsservice.xml:225
#, no-wrap, xml-text
msgid ""
"<userinput>cat &gt; /etc/polkit-1/rules.d/40-adm.rules &lt;&lt; \"EOF\"\n"
"<literal>polkit.addAdminRule(function(action, subject) {\n"
"   return [\"unix-group:adm\"];\n"
"   });</literal>\n"
"EOF</userinput>"
msgstr ""
"<userinput>cat &gt; /etc/polkit-1/rules.d/40-adm.rules &lt;&lt; \"EOF\"\n"
"<literal>polkit.addAdminRule(function(action, subject) {\n"
"  return [\"unix-group:adm\"];\n"
"  });</literal>\n"
"EOF</userinput>"

