#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/sysutils/unrar.xml:76
#, xml-text
msgid "Installation of UnRar"
msgstr "Instalação do \"UnRar\""

#. type: Content of: <sect1><sect2><note><para>
#: blfs-en/general/sysutils/unrar.xml:80
#, xml-text
msgid ""
"This package extracts the tarball to the unversioned directory "
"<filename>unrar</filename> and not the expected directory "
"<filename>unrar-&unrar-version;</filename>."
msgstr ""
"Esse pacote extrai o \"tarball\" para o diretório não versionado "
"<filename>unrar</filename> e não para o diretório esperado "
"<filename>unrar-&unrar-version;</filename>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/sysutils/unrar.xml:88
#, xml-text
msgid ""
"Install <application>UnRar</application> by running the following commands:"
msgstr ""
"Instale <application>UnRar</application> executando os seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/sysutils/unrar.xml:92
#, no-wrap, xml-text
msgid "<userinput>make -f makefile</userinput>"
msgstr "<userinput>make -f makefile</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/sysutils/unrar.xml:95
#, xml-text
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/sysutils/unrar.xml:99
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/sysutils/unrar.xml:102
#, no-wrap, xml-text
msgid "<userinput>install -v -m755 unrar /usr/bin</userinput>"
msgstr "<userinput>install -v -m755 unrar /usr/bin</userinput>"

