#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/sysutils/usbutils.xml:102
#, xml-text
msgid "Installation of USB Utils"
msgstr "Instalação do \"USB Utils\""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/sysutils/usbutils.xml:105
#, xml-text
msgid ""
"Install <application>USB Utils</application> by running the following "
"commands:"
msgstr ""
"Instale <application>USB Utils</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/sysutils/usbutils.xml:109
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr --datadir=/usr/share/hwdata &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>./configure --prefix=/usr --datadir=/usr/share/hwdata &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/sysutils/usbutils.xml:113
#, xml-text
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/sysutils/usbutils.xml:117
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/sysutils/usbutils.xml:120
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/sysutils/usbutils.xml:123
#, xml-text
msgid ""
"To install the <filename>usb.ids</filename> data file, using <xref "
"linkend=\"wget\"/>, run, as the <systemitem "
"class=\"username\">root</systemitem> user:"
msgstr ""
"Para instalar o arquivo de dados <filename>usb.ids</filename>, usando <xref "
"linkend=\"wget\"/>, execute como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/sysutils/usbutils.xml:128
#, no-wrap, xml-text
msgid ""
"<userinput>install -dm755 /usr/share/hwdata/ &amp;&amp;\n"
"wget http://www.linux-usb.org/usb.ids -O /usr/share/hwdata/usb.ids</userinput>"
msgstr ""
"<userinput>install -dm755 /usr/share/hwdata/ &amp;&amp;\n"
"wget http://www.linux-usb.org/usb.ids -O /usr/share/hwdata/usb.ids</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/sysutils/usbutils.xml:132
#, xml-text
msgid ""
"The script <command>lsusb.py</command> displays information in a more easily"
" readable form than <command>lsusb</command>. To find the options, use "
"<command>lsusb.py -h</command>. One form of use recommended by the developer"
" is <command>lsusb.py -ciu</command>."
msgstr ""
"O script <command>lsusb.py</command> exibe informações em um formato mais "
"facilmente legível que <command>lsusb</command>. Para encontrar as opções, "
"use <command>lsusb.py -h</command>. Uma forma de uso recomendada pelo(a) "
"desenvolvedor(a) é <command>lsusb.py -ciu</command>."

#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/sysutils/usbutils.xml:151
#, xml-text
msgid "Configuring USB Utils"
msgstr "Configurando o \"USB Utils\""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/sysutils/usbutils.xml:154
#, xml-text
msgid ""
"The <filename>usb.ids</filename> data file is constantly being updated.  To "
"get a current version of this file, using <xref linkend=\"wget\"/>, "
"periodically run again, as the <systemitem "
"class=\"username\">root</systemitem> user:"
msgstr ""
"O arquivo de dados <filename>usb.ids</filename> está constantemente sendo "
"atualizado. Para obter uma versão atual desse arquivo, usando <xref "
"linkend=\"wget\"/>, periodicamente execute novamente, como o(a) usuário(a) "
"<systemitem class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/sysutils/usbutils.xml:160
#, no-wrap, xml-text
msgid ""
"<userinput>wget http://www.linux-usb.org/usb.ids -O "
"/usr/share/hwdata/usb.ids</userinput>"
msgstr ""
"<userinput>wget http://www.linux-usb.org/usb.ids -O "
"/usr/share/hwdata/usb.ids</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/sysutils/usbutils.xml:163
#, xml-text
msgid ""
"You should update the <filename>/usr/share/hwdata/usb.ids</filename> file "
"periodically. <phrase revision=\"sysv\">If you've installed <xref "
"linkend=\"fcron\"/> and completed the section on periodic jobs, "
"execute</phrase><phrase revision=\"systemd\">Execute</phrase> the following "
"commands, as the <systemitem class=\"username\">root</systemitem> user, to "
"create a <phrase revision=\"sysv\">weekly cron job:</phrase> <phrase "
"revision=\"systemd\">systemd timer to update it weekly on Sundays at 2:30 "
"A.M. (local time):</phrase>"
msgstr ""
"Você deveria atualizar o arquivo "
"<filename>/usr/share/hwdata/usb.ids</filename> periodicamente. <phrase "
"revision=\"sysv\">Se você tiver instalado <xref linkend=\"fcron\"/> e "
"completou a seção relativa a tarefas periódicas, [então] "
"execute</phrase><phrase revision=\"systemd\">Execute</phrase> os seguintes "
"comandos, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>, para criar <phrase "
"revision=\"sysv\">uma tarefa semanal do \"cron\":</phrase> <phrase "
"revision=\"systemd\">um cronômetro do \"systemd\" para atualizá-lo "
"semanalmente aos domingos às 2h30. (hora local):</phrase>"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/sysutils/usbutils.xml:172
#, no-wrap, xml-text
msgid ""
"<userinput>cat &gt; /etc/cron.weekly/update-usbids.sh &lt;&lt; \"EOF\" &amp;&amp;\n"
"<literal>#!/bin/bash\n"
"/usr/bin/wget http://www.linux-usb.org/usb.ids -O /usr/share/hwdata/usb.ids</literal>\n"
"EOF\n"
"chmod 754 /etc/cron.weekly/update-usbids.sh</userinput>"
msgstr ""
"<userinput>cat &gt; /etc/cron.weekly/update-usbids.sh &lt;&lt; \"EOF\" &amp;&amp;\n"
"<literal>#!/bin/bash\n"
"/usr/bin/wget http://www.linux-usb.org/usb.ids -O /usr/share/hwdata/usb.ids</literal>\n"
"EOF\n"
"chmod 754 /etc/cron.weekly/update-usbids.sh</userinput>"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/sysutils/usbutils.xml:178
#, no-wrap, xml-text
msgid ""
"<userinput>cat &gt; /usr/lib/systemd/system/update-usbids.service &lt;&lt; \"EOF\" &amp;&amp;\n"
"<literal>[Unit]\n"
"Description=Update usb.ids file\n"
"Documentation=man:lsusb(8)\n"
"DefaultDependencies=no\n"
"After=local-fs.target network-online.target\n"
"Before=shutdown.target\n"
"\n"
"[Service]\n"
"Type=oneshot\n"
"RemainAfterExit=yes\n"
"ExecStart=/usr/bin/wget http://www.linux-usb.org/usb.ids -O /usr/share/hwdata/usb.ids</literal>\n"
"EOF\n"
"cat &gt; /usr/lib/systemd/system/update-usbids.timer &lt;&lt; \"EOF\" &amp;&amp;\n"
"<literal>[Unit]\n"
"Description=Update usb.ids file weekly\n"
"\n"
"[Timer]\n"
"OnCalendar=Sun 03:00:00\n"
"Persistent=true\n"
"\n"
"[Install]\n"
"WantedBy=timers.target</literal>\n"
"EOF\n"
"systemctl enable update-usbids.timer</userinput>"
msgstr ""
"<userinput>cat &gt; /usr/lib/systemd/system/update-usbids.service &lt;&lt; \"EOF\" &amp;&amp;\n"
"<literal>[Unit]\n"
"Description=Atualiza arquivo \"usb.ids\"\n"
"Documentation=man:lsusb(8)\n"
"DefaultDependencies=no\n"
"After=local-fs.target network-online.target\n"
"Before=shutdown.target\n"
"\n"
"[Service]\n"
"Type=oneshot\n"
"RemainAfterExit=yes\n"
"ExecStart=/usr/bin/wget http://www.linux-usb.org/usb.ids -O /usr/share/hwdata/usb.ids</literal>\n"
"EOF\n"
"cat &gt; /usr/lib/systemd/system/update-usbids.timer &lt;&lt; \"EOF\" &amp;&amp;\n"
"<literal>[Unit]\n"
"Description=Atualiza semanalmente arquivo \"usb.ids\"\n"
"\n"
"[Timer]\n"
"OnCalendar=Sun 03:00:00\n"
"Persistent=true\n"
"\n"
"[Install]\n"
"WantedBy=timers.target</literal>\n"
"EOF\n"
"systemctl enable update-usbids.timer</userinput>"

