msgstr "Instalação de xdotool"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/sysutils/xdotool.xml:76
#, xml-text
msgid ""
"Install <application>xdotool</application> by running the following "
"commands:"
msgstr ""
"Instale <application>xdotool</application> executando os seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/sysutils/xdotool.xml:80
#, no-wrap, xml-text
msgid "<userinput>make WITHOUT_RPATH_FIX=1</userinput>"
msgstr "<userinput>make WITHOUT_RPATH_FIX=1</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/sysutils/xdotool.xml:83
#, xml-text
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/sysutils/xdotool.xml:87
#, xml-text
msgid "Now, as the &root; user:"
msgstr "Agora, como o(a) usuário(a) &root;:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/sysutils/xdotool.xml:90
#, no-wrap, xml-text
msgid ""
"<userinput>make PREFIX=/usr INSTALLMAN=/usr/share/man install</userinput>"
msgstr ""
"<userinput>make PREFIX=/usr INSTALLMAN=/usr/share/man install</userinput>"

