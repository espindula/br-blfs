"<userinput>make install docdir=/usr/share/doc/at-&at-version; \\\n"
"             atdocdir=/usr/share/doc/at-&at-version;</userinput>"
msgstr ""
"<userinput>make install docdir=/usr/share/doc/at-&at-version; \\\n"
"            atdocdir=/usr/share/doc/at-&at-version;</userinput>"

