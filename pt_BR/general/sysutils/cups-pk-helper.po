#: blfs-en/general/sysutils/cups-pk-helper.xml:100
#, xml-text
msgid "Installation of cups-pk-helper"
msgstr "Instalação do \"cups-pk-helper\""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/sysutils/cups-pk-helper.xml:112
#, xml-text
msgid ""
"Install <application>cups-pk-helper</application> by running the following "
"commands:"
msgstr ""
"Instale <application>cups-pk-helper</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/sysutils/cups-pk-helper.xml:116
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr .. &amp;&amp;\n"
"ninja</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr .. &amp;&amp;\n"
"ninja</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/sysutils/cups-pk-helper.xml:123
#, xml-text
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/sysutils/cups-pk-helper.xml:127
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/sysutils/cups-pk-helper.xml:130
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr "<userinput>ninja install</userinput>"

