#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/prog/subversion.xml:146
#, xml-text
msgid "Installation of Subversion"
msgstr "Instalação do Subversion"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/prog/subversion.xml:159
#, xml-text
msgid "First, adapt some Python scripts to use python3:"
msgstr ""
"Primeiro, adapte alguns &quot;scripts&quot; &quot;Python&quot; para usar "
"&quot;python3&quot;:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/prog/subversion.xml:162
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"pre\">grep -rl '^#!.*python$' | xargs sed -i "
"'1s/python/&amp;3/'</userinput>"
msgstr ""
"<userinput remap=\"pre\">grep -rl '^#!.*python$' | xargs sed -i "
"'1s/python/&amp;3/'</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/prog/subversion.xml:165
#, xml-text
msgid "Next, fix building this package with GCC 14:"
msgstr "A seguir, corrija construir esse pacote com GCC 14:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/prog/subversion.xml:168
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"pre\">patch -Np1 -i ../subversion-&subversion-"
"version;-upstream_fixes-1.patch</userinput>"
msgstr ""
"<userinput remap=\"pre\">patch -Np1 -i ../subversion-&subversion-"
"version;-upstream_fixes-1.patch</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/prog/subversion.xml:171
#, xml-text
msgid ""
"After modifying the SWIG bindings like we did with the patch, the build "
"system must be regenerated so the bindings pick up the changes:"
msgstr ""
"Depois de modificar as ligações SWIG como nós fizemos com o remendo, o "
"sistema de construção precisa ser regenerado de forma que as ligações "
"absorvam as mudanças:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/prog/subversion.xml:175
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"pre\">touch build/generator/swig/*.py &amp;&amp;\n"
"mv -v build-outputs.mk{,.old}   &amp;&amp;\n"
"./autogen.sh --release</userinput>"
msgstr ""
"<userinput remap=\"pre\">touch build/generator/swig/*.py &amp;&amp;\n"
"mv -v build-outputs.mk{,.old}   &amp;&amp;\n"
"./autogen.sh --release</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/prog/subversion.xml:180
#, xml-text
msgid ""
"Install <application>Subversion</application> by running the following "
"commands:"
msgstr ""
"Instale <application>Subversion</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/prog/subversion.xml:184
#, no-wrap, xml-text
msgid ""
"<userinput>PYTHON=python3                        \\\n"
"./configure --prefix=/usr             \\\n"
"            --disable-static          \\\n"
"            --with-apache-libexecdir  \\\n"
"            --with-utf8proc=internal &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>PYTHON=python3                        \\\n"
"./configure --prefix=/usr             \\\n"
"            --disable-static          \\\n"
"            --with-apache-libexecdir  \\\n"
"            --with-utf8proc=internal &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/prog/subversion.xml:192
#, xml-text
msgid ""
"If you have <xref linkend=\"doxygen\"/> installed and you wish to build the "
"API documentation, issue:"
msgstr ""
"Se você tiver &quot;<xref linkend=\"doxygen\"/>&quot; instalado e desejar "
"construir a documentação da &quot;API&quot;, emita:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/prog/subversion.xml:196
#, no-wrap, xml-text
msgid "<userinput>doxygen doc/doxygen.conf</userinput>"
msgstr "<userinput>doxygen doc/doxygen.conf</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/prog/subversion.xml:199
#, xml-text
msgid ""
"If you wish to build the Java bindings pass the <option>--enable-"
"javahl</option> parameter to the <command>configure</command> command. In "
"addition, if you want to run the Java test suite, you have to specify the "
"location of the <application>JUnit</application> file by adding "
"<option>--with-junit=&lt;path to junit jar&gt;</option> (for instance "
"<option>--with-junit=/usr/local/java/lib/junit-4.13.jar</option>)  to "
"<command>configure</command>. The JUnit jar file is no longer included in "
"<xref linkend=\"apache-ant\"/> and must be downloaded separately. To build "
"the Java bindings, issue the following command:"
msgstr ""
"Se você deseja construir as ligações Java, [então] passe o parâmetro "
"&quot;<option>--enable-javahl</option>&quot; para o comando "
"&quot;<command>configure</command>&quot;. Além disso, se desejar executar a "
"suíte de teste &quot;Java&quot;, [então] você tem de especificar o local do "
"arquivo &quot;<application>JUnit</application>&quot; adicionando "
"&quot;<option>--with-junit=&lt;caminho para o jar junit&gt;</option>&quot; "
"(por exemplo &quot;<option>--with-"
"junit=/usr/local/java/lib/junit-4.13.jar</option>&quot;) para o "
"&quot;<command>configure</command>&quot;. O arquivo &quot;jar&quot; do "
"&quot;JUnit&quot; não mais está incluído em &quot;<xref linkend=\"apache-"
"ant\"/>&quot; e precisa ser baixado separadamente. Para construir as "
"ligações &quot;Java&quot;, emita o seguinte comando:"

#. type: Content of: <sect1><sect2><para><screen>
#: blfs-en/general/prog/subversion.xml:210
#, no-wrap, xml-text
msgid "<command>make -j1 javahl</command>"
msgstr "<command>make -j1 javahl</command>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/prog/subversion.xml:210
#: blfs-en/general/prog/subversion.xml:219
#: blfs-en/general/prog/subversion.xml:257
#: blfs-en/general/prog/subversion.xml:268
#, xml-text
msgid "<placeholder type=\"screen\" id=\"0\"/>"
msgstr "<placeholder type=\"screen\" id=\"0\"/>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/prog/subversion.xml:214
#, xml-text
msgid ""
"If you want to compile <application>Perl</application>, "
"<application>Python</application>, or <application>Ruby</application> "
"bindings, issue any of the following command:"
msgstr ""
"Se tu desejar compilar ligações &quot;<application>Perl</application>&quot;,"
" &quot;<application>Python</application>&quot; ou "
"&quot;<application>Ruby</application>&quot;, [então] emita algum dos "
"seguintes comandos:"

#. type: Content of: <sect1><sect2><para><screen>
#: blfs-en/general/prog/subversion.xml:219
#, no-wrap, xml-text
msgid ""
"<command>make swig-pl</command> # for <application>Perl</application>\n"
"<command>make swig-py \\\n"
"     swig_pydir=/usr/lib/python&python3-majorver;/site-packages/libsvn \\\n"
"     swig_pydir_extra=/usr/lib/python&python3-majorver;/site-packages/svn</command> # for <application>Python</application>\n"
"<command>make swig-rb</command> # for <application>Ruby</application>"
msgstr ""
"<command>make swig-pl</command> # para <application>Perl</application>\n"
"<command>make swig-py \\\n"
"     swig_pydir=/usr/lib/python&python3-majorver;/site-packages/libsvn \\\n"
"     swig_pydir_extra=/usr/lib/python&python3-majorver;/site-packages/svn</command> # para <application>Python</application>\n"
"<command>make swig-rb</command> # para <application>Ruby</application>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/prog/subversion.xml:227
#, xml-text
msgid ""
"To test the results, issue: <command>make check</command>. Four tests in the"
" <filename>commit_tests.py</filename>, <filename>prop_tests.py</filename>, "
"and <filename>update_tests.py</filename> suites are known to fail. Due to "
"changes in Python-3.12, you can expect to see around 200 Syntax Warnings "
"during the test suite due to invalid escape sequences."
msgstr ""
"Para testar os resultados, emita: <command>make check</command>. Quatro "
"testes nas suítes <filename>commit_tests.py</filename>, "
"<filename>prop_tests.py</filename> e <filename>update_tests.py</filename> "
"são conhecidos por falharem. Devido às mudanças no Python-3.12, você pode "
"esperar ver cerca de 200 avisos de sintaxe durante a suíte de teste devido a"
" sequências inválidas de escape."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/prog/subversion.xml:236
#, xml-text
msgid ""
"To test the results of any of the <application>SWIG</application> bindings, "
"you can use any of the following commands: <command>make check-swig-"
"pl</command>, <command>make check-swig-py</command>, or <command>make check-"
"swig-rb</command>."
msgstr ""
"Para testar os resultados de quaisquer das ligações "
"&quot;<application>SWIG</application>&quot;, você pode usar algum dos "
"seguintes comandos: &quot;<command>make check-swig-pl</command>&quot;, "
"&quot;<command>make check-swig-py</command>&quot; ou &quot;<command>make "
"check-swig-rb</command>&quot;."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/prog/subversion.xml:244
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/prog/subversion.xml:247
#, no-wrap, xml-text
msgid ""
"<userinput>make install &amp;&amp;\n"
"\n"
"install -v -m755 -d /usr/share/doc/subversion-&subversion-version; &amp;&amp;\n"
"cp      -v -R doc/* /usr/share/doc/subversion-&subversion-version;</userinput>"
msgstr ""
"<userinput>make install &amp;&amp;\n"
"\n"
"install -v -m755 -d /usr/share/doc/subversion-&subversion-version; &amp;&amp;\n"
"cp     -v -R doc/* /usr/share/doc/subversion-&subversion-version;</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/prog/subversion.xml:253
#, xml-text
msgid ""
"If you built the Java bindings, issue the following command as the "
"<systemitem class=\"username\">root</systemitem> user to install them:"
msgstr ""
"Se você construiu as ligações &quot;Java&quot;, [então] emita o seguinte "
"comando como o(a) usuário(a) &quot;<systemitem "
"class=\"username\">root</systemitem>&quot; para instalá-las:"

#. type: Content of: <sect1><sect2><para><screen>
#: blfs-en/general/prog/subversion.xml:257
#, no-wrap, xml-text
msgid "<command>make install-javahl</command>"
msgstr "<command>make install-javahl</command>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/prog/subversion.xml:261
#, xml-text
msgid ""
"If you built the <application>Perl</application>, "
"<application>Python</application>, or <application>Ruby</application> "
"bindings, issue any of the following commands as the <systemitem "
"class=\"username\">root</systemitem> user to install them:"
msgstr ""
"Se você construiu as ligações &quot;<application>Perl</application>&quot;, "
"&quot;<application>Python</application>&quot; ou "
"&quot;<application>Ruby</application>&quot;, [então] emita algum dos "
"seguintes comandos como o(a) usuário(a) &quot;<systemitem "
"class=\"username\">root</systemitem>&quot; para instalá-las:"

#. type: Content of: <sect1><sect2><para><screen>
#: blfs-en/general/prog/subversion.xml:268
#, no-wrap, xml-text
msgid ""
"<command>make install-swig-pl</command>\n"
"<command>make install-swig-py \\\n"
"      swig_pydir=/usr/lib/python&python3-majorver;/site-packages/libsvn \\\n"
"      swig_pydir_extra=/usr/lib/python&python3-majorver;/site-packages/svn</command>\n"
"<command>make install-swig-rb</command>"
msgstr ""
"<command>make install-swig-pl</command>\n"
"<command>make install-swig-py \\\n"
"     swig_pydir=/usr/lib/python&python3-majorver;/site-packages/libsvn \\\n"
"     swig_pydir_extra=/usr/lib/python&python3-majorver;/site-packages/svn</command>\n"
"<command>make install-swig-rb</command>"

#.  ~~ This explanation is added to the configure above ~~
#.       The <application>
#. JUnit</application> testing framework must be installed,
#.       and the location of the JUnit jar has to be specified by passing the
#.       <option>- -with-junit=&lt;path to junit jar&gt;</option> parameter to
#.       <command>configure</command>. Note that
#. <application>JUnit</application>
#.       is included in <xref linkend="apache-ant"/>, and can be accessed by
#.       passing <option>- -with-junit=/opt/ant/lib/junit-4.12.jar</option>
#.       to <command>configure</command>.
#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/prog/subversion.xml:276
#, xml-text
msgid ""
"The java bindings need to be installed in order for the tests to run, since "
"the tests attempt to look for them in CLASSPATH. To test the results of the "
"Java bindings build, issue <command>LANG=C make check-javahl</command>."
msgstr ""
"As ligações &quot;Java&quot; precisam ser instaladas para a finalidade de "
"que os testes executem, pois os testes tentam procurá-las em "
"&quot;CLASSPATH&quot;. Para testar os resultados da construção de ligações "
"&quot;Java&quot;, emita &quot;<command>LANG=C make check-"
"javahl</command>&quot;."

#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/prog/subversion.xml:293
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/prog/subversion.xml:299
#, xml-text
msgid ""
"<parameter>--with-apache-libexecdir</parameter>: If <xref "
"linkend=\"apache\"/> is installed, the shared "
"<application>Apache</application> modules are built. This switch allows to "
"have those modules installed to <application>Apache</application>'s "
"configured module dir instead of <filename "
"class=\"directory\">/usr/libexec</filename>. It has no effect if "
"<application>Apache</application> is not installed."
msgstr ""
"<parameter>--with-apache-libexecdir</parameter>: Se o &quot;<xref "
"linkend=\"apache\"/>&quot; estiver instalado, [então] os módulos "
"compartilhados do &quot;<application>Apache</application>&quot; serão "
"construídos. Essa chave permite ter esses módulos instalados no diretório "
"configurado de módulo do &quot;<application>Apache</application>&quot; em "
"vez do &quot;<filename class=\"directory\">/usr/libexec</filename>&quot;. "
"Ela não tem efeito se o &quot;<application>Apache</application>&quot; não "
"estiver instalado."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/prog/subversion.xml:309
#, xml-text
msgid ""
"<parameter>--with-utf8proc=internal</parameter>: Remove these switches if "
"you have installed the optional dependencies."
msgstr ""
"<parameter>--with-utf8proc=internal</parameter>: Remova essas chaves se você"
" tiver instalado as dependências opcionais."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/prog/subversion.xml:314
#, xml-text
msgid ""
"<option>--enable-javahl</option>: enables compilation of Java high level "
"bindings. Running <command>make javahl</command> is necessary to do the "
"compilation."
msgstr ""
"<option>--enable-javahl</option>: habilita a compilação de ligações de alto "
"nível &quot;Java&quot;. Executar &quot;<command>make javahl</command>&quot; "
"é necessário para fazer a compilação."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/prog/subversion.xml:320
#, xml-text
msgid ""
"<option>--with-junit=&lt;location of the junit jar file&gt;</option>: gives "
"the location of the junit jar, otherwise the javahl tests cannot be run."
msgstr ""
"<option>--with-junit=&lt;local do arquivo &quot;jar&quot; do "
"&quot;JUnit&quot;&gt;</option>: dá o local do &quot;jar&quot; do "
"&quot;JUnit&quot;; caso contrário, os testes &quot;javahl&quot; não poderão "
"ser executados."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/prog/subversion.xml:326
#, xml-text
msgid ""
"<option>--disable-gmock</option>: Do not use the Googlemock testing "
"framework."
msgstr ""
"<option>--disable-gmock</option>: Não use a estrutura de testes "
"&quot;Googlemock&quot;."

