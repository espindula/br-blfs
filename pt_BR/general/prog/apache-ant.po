#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/prog/apache-ant.xml:168
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/prog/apache-ant.xml:171
#, xml-text
msgid ""
"<command>bootstrap/bin/ant -f fetch.xml -Ddest=optional</command>: Downloads"
" the missing dependencies to the user's home directory, and copies them into"
" the source tree (in the <filename>lib/optional</filename> directory, where "
"<command>ant</command> picks them up at build time)."
msgstr ""
"<command>bootstrap/bin/ant -f fetch.xml -Ddest=optional</command>: Transfere"
" as dependências ausentes para o diretório inicial do(a) usuário(a) e as "
"copia na árvore do fonte (no diretório "
"&quot;<filename>lib/optional</filename>&quot;, onde o "
"&quot;<command>ant</command>&quot; os coleta ao tempo da construção)."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/prog/apache-ant.xml:178
#, xml-text
msgid ""
"<command>./build.sh -Ddist.dir=$PWD/ant-&apache-ant-version; dist</command>:"
" This command builds, tests, then installs the package into a temporary "
"directory."
msgstr ""
"<command>./build.sh -Ddist.dir=$PWD/ant-&apache-ant-version; dist</command>:"
" Esse comando constrói, testa e, então, instala o pacote em um diretório "
"temporário."

