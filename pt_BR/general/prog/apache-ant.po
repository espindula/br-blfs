#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/general/prog/apache-ant.xml:215
#, xml-text
msgid ""
"Some packages will require <command>ant</command> to be in the search path "
"and the <envar>ANT_HOME</envar> environment variable defined. Satisfy these "
"requirements by issuing, as the <systemitem "
"class=\"username\">root</systemitem> user:"
msgstr ""
"Alguns pacotes exigirão que o &quot;<command>ant</command>&quot; esteja no "
"caminho de pesquisa e que a variável de ambiente "
"&quot;<envar>ANT_HOME</envar>&quot; esteja definida. Satisfaça essas "
"exigências emitindo, como o(a) usuário(a) &quot;<systemitem "
"class=\"username\">root</systemitem>&quot;:"

#. type: Content of: <sect1><sect2><sect3><screen>
#: blfs-en/general/prog/apache-ant.xml:221
#, no-wrap, xml-text
msgid ""
"<userinput>cat &gt; /etc/profile.d/ant.sh &lt;&lt; EOF\n"
"<literal># Begin /etc/profile.d/ant.sh\n"
"\n"
"pathappend /opt/ant/bin\n"
"export ANT_HOME=/opt/ant\n"
"\n"
"# End /etc/profile.d/ant.sh</literal>\n"
"EOF</userinput>"
msgstr ""
"<userinput>cat &gt; /etc/profile.d/ant.sh &lt;&lt; EOF\n"
"<literal># Inicia /etc/profile.d/ant.sh\n"
"\n"
"pathappend /opt/ant/bin\n"
"export ANT_HOME=/opt/ant\n"
"\n"
"# Termina /etc/profile.d/ant.sh</literal>\n"
"EOF</userinput>"

