#.             by automatically converting code to be Python3 compatible.
#.           </para>
#.           <indexterm zone="python3 2to3">
#.             <primary sortas="b-2to3">2to3</primary>
#.           </indexterm>
#.         </listitem>
#.       </varlistentry>
#.       Put here for easy use when removing Python2
