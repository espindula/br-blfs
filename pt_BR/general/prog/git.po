#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/general/prog/git.xml:114
#, xml-text
msgid "Optional"
msgstr "Opcionais"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/prog/git.xml:116
#, xml-text
msgid ""
"<xref linkend=\"apache\"/> (for some tests), <xref role='runtime' "
"linkend='fcron'/> (runtime, for scheduling <command>git "
"maintenance</command> jobs), <xref role=\"runtime\" linkend=\"gnupg2\"/> "
"(runtime, may be used to sign <application>Git</application> commits or "
"tags, or verify the signatures of them), <xref role=\"runtime\" "
"linkend=\"openssh\"/> (runtime, needed to use <application>Git</application>"
" over ssh), <xref linkend=\"pcre2\"/> (<emphasis>or</emphasis> the "
"deprecated <xref role=\"nodep\" linkend=\"pcre\"/>), in either case "
"configured with <literal>--enable-jit</literal>, <xref role=\"runtime\" "
"linkend=\"subversion\"/> with Perl bindings (runtime, for <command>git "
"svn</command>), <xref role=\"runtime\" linkend=\"tk\"/> (gitk, a simple "
"<application>Git</application> repository viewer, uses "
"<application>Tk</application> at runtime), <xref linkend=\"valgrind\"/>, "
"<ulink url=\"https://metacpan.org/pod/Authen::SASL\">Authen::SASL</ulink> "
"and <ulink "
"url=\"https://metacpan.org/pod/MIME::Base64\">MIME::Base64</ulink> (both "
"runtime, for <command>git send-email</command>), <phrase revision='sysv'>and"
" </phrase><xref linkend='perl-io-socket-ssl'/> (runtime, for <command>git "
"send-email</command> to connect to a SMTP server with SSL encryption)<phrase"
" revision='systemd'>, and <xref role='runtime' linkend='systemd'/> (runtime,"
" rebuilt with <xref role='nodep' linkend='linux-pam'/>, for scheduling "
"<command>git maintenance</command> jobs)</phrase>"
msgstr ""
"<xref linkend=\"apache\"/> (para alguns testes), <xref role='runtime' "
"linkend='fcron'/> (tempo de execução, para agendamento de tarefas "
"<command>git maintenance</command>), <xref role=\"runtime\" linkend=\"gnupg2"
"\"/> (tempo de execução, possivelmente seja usado para assinar commits ou "
"tags do <application>Git</application>, ou para verificar as assinaturas "
"deles(as)), <xref role=\"runtime\" linkend=\"openssh\"/> (tempo de execução, "
"necessário para usar <application>Git</application> sobre ssh), <xref "
"linkend=\"pcre2\"/> (<emphasis>ou</emphasis> o obsoleto <xref role=\"nodep\" "
"linkend=\"pcre\"/>), em ambos os casos configurado com <literal>--enable-"
"jit</literal>, <xref role=\"runtime\" linkend=\"subversion\"/> com ligações "
"Perl (tempo de execução, para <command>git svn</command>), <xref role="
"\"runtime\" linkend=\"tk\"/> (gitk, um visualizador simples de repositórios "
"<application>Git</application>, usa <application>Tk</application> em tempo "
"de execução), <xref linkend=\"valgrind\"/>, <ulink url=\"https://metacpan."
"org/pod/Authen::SASL\">Authen::SASL</ulink> e <ulink url=\"https://metacpan."
"org/pod/MIME::Base64\">MIME::Base64</ulink> (ambos tempo de execução, para "
"<command>git send-email</command>), <phrase revision='sysv'>e </phrase><xref "
"linkend='perl-io-socket-ssl'/> (tempo de execução, para <command>git send-"
"email</command> se conectar a um servidor SMTP com encriptação SSL)<phrase "
"revision='systemd'>, e <xref role='runtime' linkend='systemd'/> (tempo de "
"execução, reconstruído com <xref role='nodep' linkend='linux-pam'/>, para "
"agendamento de tarefas <command>git maintenance</command>)</phrase>"

