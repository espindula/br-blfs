#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/prog/nasm.xml:26
#, xml-text
msgid "Introduction to NASM"
msgstr "Introdução ao \"NASM\""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/prog/nasm.xml:29
#, xml-text
msgid ""
"<application>NASM</application> (Netwide Assembler) is an 80x86 assembler "
"designed for portability and modularity. It includes a disassembler as well."
msgstr ""
"<application>NASM</application> (\"Netwide Assembler\") é um montador "
"\"80x86\" projetado para portabilidade e modularidade. Inclui também um "
"desmontador."

