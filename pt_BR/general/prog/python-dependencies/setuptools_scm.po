msgid "Introduction to Setuptools_scm Module"
msgstr "Introdução ao Módulo Setuptools_scm"

#. type: Content of: <sect2><sect3><para>
#: blfs-en/general/prog/python-dependencies/setuptools_scm.xml:27
#, xml-text
msgid ""
"The <application>Setuptools_scm</application> package is used to extract "
"Python package versions from git or hg metadata instead of declaring them."
msgstr ""
"O pacote &quot;<application>Setuptools_scm</application>&quot; é usado para "
"extrair versões de pacotes &quot;Python&quot; a partir dos metadados "
"&quot;git&quot; ou &quot;hg&quot; em vez de declará-los."

