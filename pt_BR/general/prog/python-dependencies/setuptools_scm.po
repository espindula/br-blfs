#: blfs-en/general/prog/python-dependencies/setuptools_scm.xml:78
#, xml-text
msgid ""
"<xref linkend=\"git\"/>, <xref linkend=\"mercurial\"/>, <xref "
"linkend=\"pytest\"/>, <xref linkend=\"sudo\"/>, and <ulink "
"url=\"https://pypi.org/project/build/\">build</ulink>"
msgstr ""
"<xref linkend=\"git\"/>, <xref linkend=\"mercurial\"/>, <xref "
"linkend=\"pytest\"/>, <xref linkend=\"sudo\"/> e <ulink "
"url=\"https://pypi.org/project/build/\">build</ulink>"

#. type: Content of: <sect2><sect3><title>
#: blfs-en/general/prog/python-dependencies/setuptools_scm.xml:88
#, xml-text
msgid "Installation of Setuptools_scm"
msgstr "Instalação do Setuptools_scm"

#. type: Content of: <sect2><sect3><para>
#: blfs-en/general/prog/python-dependencies/setuptools_scm.xml:90
#, xml-text
msgid "Build the module:"
msgstr "Construa o módulo:"

#. type: Content of: <sect2><sect3><para>
#: blfs-en/general/prog/python-dependencies/setuptools_scm.xml:95
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) &quot;<systemitem "
"class=\"username\">root</systemitem>&quot;:"

#. type: Content of: <sect2><sect3><screen>
#: blfs-en/general/prog/python-dependencies/setuptools_scm.xml:98
#, no-wrap, xml-text
msgid "<userinput>&install-wheel; setuptools_scm</userinput>"
msgstr "<userinput>&install-wheel; setuptools_scm</userinput>"

#. type: Content of: <sect2><sect3><para>
#: blfs-en/general/prog/python-dependencies/setuptools_scm.xml:101
#, xml-text
msgid ""
"To test the installation, make sure <xref linkend='pytest'/> is installed "
"and run:"
msgstr ""
"Para testar a instalação, certifique-se de que <xref linkend='pytest'/> "
"esteja instalado e execute:"

#. type: Content of: <sect2><sect3><screen>
#: blfs-en/general/prog/python-dependencies/setuptools_scm.xml:105
#, no-wrap, xml-text
msgid ""
"<userinput>python3 -m venv --system-site-packages testenv &amp;&amp;\n"
"testenv/bin/pip3 install build                 &amp;&amp;\n"
"testenv/bin/python -m pytest</userinput>"
msgstr ""
"<userinput>python3 -m venv --system-site-packages testenv &amp;&amp;\n"
"testenv/bin/pip3 install build                 &amp;&amp;\n"
"testenv/bin/python -m pytest</userinput>"

#. type: Content of: <sect2><sect3><para>
#: blfs-en/general/prog/python-dependencies/setuptools_scm.xml:110
#, xml-text
msgid ""
"If <xref linkend='git'/> and/or <xref linkend='mercurial'/> are not "
"installed, the tests depending on the missing one(s) will be skipped.  Some "
"tests may invoke <xref linkend='sudo'/> and request a password.  Some tests "
"may fail if your <application>git</application> configuration is not the one"
" expected by the test suite."
msgstr ""
"Se <xref linkend='git'/> e (ou) <xref linkend='mercurial'/> não estiverem "
"instalados, os testes dependentes do(s) ausente(s) serão ignorados. Alguns "
"testes podem invocar <xref linkend='sudo'/> e solicitar uma senha. Alguns "
"testes podem falhar se tua configuração do <application>git</application> "
"não for a esperada pelo suíte de teste."

