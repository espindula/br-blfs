"class=\"username\">root</systemitem>&quot;:"

#. type: Content of: <sect2><sect3><screen>
#: blfs-en/general/prog/python-dependencies/attrs.xml:103
#, no-wrap, xml-text
msgid "<userinput>&install-wheel; attrs</userinput>"
msgstr "<userinput>&install-wheel; attrs</userinput>"

#. type: Content of: <sect2><sect3><para>
#: blfs-en/general/prog/python-dependencies/attrs.xml:106
#, xml-text
msgid "To test the installation, run:"
msgstr "Para testar a instalação, execute:"

#. type: Content of: <sect2><sect3><screen>
#: blfs-en/general/prog/python-dependencies/attrs.xml:109
#, no-wrap, xml-text
#| msgid ""
#| "<userinput>python3 -m venv --system-site-packages testenv &amp;&amp;\n"
#| "source testenv/bin/activate                    &amp;&amp;\n"
#| "pip3 install attrs[tests]                      &amp;&amp;\n"
#| "python3 /usr/bin/pytest                        &amp;&amp;\n"
#| "deactivate</userinput>"
msgid ""
"<userinput>python3 -m venv --system-site-packages testenv           &amp;&amp;\n"
"testenv/bin/pip3 install 'attrs[tests]' 'mypy &lt; 1.10'    &amp;&amp;\n"
"PATH=$PWD/testenv/bin:$PATH testenv/bin/python -m pytest</userinput>"
msgstr ""
"<userinput>python3 -m venv --system-site-packages testenv           &amp;&amp;\n"
"testenv/bin/pip3 install 'attrs[tests]' 'mypy &lt; 1.10'    &amp;&amp;\n"
"PATH=$PWD/testenv/bin:$PATH testenv/bin/python -m pytest</userinput>"

#. type: Content of: <sect2><sect3><para>
#: blfs-en/general/prog/python-dependencies/attrs.xml:115
#, xml-text
msgid ""
"One test named <literal>TestAssoc::test_unknown</literal> is known to fail "
"with pytest-8.0.0 or later."
msgstr ""
"Um teste chamado <literal>TestAssoc::test_unknown</literal> é conhecido por "
"falhar com pytest-8.0.0 ou posterior."

