#. type: Content of: <sect2><sect3><title>
#: blfs-en/general/prog/python-dependencies/attrs.xml:83
#, xml-text
msgid "Installation of Attrs"
msgstr "Instalação do Attrs"

#. type: Content of: <sect2><sect3><para>
#: blfs-en/general/prog/python-dependencies/attrs.xml:85
#, xml-text
msgid "Build the module:"
msgstr "Construa o módulo:"

#. type: Content of: <sect2><sect3><para>
#: blfs-en/general/prog/python-dependencies/attrs.xml:90
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) &quot;<systemitem "
"class=\"username\">root</systemitem>&quot;:"

#. type: Content of: <sect2><sect3><screen>
#: blfs-en/general/prog/python-dependencies/attrs.xml:93
#, no-wrap, xml-text
msgid "<userinput>&install-wheel; attrs</userinput>"
msgstr "<userinput>&install-wheel; attrs</userinput>"

#. type: Content of: <sect2><sect3><para>
#: blfs-en/general/prog/python-dependencies/attrs.xml:96
#, xml-text
msgid "To test the installation, run:"
msgstr "Para testar a instalação, execute:"

#. type: Content of: <sect2><sect3><screen>
#: blfs-en/general/prog/python-dependencies/attrs.xml:99
#, no-wrap, xml-text
msgid ""
"<userinput>python3 -m venv --system-site-packages testenv &amp;&amp;\n"
"source testenv/bin/activate                    &amp;&amp;\n"
"pip3 install attrs[tests]                      &amp;&amp;\n"
"python3 /usr/bin/pytest                        &amp;&amp;\n"
"deactivate</userinput>"
msgstr ""
"<userinput>python3 -m venv --system-site-packages testenv &amp;&amp;\n"
"source testenv/bin/activate                   &amp;&amp;\n"
"pip3 install attrs[tests]                      &amp;&amp;\n"
"python3 /usr/bin/pytest                        &amp;&amp;\n"
"deactivate</userinput>"

