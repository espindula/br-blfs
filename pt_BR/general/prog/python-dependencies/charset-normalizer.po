#: blfs-en/general/prog/python-dependencies/charset-normalizer.xml:93
#, xml-text
msgid ""
"Assuming <xref linkend=\"pytest\"/> is installed, but the other optional "
"dependencies are not, the installation can be tested with the following "
"commands:"
msgstr ""
"Supondo que &quot;<xref linkend=\"pytest\"/>&quot; esteja instalado, mas as "
"outras dependências opcionais não estejam, a instalação pode ser testada com"
" os seguintes comandos:"

#.  no && because of a possible error
#. type: Content of: <sect2><sect3><screen>
#: blfs-en/general/prog/python-dependencies/charset-normalizer.xml:98
#, no-wrap, xml-text
msgid ""
"<userinput>python3 -m venv --system-site-packages testenv &amp;&amp;\n"
"source testenv/bin/activate                    &amp;&amp;\n"
"pip3 install pytest-cov                        &amp;&amp;\n"
"python3 /usr/bin/pytest\n"
"deactivate</userinput>"
msgstr ""
"<userinput>python3 -m venv --system-site-packages testenv &amp;&amp;\n"
"source testenv/bin/activate                   &amp;&amp;\n"
"pip3 install pytest-cov                        &amp;&amp;\n"
"python3 /usr/bin/pytest\n"
"deactivate</userinput>"

