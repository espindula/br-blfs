#. type: Content of: <sect2><sect3><title>
#: blfs-en/general/prog/python-dependencies/msgpack.xml:24
#, xml-text
msgid "Introduction to Msgpack Module"
msgstr "Introdução ao Módulo Msgpack"

#. type: Content of: <sect2><sect3><para>
#: blfs-en/general/prog/python-dependencies/msgpack.xml:27
#, xml-text
msgid ""
"<application>Msgpack</application> is an efficient binary serialization "
"format. It lets you exchange data among multiple languages like JSON. But "
"it's faster and smaller. This package provides CPython bindings for reading "
"and writing Msgpack data."
msgstr ""
"<application>Msgpack</application> é um formato de serialização binária "
"eficiente. Ele te permite trocar dados entre várias linguagens, como JSON. "
"Mas é mais rápido e menor. Esse pacote fornece ligações CPython para leitura"
" e escrita de dados do Msgpack."

