#. type: Content of: <sect2><sect3><para>
#: blfs-en/general/prog/python-dependencies/idna.xml:27
#, xml-text
msgid ""
"The <application>Idna</application> module provides support for the "
"Internationalized Domain Names in Applications (IDNA) protocol as specified "
"in RFC 5891."
msgstr ""
"O módulo &quot;<application>Idna</application>&quot; fornece suporte para o "
"protocolo &quot;Internationalized Domain Names in Applications&quot; "
"(&quot;IDNA&quot;), conforme especificado na &quot;RFC&quot; 5891."

