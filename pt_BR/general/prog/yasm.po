msgstr "<filename class=\"libraryfile\">libyasm.a</filename>"

#. type: Content of:
#. <sect1><sect2><variablelist><varlistentry><listitem><para>
#: blfs-en/general/prog/yasm.xml:160
#, xml-text
msgid ""
"provides all of the core functionality of <command>yasm</command>, for "
"manipulating machine instructions and object file constructs"
msgstr ""
"fornece todas as funcionalidades centrais do "
"&quot;<command>yasm</command>&quot;, para manipular instruções de máquina e "
"construções de arquivos de objetos"

