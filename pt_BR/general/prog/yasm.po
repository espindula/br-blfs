#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/prog/yasm.xml:26
#, xml-text
msgid "Introduction to yasm"
msgstr "Introdução ao yasm"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/prog/yasm.xml:29
#, xml-text
msgid ""
"<application>Yasm</application> is a complete rewrite of the <xref "
"linkend=\"nasm\"/> assembler. It supports the x86 and AMD64 instruction "
"sets, accepts NASM and GAS assembler syntaxes and outputs binary, ELF32 and "
"ELF64 object formats."
msgstr ""
"&quot;<application>Yasm</application>&quot; é uma reescrita completa do "
"montador &quot;<xref linkend=\"nasm\"/>&quot;. Ele suporta conjuntos de "
"instruções &quot;x86&quot; e &quot;AMD64&quot;, aceita sintaxes de montador "
"&quot;NASM&quot; e &quot;GAS&quot; e gera formatos de objetos binário, "
"&quot;ELF32&quot; e &quot;ELF64&quot;."

