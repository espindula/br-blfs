#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/prog/yasm.xml:83
#, xml-text
msgid "Installation of yasm"
msgstr "Instalação do yasm"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/prog/yasm.xml:86
#, xml-text
msgid ""
"Install <application>yasm</application> by running the following commands:"
msgstr ""
"Instale &quot;<application>yasm</application>&quot; executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/prog/yasm.xml:90
#, no-wrap, xml-text
msgid ""
"<userinput>sed -i 's#) ytasm.*#)#' Makefile.in &amp;&amp;\n"
"\n"
"./configure --prefix=/usr &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>sed -i 's#) ytasm.*#)#' Makefile.in &amp;&amp;\n"
"\n"
"./configure --prefix=/usr &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/prog/yasm.xml:96
#, xml-text
msgid "To test the results, issue: <command>make -j1 check</command>."
msgstr "Para testar os resultados, emita: <command>make -j1 check</command>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/prog/yasm.xml:104
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) &quot;<systemitem "
"class=\"username\">root</systemitem>&quot;:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/prog/yasm.xml:107
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/prog/yasm.xml:112
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/prog/yasm.xml:115
#, xml-text
msgid ""
"<command>sed -i 's#) ytasm.*#)#' Makefile.in</command>: This sed prevents it"
" compiling 2 programs (vsyasm and ytasm) that are only of use on Microsoft "
"Windows."
msgstr ""
"<command>sed -i 's#) ytasm.*#)#' Makefile.in</command>: Esse &quot;sed&quot;"
" impede a compilação de dois aplicativos (&quot;vsyasm&quot; e "
"&quot;ytasm&quot;) que são de uso somente no &quot;Microsoft Windows&quot;."

