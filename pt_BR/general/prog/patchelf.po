#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/prog/patchelf.xml:72
#, xml-text
msgid "Installation of Patchelf"
msgstr "Instalação do \"Patchelf\""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/prog/patchelf.xml:75
#, xml-text
msgid ""
"Install <application>patchelf</application> by running the following "
"commands:"
msgstr ""
"Instale <application>patchelf</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/prog/patchelf.xml:79
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr \\\n"
"            --docdir=/usr/share/doc/patchelf-&patchelf-version; &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>./configure --prefix=/usr \\\n"
"           --docdir=/usr/share/doc/patchelf-&patchelf-version; &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/prog/patchelf.xml:84
#, xml-text
msgid "To test the results, issue: <command>make check</command>."
msgstr "Para testar os resultados, emita: <command>make check</command>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/prog/patchelf.xml:88
#, xml-text
msgid "Now, as the &root; user:"
msgstr "Agora, como o(a) usuário(a) &root;:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/prog/patchelf.xml:91
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

