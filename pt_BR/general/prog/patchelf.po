#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/prog/patchelf.xml:26
#, xml-text
msgid "Introduction to Patchelf"
msgstr "Introdução ao \"Patchelf\""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/prog/patchelf.xml:29
#, xml-text
msgid ""
"The <application>patchelf</application> package contains a small utility to "
"modify the dynamic linker and RPATH of ELF executables."
msgstr ""
"O pacote <application>patchelf</application> contém um pequeno utilitário "
"para modificar o vinculador dinâmico e o \"RPATH\" dos executáveis \"ELF\"."

