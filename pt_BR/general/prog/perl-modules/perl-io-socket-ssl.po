"<userinput>yes | perl Makefile.PL &amp;&amp;\n"
"make             &amp;&amp;\n"
"make test</userinput>"
msgstr ""
"<userinput>yes | perl Makefile.PL &amp;&amp;\n"
"make            &amp;&amp;\n"
"make test</userinput>"

