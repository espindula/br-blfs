#. type: Content of: <sect2><sect3><title>
#: blfs-en/general/prog/python-modules/py3c.xml:80
#, xml-text
msgid "Installation of Py3c"
msgstr "Instalação do Py3c"

#. type: Content of: <sect2><sect3><para>
#: blfs-en/general/prog/python-modules/py3c.xml:83
#, xml-text
msgid ""
"The <application>Py3c</application> package is a headers-only package and "
"because of that, no configuration and compilation is required."
msgstr ""
"O pacote &quot;<application>Py3c</application>&quot; é um pacote somente de "
"cabeçalhos e, por isso, nenhuma configuração e compilação é necessária."

#. type: Content of: <sect2><sect3><para>
#: blfs-en/general/prog/python-modules/py3c.xml:89
#, xml-text
msgid "To test the package, issue:"
msgstr "Para testar o pacote, emita:"

#. type: Content of: <sect2><sect3><screen>
#: blfs-en/general/prog/python-modules/py3c.xml:92
#, no-wrap, xml-text
msgid ""
"<userinput>make test-python3 &amp;&amp;\n"
"make test-python3-cpp</userinput>"
msgstr ""
"<userinput>make test-python3 &amp;&amp;\n"
"make test-python3-cpp</userinput>"

#. type: Content of: <sect2><sect3><para>
#: blfs-en/general/prog/python-modules/py3c.xml:96
#, xml-text
msgid ""
"To install the <application>Python 3</application> module, run the following"
" command as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Para instalar o módulo &quot;<application>Python 3</application>&quot;, "
"execute o seguinte comando como o(a) usuário(a) &quot;<systemitem "
"class=\"username\">root</systemitem>&quot;:"

#.  Note:
#.   Now, doing a DESTDIR install is just
#.     "make prefix=/usr DESTDIR=<dest> install"
#. type: Content of: <sect2><sect3><screen>
#: blfs-en/general/prog/python-modules/py3c.xml:105
#, no-wrap, xml-text
msgid "<userinput>make prefix=/usr install</userinput>"
msgstr "<userinput>make prefix=/usr install</userinput>"

