#. type: Content of: <sect2><sect3><para>
#: blfs-en/general/prog/python-modules/docutils.xml:28
#, xml-text
msgid ""
"<application>docutils</application> is a set of "
"<application>Python</application> modules and programs for processing "
"plaintext docs into formats such as HTML, XML, or LaTeX."
msgstr ""
"&quot;<application>docutils</application>&quot; é um conjunto de módulos e "
"programas &quot;<application>Python</application>&quot; para processar "
"documentos de texto simples em formatos como &quot;HTML&quot;, "
"&quot;XML&quot; ou &quot;LaTeX&quot;."

