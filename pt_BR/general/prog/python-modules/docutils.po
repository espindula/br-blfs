#, xml-text
#~ msgid ""
#~ "To reduce the time needed for loading Python scripts, <command>pip3 "
#~ "install</command> will compile the scripts with extension <filename "
#~ "class='extension'>.py</filename> into byte code and save the result into "
#~ "<filename class='extension'>.pyc</filename> files in the directory <filename"
#~ " class='directory'>__pycache__</filename>.  But this package installs "
#~ "<filename class='extension'>.py</filename> scripts into <filename "
#~ "class='directory'>/usr/bin</filename>.  So the byte code files for them will"
#~ " be installed into <filename "
#~ "class='directory'>/usr/bin/__pycache__</filename>, which is not allowed by "
#~ "FHS.  Still as the &root; user, remove this directory:"
#~ msgstr ""
#~ "Para reduzir o tempo necessário para carregar &quot;scripts&quot; "
#~ "&quot;Python&quot;, &quot;<command>pip3 install</command>&quot; compilará os"
#~ " &quot;scripts&quot; com extensão &quot;<filename "
#~ "class='extension'>.py</filename>&quot; em código de bytes e salvará o "
#~ "resultado em arquivos &quot;<filename "
#~ "class='extension'>.pyc</filename>&quot; no diretório &quot;<filename "
#~ "class='directory'>__pycache__</filename>&quot;. Mas esse pacote instala "
#~ "&quot;scripts&quot; &quot;<filename class='extension'>.py</filename>&quot; "
#~ "em &quot;<filename class='directory'>/usr/bin</filename>&quot;. Portanto, os"
#~ " arquivos de código de bytes para eles serão instalados em &quot;<filename "
#~ "class='directory'>/usr/bin/__pycache__</filename>&quot;, o que não é "
#~ "permitido pelo &quot;FHS&quot;. Ainda como o(a) usuário(a) "
#~ "&quot;&root;&quot;, remova esse diretório:"

#, no-wrap, xml-text
#~ msgid "<userinput>rm -rfv /usr/bin/__pycache__</userinput>"
#~ msgstr "<userinput>rm -rfv /usr/bin/__pycache__</userinput>"

#, xml-text
#~ msgid "Editor Notes: <ulink url=\"&blfs-wiki;/docutils\"/>"
