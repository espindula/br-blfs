#. type: Content of: <sect2><sect3><title>
#: blfs-en/general/prog/python-modules/numpy.xml:99
#, xml-text
msgid "Installation of NumPy"
msgstr "Instalação do NumPy"

#. type: Content of: <sect2><sect3><para>
#: blfs-en/general/prog/python-modules/numpy.xml:101
#, xml-text
msgid "Build the module:"
msgstr "Construa o módulo:"

#. type: Content of: <sect2><sect3><screen>
#: blfs-en/general/prog/python-modules/numpy.xml:103
#, no-wrap, xml-text
msgid ""
"<userinput>pip3 wheel -w dist --no-build-isolation --no-deps --no-cache-dir "
"-Csetup-args=-Dallow-noblas=true $PWD</userinput>"
msgstr ""
"<userinput>pip3 wheel -w dist --no-build-isolation --no-deps --no-cache-dir "
"-Csetup-args=-Dallow-noblas=true $PWD</userinput>"

#. type: Content of: <sect2><sect3><para>
#: blfs-en/general/prog/python-modules/numpy.xml:106
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect2><sect3><screen>
#: blfs-en/general/prog/python-modules/numpy.xml:109
#, no-wrap, xml-text
msgid "<userinput>&install-wheel; numpy</userinput>"
msgstr "<userinput>&install-wheel; numpy</userinput>"

#. type: Content of: <sect2><sect3><para>
#: blfs-en/general/prog/python-modules/numpy.xml:112
#, xml-text
msgid "The installation can be tested with the following commands:"
msgstr "A instalação pode ser testada com os seguintes comandos:"

#.  no && because of a possible error
#. type: Content of: <sect2><sect3><screen>
#: blfs-en/general/prog/python-modules/numpy.xml:115
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir -p test                                  &amp;&amp;\n"
"cd       test                                  &amp;&amp;\n"
"python3 -m venv --system-site-packages testenv &amp;&amp;\n"
"source testenv/bin/activate                    &amp;&amp;\n"
"pip3 install hypothesis                        &amp;&amp;\n"
"\n"
"python -c \"import numpy, sys; sys.exit(numpy.test() is False)\"\n"
"deactivate</userinput>"
msgstr ""
"<userinput>mkdir -p test                                  &amp;&amp;\n"
"cd       test                                  &amp;&amp;\n"
"python3 -m venv --system-site-packages testenv &amp;&amp;\n"
"source testenv/bin/activate                    &amp;&amp;\n"
"pip3 install hypothesis                        &amp;&amp;\n"
"\n"
"python -c \"import numpy, sys; sys.exit(numpy.test() is False)\"\n"
"deactivate</userinput>"

