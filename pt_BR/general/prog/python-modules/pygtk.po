#. type: Content of: <sect2><sect3><title>
#: blfs-en/general/prog/python-modules/pygtk.xml:119
#, xml-text
msgid "Installation of PyGTK"
msgstr "Instalação do PyGTK"

#. type: Content of: <sect2><sect3><para>
#: blfs-en/general/prog/python-modules/pygtk.xml:122
#, xml-text
msgid "First, adapt PyGTK to changes in Pango by removing undefined APIs:"
msgstr ""
"Primeiro, adapte o &quot;PyGTK&quot; às mudanças no &quot;Pango&quot; "
"removendo &quot;APIs&quot; indefinidas:"

#. type: Content of: <sect2><sect3><screen>
#: blfs-en/general/prog/python-modules/pygtk.xml:126
#, no-wrap, xml-text
msgid "<userinput remap=\"pre\">sed -i '1394,1402 d' pango.defs</userinput>"
msgstr "<userinput remap=\"pre\">sed -i '1394,1402 d' pango.defs</userinput>"

#. type: Content of: <sect2><sect3><para>
#: blfs-en/general/prog/python-modules/pygtk.xml:129
#, xml-text
msgid ""
"Install <application>PyGTK</application> by running the following commands:"
msgstr ""
"Instale <application>PyGTK</application> executando os seguintes comandos:"

#. type: Content of: <sect2><sect3><screen>
#: blfs-en/general/prog/python-modules/pygtk.xml:133
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>./configure --prefix=/usr &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect2><sect3><para>
#: blfs-en/general/prog/python-modules/pygtk.xml:137
#, xml-text
msgid ""
"The tests must be run from an active X display. If this is so, issue: "
"<command>make check</command>."
msgstr ""
"Os testes precisam ser executados a partir de uma tela ativa do "
"&quot;X&quot;. Se for assim, emita: &quot;<command>make "
"check</command>&quot;."

#. type: Content of: <sect2><sect3><para>
#: blfs-en/general/prog/python-modules/pygtk.xml:142
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) &quot;<systemitem "
"class=\"username\">root</systemitem>&quot;:"

#. type: Content of: <sect2><sect3><screen>
#: blfs-en/general/prog/python-modules/pygtk.xml:145
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

#. type: Content of: <sect2><sect3><title>
#: blfs-en/general/prog/python-modules/pygtk.xml:149
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect2><sect3><para>
#: blfs-en/general/prog/python-modules/pygtk.xml:152
#, xml-text
msgid ""
"<parameter>--enable-docs</parameter>: This option enables rebuilding the "
"html documentation if <xref linkend=\"libxslt\"/> is installed."
msgstr ""
"<parameter>--enable-docs</parameter>: Essa opção habilita reconstruir a "
"documentação &quot;HTML&quot; se &quot;<xref linkend=\"libxslt\"/>&quot; "
"estiver instalado."

