#. type: Content of: <sect2><sect3><para>
#: blfs-en/general/prog/python-modules/pyatspi2.xml:29
#, xml-text
msgid ""
"The <application>PyAtSpi2</application> package contains "
"<application>Python</application> bindings for the core components of the "
"<application>GNOME</application> Accessibility."
msgstr ""
"O pacote &quot;<application>PyAtSpi2</application>&quot; contém ligações "
"&quot;<application>Python</application>&quot; para os componentes centrais "
"da Acessibilidade do &quot;<application>GNOME</application>&quot;."

