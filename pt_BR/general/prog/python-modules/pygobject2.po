#. type: Content of: <sect2><sect3><title>
#: blfs-en/general/prog/python-modules/pygobject2.xml:97
#, xml-text
msgid "Installation of PyGObject"
msgstr "Instalação do PyGObject"

#. type: Content of: <sect2><sect3><para>
#: blfs-en/general/prog/python-modules/pygobject2.xml:100
#, xml-text
msgid ""
"Install <application>PyGObject</application> by running the following "
"commands:"
msgstr ""
"Instale <application>PyGObject</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect2><sect3><screen>
#: blfs-en/general/prog/python-modules/pygobject2.xml:104
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>./configure --prefix=/usr &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect2><sect3><para>
#: blfs-en/general/prog/python-modules/pygobject2.xml:108
#, xml-text
msgid "This package does not have a working test suite."
msgstr "Esse pacote não tem uma suíte funcional de teste."

#. type: Content of: <sect2><sect3><para>
#: blfs-en/general/prog/python-modules/pygobject2.xml:112
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) &quot;<systemitem "
"class=\"username\">root</systemitem>&quot;:"

#. type: Content of: <sect2><sect3><screen>
#: blfs-en/general/prog/python-modules/pygobject2.xml:115
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

#. type: Content of: <sect2><sect3><title>
#: blfs-en/general/prog/python-modules/pygobject2.xml:119
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect2><sect3><para>
#: blfs-en/general/prog/python-modules/pygobject2.xml:122
#, xml-text
msgid ""
"<option>--disable-introspection</option>: Add this switch if you have "
"installed <xref linkend='glib2'/> without GObject Introspection.  Note that "
"it conflicts with <xref linkend=\"pygobject3\"/>."
msgstr ""
"<option>--disable-introspection</option>: Adicione essa chave se você tiver "
"instalado <xref linkend='glib2'/> sem GObject Introspection. Observe que ela"
" conflita com <xref linkend=\"pygobject3\"/>."

#. type: Content of: <sect2><sect3><para>
#: blfs-en/general/prog/python-modules/pygobject2.xml:128
#, xml-text
msgid ""
"<option>--disable-docs</option>: This option disables the rebuilding of the "
"html documentation if <xref linkend=\"libxslt\"/> is installed."
msgstr ""
"<option>--disable-docs</option>: Essa opção desabilita a reconstrução da "
"documentação &quot;HTML&quot; se &quot;<xref linkend=\"libxslt\"/>&quot; "
"estiver instalado."

