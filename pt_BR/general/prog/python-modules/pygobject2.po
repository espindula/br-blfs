#. type: Content of: <sect2><sect3><para>
#: blfs-en/general/prog/python-modules/pygobject2.xml:29
#, xml-text
msgid ""
"PyGObject-&pygobject2-version; provides <application>Python 2</application> "
"bindings to the GObject class from <application>GLib</application>."
msgstr ""
"&quot;PyGObject-&pygobject2-version;&quot; fornece ligações "
"&quot;<application>Python 2</application>&quot; para a classe "
"&quot;GObject&quot; originária da "
"&quot;<application>GLib</application>&quot;."

