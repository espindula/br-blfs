#. type: Content of: <sect2><sect3><title>
#: blfs-en/general/prog/python-modules/pytest.xml:24
#, xml-text
msgid "Introduction to Pytest Module"
msgstr "Introdução ao Módulo Pytest"

#. type: Content of: <sect2><sect3><para>
#: blfs-en/general/prog/python-modules/pytest.xml:27
#, xml-text
msgid ""
"The <application>Pytest</application> framework makes it easy to write "
"small, readable tests, and can scale to support complex functional testing "
"for applications and libraries."
msgstr ""
"A estrutura &quot;<application>Pytest</application>&quot; facilita escrever "
"testes pequenos e legíveis e pode escalar para suportar testagem complexa "
"funcional para aplicativos e bibliotecas."

