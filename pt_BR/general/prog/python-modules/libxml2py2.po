#. type: Content of: <sect2><sect3><title>
#: blfs-en/general/prog/python-modules/libxml2py2.xml:89
msgid "Installation of libxml2 Python2 module"
msgstr "Instalação do módulo <quote>Python2</quote> <quote>libxml2</quote>"

#. type: Content of: <sect2><sect3><para>
#: blfs-en/general/prog/python-modules/libxml2py2.xml:94
msgid "To build the <application>Python 2</application> module, run:"
msgstr ""
"Para construir o módulo &quot;<application>Python 2</application>&quot;, "
"execute:"

#. type: Content of: <sect2><sect3><screen>
#: blfs-en/general/prog/python-modules/libxml2py2.xml:97
#, no-wrap
msgid ""
"<userinput>./configure PYTHON=python2 &amp;&amp;\n"
"cd python                  &amp;&amp;\n"
"python2 setup.py build</userinput>"
msgstr ""
"<userinput>./configure PYTHON=python2 &amp;&amp;\n"
"cd python                 &amp;&amp;\n"
"python2 setup.py build</userinput>"

#. type: Content of: <sect2><sect3><para>
#: blfs-en/general/prog/python-modules/libxml2py2.xml:102
msgid ""
"To install the <application>Python 2</application> module, as the "
"<systemitem class=\"username\">root</systemitem> user run:"
msgstr ""
"Para instalar o módulo &quot;<application>Python 2</application>&quot;, como "
"o(a) usuário(a) &quot;<systemitem class=\"username\">root</"
"systemitem>&quot;, execute:"

#. type: Content of: <sect2><sect3><screen>
#: blfs-en/general/prog/python-modules/libxml2py2.xml:107
#, no-wrap
msgid "<userinput>python2 setup.py install --optimize=1</userinput>"
msgstr "<userinput>python2 setup.py install --optimize=1</userinput>"

