#. type: Content of: <sect2><sect3><title>
#: blfs-en/general/prog/python-modules/pycairo2.xml:86
#, xml-text
msgid "Installation of PyCairo"
msgstr "Instalação do PyCairo"

#. type: Content of: <sect2><sect3><note><para>
#: blfs-en/general/prog/python-modules/pycairo2.xml:90
#, xml-text
msgid ""
"This version of PyCairo is only retained for packages such as <xref "
"linkend=\"gimp\"/> which is stuck on Python2 until Gimp-3 is released."
msgstr ""
"Essa versão do &quot;PyCairo&quot; é mantida somente para pacotes, como "
"&quot;<xref linkend=\"gimp\"/>&quot;, que ficam presos ao "
"&quot;Python2&quot; até que o &quot;Gimp-3&quot; seja lançado."

#. type: Content of: <sect2><sect3><para>
#: blfs-en/general/prog/python-modules/pycairo2.xml:96
#, xml-text
msgid ""
"Install <application>PyCairo</application> for Python2 by running the "
"following commands:"
msgstr ""
"Instale &quot;<application>PyCairo</application>&quot; para "
"&quot;Python2&quot; executando os seguintes comandos:"

#. type: Content of: <sect2><sect3><screen>
#: blfs-en/general/prog/python-modules/pycairo2.xml:100
#, no-wrap, xml-text
msgid "<userinput>python2 setup.py build</userinput>"
msgstr "<userinput>python2 setup.py build</userinput>"

#. type: Content of: <sect2><sect3><para>
#: blfs-en/general/prog/python-modules/pycairo2.xml:103
#, xml-text
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect2><sect3><para>
#: blfs-en/general/prog/python-modules/pycairo2.xml:107
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) &quot;<systemitem "
"class=\"username\">root</systemitem>&quot;:"

#. type: Content of: <sect2><sect3><screen>
#: blfs-en/general/prog/python-modules/pycairo2.xml:110
#, no-wrap, xml-text
msgid ""
"<userinput>python2 setup.py install --optimize=1   &amp;&amp;\n"
"python2 setup.py install_pycairo_header &amp;&amp;\n"
"python2 setup.py install_pkgconfig</userinput>"
msgstr ""
"<userinput>python2 setup.py install --optimize=1  &amp;&amp;\n"
"python2 setup.py install_pycairo_header &amp;&amp;\n"
"python2 setup.py install_pkgconfig</userinput>"

