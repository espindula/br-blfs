#.  no && because of a possible error
#. type: Content of: <sect2><sect3><screen>
#: blfs-en/general/prog/python-modules/sphinx.xml:119
#, no-wrap, xml-text
#| msgid ""
#| "<userinput>python3 -m venv --system-site-packages testenv &amp;&amp;\n"
#| "source testenv/bin/activate                    &amp;&amp;\n"
#| "pip3 install html5lib filelock                 &amp;&amp;\n"
#| "python3 -m pytest\n"
#| "deactivate</userinput>"
msgid ""
"<userinput>python3 -m venv --system-site-packages testenv &amp;&amp;\n"
"source testenv/bin/activate                    &amp;&amp;\n"
"pip3 install filelock defusedxml               &amp;&amp;\n"
"python3 -m pytest\n"
"deactivate</userinput>"
msgstr ""
"<userinput>python3 -m venv --system-site-packages testenv &amp;&amp;\n"
"source testenv/bin/activate                    &amp;&amp;\n"
"pip3 install filelock defusedxml               &amp;&amp;\n"
"python3 -m pytest\n"
"deactivate</userinput>"

