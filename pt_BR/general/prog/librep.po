#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/prog/librep.xml:26
msgid "Introduction to Librep"
msgstr "Introdução ao \"Librep\""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/prog/librep.xml:29
msgid ""
"The <application>librep</application> package contains a Lisp system.  This "
"is useful for scripting or for applications that may use the Lisp "
"interpreter as an extension language."
msgstr ""
"O pacote <application>librep</application> contém um sistema \"Lisp\". Isso "
"é útil para scripts ou para aplicativos que possivelmente usem o "
"interpretador \"Lisp\" como linguagem de extensão."

