#: blfs-en/general/prog/slang.xml:76
#, xml-text
msgid "Installation of Slang"
msgstr "Instalação do Slang"

#. type: Content of: <sect1><sect2><note><para>
#: blfs-en/general/prog/slang.xml:80
#, xml-text
msgid "This package does not support parallel build."
msgstr "Esse pacote não suporta construção paralela."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/prog/slang.xml:85
#, xml-text
msgid ""
"Install <application>slang</application> by running the following commands:"
msgstr ""
"Instale &quot;<application>slang</application>&quot; executando os seguintes"
" comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/prog/slang.xml:89
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr \\\n"
"            --sysconfdir=/etc \\\n"
"            --with-readline=gnu &amp;&amp;\n"
"make -j1 RPATH=</userinput>"
msgstr ""
"<userinput>./configure --prefix=/usr \\\n"
"            --sysconfdir=/etc \\\n"
"            --with-readline=gnu &amp;&amp;\n"
"make -j1 RPATH=</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/prog/slang.xml:95
#, xml-text
msgid "To test the results, issue: <command>LC_ALL=C make check</command>."
msgstr ""
"Para testar os resultados, emita: <command>LC_ALL=C make check</command>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/prog/slang.xml:99
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) &quot;<systemitem "
"class=\"username\">root</systemitem>&quot;:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/prog/slang.xml:102
#, no-wrap, xml-text
msgid ""
"<userinput>make install_doc_dir=/usr/share/doc/slang-&slang-version;   \\\n"
"     SLSH_DOC_DIR=/usr/share/doc/slang-&slang-version;/slsh \\\n"
"     RPATH= install</userinput>"
msgstr ""
"<userinput>make install_doc_dir=/usr/share/doc/slang-&slang-version;   \\\n"
"     SLSH_DOC_DIR=/usr/share/doc/slang-&slang-version;/slsh \\\n"
"     RPATH= install</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/prog/slang.xml:108
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/prog/slang.xml:111
#, xml-text
msgid ""
"<parameter>--with-readline=gnu</parameter>: This parameter sets GNU "
"<application>Readline</application> to be used by the parser interface "
"instead of the <application>slang</application> internal version."
msgstr ""
"<parameter>--with-readline=gnu</parameter>: Esse parâmetro configura o "
"&quot;<application>Readline</application>&quot; do &quot;GNU&quot; para ser "
"usado pela interface do analisador em vez da versão interna do "
"&quot;<application>slang</application>&quot;."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/prog/slang.xml:117
#, xml-text
msgid ""
"<parameter>RPATH=</parameter>: This overridden <command>make</command> "
"variable prevents hard coding library search paths (rpath) into the binary "
"executable files and shared libraries.  This package does not need rpath for"
" an installation into the standard location, and rpath may sometimes cause "
"unwanted effects or even security issues."
msgstr ""
"<parameter>RPATH=</parameter>: Essa variável substituída do "
"<command>make</command> impede codificar rigidamente caminhos de pesquisa de"
" biblioteca (rpath) nos arquivos executáveis binários e nas bibliotecas "
"compartilhadas. Esse pacote não precisa do rpath para uma instalação no "
"local padrão, e o rpath às vezes pode causar efeitos indesejados ou até "
"mesmo problemas de segurança."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/prog/slang.xml:125
#, xml-text
msgid ""
"<parameter>install_doc_dir=/usr/share/doc/slang-&slang-version; "
"SLSH_DOC_DIR=/usr/share/doc/slang-&slang-version;/slsh</parameter>: These "
"overridden <command>make</command> variables ensure installing this package "
"with a versioned documentation installation directory."
msgstr ""
"<parameter>install_doc_dir=/usr/share/doc/slang-&slang-version; "
"SLSH_DOC_DIR=/usr/share/doc/slang-&slang-version;/slsh</parameter>: Essas "
"variáveis substituídas do <command>make</command> garantem instalar esse "
"pacote com um diretório versionado de instalação da documentação."

