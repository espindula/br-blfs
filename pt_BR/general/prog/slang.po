#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/prog/slang.xml:26
#, xml-text
msgid "Introduction to slang"
msgstr "Introdução ao slang"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/prog/slang.xml:29
#, xml-text
msgid ""
"<application>S-Lang</application> (slang) is an interpreted language that "
"may be embedded into an application to make the application extensible.  It "
"provides facilities required by interactive applications such as "
"display/screen management, keyboard input and keymaps."
msgstr ""
"&quot;<application>S-Lang</application>&quot; (&quot;slang&quot;) é uma "
"linguagem interpretada que pode ser incorporada em um aplicativo para torná-"
"lo extensível. Ela fornece recursos exigidos por aplicativos interativos, "
"como gerenciamento de exibição/tela, entrada de teclado e mapas de teclado."

