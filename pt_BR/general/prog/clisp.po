#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/prog/clisp.xml:95
#, xml-text
msgid "Installation of Clisp"
msgstr "Instalação do \"Clisp\""

#. type: Content of: <sect1><sect2><note><para>
#: blfs-en/general/prog/clisp.xml:99
#, xml-text
msgid "This package does not support parallel build."
msgstr "Esse pacote não suporta construção paralela."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/prog/clisp.xml:104
#, xml-text
msgid ""
"If you are building on a 32-bit system, work around a bug in GCC caused by "
"the latest version of binutils:"
msgstr ""
"Se você estiver construindo em um sistema de 32 bits, [então] contorne um "
"defeito no \"GCC\" causado pela versão mais recente do \"binutils\":"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/prog/clisp.xml:108
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"pre\">case $(uname -m) in\n"
"    i?86) export CFLAGS=\"${CFLAGS:--O2 -g} -falign-functions=4\" ;;\n"
"esac</userinput>"
msgstr ""
"<userinput remap=\"pre\">case $(uname -m) in\n"
"   i?86) export CFLAGS=\"${CFLAGS:--O2 -g} -falign-functions=4\" ;;\n"
"esac</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/prog/clisp.xml:113
#, xml-text
msgid "Remove two tests which fail for unknown reasons:"
msgstr "Remova dois testes que falham por motivos desconhecidos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/prog/clisp.xml:116
#, no-wrap, xml-text
msgid ""
"<userinput>sed -i -e '/socket/d' -e '/\"streams\"/d' "
"tests/tests.lisp</userinput>"
msgstr ""
"<userinput>sed -i -e '/socket/d' -e '/\"streams\"/d' "
"tests/tests.lisp</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/prog/clisp.xml:119 blfs-en/general/prog/clisp.xml:132
#, xml-text
msgid ""
"Install <application>Clisp</application> by running the following commands:"
msgstr ""
"Instale <application>Clisp</application> executando os seguintes comandos:"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/prog/clisp.xml:124
#, xml-text
msgid ""
"If you are building <application>clisp</application> against "
"<application>libffcall</application>, apply the patch to fix a build failure"
" with current <application>readline</application>:"
msgstr ""
"Se você estiver construindo <application>clisp</application> contra a "
"<application>libffcall</application>, [então] aplique o remendo para "
"corrigir uma falha de construção com a <application>readline</application> "
"atual:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/prog/clisp.xml:129
#, no-wrap, xml-text
msgid ""
"<userinput>patch -Np1 -i ../clisp-&clisp-"
"version;-readline7_fixes-1.patch</userinput>"
msgstr ""
"<userinput>patch -Np1 -i ../clisp-&clisp-"
"version;-readline7_fixes-1.patch</userinput>"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/prog/clisp.xml:136
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"../configure --srcdir=../                       \\\n"
"             --prefix=/usr                      \\\n"
"             --docdir=/usr/share/doc/clisp-&clisp-version; \\\n"
"             --with-libsigsegv-prefix=/usr &amp;&amp;\n"
"\n"
"ulimit -S -s 16384 &amp;&amp;\n"
"make -j1</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"../configure --srcdir=../                       \\\n"
"             --prefix=/usr                      \\\n"
"             --docdir=/usr/share/doc/clisp-&clisp-version; \\\n"
"             --with-libsigsegv-prefix=/usr &amp;&amp;\n"
"\n"
"ulimit -S -s 16384 &amp;&amp;\n"
"make -j1</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/prog/clisp.xml:148
#, xml-text
msgid "To test the results, issue: <command>make check</command>."
msgstr "Para testar os resultados, emita: <command>make check</command>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/prog/clisp.xml:152
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/prog/clisp.xml:155
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/prog/clisp.xml:159
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/prog/clisp.xml:162
#, xml-text
msgid ""
"<command>ulimit -s 16384</command>: this increases the maximum stack size, "
"as recommended by the <command>configure</command>."
msgstr ""
"<command>ulimit -s 16384</command>: isso aumenta o tamanho máximo da pilha, "
"conforme recomendado pelo <command>configure</command>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/prog/clisp.xml:167
#, xml-text
msgid ""
"<parameter>--docdir=/usr/share/doc/clisp-&clisp-version;</parameter>: this "
"switch forces the HTML documentation to be installed into a versioned "
"directory, rather than into <filename "
"class=\"directory\">/usr/share/html/</filename>."
msgstr ""
"<parameter>--docdir=/usr/share/doc/clisp-&clisp-version;</parameter>: essa "
"chave força a documentação HTML ser instalada em um diretório versionado em "
"vez de no <filename class=\"directory\">/usr/share/html/</filename>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/prog/clisp.xml:174
#, xml-text
msgid ""
"<parameter>--with-libsigsegv-prefix=/usr</parameter>: use this to tell "
"<command>configure</command> that you have installed "
"<package>libsigsegv</package> in /usr, otherwise it will not be found."
msgstr ""
"<parameter>--with-libsigsegv-prefix=/usr</parameter>: use isso para informar"
" ao <command>configure</command> que você instalou o "
"<package>libsigsegv</package> em /usr, caso contrário ele não será "
"encontrado."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/prog/clisp.xml:181
#, xml-text
msgid ""
"<option>--with-libffcall-prefix=/usr</option>: use this to tell "
"<command>configure</command> that you have installed the optional "
"<package>libffcall</package> package in /usr, otherwise like "
"<package>libsigsegv</package> it will not be found."
msgstr ""
"<option>--with-libffcall-prefix=/usr</option>: use isso para informar ao "
"<command>configure</command> que você instalou o pacote opcional "
"<package>libffcall</package> em /usr, caso contrário, como "
"<package>libsigsegv</package>, ele não será encontrado."

