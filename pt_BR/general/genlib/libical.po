#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/genlib/libical.xml:97
#, xml-text
msgid "Installation of libical"
msgstr "Instalação do libical"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libical.xml:108
#, xml-text
msgid ""
"Install <application>libical</application> by running the following "
"commands:"
msgstr ""
"Instale <application>libical</application> executando os seguintes comandos:"

#.  Needs confirmation, but I got a race condition at -j8,
#.   -j1 allowed the build to pass. Pierre 2019-12-06
#.   I always have it actually. Hence the entity.
#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genlib/libical.xml:116
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -DCMAKE_INSTALL_PREFIX=/usr  \\\n"
"      -DCMAKE_BUILD_TYPE=Release   \\\n"
"      -DSHARED_ONLY=yes            \\\n"
"      -DICAL_BUILD_DOCS=false      \\\n"
"      -DGOBJECT_INTROSPECTION=true \\\n"
"      -DICAL_GLIB_VAPI=true        \\\n"
"      .. &amp;&amp;\n"
"make -j1</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd  build &amp;&amp;\n"
"\n"
"cmake -DCMAKE_INSTALL_PREFIX=/usr  \\\n"
"      -DCMAKE_BUILD_TYPE=Release   \\\n"
"      -DSHARED_ONLY=yes            \\\n"
"      -DICAL_BUILD_DOCS=false      \\\n"
"      -DGOBJECT_INTROSPECTION=true \\\n"
"      -DICAL_GLIB_VAPI=true        \\\n"
"      .. &amp;&amp;\n"
"make -j1</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libical.xml:129
#, xml-text
msgid ""
"If you have <xref linkend=\"doxygen\"/>, <xref linkend=\"graphviz\"/>, and "
"<xref linkend=\"gtk-doc\"/> installed and wish to build the API "
"documentation, you should remove the "
"<parameter>-DICAL_BUILD_DOCS=false</parameter> switch and issue:"
msgstr ""
"Se tiver <xref linkend=\"doxygen\"/>, <xref linkend=\"graphviz\"/> e <xref "
"linkend=\"gtk-doc\"/> instalados e desejar construir a documentação da API, "
"[então] você deveria remover a chave "
"<parameter>-DICAL_BUILD_DOCS=false</parameter> e emitir:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genlib/libical.xml:136
#, no-wrap, xml-text
msgid "<userinput>make docs</userinput>"
msgstr "<userinput>make docs</userinput>"

#.  One test, timezones, is known to fail on SysV systems.
#.  On systemd, we symlink the current timezone to
#.            /etc/localtime, which is what libical expects.
#.            This is now done on SysV as well.
#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libical.xml:139
#, xml-text
msgid "To test the results, issue: <command>make test</command>."
msgstr "Para testar os resultados, emita: <command>make test</command>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libical.xml:147
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genlib/libical.xml:150
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libical.xml:153
#, xml-text
msgid ""
"If you have built the API documentation, install by issuing, as <systemitem "
"class=\"username\">root</systemitem> user:"
msgstr ""
"Se você tiver construído a documentação da API, [então] instale emitindo, "
"como usuário(a) <systemitem class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genlib/libical.xml:158
#, no-wrap, xml-text
msgid ""
"<userinput>install -vdm755 /usr/share/doc/libical-&libical-version;/html &amp;&amp;\n"
"cp -vr apidocs/html/* /usr/share/doc/libical-&libical-version;/html</userinput>"
msgstr ""
"<userinput>install -vdm755 /usr/share/doc/libical-&libical-version;/html &amp;&amp;\n"
"cp -vr apidocs/html/* /usr/share/doc/libical-&libical-version;/html</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/genlib/libical.xml:164
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libical.xml:167
#, xml-text
msgid ""
"<parameter>-DCMAKE_BUILD_TYPE=Release</parameter>: This switch is used to "
"apply higher level of the compiler optimizations."
msgstr ""
"<parameter>-DCMAKE_BUILD_TYPE=Release</parameter>: Essa chave é usada para "
"aplicar nível mais alto das otimizações de compilador."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libical.xml:172
#, xml-text
msgid ""
"<parameter>-DSHARED_ONLY=yes</parameter>: This switch is used in order to "
"only build the shared libraries."
msgstr ""
"<parameter>-DSHARED_ONLY=yes</parameter>: Essa chave é usada para a "
"finalidade de construir somente as bibliotecas compartilhadas."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libical.xml:177
#, xml-text
msgid ""
"<parameter>-DICAL_BUILD_DOCS=false</parameter>: This switch prevents "
"building the <application>GTK</application> documentation. Remove if you "
"want to build the documentation."
msgstr ""
"<parameter>-DICAL_BUILD_DOCS=false</parameter>: Essa chave evita construir a"
" documentação do <application>GTK</application>. Remova se você desejar "
"construir a documentação."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libical.xml:183
#, xml-text
msgid ""
"<parameter>-DGOBJECT_INTROSPECTION=true</parameter>: This switch is used to "
"generate GObject metadata bindings."
msgstr ""
"<parameter>-DGOBJECT_INTROSPECTION=true</parameter>: Essa chave é usada para"
" gerar ligações de meta dados do \"GObject\"."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libical.xml:188
#, xml-text
msgid ""
"<parameter>-DICAL_GLIB_VAPI=true</parameter>: This switch is used in order "
"to build bindings for <xref linkend=\"vala\"/>."
msgstr ""
"<parameter>-DICAL_GLIB_VAPI=true</parameter>: Essa chave é usada para a "
"finalidade de construir ligações para <xref linkend=\"vala\"/>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libical.xml:193
#, xml-text
msgid ""
"<option>-DUSE_BUILTIN_TZDATA=yes</option>: This switch is used in order to "
"build using your own timezone data."
msgstr ""
"<option>-DUSE_BUILTIN_TZDATA=yes</option>: Essa chave é usada para a "
"finalidade de construir usando seus próprios dados de fuso horário."

