#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/genlib/enchant.xml:97
#, xml-text
msgid "Installation of enchant"
msgstr "Instalação de enchant"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/enchant.xml:100
#, xml-text
msgid ""
"Install <application>enchant</application> by running the following "
"commands:"
msgstr ""
"Instale <application>enchant</application> executando os seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genlib/enchant.xml:104
#, no-wrap, xml-text
#| msgid ""
#| "<userinput>./configure --prefix=/usr    \\\n"
#| "            --disable-static \\\n"
#| "            --docdir /usr/share/doc/enchant-&enchant-version; &amp;&amp;\n"
#| "make</userinput>"
msgid ""
"<userinput>./configure --prefix=/usr    \\\n"
"            --disable-static \\\n"
"            --docdir=/usr/share/doc/enchant-&enchant-version; &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>./configure --prefix=/usr    \\\n"
"            --disable-static \\\n"
"            --docdir=/usr/share/doc/enchant-&enchant-version; &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/enchant.xml:110
#, xml-text
msgid ""
"To run tests, unittest-cpp must be installed and the <option>--enable-"
"relocatable</option> option passed to configure above.  If these conditions "
"are present, the tests may be run with <command>make check</command>."
msgstr ""
"Para executar os testes, unittest-cpp precisa ser instalado e a opção "
"<option>--enable-relocatable</option> passada para o \"configure\" acima. Se"
" essas condições estiverem presentes, [então] os testes podem ser executados"
" com <command>make check</command>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/enchant.xml:117
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genlib/enchant.xml:120
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

