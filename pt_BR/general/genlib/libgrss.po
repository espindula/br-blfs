#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/genlib/libgrss.xml:94
#, xml-text
msgid "Installation of libgrss"
msgstr "Instalação do libgrss"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libgrss.xml:97
#, xml-text
msgid ""
"Install <application>libgrss</application> by running the following "
"commands:"
msgstr ""
"Instale <application>libgrss</application> executando os seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genlib/libgrss.xml:102
#, no-wrap, xml-text
msgid ""
"<userinput>patch -Np1 -i ../libgrss-&libgrss-version;-bugfixes-2.patch &amp;&amp;\n"
"autoreconf -fv &amp;&amp;\n"
"./configure --prefix=/usr --disable-static &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>patch -Np1 -i ../libgrss-&libgrss-version;-bugfixes-2.patch &amp;&amp;\n"
"autoreconf -fv &amp;&amp;\n"
"./configure --prefix=/usr --disable-static &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libgrss.xml:108
#, xml-text
msgid "To test the results, issue: <command>make check</command>."
msgstr "Para testar os resultados, emita: <command>make check</command>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libgrss.xml:112
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genlib/libgrss.xml:115
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

