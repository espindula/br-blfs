#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/genlib/libxkbcommon.xml:92
#, xml-text
msgid "Installation of libxkbcommon"
msgstr "Instalação do libxkbcommon"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libxkbcommon.xml:95
#, xml-text
msgid ""
"Install <application>libxkbcommon</application> by running the following "
"commands:"
msgstr ""
"Instale <application>libxkbcommon</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genlib/libxkbcommon.xml:99
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup ..            \\\n"
"      --prefix=/usr       \\\n"
"      --buildtype=release \\\n"
"      -Denable-docs=false &amp;&amp;\n"
"ninja</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup ..            \\\n"
"      --prefix=/usr       \\\n"
"      --buildtype=release \\\n"
"      -Denable-docs=false &amp;&amp;\n"
"ninja</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libxkbcommon.xml:109
#, xml-text
msgid "To test the results, issue: <command>ninja test</command>."
msgstr "Para testar os resultados, emita: <command>ninja test</command>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libxkbcommon.xml:113
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genlib/libxkbcommon.xml:116
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr "<userinput>ninja install</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/genlib/libxkbcommon.xml:121
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libxkbcommon.xml:139
#, xml-text
msgid ""
"<parameter>-Denable-docs=false</parameter>: This switch disables "
"documentation generation. Remove it if <xref linkend=\"doxygen\"/> is "
"installed."
msgstr ""
"<parameter>-Denable-docs=false</parameter>: Essa chave desabilita a geração "
"de documentação. Remova-a se <xref linkend=\"doxygen\"/> estiver instalado."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libxkbcommon.xml:145
#, xml-text
msgid ""
"<command>mv -v /usr/share/doc/libxkbcommon{,-&libxkbcommon-"
"version;}</command>: If you removed -Denable-docs=false, use this command to"
" install the documentation in a versioned directory."
msgstr ""
"<command>mv -v /usr/share/doc/libxkbcommon{,-&libxkbcommon-"
"version;}</command>: se você removeu \"-Denable-docs=false\", [então] use "
"esse comando para instalar a documentação em um diretório versionado."

