#, xml-text
msgid "Installation of kirigami-addons"
msgstr "Instalação de kirigami-addons"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/kirigami-addons.xml:85
#, xml-text
msgid ""
"Install <application>kirigami-addons</application> by running the following "
"commands:"
msgstr ""
"Instale <application>kirigami-addons</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genlib/kirigami-addons.xml:89
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE__INSTALL_PREFIX=$KF6_PREFIX \\\n"
"      -D CMAKE_BUILD_TYPE=Release          \\\n"
"      -D BUILD_TESTING=OFF                 \\\n"
"       ..                                  &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE__INSTALL_PREFIX=$KF6_PREFIX \\\n"
"      -D CMAKE_BUILD_TYPE=Release          \\\n"
"      -D BUILD_TESTING=OFF                 \\\n"
"       ..                                  &amp;&amp;\n"
"make</userinput>"

