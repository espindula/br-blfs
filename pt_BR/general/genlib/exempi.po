#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/genlib/exempi.xml:84
#, xml-text
msgid "Installation of Exempi"
msgstr "Instalação de Exempi"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/exempi.xml:87
#, xml-text
msgid ""
"If you intend to run the regression tests, first remove a test that depends "
"on an apparently proprietary Adobe SDK:"
msgstr ""
"Se você pretende executar os testes de regressão, [então] primeiro remova um"
" teste que depende de um SDK da Adobe aparentemente proprietário:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genlib/exempi.xml:91
#, no-wrap, xml-text
msgid ""
"<userinput>sed -i -r '/^\\s?testadobesdk/d' exempi/Makefile.am &amp;&amp;\n"
"autoreconf -fiv</userinput>"
msgstr ""
"<userinput>sed -i -r '/^\\s?testadobesdk/d' exempi/Makefile.am &amp;&amp;\n"
"autoreconf -fiv</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/exempi.xml:96
#, xml-text
msgid ""
"Install <application>Exempi</application> by running the following commands:"
msgstr ""
"Instale <application>Exempi</application> executando os seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genlib/exempi.xml:100
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr --disable-static &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>./configure --prefix=/usr --disable-static &amp;&amp;\n"
"make</userinput>"

#.       If valgrind is installed, mosts tests will indicate a failure, but
#.       that is a test problem and not a package problem.
#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/exempi.xml:104
#, xml-text
msgid "To test the results, issue: <command>make check</command>."
msgstr "Para testar os resultados, emita: <command>make check</command>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/exempi.xml:110
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genlib/exempi.xml:113
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

