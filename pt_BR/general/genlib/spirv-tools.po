#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/spirv-tools.xml:91
#, xml-text
msgid ""
"Install <application>SPIRV-Tools</application> by running the following "
"commands:"
msgstr ""
"Instale <application>SPIRV-Tools</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genlib/spirv-tools.xml:95
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -DCMAKE_INSTALL_PREFIX=/usr     \\\n"
"      -DCMAKE_BUILD_TYPE=Release      \\\n"
"      -DSPIRV_WERROR=OFF              \\\n"
"      -DBUILD_SHARED_LIBS=ON          \\\n"
"      -DSPIRV_TOOLS_BUILD_STATIC=OFF  \\\n"
"      -DSPIRV-Headers_SOURCE_DIR=/usr \\\n"
"      -G Ninja .. &amp;&amp;\n"
"ninja</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -DCMAKE_INSTALL_PREFIX=/usr     \\\n"
"      -DCMAKE_BUILD_TYPE=Release      \\\n"
"      -DSPIRV_WERROR=OFF              \\\n"
"      -DBUILD_SHARED_LIBS=ON          \\\n"
"      -DSPIRV_TOOLS_BUILD_STATIC=OFF  \\\n"
"      -DSPIRV-Headers_SOURCE_DIR=/usr \\\n"
"      -G Ninja .. &amp;&amp;\n"
"ninja</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/spirv-tools.xml:108
#, xml-text
msgid "To test the results, issue: <command>ninja test</command>."
msgstr "Para testar os resultados, emita: <command>ninja test</command>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/spirv-tools.xml:112
#, xml-text
msgid "Now, as the &root; user:"
msgstr "Agora, como o(a) usuário(a) &root;:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genlib/spirv-tools.xml:115
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr "<userinput>ninja install</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/genlib/spirv-tools.xml:120
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/spirv-tools.xml:123
#, xml-text
msgid ""
"<parameter>-DSPIRV_WERROR=OFF</parameter>: This switch stops the build "
"system from treating warnings as errors."
msgstr ""
"<parameter>-DSPIRV_WERROR=OFF</parameter>: Essa chave impede que o sistema "
"de construção trate avisos como erros."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/spirv-tools.xml:128
#, xml-text
msgid ""
"<parameter>-DBUILD_SHARED_LIBS=ON</parameter>: This switch forces the build "
"system to install shared libraries instead of static libraries."
msgstr ""
"<parameter>-DBUILD_SHARED_LIBS=ON</parameter>: Essa chave força o sistema de"
" construção a instalar bibliotecas compartilhadas em vez de bibliotecas "
"estáticas."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/spirv-tools.xml:133
#, xml-text
msgid ""
"<parameter>-DSPIRV_TOOLS_BUILD_STATIC=OFF</parameter>: This switch disables "
"building static versions of the libraries."
msgstr ""
"<parameter>-DSPIRV_TOOLS_BUILD_STATIC=OFF</parameter>: Essa chave desabilita"
" construir versões estáticas das bibliotecas."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/spirv-tools.xml:138
#, xml-text
msgid ""
"<parameter>-DSPIRV-Headers_SOURCE_DIR</parameter>: This switch tells the "
"build system that <xref linkend=\"spirv-headers\" role=\"nodep\"/> is "
"installed in /usr. This is needed since the build system tries to use an "
"internal copy by default."
msgstr ""
"<parameter>-DSPIRV-Headers_SOURCE_DIR</parameter>: Essa chave informa ao "
"sistema de construção que <xref linkend=\"spirv-headers\" role=\"nodep\"/> "
"está instalado em /usr. Isso é necessário porque o sistema de construção "
"tenta usar uma cópia interna por padrão."

