#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libssh2.xml:29
#, xml-text
msgid ""
"<application>Libssh2</application> package is a client-side C library "
"implementing the SSH2 protocol."
msgstr ""
"O pacote <application>Libssh2</application> é uma biblioteca C do lado do "
"cliente que implementa o protocolo \"SSH2\"."

