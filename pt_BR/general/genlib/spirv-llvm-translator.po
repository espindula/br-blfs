#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/genlib/spirv-llvm-translator.xml:75
#, xml-text
msgid "Installation of SPIRV-LLVM-Translator"
msgstr "Instalação de SPIRV-LLVM-Translator"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/spirv-llvm-translator.xml:78
#, xml-text
msgid ""
"Install <application>SPIRV-LLVM-Translator</application> by running the "
"following commands:"
msgstr ""
"Instale <application>SPIRV-LLVM-Translator</application> executando os "
"seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genlib/spirv-llvm-translator.xml:82
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr                   \\\n"
"      -D CMAKE_BUILD_TYPE=Release                    \\\n"
"      -D BUILD_SHARED_LIBS=ON                        \\\n"
"      -D CMAKE_SKIP_INSTALL_RPATH=ON                 \\\n"
"      -D LLVM_EXTERNAL_SPIRV_HEADERS_SOURCE_DIR=/usr \\\n"
"      -G Ninja ..                                    &amp;&amp;\n"
"ninja</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr                   \\\n"
"      -D CMAKE_BUILD_TYPE=Release                    \\\n"
"      -D BUILD_SHARED_LIBS=ON                        \\\n"
"      -D CMAKE_SKIP_INSTALL_RPATH=ON                 \\\n"
"      -D LLVM_EXTERNAL_SPIRV_HEADERS_SOURCE_DIR=/usr \\\n"
"      -G Ninja ..                                    &amp;&amp;\n"
"ninja</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/spirv-llvm-translator.xml:96
#, xml-text
