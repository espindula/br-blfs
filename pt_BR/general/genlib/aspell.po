#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/genlib/aspell.xml:98
#, xml-text
msgid "Installation of Aspell"
msgstr "Instalação do Aspell"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/aspell.xml:101
#, xml-text
msgid ""
"Install <application>Aspell</application> by running the following commands:"
msgstr ""
"Instale <application>Aspell</application> executando os seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genlib/aspell.xml:105
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>./configure --prefix=/usr &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/aspell.xml:109
#, xml-text
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/general/genlib/aspell.xml:113 blfs-en/general/genlib/aspell.xml:171
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genlib/aspell.xml:116
#, no-wrap, xml-text
msgid ""
"<userinput>make install &amp;&amp;\n"
"ln -svfn aspell-0.60 /usr/lib/aspell &amp;&amp;\n"
"\n"
"install -v -m755 -d /usr/share/doc/aspell-&aspell-version;/aspell{,-dev}.html &amp;&amp;\n"
"\n"
"install -v -m644 manual/aspell.html/* \\\n"
"    /usr/share/doc/aspell-&aspell-version;/aspell.html &amp;&amp;\n"
"\n"
"install -v -m644 manual/aspell-dev.html/* \\\n"
"    /usr/share/doc/aspell-&aspell-version;/aspell-dev.html</userinput>"
msgstr ""
"<userinput>make install &amp;&amp;\n"
"ln -svfn aspell-0.60 /usr/lib/aspell &amp;&amp;\n"
"\n"
"install -v -m755 -d /usr/share/doc/aspell-&aspell-version;/aspell{,-dev}.html &amp;&amp;\n"
"\n"
"install -v -m644 manual/aspell.html/* \\\n"
"    /usr/share/doc/aspell-&aspell-version;/aspell.html &amp;&amp;\n"
"\n"
"install -v -m644 manual/aspell-dev.html/* \\\n"
"    /usr/share/doc/aspell-&aspell-version;/aspell-dev.html</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/aspell.xml:128
#, xml-text
msgid ""
"If you do not plan to install <application>Ispell</application>, then copy "
"the wrapper script <command>ispell</command>:"
msgstr ""
"Se você não planeja instalar <application>Ispell</application>, então copie "
"o script amarrador <command>ispell</command>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genlib/aspell.xml:132
#, no-wrap, xml-text
msgid "<userinput>install -v -m 755 scripts/ispell /usr/bin/</userinput>"
msgstr "<userinput>install -v -m 755 scripts/ispell /usr/bin/</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/aspell.xml:135
#, xml-text
msgid ""
"If you do not plan to install <application>Spell</application>, then copy "
"the wrapper script <command>spell</command>:"
msgstr ""
"Se você não planeja instalar <application>Spell</application>, então copie o"
" script amarrador <command>spell</command>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genlib/aspell.xml:139
#, no-wrap, xml-text
msgid "<userinput>install -v -m 755 scripts/spell /usr/bin/</userinput>"
msgstr "<userinput>install -v -m 755 scripts/spell /usr/bin/</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/genlib/aspell.xml:143
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/aspell.xml:146
#, xml-text
msgid ""
"<command>ln -svfn aspell-0.60 /usr/lib/aspell</command>: This command is "
"useful for configuration of other applications, such as <xref "
"linkend=\"enchant\"/>."
msgstr ""
"<command>ln -svfn aspell-0.60 /usr/lib/aspell</command>: Esse comando é útil"
" para configuração de outros aplicativos, como <xref linkend=\"enchant\"/>."

#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/genlib/aspell.xml:153
#, xml-text
msgid "Configuring Aspell"
msgstr "Configurando Aspell"

#. type: Content of: <sect1><sect2><sect3><title>
#: blfs-en/general/genlib/aspell.xml:156
#, xml-text
msgid "Configuration Information"
msgstr "Informação de Configuração"

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/general/genlib/aspell.xml:159
#, xml-text
msgid ""
"After <application>Aspell</application> is installed, you must set up at "
"least one dictionary. Install the English dictionary by running the "
"following commands:"
msgstr ""
"Depois que <application>Aspell</application> estiver instalado, você precisa"
" configurar pelo menos um dicionário. Instale o dicionário do inglês "
"executando os seguintes comandos:"

#. type: Content of: <sect1><sect2><sect3><screen>
#: blfs-en/general/genlib/aspell.xml:164
#, no-wrap, xml-text
msgid ""
"<userinput>tar xf ../&aspell-en-dict;.tar.bz2 &amp;&amp;\n"
"cd &aspell-en-dict;                &amp;&amp;\n"
"\n"
"./configure &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>tar xf ../&aspell-en-dict;.tar.bz2 &amp;&amp;\n"
"cd &aspell-en-dict;                &amp;&amp;\n"
"\n"
"./configure &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><sect3><screen>
#: blfs-en/general/genlib/aspell.xml:174
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/general/genlib/aspell.xml:177
#, xml-text
msgid "Other dictionaries can be installed with the same instructions."
msgstr "Outros dicionários podem ser instalados com as mesmas instruções."

