#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/genlib/libassuan.xml:91
#, xml-text
msgid "Installation of libassuan"
msgstr "Instalação do libassuan"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libassuan.xml:94
#, xml-text
msgid ""
"Install <application>libassuan</application> by running the following "
"commands:"
msgstr ""
"Instale <application>libassuan</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genlib/libassuan.xml:98
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr &amp;&amp;\n"
"make                      &amp;&amp;\n"
"\n"
"make -C doc html                                                       &amp;&amp;\n"
"makeinfo --html --no-split -o doc/assuan_nochunks.html doc/assuan.texi &amp;&amp;\n"
"makeinfo --plaintext       -o doc/assuan.txt           doc/assuan.texi\n"
"</userinput>"
msgstr ""
"<userinput>./configure --prefix=/usr &amp;&amp;\n"
"make                   &amp;&amp;\n"
"\n"
"make -C doc html                                                       &amp;&amp;\n"
"makeinfo --html --no-split -o doc/assuan_nochunks.html doc/assuan.texi &amp;&amp;\n"
"makeinfo --plaintext       -o doc/assuan.txt           doc/assuan.texi\n"
"</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libassuan.xml:107
#, xml-text
msgid ""
"The above commands build the documentation in html and plaintext formats.  "
"If you wish to build alternate formats of the documentation, you must have "
"<xref linkend=\"texlive\"/> installed and issue the following commands:"
msgstr ""
"Os comandos acima constroem a documentação nos formatos html e texto "
"simples. Se você deseja construir formatos alternativos da documentação, "
"[então] você precisa ter <xref linkend=\"texlive\"/> instalado e emitir os "
"seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genlib/libassuan.xml:112
#, no-wrap, xml-text
msgid "<userinput>make -C doc pdf ps</userinput>"
msgstr "<userinput>make -C doc pdf ps</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libassuan.xml:115
#, xml-text
msgid "To test the results, issue: <command>make check</command>."
msgstr "Para testar os resultados, emita: <command>make check</command>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libassuan.xml:119
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genlib/libassuan.xml:122
#, no-wrap, xml-text
msgid ""
"<userinput>make install &amp;&amp;\n"
"\n"
"install -v -dm755   /usr/share/doc/libassuan-&libassuan-version;/html &amp;&amp;\n"
"install -v -m644 doc/assuan.html/* \\\n"
"                    /usr/share/doc/libassuan-&libassuan-version;/html &amp;&amp;\n"
"install -v -m644 doc/assuan_nochunks.html \\\n"
"                    /usr/share/doc/libassuan-&libassuan-version;      &amp;&amp;\n"
"install -v -m644 doc/assuan.{txt,texi} \\\n"
"                    /usr/share/doc/libassuan-&libassuan-version;</userinput>"
msgstr ""
"<userinput>make install &amp;&amp;\n"
"\n"
"install -v -dm755 /usr/share/doc/libassuan-&libassuan-version;/html &amp;&amp;\n"
"install -v -m644 doc/assuan.html/* \\\n"
"                    /usr/share/doc/libassuan-&libassuan-version;/html &amp;&amp;\n"
"install -v -m644 doc/assuan_nochunks.html \\\n"
"                    /usr/share/doc/libassuan-&libassuan-version;      &amp;&amp;\n"
"install -v -m644 doc/assuan.{txt,texi} \\\n"
"                    /usr/share/doc/libassuan-&libassuan-version;</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libassuan.xml:133
#, xml-text
msgid ""
"If you built alternate formats of the documentation, install them by running"
" the following commands as the <systemitem "
"class=\"username\">root</systemitem> user:"
msgstr ""
"Se você construiu formatos alternativos da documentação, [então] instale-os "
"executando os seguintes comandos como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genlib/libassuan.xml:139
#, no-wrap, xml-text
msgid ""
"<userinput>install -v -m644  doc/assuan.{pdf,ps,dvi} \\\n"
"                  /usr/share/doc/libassuan-&libassuan-version;</userinput>"
msgstr ""
"<userinput>install -v -m644 doc/assuan.{pdf,ps,dvi} \\\n"
"                  /usr/share/doc/libassuan-&libassuan-version;</userinput>"

