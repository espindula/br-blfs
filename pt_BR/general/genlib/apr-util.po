#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/genlib/apr-util.xml:98
#, xml-text
msgid "Installation of Apr Util"
msgstr "Instalação da Apr Util"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/apr-util.xml:101
#, xml-text
msgid ""
"Install <application>Apr Util</application> by running the following "
"commands:"
msgstr ""
"Instale a <application>Apr Util</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genlib/apr-util.xml:105
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr       \\\n"
"            --with-apr=/usr     \\\n"
"            --with-gdbm=/usr    \\\n"
"            --with-openssl=/usr \\\n"
"            --with-crypto &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>./configure --prefix=/usr       \\\n"
"            --with-apr=/usr     \\\n"
"            --with-gdbm=/usr    \\\n"
"            --with-openssl=/usr \\\n"
"            --with-crypto &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/apr-util.xml:113
#, xml-text
msgid ""
"To test the results, issue: <command>make -j1 test</command>.  One test, "
"testdbm, is known to fail."
msgstr ""
"Para testar os resultados, emita: <command>make -j1 test</command>. Um "
"teste, \"testdbm\", é conhecido por falhar."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/apr-util.xml:118
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genlib/apr-util.xml:121
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/genlib/apr-util.xml:125
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/apr-util.xml:128
#, xml-text
msgid ""
"<parameter>--with-gdbm=/usr</parameter>: This switch enables the <filename "
"class=\"libraryfile\">apr_dbm_gdbm-1.so</filename> plugin."
msgstr ""
"<parameter>--with-gdbm=/usr</parameter>: Essa chave habilita o plugin "
"<filename class=\"libraryfile\">apr_dbm_gdbm-1.so</filename>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/apr-util.xml:133
#, xml-text
msgid ""
"<parameter>--with-openssl=/usr</parameter> <parameter>--with-"
"crypto</parameter>: These switches enable the <filename "
"class=\"libraryfile\">apr_crypto_openssl-1.so</filename> plugin."
msgstr ""
"<parameter>--with-openssl=/usr</parameter> <parameter>--with-"
"crypto</parameter>: Essas chaves habilitam o plugin <filename class="
"\"libraryfile\">apr_crypto_openssl-1.so</filename>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/apr-util.xml:141
#, xml-text
msgid ""
"<option>--with-berkeley-db=/usr</option>: If you have installed &berkeley-"
"db;, use this switch to compile the <filename "
"class=\"libraryfile\">apr_dbm_db-1.so</filename> plugin."
msgstr ""
"<option>--with-berkeley-db=/usr</option>: Se você tiver instalado &berkeley-"
"db;, use essa chave para compilar o plugin <filename class=\"libraryfile\""
">apr_dbm_db-1.so</filename>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/apr-util.xml:147
#, xml-text
msgid ""
"<option>--with-ldap</option>: If you have installed <xref "
"linkend=\"openldap\"/>, use this switch to compile the <filename "
"class=\"libraryfile\">apr_ldap.so</filename> plugin."
msgstr ""
"<option>--with-ldap</option>: se você tiver instalado <xref "
"linkend=\"openldap\"/>, [então] use essa chave para compilar o plugin "
"<filename class=\"libraryfile\">apr_ldap.so</filename>."

