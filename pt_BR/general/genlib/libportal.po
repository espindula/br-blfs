#: blfs-en/general/genlib/libportal.xml:29
#, xml-text
msgid ""
"The <application>libportal</application> package provides a library that "
"contains GIO-style async APIs for most Flatpak portals."
msgstr ""
"O pacote <application>libportal</application> fornece uma biblioteca que "
"contém APIs assíncronas estilo GIO para a maioria dos portais Flatpak."

