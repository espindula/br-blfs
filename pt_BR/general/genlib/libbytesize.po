#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/genlib/libbytesize.xml:93
#, xml-text
msgid "Installation of libbytesize"
msgstr "Instalação do libbytesize"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libbytesize.xml:96
#, xml-text
msgid ""
"Install <application>libbytesize</application> by running the following "
"commands:"
msgstr ""
"Instale <application>libbytesize</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genlib/libbytesize.xml:100
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>./configure --prefix=/usr &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libbytesize.xml:104
#, xml-text
msgid ""
"If you have the optional python modules installed, the regression tests can "
"be run with: <command>make check</command>."
msgstr ""
"Se você tiver os módulos opcionais Python instalados, [então] os testes de "
"regressão podem ser executados com: <command>make check</command>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libbytesize.xml:109
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genlib/libbytesize.xml:112
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

