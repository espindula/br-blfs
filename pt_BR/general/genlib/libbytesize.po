#: blfs-en/general/genlib/libbytesize.xml:159
#, xml-text
msgid ""
"converts from a larger unit, such as MB or TB, back to a value in bytes"
msgstr ""
"converte de uma unidade maior, como MB ou TB, de volta para um valor em "
"bytes"

