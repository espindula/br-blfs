#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/genlib/appstream.xml:100
#, xml-text
msgid "Installation of AppStream"
msgstr "Instalação do AppStream"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/appstream.xml:103
#, xml-text
msgid ""
"Install <application>AppStream</application> by running the following "
"commands:"
msgstr ""
"Instale <application>AppStream</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genlib/appstream.xml:107
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr       \\\n"
"            --buildtype=release \\\n"
"            -Dapidocs=false     \\\n"
"            -Dstemming=false    .. &amp;&amp;\n"
"ninja</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr       \\\n"
"            --buildtype=release \\\n"
"            -Dapidocs=false     \\\n"
"            -Dstemming=false    .. &amp;&amp;\n"
"ninja</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/appstream.xml:117
#, xml-text
msgid "To test the results, issue: <command>ninja test</command>."
msgstr "Para testar os resultados, emita: <command>ninja test</command>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/appstream.xml:121
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genlib/appstream.xml:124
#, no-wrap, xml-text
msgid ""
"<userinput>ninja install &amp;&amp;\n"
"mv -v /usr/share/doc/appstream{,-&appstream-version;}</userinput>"
msgstr ""
"<userinput>ninja install &amp;&amp;\n"
"mv -v /usr/share/doc/appstream{,-&appstream-version;}</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/genlib/appstream.xml:130
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/appstream.xml:136
#, xml-text
msgid ""
"<parameter>-Dapidocs=false</parameter>: This switch disables building the "
"API documentation. Remove it if you have <xref linkend=\"gi-docgen\" "
"role=\"nodep\"/> installed and wish to regenerate the API documentation.  "
"When the API documentation is not regenerated, a pre-built copy is installed"
" anyway."
msgstr ""
"<parameter>-Dapidocs=false</parameter>: Essa chave desabilita construir a "
"documentação da API. Remova-a se você tiver <xref linkend=\"gi-docgen\" role="
"\"nodep\"/> instalado e desejar regerar a documentação da API. Quando a "
"documentação da API não for regerada, uma cópia pré construída será "
"instalada de qualquer maneira."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/appstream.xml:144
#, xml-text
msgid ""
"<parameter>-Dstemming=false</parameter>: This switch disables stemming "
"support. Remove this switch if you have <ulink "
"url=\"https://github.com/zvelo/libstemmer\">libstemmer</ulink> installed and"
" want faster searches."
msgstr ""
"<parameter>-Dstemming=false</parameter>: Essa chave desabilita o suporte de "
"lematização. Remova essa chave se você tiver <ulink url=\"https://github.com/"
"zvelo/libstemmer\">libstemmer</ulink> instalado e quiser pesquisas mais "
"rápidas."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/appstream.xml:151
#, xml-text
msgid ""
"<option>-Dqt5=true</option>: Use this option if you have &qt5-deps; "
"installed and you want to build support for Qt-5 applications into this "
"package."
msgstr ""
"<option>-Dqt5=true</option>: Use essa opção se você tiver &qt5-deps; "
"instalado e quiser construir suporte para aplicativos Qt-5 nesse pacote."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/appstream.xml:157
#, xml-text
msgid ""
"<option>-Dqt=true</option>: Use this option if you have <xref "
"linkend=\"qt6\" role=\"nodep\"/> installed and you want to build support for"
" Qt6 applications into this package. This option conflicts with "
"<option>-Dqt5=true</option>."
msgstr ""
"<option>-Dqt=true</option>: Use essa opção se você tiver <xref linkend=\"qt6"
"\" role=\"nodep\"/> instalado e quiser construir suporte para aplicativos "
"Qt6 nesse pacote. Essa opção conflita com <option>-Dqt5=true</option>."

#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/genlib/appstream.xml:166
#, xml-text
msgid "Configuring AppStream"
msgstr "Configurando AppStream"

#. type: Content of: <sect1><sect2><sect3><title>
#: blfs-en/general/genlib/appstream.xml:169
#, xml-text
msgid "Config Files"
msgstr "Arquivos de Configuração"

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/general/genlib/appstream.xml:172
#, xml-text
msgid "<filename>/usr/share/metainfo/org.linuxfromscratch.lfs.xml</filename>"
msgstr "<filename>/usr/share/metainfo/org.linuxfromscratch.lfs.xml</filename>"

#. type: Content of: <sect1><sect2><sect3><title>
#: blfs-en/general/genlib/appstream.xml:177
#, xml-text
msgid "Configuration Information"
msgstr "Informação de Configuração"

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/general/genlib/appstream.xml:180
#, xml-text
msgid ""
"<application>AppStream</application> expects an operating system metainfo "
"file describing the GNU/Linux distribution.  As the &root; user, create the "
"file describing LFS:"
msgstr ""
"<application>AppStream</application> espera um arquivo de meta informações "
"do sistema operacional que descreva a distribuição GNU/Linux. Como o(a) "
"usuário(a) &root;, crie o arquivo descrevendo o LFS:"

#. type: Content of: <sect1><sect2><sect3><indexterm><primary>
#: blfs-en/general/genlib/appstream.xml:187
#, xml-text
msgid "/usr/share/metainfo/org.linuxfromscratch.lfs.xml"
msgstr "/usr/share/metainfo/org.linuxfromscratch.lfs.xml"

#. type: Content of: <sect1><sect2><sect3><screen>
#: blfs-en/general/genlib/appstream.xml:191
#, no-wrap, xml-text
msgid ""
"<userinput>install -vdm755 /usr/share/metainfo &amp;&amp;\n"
"cat > /usr/share/metainfo/org.linuxfromscratch.lfs.xml &lt;&lt; EOF\n"
"<literal>&lt;?xml version=\"1.0\" encoding=\"UTF-8\"?&gt;\n"
"&lt;component type=\"operating-system\"&gt;\n"
"  &lt;id&gt;org.linuxfromscratch.lfs&lt;/id&gt;\n"
"  &lt;name&gt;Linux From Scratch&lt;/name&gt;\n"
"  &lt;summary&gt;A customized Linux system built entirely from source&lt;/summary&gt;\n"
"  &lt;description&gt;\n"
"    &lt;p&gt;\n"
"      Linux From Scratch (LFS) is a project that provides you with\n"
"      step-by-step instructions for building your own customized Linux\n"
"      system entirely from source.\n"
"    &lt;/p&gt;\n"
"  &lt;/description&gt;\n"
"  &lt;url type=\"homepage\"&gt;https://www.linuxfromscratch.org/lfs/&lt;/url&gt;\n"
"  &lt;metadata_license&gt;MIT&lt;/metadata_license&gt;\n"
"  &lt;developer id='linuxfromscratch.org'&gt;\n"
"    &lt;name&gt;The Linux From Scratch Editors&lt;/name&gt;\n"
"  &lt;/developer&gt;\n"
"\n"
"  &lt;releases&gt;\n"
"    &lt;release version=\"12.2\" type=\"development\" date=\"2024-09-01\"&gt;\n"
"      &lt;description&gt;\n"
"        &lt;p&gt;The next release of Linux From Scratch.&lt;/p&gt;\n"
"      &lt;/description&gt;\n"
"    &lt;/release&gt;\n"
"\n"
"    &lt;release version=\"12.1\" type=\"stable\" date=\"2024-03-01\"&gt;\n"
"      &lt;description&gt;\n"
"        &lt;p&gt;Now contains Binutils 2.42, GCC-13.2.0, Glibc-2.39, and Linux\n"
"        kernel 6.7.&lt;/p&gt;\n"
"      &lt;/description&gt;\n"
"    &lt;/release&gt;\n"
"  &lt;/releases&gt;\n"
"&lt;/component&gt;</literal>\n"
"EOF</userinput>"
msgstr ""
"<userinput>install -vdm755 /usr/share/metainfo &amp;&amp;\n"
"cat > /usr/share/metainfo/org.linuxfromscratch.lfs.xml &lt;&lt; EOF\n"
"<literal>&lt;?xml version=\"1.0\" encoding=\"UTF-8\"?&gt;\n"
"&lt;component type=\"operating-system\"&gt;\n"
"  &lt;id&gt;org.linuxfromscratch.lfs&lt;/id&gt;\n"
"  &lt;name&gt;Linux From Scratch&lt;/name&gt;\n"
"  &lt;summary&gt;Um sistema Linux personalizado construído inteiramente a "
"partir do fonte&lt;/summary&gt;\n"
"  &lt;description&gt;\n"
"    &lt;p&gt;\n"
"      Linux From Scratch (LFS) é um projeto que te fornece instruções \n"
"      passo a passo para construir teu próprio sistema Linux \n"
"      personalizado inteiramente a partir do fonte.\n"
"    &lt;/p&gt;\n"
"  &lt;/description&gt;\n"
"  &lt;url type=\"homepage\"&gt;https://www.linuxfromscratch.org/lfs/"
"&lt;/url&gt;\n"
"  &lt;metadata_license&gt;MIT&lt;/metadata_license&gt;\n"
"  &lt;developer id='linuxfromscratch.org'&gt;\n"
"    &lt;name&gt;Os(As) Editores(as) do Linux From Scratch&lt;/name&gt;\n"
"  &lt;/developer&gt;\n"
"\n"
"  &lt;releases&gt;\n"
"    &lt;release version=\"12.2\" type=\"development\" date=\"2024-09-01\"&gt;"
"\n"
"      &lt;description&gt;\n"
"        &lt;p&gt;O próximo lançamento do Linux From Scratch.&lt;/p&gt;\n"
"      &lt;/description&gt;\n"
"    &lt;/release&gt;\n"
"\n"
"    &lt;release version=\"12.1\" type=\"stable\" date=\"2024-03-01\"&gt;\n"
"      &lt;description&gt;\n"
"        &lt;p&gt;Agora contém Binutils 2.42, GCC-13.2.0, Glibc-2.39 e o "
"núcleo Linux\n"
"        6.7.&lt;/p&gt;\n"
"      &lt;/description&gt;\n"
"    &lt;/release&gt;\n"
"  &lt;/releases&gt;\n"
"&lt;/component&gt;</literal>\n"
"EOF</userinput>"

