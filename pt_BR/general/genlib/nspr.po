#, xml-text
msgid "Introduction to NSPR"
msgstr "Introdução a NSPR"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/nspr.xml:29
#, xml-text
msgid ""
"<application>Netscape Portable Runtime</application> (NSPR) provides a "
"platform-neutral API for system level and libc like functions."
msgstr ""
"O <application>Netscape Portable Runtime</application> (NSPR) fornece uma "
"API neutra de plataforma para funções semelhantes às de nível de sistema e "
"\"libc\"."

