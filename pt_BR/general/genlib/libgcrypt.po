#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/genlib/libgcrypt.xml:26
#, xml-text
msgid "Introduction to libgcrypt"
msgstr "Introdução a libgcrypt"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libgcrypt.xml:29
#, xml-text
msgid ""
"The <application>libgcrypt</application> package contains a general purpose "
"crypto library based on the code used in <application>GnuPG</application>. "
"The library provides a high level interface to cryptographic building blocks"
" using an extendable and flexible API."
msgstr ""
"O pacote <application>libgcrypt</application> contém uma biblioteca "
"criptográfica de uso geral baseada no código usado no "
"<application>GnuPG</application>. A biblioteca fornece uma interface de alto"
" nível para blocos de construção criptográficos usando uma API extensível e "
"flexível."

