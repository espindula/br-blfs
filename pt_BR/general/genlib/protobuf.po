#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/genlib/protobuf.xml:78
#, xml-text
msgid "Installation of Protobuf"
msgstr "Instalação do Protobuf"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/protobuf.xml:81
#, xml-text
msgid ""
"Install <application>Protobuf</application> by running the following "
"commands:"
msgstr ""
"Instale <application>Protobuf</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genlib/protobuf.xml:85
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr      \\\n"
"      -D CMAKE_BUILD_TYPE=Release       \\\n"
"      -D CMAKE_SKIP_INSTALL_RPATH=ON    \\\n"
"      -D protobuf_BUILD_TESTS=OFF       \\\n"
"      -D protobuf_ABSL_PROVIDER=package \\\n"
"      -D protobuf_BUILD_LIBUPB=OFF      \\\n"
"      -D protobuf_BUILD_SHARED_LIBS=ON  \\\n"
"      -D utf8_range_ENABLE_INSTALL=OFF  \\\n"
"      -G Ninja ..                       &amp;&amp;\n"
"ninja</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr      \\\n"
"      -D CMAKE_BUILD_TYPE=Release       \\\n"
"      -D CMAKE_SKIP_INSTALL_RPATH=ON    \\\n"
"      -D protobuf_BUILD_TESTS=OFF       \\\n"
"      -D protobuf_ABSL_PROVIDER=package \\\n"
"      -D protobuf_BUILD_LIBUPB=OFF      \\\n"
"      -D protobuf_BUILD_SHARED_LIBS=ON  \\\n"
"      -D utf8_range_ENABLE_INSTALL=OFF  \\\n"
"      -G Ninja ..                       &amp;&amp;\n"
"ninja</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/protobuf.xml:100
#, xml-text
msgid ""
"This package does come with a test suite, but it requires <ulink "
"url=\"https://github.com/google/googletest\">gtest</ulink>, which is not "
"part of BLFS."
msgstr ""
"Esse pacote vem com uma suíte de teste, mas ela exige <ulink "
"url=\"https://github.com/google/googletest\">gtest</ulink>, que não é parte "
"do BLFS."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/protobuf.xml:106
#, xml-text
msgid "Now, as the &root; user:"
msgstr "Agora, como o(a) usuário(a) &root;:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genlib/protobuf.xml:109
#, no-wrap, xml-text
msgid ""
"<userinput>sed 's/utf8_range//' -i *.pc &amp;&amp;\n"
"ninja install</userinput>"
msgstr ""
"<userinput>sed 's/utf8_range//' -i *.pc &amp;&amp;\n"
"ninja install</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/genlib/protobuf.xml:115
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/protobuf.xml:121
#, xml-text
msgid ""
"<command>sed 's/utf8_range//' -i *.pc</command>: This command removes a "
"leftover reference to libutf8_range from the pkg-config files installed by "
"this package."
msgstr ""
"<command>sed 's/utf8_range//' -i *.pc</command>: Esse comando remove uma "
"referência restante ao libutf8_range dos arquivos pkg-config instalados por "
"esse pacote."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/protobuf.xml:127
#, xml-text
msgid ""
"<parameter>-D protobuf_BUILD_TESTS=OFF</parameter>: This parameter prevents "
"the tests from being built because <ulink "
"url=\"https://github.com/google/googletest\">gtest</ulink> is not part of "
"BLFS."
msgstr ""
"<parameter>-D protobuf_BUILD_TESTS=OFF</parameter>: Esse parâmetro impede os"
" testes de serem construídos porque <ulink "
"url=\"https://github.com/google/googletest\">gtest</ulink> não faz parte do "
"BLFS."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/protobuf.xml:134
#, xml-text
msgid ""
"<parameter>-D protobuf_ABSL_PROVIDER=package</parameter>: This parameter "
"allows the build system to use the system-installed copy of <xref "
"linkend=\"abseil-cpp\" role=\"nodep\"/>."
msgstr ""
"<parameter>-D protobuf_ABSL_PROVIDER=package</parameter>: Esse parâmetro "
"permite que o sistema de construção use a cópia instalada do sistema de "
"<xref linkend=\"abseil-cpp\" role=\"nodep\"/>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/protobuf.xml:140
#, xml-text
msgid ""
"<parameter>-D protobuf_BUILD_SHARED_LIBS=ON</parameter>: This parameter "
"enables building shared versions of the libraries provided by this package "
"instead of static versions."
msgstr ""
"<parameter>-D protobuf_BUILD_SHARED_LIBS=ON</parameter>: Esse parâmetro "
"habilita construir versões compartilhadas das bibliotecas fornecidas por "
"esse pacote em vez das versões estáticas."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/protobuf.xml:146
#, xml-text
msgid ""
"<parameter>-D utf8_range_ENABLE_INSTALL=OFF</parameter>: This parameter "
"disables installing the utf8_range static library.  The functions provided "
"by this library and used by protobuf is already embedded into <filename "
"class='libraryfile'>libprotobuf.so</filename>, so installing a full copy of "
"the static library is just wasting the disk space."
msgstr ""
"<parameter>-D utf8_range_ENABLE_INSTALL=OFF</parameter>: Esse parâmetro "
"desabilita instalar a biblioteca estática utf8_range. As funções fornecidas "
"por essa biblioteca e usadas pelo protobuf já estão incorporadas na "
"<filename class='libraryfile'>libprotobuf.so</filename>, de forma que "
"instalar uma cópia completa da biblioteca estática é apenas desperdiçar o "
"espaço em disco."

