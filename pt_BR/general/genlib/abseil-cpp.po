#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/genlib/abseil-cpp.xml:72
#, xml-text
msgid "Installation of Abseil-cpp"
msgstr "Instalação do Abseil-cpp"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/abseil-cpp.xml:75
#, xml-text
msgid ""
"Install <application>Abseil-cpp</application> by running the following "
"commands:"
msgstr ""
"Instale <application>Abseil-cpp</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genlib/abseil-cpp.xml:79
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr \\\n"
"      -D CMAKE_BUILD_TYPE=Release  \\\n"
"      -D ABSL_PROPAGATE_CXX_STD=ON \\\n"
"      -D BUILD_SHARED_LIBS=ON      \\\n"
"      -G Ninja ..                  &amp;&amp;\n"
"ninja</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr \\\n"
"      -D CMAKE_BUILD_TYPE=Release  \\\n"
"      -D ABSL_PROPAGATE_CXX_STD=ON \\\n"
"      -D BUILD_SHARED_LIBS=ON      \\\n"
"      -G Ninja ..                  &amp;&amp;\n"
"ninja</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/abseil-cpp.xml:90
#, xml-text
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/abseil-cpp.xml:94
#, xml-text
msgid "Now, as the &root; user:"
msgstr "Agora, como o(a) usuário(a) &root;:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genlib/abseil-cpp.xml:97
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr "<userinput>ninja install</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/genlib/abseil-cpp.xml:102
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/abseil-cpp.xml:105
#, xml-text
msgid ""
"<parameter>-D ABSL_PROPAGATE_CXX_STD=ON</parameter>: This parameter enables "
"propagating C++ features to targets that link to this package's libraries."
msgstr ""
"<parameter>-D ABSL_PROPAGATE_CXX_STD=ON</parameter>: Esse parâmetro habilita"
" propagar recursos C++ para alvos que linquem para as bibliotecas desse "
"pacote."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/abseil-cpp.xml:111
#, xml-text
msgid ""
"<parameter>-D BUILD_SHARED_LIBS=ON</parameter>: This parameter builds shared"
" versions of the libraries provided by this package instead of static "
"libraries."
msgstr ""
"<parameter>-D BUILD_SHARED_LIBS=ON</parameter>: Esse parâmetro constrói "
"versões compartilhadas das bibliotecas fornecidas por esse pacote em vez de "
"bibliotecas estáticas."

