#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/genlib/libarchive.xml:92
#, xml-text
msgid "Installation of libarchive"
msgstr "Instalação do libarchive"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libarchive.xml:95
#, xml-text
msgid ""
"Install <application>libarchive</application> by running the following "
"commands:"
msgstr ""
"Instale o <application>libarchive</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genlib/libarchive.xml:99
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr --disable-static &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>./configure --prefix=/usr --disable-static &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libarchive.xml:103
#, xml-text
#| msgid ""
#| "To test the results, issue: <command>LC_ALL=C make check</command>."
msgid ""
"To test the results, issue: <command>LC_ALL=C.UTF-8 make check</command>."
msgstr ""
"Para testar os resultados, emita: <command>LC_ALL=C.UTF-8 make "
"check</command>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libarchive.xml:107
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genlib/libarchive.xml:110
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/genlib/libarchive.xml:115
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libarchive.xml:121
#, xml-text
msgid ""
"<option>--without-xml2</option>: This switch sets expat for xar archive "
"format support instead of preferred libxml2 if both packages are installed."
msgstr ""
"<option>--without-xml2</option>: Essa chave configura \"expat\" para suporte"
" ao formato de arquivamento \"xar\" em vez do preferido \"libxml2\" se ambos"
" os pacotes estiverem instalados."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libarchive.xml:126
#, xml-text
msgid ""
"<option>--without-nettle</option>: This switch sets OpenSSL for crypto "
"support instead of preferred Nettle if both packages are installed."
msgstr ""
"<option>--without-nettle</option>: Essa chave configura o \"OpenSSL\" para "
"suporte de criptografia em vez do preferido \"Nettle\" se ambos os pacotes "
"estiverem instalados."

