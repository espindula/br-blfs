#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/genlib/libyaml.xml:80
#, xml-text
msgid "Installation of libyaml"
msgstr "Instalação do libyaml"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libyaml.xml:83
#, xml-text
msgid ""
"Install <application>libyaml</application> by running the following "
"commands:"
msgstr ""
"Instale <application>libyaml</application> executando os seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genlib/libyaml.xml:87
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr --disable-static &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>./configure --prefix=/usr --disable-static &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libyaml.xml:100
#, xml-text
msgid "To test the results, issue: <command>make check</command>."
msgstr "Para testar os resultados, emita: <command>make check</command>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libyaml.xml:104
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genlib/libyaml.xml:107
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

