#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/spirv-headers.xml:93
#, xml-text
msgid ""
"Install <application>SPIRV-Headers</application> by running the following "
"commands:"
msgstr ""
"Instale <application>SPIRV-Headers</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genlib/spirv-headers.xml:97
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -DCMAKE_INSTALL_PREFIX=/usr -G Ninja .. &amp;&amp;\n"
"ninja</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -DCMAKE_INSTALL_PREFIX=/usr -G Ninja .. &amp;&amp;\n"
"ninja</userinput>"

