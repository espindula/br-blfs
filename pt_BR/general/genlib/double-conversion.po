#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/double-conversion.xml:30
#, xml-text
msgid ""
"The <application>Double-conversion</application> package contains a library "
"that facilitates binary-to-decimal and decimal-to-binary routines for IEEE "
"doubles."
msgstr ""
"O pacote <application>Double-conversion</application> contém uma biblioteca "
"que facilita as rotinas binário-para-decimal e decimal-para-binário para "
"duplos IEEE."

