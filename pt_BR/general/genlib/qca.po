#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/genlib/qca.xml:108
#, xml-text
msgid "Installation of Qca"
msgstr "Instalação do Qca"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/qca.xml:111
#, xml-text
msgid "Fix the location of the CA certificates:"
msgstr "Corrija o local dos certificados de AC:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genlib/qca.xml:114
#, no-wrap, xml-text
msgid ""
"<userinput>sed -i 's@cert.pem@certs/ca-bundle.crt@' "
"CMakeLists.txt</userinput>"
msgstr ""
"<userinput>sed -i 's@cert.pem@certs/ca-bundle.crt@' "
"CMakeLists.txt</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/qca.xml:117
#, xml-text
msgid ""
"Install <application>Qca</application> by running the following commands:"
msgstr ""
"Instale <application>Qca</application> executando os seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genlib/qca.xml:121
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -DCMAKE_INSTALL_PREFIX=$QT5DIR            \\\n"
"      -DCMAKE_BUILD_TYPE=Release                \\\n"
"      -DQCA_MAN_INSTALL_DIR:PATH=/usr/share/man \\\n"
"      .. &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd   build &amp;&amp;\n"
"\n"
"cmake -DCMAKE_INSTALL_PREFIX=$QT5DIR            \\\n"
"      -DCMAKE_BUILD_TYPE=Release                \\\n"
"      -DQCA_MAN_INSTALL_DIR:PATH=/usr/share/man \\\n"
"      .. &amp;&amp;\n"
"make</userinput>"

#. One test
#.       using <xref linkend="gnupg2"/>
#.  fails without a correct passphrase.  The
#.       required passphrase does not seem to be published.
#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/qca.xml:131
#, xml-text
msgid "To test the results, issue <command>make test</command>."
msgstr "Para testar os resultados, emita: <command>make test</command>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/qca.xml:137
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genlib/qca.xml:140
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/genlib/qca.xml:145
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/qca.xml:148
#, xml-text
msgid ""
"<parameter>-DCMAKE_BUILD_TYPE=Release</parameter>: This switch is used to "
"apply a higher level of compiler optimizations."
msgstr ""
"<parameter>-DCMAKE_BUILD_TYPE=Release</parameter>: Essa chave é usada para "
"aplicar um nível mais alto de otimizações do compilador."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/qca.xml:153
#, xml-text
msgid ""
"<parameter>-DQCA_MAN_INSTALL_DIR:PATH=/usr/share/man</parameter>: Install "
"the qca man page in the normal location."
msgstr ""
"<parameter>-DQCA_MAN_INSTALL_DIR:PATH=/usr/share/man</parameter>: Instala a "
"página de manual do \"qca\" no local normal."

