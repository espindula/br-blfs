#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/genlib/qca.xml:26
#, xml-text
msgid "Introduction to Qca"
msgstr "Introdução a Qca"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/qca.xml:29
#, xml-text
msgid ""
"<application>Qca</application> aims to provide a straightforward and cross-"
"platform crypto API, using <application>Qt</application> datatypes and "
"conventions. <application>Qca</application> separates the API from the "
"implementation, using plugins known as Providers."
msgstr ""
"O <application>Qca</application> visa a fornecer uma API criptográfica "
"direta e multiplataforma, usando tipos de dados e convenções "
"<application>Qt</application>. <application>Qca</application> separa a API "
"da implementação, usando \"plugins\" conhecidos como \"Providers\"."

