#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libptytty.xml:30
#, xml-text
msgid ""
"The <application>libptytty</application> package provides a library that "
"allows for OS independent and secure pty/tty and utmp/wtmp/lastlog handling."
msgstr ""
"O pacote <application>libptytty</application> fornece uma biblioteca que "
"permite o manuseio seguro e independente do Sistema Operacional de pty/tty e"
" de utmp/wtmp/lastlog."

