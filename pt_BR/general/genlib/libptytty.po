#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/genlib/libptytty.xml:81
#, xml-text
msgid "Installation of libptytty"
msgstr "Instalação do libptytty"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libptytty.xml:84
#, xml-text
msgid ""
"Install <application>libptytty</application> by running the following "
"commands:"
msgstr ""
"Instale <application>libptytty</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genlib/libptytty.xml:88
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -DCMAKE_INSTALL_PREFIX=/usr     \\\n"
"      -DCMAKE_BUILD_TYPE=Release      \\\n"
"      -DPT_UTMP_FILE:STRING=/run/utmp \\\n"
"      .. &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd   build &amp;&amp;\n"
"\n"
"cmake -DCMAKE_INSTALL_PREFIX=/usr     \\\n"
"      -DCMAKE_BUILD_TYPE=Release      \\\n"
"      -DPT_UTMP_FILE:STRING=/run/utmp \\\n"
"      .. &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libptytty.xml:98
#, xml-text
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libptytty.xml:102
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genlib/libptytty.xml:105
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

