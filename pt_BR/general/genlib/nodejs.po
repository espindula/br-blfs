#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/nodejs.xml:29
#, xml-text
msgid ""
"<application>Node.js</application> is a "
"<application>JavaScript</application> runtime built on "
"<application>Chrome's</application> V8 JavaScript engine."
msgstr ""
"<application>Node.js</application> é um tempo de execução "
"<application>JavaScript</application> construído sobre o mecanismo "
"\"JavaScript V8\" do <application>Chrome</application>."

