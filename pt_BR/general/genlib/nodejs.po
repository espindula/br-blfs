#: blfs-en/general/genlib/nodejs.xml:110
#, xml-text
msgid "Installation of Node.js"
msgstr "Instalação do Node.js"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/nodejs.xml:123
#, xml-text
msgid ""
"Build <application>Node.js</application> by running the following commands:"
msgstr ""
"Construa <application>Node.js</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genlib/nodejs.xml:127
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr          \\\n"
"            --shared-brotli        \\\n"
"            --shared-cares         \\\n"
"            --shared-libuv         \\\n"
"            --shared-openssl       \\\n"
"            --shared-nghttp2       \\\n"
"            --shared-zlib          \\\n"
"            --with-intl=system-icu &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>./configure --prefix=/usr          \\\n"
"            --shared-brotli        \\\n"
"            --shared-cares         \\\n"
"            --shared-libuv         \\\n"
"            --shared-openssl       \\\n"
"            --shared-nghttp2       \\\n"
"            --shared-zlib          \\\n"
"            --with-intl=system-icu &amp;&amp;\n"
"make</userinput>"

