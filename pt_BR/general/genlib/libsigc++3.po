#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/genlib/libsigc++3.xml:26
#, xml-text
msgid "Introduction to libsigc++"
msgstr "Introdução ao libsigc++"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libsigc++3.xml:29
#, xml-text
msgid ""
"The <application>libsigc++</application> package implements a typesafe "
"callback system for standard C++. This version is part of a new API for "
"supporting gtkmm-4."
msgstr ""
"O pacote <application>libsigc++</application> implementa um sistema de "
"retorno de chamada seguro para C++ padrão. Essa versão é parte de uma nova "
"API para suporte ao gtkmm-4."

