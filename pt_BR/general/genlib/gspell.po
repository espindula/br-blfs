#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/gspell.xml:29
#, xml-text
msgid ""
"The <application>gspell</application> package provides a flexible API to add"
" spell checking to a GTK+ application."
msgstr ""
"O pacote <application>gspell</application> fornece uma API flexível para "
"adicionar verificação ortográfica a um aplicativo GTK+."

