#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/genlib/gspell.xml:89
#, xml-text
msgid "Installation of gspell"
msgstr "Instalação do gspell"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/gspell.xml:92
#, xml-text
msgid ""
"Install <application>gspell</application> by running the following commands:"
msgstr ""
"Instale <application>gspell</application> executando os seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genlib/gspell.xml:96
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>./configure --prefix=/usr &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/gspell.xml:100
#, xml-text
msgid ""
"To test the results, issue: <command>make check</command>.  The tests must "
"be run in an X session. One test, test-checker, is known to fail if the "
"external package <ulink url=\"https://hunspell.github.io/\">Hunspell</ulink>"
" is not installed."
msgstr ""
"Para testar os resultados, emita: <command>make check</command>. Os testes "
"precisam ser executados em uma sessão do X. Um teste, \"test-checker\", é "
"conhecido por falhar se o pacote externo <ulink "
"url=\"https://hunspell.github.io/\">Hunspell</ulink> não estiver instalado."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/gspell.xml:108
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genlib/gspell.xml:111
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genlib/gspell.xml:116
#, no-wrap, xml-text
msgid "<userinput>rm -v /usr/lib/libgspell-1.la</userinput>"
msgstr "<userinput>rm -v /usr/lib/libgspell-1.la</userinput>"

