#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libdisplay-info.xml:28
#, xml-text
msgid ""
"The <application>libdisplay-info</application> package provides a set of "
"high-level and low-level functions to access detailed Extended Display "
"Identification Data (EDID) information."
msgstr ""
"O pacote <application>libdisplay-info</application> fornece um conjunto de "
"funções de alto e baixo nível para acessar informações detalhadas de "
"Extended Display Identification Data (EDID)."

