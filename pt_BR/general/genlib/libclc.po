#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/genlib/libclc.xml:73
#, xml-text
msgid "Installation of libclc"
msgstr "Instalação de libclc"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libclc.xml:76
#, xml-text
msgid ""
"Install <application>libclc</application> by running the following commands:"
msgstr ""
"Instale <application>libclc</application> executando os seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genlib/libclc.xml:80
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr \\\n"
"      -D CMAKE_BUILD_TYPE=Release  \\\n"
"      -G Ninja ..                  &amp;&amp;\n"
"ninja</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr \\\n"
"      -D CMAKE_BUILD_TYPE=Release  \\\n"
"      -G Ninja ..                  &amp;&amp;\n"
"ninja</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libclc.xml:89
#, xml-text
msgid ""
"To test the results, issue: <command>ninja test</command>. Two tests, "
"<filename>external-calls-clspv--.bc</filename> and <filename>external-calls-"
"clspv64--.bc</filename>, are known to fail due to invalid syntax."
msgstr ""
"Para testar os resultados, emita: <command>ninja test</command>. Dois "
"testes, <filename>external-calls-clspv--.bc</filename> e <filename>external-"
"calls-clspv64--.bc</filename>, são conhecidos por falharem devido à sintaxe "
"inválida."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libclc.xml:96
#, xml-text
msgid "Now, as the &root; user:"
msgstr "Agora, como o(a) usuário(a) &root;:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genlib/libclc.xml:99
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr "<userinput>ninja install</userinput>"

