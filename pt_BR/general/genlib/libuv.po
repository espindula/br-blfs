#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/genlib/libuv.xml:84
#, xml-text
msgid "Installation of libuv"
msgstr "Instalação do libuv"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libuv.xml:87
#, xml-text
msgid ""
"Install <application>libuv</application> by running the following commands:"
msgstr ""
"Instale <application>libuv</application> executando os seguintes comandos:"

#. type: Content of: <sect1><sect2><caution><para>
#: blfs-en/general/genlib/libuv.xml:93
#, xml-text
msgid ""
"The <command>sh autogen.sh</command> command below fails if the ACLOCAL "
"environment variable is set as specified in <xref linkend=\"xorg7\"/>.  If "
"it is used, ACLOCAL needs to be unset for this package and then reset for "
"other packages."
msgstr ""
"O comando <command>sh autogen.sh</command> abaixo falha se a variável de "
"ambiente \"ACLOCAL\" estiver configurada conforme especificado em <xref "
"linkend=\"xorg7\"/>. Se for usado, [então] \"ACLOCAL\" precisa ser "
"desconfigurada para esse pacote e, em seguida, reconfigurada para outros "
"pacotes."

#. Don't use cmake here to avoid circular dependency
#. <screen><userinput>sed -i "/TARGETS uv_a ARCHIVE/d" CMakeLists.txt
#. &amp;&amp;
#. mkdir build &amp;&amp;
#. cd    build &amp;&amp;
#. cmake -DCMAKE_INSTALL_PREFIX=/usr .. &amp;&amp;
#. make </userinput></screen>
#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genlib/libuv.xml:112
#, no-wrap, xml-text
msgid ""
"<userinput>sh autogen.sh                              &amp;&amp;\n"
"./configure --prefix=/usr --disable-static &amp;&amp;\n"
"make </userinput>"
msgstr ""
"<userinput>sh autogen.sh                             &amp;&amp;\n"
"./configure --prefix=/usr --disable-static &amp;&amp;\n"
"make </userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libuv.xml:117
#, xml-text
msgid ""
"If you installed the optional <xref linkend=\"sphinx\"/> python module, "
"create the man page:"
msgstr ""
"Se você instalou o módulo opcional <xref linkend=\"sphinx\"/> do Python, "
"crie a página de manual:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genlib/libuv.xml:121
#, no-wrap, xml-text
msgid "<userinput>make man -C docs</userinput>"
msgstr "<userinput>make man -C docs</userinput>"

#.  the test suite refuses to run as root
#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libuv.xml:124
#, xml-text
msgid ""
"If you want to run the tests, run: <command>make check</command> as a non-"
"root user."
msgstr ""
"Se você deseja executar os testes, [então] execute: <command>make "
"check</command> como um(a) usuário(a) não root."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libuv.xml:129
#, xml-text
msgid "Now, as the &root; user:"
msgstr "Agora, como o(a) usuário(a) &root;:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genlib/libuv.xml:132
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libuv.xml:135
#, xml-text
msgid "If you built the man page, install it as the &root; user:"
msgstr ""
"Se você construiu a página de manual, instale-a como o(a) usuário(a) &root;:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genlib/libuv.xml:138
#, no-wrap, xml-text
msgid ""
"<userinput>install -Dm644 docs/build/man/libuv.1 "
"/usr/share/man/man1</userinput>"
msgstr ""
"<userinput>install -Dm644 docs/build/man/libuv.1 "
"/usr/share/man/man1</userinput>"

