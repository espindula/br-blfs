#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/general/genlib/libxslt.xml:83
#, xml-text
msgid "Required"
msgstr "Exigida"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libxslt.xml:85
#, xml-text
msgid "<xref linkend=\"libxml2\"/>"
msgstr "<xref linkend=\"libxml2\"/>"

#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/general/genlib/libxslt.xml:88
#, xml-text
msgid "Recommended (at runtime)"
msgstr "Recomendadas (em tempo de execução)"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libxslt.xml:90
#, xml-text
msgid ""
"<xref role=\"runtime\" linkend=\"DocBook\"/> and <xref role=\"runtime\" "
"linkend=\"docbook-xsl\"/>"
msgstr ""
"<xref role=\"runtime\" linkend=\"DocBook\"/> e <xref role=\"runtime\" "
"linkend=\"docbook-xsl\"/>"

#. type: Content of: <sect1><sect2><note><para>
#: blfs-en/general/genlib/libxslt.xml:96
#, xml-text
msgid ""
"Although it is not a direct dependency, many applications using "
"<application>libxslt</application> will expect <xref linkend=\"DocBook\"/> "
"and <xref linkend=\"docbook-xsl\"/> to be present."
msgstr ""
"Embora não seja uma dependência direta, muitos aplicativos que usam a "
"<application>libxslt</application> esperam que <xref linkend=\"DocBook\"/> e"
" <xref linkend=\"docbook-xsl\"/> estejam presentes."

#. type: Content of: <sect1><sect2><bridgehead>
