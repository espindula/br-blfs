#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libpaper.xml:75
#, xml-text
msgid ""
"Install <application>libpaper</application> by running the following "
"commands:"
msgstr ""
"Instale o <application>libpaper</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genlib/libpaper.xml:79
#, no-wrap, xml-text
#| msgid ""
#| "<userinput>./configure --prefix=/usr        \\\n"
#| "            --sysconfdir=/etc    \\\n"
#| "            --disable-static     \\\n"
#| "            --enable-relocatable \\\n"
#| "            --docdir=/usr/share/doc/libpaper-&libpaper-version; &amp;&amp;\n"
#| "make</userinput>"
msgid ""
"<userinput>./configure --prefix=/usr        \\\n"
"            --sysconfdir=/etc    \\\n"
"            --disable-static     \\\n"
"            --docdir=/usr/share/doc/libpaper-&libpaper-version; &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>./configure --prefix=/usr        \\\n"
"            --sysconfdir=/etc    \\\n"
"            --disable-static     \\\n"
"            --docdir=/usr/share/doc/libpaper-&libpaper-version; &amp;&amp;\n"
"make</userinput>"

