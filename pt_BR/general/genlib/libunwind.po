msgstr "Instalação do libunwind"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libunwind.xml:85
#, xml-text
msgid ""
"Install <application>libunwind</application> by running the following "
"commands:"
msgstr ""
"Instale <application>libunwind</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genlib/libunwind.xml:89
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr --disable-static &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>./configure --prefix=/usr --disable-static &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libunwind.xml:93
#, xml-text
msgid ""
"To test the results, issue: <command>make check</command>.  Two tests, run-"
"coredump-unwind and run-coredump-unwind-mdi are known to fail."
msgstr ""
"Para testar os resultados, emita: <command>make check</command>. Dois "
"testes, \"run-coredump-unwind\" e \"run-coredump-unwind-mdi\" são conhecidos"
" por falharem."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libunwind.xml:99
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genlib/libunwind.xml:102
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

