#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/genlib/libxmlb.xml:94
#, xml-text
msgid "Installation of libxmlb"
msgstr "Instalação do libxmlb"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libxmlb.xml:97
#, xml-text
msgid ""
"Install <application>libxmlb</application> by running the following "
"commands:"
msgstr ""
"Instale <application>libxmlb</application> executando os seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genlib/libxmlb.xml:101
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr --buildtype=release -Dgtkdoc=false .. &amp;&amp;\n"
"ninja</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr --buildtype=release -Dgtkdoc=false .. &amp;&amp;\n"
"ninja</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libxmlb.xml:108
#, xml-text
msgid "To test the results, issue: <command>ninja test</command>."
msgstr "Para testar os resultados, emita: <command>ninja test</command>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libxmlb.xml:112
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genlib/libxmlb.xml:115
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr "<userinput>ninja install</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/genlib/libxmlb.xml:120
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libxmlb.xml:129
#, xml-text
msgid ""
"<parameter>-Dgtkdoc=false</parameter>: This switch disables building the API"
" documentation. Remove it if you have <xref linkend=\"gtk-doc\" "
"role=\"nodep\"/> installed and wish to build the API documentation."
msgstr ""
"<parameter>-Dgtkdoc=false</parameter>: Essa chave desabilita construir a "
"documentação da API. Remova-a se você tiver <xref linkend=\"gtk-doc\" role="
"\"nodep\"/> instalado e desejar construir a documentação da API."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libxmlb.xml:136
#, xml-text
msgid ""
"<option>-Dintrospection=false</option>: Use this switch if you do not have "
"<xref linkend=\"gobject-introspection\" role=\"nodep\"/> installed."
msgstr ""
"<option>-Dintrospection=false</option>: Use essa chave se você não tiver "
"<xref linkend=\"gobject-introspection\" role=\"nodep\"/> instalado."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libxmlb.xml:141
#, xml-text
msgid ""
"<option>-Dstemmer=true</option>: Use this switch if you have <ulink "
"url=\"https://github.com/zvelo/libstemmer\">libstemmer</ulink> installed and"
" wish to build stemmer support."
msgstr ""
"<option>-Dstemmer=true</option>: Use essa chave se você tiver <ulink url="
"\"https://github.com/zvelo/libstemmer\">libstemmer</ulink> instalado e "
"desejar construir suporte para lematizador."

