#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/genutils/compface.xml:26
#, xml-text
msgid "Introduction to Compface"
msgstr "Introdução a Compface"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genutils/compface.xml:29
#, xml-text
msgid ""
"<application>Compface</application> provides utilities and a library to "
"convert from/to X-Face format, a 48x48 bitmap format used to carry "
"thumbnails of email authors in a mail header."
msgstr ""
"O <application>Compface</application> fornece utilitários e uma biblioteca "
"para converter de/para o formato \"X-Face\", um formato \"bitmap\" 48x48 "
"usado para transportar miniaturas dos(as) autores(as) de mensagens "
"eletrônicas em um cabeçalho de mensagem."

