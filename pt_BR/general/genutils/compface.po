#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/genutils/compface.xml:73
#, xml-text
msgid "Installation of Compface"
msgstr "Instalação do Compface"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genutils/compface.xml:76
#, xml-text
msgid ""
"Install <application>Compface</application> by running the following "
"commands:"
msgstr ""
"Instale <application>Compface</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genutils/compface.xml:80
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr --mandir=/usr/share/man &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>./configure --prefix=/usr --mandir=/usr/share/man &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genutils/compface.xml:84
#, xml-text
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genutils/compface.xml:88
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genutils/compface.xml:91
#, no-wrap, xml-text
msgid ""
"<userinput>make install &amp;&amp;\n"
"install -m755 -v xbm2xface.pl /usr/bin</userinput>"
msgstr ""
"<userinput>make install &amp;&amp;\n"
"install -m755 -v xbm2xface.pl /usr/bin</userinput>"

