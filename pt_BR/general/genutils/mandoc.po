#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/genutils/mandoc.xml:70
#, xml-text
msgid "Installation of mandoc"
msgstr "Instalação do mandoc"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genutils/mandoc.xml:73
#, xml-text
msgid ""
"Many utilities provided by <application>mandoc</application> conflicts with "
"<application>Man-DB</application> in LFS.  Only build the "
"<command>mandoc</command> command:"
msgstr ""
"Muitos utilitários fornecidos pelo <application>mandoc</application> "
"conflitam com <application>Man-DB</application> no LFS. Construa somente o "
"comando <command>mandoc</command>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genutils/mandoc.xml:78
#, no-wrap, xml-text
msgid ""
"<userinput>./configure &amp;&amp;\n"
"make mandoc</userinput>"
msgstr ""
"<userinput>./configure &amp;&amp;\n"
"make mandoc</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genutils/mandoc.xml:82
#, xml-text
msgid "To test the package, issue: <command>make regress</command>."
msgstr "Para testar o pacote, emita: <command>make regress</command>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genutils/mandoc.xml:86
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genutils/mandoc.xml:89
#, no-wrap, xml-text
msgid ""
"<userinput>install -vm755 mandoc   /usr/bin &amp;&amp;\n"
"install -vm644 mandoc.1 /usr/share/man/man1</userinput>"
msgstr ""
"<userinput>install -vm755 mandoc  /usr/bin &amp;&amp;\n"
"install -vm644 mandoc.1 /usr/share/man/man1</userinput>"

