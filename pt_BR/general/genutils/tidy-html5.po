#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/genutils/tidy-html5.xml:87
#, xml-text
msgid "Installation of Tidy HTML5"
msgstr "Instalação do \"Tidy HTML5\""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genutils/tidy-html5.xml:90
#, xml-text
msgid ""
"Install <application>Tidy HTML5</application> by running the following "
"commands:"
msgstr ""
"Instale <application>Tidy HTML5</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genutils/tidy-html5.xml:94
#, no-wrap, xml-text
msgid ""
"<userinput>cd build/cmake &amp;&amp;\n"
"\n"
"cmake -DCMAKE_INSTALL_PREFIX=/usr \\\n"
"      -DCMAKE_BUILD_TYPE=Release  \\\n"
"      -DBUILD_TAB2SPACE=ON        \\\n"
"      ../..    &amp;&amp;\n"
"\n"
"make</userinput>"
msgstr ""
"<userinput>cd build/cmake &amp;&amp;\n"
"\n"
"cmake -DCMAKE_INSTALL_PREFIX=/usr \\\n"
"      -DCMAKE_BUILD_TYPE=Release  \\\n"
"      -DBUILD_TAB2SPACE=ON       \\\n"
"      ../..    &amp;&amp;\n"
"\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genutils/tidy-html5.xml:104
#, xml-text
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genutils/tidy-html5.xml:108
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genutils/tidy-html5.xml:111
#, no-wrap, xml-text
msgid ""
"<userinput>make install &amp;&amp;\n"
"rm -fv /usr/lib/libtidy.a &amp;&amp;\n"
"install -v -m755 tab2space /usr/bin</userinput>"
msgstr ""
"<userinput>make install &amp;&amp;\n"
"rm -fv /usr/lib/libtidy.a &amp;&amp;\n"
"install -v -m755 tab2space /usr/bin</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/genutils/tidy-html5.xml:118
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genutils/tidy-html5.xml:121
#, xml-text
msgid ""
"<parameter>-DCMAKE_BUILD_TYPE=Release</parameter>: This switch is used to "
"build the release library without any debug `assert` in the code."
msgstr ""
"<parameter>-DCMAKE_BUILD_TYPE=Release</parameter>: Essa chave é usada para "
"construir a biblioteca de lançamento sem qualquer `assertiva` de depuração "
"no código."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genutils/tidy-html5.xml:126
#, xml-text
msgid ""
"<parameter>-DBUILD_TAB2SPACE=ON</parameter>: This switch is used to enable "
"building the <command>tab2space</command> utility."
msgstr ""
"<parameter>-DBUILD_TAB2SPACE=ON</parameter>: Essa chave é usada para "
"habilitar a construção do utilitário <command>tab2space</command>."

