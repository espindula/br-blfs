msgstr "Configuração do Núcleo"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genutils/lsof.xml:90
#, xml-text
msgid ""
"To run the tests, the following option should be enabled in the kernel "
"configuration:"
msgstr ""
"Para executar os testes, a seguinte opção deveria estar habilitada na "
"configuração do núcleo:"

#. type: Content of: <sect1><sect2><indexterm><primary>
#: blfs-en/general/genutils/lsof.xml:98
#, xml-text
msgid "lsof (testing)"
msgstr "lsof (testagem)"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/genutils/lsof.xml:104
#, xml-text
msgid "Installation of lsof"
msgstr "Instalação do lsof"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genutils/lsof.xml:107
#, xml-text
msgid ""
"Install <application>lsof</application> by running the following commands:"
msgstr ""
"Instale <application>lsof</application> executando os seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genutils/lsof.xml:111
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr --disable-static &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>./configure --prefix=/usr --disable-static &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genutils/lsof.xml:115
#, xml-text
msgid ""
"The tests should be run as the <systemitem "
"class=\"username\">root</systemitem> user. They require that the POSIX "
"message queues are enabled in the kernel, and that <xref linkend=\"nmap\"/> "
"be installed with a symbolic link <filename>/usr/bin/nc</filename> pointing "
"to <command>ncat</command>."
msgstr ""
"Os testes deveriam ser executados como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>. Eles exigem que as filas de mensagens "
"\"POSIX\" estejam habilitadas no núcleo e que <xref linkend=\"nmap\"/> seja "
"instalado com um link simbólico <filename>/usr/bin/nc</filename> apontando "
"para <command>ncat</command>."

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genutils/lsof.xml:123
#, no-wrap, xml-text
msgid "<userinput>make check</userinput>"
msgstr "<userinput>make check</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genutils/lsof.xml:133
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genutils/lsof.xml:136
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

