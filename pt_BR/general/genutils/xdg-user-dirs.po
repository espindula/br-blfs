#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/genutils/xdg-user-dirs.xml:84
#, xml-text
msgid "Installation of Xdg-user-dirs"
msgstr "Instalação do \"Xdg-user-dirs\""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genutils/xdg-user-dirs.xml:87
#, xml-text
msgid ""
"Install <application>xdg-user-dirs</application> by running the following "
"commands:"
msgstr ""
"Instale <application>xdg-user-dirs</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genutils/xdg-user-dirs.xml:91
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr           \\\n"
"            --sysconfdir=/etc       \\\n"
"            --disable-documentation &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>./configure --prefix=/usr           \\\n"
"            --sysconfdir=/etc       \\\n"
"            --disable-documentation &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genutils/xdg-user-dirs.xml:97
#, xml-text
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genutils/xdg-user-dirs.xml:101
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genutils/xdg-user-dirs.xml:104
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/genutils/xdg-user-dirs.xml:108
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genutils/xdg-user-dirs.xml:111
#, xml-text
msgid ""
"<parameter>--disable-documentation</parameter>: Disable the installation of "
"the man pages.  Remove this switch if you've installed the optional "
"dependencies and you wish to install the man pages of this package."
msgstr ""
"<parameter>--disable-documentation</parameter>: Desabilita a instalação das "
"páginas de manual. Remova essa chave se você tiver instalado as dependências"
" opcionais e desejar instalar as páginas de manual desse pacote."

