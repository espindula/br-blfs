msgstr "Instalação do PIN-Entry"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genutils/pinentry.xml:109
#, xml-text
msgid ""
"Install <application>PIN-Entry</application> by running the following "
"commands:"
msgstr ""
"Instale <application>PIN-Entry</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genutils/pinentry.xml:113
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr --enable-pinentry-tty &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>./configure --prefix=/usr --enable-pinentry-tty &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genutils/pinentry.xml:117
#, xml-text
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genutils/pinentry.xml:121
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genutils/pinentry.xml:124
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/genutils/pinentry.xml:129
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genutils/pinentry.xml:132
#, xml-text
msgid "<option>--enable-inside-emacs=yes/no</option>: Default is no."
msgstr "<option>--enable-inside-emacs=yes/no</option>: Padrão é \"no\"."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genutils/pinentry.xml:136
#, xml-text
msgid "<option>--enable-pinentry-qt=yes/no</option>: Default is yes."
msgstr "<option>--enable-pinentry-qt=yes/no</option>: Padrão é \"yes\"."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genutils/pinentry.xml:140
#, xml-text
msgid ""
"<option>--enable-pinentry-gtk2=yes/no</option>: Default is yes. Even if "
"other <command>pinentry-*</command> is installed, "
"<command>pinentry</command> will be a symlink to <command>pinentry-"
"gtk-2</command>."
msgstr ""
"<option>--enable-pinentry-gtk2=yes/no</option>: Padrão é \"yes\". Mesmo se "
"outros <command>pinentry-*</command> estiverem instalados, "
"<command>pinentry</command> será um link simbólico para <command>pinentry-"
"gtk-2</command>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genutils/pinentry.xml:147
#, xml-text
msgid ""
"<option>--enable-pinentry-gnome3=yes/no</option>: Default is yes.  Actually,"
" it uses <application>Gcr</application> for the pinentry dialog."
msgstr ""
"<option>--enable-pinentry-gnome3=yes/no</option>: Padrão é \"yes\". "
"Atualmente, ele usa <application>Gcr</application> para o diálogo "
"\"pinentry\"."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genutils/pinentry.xml:153
#, xml-text
msgid "<parameter>--enable-pinentry-tty</parameter>: Default is 'maybe'."
msgstr "<parameter>--enable-pinentry-tty</parameter>: Padrão é \"maybe\"."

