#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/genutils/sharutils.xml:72
#, xml-text
msgid "Installation of Sharutils"
msgstr "Instalação do Sharutils"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genutils/sharutils.xml:75
#, xml-text
msgid "Fix a heap buffer overflow, and an issue exposed by GCC-10:"
msgstr ""
"Corrija um estouro de \"buffer\" de uma coleção desordenada de objetos "
"colocados ao acaso uns sobre os outros e um problema exposto pelo "
"\"GCC-10\":"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genutils/sharutils.xml:78
#, no-wrap, xml-text
msgid ""
"<userinput>sed -i 's/BUFSIZ/rw_base_size/' src/unshar.c &amp;&amp;\n"
"sed -i '/program_name/s/^/extern /' src/*opts.h</userinput>"
msgstr ""
"<userinput>sed -i 's/BUFSIZ/rw_base_size/' src/unshar.c &amp;&amp;\n"
"sed -i '/program_name/s/^/extern /' src/*opts.h</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genutils/sharutils.xml:82
#, xml-text
msgid ""
"Install <application>Sharutils</application> by running the following "
"commands:"
msgstr ""
"Instale <application>Sharutils</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genutils/sharutils.xml:86
#, no-wrap, xml-text
msgid ""
"<userinput>sed -i 's/IO_ftrylockfile/IO_EOF_SEEN/' lib/*.c        &amp;&amp;\n"
"echo \"#define _IO_IN_BACKUP 0x100\" >> lib/stdio-impl.h &amp;&amp;\n"
"\n"
"./configure --prefix=/usr &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>sed -i 's/IO_ftrylockfile/IO_EOF_SEEN/' lib/*.c       &amp;&amp;\n"
"echo \"#define _IO_IN_BACKUP 0x100\" >> lib/stdio-impl.h &amp;&amp;\n"
"\n"
"./configure --prefix=/usr &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genutils/sharutils.xml:93
#, xml-text
msgid "To test the results, issue <command>make check</command>."
msgstr "Para testar os resultados, emita: <command>make check</command>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genutils/sharutils.xml:97
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genutils/sharutils.xml:100
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

