#. type: Content of: <sect1><sect2><title>
#: blfs-en/kde/kuserfeedback.xml:79
#, xml-text
msgid "Installation of Kuserfeedback"
msgstr "Instalação do Kuserfeedback"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/kde/kuserfeedback.xml:82
#, xml-text
msgid ""
"Install <application>kuserfeedback</application> by running the following "
"commands:"
msgstr ""
"Instale o &quot;<application>kuserfeedback</application>&quot; executando os"
" seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/kde/kuserfeedback.xml:86
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -DCMAKE_INSTALL_PREFIX=/usr \\\n"
"      -DCMAKE_BUILD_TYPE=Release  \\\n"
"      -DBUILD_TESTING=OFF         \\\n"
"      -Wno-dev .. &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd     build &amp;&amp;\n"
"\n"
"cmake -DCMAKE_INSTALL_PREFIX=/usr \\\n"
"      -DCMAKE_BUILD_TYPE=Release  \\\n"
"      -DBUILD_TESTING=OFF         \\\n"
"      -Wno-dev .. &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/kde/kuserfeedback.xml:96
#, xml-text
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/kde/kuserfeedback.xml:100
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/kde/kuserfeedback.xml:103
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

