#: blfs-en/kde/kuserfeedback.xml:24
#, xml-text
msgid "Introduction to Kuserfeedback"
msgstr "Introdução ao Kuserfeedback"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/kde/kuserfeedback.xml:27
#, xml-text
msgid ""
"The <application>kuserfeedback</application> package contains a framework "
"for collecting user feedback for applications via telemetry and surveys."
msgstr ""
"O pacote &quot;<application>kuserfeedback</application>&quot; contém uma "
"estrutura essencial de suporte para coletar retroalimentação de usuário(a) a"
" respeito de aplicativos por meio de telemetria e pesquisas."

