#. type: Content of: <sect1><sect2><note><title>
#: blfs-en/kde/plasma5/plasma-all.xml:237
#, xml-text
msgid "About Commented Out Packages"
msgstr "Acerca de Pacotes Comentados"

#. type: Content of: <sect1><sect2><note><para>
#: blfs-en/kde/plasma5/plasma-all.xml:239
#, xml-text
msgid ""
"In the above list, several files are commented out with a hash (#) "
"character."
msgstr ""
"Na lista acima, vários arquivos estão comentados com um caractere cerquilha "
"(#)."

#. type: Content of: <sect1><sect2><note><para><itemizedlist><listitem><para>
#: blfs-en/kde/plasma5/plasma-all.xml:244
#, xml-text
msgid ""
"Two packages, bluedevil and plasma-workspace, have been replaced by a "
"6.0.5.1 version."
msgstr ""
"Dois pacotes, bluedevil e plasma-workspace, foram substituídos por uma "
"versão 6.0.5.1."

#. type: Content of: <sect1><sect2><note><para><itemizedlist><listitem><para>
#: blfs-en/kde/plasma5/plasma-all.xml:250
#, xml-text
msgid "The plasma-sdk package is optional and used for software development."
msgstr ""
"O pacote plasma-sdk é opcional e usado para desenvolvimento de software."

#. type: Content of: <sect1><sect2><note><para><itemizedlist><listitem><para>
#: blfs-en/kde/plasma5/plasma-all.xml:255
#, xml-text
msgid ""
"The discover package requires <xref linkend=\"appstream\"/> to be built with"
" the -D qt=true switch."
msgstr ""
"O pacote de descoberta exige que <xref linkend=\"appstream\"/> seja "
"construído com a chave -D qt=true."

#. type: Content of: <sect1><sect2><note><para><itemizedlist><listitem><para>
#: blfs-en/kde/plasma5/plasma-all.xml:261
#, xml-text
msgid ""
"The breeze-grub, breeze-plymouth, and plymouth-kcm packages above are all "
"for customized support of <ulink "
"url=\"https://www.freedesktop.org/wiki/Software/Plymouth/\"> "
"Plymouth</ulink> which is designed to be run within an initial ram disk "
"during boot (see <xref linkend=\"initramfs\"/>)."
msgstr ""
"Os pacotes breeze-grub, breeze-plymouth e plymouth-kcm acima são todos para "
"suporte personalizado do <ulink "
"url=\"https://www.freedesktop.org/wiki/Software/Plymouth/\"> "
"Plymouth</ulink>, que foi projetado para ser executado dentro de um disco "
"inicial RAM durante a inicialização (veja-se <xref linkend=\"initramfs\"/>)."

#. type: Content of: <sect1><sect2><note><para><itemizedlist><listitem><para>
#: blfs-en/kde/plasma5/plasma-all.xml:270
#, xml-text
msgid ""
"The plasma-browser-integration package is only used by plasma-meta which is "
"not installed by BLFS."
msgstr ""
"O pacote plasma-browser-integration é usado somente pelo plasma-meta, que "
"não é instalado pelo BLFS."

#. type: Content of: <sect1><sect2><note><para><itemizedlist><listitem><para>
#: blfs-en/kde/plasma5/plasma-all.xml:276
#, xml-text
msgid "The plasma-nano package is used for embedded systems."
msgstr "O pacote plasma-nano é usado para sistemas embarcados."

#. type: Content of: <sect1><sect2><note><para><itemizedlist><listitem><para>
#: blfs-en/kde/plasma5/plasma-all.xml:281
#, xml-text
msgid "The plasma-mobile package provides phone functionality for Plasma."
msgstr ""
"O pacote plasma-mobile fornece funcionalidade de telefone para Plasma."

#. type: Content of: <sect1><sect2><note><para><itemizedlist><listitem><para>
#: blfs-en/kde/plasma5/plasma-all.xml:286
#, xml-text
msgid ""
"The flatpack-kcm package is for managing support of flatpack applications."
msgstr ""
"O pacote flatpack-kcm é para suporte de gerenciamento de aplicativos "
"flatpack."

#. type: Content of: <sect1><sect2><note><para><itemizedlist><listitem><para>
#: blfs-en/kde/plasma5/plasma-all.xml:291
#, xml-text
msgid ""
"The wacomtablet and kwayland-integration applications require plasma5 "
"support."
msgstr ""
"Os aplicativos wacomtablet e kwayland-integration exigem suporte plasma5."

#. type: Content of: <sect1><sect2><title>
#: blfs-en/kde/plasma5/plasma-all.xml:302
#, xml-text
#| msgid "Installation of Plasma5"
msgid "Installation of Plasma"
msgstr "Instalação de Plasma"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/kde/plasma5/plasma-all.xml:307
#, xml-text
msgid "First, start a subshell that will exit on error:"
msgstr "Primeiro, inicie um sub shell que sairá em caso de erro:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/kde/plasma5/plasma-all.xml:310
#, no-wrap, xml-text
msgid "<userinput>bash -e</userinput>"
msgstr "<userinput>bash -e</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/kde/plasma5/plasma-all.xml:313
#, xml-text
msgid "Install all of the packages by running the following commands:"
msgstr "Instale todos os pacotes executando os seguintes comandos:"

#.        # Fix some build issues when generating some configuration files
#.        case $name in
#.          plasma-workspace)
#.            sed -i '/set.HAVE_X11/a set(X11_FOUND 1)' CMakeLists.txt
#.          ;;
#.          khotkeys)
#.            sed -i '/X11Extras/a set(X11_FOUND 1)' CMakeLists.txt
#.          ;;
#.          plasma-desktop)
#.            sed -i '/X11.h)/i set(X11_FOUND 1)' CMakeLists.txt
#.          ;;
#.        esac
#.  some packages end up with files owned by root in $packagedir,
#.      so use as_root for removing
#. type: Content of: <sect1><sect2><screen>
#: blfs-en/kde/plasma5/plasma-all.xml:317
#, no-wrap, xml-text
#| msgid ""
#| "<userinput>while read -r line; do\n"
#| "\n"
#| "    # Get the file name, ignoring comments and blank lines\n"
#| "    if $(echo $line | grep -E -q '^ *$|^#' ); then continue; fi\n"
#| "    file=$(echo $line | cut -d\" \" -f2)\n"
#| "\n"
#| "    pkg=$(echo $file|sed 's|^.*/||')          # Remove directory\n"
#| "    packagedir=$(echo $pkg|sed 's|\\.tar.*||') # Package directory\n"
#| "\n"
#| "    tar -xf $file\n"
#| "    pushd $packagedir\n"
#| "\n"
#| "       mkdir build\n"
#| "       cd    build\n"
#| "\n"
#| "       cmake -DCMAKE_INSTALL_PREFIX=$KF5_PREFIX \\\n"
#| "             -DCMAKE_BUILD_TYPE=Release         \\\n"
#| "             -DBUILD_TESTING=OFF                \\\n"
#| "             -Wno-dev ..  &amp;&amp;\n"
#| "\n"
#| "        make\n"
#| "        as_root make install\n"
#| "    popd\n"
#| "\n"
#| "\n"
#| "    as_root rm -rf $packagedir\n"
#| "    as_root /sbin/ldconfig\n"
#| "\n"
#| "done &lt; plasma-&plasma5-version;.md5\n"
#| "\n"
#| "exit</userinput>"
msgid ""
"<userinput>while read -r line; do\n"
"\n"
"    # Get the file name, ignoring comments and blank lines\n"
"    if $(echo $line | grep -E -q '^ *$|^#' ); then continue; fi\n"
"    file=$(echo $line | cut -d\" \" -f2)\n"
"\n"
"    pkg=$(echo $file|sed 's|^.*/||')          # Remove directory\n"
"    packagedir=$(echo $pkg|sed 's|\\.tar.*||') # Package directory\n"
"\n"
"    tar -xf $file\n"
"    pushd $packagedir\n"
"\n"
"       mkdir build\n"
"       cd    build\n"
"\n"
"       cmake -D CMAKE_INSTALL_PREFIX=$KF6_PREFIX \\\n"
"             -D CMAKE_INSTALL_LIBEXECDIR=libexec \\\n"
"             -D CMAKE_BUILD_TYPE=Release         \\\n"
"             -D BUILD_QT5=OFF                    \\\n"
"             -D BUILD_TESTING=OFF                \\\n"
"             -W no-dev ..  &amp;&amp;\n"
"\n"
"        make\n"
"        as_root make install\n"
"    popd\n"
"\n"
"\n"
"    as_root rm -rf $packagedir\n"
"    as_root /sbin/ldconfig\n"
"\n"
"done &lt; plasma-&plasma-version;.md5\n"
"\n"
"exit</userinput>"
msgstr ""
"<userinput>while read -r line; do\n"
"\n"
"    # Get the file name, ignoring comments and blank lines\n"
"    if $(echo $line | grep -E -q '^ *$|^#' ); then continue; fi\n"
"    file=$(echo $line | cut -d\" \" -f2)\n"
"\n"
"    pkg=$(echo $file|sed 's|^.*/||')          # Remove directory\n"
"    packagedir=$(echo $pkg|sed 's|\\.tar.*||') # Package directory\n"
"\n"
"    tar -xf $file\n"
"    pushd $packagedir\n"
"\n"
"       mkdir build\n"
"       cd    build\n"
"\n"
"       cmake -D CMAKE_INSTALL_PREFIX=$KF6_PREFIX \\\n"
"             -D CMAKE_INSTALL_LIBEXECDIR=libexec \\\n"
"             -D CMAKE_BUILD_TYPE=Release         \\\n"
"             -D BUILD_QT5=OFF                    \\\n"
"             -D BUILD_TESTING=OFF                \\\n"
"             -W no-dev ..  &amp;&amp;\n"
"\n"
"        make\n"
"        as_root make install\n"
"    popd\n"
"\n"
"\n"
"    as_root rm -rf $packagedir\n"
"    as_root /sbin/ldconfig\n"
"\n"
"done &lt; plasma-&plasma-version;.md5\n"
"\n"
"exit</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/kde/plasma5/plasma-all.xml:368
#, xml-text
msgid ""
"If you did not set <envar>$KF6_PREFIX</envar> to <filename>/usr</filename>, "
"create symlinks to allow display managers to find "
"<application>Plasma</application>, and to allow the XDG Desktop Portal to be"
" detected. As the &root; user:"
msgstr ""
"Se você não configurou <envar>$KF5_PREFIX</envar> como "
"<filename>/usr</filename>, crie links simbólicos para permitir que "
"gerenciadores de tela encontrem o <application>Plasma</application> e para "
"permitir que XDG Desktop Portal seja detectado. Como o(a) usuário(a) &root;:"

#.  work around a bug in xdg-desktop-portal
#. type: Content of: <sect1><sect2><screen>
#: blfs-en/kde/plasma5/plasma-all.xml:374
#, no-wrap, xml-text
#| msgid ""
#| "<userinput>as_root install -dvm 755 /usr/share/xsessions              &amp;&amp;\n"
#| "cd /usr/share/xsessions/                                   &amp;&amp;\n"
#| "[ -e plasma.desktop ]                                      ||\n"
#| "as_root ln -sfv $KF5_PREFIX/share/xsessions/plasma.desktop &amp;&amp;\n"
#| "as_root install -dvm 755 /usr/share/wayland-sessions       &amp;&amp;\n"
#| "cd /usr/share/wayland-sessions/                            &amp;&amp;\n"
#| "[ -e plasmawayland.desktop ]                               ||\n"
#| "as_root ln -sfv $KF5_PREFIX/share/wayland-sessions/plasmawayland.desktop\n"
#| "as_root install -dvm 755 /usr/share/xdg-desktop-portal     &amp;&amp;\n"
#| "cd /usr/share/xdg-desktop-portal/                          &amp;&amp;\n"
#| "[ -e kde-portals.conf ]                                    ||\n"
#| "as_root ln -sfv $KF5_PREFIX/share/xdg-desktop-portal/kde-portals.conf\n"
#| "as_root install -dvm 755 /usr/share/xdg-desktop-portal/portals &amp;&amp;\n"
#| "cd /usr/share/xdg-desktop-portal/portals                       &amp;&amp;\n"
#| "[ -e kde.portal ]                                              ||\n"
#| "as_root ln -sfv $KF5_PREFIX/share/xdg-desktop-portal/portals/kde.portal\n"
#| "</userinput>"
msgid ""
"<userinput># Setup xsessions (X11 sessions)\n"
"install -dvm 755 /usr/share/xsessions\n"
"cd /usr/share/xsessions\n"
"\n"
"[ -e plasma.desktop ] ||\n"
"ln -sfv $KF6_PREFIX/share/xsessions/plasmax11.desktop \n"
"\n"
"# Setup wayland-sessions \n"
"install -dvm 755 /usr/share/wayland-sessions\n"
"cd /usr/share/wayland-sessions\n"
"\n"
"[ -e plasmawayland.desktop ] ||\n"
"ln -sfv $KF6_PREFIX/share/wayland-sessions/plasma.desktop\n"
"\n"
"# Setup xdg-desktop-portal\n"
"install -dvm 755 /usr/share/xdg-desktop-portal\n"
"cd /usr/share/xdg-desktop-portal \n"
"\n"
"[ -e kde-portals.conf ] ||\n"
"ln -sfv $KF6_PREFIX/share/xdg-desktop-portal/kde-portals.conf\n"
"\n"
"# Setup kde portal\n"
"install -dvm 755 /usr/share/xdg-desktop-portal/portals\n"
"cd /usr/share/xdg-desktop-portal/portals\n"
"\n"
"[ -e kde.portal ] ||\n"
"ln -sfv $KF6_PREFIX/share/xdg-desktop-portal/portals/kde.portal</userinput>"
msgstr ""
"<userinput># Setup xsessions (X11 sessions)\n"
"install -dvm 755 /usr/share/xsessions\n"
"cd /usr/share/xsessions\n"
"\n"
"[ -e plasma.desktop ] ||\n"
"ln -sfv $KF6_PREFIX/share/xsessions/plasmax11.desktop \n"
"\n"
"# Setup wayland-sessions \n"
"install -dvm 755 /usr/share/wayland-sessions\n"
"cd /usr/share/wayland-sessions\n"
"\n"
"[ -e plasmawayland.desktop ] ||\n"
"ln -sfv $KF6_PREFIX/share/wayland-sessions/plasma.desktop\n"
"\n"
"# Setup xdg-desktop-portal\n"
"install -dvm 755 /usr/share/xdg-desktop-portal\n"
"cd /usr/share/xdg-desktop-portal \n"
"\n"
"[ -e kde-portals.conf ] ||\n"
"ln -sfv $KF6_PREFIX/share/xdg-desktop-portal/kde-portals.conf\n"
"\n"
"# Setup kde portal\n"
"install -dvm 755 /usr/share/xdg-desktop-portal/portals\n"
"cd /usr/share/xdg-desktop-portal/portals\n"
"\n"
"[ -e kde.portal ] ||\n"
"ln -sfv $KF6_PREFIX/share/xdg-desktop-portal/portals/kde.portal</userinput>"

