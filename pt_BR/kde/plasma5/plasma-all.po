#. type: Content of: <sect1><para>
#: blfs-en/kde/plasma5/plasma-all.xml:99
#, xml-text
msgid ""
"<xref linkend=\"gsettings-desktop-schemas\"/>, <xref "
"linkend=\"libcanberra\"/>, <xref linkend=\"libinput\"/>, <xref "
"linkend=\"libpcap\"/>, <xref linkend=\"linux-pam\"/>, <xref "
"linkend=\"lm_sensors\"/>, <xref linkend=\"oxygen-icons\"/>, <xref "
"linkend=\"pciutils\"/>, <xref linkend=\"power-profiles-daemon\"/>, and the "
"following Python modules: <xref linkend=\"psutil\"/>, <xref "
"linkend=\"pygdbmi\"/>, <xref linkend=\"sentry-sdk\"/>, <xref "
"linkend=\"urllib3\"/> (if they are not installed, they will be downloaded "
"and installed by the drkonqi build procedure)"
msgstr ""
"<xref linkend=\"gsettings-desktop-schemas\"/>, <xref "
"linkend=\"libcanberra\"/>, <xref linkend=\"libinput\"/>, <xref "
"linkend=\"libpcap\"/>, <xref linkend=\"linux-pam\"/>, <xref "
"linkend=\"lm_sensors\"/>, <xref linkend=\"oxygen-icons\"/>, <xref "
"linkend=\"pciutils\"/>, <xref linkend=\"power-profiles-daemon\"/> e os "
"seguintes módulos do Python: <xref linkend=\"psutil\"/>, <xref "
"linkend=\"pygdbmi\"/>, <xref linkend=\"sentry-sdk\"/>, <xref "
"linkend=\"urllib3\"/> (se eles não estiverem instalados, serão baixados e "
"instalados pelo procedimento de construção drkonqi)"

