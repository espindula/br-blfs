#: blfs-en/kde/kf6/kf6-frameworks.xml:312
#, no-wrap, xml-text
msgid ""
"<userinput>mv -v /opt/kf6 /opt/kf6.old                         &amp;&amp;\n"
"install -v -dm755           $KF6_PREFIX/{etc,share} &amp;&amp;\n"
"ln -sfv /etc/dbus-1         $KF6_PREFIX/etc         &amp;&amp;\n"
"ln -sfv /usr/share/dbus-1   $KF6_PREFIX/share       &amp;&amp;\n"
"ln -sfv /usr/share/polkit-1 $KF6_PREFIX/share</userinput>"
msgstr ""
"<userinput>mv -v /opt/kf6 /opt/kf6.old                         &amp;&amp;\n"
"install -v -dm755           $KF6_PREFIX/{etc,share} &amp;&amp;\n"
