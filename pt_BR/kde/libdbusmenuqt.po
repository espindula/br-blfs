#. type: Content of: <sect1><sect2><para>
#: blfs-en/kde/libdbusmenuqt.xml:29
#, xml-text
msgid ""
"This library provides a <application>Qt</application> implementation of the "
"DBusMenu specification that exposes menus via DBus."
msgstr ""
"Essa biblioteca fornece uma implementação "
"&quot;<application>Qt</application>&quot; da especificação "
"&quot;DBusMenu&quot; que expõe menus via &quot;DBus&quot;."

