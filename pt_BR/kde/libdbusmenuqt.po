#. type: Content of: <sect1><sect2><title>
#: blfs-en/kde/libdbusmenuqt.xml:86
#, xml-text
msgid "Installation of libdbusmenu-qt"
msgstr "Instalação do libdbusmenu-qt"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/kde/libdbusmenuqt.xml:89
#, xml-text
msgid ""
"Install <application>libdbusmenu-qt</application> by running the following "
"commands:"
msgstr ""
"Instale o &quot;<application>libdbusmenu-qt</application>&quot; executando "
"os seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/kde/libdbusmenuqt.xml:93
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -DCMAKE_INSTALL_PREFIX=/usr \\\n"
"      -DCMAKE_BUILD_TYPE=Release  \\\n"
"      -DWITH_DOC=OFF              \\\n"
"      -Wno-dev .. &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd     build &amp;&amp;\n"
"\n"
"cmake -DCMAKE_INSTALL_PREFIX=/usr \\\n"
"      -DCMAKE_BUILD_TYPE=Release  \\\n"
"      -DWITH_DOC=OFF              \\\n"
"      -Wno-dev .. &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/kde/libdbusmenuqt.xml:110
#, xml-text
msgid "This package does not come with a working test suite."
msgstr "Esse pacote não vem com uma suíte de teste funcional."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/kde/libdbusmenuqt.xml:114
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) &quot;<systemitem "
"class=\"username\">root</systemitem>&quot;:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/kde/libdbusmenuqt.xml:117
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/kde/libdbusmenuqt.xml:122
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/kde/libdbusmenuqt.xml:125
#, xml-text
msgid ""
"<parameter>-DCMAKE_BUILD_TYPE=Release</parameter>: This switch is used to "
"build without debugging symbols and apply a higher level of compiler "
"optimizations."
msgstr ""
"<parameter>-DCMAKE_BUILD_TYPE=Release</parameter>: Essa chave é usada para "
"construir sem símbolos de depuração e aplicar um nível mais alto de "
"otimizações do compilador."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/kde/libdbusmenuqt.xml:131
#, xml-text
msgid ""
"<parameter>-DWITH_DOC=OFF</parameter>: This option is set to avoid trying to"
" build the API documentation which requires obsolete Qt4."
msgstr ""
"<parameter>-DWITH_DOC=OFF</parameter>: Essa opção está configurada para "
"evitar tentar construir a documentação da &quot;API&quot;, a qual exige "
"&quot;Qt4&quot; obsoleta."

