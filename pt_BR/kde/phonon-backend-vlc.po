#. type: Content of: <sect1><sect2><title>
#: blfs-en/kde/phonon-backend-vlc.xml:81
#, xml-text
msgid "Installation of Phonon-backend-vlc"
msgstr "Instalação do Phonon-backend-vlc"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/kde/phonon-backend-vlc.xml:84
#, xml-text
msgid ""
"Install <application>Phonon-backend-vlc</application> by running the "
"following commands:"
msgstr ""
"Instale o &quot;<application>Phonon-backend-vlc</application>&quot; "
"executando os seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/kde/phonon-backend-vlc.xml:88
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr \\\n"
"      -D CMAKE_BUILD_TYPE=Release  \\\n"
"      -D PHONON_BUILD_QT5=OFF      \\\n"
"      .. &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr \\\n"
"      -D CMAKE_BUILD_TYPE=Release  \\\n"
"      -D PHONON_BUILD_QT5=OFF      \\\n"
"      .. &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/kde/phonon-backend-vlc.xml:98
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) &quot;<systemitem "
"class=\"username\">root</systemitem>&quot;:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/kde/phonon-backend-vlc.xml:101
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/kde/phonon-backend-vlc.xml:106
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/kde/phonon-backend-vlc.xml:109
#, xml-text
msgid ""
"<parameter>-D CMAKE_BUILD_TYPE=Release</parameter>: This switch is used to "
"apply higher level of compiler optimizations."
msgstr ""
"<parameter>-D CMAKE_BUILD_TYPE=Release</parameter>: Essa chave é usada para "
"aplicar um nível mais alto de otimização à compilação."

