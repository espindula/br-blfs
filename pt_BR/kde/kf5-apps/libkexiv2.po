#. type: Content of: <sect1><sect2><para>
#: blfs-en/kde/kf5-apps/libkexiv2.xml:29
#, xml-text
msgid ""
"<application>Libkexiv2</application> is a KDE wrapper around the Exiv2 "
"library for manipulating image metadata."
msgstr ""
"&quot;<application>Libkexiv2</application>&quot; é um invólucro do "
"&quot;KDE&quot; em torno da biblioteca &quot;Exiv2&quot; para manipular "
"metadados de imagens."

