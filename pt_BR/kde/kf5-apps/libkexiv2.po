#. type: Content of: <sect1><sect2><title>
#: blfs-en/kde/kf5-apps/libkexiv2.xml:80
#, xml-text
msgid "Installation of libkexiv2"
msgstr "Instalação do libkexiv2"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/kde/kf5-apps/libkexiv2.xml:83
#, xml-text
msgid ""
"Install <application>libkexiv2</application> by running the following "
"commands:"
msgstr ""
"Instale o &quot;<application>libkexiv2</application>&quot; executando os "
"seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/kde/kf5-apps/libkexiv2.xml:87
#, no-wrap, xml-text
#| msgid ""
#| "<userinput>mkdir build &amp;&amp;\n"
#| "cd    build &amp;&amp;\n"
#| "\n"
#| "cmake -DCMAKE_INSTALL_PREFIX=$KF5_PREFIX \\\n"
#| "      -DCMAKE_BUILD_TYPE=Release         \\\n"
#| "      -DBUILD_TESTING=OFF                \\\n"
#| "      -Wno-dev .. &amp;&amp;\n"
#| "make</userinput>"
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=$KF6_PREFIX \\\n"
"      -D CMAKE_BUILD_TYPE=Release         \\\n"
"      -D BUILD_WITH_QT6=ON                \\\n"
"      -D BUILD_TESTING=OFF                \\\n"
"      -W no-dev .. &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=$KF6_PREFIX \\\n"
"      -D CMAKE_BUILD_TYPE=Release         \\\n"
"      -D BUILD_WITH_QT6=ON                \\\n"
"      -D BUILD_TESTING=OFF                \\\n"
"      -W no-dev .. &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/kde/kf5-apps/libkexiv2.xml:98
#, xml-text
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/kde/kf5-apps/libkexiv2.xml:102
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) &quot;<systemitem "
"class=\"username\">root</systemitem>&quot;:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/kde/kf5-apps/libkexiv2.xml:105
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

