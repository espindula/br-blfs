#. type: Content of: <sect1><title>
#: blfs-en/kde/kf5-apps/add-pkgs.xml:8 blfs-en/kde/kf5-apps/add-pkgs.xml:12
#, xml-text
msgid "Further KDE5 packages"
msgstr "Outros pacotes do KDE5"

#. type: Content of: <sect1><para>
#: blfs-en/kde/kf5-apps/add-pkgs.xml:15
#, xml-text
msgid ""
"This section did not provide instructions for all of the available packages "
"in the KDE5 Software Compilation. The included packages were selected based "
"on what most people would want to use on a standard desktop computer."
msgstr ""
"Esta seção não fornece instruções para todos os pacotes disponíveis na "
"Compilação de Logiciário do &quot;KDE5&quot;. Os pacotes incluídos foram "
"selecionados com base no que a maioria das pessoas gostaria de usar em um "
"computador padrão de área de trabalho."

#. type: Content of: <sect1><para>
#: blfs-en/kde/kf5-apps/add-pkgs.xml:21
#, xml-text
msgid ""
"For a full list of available packages, have a look on the KDE5 servers at "
"<ulink url=\"&kf5apps-download-http;\">&kf5apps-download-http;</ulink>."
msgstr ""
"Para uma lista completa dos pacotes disponíveis, dê uma olhada nos "
"servidores do &quot;KDE5&quot; em <ulink url=\"&kf5apps-download-"
"http;\">&kf5apps-download-http;</ulink>."

#. type: Content of: <sect1><para>
#: blfs-en/kde/kf5-apps/add-pkgs.xml:26
#, xml-text
msgid "Editor Notes: <ulink url=\"&blfs-wiki;/Further_KDE_Packages\"/>"
msgstr ""
"Observações de Editor(a): <ulink url=\"&blfs-wiki;/Further_KDE_Packages\"/>"

#. type: Content of: <sect1><para>
#: blfs-en/kde/kf5-apps/add-pkgs.xml:30
#, xml-text
msgid "Some additional packages worth mentioning are:"
msgstr "Alguns pacotes adicionais que compensa mencionar são:"

#. type: Content of: <sect1><itemizedlist><listitem><para>
#: blfs-en/kde/kf5-apps/add-pkgs.xml:35
#, xml-text
msgid "Juk: A lightweight music player."
msgstr "&quot;Juk&quot;: Um reprodutor de música leve."

#. type: Content of: <sect1><itemizedlist><listitem><para>
#: blfs-en/kde/kf5-apps/add-pkgs.xml:38
#, xml-text
msgid "Dragon: A video player."
msgstr "&quot;Dragon&quot;: Um reprodutor de vídeo."

#. type: Content of: <sect1><itemizedlist><listitem><para>
#: blfs-en/kde/kf5-apps/add-pkgs.xml:41
#, xml-text
msgid "Kcalc: A scientific calculator."
msgstr "&quot;Kcalc&quot;: Uma calculadora científica."

#. type: Content of: <sect1><itemizedlist><listitem><para>
#: blfs-en/kde/kf5-apps/add-pkgs.xml:51
#, xml-text
msgid "Kwalletmanager: A credentials management application."
msgstr ""
"&quot;Kwalletmanager&quot;: Um aplicativo de gerenciamento de credenciais."

#. type: Content of: <sect1><itemizedlist><listitem><para>
#: blfs-en/kde/kf5-apps/add-pkgs.xml:54
#, xml-text
msgid "Marble: A global map program."
msgstr "&quot;Marble&quot;: Um aplicativo de mapas globais."

#. type: Content of: <sect1><itemizedlist><listitem><para>
#: blfs-en/kde/kf5-apps/add-pkgs.xml:58
#, xml-text
msgid ""
"A variety (about 40) of KDE games including: kpat, kfourinline, and kmines."
msgstr ""
"Uma variedade (cerca de quarenta (40)) de jogos do &quot;KDE&quot;, "
"incluindo: &quot;kpat&quot;, &quot;kfourinline&quot; e &quot;kmines&quot;."

#. type: Content of: <sect1><note><para>
#: blfs-en/kde/kf5-apps/add-pkgs.xml:66
#, xml-text
msgid ""
"Some packages will require additional dependencies.  To determine what "
"dependencies are needed, run from the top of the source tree:"
msgstr ""
"Alguns pacotes exigirão dependências adicionais. Para determinar quais "
"dependências são necessárias, execute a partir do topo da árvore do fonte:"

#. type: Content of: <sect1><note><screen>
#: blfs-en/kde/kf5-apps/add-pkgs.xml:70
#, no-wrap, xml-text
msgid "<userinput>cmake -Wno-dev -L .</userinput>"
msgstr "<userinput>cmake -Wno-dev -L .</userinput>"

#. type: Content of: <sect1><para>
#: blfs-en/kde/kf5-apps/add-pkgs.xml:75
#, xml-text
msgid ""
"Most of these packages can be built with the standard KDE5 instructions:"
msgstr ""
"A maioria desses pacotes pode ser construída com as instruções padrão do "
"&quot;KDE5&quot;:"

#. type: Content of: <sect1><screen>
#: blfs-en/kde/kf5-apps/add-pkgs.xml:78
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -DCMAKE_INSTALL_PREFIX=$KF5_PREFIX \\\n"
"      -DCMAKE_BUILD_TYPE=Release         \\\n"
"      -DBUILD_TESTING=OFF                \\\n"
"      -Wno-dev .. &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd     build &amp;&amp;\n"
"\n"
"cmake -DCMAKE_INSTALL_PREFIX=$KF5_PREFIX \\\n"
"      -DCMAKE_BUILD_TYPE=Release         \\\n"
"      -DBUILD_TESTING=OFF                \\\n"
"      -Wno-dev .. &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><para>
#: blfs-en/kde/kf5-apps/add-pkgs.xml:88
#, xml-text
msgid "And as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"E como o(a) usuário(a) &quot;<systemitem "
"class=\"username\">root</systemitem>&quot;:"

#. type: Content of: <sect1><screen>
#: blfs-en/kde/kf5-apps/add-pkgs.xml:91
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"
