#. type: Content of: <sect1><sect2><title>
#: blfs-en/kde/kf5-apps/kdenlive5.xml:96
#, xml-text
msgid "Installation of Kdenlive"
msgstr "Instalação do Kdenlive"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/kde/kf5-apps/kdenlive5.xml:105
#, xml-text
msgid ""
"Install <application>Kdenlive</application> by running the following "
"commands:"
msgstr ""
"Instale o &quot;<application>Kdenlive</application>&quot; executando os "
"seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/kde/kf5-apps/kdenlive5.xml:109
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -DCMAKE_INSTALL_PREFIX=$KF5_PREFIX \\\n"
"      -DCMAKE_BUILD_TYPE=Release         \\\n"
"      -DBUILD_TESTING=OFF                \\\n"
"      -Wno-dev .. &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd     build &amp;&amp;\n"
"\n"
"cmake -DCMAKE_INSTALL_PREFIX=$KF5_PREFIX \\\n"
"      -DCMAKE_BUILD_TYPE=Release         \\\n"
"      -DBUILD_TESTING=OFF                \\\n"
"      -Wno-dev .. &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/kde/kf5-apps/kdenlive5.xml:119
#, xml-text
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/kde/kf5-apps/kdenlive5.xml:123
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) &quot;<systemitem "
"class=\"username\">root</systemitem>&quot;:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/kde/kf5-apps/kdenlive5.xml:126
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

