#. type: Content of: <sect1><sect2><para>
#: blfs-en/kde/kf5-apps/libkdcraw.xml:29
#, xml-text
msgid ""
"<application>Libkdcraw</application> is a KDE wrapper around the <xref "
"linkend=\"libraw\"/> library for manipulating image metadata."
msgstr ""
"&quot;<application>Libkdcraw</application>&quot; é um invólucro do "
"&quot;KDE&quot; em torno da biblioteca &quot;<xref "
"linkend=\"libraw\"/>&quot; para manipular metadados de imagens."

