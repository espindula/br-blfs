#. type: Content of: <sect1><sect2><title>
#: blfs-en/kde/kf5-apps/k3b.xml:141
#, xml-text
msgid "Installation of K3b"
msgstr "Instalação do K3b"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/kde/kf5-apps/k3b.xml:144
#, xml-text
msgid ""
"Install <application>K3b</application> by running the following commands:"
msgstr ""
"Instale o &quot;<application>K3b</application>&quot; executando os seguintes"
" comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/kde/kf5-apps/k3b.xml:148
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -DCMAKE_INSTALL_PREFIX=$KF6_PREFIX \\\n"
"      -DCMAKE_BUILD_TYPE=Release         \\\n"
"      -DBUILD_TESTING=OFF                \\\n"
"      -Wno-dev ..                        &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -DCMAKE_INSTALL_PREFIX=$KF6_PREFIX \\\n"
"      -DCMAKE_BUILD_TYPE=Release         \\\n"
"      -DBUILD_TESTING=OFF                \\\n"
"      -Wno-dev ..                        &amp;&amp;\n"
"make</userinput>"

