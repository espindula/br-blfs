#. type: Content of: <sect1><sect2><title>
#: blfs-en/kde/phonon.xml:95
#, xml-text
msgid "Installation of Phonon"
msgstr "Instalação do Phonon"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/kde/phonon.xml:97
#, xml-text
msgid ""
"Install <application>Phonon</application> by running the following commands:"
msgstr ""
"Instale o &quot;<application>Phonon</application>&quot; executando os "
"seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/kde/phonon.xml:101
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr \\\n"
"      -D CMAKE_BUILD_TYPE=Release  \\\n"
"      -D PHONON_BUILD_QT5=OFF      \\\n"
"      -W no-dev .. &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr \\\n"
"      -D CMAKE_BUILD_TYPE=Release  \\\n"
"      -D PHONON_BUILD_QT5=OFF      \\\n"
"      -W no-dev .. &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/kde/phonon.xml:111
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) &quot;<systemitem "
"class=\"username\">root</systemitem>&quot;:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/kde/phonon.xml:114
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/kde/phonon.xml:119
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/kde/phonon.xml:122
#, xml-text
msgid ""
"<parameter>-D CMAKE_BUILD_TYPE=Release</parameter>: This switch is used to "
"apply higher level of the compiler optimizations."
msgstr ""
"<parameter>-D CMAKE_BUILD_TYPE=Release</parameter>: Essa chave é usada para "
"aplicar um nível mais alto de otimização à compilação."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/kde/phonon.xml:127
#, xml-text
msgid ""
"<parameter>-D PHONON_BUILD_QT5=OFF</parameter>: By default both the Qt5 and "
"Qt6 versions of this package are built.  We currently just want the Qt6 "
"version, since nothing in BLFS uses the Qt5 version."
msgstr ""
"<parameter>-D PHONON_BUILD_QT5=OFF</parameter>: Por padrão, ambas as versões"
" de Qt5 e Qt6 desse pacote são construídas. Atualmente nós queremos apenas a"
" versão Qt6, já que nada no BLFS usa a versão Qt5."

