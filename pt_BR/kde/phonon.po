#. type: Content of: <sect1><sect2><title>
#: blfs-en/kde/phonon.xml:26
#, xml-text
msgid "Introduction to Phonon"
msgstr "Introdução ao Phonon"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/kde/phonon.xml:29
#, xml-text
msgid ""
"<application>Phonon</application> is the multimedia API for KDE.  It "
"replaces the old <application>aRts</application> package.  Phonon needs the "
"VLC backend."
msgstr ""
"<application>Phonon</application> é a API multimídia do KDE. Ela substitui o"
" antigo pacote <application>aRts</application>. Phonon precisa da estrutura "
"de retaguarda VLC."

