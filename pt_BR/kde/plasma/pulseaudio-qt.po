#. type: Content of: <sect1><sect2><title>
#: blfs-en/kde/plasma/pulseaudio-qt.xml:80
#, xml-text
msgid "Installation of pulseaudio-qt"
msgstr "Instalação do pulseaudio-qt"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/kde/plasma/pulseaudio-qt.xml:83
#, xml-text
msgid ""
"Install <application>pulseaudio-qt</application> by running the following "
"commands:"
msgstr ""
"Instale <application>pulseaudio-qt</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/kde/plasma/pulseaudio-qt.xml:87
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=$KF6_PREFIX \\\n"
"      -D CMAKE_PREFIX_PATH=$QT6DIR        \\\n"
"      -D CMAKE_SKIP_INSTALL_RPATH=ON      \\\n"
"      -D CMAKE_BUILD_TYPE=Release         \\\n"
"      -D BUILD_TESTING=OFF                \\\n"
"      -D QT_MAJOR_VERSION=6               \\\n"
"      .. &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=$KF6_PREFIX \\\n"
"      -D CMAKE_PREFIX_PATH=$QT6DIR        \\\n"
"      -D CMAKE_SKIP_INSTALL_RPATH=ON      \\\n"
"      -D CMAKE_BUILD_TYPE=Release         \\\n"
"      -D BUILD_TESTING=OFF                \\\n"
"      -D QT_MAJOR_VERSION=6               \\\n"
"      .. &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/kde/plasma/pulseaudio-qt.xml:100
#, xml-text
msgid "Now as the &root; user:"
msgstr "Agora como o(a) usuário(a) &root;:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/kde/plasma/pulseaudio-qt.xml:103
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

