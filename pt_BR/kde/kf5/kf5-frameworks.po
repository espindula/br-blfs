#. type: Content of: <sect1><sect2><para>
#: blfs-en/kde/kf5/kf5-frameworks.xml:347
#, xml-text
msgid "Install all of the packages by running the following commands:"
msgstr "Instale todos os pacotes executando os seguintes comandos:"

#.  some packages end with files owned by root in $packagedir, so use as_root
#.      in the following
#. type: Content of: <sect1><sect2><screen>
#: blfs-en/kde/kf5/kf5-frameworks.xml:351
#, no-wrap, xml-text
msgid ""
"<userinput>while read -r line; do\n"
"\n"
"    # Get the file name, ignoring comments and blank lines\n"
"    if $(echo $line | grep -E -q '^ *$|^#' ); then continue; fi\n"
"    file=$(echo $line | cut -d\" \" -f2)\n"
"\n"
"    pkg=$(echo $file|sed 's|^.*/||')          # Remove directory\n"
"    packagedir=$(echo $pkg|sed 's|\\.tar.*||') # Package directory\n"
"\n"
"    name=$(echo $pkg|sed 's|-5.*$||') # Isolate package name\n"
"\n"
"    tar -xf $file\n"
"    pushd $packagedir\n"
"\n"
"      # kapidox is a python module\n"
"      case $name in\n"
"        kapidox)\n"
"          &build-wheel-cmd; $PWD\n"
"          as_root &install-wheel; kapidox\n"
"          popd\n"
"          rm -rf $packagedir\n"
"          continue\n"
"          ;;\n"
"      esac\n"
"\n"
"      mkdir build\n"
"      cd    build\n"
"\n"
"      cmake -DCMAKE_INSTALL_PREFIX=$KF5_PREFIX \\\n"
"            -DCMAKE_PREFIX_PATH=$QT5DIR        \\\n"
"            -DCMAKE_BUILD_TYPE=Release         \\\n"
"            -DBUILD_TESTING=OFF                \\\n"
"            -Wno-dev ..\n"
"      make\n"
"      as_root make install\n"
"    popd\n"
"\n"
"  as_root rm -rf $packagedir\n"
"  as_root /sbin/ldconfig\n"
"\n"
"done &lt; frameworks-&kf5-version;.md5\n"
"\n"
"exit</userinput>"
msgstr ""
"<userinput>while read -r line; do\n"
"\n"
"    # Obtenha o nome do arquivo, ignorando comentários e linhas em branco\n"
"    if $(echo $line | grep -E -q '^ *$|^#' ); then continue; fi\n"
"    file=$(echo $line | cut -d\" \" -f2)\n"
"\n"
"    pkg=$(echo $file|sed 's|^.*/||')          # Remove diretório\n"
"    packagedir=$(echo $pkg|sed 's|\\.tar.*||') # Diretório de pacote\n"
"\n"
"    name=$(echo $pkg|sed 's|-5.*$||') # Isolar o nome do pacote\n"
"\n"
"    tar -xf $file\n"
"    pushd $packagedir\n"
"\n"
"      # kapidox é um módulo python\n"
"      case $name in\n"
"        kapidox)\n"
"          &build-wheel-cmd; $PWD\n"
"          as_root &install-wheel; kapidox\n"
"          popd\n"
"          rm -rf $packagedir\n"
"          continue\n"
"          ;;\n"
"      esac\n"
"\n"
"      mkdir build\n"
"      cd    build\n"
"\n"
"      cmake -DCMAKE_INSTALL_PREFIX=$KF5_PREFIX \\\n"
"            -DCMAKE_PREFIX_PATH=$QT5DIR        \\\n"
"            -DCMAKE_BUILD_TYPE=Release         \\\n"
"            -DBUILD_TESTING=OFF                \\\n"
"            -Wno-dev ..\n"
"      make\n"
"      as_root make install\n"
"    popd\n"
"\n"
"  as_root rm -rf $packagedir\n"
"  as_root /sbin/ldconfig\n"
"\n"
"done &lt; frameworks-&kf5-version;.md5\n"
"\n"
"exit</userinput>"

#. type: Content of: <sect1><sect2><note><para>
#: blfs-en/kde/kf5/kf5-frameworks.xml:398
#, xml-text
msgid ""
"Any modules that have been omitted can be installed later by using the same "
"<command>mkdir build; cd build; cmake; make; make install</command> "
"procedure as above."
msgstr ""
"Quaisquer módulos que tenham sido omitidos podem ser instalados "
"posteriormente usando-se o mesmo procedimento <command>mkdir build; cd "
"build; cmake; make; make install</command> conforme acima."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/kde/kf5/kf5-frameworks.xml:405
#, xml-text
msgid ""
"Useless systemd units have been installed in <filename "
"class=\"directory\">$KF5_PREFIX/lib</filename>. Remove them now (as &root;):"
msgstr ""
"Unidades inúteis do &quot;systemd&quot; foram instaladas em &quot;<filename "
"class=\"directory\">$KF5_PREFIX/lib</filename>&quot;. Remova-as agora (como "
"&quot;&root;&quot;):"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/kde/kf5/kf5-frameworks.xml:411
#, no-wrap, xml-text
msgid "<userinput>rm -rf $KF5_PREFIX/lib/systemd</userinput>"
msgstr "<userinput>rm -rf $KF5_PREFIX/lib/systemd</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/kde/kf5/kf5-frameworks.xml:414
#, xml-text
msgid ""
"Sometimes the installation paths are hardcoded into installed files.  If the"
" installed directory is not /usr, rename the directory and create a symlink:"
msgstr ""
"Ocasionalmente, os caminhos de instalação estão rigidamente codificados nos "
"arquivos instalados. Se o diretório instalado não for /usr, renomeie o "
"diretório e crie um link simbólico:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/kde/kf5/kf5-frameworks.xml:419
#, no-wrap, xml-text
msgid ""
"<userinput>mv -v /opt/kf5 /opt/kf5-&kf5-version;\n"
"ln -sfvn kf5-&kf5-version; /opt/kf5</userinput>"
msgstr ""
"<userinput>mv -v /opt/kf5 /opt/kf5-&kf5-version;\n"
"ln -sfvn kf5-&kf5-version; /opt/kf5</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/kde/kf5/kf5-frameworks.xml:425
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/kde/kf5/kf5-frameworks.xml:428
#, xml-text
msgid ""
"<parameter>-DCMAKE_PREFIX_PATH=$QT5DIR</parameter>: This switch is used to "
"allow cmake to find the proper Qt libraries."
msgstr ""
"<parameter>-DCMAKE_PREFIX_PATH=$QT5DIR</parameter>: Essa chave é usada para "
"permitir que o &quot;cmake&quot; encontre as bibliotecas &quot;Qt&quot; "
"adequadas."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/kde/kf5/kf5-frameworks.xml:433
#, xml-text
msgid ""
"<parameter>-DCMAKE_BUILD_TYPE=Release</parameter>: This switch is used to "
"apply higher level of the compiler optimizations."
msgstr ""
"<parameter>-DCMAKE_BUILD_TYPE=Release</parameter>: Essa chave é usada para "
"aplicar nível mais alto das otimizações de compilador."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/kde/kf5/kf5-frameworks.xml:438
#, xml-text
msgid ""
"<parameter>-DBUILD_TESTING=OFF</parameter>: This switch is used to prevent "
"building test programs and libraries that are of no use to an end user."
msgstr ""
"<parameter>-DBUILD_TESTING=OFF</parameter>: Essa chave é usada para evitar "
"construir aplicativos de teste e bibliotecas que não são de uso para um(a) "
"usuário(a) final."

