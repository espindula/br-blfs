#. type: Content of: <sect1><sect2><title>
#: blfs-en/kde/polkit-qt.xml:81
#, xml-text
msgid "Installation of Polkit-Qt"
msgstr "Instalação do Polkit-Qt"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/kde/polkit-qt.xml:84
#, xml-text
msgid ""
"Install <application>Polkit-Qt</application> by running the following "
"commands:"
msgstr ""
"Instale o &quot;<application>Polkit-Qt</application>&quot; executando os "
"seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/kde/polkit-qt.xml:88
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -DCMAKE_INSTALL_PREFIX=/usr \\\n"
"      -DCMAKE_BUILD_TYPE=Release  \\\n"
"      -DQT_MAJOR_VERSION=6        \\\n"
"      -Wno-dev .. &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -DCMAKE_INSTALL_PREFIX=/usr \\\n"
"      -DCMAKE_BUILD_TYPE=Release  \\\n"
"      -DQT_MAJOR_VERSION=6        \\\n"
"      -Wno-dev .. &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/kde/polkit-qt.xml:98
#, xml-text
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/kde/polkit-qt.xml:102
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) &quot;<systemitem "
"class=\"username\">root</systemitem>&quot;:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/kde/polkit-qt.xml:105
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/kde/polkit-qt.xml:110
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/kde/polkit-qt.xml:113
#, xml-text
msgid ""
"<parameter>-DCMAKE_BUILD_TYPE=Release</parameter>: This switch is used to "
"apply higher level of the compiler optimizations."
msgstr ""
"<parameter>-DCMAKE_BUILD_TYPE=Release</parameter>: Essa chave é usada para "
"aplicar nível mais alto das otimizações de compilador."

