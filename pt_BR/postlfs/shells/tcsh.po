msgstr "Instalação do Tcsh"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/postlfs/shells/tcsh.xml:79
#, xml-text
msgid ""
"Install <application>Tcsh</application> by running the following commands:"
msgstr ""
"Instale <application>Tcsh</application> executando os seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/postlfs/shells/tcsh.xml:83
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>./configure --prefix=/usr &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/postlfs/shells/tcsh.xml:87
#, xml-text
msgid "To test the results, issue: <command>make check</command>."
msgstr "Para testar os resultados, emita: <command>make check</command>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/postlfs/shells/tcsh.xml:91
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/postlfs/shells/tcsh.xml:94
#, no-wrap, xml-text
msgid ""
"<userinput>make install install.man &amp;&amp;\n"
"\n"
"ln -v -sf tcsh   /bin/csh &amp;&amp;\n"
"ln -v -sf tcsh.1 /usr/share/man/man1/csh.1</userinput>"
msgstr ""
"<userinput>make install install.man &amp;&amp;\n"
"\n"
"ln -v -sf tcsh  /bin/csh &amp;&amp;\n"
"ln -v -sf tcsh.1 /usr/share/man/man1/csh.1</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/postlfs/shells/tcsh.xml:106
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/postlfs/shells/tcsh.xml:115
#, xml-text
msgid ""
"<command>ln -v -sf tcsh /bin/csh</command>: The FHS states that if there is "
"a <application>C</application> shell installed, there should be a symlink "
"from <filename>/bin/csh</filename> to it. This creates that symlink."
msgstr ""
"<command>ln -v -sf tcsh /bin/csh</command>: O FHS afirma que, se existir um "
"shell <application>C</application> instalado, [então] deveria existir um "
"link simbólico a partir de <filename>/bin/csh</filename> para ele. Isso cria"
" esse link simbólico."

