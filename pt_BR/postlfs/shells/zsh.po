#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/postlfs/shells/zsh.xml:285
#, xml-text
msgid ""
"Update <filename>/etc/shells</filename> to include the "
"<application>zsh</application> shell program names (as the <systemitem "
"class=\"username\">root</systemitem> user):"
msgstr ""
"Atualize <filename>/etc/shells</filename> para incluir os nomes do "
"aplicativo de shell <application>zsh</application> (como o(a) usuário(a) "
"<systemitem class=\"username\">root</systemitem>):"

#. type: Content of: <sect1><sect2><sect3><screen>
#: blfs-en/postlfs/shells/zsh.xml:290
#, no-wrap, xml-text
msgid ""
"<userinput>cat &gt;&gt; /etc/shells &lt;&lt; \"EOF\"\n"
"<literal>/bin/zsh</literal>\n"
"EOF</userinput>"
msgstr ""
"<userinput>cat &gt;&gt; /etc/shells &lt;&lt; \"EOF\"\n"
"<literal>/bin/zsh</literal>\n"
"EOF</userinput>"

