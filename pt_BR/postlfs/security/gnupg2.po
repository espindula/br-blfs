#. type: Content of: <sect1><sect2><title>
#: blfs-en/postlfs/security/gnupg2.xml:125
#, xml-text
msgid "Installation of GnuPG"
msgstr "Instalação do GnuPG"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/postlfs/security/gnupg2.xml:136
#, xml-text
msgid ""
"Install <application>GnuPG</application> by running the following commands:"
msgstr ""
"Instale <application>GnuPG</application> executando os seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/postlfs/security/gnupg2.xml:140
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"../configure --prefix=/usr           \\\n"
"             --localstatedir=/var    \\\n"
"             --sysconfdir=/etc       \\\n"
"             --docdir=/usr/share/doc/gnupg-&gnupg2-version; &amp;&amp;\n"
"make &amp;&amp;\n"
"\n"
"makeinfo --html --no-split -I doc -o doc/gnupg_nochunks.html ../doc/gnupg.texi &amp;&amp;\n"
"makeinfo --plaintext       -I doc -o doc/gnupg.txt           ../doc/gnupg.texi &amp;&amp;\n"
"make -C doc html</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"../configure --prefix=/usr          \\\n"
"             --localstatedir=/var    \\\n"
"             --sysconfdir=/etc       \\\n"
"             --docdir=/usr/share/doc/gnupg-&gnupg2-version; &amp;&amp;\n"
"make &amp;&amp;\n"
"\n"
"makeinfo --html --no-split -I doc -o doc/gnupg_nochunks.html ../doc/gnupg.texi &amp;&amp;\n"
"makeinfo --plaintext       -I doc -o doc/gnupg.txt           ../doc/gnupg.texi &amp;&amp;\n"
"make -C doc html</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/postlfs/security/gnupg2.xml:154
#, xml-text
msgid ""
"If you have <xref linkend=\"texlive\"/> installed and you wish to create "
"documentation in the pdf format, issue the following command:"
msgstr ""
"Se tiver o <xref linkend=\"texlive\"/> instalado e você desejar criar "
"documentação no formato PDF, emita o seguinte comando:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/postlfs/security/gnupg2.xml:159
#, no-wrap, xml-text
msgid "<userinput>make -C doc pdf</userinput>"
msgstr "<userinput>make -C doc pdf</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/postlfs/security/gnupg2.xml:162
#, xml-text
msgid "To test the results, issue: <command>make check</command>."
msgstr "Para testar os resultados, emita: <command>make check</command>."

#.       Note that if you have already installed
#.       <application>
#. GnuPG</application>, the instructions below will overwrite
#.       <filename>/usr/share/man/man1/gpg-zip.1</filename>.
#. type: Content of: <sect1><sect2><para>
#: blfs-en/postlfs/security/gnupg2.xml:171
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/postlfs/security/gnupg2.xml:174
#, no-wrap, xml-text
msgid ""
"<userinput>make install &amp;&amp;\n"
"\n"
"install -v -m755 -d /usr/share/doc/gnupg-&gnupg2-version;/html            &amp;&amp;\n"
"install -v -m644    doc/gnupg_nochunks.html \\\n"
"                    /usr/share/doc/gnupg-&gnupg2-version;/html/gnupg.html &amp;&amp;\n"
"install -v -m644    ../doc/*.texi doc/gnupg.txt \\\n"
"                    /usr/share/doc/gnupg-&gnupg2-version; &amp;&amp;\n"
"install -v -m644    doc/gnupg.html/* \\\n"
"                    /usr/share/doc/gnupg-&gnupg2-version;/html</userinput>"
msgstr ""
"<userinput>make install &amp;&amp;\n"
"\n"
"install -v -m755 -d /usr/share/doc/gnupg-&gnupg2-version;/html           &amp;&amp;\n"
"install -v -m644    doc/gnupg_nochunks.html \\\n"
"                    /usr/share/doc/gnupg-&gnupg2-version;/html/gnupg.html &amp;&amp;\n"
"install -v -m644    ../doc/*.texi doc/gnupg.txt \\\n"
"                    /usr/share/doc/gnupg-&gnupg2-version; &amp;&amp;\n"
"install -v -m644    doc/gnupg.html/* \\\n"
"                    /usr/share/doc/gnupg-&gnupg2-version;/html</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/postlfs/security/gnupg2.xml:184
#, xml-text
msgid ""
"If you created the pdf format of the documentation, install them using the "
"following command as the <systemitem class=\"username\">root</systemitem> "
"user:"
msgstr ""
"Se você criou o formato PDF da documentação, instale-os usando o seguinte "
"comando como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/postlfs/security/gnupg2.xml:190
#, no-wrap, xml-text
msgid ""
"<userinput>install -v -m644 doc/gnupg.pdf \\\n"
"                 /usr/share/doc/gnupg-&gnupg2-version;</userinput>"
msgstr ""
"<userinput>install -v -m644 doc/gnupg.pdf \\\n"
"                 /usr/share/doc/gnupg-&gnupg2-version;</userinput>"

