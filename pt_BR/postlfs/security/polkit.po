#. type: Content of: <sect1><sect2><title>
#: blfs-en/postlfs/security/polkit.xml:26
#, xml-text
msgid "Introduction to Polkit"
msgstr "Introdução ao Polkit"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/postlfs/security/polkit.xml:29
#, xml-text
msgid ""
"<application>Polkit</application> is a toolkit for defining and handling "
"authorizations. It is used for allowing unprivileged processes to "
"communicate with privileged processes."
msgstr ""
"<application>Polkit</application> é um kit de ferramentas para definir e "
"para manusear autorizações. Ele é usado para permitir que processos não "
"privilegiados se comuniquem com processos privilegiados."

