#. type: Content of: <sect1><sect2><title>
#: blfs-en/postlfs/security/sudo.xml:26
#, xml-text
msgid "Introduction to Sudo"
msgstr "Introdução ao Sudo"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/postlfs/security/sudo.xml:29
#, xml-text
msgid ""
"The <application>Sudo</application> package allows a system administrator to"
" give certain users (or groups of users) the ability to run some (or all) "
"commands as <systemitem class=\"username\">root</systemitem> or another user"
" while logging the commands and arguments."
msgstr ""
"O pacote <application>Sudo</application> permite que um(a) administrador(a) "
"do sistema dê a certos(as) usuários(as) (ou a grupos de usuários(as)) a "
"capacidade de executar alguns (ou todos) comandos como <systemitem "
"class=\"username\">root</systemitem> ou outro usuário(a) enquanto registra "
"os comandos e argumentos."

