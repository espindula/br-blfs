#. type: Content of: <sect1><sect2><title>
#: blfs-en/postlfs/security/liboauth.xml:98
#, xml-text
msgid "Installation of liboauth"
msgstr "Instalação do liboauth"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/postlfs/security/liboauth.xml:101
#, xml-text
msgid "Apply a patch for the current version of openssl:"
msgstr "Aplique um remendo para a versão atual do OpenSSL:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/postlfs/security/liboauth.xml:104
#, no-wrap, xml-text
msgid ""
"<userinput>patch -Np1 -i ../liboauth-&liboauth-"
"version;-openssl-1.1.0-3.patch</userinput>"
msgstr ""
"<userinput>patch -Np1 -i ../liboauth-&liboauth-"
"version;-openssl-1.1.0-3.patch</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/postlfs/security/liboauth.xml:107
#, xml-text
msgid ""
"Install <application>liboauth</application> by running the following "
"commands:"
msgstr ""
"Instale <application>liboauth</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/postlfs/security/liboauth.xml:111
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr --disable-static &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>./configure --prefix=/usr --disable-static &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/postlfs/security/liboauth.xml:115
#, xml-text
msgid ""
"If you wish to build the documentation (needs <xref linkend=\"doxygen\"/>), "
"issue:"
msgstr ""
"Se você deseja construir a documentação (precisa do <xref "
"linkend=\"doxygen\"/>), emita:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/postlfs/security/liboauth.xml:119
#, no-wrap, xml-text
msgid "<userinput>make dox</userinput>"
msgstr "<userinput>make dox</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/postlfs/security/liboauth.xml:122
#, xml-text
msgid "To test the results, issue: <command>make check</command>."
msgstr "Para testar os resultados, emita: <command>make check</command>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/postlfs/security/liboauth.xml:126
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/postlfs/security/liboauth.xml:129
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/postlfs/security/liboauth.xml:132
#, xml-text
msgid ""
"If you have previously built the documentation, install it by running the "
"following commands as the <systemitem class=\"username\">root</systemitem> "
"user:"
msgstr ""
"Se você previamente já tiver criado a documentação, [então] instale-a "
"executando os seguintes comandos como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/postlfs/security/liboauth.xml:138
#, no-wrap, xml-text
msgid ""
"<userinput>install -v -dm755 /usr/share/doc/liboauth-&liboauth-version; &amp;&amp;\n"
"cp -rv doc/html/* /usr/share/doc/liboauth-&liboauth-version;</userinput>"
msgstr ""
"<userinput>install -v -dm755 /usr/share/doc/liboauth-&liboauth-version; &amp;&amp;\n"
"cp -rv doc/html/* /usr/share/doc/liboauth-&liboauth-version;</userinput>"

