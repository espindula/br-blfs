msgstr "Instalação do libpwquality"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/postlfs/security/libpwquality.xml:88
#, xml-text
msgid ""
"Install <application>libpwquality</application> by running the following "
"commands:"
msgstr ""
"Instale <application>libpwquality</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/postlfs/security/libpwquality.xml:92
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr                      \\\n"
"            --disable-static                   \\\n"
"            --with-securedir=/usr/lib/security \\\n"
"            --disable-python-bindings          &amp;&amp;\n"
"make &amp;&amp;\n"
"&build-wheel-cmd; $PWD/python</userinput>"
msgstr ""
"<userinput>./configure --prefix=/usr                      \\\n"
"            --disable-static                   \\\n"
"            --with-securedir=/usr/lib/security \\\n"
"            --disable-python-bindings          &amp;&amp;\n"
"make &amp;&amp;\n"
"&build-wheel-cmd; $PWD/python</userinput>"

