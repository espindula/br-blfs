#. type: Content of: <sect1><sect2><title>
#: blfs-en/postlfs/filesystems/xfsprogs.xml:102
#, xml-text
msgid "Installation of xfsprogs"
msgstr "Instalação do xfsprogs"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/postlfs/filesystems/xfsprogs.xml:113
#, xml-text
msgid ""
"Install <application>xfsprogs</application> by running the following "
"commands:"
msgstr ""
"Instale <application>xfsprogs</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/postlfs/filesystems/xfsprogs.xml:117
#, no-wrap, xml-text
msgid ""
"<userinput>make DEBUG=-DNDEBUG     \\\n"
"     INSTALL_USER=root  \\\n"
"     INSTALL_GROUP=root</userinput>"
msgstr ""
"<userinput>make DEBUG=-DNDEBUG    \\\n"
"     INSTALL_USER=root  \\\n"
"     INSTALL_GROUP=root</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/postlfs/filesystems/xfsprogs.xml:122
#, xml-text
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/postlfs/filesystems/xfsprogs.xml:126
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/postlfs/filesystems/xfsprogs.xml:129
#, no-wrap, xml-text
msgid ""
"<userinput>make PKG_DOC_DIR=/usr/share/doc/xfsprogs-&xfsprogs-version; install     &amp;&amp;\n"
"make PKG_DOC_DIR=/usr/share/doc/xfsprogs-&xfsprogs-version; install-dev &amp;&amp;\n"
"\n"
"rm -rfv /usr/lib/libhandle.{a,la}</userinput>"
msgstr ""
"<userinput>make PKG_DOC_DIR=/usr/share/doc/xfsprogs-&xfsprogs-version; install    &amp;&amp;\n"
"make PKG_DOC_DIR=/usr/share/doc/xfsprogs-&xfsprogs-version; install-dev &amp;&amp;\n"
"\n"
"rm -rfv /usr/lib/libhandle.{a,la}</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/postlfs/filesystems/xfsprogs.xml:137
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/postlfs/filesystems/xfsprogs.xml:140
#, xml-text
msgid "<parameter>DEBUG=-DNDEBUG</parameter>: Turns off debugging symbols."
msgstr ""
"<parameter>DEBUG=-DNDEBUG</parameter>: Desliga os símbolos de depuração."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/postlfs/filesystems/xfsprogs.xml:145
#, xml-text
msgid ""
"<parameter>INSTALL_USER=root</parameter> "
"<parameter>INSTALL_GROUP=root</parameter>: This sets the owner and group of "
"the installed files."
msgstr ""
"<parameter>INSTALL_USER=root</parameter> "
"<parameter>INSTALL_GROUP=root</parameter>: Isso configura o(a) "
"proprietário(a) e o grupo dos arquivos instalados."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/postlfs/filesystems/xfsprogs.xml:151
#, xml-text
msgid ""
"<option>OPTIMIZER=\"...\"</option>: Adding this parameter to the end of the "
"<command>make</command> command overrides the default optimization settings."
msgstr ""
"<option>OPTIMIZER=\"...\"</option>: Adicionar esse parâmetro ao final do "
"comando <command>make</command> substitui as configurações padrão de "
"otimização."

