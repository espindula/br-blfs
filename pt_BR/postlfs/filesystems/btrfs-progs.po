#, no-wrap, xml-text
#~ msgid ""
#~ "<userinput>pushd tests\n"
#~ "   ./fsck-tests.sh\n"
#~ "   ./mkfs-tests.sh\n"
#~ "   ./cli-tests.sh\n"
