#: blfs-en/postlfs/filesystems/uefi-bootloaders/grub-efi.xml:254
#, xml-text
msgid "See the page for GRUB in LFS book."
msgstr "Veja-se a página para o GRUB no livro LFS."

#, xml-text
#~ msgid "cf0fd928b1e5479c8108ee52cb114363"
#~ msgstr "cf0fd928b1e5479c8108ee52cb114363"

#, xml-text
#~ msgid "94ff8cb4d5674cd2f38b00cede5e06d5"
#~ msgstr "94ff8cb4d5674cd2f38b00cede5e06d5"

#, xml-text
#~ msgid ""
#~ "Required patch: <ulink url=\"&patch-root;/grub-&grub-"
#~ "version;-upstream_fixes-1.patch\"/>"
#~ msgstr ""
#~ "Remendo exigido: <ulink url=\"&patch-root;/grub-&grub-"
#~ "version;-upstream_fixes-1.patch\"/>"

#, xml-text
#~ msgid ""
#~ "Fix an issue causing <command>grub-install</command> to fail when the "
#~ "<filename class='directory'>/boot</filename> partition (or the root "
#~ "partition if <filename class='directory'>/boot</filename> is not a separate "
#~ "partition) is created by e2fsprogs-1.47.0 or later:"
#~ msgstr ""
#~ "Corrija um problema que faz com que <command>grub-install</command> falhe "
#~ "quando a partição <filename class='directory'>/boot</filename> (ou a "
#~ "partição raiz, se <filename class='directory'>/boot</filename> não for uma "
#~ "partição separada) é criada pelo e2fsprogs-1.47.0 ou posterior:"

#, no-wrap, xml-text
#~ msgid ""
#~ "<userinput>patch -Np1 -i ../grub-&grub-"
#~ "version;-upstream_fixes-1.patch</userinput>"
