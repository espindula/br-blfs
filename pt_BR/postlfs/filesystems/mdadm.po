#. type: Content of: <sect1><sect2><para>
#: blfs-en/postlfs/filesystems/mdadm.xml:30
#, xml-text
msgid ""
"The <application>mdadm</application> package contains administration tools "
"for software RAID."
msgstr ""
"O pacote <application>mdadm</application> contém ferramentas de "
"administração para RAID de software."

