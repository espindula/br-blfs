#. type: Content of: <sect1><sect2><title>
#: blfs-en/postlfs/editors/kate5.xml:83
msgid "Installation of Kate"
msgstr "Instalação do Kate"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/postlfs/editors/kate5.xml:86
msgid ""
"Install <application>Kate</application> by running the following commands:"
msgstr ""
"Instale <application>Kate</application> executando os seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/postlfs/editors/kate5.xml:90
#, no-wrap
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -DCMAKE_INSTALL_PREFIX=$KF5_PREFIX  \\\n"
"      -DCMAKE_BUILD_TYPE=Release          \\\n"
"      -DBUILD_TESTING=OFF                 \\\n"
"      -Wno-dev .. &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd   build &amp;&amp;\n"
"\n"
"cmake -DCMAKE_INSTALL_PREFIX=$KF5_PREFIX  \\\n"
"      -DCMAKE_BUILD_TYPE=Release          \\\n"
"      -DBUILD_TESTING=OFF                 \\\n"
"      -Wno-dev .. &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/postlfs/editors/kate5.xml:100
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/postlfs/editors/kate5.xml:104
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/postlfs/editors/kate5.xml:107
#, no-wrap
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

