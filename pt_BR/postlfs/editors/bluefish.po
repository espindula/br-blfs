#, xml-text
msgid "Introduction to Bluefish"
msgstr "Introdução ao Bluefish"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/postlfs/editors/bluefish.xml:29
#, xml-text
msgid ""
"<application>Bluefish</application> is a <application>GTK+</application> "
"text editor targeted towards programmers and web designers, with many "
"options to write websites, scripts and programming code. "
"<application>Bluefish</application> supports many programming and markup "
"languages, and it focuses on editing dynamic and interactive websites."
msgstr ""
"O <application>Bluefish</application> é um editor de texto "
"<application>GTK+</application> voltado para programadores(as) e projetistas"
" web, com muitas opções para escrever sítios web, scripts e códigos de "
"programação. O <application>Bluefish</application> suporta muitas linguagens"
" de programação e de marcação e se concentra na edição de sítios da web "
"dinâmicos e interativos."

