#. type: Content of: <sect1><sect2><title>
#: blfs-en/postlfs/editors/bluefish.xml:96
#, xml-text
msgid "Installation of Bluefish"
msgstr "Instalação do Bluefish"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/postlfs/editors/bluefish.xml:99
#, xml-text
msgid ""
"First, disable a plugin requiring functions removed in libxml-2.13.0 or "
"later:"
msgstr ""
"Primeiro, desabilite um plugin que requer funções removidas na libxml-2.13.0"
" ou posterior:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/postlfs/editors/bluefish.xml:103
#, no-wrap, xml-text
msgid ""
"<userinput>sed '/infbrowser/d' -i src/Makefile.am &amp;&amp;\n"
"autoreconf</userinput>"
msgstr ""
"<userinput>sed '/infbrowser/d' -i src/Makefile.am &amp;&amp;\n"
"autoreconf</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/postlfs/editors/bluefish.xml:107
#, xml-text
msgid ""
"Install <application>Bluefish</application> by running the following "
"commands:"
msgstr ""
"Instale <application>Bluefish</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/postlfs/editors/bluefish.xml:111
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr --docdir=/usr/share/doc/bluefish-&bluefish-version; &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>./configure --prefix=/usr --docdir=/usr/share/doc/bluefish-&bluefish-version; &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/postlfs/editors/bluefish.xml:115
#, xml-text
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/postlfs/editors/bluefish.xml:119
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/postlfs/editors/bluefish.xml:123
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

#. type: Content of: <sect1><sect2><note><para>
#: blfs-en/postlfs/editors/bluefish.xml:127
#, xml-text
msgid ""
"This package installs icon files into the <filename "
"class=\"directory\">/usr/share/icons/hicolor</filename> hierarchy and "
"desktop files into the <filename "
"class=\"directory\">/usr/share/applications</filename> hierarchy. You can "
"improve system performance and memory usage by updating "
"<filename>/usr/share/icons/hicolor/icon-theme.cache</filename> and "
"<filename>/usr/share/applications/mimeinfo.cache</filename>. To perform the "
"update you must have <xref linkend=\"desktop-file-utils\"/> (for the desktop"
" cache) and issue the following commands as the <systemitem "
"class=\"username\">root</systemitem> user:"
msgstr ""
"Esse pacote instala arquivos de ícone na hierarquia <filename "
"class=\"directory\">/usr/share/icons/hicolor</filename> e arquivos de área "
"de trabalho na hierarquia <filename "
"class=\"directory\">/usr/share/applications</filename>. Você pode melhorar o"
" desempenho do sistema e o uso da memória atualizando "
"<filename>/usr/share/icons/hicolor/icon-theme.cache</filename> e "
"<filename>/usr/share/applications/mimeinfo.cache</filename>. Para realizar a"
" atualização, você precisa ter <xref linkend=\"desktop-file-utils\"/> (para "
"o cache da área de trabalho) e emitir os seguintes comandos como o(a) "
"usuário(a) <systemitem class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><note><screen>
#: blfs-en/postlfs/editors/bluefish.xml:139
#, no-wrap, xml-text
msgid ""
"<userinput>gtk-update-icon-cache -t -f --include-image-data /usr/share/icons/hicolor &amp;&amp;\n"
"update-desktop-database</userinput>"
msgstr ""
"<userinput>gtk-update-icon-cache -t -f --include-image-data /usr/share/icons/hicolor &amp;&amp;\n"
"update-desktop-database</userinput>"

