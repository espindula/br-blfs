#. type: Content of: <sect1><sect2><title>
#: blfs-en/postlfs/editors/gedit.xml:100
#, xml-text
msgid "Installation of Gedit"
msgstr "Instalação do Gedit"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/postlfs/editors/gedit.xml:112
#, xml-text
msgid ""
"Install <application>Gedit</application> by running the following commands:"
msgstr ""
"Instale <application>Gedit</application> executando os seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/postlfs/editors/gedit.xml:116
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir gedit-build &amp;&amp;\n"
"cd    gedit-build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr       \\\n"
"            --buildtype=release \\\n"
"            -Dgtk_doc=false     \\\n"
"            .. &amp;&amp;\n"
"ninja</userinput>"
msgstr ""
"<userinput>mkdir gedit-build &amp;&amp;\n"
"cd   gedit-build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr       \\\n"
"            --buildtype=release \\\n"
"            -Dgtk_doc=false     \\\n"
"            .. &amp;&amp;\n"
"ninja</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/postlfs/editors/gedit.xml:126
#, xml-text
msgid "To test the results, issue: <command>ninja test</command>."
msgstr "Para testar os resultados, emita: <command>ninja test</command>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/postlfs/editors/gedit.xml:130
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/postlfs/editors/gedit.xml:133
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr "<userinput>ninja install</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/postlfs/editors/gedit.xml:141
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/postlfs/editors/gedit.xml:147
#, xml-text
msgid ""
"<parameter>-Dgtk_doc=false</parameter>: This switch disables generating the "
"API documentation. Omit this switch if you have <xref linkend=\"gtk-doc\"/> "
"installed and wish to generate the API documentation."
msgstr ""
"<parameter>-Dgtk_doc=false</parameter>: Essa chave desabilita a geração da "
"documentação da API. Omita essa chave se você tiver <xref linkend=\"gtk-"
"doc\"/> instalado e desejar gerar a documentação da API."

