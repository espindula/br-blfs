#. type: Content of: <sect1><sect2><title>
#: blfs-en/gnome/platform/libpeas.xml:98
#, xml-text
msgid "Installation of libpeas"
msgstr "Instalação do libpeas"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/libpeas.xml:101
#, xml-text
msgid ""
"Install <application>libpeas</application> by running the following "
"commands:"
msgstr ""
"Instale o <application>libpeas</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/gnome/platform/libpeas.xml:105
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr          \\\n"
"            --buildtype=release    \\\n"
"            --wrap-mode=nofallback \\\n"
"            ..                     &amp;&amp;\n"
"ninja</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr          \\\n"
"            --buildtype=release    \\\n"
"            --wrap-mode=nofallback \\\n"
"            ..                     &amp;&amp;\n"
"ninja</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/libpeas.xml:115
#, xml-text
msgid ""
"If you have <xref linkend='gi-docgen'/> installed and wish to build the API "
"documentation for this package, issue:"
msgstr ""
"Se você tiver o <xref linkend='gi-docgen'/> instalado e desejar construir a "
"documentação da API para esse pacote, emita:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/gnome/platform/libpeas.xml:119
#, no-wrap, xml-text
msgid ""
"<userinput>sed \"/docs_dir =/s@\\$@/ 'libpeas-&libpeas-version;'@\" \\\n"
"    -i ../docs/reference/meson.build       &amp;&amp;\n"
"meson configure -Dgtk_doc=true             &amp;&amp;\n"
"ninja</userinput>"
msgstr ""
"<userinput>sed \"/docs_dir =/s@\\$@/ 'libpeas-&libpeas-version;'@\" \\\n"
"    -i ../docs/reference/meson.build       &amp;&amp;\n"
"meson configure -Dgtk_doc=true             &amp;&amp;\n"
"ninja</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/libpeas.xml:125
#, xml-text
msgid ""
"To test the results, issue: <command>ninja test</command>.  An active "
"graphical session with bus address is necessary to run the tests."
msgstr ""
"Para testar os resultados, emita: <command>ninja test</command>. Uma sessão "
"gráfica ativa com endereço de barramento é necessária para executar os "
"testes."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/libpeas.xml:131
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/gnome/platform/libpeas.xml:134
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr "<userinput>ninja install</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/gnome/platform/libpeas.xml:139
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/libpeas.xml:149
#, xml-text
msgid ""
"<option>-Dvapi=true</option>: Add this switch if you wish to generate vapi "
"(vala) data."
msgstr ""
"<option>-Dvapi=true</option>: Adicione essa chave se você desejar gerar "
"dados vapi (vala)."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/libpeas.xml:154
#, xml-text
msgid ""
"<option>-Ddemos=false</option>: Add this switch if you do not wish to build "
"the demo programs."
msgstr ""
"<option>-Ddemos=false</option>: Adicione essa chave se você não desejar "
"construir os aplicativos de demonstração."

