#, xml-text
msgid "Introduction to libpeas"
msgstr "Introdução ao libpeas"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/libpeas.xml:29
#, xml-text
msgid ""
"<application>libpeas</application> is a GObject based plugins engine, and is"
" targeted at giving every application the chance to assume its own "
"extensibility."
msgstr ""
"<application>libpeas</application> é um mecanismo de plug-ins baseado em "
"GObject e tem como objetivo dar a cada aplicativo a chance de assumir a "
"própria extensibilidade dele."

