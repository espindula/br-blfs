#. type: Content of: <sect1><sect2><title>
#: blfs-en/gnome/platform/gnome-desktop.xml:99
#, xml-text
msgid "Installation of GNOME Desktop"
msgstr "Instalação do GNOME Desktop"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/gnome-desktop.xml:102
#, xml-text
msgid ""
"Install <application>GNOME Desktop</application> by running the following "
"commands:"
msgstr ""
"Instale o <application>GNOME Desktop</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/gnome/platform/gnome-desktop.xml:106
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr       \\\n"
"            --buildtype=release \\\n"
"            ..                  &amp;&amp;\n"
"ninja</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr       \\\n"
"            --buildtype=release \\\n"
"            ..                  &amp;&amp;\n"
"ninja</userinput>"

#.  "no tests defined."
#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/gnome-desktop.xml:125
#, xml-text
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/gnome-desktop.xml:130
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/gnome/platform/gnome-desktop.xml:133
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr "<userinput>ninja install</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/gnome/platform/gnome-desktop.xml:138
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/gnome-desktop.xml:152
#, xml-text
msgid ""
"<option>-Dgtk_doc=true</option>: Use this parameter if you wish to build the"
" API documentation."
msgstr ""
"<option>-Dgtk_doc=true</option>: Use esse parâmetro se você desejar "
"construir a documentação da API."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/gnome-desktop.xml:157
#, xml-text
msgid ""
"<option>-Dinstalled_tests=true</option>: Use this parameter you wish to "
"enable the installed tests."
msgstr ""
"<option>-Dinstalled_tests=true</option>: Use esse parâmetro se você desejar "
"habilitar os testes instalados."

