#. type: Content of: <sect1><sect2><title>
#: blfs-en/gnome/platform/vte.xml:98
#, xml-text
msgid "Installation of VTE"
msgstr "Instalação do VTE"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/vte.xml:101
#, xml-text
msgid ""
"Install <application>VTE</application> by running the following commands:"
msgstr ""
"Instale o <application>VTE</application> executando os seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/gnome/platform/vte.xml:105
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr --buildtype=release .. &amp;&amp;\n"
"ninja</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr --buildtype=release .. &amp;&amp;\n"
"ninja</userinput>"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/gnome/platform/vte.xml:111
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr       \\\n"
"            --buildtype=release \\\n"
"            -D_systemd=false    &amp;&amp;\n"
"ninja</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr       \\\n"
"            --buildtype=release \\\n"
"            -D_systemd=false    &amp;&amp;\n"
"ninja</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/vte.xml:120
#, xml-text
msgid ""
"If you have <xref linkend='gi-docgen'/> installed and wish to build the API "
"documentation for this package, issue:"
msgstr ""
"Se você tiver o <xref linkend='gi-docgen'/> instalado e desejar construir a "
"documentação da API para esse pacote, emita:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/gnome/platform/vte.xml:124
#, no-wrap, xml-text
msgid ""
"<userinput>sed -e \"/docdir =/s@\\$@/ 'vte-&vte-version;'@\" \\\n"
"    -e \"/--fatal-warnings/d\"            \\\n"
"    -i ../doc/reference/meson.build     &amp;&amp;\n"
"meson configure -Ddocs=true             &amp;&amp;\n"
"ninja</userinput>"
msgstr ""
"<userinput>sed -e \"/docdir =/s@\\$@/ 'vte-&vte-version;'@\" \\\n"
"    -e \"/--fatal-warnings/d\"            \\\n"
"    -i ../doc/reference/meson.build     &amp;&amp;\n"
"meson configure -Ddocs=true             &amp;&amp;\n"
"ninja</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/vte.xml:131
#, xml-text
msgid "To test the results, issue <command>ninja test</command>."
msgstr "Para testar os resultados, emita: <command>ninja test</command>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/vte.xml:135
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/gnome/platform/vte.xml:138
#, no-wrap, xml-text
msgid ""
"<userinput>ninja install &amp;&amp;\n"
"rm -v /etc/profile.d/vte.*</userinput>"
msgstr ""
"<userinput>ninja install &amp;&amp;\n"
"rm -v /etc/profile.d/vte.*</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/gnome/platform/vte.xml:144
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/vte.xml:150
#, xml-text
msgid ""
"<command>rm -v /etc/profile.d/vte.*</command>: This command removes two "
"files installed in /etc/profile.d that have no use on a LFS system."
msgstr ""
"<command>rm -v /etc/profile.d/vte.*</command>: Esse comando remove dois "
"arquivos instalados em /etc/profile.d que não tem uso em um sistema LFS."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/vte.xml:155
#, xml-text
msgid ""
"<option>-Dgnutls=false</option>: Add this switch if you do not want to "
"enable GnuTLS support."
msgstr ""
"<option>-Dgnutls=false</option>: Adicione essa chave se você não quiser "
"habilitar o suporte GnuTLS."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/vte.xml:160
#, xml-text
msgid ""
"<option>-Dvapi=false</option>: Add this switch if you do not want to enable "
"vala bindings."
msgstr ""
"<option>-Dvapi=false</option>: Adicione essa chave se você não quiser "
"habilitar ligações Vala."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/vte.xml:165
#, xml-text
msgid ""
"<option>-Dgtk4=false</option>: Add this switch if you do not want to build "
"the GTK-4 version of VTE."
msgstr ""
"<option>-Dgtk4=false</option>: Adicione essa chave se você não quiser "
"construir a versão GTK-4 do VTE."

