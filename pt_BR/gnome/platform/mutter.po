#. type: Content of: <sect1><sect2><title>
#: blfs-en/gnome/platform/mutter.xml:26
#, xml-text
msgid "Introduction to Mutter"
msgstr "Introdução ao Mutter"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/mutter.xml:29
#, xml-text
msgid ""
"<application>Mutter</application> is the window manager for "
"<application>GNOME</application>. It is not invoked directly, but from "
"<application>GNOME Session</application> (on a machine with a hardware "
"accelerated video driver)."
msgstr ""
"<application>Mutter</application> é o gerenciador de janelas para o "
"<application>GNOME</application>. Ele não é invocado diretamente, mas a "
"partir da <application>Sessão GNOME</application> (em uma máquina com um "
"controlador de vídeo acelerado por hardware)."

