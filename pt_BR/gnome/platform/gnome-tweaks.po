#. type: Content of: <sect1><sect2><title>
#: blfs-en/gnome/platform/gnome-tweaks.xml:27
#, xml-text
msgid "Introduction to GNOME Tweaks"
msgstr "Introdução ao GNOME Tweaks"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/gnome-tweaks.xml:30
#, xml-text
msgid ""
"<application>GNOME Tweaks</application> is a simple program used to tweak "
"advanced <application>GNOME</application> settings."
msgstr ""
"<application>GNOME Tweaks</application> é um aplicativo simples usado para "
"ajustar configurações avançadas do <application>GNOME</application>."

