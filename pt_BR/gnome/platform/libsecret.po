#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/gnome/platform/libsecret.xml:69
#, xml-text
msgid "libsecret Dependencies"
msgstr "Dependências do libsecret"

#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/gnome/platform/libsecret.xml:71
#, xml-text
msgid "Required"
msgstr "Exigidas"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/libsecret.xml:73
#, xml-text
msgid "<xref linkend=\"glib2\"/>"
msgstr "<xref linkend=\"glib2\"/>"

#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/gnome/platform/libsecret.xml:76
#, xml-text
msgid "Recommended"
msgstr "Recomendadas"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/libsecret.xml:78
#, xml-text
msgid ""
"<xref linkend=\"gobject-introspection\"/>, <xref linkend=\"libgcrypt\"/>, or"
" <xref linkend=\"gnutls\"/> (for cryptography), and <xref linkend=\"vala\"/>"
msgstr ""
"<xref linkend=\"gobject-introspection\"/>, <xref linkend=\"libgcrypt\"/> ou "
"<xref linkend=\"gnutls\"/> (para criptografia) e <xref linkend=\"vala\"/>"

#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/gnome/platform/libsecret.xml:84
#, xml-text
msgid "Optional"
msgstr "Opcionais"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/libsecret.xml:86
#, xml-text
msgid ""
"<xref linkend=\"gi-docgen\"/> and <xref linkend=\"DocBook\"/>, <xref "
"linkend=\"docbook-xsl\"/>, <xref linkend=\"libxslt\"/> (to build manual "
"pages), and <xref linkend=\"valgrind\"/> (can be used in tests)"
msgstr ""
"<xref linkend=\"gi-docgen\"/> e <xref linkend=\"DocBook\"/>, <xref "
"linkend=\"docbook-xsl\"/>, <xref linkend=\"libxslt\"/> (para construir "
"páginas de manual) e <xref linkend=\"valgrind\"/> (pode ser usado em testes)"

#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/gnome/platform/libsecret.xml:93
#, xml-text
msgid "Optional (Required for the test suite)"
msgstr "Opcionais (exigidas para a suíte de teste)"

#.  Historically libsecret used to require Python2, but it has been
#.       fully ported to Python3.
#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/libsecret.xml:95
#, xml-text
msgid ""
"<xref linkend=\"dbus-python\"/>, <xref linkend=\"gjs\"/>, <xref "
"linkend=\"pygobject3\"/> (Python 3 module), and <ulink "
"url=\"https://github.com/tpm2-software/tpm2-tss\">tpm2-tss</ulink>"
msgstr ""
"<xref linkend=\"dbus-python\"/>, <xref linkend=\"gjs\"/>, <xref "
"linkend=\"pygobject3\"/> (módulo do Python 3) e <ulink "
"url=\"https://github.com/tpm2-software/tpm2-tss\">tpm2-tss</ulink>"

#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/gnome/platform/libsecret.xml:103
#, xml-text
msgid "Runtime Dependency"
msgstr "Dependência de Tempo de Execução"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/libsecret.xml:105
#, xml-text
msgid "<xref role=\"runtime\" linkend=\"gnome-keyring\"/>"
msgstr "<xref role=\"runtime\" linkend=\"gnome-keyring\"/>"

#. type: Content of: <sect1><sect2><note><para>
#: blfs-en/gnome/platform/libsecret.xml:110
#, xml-text
msgid ""
"Any package requiring <application>libsecret</application> expects "
"<application>GNOME Keyring</application> to be present at runtime."
msgstr ""
"Qualquer pacote que exija a <application>libsecret</application> espera que "
"o <application>GNOME Keyring</application> esteja presente em tempo de "
"execução."

#. type: Content of: <sect1><sect2><title>
#: blfs-en/gnome/platform/libsecret.xml:119
#, xml-text
msgid "Installation of libsecret"
msgstr "Instalação do libsecret"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/libsecret.xml:122
#, xml-text
msgid ""
"Install <application>libsecret</application> by running the following "
"commands:"
msgstr ""
"Instale o <application>libsecret</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/gnome/platform/libsecret.xml:126
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir bld &amp;&amp;\n"
"cd    bld &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr       \\\n"
"            --buildtype=release \\\n"
"            -Dgtk_doc=false     \\\n"
"            ..                  &amp;&amp;\n"
"ninja</userinput>"
msgstr ""
"<userinput>mkdir bld &amp;&amp;\n"
"cd    bld &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr       \\\n"
"            --buildtype=release \\\n"
"            -Dgtk_doc=false     \\\n"
"            ..                  &amp;&amp;\n"
"ninja</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/libsecret.xml:136
#, xml-text
msgid ""
"If you have <xref linkend='gi-docgen'/> installed and wish to build the API "
"documentation for this package, issue:"
msgstr ""
"Se você tiver o <xref linkend='gi-docgen'/> instalado e desejar construir a "
"documentação da API para esse pacote, emita:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/gnome/platform/libsecret.xml:140
#, no-wrap, xml-text
msgid ""
"<userinput>sed \"s/api_version_major/'&libsecret-version;'/\"            \\\n"
"    -i ../docs/reference/libsecret/meson.build &amp;&amp;\n"
"meson configure -Dgtk_doc=true                 &amp;&amp;\n"
"ninja</userinput>"
msgstr ""
"<userinput>sed \"s/api_version_major/'&libsecret-version;'/\"            \\\n"
"    -i ../docs/reference/libsecret/meson.build &amp;&amp;\n"
"meson configure -Dgtk_doc=true                 &amp;&amp;\n"
"ninja</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/libsecret.xml:146
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/gnome/platform/libsecret.xml:149
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr "<userinput>ninja install</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/libsecret.xml:152
#, xml-text
msgid ""
"To test the results, issue: <command>dbus-run-session ninja test</command>."
msgstr ""
"Para testar os resultados, emita: <command>dbus-run-session ninja "
"test</command>."

#. type: Content of: <sect1><sect2><title>
#: blfs-en/gnome/platform/libsecret.xml:158
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/libsecret.xml:164
#, xml-text
msgid "<parameter>-Dgtk_doc=false</parameter>: &gi-doc-disable;"
msgstr "<parameter>-Dgtk_doc=false</parameter>: &gi-doc-disable;"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/libsecret.xml:168
#, xml-text
msgid ""
"<option>-Dmanpage=false</option>: Use this switch if you have not installed "
"<xref linkend=\"libxslt\"/> and DocBook packages."
msgstr ""
"<option>-Dmanpage=false</option>: Use essa chave se você não tiver instalado"
" os pacotes <xref linkend=\"libxslt\"/> e DocBook."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/libsecret.xml:174
#, xml-text
msgid ""
"<option>-Dcrypto=gnutls, disabled</option>: Use this switch if you want to "
"use <xref linkend=\"gnutls\"/> for cryptography or if either <xref "
"linkend=\"gnutls\"/> or <xref linkend=\"libgcrypt\"/> is not installed."
msgstr ""
"<option>-Dcrypto=gnutls, disabled</option>: Use essa chave se você quiser "
"usar <xref linkend=\"gnutls\"/> para criptografia ou se, ou <xref linkend="
"\"gnutls\"/> ou <xref linkend=\"libgcrypt\"/>, não estiver instalado."

