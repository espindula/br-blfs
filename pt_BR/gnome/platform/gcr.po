#. type: Content of: <sect1><sect2><title>
#: blfs-en/gnome/platform/gcr.xml:98
#, xml-text
msgid "Installation of Gcr"
msgstr "Instalação do Gcr"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/gcr.xml:120
#, xml-text
msgid ""
"Install <application>Gcr</application> by running the following commands:"
msgstr ""
"Instale o <application>Gcr</application> executando os seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/gnome/platform/gcr.xml:124
#, no-wrap, xml-text
msgid ""
"<userinput>sed -i 's:\"/desktop:\"/org:' schema/*.xml &amp;&amp;\n"
"\n"
"mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr       \\\n"
"            --buildtype=release \\\n"
"            -D gtk_doc=false    \\\n"
"            -D ssh_agent=false  \\\n"
"            ..                  &amp;&amp;\n"
"ninja</userinput>"
msgstr ""
"<userinput>sed -i 's:\"/desktop:\"/org:' schema/*.xml &amp;&amp;\n"
"\n"
"mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr       \\\n"
"            --buildtype=release \\\n"
"            -D gtk_doc=false    \\\n"
"            -D ssh_agent=false  \\\n"
"            ..                  &amp;&amp;\n"
"ninja</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/gcr.xml:137
#, xml-text
msgid ""
"If you have <xref linkend='gi-docgen'/> installed and wish to build the API "
"documentation for this package, issue:"
msgstr ""
"Se você tiver <xref linkend='gi-docgen'/> instalado e desejar construir a "
"documentação da API para esse pacote, emita:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/gnome/platform/gcr.xml:141
#, no-wrap, xml-text
msgid ""
"<userinput>sed -e \"/install_dir/s@,\\$@ / 'gcr-&gcr-version;'&amp;@\" \\\n"
"    -i ../docs/*/meson.build                  &amp;&amp;\n"
"meson configure -D gtk_doc=true               &amp;&amp;\n"
"ninja</userinput>"
msgstr ""
"<userinput>sed -e \"/install_dir/s@,\\$@ / 'gcr-&gcr-version;'&amp;@\" \\\n"
"    -i ../docs/*/meson.build                  &amp;&amp;\n"
"meson configure -D gtk_doc=true               &amp;&amp;\n"
"ninja</userinput>"

#.  One test,
#.       "test-openssl 3", is known to fail.
#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/gcr.xml:147
#, xml-text
msgid ""
"To test the results, issue: <command>ninja test</command>.  The tests must "
"be run from an X Terminal or similar."
msgstr ""
"Para testar os resultados, emita: <command>ninja test</command>. Os testes "
"precisam ser executados a partir de um Terminal do X ou similar."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/gcr.xml:153
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/gnome/platform/gcr.xml:156
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr "<userinput>ninja install</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/gnome/platform/gcr.xml:160
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/gcr.xml:186
#, xml-text
msgid ""
"<parameter>-D ssh_agent=false</parameter>: Prevent a conflict with <xref "
"linkend='gcr4'/>.  Omit this switch if you do not plan to install <xref "
"linkend='gcr4'/> and you want to use <command>gcr-ssh-agent</command>."
msgstr ""
"<parameter>-D ssh_agent=false</parameter>: Evita um conflito com <xref "
"linkend='gcr4'/>. Omita essa chave se você não planeja instalar o <xref "
"linkend='gcr4'/> e deseja usar o <command>gcr-ssh-agent</command>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/gcr.xml:193
#, xml-text
msgid ""
"<option>-D gtk=false</option>: Use this switch if you haven't installed "
"<xref linkend=\"gtk3\"/>. Note that <application>gcr-viewer</application> "
"will not be installed if this is passed to meson."
msgstr ""
"<option>-D gtk=false</option>: Use essa chave se você não tiver instalado o "
"<xref linkend=\"gtk3\"/>. Observe que o <application>gcr-"
"viewer</application> não será instalado se isso for passado para o meson."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/gcr.xml:200
#, xml-text
msgid "<option>-D gtk_doc=true</option>: &gi-doc-disable;"
msgstr "<option>-D gtk_doc=true</option>: &gi-doc-disable;"

