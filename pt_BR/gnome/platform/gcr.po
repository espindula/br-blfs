#. type: Content of: <sect1><sect2><title>
#: blfs-en/gnome/platform/gcr.xml:26
#, xml-text
msgid "Introduction to Gcr"
msgstr "Introdução ao Gcr"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/gcr.xml:29
#, xml-text
msgid ""
"The <application>Gcr</application> package contains libraries used for "
"displaying certificates and accessing key stores. It also provides the "
"viewer for crypto files on the <application>GNOME</application> Desktop."
msgstr ""
"O pacote <application>Gcr</application> contém bibliotecas usadas para "
"exibir certificados e acessar armazenamentos de chaves. Ele também fornece o"
" visualizador para arquivos criptográficos na área de trabalho do "
"<application>GNOME</application>."

