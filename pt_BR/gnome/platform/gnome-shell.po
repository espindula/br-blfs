msgstr "<userinput>ninja install</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/gnome/platform/gnome-shell.xml:198
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/gnome-shell.xml:211
#, xml-text
msgid ""
"<parameter>-Dsystemd=false</parameter>: Prevents installing systemd files, "
"which are not needed in this version of BLFS."
msgstr ""
"<parameter>-Dsystemd=false</parameter>: Impede a instalação de arquivos "
"systemd, que não são necessários nesta versão do BLFS."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/gnome-shell.xml:216
#, xml-text
msgid ""
"<parameter>-Dtests=false</parameter>: Remove this switch if you want to "
"build the tests. But then <command>meson</command> will fail if <xref "
"linkend=\"mutter\"/> tests are not installed."
msgstr ""
"<parameter>-Dtests=false</parameter>: Remova essa chave se você quiser "
"construir os testes. Mas, então, <command>meson</command> falhará se os "
"testes <xref linkend=\"mutter\"/> não estiverem instalados."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/gnome-shell.xml:222
#, xml-text
msgid ""
"<option>-Dextensions_tool=false</option>: This switch allows building this "
"package without <xref linkend='gnome-autoar'/> installed."
msgstr ""
"<option>-Dextensions_tool=false</option>: Essa chave permite construir esse "
"pacote sem <xref linkend='gnome-autoar'/> instalado."

