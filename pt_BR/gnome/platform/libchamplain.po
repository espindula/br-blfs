#. type: Content of: <sect1><sect2><title>
#: blfs-en/gnome/platform/libchamplain.xml:96
msgid "Installation of libchamplain"
msgstr "Instalação do libchamplain"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/libchamplain.xml:99
msgid ""
"Install <application>libchamplain</application> by running the following "
"commands:"
msgstr ""
"Instale o <application>libchamplain</application> executando os seguintes "
"comandos:"

#.  Because there is still rudimentary autotools support, there is already a
#.      build directory. Change into it and continue.
#. type: Content of: <sect1><sect2><screen>
#: blfs-en/gnome/platform/libchamplain.xml:105
#, no-wrap
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr --buildtype=release .. &amp;&amp;\n"
"ninja</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr --buildtype=release .. &amp;&amp;\n"
"ninja</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/libchamplain.xml:112
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/libchamplain.xml:116
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/gnome/platform/libchamplain.xml:119
#, no-wrap
msgid "<userinput>ninja install</userinput>"
msgstr "<userinput>ninja install</userinput>"

