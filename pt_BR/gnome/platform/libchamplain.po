#. type: Content of: <sect1><sect2><title>
#: blfs-en/gnome/platform/libchamplain.xml:28
msgid "Introduction to libchamplain"
msgstr "Introdução ao libchamplain"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/libchamplain.xml:31
msgid ""
"The <application>libchamplain</application> package contains a Clutter-based"
" widget that is used to display rich and interactive maps."
msgstr ""
"O pacote <application>libchamplain</application> contém uma pequena "
"engenhoca baseada em Clutter que é usada para exibir mapas ricos e "
"interativos."

