#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/libgee.xml:29
#, xml-text
msgid ""
"The <application>libgee</application> package is a collection library "
"providing GObject based interfaces and classes for commonly used data "
"structures."
msgstr ""
"O pacote <application>libgee</application> é uma biblioteca de coleção que "
"fornece interfaces e classes baseadas em GObject para estruturas de dados "
"comumente usadas."

