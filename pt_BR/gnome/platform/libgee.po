#. type: Content of: <sect1><sect2><title>
#: blfs-en/gnome/platform/libgee.xml:91
#, xml-text
msgid "Installation of libgee"
msgstr "Instalação do libgee"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/libgee.xml:94
#, xml-text
msgid ""
"First, force the Vala code to be regenerated so that it is compatible with "
"gcc-14:"
msgstr ""
"Primeiro, force o código Vala ser regenerado, de forma que ele seja "
"compatível com gcc-14:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/gnome/platform/libgee.xml:98
#, no-wrap, xml-text
msgid "<userinput remap=\"pre\">find . -name \\*.vala -exec touch {} \\;</userinput>"
msgstr "<userinput remap=\"pre\">find . -name \\*.vala -exec touch {} \\;</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/libgee.xml:101
#, xml-text
msgid ""
"Install <application>libgee</application> by running the following commands:"
msgstr ""
"Instale o <application>libgee</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/gnome/platform/libgee.xml:105
#, no-wrap, xml-text
#| msgid ""
#| "<userinput>./configure --prefix=/usr &amp;&amp;\n"
#| "make</userinput>"
msgid ""
"<userinput>./configure --prefix=/usr --enable-vala &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>./configure --prefix=/usr --enable-vala &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/libgee.xml:109
#, xml-text
msgid "To test the results, issue: <command>make check</command>."
msgstr "Para testar os resultados, emita: <command>make check</command>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/libgee.xml:115
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/gnome/platform/libgee.xml:118
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

