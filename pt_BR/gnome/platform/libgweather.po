#: blfs-en/gnome/platform/libgweather.xml:71
#, xml-text
msgid "libgweather Dependencies"
msgstr "Dependências do libgweather"

#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/gnome/platform/libgweather.xml:73
#, xml-text
msgid "Required"
msgstr "Exigidas"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/libgweather.xml:75
#, xml-text
