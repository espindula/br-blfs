#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/gnome/platform/gnome-settings-daemon.xml:81
#, xml-text
msgid "GNOME Settings Daemon Dependencies"
msgstr "Dependências do GNOME Settings Daemon"

#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/gnome/platform/gnome-settings-daemon.xml:83
#, xml-text
msgid "Required"
msgstr "Exigidas"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/gnome-settings-daemon.xml:85
#, xml-text
msgid ""
"<xref linkend=\"alsa-lib\"/>, <xref linkend=\"colord\"/>, <xref "
"linkend=\"fontconfig\"/>, <xref linkend=\"gcr4\"/>, <xref "
"linkend=\"geoclue2\"/>, <xref linkend=\"geocode-glib\"/>, <xref "
"linkend=\"gnome-desktop\"/>, <xref linkend=\"lcms2\"/>, <xref "
"linkend=\"libcanberra\"/>, <xref linkend=\"libgweather\"/>, <xref "
"linkend=\"libnotify\"/>, <xref linkend=\"libwacom\"/>, <xref "
"linkend=\"pulseaudio\"/>, and <xref linkend=\"upower\"/>"
msgstr ""
"<xref linkend=\"alsa-lib\"/>, <xref linkend=\"colord\"/>, <xref "
"linkend=\"fontconfig\"/>, <xref linkend=\"gcr4\"/>, <xref "
"linkend=\"geoclue2\"/>, <xref linkend=\"geocode-glib\"/>, <xref "
"linkend=\"gnome-desktop\"/>, <xref linkend=\"lcms2\"/>, <xref "
"linkend=\"libcanberra\"/>, <xref linkend=\"libgweather\"/>, <xref "
"linkend=\"libnotify\"/>, <xref linkend=\"libwacom\"/>, <xref "
"linkend=\"pulseaudio\"/> e <xref linkend=\"upower\"/>"

#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/gnome/platform/gnome-settings-daemon.xml:101
#, xml-text
msgid "Recommended"
msgstr "Recomendadas"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/gnome-settings-daemon.xml:103
#, xml-text
msgid ""
"<xref linkend=\"alsa\"/>, <xref linkend=\"cups\"/>, <xref "
"linkend=\"NetworkManager\"/>, <xref linkend=\"nss\"/>, and <xref "
"linkend=\"wayland\"/>"
msgstr ""
"<xref linkend=\"alsa\"/>, <xref linkend=\"cups\"/>, <xref "
"linkend=\"NetworkManager\"/>, <xref linkend=\"nss\"/> e <xref "
"linkend=\"wayland\"/>"

#. type: Content of: <sect1><sect2><note><para>
#: blfs-en/gnome/platform/gnome-settings-daemon.xml:112
#, xml-text
msgid ""
"Recommended dependencies are not strictly required for this package to build"
" and function, but you may not get expected results at runtime if you don't "
"install them."
msgstr ""
"As dependências recomendadas não são estritamente exigidas para esse pacote "
"construir e funcionar, mas você possivelmente não obtenha os resultados "
"esperados em tempo de execução se não as instalar."

#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/gnome/platform/gnome-settings-daemon.xml:119
#, xml-text
msgid "Recommended (Runtime)"
msgstr "Recomendadas (tempo de execução)"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/gnome-settings-daemon.xml:121
#, xml-text
msgid "<xref linkend=\"blocaled\" role=\"runtime\"/>"
msgstr "<xref linkend=\"blocaled\" role=\"runtime\"/>"

#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/gnome/platform/gnome-settings-daemon.xml:124
#, xml-text
msgid "Optional"
msgstr "Opcionais"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/gnome-settings-daemon.xml:126
#, xml-text
msgid ""
"<xref linkend=\"gnome-session\"/>, <xref linkend=\"mutter\"/>, <xref "
"linkend=\"python-dbusmock\"/>, <xref linkend=\"umockdev\"/>, and "
"<command>Xvfb</command> (for tests, from <xref linkend=\"xorg-server\"/> or "
"<xref role=\"nodep\" linkend=\"xwayland\"/>)"
msgstr ""
"<xref linkend=\"gnome-session\"/>, <xref linkend=\"mutter\"/>, <xref "
"linkend=\"python-dbusmock\"/>, <xref linkend=\"umockdev\"/> e "
"<command>Xvfb</command> (para testes, originário de <xref linkend=\"xorg-"
"server\"/> ou <xref role=\"nodep\" linkend=\"xwayland\"/>)"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/gnome/platform/gnome-settings-daemon.xml:138
#, xml-text
msgid "Installation of GNOME Settings Daemon"
msgstr "Instalação do GNOME Settings Daemon"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/gnome-settings-daemon.xml:150
#, xml-text
msgid "Next, fix libelogind detection for tests:"
msgstr "A seguir, corrija a detecção da libelogind para testes:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/gnome/platform/gnome-settings-daemon.xml:153
#, no-wrap, xml-text
msgid ""
"<userinput>sed -e 's/libsystemd/libelogind/' \\\n"
"    -i plugins/power/test.py</userinput>"
msgstr ""
"<userinput>sed -e 's/libsystemd/libelogind/' \\\n"
"    -i plugins/power/test.py</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/gnome-settings-daemon.xml:157
#, xml-text
msgid "Next, fix backlight functionality in gnome-control-center:"
msgstr ""
"A seguir, corrija a funcionalidade da luz de fundo no gnome-control-center:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/gnome/platform/gnome-settings-daemon.xml:160
#, no-wrap, xml-text
msgid ""
"<userinput>sed -e 's/(backlight->logind_proxy)/(0)/' \\\n"
"    -i plugins/power/gsd-backlight.c</userinput>"
msgstr ""
"<userinput>sed -e 's/(backlight->logind_proxy)/(0)/' \\\n"
"    -i plugins/power/gsd-backlight.c</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/gnome-settings-daemon.xml:164
#, xml-text
msgid ""
"If running the test suite, apply a patch to fix test timeouts with python-"
"dbusmock 0.30.0 or later:"
msgstr ""
"Se executar a suíte de teste, aplique um remendo para corrigir tempos limite "
"de teste com python-dbusmock 0.30.0 ou posterior:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/gnome/platform/gnome-settings-daemon.xml:168
#, no-wrap, xml-text
msgid ""
"<userinput>patch -Np1 -i ../gnome-settings-daemon-&gnome-settings-daemon-"
"version;-testsuite_fix-1.patch</userinput>"
msgstr ""
"<userinput>patch -Np1 -i ../gnome-settings-daemon-&gnome-settings-daemon-"
"version;-testsuite_fix-1.patch</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/gnome-settings-daemon.xml:171
#, xml-text
msgid ""
"Install <application>GNOME Settings Daemon</application> by running the "
"following commands:"
msgstr ""
"Instale o <application>Gnome Settings Daemon</application> executando os "
"seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/gnome/platform/gnome-settings-daemon.xml:175
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr       \\\n"
"            --buildtype=release \\\n"
"            -Dsystemd=false     \\\n"
"            ..                  &amp;&amp;\n"
"ninja</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr       \\\n"
"            --buildtype=release \\\n"
"            -Dsystemd=false     \\\n"
"            ..                  &amp;&amp;\n"
"ninja</userinput>"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/gnome/platform/gnome-settings-daemon.xml:184
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr --buildtype=release .. &amp;&amp;\n"
"ninja</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr --buildtype=release .. &amp;&amp;\n"
"ninja</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/gnome-settings-daemon.xml:198
#, xml-text
msgid ""
"To check the results, execute: <command>ninja test</command>. Note that you "
"must have <application>python-dbusmock</application> installed in order for "
"the tests to complete successfully. Some tests may fail depending on the "
"init system in use."
msgstr ""
"Para verificar os resultados, execute: <command>ninja test</command>. "
"Observe que você precisa ter o <application>python-dbusmock</application> "
"instalado para a finalidade de que os testes completem com sucesso. Alguns "
"testes possivelmente falhem dependendo do sistema init em uso."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/gnome-settings-daemon.xml:205
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/gnome/platform/gnome-settings-daemon.xml:208
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr "<userinput>ninja install</userinput>"

