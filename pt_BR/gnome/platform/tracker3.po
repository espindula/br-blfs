#. type: Content of: <sect1><sect2><title>
#: blfs-en/gnome/platform/tracker3.xml:119
#, xml-text
msgid "Installation of Tracker"
msgstr "Instalação do Tracker"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/tracker3.xml:122
#, xml-text
msgid "Fix the location to install the documentation into:"
msgstr "Corrija o local para instalar a documentação:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/gnome/platform/tracker3.xml:125
#, no-wrap, xml-text
msgid ""
"<userinput>mv docs/reference/libtracker-sparql/doc/{Tracker-3.0,tracker-&tracker3-version;} &amp;&amp;\n"
"sed '/docs_name/s/Tracker-3.0/tracker-&tracker3-version;/' \\\n"
"    -i docs/reference/libtracker-sparql/meson.build</userinput>"
msgstr ""
"<userinput>mv docs/reference/libtracker-sparql/doc/{Tracker-3.0,tracker-&tracker3-version;} &amp;&amp;\n"
"sed '/docs_name/s/Tracker-3.0/tracker-&tracker3-version;/' \\\n"
"    -i docs/reference/libtracker-sparql/meson.build</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/tracker3.xml:130
#, xml-text
msgid ""
"Install <application>Tracker</application> by running the following "
"commands:"
msgstr ""
"Instale o <application>Tracker</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/gnome/platform/tracker3.xml:134
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr       \\\n"
"            --buildtype=release \\\n"
"            -Dman=false         \\\n"
"            ..                  &amp;&amp;\n"
"ninja</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr       \\\n"
"            --buildtype=release \\\n"
"            -Dman=false         \\\n"
"            ..                  &amp;&amp;\n"
"ninja</userinput>"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/gnome/platform/tracker3.xml:143
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr                 \\\n"
"            --buildtype=release           \\\n"
"            -Dman=false                   \\\n"
"            -Dsystemd_user_services=false \\\n"
"            ..                            &amp;&amp;\n"
"ninja</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr                 \\\n"
"            --buildtype=release           \\\n"
"            -Dman=false                   \\\n"
"            -Dsystemd_user_services=false \\\n"
"            ..                            &amp;&amp;\n"
"ninja</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/tracker3.xml:154
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/gnome/platform/tracker3.xml:157
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr "<userinput>ninja install</userinput>"

#. One test,
#.       <filename>
#. tracker: fts / fts</filename>, is known to fail due to an
#.       incompatibility with SQLite-3.42.
#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/tracker3.xml:160
#, xml-text
msgid ""
"To test the results, issue: <command>meson configure -Ddebug=true &amp;&amp;"
" ninja test</command>.  The test suite should be run from a graphical "
"session."
msgstr ""
"Para testar os resultados, emita: <command>meson configure -Ddebug=true "
"&amp;&amp; ninja test</command>. A suíte de teste deveria ser executada a "
"partir de uma sessão gráfica."

#. type: Content of: <sect1><sect2><title>
#: blfs-en/gnome/platform/tracker3.xml:171
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/tracker3.xml:177
#, xml-text
msgid ""
"<parameter>-Dman=false</parameter>: This switch prevents the build process "
"from generating man pages. Omit this switch if you have <xref "
"linkend=\"asciidoc\" role=\"nodep\"/> installed and wish to generate and "
"install the man pages."
msgstr ""
"<parameter>-Dman=false</parameter>: Essa chave evita que o processo de "
"construção gere páginas de manual. Omita essa chave se você tiver o <xref "
"linkend=\"asciidoc\" role=\"nodep\"/> instalado e desejar gerar e instalar "
"as páginas de manual."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/tracker3.xml:184
#, xml-text
msgid ""
"<parameter>-Dsystemd_user_services=false</parameter>: This switch prevents "
"the build process from installing systemd user services since they are "
"useless on SysV systems."
msgstr ""
"<parameter>-Dsystemd_user_services=false</parameter>: Essa chave impede que "
"o processo de construção instale serviços de usuário(a) do systemd, pois "
"eles são inúteis em sistemas SysV."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/tracker3.xml:190
#, xml-text
msgid ""
"<command>meson configure -Ddebug=true</command>: This command enables some "
"debug checks necessary for the test suite.  We don't want to enable them for"
" the installed Tracker 3 libraries and programs, so we run the test suite "
"after installation."
msgstr ""
"<command>meson configure -Ddebug=true</command>: Esse comando habilita "
"algumas verificações de depuração necessárias para a suíte de teste. Nós não"
" queremos habilitá-las para as bibliotecas e aplicativos instaladas do "
"Tracker 3, de forma que executamos a suíte de teste depois da instalação."

