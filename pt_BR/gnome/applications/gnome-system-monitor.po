#. type: Content of: <sect1><sect2><title>
#: blfs-en/gnome/applications/gnome-system-monitor.xml:93
#, xml-text
msgid "Installation of GNOME System Monitor"
msgstr "Instalação do GNOME System Monitor"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/applications/gnome-system-monitor.xml:96
#, xml-text
msgid ""
"Install <application>GNOME System Monitor</application> by running the "
"following commands:"
msgstr ""
"Instale o <application>GNOME System Monitor</application> executando os "
"seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/gnome/applications/gnome-system-monitor.xml:100
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr       \\\n"
"            -Dsystemd=false     \\\n"
"            --buildtype=release \\\n"
"            ..                  &amp;&amp;\n"
"ninja</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr       \\\n"
"            -Dsystemd=false     \\\n"
"            --buildtype=release \\\n"
"            ..                  &amp;&amp;\n"
"ninja</userinput>"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/gnome/applications/gnome-system-monitor.xml:109
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr --buildtype=release .. &amp;&amp;\n"
"ninja</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr --buildtype=release .. &amp;&amp;\n"
"ninja</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/applications/gnome-system-monitor.xml:116
#, xml-text
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/applications/gnome-system-monitor.xml:120
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/gnome/applications/gnome-system-monitor.xml:123
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr "<userinput>ninja install</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/gnome/applications/gnome-system-monitor.xml:128
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/applications/gnome-system-monitor.xml:131
#, xml-text
msgid ""
"<parameter>-Dsystemd=false</parameter>: This switch ensures that gnome-"
"system-monitor does NOT use the systemd process monitoring framework.  Use "
"this option if you are on a SysV system."
msgstr ""
"<parameter>-Dsystemd=false</parameter>: Essa chave garante que o gnome-"
"system-monitor NÃO use a estrutura de monitoramento de processos do systemd."
" Use essa opção se você estiver em um sistema SysV."

