#. type: Content of: <sect1><sect2><title>
#: blfs-en/gnome/applications/gnome-color-manager.xml:97
#, xml-text
msgid "Installation of GNOME Color Manager"
msgstr "Instalação do GNOME Color Manager"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/applications/gnome-color-manager.xml:100
#, xml-text
msgid ""
"If <xref linkend=\"docbook-utils\"/> is installed, disable installation of "
"the man pages to avoid a build failure:"
msgstr ""
"Se o <xref linkend=\"docbook-utils\"/> estiver instalado, desabilite a "
"instalação das páginas de manual para evitar uma falha de construção:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/gnome/applications/gnome-color-manager.xml:104
#, no-wrap, xml-text
msgid "<userinput>sed /subdir\\(\\'man/d -i meson.build</userinput>"
msgstr "<userinput>sed /subdir\\(\\'man/d -i meson.build</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/applications/gnome-color-manager.xml:107
#, xml-text
msgid ""
"Install <application>GNOME Color Manager</application> by running the "
"following commands:"
msgstr ""
"Instale o <application>GNOME Color Manager</application> executando os "
"seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/gnome/applications/gnome-color-manager.xml:111
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr --buildtype=release .. &amp;&amp;\n"
"ninja</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr --buildtype=release .. &amp;&amp;\n"
"ninja</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/applications/gnome-color-manager.xml:118
#, xml-text
msgid ""
"To test the results, issue: <command>ninja test</command>. The tests must be"
" run from an X session."
msgstr ""
"Para testar os resultados, emita: <command>ninja test</command>. Os testes "
"precisam ser executados a partir de uma sessão do X."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/applications/gnome-color-manager.xml:123
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/gnome/applications/gnome-color-manager.xml:126
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr "<userinput>ninja install</userinput>"

