#. type: Content of: <sect1><sect2><title>
#: blfs-en/gnome/applications/brasero.xml:27
#, xml-text
msgid "Introduction to Brasero"
msgstr "Introdução ao Brasero"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/applications/brasero.xml:30
#, xml-text
msgid ""
"<application>Brasero</application> is an application used to burn CD/DVD on "
"the <application>GNOME</application> Desktop.  It is designed to be as "
"simple as possible and has some unique features that enable users to create "
"their discs easily and quickly."
msgstr ""
"<application>Brasero</application> é um aplicativo usado para gravar CD/DVD "
"na Área de Trabalho do <application>GNOME</application>. Ele foi projetado "
"para ser o mais simples possível e tem alguns recursos exclusivos que "
"habilitam usuários(as) a criar os discos deles(as) fácil e rapidamente."

