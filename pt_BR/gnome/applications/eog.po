"linkend=\"libexif\"/>, <xref linkend=\"librsvg\"/>, and <xref "
"linkend=\"webp-pixbuf-loader\"/>"
msgstr ""
"<xref linkend=\"gobject-introspection\"/>, <xref linkend=\"lcms2\"/>, <xref "
"linkend=\"libexif\"/>, <xref linkend=\"librsvg\"/> e <xref linkend=\"webp-"
"pixbuf-loader\"/>"

