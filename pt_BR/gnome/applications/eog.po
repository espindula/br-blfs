#. type: Content of: <sect1><sect2><title>
#: blfs-en/gnome/applications/eog.xml:26
#, xml-text
msgid "Introduction to EOG"
msgstr "Introdução ao EOG"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/applications/eog.xml:29
#, xml-text
msgid ""
"<application>EOG</application> is an application used for viewing and "
"cataloging image files on the <application>GNOME</application> Desktop. It "
"also has basic editing capabilities."
msgstr ""
"<application>EOG</application> é um aplicativo usado para visualizar e "
"catalogar arquivos de imagem na Área de Trabalho do "
"<application>GNOME</application>. Ele também tem recursos básicos de edição."

