#. type: Content of: <sect1><sect2><title>
#: blfs-en/gnome/applications/cheese.xml:101
msgid "Kernel Configuration"
msgstr "Configuração do Núcleo"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/applications/cheese.xml:104
msgid ""
"Depending on your camera, enable the appropriate options and recompile the "
"kernel if necessary:"
msgstr ""
"Dependendo da tua câmera, habilite as opções apropriadas e recompile o "
"núcleo se necessário:"

#. type: Content of: <sect1><sect2><variablelist><varlistentry><listitem><indexterm><primary>
#: blfs-en/gnome/applications/cheese.xml:112
#: blfs-en/gnome/applications/cheese.xml:177
#: blfs-en/gnome/applications/cheese.xml:200
msgid "cheese"
msgstr "cheese"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/gnome/applications/cheese.xml:117
msgid "Installation of Cheese"
msgstr "Instalação do Cheese"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/applications/cheese.xml:120
msgid ""
"Install <application>Cheese</application> by running the following commands:"
msgstr ""
"Instale o <application>Cheese</application> executando os seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/gnome/applications/cheese.xml:124
#, no-wrap
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr        \\\n"
"            --buildtype=release  \\\n"
"            -Dgtk_doc=false      \\\n"
"            -Dtests=true         \\\n"
"            ..                   &amp;&amp;\n"
"ninja</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr        \\\n"
"            --buildtype=release  \\\n"
"            -Dgtk_doc=false      \\\n"
"            -Dtests=true         \\\n"
"            ..                   &amp;&amp;\n"
"ninja</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/applications/cheese.xml:135
msgid "To test the results, issue: <command>ninja test</command>"
msgstr "Para testar os resultados, emita: <command>ninja test</command>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/applications/cheese.xml:139
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/gnome/applications/cheese.xml:142
#, no-wrap
msgid "<userinput>ninja install</userinput>"
msgstr "<userinput>ninja install</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/gnome/applications/cheese.xml:147
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/applications/cheese.xml:153
msgid ""
"<parameter>-Dgtk_doc=false</parameter>: This switch prevents the build "
"system from generating and installing the API documentation. Omit this "
"switch if you have <xref linkend=\"gtk-doc\" role=\"nodep\"/> installed and "
"wish to generate and install the API documentation. Building the "
"documentation is broken due to an incompatibility with gtk-doc."
msgstr ""
"<parameter>-Dgtk_doc=false</parameter>: Essa chave impede que o sistema de "
"construção gere e instale a documentação da API. Omita essa chave se você "
"tiver o <xref linkend=\"gtk-doc\" role=\"nodep\"/> instalado e desejar gerar "
"e instalar a documentação da API. A construção da documentação está quebrada "
"devido a uma incompatibilidade com gtk-doc."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/applications/cheese.xml:161
msgid ""
"<parameter>-Dtests=true</parameter>: This switch allows building the tests "
"so that the test suite can be run. Remove this switch if you are not going "
"to run the tests."
msgstr ""
"<parameter>-Dtests=true</parameter>: Essa chave permite construir os testes, "
"de forma que a suíte de teste possa ser executada. Remova essa chave se você "
"não for executar os testes."

