#. type: Content of: <sect1><sect2><title>
#: blfs-en/gnome/applications/file-roller.xml:113
#, xml-text
msgid "Installation of File Roller"
msgstr "Instalação do File Roller"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/applications/file-roller.xml:116
#, xml-text
msgid ""
"Install <application>File Roller</application> by running the following "
"commands:"
msgstr ""
"Instale o <application>File Roller</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/gnome/applications/file-roller.xml:120
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr       \\\n"
"            --buildtype=release \\\n"
"            -Dpackagekit=false  \\\n"
"            ..                  &amp;&amp;\n"
"ninja</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr       \\\n"
"            --buildtype=release \\\n"
"            -Dpackagekit=false  \\\n"
"            ..                  &amp;&amp;\n"
"ninja</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/applications/file-roller.xml:130
#, xml-text
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/applications/file-roller.xml:134
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/gnome/applications/file-roller.xml:137
#, no-wrap, xml-text
msgid ""
"<userinput>ninja install &amp;&amp;\n"
"chmod -v 0755 /usr/libexec/file-roller/isoinfo.sh</userinput>"
msgstr ""
"<userinput>ninja install &amp;&amp;\n"
"chmod -v 0755 /usr/libexec/file-roller/isoinfo.sh</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/gnome/applications/file-roller.xml:149
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/applications/file-roller.xml:155
#, xml-text
msgid ""
"<parameter>-Dpackagekit=false</parameter>: This switch disables the use of "
"PackageKit which isn't suitable for BLFS."
msgstr ""
"<parameter>-Dpackagekit=false</parameter>: Essa chave desabilita o uso do "
"PackageKit que não é adequado para o BLFS."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/applications/file-roller.xml:160
#, xml-text
msgid ""
"<option>-Dapi_docs=enabled</option>: Use this switch if you have <xref "
"linkend=\"gi-docgen\"/> installed and wish to generate the API "
"documentation."
msgstr ""
"<option>-Dapi_docs=enabled</option>: Use essa chave se você tiver o <xref "
"linkend=\"gi-docgen\"/> instalado e desejar gerar a documentação da API."

