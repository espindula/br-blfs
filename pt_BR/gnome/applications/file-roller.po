#. type: Content of: <sect1><sect2><title>
#: blfs-en/gnome/applications/file-roller.xml:27
#, xml-text
msgid "Introduction to File Roller"
msgstr "Introdução ao File Roller"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/applications/file-roller.xml:30
#, xml-text
msgid ""
"<application>File Roller</application> is an archive manager for "
"<application>GNOME</application> with support for tar, bzip2, gzip, zip, "
"jar, compress, lzop, zstd, dmg, and many other archive formats."
msgstr ""
"<application>File Roller</application> é um gerenciador de arquivamentos "
"para o <application>GNOME</application> com suporte para tar, bzip2, gzip, "
"zip, jar, compress, lzop, zstd, dmg e muitos outros formatos de "
"arquivamento."

#. type: Content of: <sect1><sect2><note><para>
#: blfs-en/gnome/applications/file-roller.xml:39
#, xml-text
msgid ""
"<application>File Roller</application> is only a graphical interface to "
"archiving utilities such as <application>tar</application> and "
"<application>zip</application>."
msgstr ""
"<application>File Roller</application> é apenas uma interface gráfica para "
"utilitários de arquivamento como o <application>tar</application> e "
"<application>zip</application>."

