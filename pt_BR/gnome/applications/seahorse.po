#. type: Content of: <sect1><sect2><title>
#: blfs-en/gnome/applications/seahorse.xml:27
#, xml-text
msgid "Introduction to Seahorse"
msgstr "Introdução ao Seahorse"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/applications/seahorse.xml:30
#, xml-text
msgid ""
"<application>Seahorse</application> is a graphical interface for managing "
"and using encryption keys. Currently it supports PGP keys (using GPG/GPGME) "
"and SSH keys."
msgstr ""
"<application>Seahorse</application> é uma interface gráfica para gerenciar e"
" usar chaves de criptografia. Atualmente ela suporta chaves PGP (usando "
"GPG/GPGME) e chaves SSH."

