"linkend=\"libsecret\"/>, and <xref linkend=\"vala\"/>"
msgstr ""
"<xref linkend=\"gcr\"/>, <xref linkend=\"gnupg2\"/>, <xref "
"linkend=\"gpgme\"/>, <xref linkend=\"itstool\"/>, <xref "
"linkend=\"libhandy1\"/>, <xref linkend=\"libpwquality\"/>, <xref "
"linkend=\"libsecret\"/> e <xref linkend=\"vala\"/>"

