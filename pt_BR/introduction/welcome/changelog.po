#: blfs-en/introduction/welcome/changelog.xml:337
#, xml-text
msgid ""
"[renodr] - Update python module dependencies for BLFS 12.2.  This includes "
"alabaster-1.0.0, attrs-24.2.0, babel-2.16.0, certifi-2024.7.4, "
"chardet-5.2.0, charset-normalizer-3.3.2, idna-3.7, markdown-3.6, "
