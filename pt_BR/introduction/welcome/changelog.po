#, xml-text
msgid "[renodr] - Add libplacebo to the book in support of mpv."
msgstr "[renodr] - Adicionar libplacebo ao livro em suporte de mpv."

#. type: Content of:
#. <sect1><itemizedlist><listitem><itemizedlist><listitem><para>
#: blfs-en/introduction/welcome/changelog.xml:2116
#, xml-text
msgid "[renodr] - Add glad to the book in support of libplacebo."
msgstr "[renodr] - Adicionar glad ao livro em suporte de libplacebo."

#. type: Content of:
#. <sect1><itemizedlist><listitem><itemizedlist><listitem><para>
#: blfs-en/introduction/welcome/changelog.xml:2119
#, xml-text
msgid ""
"[renodr] - Add support for Vulkan to the book. This is in support of "
"libplacebo, but also since it is used in more packages.  This involves the "
"addition of SPIRV-Headers, SPIRV-Tools, glslang, Vulkan-Headers, and Vulkan-"
"Loader."
msgstr ""
"[renodr] - Adicionar suporte para Vulkan ao livro. Isso é em suporte de "
"libplacebo, mas também porque é usado em mais pacotes. Isso envolve a adição"
" de SPIRV-Headers, SPIRV-Tools, glslang, Vulkan-Headers e Vulkan-Loader."

#. type: Content of:
#. <sect1><itemizedlist><listitem><itemizedlist><listitem><para>
#: blfs-en/introduction/welcome/changelog.xml:2125
#, xml-text
msgid ""
"[renodr] - Disable the usage of libplacebo in VLC. It's broken due to major "
"API changes in libplacebo, and will not be fixed until VLC-4."
msgstr ""
"[renodr] – Desabilita o uso de libplacebo no VLC. Ela está quebrada devido a"
" grandes mudanças de API na libplacebo e não será corrigida até o VLC-4."

#. type: Content of:
#. <sect1><itemizedlist><listitem><itemizedlist><listitem><para>
#: blfs-en/introduction/welcome/changelog.xml:2130
#, xml-text
msgid ""
"[renodr] - Enable support for Vulkan in Mesa. This includes the addition of "
"Vulkan drivers."
msgstr ""
"[renodr] – Habilita suporte para Vulkan no Mesa. Isso inclui a adição de "
"controladores Vulkan."

#. type: Content of:
#. <sect1><itemizedlist><listitem><itemizedlist><listitem><para>
#: blfs-en/introduction/welcome/changelog.xml:2134
#, xml-text
msgid ""
"[renodr] - Add support for Vulkan to ffmpeg, Qt5, Qt6, gst-plugins-bad, "
"gtksourceview5, and pipewire."
msgstr ""
"[renodr] - Adicionar suporte para Vulkan ao ffmpeg, Qt5, Qt6, gst-plugins-"
"bad, gtksourceview5 e pipewire."

