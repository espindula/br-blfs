#, xml-text
msgid "Inkscape Dependencies"
msgstr "Dependências do Inkscape"

#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/xsoft/other/inkscape.xml:96
#, xml-text
msgid "Required"
msgstr "Exigidas"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/xsoft/other/inkscape.xml:98
#, xml-text
msgid ""
"<xref linkend=\"boost\"/>, <xref linkend=\"double-conversion\"/>, <xref "
"linkend=\"gc\"/>, <xref linkend=\"gsl\"/>, <xref linkend=\"gtkmm3\"/>, <xref"
" linkend=\"libsoup\"/>, <xref linkend=\"libxslt\"/>, <xref "
"linkend=\"poppler\"/>, <xref linkend=\"popt\"/> and <xref linkend=\"wget\"/>"
" (to download the test dependencies)"
msgstr ""
"<xref linkend=\"boost\"/>, <xref linkend=\"double-conversion\"/>, <xref "
"linkend=\"gc\"/>, <xref linkend=\"gsl\"/>, <xref linkend=\"gtkmm3\"/>, <xref"
" linkend=\"libsoup\"/>, <xref linkend=\"libxslt\"/>, <xref "
"linkend=\"poppler\"/>, <xref linkend=\"popt\"/> e <xref linkend=\"wget\"/> "
"(para baixar as dependências de teste)"

#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/xsoft/other/inkscape.xml:110
#, xml-text
msgid "Recommended"
msgstr "Recomendadas"

#.  Imagemagick is used for two different purposes:
#.            For raster extensions and image import resolution, Imagemagick
#.            libraries are needed but this requires Imagemagick 6:
#.            https://gitlab.com/inkscape/inkscape/-/issues/1294
#.            TODO: add Imagemagick 6 back or add GraphicsMagick, or port
#.                  inkscape to Imagemagick 7 API.
#.            For WebSlicer export to JPG or GIF, Imagemagick program
#.            "convert" is needed and this is only a runtime dependency.
#.  there might be others, or other needed dependencies:
#.        needs someone who knows how to use *all" the core extensions
#. type: Content of: <sect1><sect2><para>
#: blfs-en/xsoft/other/inkscape.xml:120
#, xml-text
msgid ""
"<xref role=\"runtime\" linkend=\"imagemagick\"/> (runtime), <xref "
"linkend=\"lcms2\"/>, <xref linkend=\"libcanberra\"/> (to eliminate plugin "
"warnings), <xref linkend=\"potrace\"/> (for the bucket-fill tool), also "
"various Python modules at runtime for the core extensions: <xref "
"role=\"runtime\" linkend=\"cachecontrol\"/>, <xref role=\"runtime\" "
"linkend=\"cssselect\"/>, <xref role=\"runtime\" linkend=\"lxml\"/>, <xref "
"role=\"runtime\" linkend=\"numpy\"/>, <xref role=\"runtime\" "
"linkend=\"pyserial\"/>, and <xref role=\"runtime\" linkend=\"scour\"/>"
msgstr ""
"<xref role=\"runtime\" linkend=\"imagemagick\"/> (tempo de execução), <xref "
"linkend=\"lcms2\"/>, <xref linkend=\"libcanberra\"/> (para eliminar avisos "
"de plugin), <xref linkend=\"potrace\"/> (para a ferramenta bucket-fill), "
"também vários módulos Python em tempo de execução para as extensões "
"centrais: <xref role=\"runtime\" linkend=\"cachecontrol\"/>, <xref "
"role=\"runtime\" linkend=\"cssselect\"/>, <xref role=\"runtime\" "
"linkend=\"lxml\"/>, <xref role=\"runtime\" linkend=\"numpy\"/>, <xref "
"role=\"runtime\" linkend=\"pyserial\"/> e <xref role=\"runtime\" "
"linkend=\"scour\"/>"

#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/xsoft/other/inkscape.xml:135
#, xml-text
msgid "Optional"
msgstr "Opcionais"

#.  these document foundation links work from firefox's address bar, or
#.       from google (pages telling you how to get it from git), but when I
#. link
#.       them here I get "There is currently no text in this page...". Ken or
#.       developer: wiki.documentfoundation.org pages don't like trailing /
#. <ulink url="https://wiki.documentfoundation.org/DLP/Libraries/libcdr">
#. libcdr</ulink>,
#.       <ulink
#. url="https://wiki.documentfoundation.org/DLP/Libraries/libvisio">libvisio</ulink>,
#. <ulink url="https://gtkspell.sourceforge.net">
#. gtkspell</ulink>,
#. type: Content of: <sect1><sect2><para>
#: blfs-en/xsoft/other/inkscape.xml:137
#, xml-text
msgid ""
"<xref linkend=\"aspell\"/>, <xref linkend=\"dbus\"/> (to run inkscape from "
"scripts), <xref linkend=\"doxygen\"/>, <xref linkend=\"gspell\"/>, <ulink "
"url=\"https://sourceforge.net/projects/graphicsmagick\">GraphicsMagick</ulink>,"
" <ulink url=\"https://github.com/LibreOffice/libcdr\">libcdr</ulink>, <ulink"
" url=\"https://github.com/LibreOffice/libvisio\">libvisio</ulink>, <ulink "
"url=\"https://libwpg.sourceforge.net/\">libwpg</ulink> (or <ulink "
"url=\"https://libwpd.sourceforge.net/\">libwpd</ulink>)"
msgstr ""
"<xref linkend=\"aspell\"/>, <xref linkend=\"dbus\"/> (para executar inkscape"
" a partir de conjuntos de comandos sequenciais), <xref "
"linkend=\"doxygen\"/>, <xref linkend=\"gspell\"/>, <ulink "
"url=\"https://sourceforge.net/projects/graphicsmagick\">GraphicsMagick</ulink>,"
" <ulink url=\"https://github.com/LibreOffice/libcdr\">libcdr</ulink>, <ulink"
" url=\"https://github.com/LibreOffice/libvisio\">libvisio</ulink>, <ulink "
"url=\"https://libwpg.sourceforge.net/\">libwpg</ulink> (ou <ulink "
"url=\"https://libwpd.sourceforge.net/\">libwpd</ulink>)"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/xsoft/other/inkscape.xml:167
#, xml-text
msgid "Installation of Inkscape"
msgstr "Instalação do Inkscape"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/xsoft/other/inkscape.xml:177
#, xml-text
msgid "First, fix a build failure caused by libxml2-2.12.0:"
msgstr "Primeiro, corrija uma falha de construção causada por libxml2-2.12.0:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/xsoft/other/inkscape.xml:180
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"pre\">sed -i '/uri.h/a #include "
"&lt;libxml/xmlmemory.h&gt;' src/object/uri.h</userinput>"
msgstr ""
"<userinput remap=\"pre\">sed -i '/uri.h/a #include "
"&lt;libxml/xmlmemory.h&gt;' src/object/uri.h</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/xsoft/other/inkscape.xml:183
#, xml-text
msgid ""
"Install <application>Inkscape</application> by running the following "
"commands:"
msgstr ""
"Instale o <application>Inkscape</application> executando os seguintes "
"comandos:"

#. <screen>
#. <userinput remap="pre">patch -Np1 -i ../inkscape-&inkscape-
#. version;-poppler_21.11.0-1.patch &amp;&amp;
#. type: Content of: <sect1><sect2><screen>
#: blfs-en/xsoft/other/inkscape.xml:189
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build                       &amp;&amp;\n"
"cd    build                       &amp;&amp;\n"
"\n"
"cmake -DCMAKE_INSTALL_PREFIX=/usr \\\n"
"      -DCMAKE_BUILD_TYPE=Release  \\\n"
"      ..                          &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>mkdir build                       &amp;&amp;\n"
"cd    build                       &amp;&amp;\n"
"\n"
"cmake -DCMAKE_INSTALL_PREFIX=/usr \\\n"
"      -DCMAKE_BUILD_TYPE=Release  \\\n"
"      ..                          &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/xsoft/other/inkscape.xml:215
#, xml-text
msgid "This package does not come with a working test suite."
msgstr "Esse pacote não vem com uma suíte de teste funcional."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/xsoft/other/inkscape.xml:219
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/xsoft/other/inkscape.xml:222
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/xsoft/other/inkscape.xml:230
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/xsoft/other/inkscape.xml:233
#, xml-text
msgid ""
"<parameter>-DCMAKE_BUILD_TYPE=Release</parameter>: This switch is used to "
"build the release library without any debug `assert` in the code."
msgstr ""
"<parameter>-DCMAKE_BUILD_TYPE=Release</parameter>: Essa chave é usada para "
"construir a biblioteca de lançamento sem qualquer `assertiva` de depuração "
"no código."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/xsoft/other/inkscape.xml:238
#, xml-text
msgid ""
"<option>-DWITH_DBUS=ON</option>: use this if you wish to use "
"<command>inkscape</command> in interactive scripts which manipulate images."
msgstr ""
"<option>-DWITH_DBUS=ON</option>: use isso se você desejar usar o "
"<command>inkscape</command> em conjuntos de comandos sequenciais interativos"
" que manipulam imagens."

