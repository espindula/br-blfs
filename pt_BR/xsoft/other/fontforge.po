#, xml-text
msgid "Required"
msgstr "Exigidas"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/xsoft/other/fontforge.xml:90
#, xml-text
msgid "<xref linkend=\"libspiro\"/> and <xref linkend=\"libxml2\"/>"
msgstr "<xref linkend=\"libspiro\"/> e <xref linkend=\"libxml2\"/>"

#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/xsoft/other/fontforge.xml:94
#, xml-text
msgid "Recommended"
msgstr "Recomendadas"

#.  not mentioned:
#.       glib is required for gtk3
#.       pango is required for gtk3
#.       cairo is recommended for pango
#.       xorg libs pulled in by gtk3 via libepoxy.
#. type: Content of: <sect1><sect2><para>
#: blfs-en/xsoft/other/fontforge.xml:102
#, xml-text
msgid "<xref linkend=\"gtk3\"/>"
msgstr "<xref linkend=\"gtk3\"/>"

#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/xsoft/other/fontforge.xml:105
#, xml-text
msgid "Optional"
msgstr "Opcionais"

#.  the following references in the source appear not to be used:
#.       curl is mentioned in appveyor.yml for msys2 (integration tests, I
#. think)
#.       wget is referenced in Unicode/charset/generate.sh which will fail if
#.       wget is not on the PATH, and in Unicode/dump.c - with wget moved off
#. the
#.       PATH, no problems, i.e. they are never run and never built.
#.       Some of the others are at a minimum pulled in for recommended deps -
#.        libpng from freetype from fontconfig from xorg libs.
#.        harfbuzz is the same
#.       Also, adding or removing optional deps other than Sphinx doesn't seem
#.       to materially alter the build time or size.
#. type: Content of: <sect1><sect2><para>
#: blfs-en/xsoft/other/fontforge.xml:120
#, xml-text
msgid ""
"<xref linkend=\"giflib\"/>, <xref linkend=\"git\"/>, <xref "
"linkend=\"libjpeg\"/>, <xref linkend=\"libtiff\"/>, <xref "
"linkend=\"sphinx\"/> (to build html documentation), and <xref "
"linkend=\"woff2\"/>"
msgstr ""
"<xref linkend=\"giflib\"/>, <xref linkend=\"git\"/>, <xref "
"linkend=\"libjpeg\"/>, <xref linkend=\"libtiff\"/>, <xref "
"linkend=\"sphinx\"/> (para construir documentação HTML) e <xref "
"linkend=\"woff2\"/>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/xsoft/other/fontforge.xml:131
#, xml-text
msgid "Installation of FontForge"
msgstr "Instalação do FontForge"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/xsoft/other/fontforge.xml:134
#, xml-text
msgid ""
"First, fix two security vulnerabilities in the Splinefont functionality:"
msgstr ""
"Primeiro, corrija duas vulnerabilidades de segurança na funcionalidade "
"Splinefont:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/xsoft/other/fontforge.xml:137
#, no-wrap, xml-text
#| msgid ""
#| "<userinput>ln -sv fontforge /usr/share/doc/fontforge-&fontforge-"
#| "version;</userinput>"
msgid ""
"<userinput remap=\"pre\">patch -Np1 -i ../fontforge-&fontforge-"
"version;-security_fixes-1.patch</userinput>"
msgstr ""
"<userinput remap=\"pre\">patch -Np1 -i ../fontforge-&fontforge-"
"version;-security_fixes-1.patch</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/xsoft/other/fontforge.xml:140
#, xml-text
msgid "Next, fix a problem with old translations exposed by gettext-0.22:"
msgstr ""
"A seguir, corrija um problema com traduções antigas exposto por "
"gettext-0.22:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/xsoft/other/fontforge.xml:143
#, no-wrap, xml-text
msgid ""
"<userinput>sed -i.orig 's/\\(%[^%[:space:]]*\\)hs/\\1s/g' \\\n"
" fontforgeexe/searchview.c po/de.po po/ca.po \\\n"
" po/hr.po po/it.po po/pl.po po/uk.po po/en_GB.po \\\n"
" po/fr.po po/vi.po po/ko.po po/ja.po</userinput>"
msgstr ""
"<userinput>sed -i.orig 's/\\(%[^%[:space:]]*\\)hs/\\1s/g' \\\n"
" fontforgeexe/searchview.c po/de.po po/ca.po \\\n"
" po/hr.po po/it.po po/pl.po po/uk.po po/en_GB.po \\\n"
" po/fr.po po/vi.po po/ko.po po/ja.po</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/xsoft/other/fontforge.xml:149
#, xml-text
msgid ""
"Install <application>FontForge</application> by running the following "
"commands:"
msgstr ""
"Instale o <application>FontForge</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/xsoft/other/fontforge.xml:153
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -DCMAKE_INSTALL_PREFIX=/usr \\\n"
"      -DCMAKE_BUILD_TYPE=Release  \\\n"
"      -Wno-dev .. &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -DCMAKE_INSTALL_PREFIX=/usr \\\n"
"      -DCMAKE_BUILD_TYPE=Release  \\\n"
"      -Wno-dev .. &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/xsoft/other/fontforge.xml:162
#, xml-text
msgid "To test the results, issue: <command>make check</command>."
msgstr "Para testar os resultados, emita: <command>make check</command>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/xsoft/other/fontforge.xml:166
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/xsoft/other/fontforge.xml:169
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/xsoft/other/fontforge.xml:172
#, xml-text
msgid ""
"If you have installed <command>sphinx-build</command>, HTML documentation "
"was built and installed in <filename "
"class=\"directory\">/usr/share/doc/fontforge</filename>.  To be able to "
"access it as a versioned directory, create a symlink as the <systemitem "
"class=\"username\">root</systemitem> user:"
msgstr ""
"Se você tiver instalou o <command>sphinx-build</command>, a documentação "
"HTML foi construída e instalada em <filename "
"class=\"directory\">/usr/share/doc/fontforge</filename>. Para poder acessá-"
"la como um diretório versionado, crie um link simbólico como o(a) usuário(a)"
" <systemitem class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/xsoft/other/fontforge.xml:181
#, no-wrap, xml-text
msgid ""
"<userinput>ln -sv fontforge /usr/share/doc/fontforge-&fontforge-"
"version;</userinput>"
msgstr ""
"<userinput>ln -sv fontforge /usr/share/doc/fontforge-&fontforge-"
"version;</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/xsoft/other/fontforge.xml:186
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/xsoft/other/fontforge.xml:189
#, xml-text
msgid ""
"<parameter>-DCMAKE_BUILD_TYPE=Release</parameter>: This switch is used to "
"create an optimized release without debug information."
msgstr ""
"<parameter>-DCMAKE_BUILD_TYPE=Release</parameter>: Essa chave é usada para "
"criar um lançamento otimizado sem informações de depuração."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/xsoft/other/fontforge.xml:194
#, xml-text
msgid ""
"<parameter>-Wno-dev</parameter>: This switch is used to suppress warnings "
"intended for the package's developers."
msgstr ""
"<parameter>-Wno-dev</parameter>: Essa chave é usada para suprimir avisos "
"destinados para os(as) desenvolvedores(as) do pacote."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/xsoft/other/fontforge.xml:199
#, xml-text
msgid ""
"<option>-DENABLE_X11=ON</option>: use an X11 backend instead of GDK3 "
"(gtk+-3) for basic Xorg graphics."
msgstr ""
"<option>-DENABLE_X11=ON</option>: use uma estrutura de retaguarda X11 em vez"
" da GDK3 (gtk+-3) para gráficos básicos do Xorg."

