#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/xsoft/other/gimp.xml:142
#, xml-text
msgid "Gimp Dependencies"
msgstr "Dependências do Gimp"

#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/xsoft/other/gimp.xml:144
#, xml-text
msgid "Required"
msgstr "Exigidas"

#.  en can be built without this
#. type: Content of: <sect1><sect2><para>
#: blfs-en/xsoft/other/gimp.xml:146
#, xml-text
msgid ""
"<xref linkend=\"appstream-glib\"/>, <xref linkend=\"gegl\"/>, <xref "
"linkend=\"gexiv2\"/>, <xref linkend=\"glib-networking\"/>, <xref "
"linkend=\"gtk3\"/>, <xref linkend=\"harfbuzz\"/>, <xref "
"linkend=\"libmypaint\"/>, <xref linkend=\"librsvg\"/>, <xref "
"linkend=\"libtiff\"/>, <xref linkend=\"libxml2\"/> (to build the translated "
"help files), <xref linkend=\"lcms2\"/>, <xref linkend=\"mypaint-brushes\"/>,"
" and <xref linkend=\"poppler\"/> (including poppler-data)"
msgstr ""
"<xref linkend=\"appstream-glib\"/>, <xref linkend=\"gegl\"/>, <xref "
"linkend=\"gexiv2\"/>, <xref linkend=\"glib-networking\"/>, <xref "
"linkend=\"gtk3\"/>, <xref linkend=\"harfbuzz\"/>, <xref "
"linkend=\"libmypaint\"/>, <xref linkend=\"librsvg\"/>, <xref "
"linkend=\"libtiff\"/>, <xref linkend=\"libxml2\"/> (para construir os "
"arquivos da ajuda traduzida), <xref linkend=\"lcms2\"/>, <xref "
"linkend=\"mypaint-brushes\"/> e <xref linkend=\"poppler\"/> (incluindo "
"poppler-data)"

#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/xsoft/other/gimp.xml:162
#, xml-text
msgid "Recommended"
msgstr "Recomendadas"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/xsoft/other/gimp.xml:164
#, xml-text
msgid ""
"<xref linkend=\"graphviz\"/>, <xref linkend=\"gs\"/> (with libgs installed),"
" <xref role='runtime' linkend=\"gvfs\"/> and <xref role='runtime' "
"linkend='glib-networking'/> (both runtime, to access the online help, open "
"images from a HTTP or HTTPS URL, drag and drop images from an external "
"application, etc.), <xref linkend=\"iso-codes\"/>, <xref "
"linkend=\"libgudev\"/>, <xref linkend=\"pygobject3\"/>, and <xref "
"linkend=\"xdg-utils\"/>"
msgstr ""
"<xref linkend=\"graphviz\"/>, <xref linkend=\"gs\"/> (com libgs instalado), "
"<xref role='runtime' linkend=\"gvfs\"/> e <xref role='runtime' "
"linkend='glib-networking'/> (ambos tempo de execução, para acessar a ajuda "
"online, abrir imagens provenientes de um URL HTTP ou HTTPS, arrastar e "
"soltar imagens provenientes de um aplicativo externo, etc.), <xref "
"linkend=\"iso-codes\"/>, <xref linkend=\"libgudev\"/>, <xref "
"linkend=\"pygobject3\"/> e <xref linkend=\"xdg-utils\"/>"

#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/xsoft/other/gimp.xml:177
#, xml-text
msgid "Optional"
msgstr "Opcionais"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/xsoft/other/gimp.xml:179
#, xml-text
msgid ""
"<xref linkend=\"aalib\"/>, <xref linkend=\"alsa-lib\"/>, <xref "
"linkend=\"gjs\"/>, <xref linkend=\"libjxl\"/>, <xref linkend=\"libmng\"/>, "
"<xref linkend=\"libunwind\"/>, <xref linkend=\"libwebp\"/>, <xref "
"linkend=\"lua\"/>, <xref linkend=\"openjpeg2\"/>, <xref linkend=\"gtk-"
"doc\"/>, <ulink url=\"https://github.com/HEASARC/cfitsio\">cfitsio</ulink>, "
"<ulink "
"url=\"https://github.com/ianlancetaylor/libbacktrace\">libbacktrace</ulink>,"
" <ulink url=\"https://github.com/svanderburg/libiff\">libiff</ulink>, <ulink"
" url=\"https://github.com/svanderburg/libilbm\">libilbm</ulink>, <ulink "
"url=\"https://github.com/strukturag/libheif/\">libheif</ulink> with <ulink "
"url=\"https://github.com/strukturag/libde265/\">libde265</ulink> (both "
"needed to read macOS heic images), <ulink "
"url=\"https://wvware.sourceforge.net/libwmf.html\">libwmf</ulink>, <ulink "
"url=\"https://www.openexr.com/\">OpenEXR</ulink>, and <ulink "
"url=\"https://github.com/phoboslab/qoi\">qoi</ulink>"
msgstr ""
"<xref linkend=\"aalib\"/>, <xref linkend=\"alsa-lib\"/>, <xref "
"linkend=\"gjs\"/>, <xref linkend=\"libjxl\"/>, <xref linkend=\"libmng\"/>, "
"<xref linkend=\"libunwind\"/>, <xref linkend=\"libwebp\"/>, <xref "
"linkend=\"lua\"/>, <xref linkend=\"openjpeg2\"/>, <xref linkend=\"gtk-"
"doc\"/>, <ulink url=\"https://github.com/HEASARC/cfitsio\">cfitsio</ulink>, "
"<ulink "
"url=\"https://github.com/ianlancetaylor/libbacktrace\">libbacktrace</ulink>,"
" <ulink url=\"https://github.com/svanderburg/libiff\">libiff</ulink>, <ulink"
" url=\"https://github.com/svanderburg/libilbm\">libilbm</ulink>, <ulink "
"url=\"https://github.com/strukturag/libheif/\">libheif</ulink> com <ulink "
"url=\"https://github.com/strukturag/libde265/\">libde265</ulink> (ambos "
"necessários para ler-se imagens heic do macOS), <ulink "
"url=\"https://wvware.sourceforge.net/libwmf.html\">libwmf</ulink>, <ulink "
"url=\"https://www.openexr.com/\">OpenEXR</ulink> e <ulink "
"url=\"https://github.com/phoboslab/qoi\">qoi</ulink>"

#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/xsoft/other/gimp.xml:201
#, xml-text
msgid "Optional, for building the help system"
msgstr "Opcionais, para construir o sistema de ajuda"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/xsoft/other/gimp.xml:203
#, xml-text
msgid ""
"<ulink url=\"https://dblatex.sourceforge.net/\">dblatex</ulink> (for PDF "
"docs), <ulink url=\"https://pngnq.sourceforge.net/\">pngnq</ulink> and "
"<ulink url=\"https://pmt.sourceforge.net/pngcrush/\">pngcrush</ulink> to "
"optimize the png files, but see the note on the help download above"
msgstr ""
"<ulink url=\"https://dblatex.sourceforge.net/\">dblatex</ulink> (para "
"documentos PDF), <ulink url=\"https://pngnq.sourceforge.net/\">pngnq</ulink>"
" e <ulink url=\"https://pmt.sourceforge.net/pngcrush/\">pngcrush</ulink> "
"para otimizar os arquivos png, mas veja-se a observação no download da ajuda"
" acima"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/xsoft/other/gimp.xml:209
#, xml-text
msgid "Editor Notes: <ulink url=\"&blfs-wiki;/gimp\"/>"
msgstr "Observações de Editor(a): <ulink url=\"&blfs-wiki;/gimp\"/>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/xsoft/other/gimp.xml:215
#, xml-text
msgid "Installation of Gimp"
msgstr "Instalação do Gimp"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/xsoft/other/gimp.xml:218
#, xml-text
msgid ""
"Install <application>Gimp</application> by running the following commands:"
msgstr ""
"Instale o <application>Gimp</application> executando os seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/xsoft/other/gimp.xml:222
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir gimp-build &amp;&amp;\n"
"cd    gimp-build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr --buildtype=release .. &amp;&amp;\n"
"ninja</userinput>"
msgstr ""
"<userinput>mkdir gimp-build &amp;&amp;\n"
"cd    gimp-build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr --buildtype=release .. &amp;&amp;\n"
"ninja</userinput>"

#.  km: in 2.10.16 no failures, 2 tests were skipped
#. type: Content of: <sect1><sect2><para>
#: blfs-en/xsoft/other/gimp.xml:229
#, xml-text
msgid ""
"To test the results (requires an X-Windowed terminal) issue: <command>ninja "
"test</command>."
msgstr ""
"Para testar os resultados (exige um terminal janelado do X) emita: "
"<command>ninja test</command>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/xsoft/other/gimp.xml:236
#, xml-text
msgid "Now, as the &root; user:"
msgstr "Agora, como o(a) usuário(a) &root;:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/xsoft/other/gimp.xml:239
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr "<userinput>ninja install</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/xsoft/other/gimp.xml:247
#, xml-text
msgid "Installation of Gimp-Help"
msgstr "Instalação do Gimp-Help"

#.       The documentation generated by gimp-help-2.10.34 and online help have
#.       the same contents, so I comment this out. [pierre Nov. 2023]
#.       Because of the
#.       issues mentioned in the note above, you are recommended to use the
#. online
#.       help, either by building against <xref linkend="gvfs"/>
#.  so that 'help'
#.       can open the latest XML files in your browser, or else you can
#. manually
#.       open the html in your browser by going to <ulink
#. url="https://docs.gimp.org/2.10/en/">https://docs.gimp.org/2.10/en</ulink>
#.      (change the language code if desired).
#. type: Content of: <sect1><sect2><para>
#: blfs-en/xsoft/other/gimp.xml:250
#, xml-text
msgid ""
"The <filename>gimp-help</filename> tarball contains images and English text "
"help for help files, together with translations.  If you wish to install "
"local copies of the help files to read offline, unpack the gimp-help tarball"
" and change into the root of the newly created source tree."
msgstr ""
"O tarball <filename>gimp-help</filename> contém imagens e texto de ajuda em "
"inglês para arquivos de ajuda, juntamente com traduções. Se você desejar "
"instalar cópias locais dos arquivos de ajuda para ler offline, desempacote o"
" tarball gimp-help e mude para a raiz da árvore do fonte recém-criada."

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/xsoft/other/gimp.xml:268
#, no-wrap, xml-text
#| msgid ""
#| "<userinput>tar -xf ../../gimp3-help-&gimp-version;.tar.xz &amp;&amp;\n"
#| "cd gimp3-help-&gimp-version;\n"
#| "\n"
#| "ALL_LINGUAS=&quot;ca cs da de en en_GB es fa fr hr ko lt nl nn pt pt_BR ro sl sv uk zh_CN&quot; \\\n"
#| "./configure --prefix=/usr</userinput>"
msgid ""
"<userinput>tar -xf ../../gimp3-help-&gimp-version;.tar.xz &amp;&amp;\n"
"cd gimp3-help-&gimp-version;\n"
"\n"
"automake --add-missing\n"
"\n"
"ALL_LINGUAS=&quot;ca cs da de en en_GB es fa fr hr ko lt nl nn pt pt_BR ro sl sv uk zh_CN&quot; \\\n"
"./configure --prefix=/usr</userinput>"
msgstr ""
"<userinput>tar -xf ../../gimp3-help-&gimp-version;.tar.xz &amp;&amp;\n"
"cd gimp3-help-&gimp-version;\n"
"\n"
"automake --add-missing\n"
"\n"
"ALL_LINGUAS=&quot;ca cs da de en en_GB es fa fr hr ko lt nl nn pt pt_BR ro sl sv uk zh_CN&quot; \\\n"
"./configure --prefix=/usr</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/xsoft/other/gimp.xml:277
#, xml-text
msgid ""
"Remove from <envar>ALL_LINGUAS</envar> the codes for any languages which you"
" do not wish to install. Alternatively, remove the line starting with "
"<envar>ALL_LINGUAS</envar>, if you wish to build all languages."
msgstr ""
"Remova de <envar>ALL_LINGUAS</envar> os códigos de quaisquer idiomas que "
"você não desejar instalar. Alternativamente, remova a linha que começa com "
"<envar>ALL_LINGUAS</envar>, se desejar construir todos os idiomas."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/xsoft/other/gimp.xml:283
#, xml-text
msgid "Now build the help files:"
msgstr "Agora construa os arquivos de ajuda:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/xsoft/other/gimp.xml:286
#, no-wrap, xml-text
msgid "<userinput>make</userinput>"
msgstr "<userinput>make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/xsoft/other/gimp.xml:289
#, xml-text
msgid ""
"Issue the following commands as the &root; user to install the help files:"
msgstr ""
"Emita os seguintes comandos como o(a) usuário(a) &root; para instalar os "
"arquivos de ajuda:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/xsoft/other/gimp.xml:292
#, no-wrap, xml-text
msgid ""
"<userinput>make install &amp;&amp;\n"
"chown -R root:root /usr/share/gimp/3.0/help</userinput>"
msgstr ""
"<userinput>make install &amp;&amp;\n"
"chown -R root:root /usr/share/gimp/3.0/help</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/xsoft/other/gimp.xml:298
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/xsoft/other/gimp.xml:301
#, xml-text
msgid ""
"<envar>ALL_LINGUAS=&quot;ca cs da de en en_GB es fa...&quot;</envar>: by "
"default, the help files will be rendered in all the available languages.  "
"Remove the codes of any languages you do not wish to build."
msgstr ""
"<envar>ALL_LINGUAS=&quot;ca cs da de en en_GB es fa...&quot;</envar>: por "
"padrão, os arquivos de ajuda serão renderizados em todos os idiomas "
"disponíveis. Remova os códigos de quaisquer idiomas que você não desejar "
"construir."

