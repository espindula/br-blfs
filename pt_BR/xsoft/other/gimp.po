#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/xsoft/other/gimp.xml:144
#, xml-text
msgid "Gimp Dependencies"
msgstr "Dependências do Gimp"

#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/xsoft/other/gimp.xml:146
#, xml-text
msgid "Required"
msgstr "Exigidas"

#.  en can be built without this
#.  some parts of Xorg appear to be required, as are deps it pulls in
#. type: Content of: <sect1><sect2><para>
#: blfs-en/xsoft/other/gimp.xml:148
#, xml-text
msgid ""
"<xref linkend=\"gegl\"/>, <xref linkend=\"gexiv2\"/>, <xref linkend=\"glib-"
"networking\"/>, <xref linkend=\"gtk2\"/>, <xref linkend=\"harfbuzz\"/>.  "
"<xref linkend=\"libjpeg\"/>, <xref linkend=\"libmypaint\"/>, <xref "
"linkend=\"librsvg\"/>, <xref linkend=\"libtiff\"/>, <xref "
"linkend=\"libxml2\"/> (to build the translated help files), <xref "
"linkend=\"lcms2\"/>, <xref linkend=\"mypaint-brushes\"/>, <xref "
"linkend=\"poppler\"/> (including poppler-data) and <xref linkend=\"x-window-"
"system\"/>"
msgstr ""
"<xref linkend=\"gegl\"/>, <xref linkend=\"gexiv2\"/>, <xref linkend=\"glib-"
"networking\"/>, <xref linkend=\"gtk2\"/>, <xref linkend=\"harfbuzz\"/>, "
"<xref linkend=\"libjpeg\"/>, <xref linkend=\"libmypaint\"/>, <xref linkend="
"\"librsvg\"/>, <xref linkend=\"libtiff\"/>, <xref linkend=\"libxml2\"/> ("
"para construir os arquivos traduzidos de ajuda), <xref linkend=\"lcms2\"/>, "
"<xref linkend=\"mypaint-brushes\"/>, <xref linkend=\"poppler\"/> (incluindo "
"poppler-data) e <xref linkend=\"x-window-system\"/>"

#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/xsoft/other/gimp.xml:166
#, xml-text
msgid "Recommended"
msgstr "Recomendadas"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/xsoft/other/gimp.xml:168
#, xml-text
msgid ""
"<xref linkend=\"dbus-glib\"/>, <xref linkend=\"graphviz\"/>, <xref "
"linkend=\"gs\"/> (with libgs installed), <xref linkend=\"iso-codes\"/>, "
"<xref linkend=\"libgudev\"/>, <xref linkend=\"pygtk\"/> (including the gtk, "
"pango and pangocairo modules) and <xref linkend=\"xdg-utils\"/>"
msgstr ""
"<xref linkend=\"dbus-glib\"/>, <xref linkend=\"graphviz\"/>, <xref "
"linkend=\"gs\"/> (com libgs instalado), <xref linkend=\"iso-codes\"/>, <xref"
" linkend=\"libgudev\"/>, <xref linkend=\"pygtk\"/> (incluindo os módulos "
"gtk, pango e pangocairo) e <xref linkend=\"xdg-utils\"/>"

#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/xsoft/other/gimp.xml:177
#, xml-text
msgid "Optional"
msgstr "Opcionais"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/xsoft/other/gimp.xml:179
#, xml-text
msgid ""
"<xref linkend=\"aalib\"/>, <xref linkend=\"alsa-lib\"/>, <xref "
"linkend=\"gvfs\"/> (to access the online help), <xref linkend=\"libmng\"/>, "
"<xref linkend=\"libunwind\"/>, <xref linkend=\"libwebp\"/>, <xref "
"linkend=\"openjpeg2\"/>, an <xref linkend=\"server-mail\"/> (that provides a"
" <command>sendmail</command> program), <xref linkend=\"gtk-doc\"/>, <ulink "
"url=\"https://people.freedesktop.org/~hughsient/appstream-glib\">appstream-"
"glib</ulink>, <ulink "
"url=\"https://github.com/ianlancetaylor/libbacktrace\">libbacktrace</ulink>,"
" <ulink url=\"https://github.com/strukturag/libheif/\">libheif</ulink> with "
"<ulink url=\"https://github.com/strukturag/libde265/\">libde265</ulink> "
"(both needed to read macOS heic images), <ulink "
"url=\"https://wvware.sourceforge.net/libwmf.html\">libwmf</ulink>, and "
"<ulink url=\"https://www.openexr.com/\">OpenEXR</ulink>"
msgstr ""
"<xref linkend=\"aalib\"/>, <xref linkend=\"alsa-lib\"/>, <xref "
"linkend=\"gvfs\"/> (para acessar a ajuda online), <xref "
"linkend=\"libmng\"/>, <xref linkend=\"libunwind\"/>, <xref "
"linkend=\"libwebp\"/>, <xref linkend=\"openjpeg2\"/>, um <xref "
"linkend=\"server-mail\"/> (isso fornece um aplicativo "
"<command>sendmail</command>), <xref linkend=\"gtk-doc\"/>, <ulink "
"url=\"https://people.freedesktop.org/~hughsient/appstream-glib\">appstream-"
"glib</ulink>, <ulink "
"url=\"https://github.com/ianlancetaylor/libbacktrace\">libbacktrace</ulink>,"
" <ulink url=\"https://github.com/strukturag/libheif/\">libheif</ulink> com "
"<ulink url=\"https://github.com/strukturag/libde265/\">libde265</ulink> "
"(ambos necessários para ler imagens heic do macOS), <ulink "
"url=\"https://wvware.sourceforge.net/libwmf.html\">libwmf</ulink> e <ulink "
"url=\"https://www.openexr.com/\">OpenEXR</ulink>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/xsoft/other/gimp.xml:199
#, xml-text
msgid ""
"When you have run configure, you will see that WebKit is not found - that "
"dependency is for the legacy webkit-1.0 which should never be used on a "
"modern system exposed to the internet."
msgstr ""
"Quando tiver executado o configure, você verá que o WebKit não foi "
"encontrado - essa dependência é para o legado webkit-1.0 que nunca deveria "
"ser usado em um sistema moderno exposto à Internet."

#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/xsoft/other/gimp.xml:204
#, xml-text
msgid "Optional, for building the help system"
msgstr "Opcionais, para construir o sistema de ajuda"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/xsoft/other/gimp.xml:206
#, xml-text
msgid ""
"<ulink url=\"https://dblatex.sourceforge.net/\">dblatex</ulink> (for PDF "
"docs), <ulink url=\"https://pngnq.sourceforge.net/\">pngnq</ulink> and "
"<ulink url=\"https://pmt.sourceforge.net/pngcrush/\">pngcrush</ulink> to "
"optimize the png files, but see the note on the help download above"
msgstr ""
"<ulink url=\"https://dblatex.sourceforge.net/\">dblatex</ulink> (para "
"documentos PDF), <ulink url=\"https://pngnq.sourceforge.net/\">pngnq</ulink>"
" e <ulink url=\"https://pmt.sourceforge.net/pngcrush/\">pngcrush</ulink> "
"para otimizar os arquivos png, mas veja-se a observação no download da ajuda"
" acima"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/xsoft/other/gimp.xml:212
#, xml-text
msgid "Editor Notes: <ulink url=\"&blfs-wiki;/gimp\"/>"
msgstr "Observações de Editor(a): <ulink url=\"&blfs-wiki;/gimp\"/>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/xsoft/other/gimp.xml:218
#, xml-text
msgid "Installation of Gimp"
msgstr "Instalação do Gimp"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/xsoft/other/gimp.xml:221
#, xml-text
msgid ""
"Install <application>Gimp</application> by running the following commands:"
msgstr ""
"Instale o <application>Gimp</application> executando os seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/xsoft/other/gimp.xml:225
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr --sysconfdir=/etc &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>./configure --prefix=/usr --sysconfdir=/etc &amp;&amp;\n"
"make</userinput>"

#.  km: in 2.10.16 no failures, 2 tests were skipped
#. type: Content of: <sect1><sect2><para>
#: blfs-en/xsoft/other/gimp.xml:229
#, xml-text
msgid ""
"To test the results (requires an X-Windowed terminal) issue: <command>make "
"check</command>."
msgstr ""
"Para testar os resultados (exige um terminal janelado do X): <command>make "
"check</command>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/xsoft/other/gimp.xml:236
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/xsoft/other/gimp.xml:240
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/xsoft/other/gimp.xml:248
#, xml-text
msgid "Installation of Gimp-Help"
msgstr "Instalação do Gimp-Help"

#.       The documentation generated by gimp-help-2.10.34 and online help have
#.       the same contents, so I comment this out. [pierre Nov. 2023]
#.       Because of the
#.       issues mentioned in the note above, you are recommended to use the
#. online
#.       help, either by building against <xref linkend="gvfs"/>
#.  so that 'help'
#.       can open the latest XML files in your browser, or else you can
#. manually
#.       open the html in your browser by going to <ulink
#. url="https://docs.gimp.org/2.10/en/">https://docs.gimp.org/2.10/en</ulink>
#.      (change the language code if desired).
#. type: Content of: <sect1><sect2><para>
#: blfs-en/xsoft/other/gimp.xml:251
#, xml-text
msgid ""
"The <filename>gimp-help</filename> tarball contains images and English text "
"help for help files, together with translations."
msgstr ""
"O tarball <filename>gimp-help</filename> contém imagens e texto de ajuda em "
"inglês para arquivos de ajuda, juntamente com traduções."

#.      If you nevertheless wish to install local copies of the help files to
#. read
#.       offline, u
#. type: Content of: <sect1><sect2><para>
#: blfs-en/xsoft/other/gimp.xml:266
#, xml-text
msgid ""
"Unpack the <filename>gimp-help</filename> tarball and change into the root "
"of the newly created source tree. Prepare for the build with the following "
"command:"
msgstr ""
"Desempacote o tarball <filename>gimp-help</filename> e mude para a raiz da "
"recém-criada árvore do fonte. Prepare para a construção com o seguinte "
"comando:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/xsoft/other/gimp.xml:271
#, no-wrap, xml-text
msgid ""
"<userinput>ALL_LINGUAS=&quot;ca cs da de en en_GB es fa fr hr ko lt nl nn pt pt_BR ro sl sv uk zh_CN&quot; \\\n"
"./configure --prefix=/usr</userinput>"
msgstr ""
"<userinput>ALL_LINGUAS=&quot;ca cs da de en en_GB es fa fr hr ko lt nl nn pt "
"pt_BR ro sl sv uk zh_CN&quot; \\\n"
"./configure --prefix=/usr</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/xsoft/other/gimp.xml:275
#, xml-text
msgid ""
"Remove from <envar>ALL_LINGUAS</envar> the codes for any languages which you"
" do not wish to install. Alternatively, remove the line starting with "
"<envar>ALL_LINGUAS</envar>, if you wish to build all languages."
msgstr ""
"Remova de <envar>ALL_LINGUAS</envar> os códigos de quaisquer idiomas que "
"você não desejar instalar. Alternativamente, remova a linha que começa com "
"<envar>ALL_LINGUAS</envar>, se desejar construir todos os idiomas."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/xsoft/other/gimp.xml:281
#, xml-text
msgid "Now build the help files:"
msgstr "Agora construa os arquivos de ajuda:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/xsoft/other/gimp.xml:284
#, no-wrap, xml-text
msgid "<userinput>make</userinput>"
msgstr "<userinput>make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/xsoft/other/gimp.xml:287
#, xml-text
msgid ""
"Issue the following commands as the <systemitem "
"class=\"username\">root</systemitem> user to install the help files:"
msgstr ""
"Emita os seguintes comandos como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem> para instalar os arquivos de ajuda:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/xsoft/other/gimp.xml:292
#, no-wrap, xml-text
msgid ""
"<userinput>make install &amp;&amp;\n"
"chown -R root:root /usr/share/gimp/2.0/help</userinput>"
msgstr ""
"<userinput>make install &amp;&amp;\n"
"chown -R root:root /usr/share/gimp/2.0/help</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/xsoft/other/gimp.xml:298
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/xsoft/other/gimp.xml:301
#, xml-text
msgid ""
"<envar>ALL_LINGUAS=&quot;ca cs da de en en_GB es fa...&quot;</envar>: by "
"default, the help files will be rendered in all the available languages.  "
"Remove the codes of any languages you do not wish to build."
msgstr ""
"<envar>ALL_LINGUAS=&quot;ca cs da de en en_GB es fa...&quot;</envar>: por "
"padrão, os arquivos de ajuda serão renderizados em todos os idiomas "
"disponíveis. Remova os códigos de quaisquer idiomas que você não desejar "
"construir."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/xsoft/other/gimp.xml:307
#, xml-text
msgid ""
"<option>--disable-python</option>: This option is necessary if you have not "
"installed <application>PyGTK</application>."
msgstr ""
"<option>--disable-python</option>: Essa opção é necessária se você não tiver"
" instaladoou o <application>PyGTK</application>."

#. type: Content of: <sect1><sect2><title>
#: blfs-en/xsoft/other/gimp.xml:317
#, xml-text
msgid "Configuring The Gimp"
msgstr "Configurando o Gimp"

