#. type: Content of: <sect1><sect2><title>
#: blfs-en/xsoft/other/transmission.xml:111
#, xml-text
msgid "Installation of Transmission"
msgstr "Instalação do Transmission"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/xsoft/other/transmission.xml:114
#, xml-text
msgid ""
"Install <application>Transmission</application> by running the following "
"commands:"
msgstr ""
"Instale o <application>Transmission</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/xsoft/other/transmission.xml:118
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -DCMAKE_INSTALL_PREFIX=/usr \\\n"
"      -DCMAKE_BUILD_TYPE=Release  \\\n"
"      -DCMAKE_INSTALL_DOCDIR=/usr/share/doc/transmission-&transmission-version; \\\n"
"      .. &amp;&amp;\n"
"\n"
"make</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -DCMAKE_INSTALL_PREFIX=/usr \\\n"
"      -DCMAKE_BUILD_TYPE=Release  \\\n"
"      -DCMAKE_INSTALL_DOCDIR=/usr/share/doc/transmission-&transmission-version; \\\n"
"      .. &amp;&amp;\n"
"\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/xsoft/other/transmission.xml:130
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/xsoft/other/transmission.xml:133
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/xsoft/other/transmission.xml:136
#, xml-text
msgid "Next, create transmission.png from the SVG file:"
msgstr "A seguir, crie transmission.png a partir do arquivo SVG:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/xsoft/other/transmission.xml:139
#, no-wrap, xml-text
msgid ""
"<userinput>rsvg-convert                                               \\\n"
"   /usr/share/icons/hicolor/scalable/apps/transmission.svg \\\n"
"   -o /usr/share/pixmaps/transmission.png</userinput>"
msgstr ""
"<userinput>rsvg-convert                                               \\\n"
"   /usr/share/icons/hicolor/scalable/apps/transmission.svg \\\n"
"   -o /usr/share/pixmaps/transmission.png</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/xsoft/other/transmission.xml:146
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/xsoft/other/transmission.xml:149
#, xml-text
msgid ""
"<option>-DENABLE_QT=OFF</option>: This switch disables building the "
"<application>Qt</application> interface. The default is to build it if "
"&qt5-deps; or <xref linkend=\"qt6\"/> is installed."
msgstr ""
"<option>-DENABLE_QT=OFF</option>: Essa chave desabilita construir a "
"interface <application>Qt</application>. O padrão é o de construí-la se "
"&qt5-deps;, ou <xref linkend=\"qt6\"/>, estiver instalado."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/xsoft/other/transmission.xml:155
#, xml-text
msgid ""
"<option>-DENABLE_GTK=OFF</option>: This switch disables building the GTK+-3 "
"interface. The default is to build it if <xref linkend=\"gtkmm3\"/> is "
"installed."
msgstr ""
"<option>-DENABLE_GTK=OFF</option>: Essa chave desabilita construir a "
"interface GTK+-3. O padrão é o de construí-la se o <xref linkend=\"gtkmm3\"/"
"> estiver instalado."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/xsoft/other/transmission.xml:161
#, xml-text
msgid ""
"<option>-DENABLE_WEB=OFF</option>: This switch disables building the web "
"client. The default is to build it if <xref linkend=\"nodejs\"/> is "
"installed."
msgstr ""
"<option>-DENABLE_WEB=OFF</option>: Essa chave desabilita a construção do "
"cliente web. O padrão é o de construí-lo se o <xref linkend=\"nodejs\"/> "
"estiver instalado."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/xsoft/other/transmission.xml:167
#, xml-text
msgid ""
"<option>-DREBUILD_WEB=ON</option>: This switch forces rebuilding the web "
"client. This option needs <xref linkend=\"nodejs\"/> to be installed as well"
" as an internet connection. The default is to not rebuild the client."
msgstr ""
"<option>-DREBUILD_WEB=ON</option>: Essa chave força reconstruir o cliente "
"web. Essa opção precisa de <xref linkend=\"nodejs\"/> para ser instalado bem "
"como de uma conexão de internet. O padrão é o de não reconstruir o cliente."

