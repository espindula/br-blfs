#. type: Content of: <sect1><sect2><segmentedlist><seglistitem><seg>
#: blfs-en/xsoft/other/pidgin.xml:310
#, xml-text
msgid ""
"/usr/include/libpurple, /usr/include/pidgin, /usr/lib/pidgin, "
"/usr/lib/purple-2, /usr/share/doc/pidgin-&pidgin-version;, "
