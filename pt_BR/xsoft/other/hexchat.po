#. type: Content of: <sect1><sect2><title>
#: blfs-en/xsoft/other/hexchat.xml:120
#, xml-text
msgid "Installation of HexChat"
msgstr "Instalação do HexChat"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/xsoft/other/hexchat.xml:138
#, xml-text
msgid ""
"Install <application>HexChat</application> by running the following "
"commands:"
msgstr ""
"Instale o <application>HexChat</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/xsoft/other/hexchat.xml:142
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup ..              \\\n"
"      --prefix=/usr         \\\n"
"      --buildtype=release   \\\n"
"      -Dwith-lua=false      \\\n"
"      -Dwith-python=false   &amp;&amp;\n"
"ninja</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup ..              \\\n"
"      --prefix=/usr         \\\n"
"      --buildtype=release   \\\n"
"      -Dwith-lua=false      \\\n"
"      -Dwith-python=false   &amp;&amp;\n"
"ninja</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/xsoft/other/hexchat.xml:153
#, xml-text
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/xsoft/other/hexchat.xml:157
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/xsoft/other/hexchat.xml:160
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr "<userinput>ninja install</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/xsoft/other/hexchat.xml:165
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/xsoft/other/hexchat.xml:175
#, xml-text
msgid ""
"<parameter>-Dwith-lua=false</parameter>: By default, this package will look "
"for luajit. However, the Lua plugin support is currently broken and will "
"cause the application to crash on startup."
msgstr ""
"<parameter>-Dwith-lua=false</parameter>: Por padrão, esse pacote procurará "
"por luajit. No entanto, o suporte ao plugin Lua atualmente está quebrado e "
"fará com que o aplicativo trave na inicialização."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/xsoft/other/hexchat.xml:181
#, xml-text
msgid ""
"<parameter>-Dwith-python=false</parameter>: If the Python interface should "
"be enabled, remove this switch or set it to <literal>true</literal>.  When "
"enabling Python, two additional modules (cffi and pycparser)  needs to be "
"installed prior to installation of <application>Hexchat</application>."
msgstr ""
"<parameter>-Dwith-python=false</parameter>: Se a interface Python precisasse"
" ser habilitada, remova essa chave ou configure-a como "
"<literal>true</literal>. Ao habilitar o Python, dois módulos adicionais "
"(cffi e pycparser) precisam ser instalados antes da instalação do "
"<application>Hexchat</application>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/xsoft/other/hexchat.xml:188
#, xml-text
msgid ""
"<option>-Dwith-libcanberra=false</option>: Use this switch if you have "
"libcanberra not installed."
msgstr ""
"<option>-Dwith-libcanberra=false</option>: Use essa chave se você não tiver "
"a libcanberra instalada."

