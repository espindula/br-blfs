#. type: Content of: <sect1><sect2><title>
#: blfs-en/xsoft/other/balsa.xml:129
#, xml-text
msgid "Installation of Balsa"
msgstr "Instalação do Balsa"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/xsoft/other/balsa.xml:132
#, xml-text
msgid ""
"First, fix build issues when configuring without WebKitGTK, or when using "
"WebKitGTK-2.38 or later."
msgstr ""
"Primeiro, corrija problemas de construção ao configurar sem WebKitGTK ou ao "
"usar WebKitGTK-2.38 ou posterior."

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/xsoft/other/balsa.xml:136
#, no-wrap, xml-text
msgid ""
"<userinput>patch -Np1 -i ../balsa-&balsa-"
"version;-upstream_fixes-2.patch</userinput>"
msgstr ""
"<userinput>patch -Np1 -i ../balsa-&balsa-"
"version;-upstream_fixes-2.patch</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/xsoft/other/balsa.xml:139
#, xml-text
msgid ""
"Install <application>Balsa</application> by running the following commands:"
msgstr ""
"Instale o <application>Balsa</application> executando os seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/xsoft/other/balsa.xml:143
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr            \\\n"
"            --sysconfdir=/etc        \\\n"
"            --localstatedir=/var/lib \\\n"
"            --without-html-widget    &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>./configure --prefix=/usr            \\\n"
"            --sysconfdir=/etc        \\\n"
"            --localstatedir=/var/lib \\\n"
"            --without-html-widget    &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/xsoft/other/balsa.xml:150
#, xml-text
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/xsoft/other/balsa.xml:154
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/xsoft/other/balsa.xml:157
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/xsoft/other/balsa.xml:162
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/xsoft/other/balsa.xml:179
#, xml-text
msgid ""
"<parameter>--without-html-widget</parameter>: This option disables building "
"the HTML renderer. If you want the HTML renderer to be built, verify that "
"you have <xref linkend=\"webkitgtk\"/> installed, and then remove this "
"option."
msgstr ""
"<parameter>--without-html-widget</parameter>: Essa opção desabilita a "
"construção do renderizador HTML. Se você quiser que o renderizador HTML seja"
" construído, verifique se você tem o <xref linkend=\"webkitgtk\"/> instalado"
" e, então, remova essa opção."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/xsoft/other/balsa.xml:186
#, xml-text
msgid "<option>--with-canberra</option>: Enable libcanberra support."
msgstr "<option>--with-canberra</option>: Habilita suporte a libcanberra."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/xsoft/other/balsa.xml:190
#, xml-text
msgid "<option>--with-compface</option>: Enable compface support."
msgstr "<option>--with-compface</option>: Habilita suporte a compface."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/xsoft/other/balsa.xml:194
#, xml-text
msgid "<option>--with-gcr</option>: Use libgcr for TLS support."
msgstr "<option>--with-gcr</option>: Usa libgcr para suporte TLS."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/xsoft/other/balsa.xml:198
#, xml-text
msgid "<option>--with-gss</option>: Enable GSSAPI support."
msgstr "<option>--with-gss</option>: Habilita suporte GSSAPI."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/xsoft/other/balsa.xml:202
#, xml-text
msgid ""
"<option>--with-ldap</option>: Use this option to enable LDAP address book "
"support if <application>OpenLDAP</application> is installed."
msgstr ""
"<option>--with-ldap</option>: Use essa opção para habilitar o suporte ao "
"catálogo de endereços LDAP se o <application>OpenLDAP</application> estiver "
"instalado."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/xsoft/other/balsa.xml:207
#, xml-text
msgid ""
"<option>--with-libsecret</option>: Enable strong password support and "
"support for gnome-keyring to store passwords."
msgstr ""
"<option>--with-libsecret</option>: Habilita suporte a senhas fortes e "
"suporte para o gnome-keyring armazenar senhas."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/xsoft/other/balsa.xml:220
#, xml-text
msgid ""
"<option>--with-sqlite</option>: Use this option to enable SQLite address "
"book support if <application>SQLite</application> is installed."
msgstr ""
"<option>--with-sqlite</option>: Use essa opção para habilitar o suporte ao "
"catálogo de endereços SQLite se o <application>SQLite</application> estiver "
"instalado."

