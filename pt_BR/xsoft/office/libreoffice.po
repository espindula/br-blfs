#, xml-text
msgid ""
"<xref linkend=\"perl-archive-zip\"/>, <xref linkend=\"unzip\"/>, <xref "
"linkend=\"wget\"/>, <xref linkend=\"which\"/>, and <xref linkend=\"zip\"/>"
msgstr ""
