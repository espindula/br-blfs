#, xml-text
msgid ""
"<xref linkend=\"extra-cmake-modules\"/>, <xref linkend=\"kf5-frameworks\"/> "
"(for karchive), and <xref linkend=\"qtwebengine\"/>"
msgstr ""
"<xref linkend=\"extra-cmake-modules\"/>, <xref linkend=\"kf5-frameworks\"/> "
