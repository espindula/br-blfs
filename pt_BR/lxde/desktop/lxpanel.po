#. type: Content of: <sect1><indexterm><primary>
#: blfs-en/lxde/desktop/lxpanel.xml:22
msgid "LXPanel"
msgstr "LXPanel"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/lxde/desktop/lxpanel.xml:26
msgid "Introduction to LXPanel"
msgstr "Introdução ao LXPanel"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/lxde/desktop/lxpanel.xml:29
msgid ""
"The <application>LXPanel</application> package contains a lightweight X11 "
"desktop panel."
msgstr ""
"O pacote <application>LXPanel</application> contém um painel leve de área de "
"trabalho do X11."

#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/lxde/desktop/lxpanel.xml:35
msgid "Package Information"
msgstr "Informação do Pacote"

#. type: Content of: <sect1><sect2><itemizedlist><listitem><para>
#: blfs-en/lxde/desktop/lxpanel.xml:39
msgid "Download (HTTP): <ulink url=\"&lxpanel-download-http;\"/>"
msgstr "Transferência (HTTP): <ulink url=\"&lxpanel-download-http;\"/>"

#. type: Content of: <sect1><sect2><itemizedlist><listitem><para>
#: blfs-en/lxde/desktop/lxpanel.xml:44
msgid "Download (FTP): <ulink url=\"&lxpanel-download-ftp;\"/>"
msgstr "Transferência (FTP): <ulink url=\"&lxpanel-download-ftp;\"/>"

#. type: Content of: <sect1><sect2><itemizedlist><listitem><para>
#: blfs-en/lxde/desktop/lxpanel.xml:49
msgid "Download MD5 sum: &lxpanel-md5sum;"
msgstr "Soma de verificação MD5 da transferência: &lxpanel-md5sum;"

#. type: Content of: <sect1><sect2><itemizedlist><listitem><para>
#: blfs-en/lxde/desktop/lxpanel.xml:54
msgid "Download size: &lxpanel-size;"
msgstr "Tamanho da transferência: &lxpanel-size;"

#. type: Content of: <sect1><sect2><itemizedlist><listitem><para>
#: blfs-en/lxde/desktop/lxpanel.xml:59
msgid "Estimated disk space required: &lxpanel-buildsize;"
msgstr "Espaço em disco estimado exigido: &lxpanel-buildsize;"

#. type: Content of: <sect1><sect2><itemizedlist><listitem><para>
#: blfs-en/lxde/desktop/lxpanel.xml:64
msgid "Estimated build time: &lxpanel-time;"
msgstr "Tempo de construção estimado: &lxpanel-time;"

#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/lxde/desktop/lxpanel.xml:69
msgid "LXPanel Dependencies"
msgstr "Dependências do LXPanel"

#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/lxde/desktop/lxpanel.xml:71
msgid "Required"
msgstr "Exigidas"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/lxde/desktop/lxpanel.xml:73
msgid ""
"<xref linkend=\"gdk-pixbuf-xlib\"/>, <xref linkend=\"keybinder2\"/>, <xref "
"linkend=\"libwnck2\"/>, <xref linkend=\"lxmenu-data\"/> and <xref "
"linkend=\"menu-cache\"/>"
msgstr ""
"<xref linkend=\"gdk-pixbuf-xlib\"/>, <xref linkend=\"keybinder2\"/>, <xref "
"linkend=\"libwnck2\"/>, <xref linkend=\"lxmenu-data\"/> e <xref "
"linkend=\"menu-cache\"/>"

#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/lxde/desktop/lxpanel.xml:80
msgid "Recommended"
msgstr "Recomendadas"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/lxde/desktop/lxpanel.xml:82
msgid ""
"<xref linkend=\"alsa-lib\"/>, <xref linkend=\"gnome-screenshot\"/> (to take "
"screenshots using PrtScr), <xref linkend=\"libxml2\"/> (weather plugin), and "
"<xref linkend=\"wireless_tools\"/>"
msgstr ""
"<xref linkend=\"alsa-lib\"/>, <xref linkend=\"gnome-screenshot\"/> (para "
"fazer capturas de tela usando o PrtScr), <xref linkend=\"libxml2\"/> (plugin "
"de clima) e <xref linkend=\"wireless_tools\"/>"

#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/lxde/desktop/lxpanel.xml:88
msgid "Optional"
msgstr "Opcionais"

#.       <xref linkend="libxslt"/>
#.  with
#.       <xref linkend="DocBook"/> and
#.       <xref linkend="docbook-xsl"/> (to build man pages)
#. type: Content of: <sect1><sect2><para>
#: blfs-en/lxde/desktop/lxpanel.xml:90
msgid ""
"<ulink url=\"https://launchpad.net/libindicator/\">libindicator</ulink> "
"(indicator plugin)"
msgstr ""
"<ulink url=\"https://launchpad.net/libindicator/\">libindicator</ulink> "
"(plugin indicador)"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/lxde/desktop/lxpanel.xml:100
msgid "Installation of LXPanel"
msgstr "Instalação do LXPanel"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/lxde/desktop/lxpanel.xml:103
msgid ""
"Install <application>LXPanel</application> by running the following commands:"
msgstr ""
"Instale o <application>LXPanel</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/lxde/desktop/lxpanel.xml:107
#, no-wrap
msgid ""
"<userinput>./configure --prefix=/usr &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>./configure --prefix=/usr &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/lxde/desktop/lxpanel.xml:111
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/lxde/desktop/lxpanel.xml:115
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/lxde/desktop/lxpanel.xml:118
#, no-wrap
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

