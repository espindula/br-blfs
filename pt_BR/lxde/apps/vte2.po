#. type: Content of: <sect1><sect2><title>
#: blfs-en/lxde/apps/vte2.xml:88
msgid "Installation of Vte"
msgstr "Instalação do Vte"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/lxde/apps/vte2.xml:91
msgid ""
"Install <application>Vte</application> by running the following commands:"
msgstr ""
"Instale o <application>Vte</application> executando os seguintes comandos:"

#.  both vte2 and vte3 install the same file in libexecdir, so overwrite this one 
#. type: Content of: <sect1><sect2><screen>
#: blfs-en/lxde/apps/vte2.xml:96
#, no-wrap
msgid ""
"<userinput>./configure --prefix=/usr \\\n"
"            --libexecdir=/usr/lib/vte \\\n"
"            --disable-static  &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>./configure --prefix=/usr \\\n"
"            --libexecdir=/usr/lib/vte \\\n"
"            --disable-static  &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/lxde/apps/vte2.xml:102
msgid "To test the results, issue: <command>make check</command>."
msgstr "Para testar os resultados, emita: <command>make check</command>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/lxde/apps/vte2.xml:106
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/lxde/apps/vte2.xml:109
#, no-wrap
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/lxde/apps/vte2.xml:114
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/lxde/apps/vte2.xml:117
msgid ""
"<parameter>--libexecdir=/usr/lib/vte</parameter> : both this package and "
"<xref linkend=\"vte\"/> install files of the same name. This switch ensures "
"that they do not overwrite each other if both are installed."
msgstr ""
"<parameter>--libexecdir=/usr/lib/vte</parameter> : tanto esse pacote quanto "
"o <xref linkend=\"vte\"/> instalam arquivos de mesmo nome. Essa chave "
"garante que eles não se sobrescrevam se ambos forem instalados."

