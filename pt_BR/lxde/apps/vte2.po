#. type: Content of: <sect1><sect2><title>
#: blfs-en/lxde/apps/vte2.xml:26
msgid "Introduction to Vte"
msgstr "Introdução ao Vte"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/lxde/apps/vte2.xml:29
msgid ""
"<application>Vte</application> is a library (libvte) implementing a terminal "
"emulator widget for <application>GTK+ 2</application>, and a minimal "
"demonstration application (vte) that uses <application>libvte</application>."
msgstr ""
"<application>Vte</application> é uma biblioteca (libvte) que implementa uma "
"pequena engenhoca de emulador de terminal para <application>GTK+ 2</"
"application> e um aplicativo mínimo de demonstração (vte) que usa a "
"<application>libvte</application>."

