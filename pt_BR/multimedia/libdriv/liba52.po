#. type: Content of: <sect1><sect2><title>
#: blfs-en/multimedia/libdriv/liba52.xml:82
#, xml-text
msgid "Installation of Liba52"
msgstr "Instalação do Liba52"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/liba52.xml:85
#, xml-text
msgid ""
"Install <application>liba52</application> by running the following commands:"
msgstr ""
"Instale o <application>liba52</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/multimedia/libdriv/liba52.xml:89
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr           \\\n"
"            --mandir=/usr/share/man \\\n"
"            --enable-shared         \\\n"
"            --disable-static        \\\n"
"            CFLAGS=\"${CFLAGS:--g -O3} -fPIC\" &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>./configure --prefix=/usr           \\\n"
"            --mandir=/usr/share/man \\\n"
"            --enable-shared         \\\n"
"            --disable-static        \\\n"
"            CFLAGS=\"${CFLAGS:--g -O3} -fPIC\" &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/liba52.xml:97
#, xml-text
msgid "To test the results, issue: <command>make check</command>."
msgstr "Para testar os resultados, emita: <command>make check</command>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/liba52.xml:101
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/multimedia/libdriv/liba52.xml:105
#, no-wrap, xml-text
msgid ""
"<userinput>make install &amp;&amp;\n"
"cp liba52/a52_internal.h /usr/include/a52dec &amp;&amp;\n"
"install -v -m644 -D doc/liba52.txt \\\n"
"    /usr/share/doc/liba52-&liba52-version;/liba52.txt</userinput>"
msgstr ""
"<userinput>make install &amp;&amp;\n"
"cp liba52/a52_internal.h /usr/include/a52dec &amp;&amp;\n"
"install -v -m644 -D doc/liba52.txt \\\n"
"    /usr/share/doc/liba52-&liba52-version;/liba52.txt</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/multimedia/libdriv/liba52.xml:112
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/liba52.xml:115
#, xml-text
msgid ""
"<parameter>CFLAGS=\"${CFLAGS:--g -O3} -fPIC\"</parameter>: This appends "
"<option>-fPIC</option> to <envar>CFLAGS</envar> but use <option>-g "
"-O3</option> (the default of this package) instead of an empty string when "
"<envar>CFLAGS</envar> is not set.  This is needed to compile "
"<application>liba52</application> without runtime text relocation.  Runtime "
"text relocation is prohibited on x86_64 so <option>-fPIC</option> is "
"strictly required.  On 32-bit x86 runtime text relocation is allowed but "
"it's insecure and it may waste physical RAM, so <option>-fPIC</option> is "
"still better."
msgstr ""
"<parameter>CFLAGS=\"${CFLAGS:--g -O3} -fPIC\"</parameter>: Isso anexa "
"<option>-fPIC</option> a <envar>CFLAGS</envar>, mas usa <option>- g -O3</"
"option> (o padrão desse pacote) em vez de uma sequência vazia de caracteres "
"quando <envar>CFLAGS</envar> não estiver configurada. Isso é necessário para "
"compilar <application>liba52</application> sem realocação de texto em tempo "
"de execução. A realocação de texto em tempo de execução é proibida no "
"x86_64, de forma que <option>-fPIC</option> é estritamente exigido. No x86 "
"de 32 bits, a realocação de texto em tempo de execução é permitida, mas é "
"insegura e pode desperdiçar RAM física; portanto, <option>-fPIC</option> "
"ainda é melhor."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/liba52.xml:130
#, xml-text
msgid ""
"<command>cp liba52/a52_internal.h ...</command>: Copying this header file "
"into /usr/include/a52dec allows some other programs (such as "
"<application>xine-lib</application>) to compile and link against a system "
"installed <application>liba52</application>."
msgstr ""
"<command>cp liba52/a52_internal.h ...</command>: Copiar esse arquivo de "
"cabeçalho para /usr/include/a52dec permite que alguns outros aplicativos "
"(como o <application>xine-lib</application>) compilem e vinculem contra uma "
"<application>liba52</application> instalada no sistema."

