#. type: Content of: <sect1><sect2><title>
#: blfs-en/multimedia/libdriv/libplacebo.xml:95
#, xml-text
msgid "Installation of libplacebo"
msgstr "Instalação do libplacebo"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/libplacebo.xml:98
#, xml-text
msgid ""
"Install <application>libplacebo</application> by running the following "
"commands:"
msgstr ""
"Instale <application>libplacebo</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/multimedia/libdriv/libplacebo.xml:102
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup ..            \\\n"
"      --prefix=/usr       \\\n"
"      --buildtype=release \\\n"
"      -Dtests=true        \\\n"
"      -Ddemos=false       &amp;&amp;\n"
"ninja</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup ..            \\\n"
"      --prefix=/usr       \\\n"
"      --buildtype=release \\\n"
"      -Dtests=true        \\\n"
"      -Ddemos=false       &amp;&amp;\n"
"ninja</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/libplacebo.xml:113
#, xml-text
msgid ""
"To test the results, issue: <command>ninja test</command>.  One test, "
"opengl_surfaceless.c, is known to fail."
msgstr ""
"Para testar os resultados, emita: <command>ninja test</command>. Um teste, "
"opengl_surfaceless.c, é conhecido por falhar."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/libplacebo.xml:118
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/multimedia/libdriv/libplacebo.xml:121
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr "<userinput>ninja install</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/multimedia/libdriv/libplacebo.xml:126
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/libplacebo.xml:132
#, xml-text
msgid ""
"<parameter>-Ddemos=false</parameter>: This switch disables building the demo"
" programs because building <application>plplay</application> is currently "
"broken."
msgstr ""
"<parameter>-Ddemos=false</parameter>: Essa chave desabilita construir os "
"programas de demonstração, porque construir "
"<application>plplay</application> atualmente está quebrado."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/libplacebo.xml:138
#, xml-text
msgid ""
"<parameter>-Dtests=true</parameter>: This switch enables building the code "
"necessary to run the tests."
msgstr ""
"<parameter>-Dtests=true</parameter>: Essa chave habilita construir o código "
"necessário para executar os testes."

