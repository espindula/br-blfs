#. type: Content of: <sect1><sect2><title>
#: blfs-en/multimedia/libdriv/alsa-firmware.xml:84
#, xml-text
msgid "Installation of ALSA Firmware"
msgstr "Instalação do ALSA Firmware"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/alsa-firmware.xml:87
#, xml-text
msgid ""
"The <application>ALSA Firmware</application> package is only needed by those"
" with advanced requirements for their sound card. See the README for "
"configure options."
msgstr ""
"O pacote <application>ALSA Firmware</application> somente é necessário para "
"aqueles(as) com requisitos avançados para a placa de som deles(as). Veja-se "
"o README para opções de configuração."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/alsa-firmware.xml:93
#, xml-text
msgid ""
"Install <application>ALSA Firmware</application> by running the following "
"commands:"
msgstr ""
"Instale o <application>ALSA Firmware</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/multimedia/libdriv/alsa-firmware.xml:97
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>./configure --prefix=/usr &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/alsa-firmware.xml:101
#, xml-text
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/alsa-firmware.xml:105
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/multimedia/libdriv/alsa-firmware.xml:108
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

