#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/libsndfile.xml:30
#, xml-text
msgid ""
"<application>Libsndfile</application> is a library of C routines for reading"
" and writing files containing sampled audio data."
msgstr ""
"<application>Libsndfile</application> é uma biblioteca de rotinas C para "
"leitura e escrita de arquivos contendo dados amostrados de áudio."

