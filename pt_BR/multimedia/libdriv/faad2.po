#. type: Content of: <sect1><sect2><title>
#: blfs-en/multimedia/libdriv/faad2.xml:89
#, xml-text
msgid "Installation of FAAD2"
msgstr "Instalação do FAAD2"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/faad2.xml:92
#, xml-text
msgid ""
"Install <application>FAAD2</application> by running the following commands:"
msgstr ""
"Instale o <application>FAAD2</application> executando os seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/multimedia/libdriv/faad2.xml:96
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr \\\n"
"      -D CMAKE_BUILD_TYPE=Release  \\\n"
"      -D BUILD_SHARED_LIBS=ON      \\\n"
"      .. &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr \\\n"
"      -D CMAKE_BUILD_TYPE=Release  \\\n"
"      -D BUILD_SHARED_LIBS=ON      \\\n"
"      .. &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/faad2.xml:106
#, xml-text
msgid ""
"This package does not come with a test suite. However, basic functionality "
"can be tested by decoding the sample AAC file:"
msgstr ""
"Esse pacote não vem com uma suíte de teste. No entanto, a funcionalidade "
"básica pode ser testada decodificando-se o arquivo AAC de amostra:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/multimedia/libdriv/faad2.xml:110
#, no-wrap, xml-text
msgid "<userinput>./faad -o sample.wav ../../sample.aac</userinput>"
msgstr "<userinput>./faad -o sample.wav ../../sample.aac</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/faad2.xml:113
#, xml-text
msgid ""
"This should display a copyright message and the following information about "
"the sample file:"
msgstr ""
"Isso deveria exibir uma mensagem de direitos autorais e as seguintes "
"informações a respeito do arquivo de amostra:"

#. type: Content of: <sect1><sect2><literallayout>
#: blfs-en/multimedia/libdriv/faad2.xml:117
#, no-wrap, xml-text
msgid ""
"<computeroutput>sample.aac file info:\n"
"ADTS, 4.608 sec, 13 kbps, 16000 Hz\n"
"\n"
"  ---------------------\n"
" | Config:  2 Ch       |\n"
"  ---------------------\n"
" | Ch |    Position    |\n"
"  ---------------------\n"
" | 00 | Left front     |\n"
" | 01 | Right front    |\n"
"  ---------------------</computeroutput>"
msgstr ""
"<computeroutput>sample.aac file info:\n"
"ADTS, 4.608 sec, 13 kbps, 16000 Hz\n"
"\n"
"  ---------------------\n"
" | Config:  2 Ch       |\n"
"  ---------------------\n"
" | Ch |    Position    |\n"
"  ---------------------\n"
" | 00 | Left front     |\n"
" | 01 | Right front    |\n"
"  ---------------------</computeroutput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/faad2.xml:130
#, xml-text
msgid ""
"Now play the result (requires the <command>aplay</command> program from the "
"<xref linkend=\"alsa-utils\"/> package):"
msgstr ""
"Agora reproduza o resultado (exige o aplicativo <command>aplay</command> "
"originário do pacote <xref linkend=\"alsa-utils\"/>):"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/multimedia/libdriv/faad2.xml:134
#, no-wrap, xml-text
msgid "<userinput>aplay sample.wav</userinput>"
msgstr "<userinput>aplay sample.wav</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/faad2.xml:137
#, xml-text
msgid ""
"<command>aplay</command> should identify the file as <computeroutput>Signed "
"16 bit Little Endian, Rate 16000 Hz, Stereo</computeroutput>, and you should"
" hear some piano notes."
msgstr ""
"<command>aplay</command> deveria identificar o arquivo como "
"<computeroutput>Signed 16 bit Little Endian, Rate 16000 Hz, "
"Stereo</computeroutput>, e você deveria escutar algumas notas de piano."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/faad2.xml:143
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/multimedia/libdriv/faad2.xml:146
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

