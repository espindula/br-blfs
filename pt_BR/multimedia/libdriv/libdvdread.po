#. type: Content of: <sect1><sect2><title>
#: blfs-en/multimedia/libdriv/libdvdread.xml:72
#, xml-text
msgid "Installation of Libdvdread"
msgstr "Instalação do Libdvdread"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/libdvdread.xml:75
#, xml-text
msgid ""
"Install <application>libdvdread</application> by running the following "
"commands:"
msgstr ""
"Instale o <application>libdvdread</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/multimedia/libdriv/libdvdread.xml:79
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr    \\\n"
"            --disable-static \\\n"
"            --docdir=/usr/share/doc/libdvdread-&libdvdread-version; &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>./configure --prefix=/usr    \\\n"
"            --disable-static \\\n"
"            --docdir=/usr/share/doc/libdvdread-&libdvdread-version; &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/libdvdread.xml:85
#, xml-text
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/libdvdread.xml:89
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/multimedia/libdriv/libdvdread.xml:92
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

