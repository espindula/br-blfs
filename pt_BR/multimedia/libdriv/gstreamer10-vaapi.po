#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/gstreamer10-vaapi.xml:102
#, xml-text
msgid ""
"Install <application>gstreamer-vaapi</application> by running the following "
"commands:"
msgstr ""
"Instale o <application>gstreamer-vaapi</application> executando os seguintes"
" comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/multimedia/libdriv/gstreamer10-vaapi.xml:106
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup ..            \\\n"
"      --prefix=/usr       \\\n"
"      --buildtype=release \\\n"
"      -Dpackage-origin=https://www.linuxfromscratch.org/blfs/view/&blfs-version;/ &amp;&amp;\n"
"ninja</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup ..            \\\n"
"      --prefix=/usr       \\\n"
"      --buildtype=release \\\n"
"      -Dpackage-origin=https://www.linuxfromscratch.org/blfs/view/&blfs-version;/ &amp;&amp;\n"
"ninja</userinput>"

