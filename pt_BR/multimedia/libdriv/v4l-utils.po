#. type: Content of: <sect1><sect2><title>
#: blfs-en/multimedia/libdriv/v4l-utils.xml:103
#, xml-text
msgid "Installation of v4l-utils"
msgstr "Instalação do v4l-utils"

#. type: Content of: <sect1><sect2><note><para>
#: blfs-en/multimedia/libdriv/v4l-utils.xml:107
#, xml-text
msgid ""
"If you've installed both LLVM and libbpf (not in BLFS), either enable the "
"BPF target (via <option>-DLLVM_TARGETS_TO_BUILD=</option>) building LLVM, or"
" disable the infrared remote control decoders based on BPF:"
msgstr ""
"Se você tiver instalado o LLVM e a libbpf (não no BLFS), ou habilite o alvo "
"BPF (via <option>-DLLVM_TARGETS_TO_BUILD=</option>) construindo o LLVM ou "
"desabilite os decodificadores de controle remoto infravermelho baseados em "
"BPF:"

#.  not "nodump" because it's harmless for BLFS anyway
#. type: Content of: <sect1><sect2><note><screen>
#: blfs-en/multimedia/libdriv/v4l-utils.xml:114
#, no-wrap, xml-text
msgid ""
"<userinput>sed -i '/^ir_bpf_enabled/s/=.*/= false/' "
"utils/keytable/meson.build</userinput>"
msgstr ""
"<userinput>sed -i '/^ir_bpf_enabled/s/=.*/= false/' "
"utils/keytable/meson.build</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/v4l-utils.xml:118
#, xml-text
msgid ""
"Install <application>v4l-utils</application> by running the following "
"commands:"
msgstr ""
"Instale o <application>v4l-utils</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/multimedia/libdriv/v4l-utils.xml:122
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr           \\\n"
"            -D doxygen-doc=disabled \\\n"
"            -D gconv=disabled       \\\n"
"            --buildtype=release     .. &amp;&amp;\n"
"ninja</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr           \\\n"
"            -D doxygen-doc=disabled \\\n"
"            -D gconv=disabled       \\\n"
"            --buildtype=release     .. &amp;&amp;\n"
"ninja</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/v4l-utils.xml:132
#, xml-text
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/v4l-utils.xml:136
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/multimedia/libdriv/v4l-utils.xml:139
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr "<userinput>ninja install</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/v4l-utils.xml:142
#, xml-text
msgid "If you also wish to install the contrib programs, add:"
msgstr "Se você também desejar instalar os programas contrib, adicione:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/multimedia/libdriv/v4l-utils.xml:145
#, no-wrap, xml-text
msgid ""
"<userinput>for prog in v4l2gl v4l2grab\n"
"do\n"
"   cp -v contrib/test/$prog /usr/bin\n"
"done</userinput>"
msgstr ""
"<userinput>for prog in v4l2gl v4l2grab\n"
"do\n"
"   cp -v contrib/test/$prog /usr/bin\n"
"done</userinput>"

