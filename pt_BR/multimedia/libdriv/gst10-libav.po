#. type: Content of: <sect1><sect2><title>
#: blfs-en/multimedia/libdriv/gst10-libav.xml:92
#, xml-text
msgid "Installation of GStreamer Libav"
msgstr "Instalação do GStreamer Libav"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/gst10-libav.xml:95
#, xml-text
msgid ""
"Install <application>GStreamer Libav</application> by running the following "
"commands:"
msgstr ""
"Instale o <application>GStreamer Libav</application> executando os seguintes"
" comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/multimedia/libdriv/gst10-libav.xml:99
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson  setup ..            \\\n"
"       --prefix=/usr       \\\n"
"       --buildtype=release \\\n"
"       -Dpackage-origin=https://www.linuxfromscratch.org/blfs/view/&blfs-version;/ \\\n"
"       -Dpackage-name=\"GStreamer &gst10-libav-version; BLFS\" &amp;&amp;\n"
"ninja</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson  setup ..            \\\n"
"       --prefix=/usr       \\\n"
"       --buildtype=release \\\n"
"       -Dpackage-origin=https://www.linuxfromscratch.org/blfs/view/&blfs-version;/ \\\n"
"       -Dpackage-name=\"GStreamer &gst10-libav-version; BLFS\" &amp;&amp;\n"
"ninja</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/gst10-libav.xml:111
#, xml-text
msgid "To run the tests, issue: <command>ninja test</command>."
msgstr "Para executar os testes, emita: <command>ninja test</command>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/gst10-libav.xml:115
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/multimedia/libdriv/gst10-libav.xml:118
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr "<userinput>ninja install</userinput>"

