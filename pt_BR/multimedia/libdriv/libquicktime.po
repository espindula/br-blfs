#. type: Content of: <sect1><sect2><title>
#: blfs-en/multimedia/libdriv/libquicktime.xml:109
#, xml-text
msgid "Installation of libquicktime"
msgstr "Instalação do libquicktime"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/libquicktime.xml:112
#, xml-text
msgid "First fix an issue with gcc14:"
msgstr "Primeiro corrija um problema com gcc14:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/multimedia/libdriv/libquicktime.xml:115
#, no-wrap, xml-text
msgid ""
"<userinput>sed -i '/qtpng.h/a #include &lt;string.h&gt;' "
"plugins/png/qtpng.c</userinput>"
msgstr ""
"<userinput>sed -i '/qtpng.h/a #include &lt;string.h&gt;' "
"plugins/png/qtpng.c</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/libquicktime.xml:118
#, xml-text
msgid ""
"Install <application>libquicktime</application> by running the following "
"commands:"
msgstr ""
"Instale o <application>libquicktime</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/multimedia/libdriv/libquicktime.xml:122
#, no-wrap, xml-text
msgid ""
"<userinput>CFLAGS=\"-msse -msse2\"         \\\n"
"./configure --prefix=/usr     \\\n"
"            --enable-gpl      \\\n"
"            --without-doxygen \\\n"
"            --without-ffmpeg  \\\n"
"            --docdir=/usr/share/doc/libquicktime-&libquicktime-version;\n"
"make</userinput>"
msgstr ""
"<userinput>CFLAGS=\"-msse -msse2\"         \\\n"
"./configure --prefix=/usr     \\\n"
"            --enable-gpl      \\\n"
"            --without-doxygen \\\n"
"            --without-ffmpeg  \\\n"
"            --docdir=/usr/share/doc/libquicktime-&libquicktime-version;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/libquicktime.xml:131
#, xml-text
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/libquicktime.xml:135
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/multimedia/libdriv/libquicktime.xml:138
#, no-wrap, xml-text
msgid ""
"<userinput>make install &amp;&amp;\n"
"\n"
"install -v -m755 -d /usr/share/doc/libquicktime-&libquicktime-version; &amp;&amp;\n"
"install -v -m644    README doc/{*.txt,*.html,mainpage.incl} \\\n"
"                    /usr/share/doc/libquicktime-&libquicktime-version;</userinput>"
msgstr ""
"<userinput>make install &amp;&amp;\n"
"\n"
"install -v -m755 -d /usr/share/doc/libquicktime-&libquicktime-version; &amp;&amp;\n"
"install -v -m644    README doc/{*.txt,*.html,mainpage.incl} \\\n"
"                    /usr/share/doc/libquicktime-&libquicktime-version;</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/multimedia/libdriv/libquicktime.xml:147
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/libquicktime.xml:150
#, xml-text
msgid ""
"<parameter>--enable-gpl</parameter>: Changes the licence to GPL. This "
"enables some extra plugins, such as FAAC, FAAD2, and x264."
msgstr ""
"<parameter>--enable-gpl</parameter>: Muda a licença para GPL. Isso habilita "
"alguns plugins extras, como FAAC, FAAD2 e x264."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/libquicktime.xml:155
#, xml-text
msgid ""
"<parameter>--without-doxygen</parameter>: This is necessary if you do not "
"have <application>Doxygen</application>, omit this if it is installed and "
"you wish the API documentation installed."
msgstr ""
"<parameter>--without-doxygen</parameter>: Isso é necessário se você não "
"tiver o <application>Doxygen</application>; omita isso se estiver ele "
"estiver instalado e você desejar que a documentação da API seja instalada."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/libquicktime.xml:161
#, xml-text
msgid ""
"<parameter>--without-ffmpeg</parameter>: This switch disables ffmpeg support"
" because it is incompatible with ffmpeg-5."
msgstr ""
"<parameter>--without-ffmpeg</parameter>: Essa chave desabilita o suporte ao "
"FFmpeg porque é incompatível com o FFmpeg-5."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/libquicktime.xml:166
#, xml-text
msgid ""
"<option>--with-libdv</option>: Build with libdv support.  Not enabled by "
"default."
msgstr ""
"<option>--with-libdv</option>: Construa com suporte a libdv. Não habilitado "
"por padrão."

