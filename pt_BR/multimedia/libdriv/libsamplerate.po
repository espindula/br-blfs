#. type: Content of: <sect1><sect2><title>
#: blfs-en/multimedia/libdriv/libsamplerate.xml:82
#, xml-text
msgid "Installation of libsamplerate"
msgstr "Instalação do libsamplerate"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/libsamplerate.xml:85
#, xml-text
msgid ""
"Install <application>libsamplerate</application> by running the following "
"commands:"
msgstr ""
"Instale o <application>libsamplerate</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/multimedia/libdriv/libsamplerate.xml:89
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr    \\\n"
"            --disable-static \\\n"
"            --docdir=/usr/share/doc/libsamplerate-&libsamplerate-version; &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>./configure --prefix=/usr    \\\n"
"            --disable-static \\\n"
"            --docdir=/usr/share/doc/libsamplerate-&libsamplerate-version; &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/libsamplerate.xml:95
#, xml-text
msgid "To test the results, issue: <command>make check</command>."
msgstr "Para testar os resultados, emita: <command>make check</command>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/libsamplerate.xml:99
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/multimedia/libdriv/libsamplerate.xml:102
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

