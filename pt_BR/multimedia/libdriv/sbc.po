#. type: Content of: <sect1><sect2><title>
#: blfs-en/multimedia/libdriv/sbc.xml:80
#, xml-text
msgid "Installation of SBC"
msgstr "Instalação do SBC"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/sbc.xml:83
#, xml-text
msgid ""
"Install <application>SBC</application> by running the following commands:"
msgstr ""
"Instale o <application>SBC</application> executando os seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/multimedia/libdriv/sbc.xml:87
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr --disable-static --disable-tester &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>./configure --prefix=/usr --disable-static --disable-tester &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/sbc.xml:91
#, xml-text
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/sbc.xml:95
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/multimedia/libdriv/sbc.xml:98
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/multimedia/libdriv/sbc.xml:102
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/sbc.xml:105
#, xml-text
msgid ""
"<parameter>--disable-tester</parameter>: This disables the SBC tester. "
"Remove it if you have installed <xref linkend=\"libsndfile\"/>."
msgstr ""
"<parameter>--disable-tester</parameter>: Isso desabilita o testador SBC. "
"Remova-o se você tiver instalado <xref linkend=\"libsndfile\"/>."

