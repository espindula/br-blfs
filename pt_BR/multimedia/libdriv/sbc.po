#. type: Content of: <sect1><sect2><title>
#: blfs-en/multimedia/libdriv/sbc.xml:26
#, xml-text
msgid "Introduction to SBC"
msgstr "Introdução ao SBC"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/sbc.xml:29
#, xml-text
msgid ""
"The <application>SBC</application> package is a digital audio encoder and "
"decoder used to transfer data to Bluetooth audio output devices like "
"headphones or loudspeakers."
msgstr ""
"O pacote <application>SBC</application> é um codificador e decodificador de "
"áudio digital usado para transferir dados para dispositivos de saída de "
"áudio Bluetooth, como fones de ouvido ou alto-falantes."

