#. type: Content of: <sect1><sect2><title>
#: blfs-en/multimedia/libdriv/x265.xml:89
#, xml-text
msgid "Installation of x265"
msgstr "Instalação do x265"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/x265.xml:92
#, xml-text
msgid ""
"Install <application>x265</application> by running the following commands:"
msgstr ""
"Instale o <application>x265</application> executando os seguintes comandos:"

#.  the default build is Release, no need to specify that
#. type: Content of: <sect1><sect2><screen>
#: blfs-en/multimedia/libdriv/x265.xml:97
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir bld &amp;&amp;\n"
"cd    bld &amp;&amp;\n"
"\n"
"cmake -DCMAKE_INSTALL_PREFIX=/usr \\\n"
"      -DGIT_ARCHETYPE=1           \\\n"
"      -Wno-dev ../source          &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>mkdir bld &amp;&amp;\n"
"cd    bld &amp;&amp;\n"
"\n"
"cmake -DCMAKE_INSTALL_PREFIX=/usr \\\n"
"      -DGIT_ARCHETYPE=1           \\\n"
"      -Wno-dev ../source          &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/x265.xml:106
#, xml-text
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/x265.xml:110
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/multimedia/libdriv/x265.xml:113
#, no-wrap, xml-text
msgid ""
"<userinput>make install &amp;&amp;\n"
"rm -vf /usr/lib/libx265.a </userinput>"
msgstr ""
"<userinput>make install &amp;&amp;\n"
"rm -vf /usr/lib/libx265.a </userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/multimedia/libdriv/x265.xml:119
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/x265.xml:122
#, xml-text
msgid ""
"<parameter>-DGIT_ARCHETYPE=1</parameter>: Upstream no longer provides "
"releases. BLFS is using a git snapshot, but if the builder has not installed"
" <application>git</application> the build will not install the shared "
"library or the pkgconfig file without this switch."
msgstr ""
"<parameter>-DGIT_ARCHETYPE=1</parameter>: o(a) Desenvolvedor(a) não mais "
"fornece lançamentos. O BLFS está usando um instantâneo git, mas se o "
"construtor não tiver instalado o <application>git</application>, a "
"construção não instalará a biblioteca compartilhada ou o arquivo pkgconfig "
"sem essa chave."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/x265.xml:129
#, xml-text
msgid ""
"<parameter>-Wno-dev</parameter>: This switch is used to suppress warnings "
"intended for the package's developers."
msgstr ""
"<parameter>-Wno-dev</parameter>: Essa chave é usada para suprimir avisos "
"destinados para os(as) desenvolvedores(as) do pacote."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/x265.xml:134
#, xml-text
msgid ""
"<command>rm -vf /usr/lib/libx265.a</command>: BLFS does not recommend using "
"static libraries."
msgstr ""
"<command>rm -vf /usr/lib/libx265.a</command>: O BLFS não recomenda usar "
"bibliotecas estáticas."

