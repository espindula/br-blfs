#. type: Content of: <sect1><sect2><title>
#: blfs-en/multimedia/libdriv/opus.xml:82
#, xml-text
msgid "Installation of Opus"
msgstr "Instalação do Opus"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/opus.xml:85
#, xml-text
msgid ""
"Install <application>Opus</application> by running the following commands:"
msgstr ""
"Instale o <application>Opus</application> executando os seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/multimedia/libdriv/opus.xml:89
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr        \\\n"
"            --buildtype=release  \\\n"
"            -Ddocdir=/usr/share/doc/opus-&opus-version; &amp;&amp;\n"
"ninja</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr        \\\n"
"            --buildtype=release  \\\n"
"            -Ddocdir=/usr/share/doc/opus-&opus-version; &amp;&amp;\n"
"ninja</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/opus.xml:98
#, xml-text
msgid "To test the results, issue: <command>ninja test</command>."
msgstr "Para testar os resultados, emita: <command>ninja test</command>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/opus.xml:102
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/multimedia/libdriv/opus.xml:105
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr "<userinput>ninja install</userinput>"

