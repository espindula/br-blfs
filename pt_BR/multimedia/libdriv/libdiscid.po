#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/libdiscid.xml:86
msgid ""
"Install <application>libdiscid</application> by running the following "
"commands:"
msgstr ""
"Instale o <application>libdiscid</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/multimedia/libdriv/libdiscid.xml:90
#, no-wrap
msgid ""
"<userinput>./configure --prefix=/usr --disable-static &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>./configure --prefix=/usr --disable-static &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/libdiscid.xml:94
