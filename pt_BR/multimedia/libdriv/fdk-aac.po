#. type: Content of: <sect1><sect2><title>
#: blfs-en/multimedia/libdriv/fdk-aac.xml:74
#, xml-text
msgid "Installation of fdk-aac"
msgstr "Instalação do fdk-aac"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/fdk-aac.xml:77
#, xml-text
msgid ""
"Install <application>fdk-aac</application> by running the following "
"commands:"
msgstr ""
"Instale o <application>fdk-aac</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/multimedia/libdriv/fdk-aac.xml:81
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr --disable-static &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>./configure --prefix=/usr --disable-static &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/fdk-aac.xml:85
#, xml-text
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/fdk-aac.xml:89
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/multimedia/libdriv/fdk-aac.xml:92
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

