#. type: Content of: <sect1><sect2><title>
#: blfs-en/multimedia/libdriv/taglib.xml:86
#, xml-text
msgid "Installation of Taglib"
msgstr "Instalação do Taglib"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/taglib.xml:89
#, xml-text
msgid ""
"Install <application>Taglib</application> by running the following commands:"
msgstr ""
"Instale o <application>Taglib</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/multimedia/libdriv/taglib.xml:93
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -DCMAKE_INSTALL_PREFIX=/usr \\\n"
"      -DCMAKE_BUILD_TYPE=Release  \\\n"
"      -DBUILD_SHARED_LIBS=ON \\\n"
"      .. &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -DCMAKE_INSTALL_PREFIX=/usr \\\n"
"      -DCMAKE_BUILD_TYPE=Release  \\\n"
"      -DBUILD_SHARED_LIBS=ON \\\n"
"      .. &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/taglib.xml:103
#, xml-text
msgid ""
"The test suite requires <application>Cppunit</application> but it's not a "
"BLFS package."
msgstr ""
"A suíte de teste exige <application>Cppunit</application>, mas ele não é um "
"pacote do BLFS."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/taglib.xml:108
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/multimedia/libdriv/taglib.xml:111
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

