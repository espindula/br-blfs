"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/multimedia/libdriv/libmusicbrainz5.xml:145
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/libmusicbrainz5.xml:148
#, xml-text
msgid ""
"If you have built the API documentation, install, as the <systemitem "
"class=\"username\">root</systemitem> user:"
msgstr ""
"Se você tiver construído a documentação da API, instale como o(a) usuário(a)"
" <systemitem class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/multimedia/libdriv/libmusicbrainz5.xml:153
#, no-wrap, xml-text
msgid ""
"<userinput>rm -rf /usr/share/doc/libmusicbrainz-&libmusicbrainz5-version; &amp;&amp;\n"
"cp -vr docs/ /usr/share/doc/libmusicbrainz-&libmusicbrainz5-version;</userinput>"
