#. type: Content of: <sect1><sect2><title>
#: blfs-en/multimedia/libdriv/libmusicbrainz5.xml:96
#, xml-text
msgid "Installation of libmusicbrainz"
msgstr "Instalação do libmusicbrainz"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/libmusicbrainz5.xml:107
#, xml-text
msgid "First, fix a problem caused by CMake-3.18.0 and later:"
msgstr ""
"Primeiro, corrija um problema causado pelo CMake-3.18.0 e posteriores:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/multimedia/libdriv/libmusicbrainz5.xml:110
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"pre\">patch -Np1 -i "
"../libmusicbrainz-&libmusicbrainz5-version;-cmake_fixes-1.patch</userinput>"
msgstr ""
"<userinput remap=\"pre\">patch -Np1 -i "
"../libmusicbrainz-&libmusicbrainz5-version;-cmake_fixes-1.patch</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/libmusicbrainz5.xml:113
#, xml-text
msgid "Fix also a problem caused by libxml-2.12.x:"
msgstr "Corrija também um problema causado pela libxml-2.12.x:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/multimedia/libdriv/libmusicbrainz5.xml:116
#, no-wrap, xml-text
msgid ""
"<userinput>sed -e 's/xmlErrorPtr /const xmlError */'     \\\n"
"    -i src/xmlParser.cc</userinput>"
msgstr ""
"<userinput>sed -e 's/xmlErrorPtr /const xmlError */'     \\\n"
"    -i src/xmlParser.cc</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/libmusicbrainz5.xml:120
#, xml-text
msgid ""
"Install <application>libmusicbrainz</application> by running the following "
"commands:"
msgstr ""
"Instale o <application>libmusicbrainz</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/multimedia/libdriv/libmusicbrainz5.xml:124
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release .. &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release .. &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/libmusicbrainz5.xml:131
#, xml-text
msgid ""
"If you have installed <xref linkend=\"doxygen\"/>, optionally build the API "
"documentation:"
msgstr ""
"Se você tiver instalado o <xref linkend=\"doxygen\"/>, opcionalmente "
"construa a documentação da API:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/multimedia/libdriv/libmusicbrainz5.xml:135
#, no-wrap, xml-text
msgid "<userinput>doxygen ../Doxyfile</userinput>"
msgstr "<userinput>doxygen ../Doxyfile</userinput>"

