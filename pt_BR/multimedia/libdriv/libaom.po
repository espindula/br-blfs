#. type: Content of: <sect1><sect2><title>
#: blfs-en/multimedia/libdriv/libaom.xml:91
#, xml-text
msgid "Installation of libaom"
msgstr "Instalação do libaom"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/libaom.xml:94
#, xml-text
msgid ""
"Install <application>libaom</application> by running the following commands:"
msgstr ""
"Instale o <application>libaom</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/multimedia/libdriv/libaom.xml:98
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir aom-build &amp;&amp;\n"
"cd    aom-build &amp;&amp;\n"
"\n"
"cmake -DCMAKE_INSTALL_PREFIX=/usr \\\n"
"      -DCMAKE_BUILD_TYPE=Release  \\\n"
"      -DBUILD_SHARED_LIBS=1       \\\n"
"      -DENABLE_DOCS=no            \\\n"
"      -G Ninja .. &amp;&amp;\n"
"ninja</userinput>"
msgstr ""
"<userinput>mkdir aom-build &amp;&amp;\n"
"cd    aom-build &amp;&amp;\n"
"\n"
"cmake -DCMAKE_INSTALL_PREFIX=/usr \\\n"
"      -DCMAKE_BUILD_TYPE=Release  \\\n"
"      -DBUILD_SHARED_LIBS=1       \\\n"
"      -DENABLE_DOCS=no            \\\n"
"      -G Ninja .. &amp;&amp;\n"
"ninja</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/libaom.xml:109
#, xml-text
msgid ""
"To test the results, issue: <command>ninja runtests</command>. Note that the"
" tests take an extremely long time to run."
msgstr ""
"Para testar os resultados, emita: <command>ninja runtests</command>. Observe"
" que os tomam um tempo extremamente longo para executar."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/libaom.xml:114
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/multimedia/libdriv/libaom.xml:117
#, no-wrap, xml-text
msgid ""
"<userinput>ninja install &amp;&amp;\n"
"rm -v /usr/lib/libaom.a</userinput>"
msgstr ""
"<userinput>ninja install &amp;&amp;\n"
"rm -v /usr/lib/libaom.a</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/multimedia/libdriv/libaom.xml:123
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/libaom.xml:126
#, xml-text
msgid ""
"<parameter>-DBUILD_SHARED_LIBS=1</parameter>: This switch builds shared "
"versions of the libraries."
msgstr ""
"<parameter>-DBUILD_SHARED_LIBS=1</parameter>: Essa chave constrói versões "
"compartilhadas das bibliotecas."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/libaom.xml:131
#, xml-text
msgid ""
"<parameter>-DENABLE_DOCS=no</parameter>: This switch disables building the "
"documentation because it fails due to an incompatibility with the latest "
"version of <xref role=\"nodep\" linkend=\"doxygen\"/>."
msgstr ""
"<parameter>-DENABLE_DOCS=no</parameter>: Essa chave desabilita a construção "
"da documentação porque ela falha devido a uma incompatibilidade com a versão"
" mais recente do <xref role=\"nodep\" linkend=\"doxygen\"/>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/libaom.xml:137
#, xml-text
msgid ""
"<option>-DENABLE_NASM=yes</option>: Use this switch if you have both <xref "
"linkend=\"yasm\"/> and <xref role=\"nodep\" linkend=\"nasm\"/> installed and"
" wish to use nasm instead of yasm."
msgstr ""
"<option>-DENABLE_NASM=yes</option>: Use essa chave se você tiver ambos, "
"<xref linkend=\"yasm\"/> e <xref role=\"nodep\" linkend=\"nasm\"/>, "
"instalados e desejar usar nasm em vez do yasm."

