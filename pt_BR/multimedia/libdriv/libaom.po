#, xml-text
msgid "Introduction to libaom"
msgstr "Introdução ao libaom"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/libaom.xml:30
#, xml-text
msgid ""
"The <application>libaom</application> package contains a reference version "
"of the Alliance for Open Media video codec. This codec is a patent free "
"alternative to H.265, and is starting to be used throughout the internet."
msgstr ""
"O pacote <application>libaom</application> contém uma versão de referência "
"do codificador de vídeo Alliance for Open Media. Esse codificador é uma "
"alternativa livre de patente ao H.265 e está começando a ser usado em toda a"
" Internet."

