#. type: Content of: <sect1><sect2><title>
#: blfs-en/multimedia/cdwriteutils/libburn.xml:80
#, xml-text
msgid "Installation of libburn"
msgstr "Instalação do libburn"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/cdwriteutils/libburn.xml:83
#, xml-text
msgid ""
"Install <application>libburn</application> by running the following "
"commands:"
msgstr ""
"Instale o <application>libburn</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/multimedia/cdwriteutils/libburn.xml:87
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr --disable-static &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>./configure --prefix=/usr --disable-static &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/cdwriteutils/libburn.xml:91
#, xml-text
msgid ""
"If you have installed <application>Doxygen</application> and wish to "
"generate the HTML documentation, issue the following command:"
msgstr ""
"Se você tiver instalado o <application>Doxygen</application> e desejar gerar"
" a documentação HTML, emita o seguinte comando:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/multimedia/cdwriteutils/libburn.xml:95
#, no-wrap, xml-text
msgid "<userinput>doxygen doc/doxygen.conf</userinput>"
msgstr "<userinput>doxygen doc/doxygen.conf</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/cdwriteutils/libburn.xml:98
#, xml-text
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/cdwriteutils/libburn.xml:102
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/multimedia/cdwriteutils/libburn.xml:105
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/cdwriteutils/libburn.xml:108
#, xml-text
msgid ""
"If you have built the HTML documentation, install it by running the "
"following commands as the <systemitem class=\"username\">root</systemitem> "
"user:"
msgstr ""
"Se você tiver construído a documentação HTML, instale-a executando os "
"seguintes comandos como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/multimedia/cdwriteutils/libburn.xml:113
#, no-wrap, xml-text
msgid ""
"<userinput>install -v -dm755 /usr/share/doc/libburn-&libburn-version; &amp;&amp;\n"
"install -v -m644 doc/html/* /usr/share/doc/libburn-&libburn-version;</userinput>"
msgstr ""
"<userinput>install -v -dm755 /usr/share/doc/libburn-&libburn-version; &amp;&amp;\n"
"install -v -m644 doc/html/* /usr/share/doc/libburn-&libburn-version;</userinput>"

