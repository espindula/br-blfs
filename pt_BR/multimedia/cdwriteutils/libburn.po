#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/cdwriteutils/libburn.xml:30
#, xml-text
msgid ""
"<application>libburn</application> is a library for writing preformatted "
"data onto optical media: CD, DVD and BD (Blu-Ray)."
msgstr ""
"<application>libburn</application> é uma biblioteca para gravação de dados "
"pré-formatados em mídia óptica: CD, DVD e BD (Blu-Ray)."

