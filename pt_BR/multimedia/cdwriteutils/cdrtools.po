#. type: Content of: <sect1><sect2><title>
#: blfs-en/multimedia/cdwriteutils/cdrtools.xml:83
#, xml-text
msgid "Installation of Cdrtools"
msgstr "Instalação do Cdrtools"

#. type: Content of: <sect1><sect2><note><para>
#: blfs-en/multimedia/cdwriteutils/cdrtools.xml:87
#, xml-text
msgid "This package does not support parallel build."
msgstr "Esse pacote não suporta construção paralela."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/cdwriteutils/cdrtools.xml:92
#, xml-text
msgid ""
"Install <application>Cdrtools</application> by running the following "
"commands:"
msgstr ""
"Instale o <application>Cdrtools</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/multimedia/cdwriteutils/cdrtools.xml:96
#, no-wrap, xml-text
msgid ""
"<userinput>export GMAKE_NOWARN=true &amp;&amp;\n"
"make -j1 INS_BASE=/usr DEFINSUSR=root DEFINSGRP=root</userinput>"
msgstr ""
"<userinput>export GMAKE_NOWARN=true &amp;&amp;\n"
"make -j1 INS_BASE=/usr DEFINSUSR=root DEFINSGRP=root</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/cdwriteutils/cdrtools.xml:100
#, xml-text
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/cdwriteutils/cdrtools.xml:104
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/multimedia/cdwriteutils/cdrtools.xml:107
#, no-wrap, xml-text
msgid ""
"<userinput>export GMAKE_NOWARN=true &amp;&amp;\n"
"make INS_BASE=/usr MANSUFF_LIB=3cdr DEFINSUSR=root DEFINSGRP=root install &amp;&amp;\n"
"install -v -m755 -d /usr/share/doc/cdrtools-&cdrtools-version; &amp;&amp;\n"
"install -v -m644 README.* READMEs/* ABOUT doc/*.ps \\\n"
"                    /usr/share/doc/cdrtools-&cdrtools-version;</userinput>"
msgstr ""
"<userinput>export GMAKE_NOWARN=true &amp;&amp;\n"
"make INS_BASE=/usr MANSUFF_LIB=3cdr DEFINSUSR=root DEFINSGRP=root install &amp;&amp;\n"
"install -v -m755 -d /usr/share/doc/cdrtools-&cdrtools-version; &amp;&amp;\n"
"install -v -m644 README.* READMEs/* ABOUT doc/*.ps \\\n"
"                    /usr/share/doc/cdrtools-&cdrtools-version;</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/multimedia/cdwriteutils/cdrtools.xml:116
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/cdwriteutils/cdrtools.xml:119
#, xml-text
msgid ""
"<command>export GMAKE_NOWARN=true</command>: This variable avoids a warning "
"when using GNU make."
msgstr ""
"<command>export GMAKE_NOWARN=true</command>: Essa variável evita um aviso ao"
" usar GNU make."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/cdwriteutils/cdrtools.xml:124
#, xml-text
msgid ""
"<parameter>INS_BASE=/usr</parameter>: This parameter moves the install "
"directory from <filename class=\"directory\">/opt/schily</filename> to "
"<filename class=\"directory\">/usr</filename>."
msgstr ""
"<parameter>INS_BASE=/usr</parameter>: Esse parâmetro move o diretório de "
"instalação de <filename class=\"directory\">/opt/schily</filename> para "
"<filename class=\"directory\">/usr</filename>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/cdwriteutils/cdrtools.xml:130
#, xml-text
msgid ""
"<parameter>DEFINSUSR=root DEFINSGRP=root</parameter>: These parameters "
"install all programs with root:root ownership instead of the default "
"bin:bin."
msgstr ""
"<parameter>DEFINSUSR=root DEFINSGRP=root</parameter>: Esses parâmetros "
"instalam todos os aplicativos com titularidade de propriedade root:root em "
"vez do padrão bin:bin."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/cdwriteutils/cdrtools.xml:136
#, xml-text
msgid ""
"<parameter>MANSUFF_LIB=3cdr</parameter>: This parameter prevents "
"<application>Cdrtools</application> from overwriting important pages which "
"are already installed by LFS. The installed man pages of section 3 will have"
" a suffix <literal>3cdr</literal> and can be shown using <command>man 3cdr "
"&lt;manpage&gt;</command>."
msgstr ""
"<parameter>MANSUFF_LIB=3cdr</parameter>: Esse parâmetro evita que o "
"<application>Cdrtools</application> sobrescreva páginas importantes que já "
"estão instaladas pelo LFS. As páginas de manual instaladas da seção 3 terão "
"um sufixo <literal>3cdr</literal> e podem ser mostradas usando <command>man "
"3cdr &lt;página de manual&gt;</command>."

