#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/audioutils/pavucontrol.xml:88
#, xml-text
msgid ""
"Install <application>pavucontrol</application> by running the following "
"commands:"
msgstr ""
"Instale o <application>pavucontrol</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/multimedia/audioutils/pavucontrol.xml:92
#, no-wrap, xml-text
