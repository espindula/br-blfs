#. type: Content of: <sect1><sect2><title>
#: blfs-en/multimedia/videoutils/mpv.xml:26
#, xml-text
msgid "Introduction to mpv"
msgstr "Introdução ao mpv"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/videoutils/mpv.xml:29
#, xml-text
msgid ""
"<application>mpv</application> is a free media player for the command line. "
"It supports a wide variety of media file formats, audio and video codecs, "
"and subtitle types."
msgstr ""
"<application>mpv</application> é um reprodutor de mídia livre para a linha "
"de comando. Ele suporta uma ampla variedade de formatos de arquivos de "
"mídia, codificadores de áudio e vídeo e tipos de legendas."

