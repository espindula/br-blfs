#. type: Content of: <sect1><sect2><title>
#: blfs-en/multimedia/videoutils/mpv.xml:121
#, xml-text
msgid "Installation of mpv"
msgstr "Instalação do mpv"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/videoutils/mpv.xml:124
#, xml-text
msgid "Add a fix to build with FFMpeg &gt; 7.0"
msgstr "Adicione uma correção para construir com FFMpeg &gt; 7.0"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/multimedia/videoutils/mpv.xml:126
#, no-wrap, xml-text
msgid ""
"<userinput>sed -i 's/AV_OPT_TYPE_CHANNEL_LAYOUT/AV_OPT_TYPE_CHLAYOUT/' "
"filters/f_lavfi.c</userinput>"
msgstr ""
"<userinput>sed -i 's/AV_OPT_TYPE_CHANNEL_LAYOUT/AV_OPT_TYPE_CHLAYOUT/' "
"filters/f_lavfi.c</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/videoutils/mpv.xml:129
#, xml-text
msgid ""
"Install <application>mpv</application> by running the following commands:"
msgstr ""
"Instale <application>mpv</application> executando os seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/multimedia/videoutils/mpv.xml:133
#, no-wrap, xml-text
#| msgid ""
#| "<userinput>mkdir build &amp;&amp;\n"
#| "cd    build &amp;&amp;\n"
#| "\n"
#| "meson setup --prefix=/usr       \\\n"
#| "            --buildtype=release \\\n"
#| "            -Dx11=enabled       \\\n"
#| "            ..                  &amp;&amp;\n"
#| "ninja</userinput>"
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr       \\\n"
"            --buildtype=release \\\n"
"            -D x11=enabled      \\\n"
"            ..                  &amp;&amp;\n"
"ninja</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr       \\\n"
"            --buildtype=release \\\n"
"            -D x11=enabled      \\\n"
"            ..                  &amp;&amp;\n"
"ninja</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/videoutils/mpv.xml:143
#, xml-text
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/videoutils/mpv.xml:147
#, xml-text
msgid "Now, as the &root; user:"
msgstr "Agora, como o(a) usuário(a) &root;:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/multimedia/videoutils/mpv.xml:150
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr "<userinput>ninja install</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/multimedia/videoutils/mpv.xml:158
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/videoutils/mpv.xml:161
#, xml-text
msgid ""
"<parameter>-Dx11=enabled</parameter>: allows linking to the X11 libraries."
msgstr ""
"<parameter>-Dx11=enabled</parameter>: permite vincular com as bibliotecas do"
" X11."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/videoutils/mpv.xml:165
#, xml-text
msgid "<option>-Ddvdnav=enabled</option>: enables support for DVD playback."
msgstr ""
"<option>-Ddvdnav=enabled</option>: habilita suporte para reprodução de DVD."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/videoutils/mpv.xml:169
#, xml-text
msgid "<option>-Dcdda=enabled</option>: enables support for CD Audio."
msgstr "<option>-Dcdda=enabled</option>: habilita suporte para áudio de CD."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/videoutils/mpv.xml:173
#, xml-text
msgid ""
"<option>-Dsdl2=enabled</option>: enables the usage of SDL2 for audio and "
"video output."
msgstr ""
"<option>-Dsdl2=enabled</option>: habilita o uso de SDL2 para saída de áudio "
"e vídeo."

