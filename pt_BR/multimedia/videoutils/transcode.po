#. type: Content of: <sect1><sect2><title>
#: blfs-en/multimedia/videoutils/transcode.xml:158
#, xml-text
msgid "Installation of Transcode"
msgstr "Instalação do Transcode"

#. type: Content of: <sect1><sect2><note><para>
#: blfs-en/multimedia/videoutils/transcode.xml:183
#, xml-text
msgid ""
"Support for most of the dependency packages requires using options passed to"
" the <command>configure</command> script. View the "
"<filename>INSTALL</filename> file and the output from <command>./configure "
"--help</command> for complete information about enabling dependency "
"packages."
msgstr ""
"O suporte para a maioria dos pacotes de dependência exige usar opções "
"passadas para o conjunto de comandos sequenciais "
"<command>configure</command>. Visualize o arquivo "
"<filename>INSTALL</filename> e a saída gerada a partir de "
"<command>./configure --help</command> para informações completas acerca de "
"habilitar pacotes de dependência."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/videoutils/transcode.xml:192
#, xml-text
msgid ""
"Install <application>Transcode</application> by running the following "
"commands:"
msgstr ""
"Instale o <application>Transcode</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/multimedia/videoutils/transcode.xml:196
#, no-wrap, xml-text
msgid ""
"<userinput>sed -i 's|doc/transcode|&amp;-$(PACKAGE_VERSION)|' \\\n"
"       $(find . -name Makefile.in -exec grep -l 'docsdir =' {} \\;) &amp;&amp;\n"
"\n"
"patch -Np1 -i ../transcode-&transcode-version;-gcc10_fix-1.patch &amp;&amp;\n"
"\n"
"./configure --prefix=/usr     \\\n"
"            --enable-alsa     \\\n"
"            --enable-libmpeg2 \\\n"
"            --disable-ffmpeg  &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>sed -i 's|doc/transcode|&amp;-$(PACKAGE_VERSION)|' \\\n"
"       $(find . -name Makefile.in -exec grep -l 'docsdir =' {} \\;) &amp;&amp;\n"
"\n"
"patch -Np1 -i ../transcode-&transcode-version;-gcc10_fix-1.patch &amp;&amp;\n"
"\n"
"./configure --prefix=/usr     \\\n"
"            --enable-alsa     \\\n"
"            --enable-libmpeg2 \\\n"
"            --disable-ffmpeg  &amp;&amp;\n"
"make</userinput>"

