#. type: Content of: <sect1><sect2><title>
#: blfs-en/xfce/apps/parole.xml:27
#, xml-text
msgid "Introduction to Parole"
msgstr "Introdução ao Parole"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/xfce/apps/parole.xml:30
#, xml-text
msgid ""
"<application>Parole</application> is a DVD/CD/music player for "
"<application>Xfce</application> that uses "
"<application>GStreamer</application>."
msgstr ""
"<application>Parole</application> é um reprodutor de DVD/CD/música para o "
"<application>Xfce</application> que usa o "
"<application>GStreamer</application>."

#. type: Content of: <sect1><sect2><note><para>
#: blfs-en/xfce/apps/parole.xml:39
#, xml-text
msgid ""
"Although this version of parole works with most files, it is unable to play "
"DVDs, reporting an error in the gstreamer backend."
msgstr ""
"Embora essa versão do Parole funcione com a maioria dos arquivos, ela é "
"inapta para reproduzir DVDs, informando um erro na estrutura de retaguarda "
"do GStreamer."

