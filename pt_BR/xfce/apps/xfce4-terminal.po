msgstr "Instalação do Terminal do Xfce4"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/xfce/apps/xfce4-terminal.xml:86
#, xml-text
msgid ""
"Install <application>Xfce4 Terminal</application> by running the following "
"commands:"
msgstr ""
"Instale o <application>Terminal do Xfce4</application> executando os "
"seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/xfce/apps/xfce4-terminal.xml:90
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>./configure --prefix=/usr &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/xfce/apps/xfce4-terminal.xml:94
#, xml-text
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/xfce/apps/xfce4-terminal.xml:98
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/xfce/apps/xfce4-terminal.xml:101
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

