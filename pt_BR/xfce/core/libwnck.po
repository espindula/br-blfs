#. type: Content of: <sect1><sect2><title>
#: blfs-en/xfce/core/libwnck.xml:90
#, xml-text
msgid "Installation of libwnck"
msgstr "Instalação do libwnck"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/xfce/core/libwnck.xml:93
#, xml-text
msgid ""
"Install <application>libwnck</application> by running the following "
"commands:"
msgstr ""
"Instale <application>libwnck</application> executando os seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/xfce/core/libwnck.xml:97
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr --buildtype=release .. &amp;&amp;\n"
"ninja</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr --buildtype=release .. &amp;&amp;\n"
"ninja</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/xfce/core/libwnck.xml:104
#, xml-text
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/xfce/core/libwnck.xml:108
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/xfce/core/libwnck.xml:111
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr "<userinput>ninja install</userinput>"

