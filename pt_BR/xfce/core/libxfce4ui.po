#. type: Content of: <sect1><sect2><title>
#: blfs-en/xfce/core/libxfce4ui.xml:95
#, xml-text
msgid "Installation of libxfce4ui"
msgstr "Instalação do libxfce4ui"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/xfce/core/libxfce4ui.xml:98
#, xml-text
msgid ""
"Install <application>libxfce4ui</application> by running the following "
"commands:"
msgstr ""
"Instale o <application>libxfce4ui</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/xfce/core/libxfce4ui.xml:102
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr --sysconfdir=/etc &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>./configure --prefix=/usr --sysconfdir=/etc &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/xfce/core/libxfce4ui.xml:106
#, xml-text
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/xfce/core/libxfce4ui.xml:110
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/xfce/core/libxfce4ui.xml:113
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

