#. type: Content of: <sect1><sect2><para>
#: blfs-en/xfce/core/libxfce4ui.xml:30
#, xml-text
msgid ""
"The <application>libxfce4ui</application> package contains <application>GTK+"
" 3</application> widgets that are used by other "
"<application>Xfce</application> applications."
msgstr ""
"O pacote <application>libxfce4ui</application> contém pequenas engenhocas "
"<application>GTK+ 3</application> que são usadas por outros aplicativos do "
"<application>Xfce</application>."

