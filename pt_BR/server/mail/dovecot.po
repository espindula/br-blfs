#. type: Content of: <sect1><sect2><title>
#: blfs-en/server/mail/dovecot.xml:118
#, xml-text
msgid "Installation of Dovecot"
msgstr "Instalação do Dovecot"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/server/mail/dovecot.xml:121
#, xml-text
msgid ""
"There should be dedicated users and groups for unprivileged Dovecot "
"processes and for processing users' logins. Issue the following commands as "
"the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Deveria existir usuários(as) e grupos dedicados(as) para processos sem "
"privilégios do &quot;Dovecot&quot; e para processamento de "
"&quot;logins&quot; de usuários(as). Emita os seguintes comandos como o(a) "
"usuário(a) &quot;<systemitem class=\"username\">root</systemitem>&quot;:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/server/mail/dovecot.xml:126
#, no-wrap, xml-text
msgid ""
"<userinput>groupadd -g 42 dovecot &amp;&amp;\n"
"useradd -c \"Dovecot unprivileged user\" -d /dev/null -u 42 \\\n"
"        -g dovecot -s /bin/false dovecot &amp;&amp;\n"
"groupadd -g 43 dovenull &amp;&amp;\n"
"useradd -c \"Dovecot login user\" -d /dev/null -u 43 \\\n"
"        -g dovenull -s /bin/false dovenull</userinput>"
msgstr ""
"<userinput>groupadd -g 42 dovecot &amp;&amp;\n"
"useradd -c \"Usuário(a) sem privilégios do Dovecot\" -d /dev/null -u 42 \\\n"
"        -g dovecot -s /bin/false dovecot &amp;&amp;\n"
"groupadd -g 43 dovenull &amp;&amp;\n"
"useradd -c \"Usuário(a) de login do Dovecot\" -d /dev/null -u 43 \\\n"
"        -g dovenull -s /bin/false dovenull</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/server/mail/dovecot.xml:134
#, xml-text
msgid "First, apply a patch to fix problems with OpenSSL-3:"
msgstr ""
"Primeiro, aplique um remendo para corrigir problemas com o "
"&quot;OpenSSL-3&quot;:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/server/mail/dovecot.xml:137
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"pre\">patch -Np1 -i ../dovecot-&dovecot-"
"version;-openssl3_fixes-1.patch</userinput>"
msgstr ""
"<userinput remap=\"pre\">patch -Np1 -i ../dovecot-&dovecot-"
"version;-openssl3_fixes-1.patch</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/server/mail/dovecot.xml:140
#, xml-text
msgid "Next, apply a patch to fix a security vulnerability:"
msgstr ""
"A seguir, aplique um remendo para corrigir uma vulnerabilidade de segurança:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/server/mail/dovecot.xml:143
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"pre\">patch -Np1 -i ../dovecot-&dovecot-"
"version;-security_fix-1.patch</userinput>"
msgstr ""
"<userinput remap=\"pre\">patch -Np1 -i ../dovecot-&dovecot-"
"version;-security_fix-1.patch</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/server/mail/dovecot.xml:146
#, xml-text
msgid ""
"Install <application>Dovecot</application> by running the following "
"commands:"
msgstr ""
"Instale o &quot;<application>Dovecot</application>&quot; executando os "
"seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/server/mail/dovecot.xml:150
#, no-wrap, xml-text
msgid ""
"<userinput>CPPFLAGS=\"-I/usr/include/tirpc\" \\\n"
"LDFLAGS+=\" -ltirpc\" \\\n"
"./configure --prefix=/usr                          \\\n"
"            --sysconfdir=/etc                      \\\n"
"            --localstatedir=/var                   \\\n"
"            --with-systemd=no                      \\\n"
"            --docdir=/usr/share/doc/dovecot-&dovecot-version; \\\n"
"            --disable-static &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>CPPFLAGS=\"-I/usr/include/tirpc\" \\\n"
"LDFLAGS+=\" -ltirpc\" \\\n"
"./configure --prefix=/usr                         \\\n"
"            --sysconfdir=/etc                      \\\n"
"            --localstatedir=/var                   \\\n"
"            --with-systemd=no                      \\\n"
"            --docdir=/usr/share/doc/dovecot-&dovecot-version; \\\n"
"            --disable-static &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/server/mail/dovecot.xml:160
#, no-wrap, xml-text
msgid ""
"<userinput>CPPFLAGS=\"-I/usr/include/tirpc\" \\\n"
"LDFLAGS+=\" -ltirpc\" \\\n"
"./configure --prefix=/usr                          \\\n"
"            --sysconfdir=/etc                      \\\n"
"            --localstatedir=/var                   \\\n"
"            --docdir=/usr/share/doc/dovecot-&dovecot-version; \\\n"
"            --disable-static                       &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>CPPFLAGS=\"-I/usr/include/tirpc\" \\\n"
"LDFLAGS+=\" -ltirpc\" \\\n"
"./configure --prefix=/usr                         \\\n"
"            --sysconfdir=/etc                      \\\n"
"            --localstatedir=/var                   \\\n"
"            --docdir=/usr/share/doc/dovecot-&dovecot-version; \\\n"
"            --disable-static                       &amp;&amp;\n"
"make</userinput>"

