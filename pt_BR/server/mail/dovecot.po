#. type: Content of: <sect1><sect2><title>
#: blfs-en/server/mail/dovecot.xml:184
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/server/mail/dovecot.xml:187
#, xml-text
msgid ""
"<command>CPPFLAGS=... LDFLAGS+=...</command>: build with libtirpc instead of"
" the recently removed RPC code provided by GlibC."
msgstr ""
"<command>CPPFLAGS=... LDFLAGS+=...</command>: construa com "
"&quot;libtirpc&quot; em vez do código &quot;RPC&quot; recentemente removido "
"fornecido pela &quot;GlibC&quot;."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/server/mail/dovecot.xml:203
#, xml-text
msgid ""
"<option>--with-ldap</option>: This switch enables "
"<application>OpenLDAP</application> authentication support."
msgstr ""
"<option>--with-ldap</option>: Essa chave habilita o suporte a autenticação "
"&quot;<application>OpenLDAP</application>&quot;."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/server/mail/dovecot.xml:208
#, xml-text
msgid ""
"<option>--with-pgsql</option>: This switch enables "
"<application>PostgreSQL</application> database support."
msgstr ""
"<option>--with-pgsql</option>: Essa chave habilita o suporte a base de dados"
" &quot;<application>PostgreSQL</application>&quot;."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/server/mail/dovecot.xml:213
#, xml-text
msgid ""
"<option>--with-mysql</option>: This switch enables "
"<application>MySQL</application> database support."
msgstr ""
"<option>--with-mysql</option>: Essa chave habilita o suporte a base de dados"
" &quot;<application>MySQL</application>&quot;."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/server/mail/dovecot.xml:218
#, xml-text
msgid ""
"<option>--with-sqlite</option>: This switch enables "
"<application>SQLite</application> database support."
msgstr ""
"<option>--with-sqlite</option>: Essa chave habilita o suporte a base de "
"dados &quot;<application>SQLite</application>&quot;."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/server/mail/dovecot.xml:223
#, xml-text
msgid ""
"<option>--with-lucene</option>: This switch enables "
"<application>CLucene</application> full text search support."
msgstr ""
"<option>--with-lucene</option>: Essa chave habilita o suporte pesquisa "
"completa de texto &quot;<application>CLucene</application>&quot;."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/server/mail/dovecot.xml:228
#, xml-text
msgid ""
"<option>--with-lua</option>: This switch enables "
"<application>Lua</application> plugin support. This includes a mail and push"
" notification plugin."
msgstr ""
"<option>--with-lua</option>: Essa chave habilita o suporte ao "
"&quot;plugin&quot; &quot;<application>Lua</application>&quot;. Isso inclui "
"um &quot;plugin&quot; de notificação de mensagem e envio."

