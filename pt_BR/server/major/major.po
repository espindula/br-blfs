msgid "Major Servers"
msgstr "Servidores Principais"

#. type: Content of: <chapter><para>
#: blfs-en/server/major/major.xml:14
#, xml-text
msgid ""
"Major servers are the programs that provide content or services to users or "
"other programs."
msgstr ""
"Os servidores principais são os aplicativos que fornecem conteúdo ou "
"serviços para os(as) usuários(as) ou outros aplicativos."
