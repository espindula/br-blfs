#. type: Content of: <sect1><sect2><title>
#: blfs-en/lxqt/desktop/menu-cache.xml:96
#, xml-text
msgid "Installation of Menu Cache"
msgstr "Instalação do Menu Cache"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/lxqt/desktop/menu-cache.xml:99
#, xml-text
msgid ""
"First fix a memory leak and <quote>multiple definitions</quote> issues:"
msgstr ""
"Primeiro, corrija um vazamento de memória e problemas de <quote>múltiplas "
"definições</quote>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/lxqt/desktop/menu-cache.xml:103
#, no-wrap, xml-text
msgid ""
"<userinput>patch -Np1 -i ../menu-cache-&menu-cache-"
"version;-consolidated_fixes-1.patch</userinput>"
msgstr ""
"<userinput>patch -Np1 -i ../menu-cache-&menu-cache-"
"version;-consolidated_fixes-1.patch</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/lxqt/desktop/menu-cache.xml:106
#, xml-text
msgid ""
"Install <application>Menu Cache</application> by running the following "
"commands:"
msgstr ""
"Instale <application>Menu Cache</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/lxqt/desktop/menu-cache.xml:110
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr    \\\n"
"            --disable-static &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>./configure --prefix=/usr    \\\n"
"            --disable-static &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/lxqt/desktop/menu-cache.xml:115
#, xml-text
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/lxqt/desktop/menu-cache.xml:119
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/lxqt/desktop/menu-cache.xml:122
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/lxqt/desktop/menu-cache.xml:127
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/lxqt/desktop/menu-cache.xml:133
#, xml-text
msgid ""
"<option>--enable-gtk-doc</option>: Use this option if <application>GTK-"
"Doc</application> is installed and you wish to build and install the API "
"documentation."
msgstr ""
"<option>--enable-gtk-doc</option>: Use essa opção se <application>GTK-Doc</"
"application> estiver instalado e você desejar construir e instalar a "
"documentação da API."

