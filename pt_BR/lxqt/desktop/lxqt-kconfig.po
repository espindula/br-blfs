msgstr "Instalação do kconfig"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/lxqt/desktop/lxqt-kconfig.xml:92
#, xml-text
msgid ""
"Install <application>kconfig</application> by running the following "
"commands:"
msgstr ""
"Instale o <application>kconfig</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/lxqt/desktop/lxqt-kconfig.xml:96
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir -v build &amp;&amp;\n"
"cd       build &amp;&amp;\n"
"\n"
"cmake -DCMAKE_INSTALL_PREFIX=/usr        \\\n"
"      -DCMAKE_BUILD_TYPE=Release         \\\n"
"      -DCMAKE_INSTALL_LIBEXECDIR=libexec \\\n"
"      -DKDE_INSTALL_USE_QT_SYS_PATHS=ON  \\\n"
"      -DBUILD_TESTING=OFF                \\\n"
"      -Wno-dev ..                        &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>mkdir -v build &amp;&amp;\n"
"cd       build &amp;&amp;\n"
"\n"
"cmake -DCMAKE_INSTALL_PREFIX=/usr        \\\n"
"      -DCMAKE_BUILD_TYPE=Release         \\\n"
"      -DCMAKE_INSTALL_LIBEXECDIR=libexec \\\n"
"      -DKDE_INSTALL_USE_QT_SYS_PATHS=ON  \\\n"
"      -DBUILD_TESTING=OFF                \\\n"
"      -Wno-dev ..                        &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/lxqt/desktop/lxqt-kconfig.xml:108
#, xml-text
