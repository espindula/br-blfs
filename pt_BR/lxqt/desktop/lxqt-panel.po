#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/lxqt/desktop/lxqt-panel.xml:69
#, xml-text
msgid "lxqt-panel Dependencies"
msgstr "Dependências do lxqt-panel"

#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/lxqt/desktop/lxqt-panel.xml:71
#, xml-text
msgid "Required"
msgstr "Exigidas"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/lxqt/desktop/lxqt-panel.xml:73
#, xml-text
msgid ""
"<xref linkend=\"libdbusmenu-qt\"/>, <xref linkend=\"liblxqt\"/>, <xref "
"linkend=\"lxqt-globalkeys\"/>, <xref linkend=\"lxqt-menu-data\"/>, (<xref "
"linkend=\"lxqt-solid\"/> or <xref role=\"nodep\" "
"linkend=\"kf5-frameworks\"/>), and <xref linkend=\"menu-cache\"/>"
msgstr ""
"<xref linkend=\"libdbusmenu-qt\"/>, <xref linkend=\"liblxqt\"/>, <xref "
"linkend=\"lxqt-globalkeys\"/>, <xref linkend=\"lxqt-menu-data\"/>, (<xref "
"linkend=\"lxqt-solid\"/> ou <xref role=\"nodep\" "
"linkend=\"kf5-frameworks\"/>) e <xref linkend=\"menu-cache\"/>"

#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/lxqt/desktop/lxqt-panel.xml:82
#, xml-text
msgid "Recommended"
msgstr "Recomendadas"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/lxqt/desktop/lxqt-panel.xml:84
#, xml-text
msgid ""
"<xref linkend=\"alsa-lib\"/> or <xref linkend=\"pulseaudio\"/> (volume "
"plugin; see Command Explanations below if not present), <xref "
"linkend=\"libstatgrab\"/> (network monitor and CPU load plugins), <xref "
"linkend=\"libsysstat\"/> (CPU and network monitor plugins), <xref "
"linkend=\"libxkbcommon\"/> (keyboard indicator plugin), and <xref "
"linkend=\"lm_sensors\"/> (sensors plugin)"
msgstr ""
"<xref linkend=\"alsa-lib\"/> ou <xref linkend=\"pulseaudio\"/> (plugin de "
"volume; veja-se Explicações do Comando abaixo se não presente), <xref "
"linkend=\"libstatgrab\"/> (monitor de rede de intercomunicação e plug-ins de"
" carga da CPU), <xref linkend=\"libsysstat\"/> (Plug-ins de monitor de CPU e"
" rede de intercomunicação), <xref linkend=\"libxkbcommon\"/> (plugin "
"indicador de teclado) e <xref linkend=\"lm_sensors\"/> (plugin de sensores)"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/lxqt/desktop/lxqt-panel.xml:96
#, xml-text
msgid "Installation of lxqt-panel"
msgstr "Instalação do lxqt-panel"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/lxqt/desktop/lxqt-panel.xml:99
#, xml-text
msgid ""
"If <xref linkend=\"kf5-frameworks\"/> was not installed in /usr, help the "
"code find some headers that it needs:"
msgstr ""
"Se o <xref linkend=\"kf5-frameworks\"/> não foi instalado em /usr, ajude o "
"código a encontrar alguns cabeçalhos que ele necessita:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/lxqt/desktop/lxqt-panel.xml:103
#, no-wrap, xml-text
msgid ""
"<userinput>export CXXFLAGS+=\"-I $KF5_PREFIX/include\"\n"
"export CFLAGS+=\"-I $KF5_PREFIX/include\"</userinput>"
msgstr ""
"<userinput>export CXXFLAGS+=\"-I $KF5_PREFIX/include\"\n"
"export CFLAGS+=\"-I $KF5_PREFIX/include\"</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/lxqt/desktop/lxqt-panel.xml:107
#, xml-text
msgid ""
"Install <application>lxqt-panel</application> by running the following "
"commands:"
msgstr ""
"Instale o <application>lxqt-panel</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/lxqt/desktop/lxqt-panel.xml:111
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir -v build &amp;&amp;\n"
"cd       build &amp;&amp;\n"
"\n"
"cmake -DCMAKE_INSTALL_PREFIX=/usr \\\n"
"      -DCMAKE_BUILD_TYPE=Release  \\\n"
"      ..                          &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>mkdir -v build &amp;&amp;\n"
"cd       build &amp;&amp;\n"
"\n"
"cmake -DCMAKE_INSTALL_PREFIX=/usr \\\n"
"      -DCMAKE_BUILD_TYPE=Release  \\\n"
"      ..                          &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/lxqt/desktop/lxqt-panel.xml:120
#, xml-text
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/lxqt/desktop/lxqt-panel.xml:124
#, xml-text
msgid "Now, as the &root; user:"
msgstr "Agora, como o(a) usuário(a) &root;:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/lxqt/desktop/lxqt-panel.xml:127
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/lxqt/desktop/lxqt-panel.xml:132
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/lxqt/desktop/lxqt-panel.xml:135
#, xml-text
msgid ""
"<option>-D&lt;plugin&gt;_PLUGIN=no</option>: Disable a &lt;plugin&gt;, where"
" &lt;plugin&gt; may be CLOCK, COLORPICKER, CPULOAD, DIRECTORYMENU, "
"DESKTOPSWITCH, KBINDICATOR, MAINMENU, MOUNT, QUICKLAUNCH, SENSORS, "
"SHOWDESKTOP, NETWORKMONITOR, SYSSTAT, TASKBAR, STATUSNOTIFIER, TRAY, VOLUME,"
" WORLDCLOCK, or SPACER"
msgstr ""
"<option>-D&lt;plugin&gt;_PLUGIN=no</option>: Desabilite um &lt;plugin&gt;, "
"onde &lt;plugin&gt; pode ser CLOCK, COLORPICKER, CPULOAD, DIRECTORYMENU, "
"DESKTOPSWITCH, KBINDICATOR, MAINMENU, MOUNT, QUICKLAUNCH, SENSORS, "
"SHOWDESKTOP, NETWORKMONITOR, SYSSTAT, TASKBAR, STATUSNOTIFIER, TRAY, VOLUME,"
" WORLDCLOCK ou SPACER"

