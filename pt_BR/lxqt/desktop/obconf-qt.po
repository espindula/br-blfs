#. type: Content of: <sect1><sect2><title>
#: blfs-en/lxqt/desktop/obconf-qt.xml:81
#, xml-text
msgid "Installation of obconf-qt"
msgstr "Instalação do obconf-qt"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/lxqt/desktop/obconf-qt.xml:84
#, xml-text
msgid ""
"Install <application>obconf-qt</application> by running the following "
"commands:"
msgstr ""
"Instale o <application>obconf-qt</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/lxqt/desktop/obconf-qt.xml:88
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir -v build &amp;&amp;\n"
"cd       build &amp;&amp;\n"
"\n"
"cmake -DCMAKE_INSTALL_PREFIX=/usr \\\n"
"      -DCMAKE_BUILD_TYPE=Release  \\\n"
"      ..                          &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>mkdir -v build &amp;&amp;\n"
"cd       build &amp;&amp;\n"
"\n"
"cmake -DCMAKE_INSTALL_PREFIX=/usr \\\n"
"      -DCMAKE_BUILD_TYPE=Release  \\\n"
"      ..                          &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/lxqt/desktop/obconf-qt.xml:97
#, xml-text
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/lxqt/desktop/obconf-qt.xml:101
#, xml-text
msgid "Now, as the &root; user:"
msgstr "Agora, como o(a) usuário(a) &root;:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/lxqt/desktop/obconf-qt.xml:104
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

