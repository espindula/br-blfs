#. type: Content of: <sect1><sect2><para>
#: blfs-en/lxqt/desktop/lxqt-qtplugin.xml:83
#, xml-text
msgid ""
"Install <application>lxqt-qtplugin</application> by running the following "
"commands:"
msgstr ""
"Instale o <application>lxqt-qtplugin</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/lxqt/desktop/lxqt-qtplugin.xml:87
#, no-wrap, xml-text
#| msgid ""
#| "<userinput>mkdir -v build &amp;&amp;\n"
#| "cd       build &amp;&amp;\n"
#| "\n"
#| "cmake -DCMAKE_INSTALL_PREFIX=/usr \\\n"
#| "      -DCMAKE_BUILD_TYPE=Release  \\\n"
#| "      ..       &amp;&amp;\n"
#| "\n"
#| "make</userinput>"
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr \\\n"
"      -D CMAKE_BUILD_TYPE=Release  \\\n"
"      ..                           &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr \\\n"
"      -D CMAKE_BUILD_TYPE=Release  \\\n"
"      ..                           &amp;&amp;\n"
"make</userinput>"

