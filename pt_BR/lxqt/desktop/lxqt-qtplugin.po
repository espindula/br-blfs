#, xml-text
#~ msgid ""
#~ "To use the plugin in Qt 5, the environment variable "
#~ "<envar>QT_QPA_PLATFORMTHEME</envar> must be set to <quote>lxqt</quote>.  One"
#~ " way to do that is to issue as the &root; user:"
#~ msgstr ""
#~ "Para usar o plugin no Qt 5, a variável de ambiente "
#~ "<envar>QT_QPA_PLATFORMTHEME</envar> precisa estar configurada como "
#~ "<quote>lxqt</quote>. Uma maneira de fazer isso é a de emitir como o(a) "
#~ "usuário(a) &root;:"

#, no-wrap, xml-text
#~ msgid ""
#~ "<userinput>cat &gt;&gt; /etc/profile.d/lxqt.sh &lt;&lt; \"EOF\"\n"
#~ "<literal># Begin lxqt-qtplugin configuration\n"
#~ "\n"
#~ "export QT_QPA_PLATFORMTHEME=lxqt\n"
#~ "\n"
#~ "# End lxqt-qtplugin configuration</literal>\n"
#~ "EOF</userinput>"
#~ msgstr ""
#~ "<userinput>cat &gt;&gt; /etc/profile.d/lxqt.sh &lt;&lt; \"EOF\"\n"
#~ "<literal># Inicia configuração do lxqt-qtplugin\n"
#~ "\n"
#~ "export QT_QPA_PLATFORMTHEME=lxqt\n"
#~ "\n"
#~ "# Termina configuração do lxqt-qtplugin</literal>\n"
#~ "EOF</userinput>"

