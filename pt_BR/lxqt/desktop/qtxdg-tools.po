#. type: Content of: <sect1><sect2><para>
#: blfs-en/lxqt/desktop/qtxdg-tools.xml:28
#, xml-text
msgid ""
"The <application>qtxdg-tools</application> contains a CLI MIME tool for "
"handling file associations and opening files with their default "
"applications."
msgstr ""
"O <application>qtxdg-tools</application> contém uma ferramenta CLI MIME para"
" lidar com associações de arquivos e abrir arquivos com os aplicativos "
"padrão deles."

