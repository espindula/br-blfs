#. type: Content of: <sect1><sect2><title>
#: blfs-en/lxqt/desktop/qtxdg-tools.xml:79
#, xml-text
msgid "Installation of qtxdg-tools"
msgstr "Instalação do qtxdg-tools"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/lxqt/desktop/qtxdg-tools.xml:82
#, xml-text
msgid ""
"Install <application>qtxdg-tools</application> by running the following "
"commands:"
msgstr ""
"Instale o <application>qtxdg-tools</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/lxqt/desktop/qtxdg-tools.xml:86
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir -v build &amp;&amp;\n"
"cd       build &amp;&amp;\n"
"\n"
"cmake -DCMAKE_INSTALL_PREFIX=/usr \\\n"
"      -DCMAKE_BUILD_TYPE=Release  \\\n"
"      -DCMAKE_INSTALL_LIBDIR=lib  \\\n"
"      ..                          &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>mkdir -v build &amp;&amp;\n"
"cd       build &amp;&amp;\n"
"\n"
"cmake -DCMAKE_INSTALL_PREFIX=/usr \\\n"
"      -DCMAKE_BUILD_TYPE=Release  \\\n"
"      -DCMAKE_INSTALL_LIBDIR=lib  \\\n"
"      ..                          &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/lxqt/desktop/qtxdg-tools.xml:96
#, xml-text
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/lxqt/desktop/qtxdg-tools.xml:100
#, xml-text
msgid "Now, as the &root; user:"
msgstr "Agora, como o(a) usuário(a) &root;:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/lxqt/desktop/qtxdg-tools.xml:103
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

