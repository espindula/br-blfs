#. type: Content of: <sect1><sect2><title>
#: blfs-en/lxqt/desktop/libfm-extra.xml:92
#, xml-text
msgid "Installation of libfm-extra"
msgstr "Instalação do libfm-extra"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/lxqt/desktop/libfm-extra.xml:95
#, xml-text
msgid ""
"Install <application>libfm-extra</application> by running the following "
"commands:"
msgstr ""
"Instale <application>libfm-extra</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/lxqt/desktop/libfm-extra.xml:99
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr     \\\n"
"            --sysconfdir=/etc \\\n"
"            --with-extra-only \\\n"
"            --with-gtk=no     \\\n"
"            --disable-static  &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>./configure --prefix=/usr     \\\n"
"            --sysconfdir=/etc \\\n"
"            --with-extra-only \\\n"
"            --with-gtk=no     \\\n"
"            --disable-static  &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/lxqt/desktop/libfm-extra.xml:107
#, xml-text
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/lxqt/desktop/libfm-extra.xml:111
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/lxqt/desktop/libfm-extra.xml:114
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/lxqt/desktop/libfm-extra.xml:119
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/lxqt/desktop/libfm-extra.xml:122
#, xml-text
msgid ""
"<parameter>--with-extra-only</parameter>: This switch disables all "
"components except for the libfm-extra library."
msgstr ""
"<parameter>--with-extra-only</parameter>: Essa chave desabilita todos os "
"componentes, exceto a biblioteca libfm-extra."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/lxqt/desktop/libfm-extra.xml:127
#, xml-text
msgid ""
"<parameter>--with-gtk=no</parameter>: This switch disables support for "
"<application>GTK+</application> because it is not necessary for this "
"package."
msgstr ""
"<parameter>--with-gtk=no</parameter>: Essa chave desabilita suporte para "
"<application>GTK+</application>, porque não é necessário para esse pacote."

