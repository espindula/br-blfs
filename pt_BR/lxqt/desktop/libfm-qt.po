#. type: Content of: <sect1><sect2><para>
#: blfs-en/lxqt/desktop/libfm-qt.xml:29
#, xml-text
msgid ""
"<application>libfm-qt</application> is the Qt port of libfm, a library "
"providing components to build desktop file managers."
msgstr ""
"<application>libfm-qt</application> é a versão Qt da libfm, uma biblioteca "
"que fornece componentes para construir gerenciadores de arquivos de área de "
"trabalho."

