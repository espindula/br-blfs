#. type: Content of: <sect1><sect2><title>
#: blfs-en/lxqt/desktop/lxqt-kwindowsystem.xml:97
#, xml-text
msgid "Installation of kwindowsystem"
msgstr "Instalação do kwindowsystem"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/lxqt/desktop/lxqt-kwindowsystem.xml:100
#, xml-text
msgid ""
"Install <application>kwindowsystem</application> by running the following "
"commands:"
msgstr ""
"Instale o <application>kwindowsystem</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/lxqt/desktop/lxqt-kwindowsystem.xml:104
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir -v build &amp;&amp;\n"
"cd       build &amp;&amp;\n"
"\n"
"cmake -DCMAKE_INSTALL_PREFIX=/usr        \\\n"
"      -DCMAKE_INSTALL_LIBEXECDIR=libexec \\\n"
"      -DKDE_INSTALL_USE_QT_SYS_PATHS=ON  \\\n"
"      -DCMAKE_BUILD_TYPE=Release         \\\n"
"      -DBUILD_TESTING=OFF                \\\n"
"      -Wno-dev ..                        &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>mkdir -v build &amp;&amp;\n"
"cd       build &amp;&amp;\n"
"\n"
"cmake -DCMAKE_INSTALL_PREFIX=/usr        \\\n"
"      -DCMAKE_INSTALL_LIBEXECDIR=libexec \\\n"
"      -DKDE_INSTALL_USE_QT_SYS_PATHS=ON  \\\n"
"      -DCMAKE_BUILD_TYPE=Release         \\\n"
"      -DBUILD_TESTING=OFF                \\\n"
"      -Wno-dev ..                        &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/lxqt/desktop/lxqt-kwindowsystem.xml:116
#, xml-text
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/lxqt/desktop/lxqt-kwindowsystem.xml:120
#, xml-text
msgid "Now, as the &root; user:"
msgstr "Agora, como o(a) usuário(a) &root;:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/lxqt/desktop/lxqt-kwindowsystem.xml:123
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/lxqt/desktop/lxqt-kwindowsystem.xml:128
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/lxqt/desktop/lxqt-kwindowsystem.xml:131
#, xml-text
msgid ""
"<parameter>-DCMAKE_INSTALL_LIBEXECDIR=libexec</parameter>: This overrides "
"the default in extra-cmake-modules, which is <filename "
"class=\"directory\">/usr/lib/libexec</filename> and is not FHS compliant."
msgstr ""
"<parameter>-DCMAKE_INSTALL_LIBEXECDIR=libexec</parameter>: Isso substitui o "
"padrão em extra-cmake-modules, que é <filename "
"class=\"directory\">/usr/lib/libexec</filename> e não é compatível com FHS."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/lxqt/desktop/lxqt-kwindowsystem.xml:137
#, xml-text
msgid ""
"<parameter>-DKDE_INSTALL_USE_QT_SYS_PATHS=ON</parameter>: This forces "
"installation of Qt plugins in the same directory as <xref linkend=\"qt5\"/> "
"itself. Otherwise they get installed into <filename "
"class=\"directory\">/usr/mkspecs</filename>, which is not FHS compliant."
msgstr ""
"<parameter>-DKDE_INSTALL_USE_QT_SYS_PATHS=ON</parameter>: Isso força a "
"instalação de plugins Qt no mesmo diretório que o próprio <xref "
"linkend=\"qt5\"/>. Caso contrário, eles serão instalados em <filename "
"class=\"directory\">/usr/mkspecs</filename>, que não é compatível com FHS."

