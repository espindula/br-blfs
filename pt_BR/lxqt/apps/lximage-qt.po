#. type: Content of: <sect1><sect2><title>
#: blfs-en/lxqt/apps/lximage-qt.xml:78
#, xml-text
msgid "Installation of lximage-qt"
msgstr "Instalação do lximage-qt"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/lxqt/apps/lximage-qt.xml:81
#, xml-text
msgid ""
"Install <application>lximage-qt</application> by running the following "
"commands:"
msgstr ""
"Instale o <application>lximage-qt</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/lxqt/apps/lximage-qt.xml:85
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir -v build &amp;&amp;\n"
"cd       build &amp;&amp;\n"
"\n"
"cmake -DCMAKE_BUILD_TYPE=Release  \\\n"
"      -DCMAKE_INSTALL_PREFIX=/usr \\\n"
"      ..       &amp;&amp;\n"
"\n"
"make</userinput>"
msgstr ""
"<userinput>mkdir -v build &amp;&amp;\n"
"cd       build &amp;&amp;\n"
"\n"
"cmake -DCMAKE_BUILD_TYPE=Release  \\\n"
"      -DCMAKE_INSTALL_PREFIX=/usr \\\n"
"      ..       &amp;&amp;\n"
"\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/lxqt/apps/lximage-qt.xml:95
#, xml-text
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/lxqt/apps/lximage-qt.xml:99
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/lxqt/apps/lximage-qt.xml:102
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/lxqt/apps/lximage-qt.xml:105
#, xml-text
msgid ""
"If you have <xref linkend=\"xdg-utils\"/> installed, as the &root; user, run"
" <command>xdg-icon-resource forceupdate --theme hicolor</command>."
msgstr ""
"Se você tiver o <xref linkend=\"xdg-utils\"/> instalado, como o(a) "
"usuário(a) &root;, execute <command>xdg-icon-resource forceupdate --theme "
"hicolor</command>."

