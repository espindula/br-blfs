#: blfs-en/xincludes/without-scrollkeeper.xml:7
msgid ""
"<option>--disable-scrollkeeper</option>: Use this parameter if you have "
"installed <application>Rarian</application> but wish to disable the updates "
"to the Scrollkeeper database."
msgstr ""
"<option>--disable-scrollkeeper</option>: Use esse parâmetro se você tiver "
"instalado o <application>Rarian</application>, mas desejar desabilitar as "
"atualizações para a base de dados Scrollkeeper."
