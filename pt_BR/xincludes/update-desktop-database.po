#, xml-text
msgid "<note>"
msgstr "<note>"

#. type: Content of: <note><para>
#: blfs-en/xincludes/update-desktop-database.xml:8
#, xml-text
msgid ""
"This package installs desktop files into the <filename "
"class=\"directory\">/usr/share/applications</filename> hierarchy and you can"
" improve system performance and memory usage by updating "
"<filename>/usr/share/applications/mimeinfo.cache</filename>.  To perform the"
" update you must have <xref linkend=\"desktop-file-utils\"/> installed and "
"issue the following command as the <systemitem "
"class=\"username\">root</systemitem> user:"
msgstr ""
"Esse pacote instala arquivos de área de trabalho na hierarquia <filename "
"class=\"directory\">/usr/share/applications</filename> e você pode melhorar "
"o desempenho do sistema e o uso de memória atualizando "
"<filename>/usr/share/applications/mimeinfo.cache</filename>. Para realizar a"
" atualização, você precisa ter o <xref linkend=\"desktop-file-utils\"/> "
"instalado e emitir o seguinte comando como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <note><screen>
#: blfs-en/xincludes/update-desktop-database.xml:17
#, no-wrap, xml-text
msgid "<userinput>update-desktop-database -q</userinput>"
msgstr "<userinput>update-desktop-database -q</userinput>"

