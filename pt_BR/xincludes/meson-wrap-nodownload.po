#: blfs-en/xincludes/meson-wrap-nodownload.xml:7
#, xml-text
msgid ""
"<parameter>--wrap-mode=nodownload</parameter>: This switch prevents "
"<command>meson</command> from downloading any optional dependency which is "
"not installed on the system."
msgstr ""
"<parameter>--wrap-mode=nodownload</parameter>: Essa chave impede que o "
"<command>meson</command> baixe qualquer dependência opcional que não esteja "
"instalada no sistema."
