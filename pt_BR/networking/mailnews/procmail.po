#. type: Content of: <sect1><sect2><title>
#: blfs-en/networking/mailnews/procmail.xml:95
#, xml-text
msgid "Installation of Procmail"
msgstr "Instalação do Procmail"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/mailnews/procmail.xml:98
#, xml-text
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/mailnews/procmail.xml:102
#, xml-text
msgid ""
"Install <application>Procmail</application> by running the following "
"commands as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Instale o &quot;<application>Procmail</application>&quot; executando os "
"seguintes comandos como o(a) usuário(a) &quot;<systemitem "
"class=\"username\">root</systemitem>&quot;:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/networking/mailnews/procmail.xml:106
#, no-wrap, xml-text
msgid ""
"<userinput>sed -i 's/getline/get_line/' src/*.[ch]                   &amp;&amp;\n"
"patch -Np1 -i ../procmail-&procmail-version;-consolidated_fixes-1.patch &amp;&amp;\n"
"\n"
"make LOCKINGTEST=/tmp MANDIR=/usr/share/man install       &amp;&amp;\n"
"make install-suid</userinput>"
msgstr ""
"<userinput>sed -i 's/getline/get_line/' src/*.[ch]                  &amp;&amp;\n"
"patch -Np1 -i ../procmail-&procmail-version;-consolidated_fixes-1.patch &amp;&amp;\n"
"\n"
"make LOCKINGTEST=/tmp MANDIR=/usr/share/man install       &amp;&amp;\n"
"make install-suid</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/networking/mailnews/procmail.xml:115
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/mailnews/procmail.xml:118
#, xml-text
msgid ""
"<command>sed -i 's/getline/get_line/' src/*.[ch]</command>: This renames "
"procmail's getline function to avoid conflict with the getline function from"
" <application>glibc</application>."
msgstr ""
"<command>sed -i 's/getline/get_line/' src/*.[ch]</command>: Isso renomeia a "
"função &quot;getline&quot; do &quot;Procmail&quot; para evitar conflito com "
"a função &quot;getline&quot; proveniente da "
"&quot;<application>glibc</application>&quot;."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/mailnews/procmail.xml:124
#, xml-text
msgid ""
"<command>make LOCKINGTEST=/tmp install</command>: This prevents "
"<command>make</command> from asking you where to test file-locking patterns."
msgstr ""
"<command>make LOCKINGTEST=/tmp install</command>: Isso evita que o "
"&quot;<command>make</command>&quot; te pergunte onde testar os padrões de "
"bloqueio de arquivos."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/mailnews/procmail.xml:130
#, xml-text
msgid ""
"<command>make install-suid</command>: Modifies permissions of the installed "
"files."
msgstr ""
"<command>make install-suid</command>: Modifica as permissões dos arquivos "
"instalados."

