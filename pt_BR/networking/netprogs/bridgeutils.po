#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/netprogs/bridgeutils.xml:29
#, xml-text
msgid ""
"The <application>bridge-utils</application> package contains a utility "
"needed to create and manage bridge devices.  This is useful in setting up "
"networks for a hosted virtual machine (VM)."
msgstr ""
"O pacote &quot;<application>bridge-utils</application>&quot; contém um "
"utilitário necessário para criar e gerenciar dispositivos de ponte. Isso é "
"útil na configuração de redes de intercomunicação para uma máquina virtual "
"(&quot;MV&quot;) hospedada."

