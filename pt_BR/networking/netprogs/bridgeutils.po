#, xml-text
msgid "Configuring bridge-utils"
msgstr "Configurando o bridge-utils"

#. type: Content of: <sect1><sect2><sect3><title>
#: blfs-en/networking/netprogs/bridgeutils.xml:129
#, xml-text
