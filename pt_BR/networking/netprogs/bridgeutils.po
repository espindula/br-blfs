msgstr "Instalação do bridge-utils"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/netprogs/bridgeutils.xml:101
#, xml-text
msgid ""
"Install <application>bridge-utils</application> by running the following "
"commands:"
msgstr ""
"Instale &quot;<application>bridge-utils</application>&quot; executando os "
"seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/networking/netprogs/bridgeutils.xml:105
#, no-wrap, xml-text
msgid ""
"<userinput>autoconf                  &amp;&amp;\n"
"./configure --prefix=/usr &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>autoconf                  &amp;&amp;\n"
"./configure --prefix=/usr &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/netprogs/bridgeutils.xml:110
#, xml-text
msgid ""
"Testing the results requires running the six shell scripts in the <filename "
"class='directory'>tools/</filename> directory.  Two of the tests require two"
" ethernet ports.  Some tests will not preserve the current network "
"configuration.  See <filename>tests/README</filename> for details."
msgstr ""
"Testar os resultados exige executar-se os seis conjuntos sequenciais de "
"comandos de &quot;shell&quot; no diretório &quot;<filename "
"class='directory'>tools/</filename>&quot;. Dois dos testes exigem duas "
"portas &quot;Ethernet&quot;. Alguns testes não preservarão a configuração "
"atual da rede de intercomunicação. Veja-se "
"&quot;<filename>tests/README</filename>&quot; para detalhes."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/netprogs/bridgeutils.xml:118
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) &quot;<systemitem "
"class=\"username\">root</systemitem>&quot;:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/networking/netprogs/bridgeutils.xml:121
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

