#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/netprogs/wget.xml:84
#, xml-text
msgid ""
"<xref linkend=\"gnutls\"/>, <xref linkend=\"perl-http-daemon\"/> (for the "
"test suite), <xref linkend=\"perl-io-socket-ssl\"/> (for the test suite), "
"<xref linkend=\"libidn2\"/>, <xref linkend=\"pcre2\"/>, and <xref "
"linkend=\"valgrind\"/> (for the test suite)"
msgstr ""
"<xref linkend=\"gnutls\"/>, <xref linkend=\"perl-http-daemon\"/> (para a "
"suíte de teste), <xref linkend=\"perl-io-socket-ssl\"/> (para a suíte de "
"teste), <xref linkend=\"libidn2\"/>, <xref linkend=\"pcre2\"/> e <xref "
"linkend=\"valgrind\"/> (para a suíte de teste)"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/networking/netprogs/wget.xml:95
#, xml-text
msgid "Installation of Wget"
msgstr "Instalação do Wget"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/netprogs/wget.xml:98
#, xml-text
msgid ""
"Install <application>Wget</application> by running the following commands:"
msgstr ""
"Instale o &quot;<application>Wget</application>&quot; executando os "
"seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/networking/netprogs/wget.xml:101
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr      \\\n"
"            --sysconfdir=/etc  \\\n"
"            --with-ssl=openssl &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>./configure --prefix=/usr     \\\n"
"            --sysconfdir=/etc  \\\n"
"            --with-ssl=openssl &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/netprogs/wget.xml:107
#, xml-text
#| msgid ""
#| "To test the results, issue: <command>make check</command>. A few tests are "
#| "known to fail due to an incompatibility with Python 3.12."
msgid "To test the results, issue: <command>make check</command>."
msgstr "Para testar os resultados, emita: <command>make check</command>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/netprogs/wget.xml:120
#, xml-text
msgid "Some tests may fail when Valgrind tests are enabled."
msgstr ""
"Alguns testes possivelmente falhem quando os testes &quot;Valgrind&quot; "
"estiverem habilitados."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/netprogs/wget.xml:124
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) &quot;<systemitem "
"class=\"username\">root</systemitem>&quot;:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/networking/netprogs/wget.xml:127
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/networking/netprogs/wget.xml:131
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/netprogs/wget.xml:134
#, xml-text
msgid ""
"<parameter>--sysconfdir=/etc</parameter>: This relocates the configuration "
"file from <filename class=\"directory\">/usr/etc</filename> to <filename "
"class=\"directory\">/etc</filename>."
msgstr ""
"<parameter>--sysconfdir=/etc</parameter>: Isso realoca o arquivo de "
"configuração de &quot;<filename "
"class=\"directory\">/usr/etc</filename>&quot; para &quot;<filename "
"class=\"directory\">/etc</filename>&quot;."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/netprogs/wget.xml:140
#, xml-text
msgid ""
"<parameter>--with-ssl=openssl</parameter>: This allows the program to use "
"openssl instead of <xref linkend=\"gnutls\"/>."
msgstr ""
"<parameter>--with-ssl=openssl</parameter>: Isso permite que o aplicativo use"
" o &quot;OpenSSL&quot; em vez do &quot;<xref linkend=\"gnutls\"/>&quot;."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/netprogs/wget.xml:145
#, xml-text
msgid ""
"<option>--enable-valgrind-tests</option>: This allows the tests to be run "
"under valgrind."
msgstr ""
"<option>--enable-valgrind-tests</option>: Isso permite que os testes sejam "
"executados sob o &quot;Valgrind&quot;."

