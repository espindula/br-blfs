#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/netprogs/wget.xml:30
#, xml-text
msgid ""
"The <application>Wget</application> package contains a utility useful for "
"non-interactive downloading of files from the Web."
msgstr ""
"O pacote <application>Wget</application> contém um utilitário útil para "
"transferência não interativa de arquivos a partir da &quot;Web&quot;."

