msgstr "Recomendadas em tempo de execução"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/netprogs/wget.xml:79
#, xml-text
msgid "<xref role=\"runtime\" linkend=\"make-ca\"/>"
msgstr "<xref role=\"runtime\" linkend=\"make-ca\"/>"

