#. type: Content of: <sect1><sect2><title>
#: blfs-en/networking/netutils/nmap.xml:26
#, xml-text
msgid "Introduction to Nmap"
msgstr "Introdução ao Nmap"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/netutils/nmap.xml:29
#, xml-text
msgid ""
"<application>Nmap</application> is a utility for network exploration and "
"security auditing. It supports ping scanning, port scanning and TCP/IP "
"fingerprinting."
msgstr ""
"&quot;<application>Nmap</application>&quot; é um utilitário para exploração "
"de rede de intercomunicação e auditoria de segurança. Ele suporta varredura "
"de &quot;ping&quot;, varredura de porta e impressão digital "
"&quot;TCP&quot;/&quot;IP&quot;."

