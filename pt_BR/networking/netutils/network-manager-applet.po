#. type: Content of: <sect1><sect2><title>
#: blfs-en/networking/netutils/network-manager-applet.xml:107
#, xml-text
msgid "Installation of NetworkManager Applet"
msgstr "Instalação do NetworkManager Applet"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/netutils/network-manager-applet.xml:110
#, xml-text
msgid ""
"Install <application>NetworkManager Applet</application> by running the "
"following commands:"
msgstr ""
"Instale o &quot;<application>NetworkManager Applet</application>&quot; "
"executando os seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/networking/netutils/network-manager-applet.xml:114
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup ..            \\\n"
"      --prefix=/usr       \\\n"
"      --buildtype=release \\\n"
"      -Dappindicator=no   \\\n"
"      -Dselinux=false     &amp;&amp;\n"
"ninja</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup ..            \\\n"
"      --prefix=/usr       \\\n"
"      --buildtype=release \\\n"
"      -Dappindicator=no   \\\n"
"      -Dselinux=false     &amp;&amp;\n"
"ninja</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/netutils/network-manager-applet.xml:125
#, xml-text
msgid "To test the results, issue: <command>ninja test</command>."
msgstr "Para testar os resultados, emita: <command>ninja test</command>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/netutils/network-manager-applet.xml:129
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) &quot;<systemitem "
"class=\"username\">root</systemitem>&quot;:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/networking/netutils/network-manager-applet.xml:132
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr "<userinput>ninja install</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/networking/netutils/network-manager-applet.xml:137
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/netutils/network-manager-applet.xml:140
#, xml-text
msgid ""
"<parameter>-Dappindicator=no</parameter>: This switch disables AppIndicator "
"support in network-manager-applet because it requires libindicator, which is"
" not in BLFS. The build will fail without this option."
msgstr ""
"<parameter>-Dappindicator=no</parameter>: Essa chave desabilita o suporte ao"
" &quot;AppIndicator&quot; no &quot;network-manager-applet&quot; porque ele "
"exige a &quot;libindicator&quot;, que não está no BLFS. A construção falhará"
" sem essa opção."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/netutils/network-manager-applet.xml:155
#, xml-text
msgid ""
"<parameter>-Dselinux=false</parameter>: This switch forcibly disables "
"<application>SELinux</application> support since it is not currently in BLFS"
" and the build will fail without it."
msgstr ""
"<parameter>-Dselinux=false</parameter>: Essa chave desabilita forçosamente o"
" suporte ao &quot;<application>SELinux</application>&quot;, uma vez que ele "
"atualmente não está no BLFS e a construção falhará sem ela."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/netutils/network-manager-applet.xml:174
#, xml-text
msgid ""
"<option>-Dwwan=false</option>: This switch disables WWAN support.  Use this "
"if you do not have <xref linkend=\"ModemManager\"/> installed."
msgstr ""
"<option>-Dwwan=false</option>: Essa chave desabilita o suporte "
"&quot;WWAN&quot;. Use isso se você não tiver o &quot;<xref "
"linkend=\"ModemManager\"/>&quot; instalado."

