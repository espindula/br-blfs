#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/netlibs/uhttpmock.xml:29
#, xml-text
msgid ""
"The <application>uhttpmock</application> package contains a library for "
"mocking web service APIs which use HTTP or HTTPS."
msgstr ""
"O pacote &quot;<application>uhttpmock</application>&quot; contém uma "
"biblioteca para simular &quot;APIs&quot; de serviços da &quot;web&quot; que "
"usem &quot;HTTP&quot; ou &quot;HTTPS&quot;."

