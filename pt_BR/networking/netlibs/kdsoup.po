#. type: Content of: <sect1><sect2><title>
#: blfs-en/networking/netlibs/kdsoup.xml:81
msgid "Installation of kdsoap"
msgstr "Instalação do <quote>kdsoap</quote>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/netlibs/kdsoup.xml:84
msgid ""
"Install <application>kdsoap</application> by running the following commands:"
msgstr ""
"Instale o &quot;<application>kdsoap</application>&quot; executando os "
"seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/networking/netlibs/kdsoup.xml:88
#, no-wrap
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -DCMAKE_INSTALL_PREFIX=/usr \\\n"
"      -DCMAKE_BUILD_TYPE=Release  \\\n"
"      -DCMAKE_INSTALL_DOCDIR=/usr/share/doc/kdsoap-&kdsoap-version; \\\n"
"      .. &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd   build &amp;&amp;\n"
"\n"
"cmake -DCMAKE_INSTALL_PREFIX=/usr \\\n"
"      -DCMAKE_BUILD_TYPE=Release  \\\n"
"      -DCMAKE_INSTALL_DOCDIR=/usr/share/doc/kdsoap-&kdsoap-version; \\\n"
"      .. &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/netlibs/kdsoup.xml:98
msgid "The package does not come with a test suite."
msgstr "O pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/netlibs/kdsoup.xml:102
