#. type: Content of: <sect1><sect2><title>
#: blfs-en/networking/netlibs/glib-networking.xml:104
#, xml-text
msgid "Installation of GLib Networking"
msgstr "Instalação do GLib Networking"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/netlibs/glib-networking.xml:112
#, xml-text
msgid ""
"Install <application>GLib Networking</application> by running the following "
"commands:"
msgstr ""
"Instale o &quot;<application>GLib Networking</application>&quot; executando "
"os seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/networking/netlibs/glib-networking.xml:116
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup            \\\n"
"   --prefix=/usr       \\\n"
"   --buildtype=release \\\n"
"   -Dlibproxy=disabled \\\n"
"   .. &amp;&amp;\n"
"ninja</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup            \\\n"
"   --prefix=/usr       \\\n"
"   --buildtype=release \\\n"
"   -Dlibproxy=disabled \\\n"
"   .. &amp;&amp;\n"
"ninja</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/netlibs/glib-networking.xml:127
#, xml-text
msgid "To test the results, issue: <command>ninja test</command>."
msgstr "Para testar os resultados, emita: <command>ninja test</command>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/netlibs/glib-networking.xml:131
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) &quot;<systemitem "
"class=\"username\">root</systemitem>&quot;:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/networking/netlibs/glib-networking.xml:134
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr "<userinput>ninja install</userinput>"

