#. type: Content of: <sect1><sect2><title>
#: blfs-en/networking/netlibs/libnma.xml:93
#, xml-text
msgid "Installation of libnma"
msgstr "Instalação do libnma"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/netlibs/libnma.xml:96
#, xml-text
msgid ""
"Install <application>libnma</application> by running the following commands:"
msgstr ""
"Instale o &quot;<application>libnma</application>&quot; executando os "
"seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/networking/netlibs/libnma.xml:100
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup ..                               \\\n"
"      --prefix=/usr                          \\\n"
"      --buildtype=release                    \\\n"
"      -Dgtk_doc=false                        \\\n"
"      -Dlibnma_gtk4=true                     \\\n"
"      -Dmobile_broadband_provider_info=false &amp;&amp;\n"
"ninja</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup ..                               \\\n"
"      --prefix=/usr                          \\\n"
"      --buildtype=release                    \\\n"
"      -Dgtk_doc=false                        \\\n"
"      -Dlibnma_gtk4=true                     \\\n"
"      -Dmobile_broadband_provider_info=false &amp;&amp;\n"
"ninja</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/netlibs/libnma.xml:112
#, xml-text
msgid "To test the results, issue: <command>ninja test</command>."
msgstr "Para testar os resultados, emita: <command>ninja test</command>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/netlibs/libnma.xml:116
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) &quot;<systemitem "
"class=\"username\">root</systemitem>&quot;:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/networking/netlibs/libnma.xml:119
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr "<userinput>ninja install</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/networking/netlibs/libnma.xml:123
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/netlibs/libnma.xml:129
#, xml-text
msgid ""
"<parameter>-Dgtk_doc=false</parameter>: This parameter disables generating "
"API documentation using gtk-doc. If you have <xref role=\"nodep\" "
"linkend=\"gtk-doc\"/> installed and wish to generate the API documentation, "
"omit this switch."
msgstr ""
"<parameter>-Dgtk_doc=false</parameter>: Esse parâmetro desabilita a geração "
"da documentação da &quot;API&quot; usando &quot;gtk-doc&quot;. Se você tiver"
" o &quot;<xref role=\"nodep\" linkend=\"gtk-doc\"/>&quot; instalado e "
"desejar gerar a documentação da &quot;API&quot;, [então] omita essa chave."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/netlibs/libnma.xml:136
#, xml-text
msgid ""
"<parameter>-Dlibnma_gtk4=true</parameter>: This parameter builds the GTK-4 "
"version of libnma. It is needed by <xref linkend=\"gnome-control-center\"/>."
msgstr ""
"<parameter>-Dlibnma_gtk4=true</parameter>: Esse parâmetro constrói a versão "
"GTK-4 da libnma. É necessário para o <xref linkend=\"gnome-control-center\""
"/>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/netlibs/libnma.xml:142
#, xml-text
msgid ""
"<parameter>-Dmobile_broadband_provider_info=false</parameter>: This switch "
"disables WWAN support because mobile-broadband-provider-info is not in BLFS."
" Omit this switch if you have it installed and wish to enable WWAN support."
msgstr ""
"<parameter>-Dmobile_broadband_provider_info=false</parameter>: Essa chave "
"desabilita o suporte a &quot;WWAN&quot; porque as informações do provedor de"
" banda larga móvel não estão no BLFS. Omita essa chave se você a tiver "
"instalada e desejar habilitar o suporte a &quot;WWAN&quot;."

