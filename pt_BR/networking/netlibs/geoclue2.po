#. type: Content of: <sect1><sect2><title>
#: blfs-en/networking/netlibs/geoclue2.xml:96
#, xml-text
msgid "Installation of GeoClue"
msgstr "Instalação do GeoClue"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/netlibs/geoclue2.xml:99
#, xml-text
msgid ""
"Install <application>GeoClue</application> by running the following "
"commands:"
msgstr ""
"Instale o &quot;<application>GeoClue</application>&quot; executando os "
"seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/networking/netlibs/geoclue2.xml:103
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr       \\\n"
"            --buildtype=release \\\n"
"            -Dgtk-doc=false     \\\n"
"            ..                  &amp;&amp;\n"
"ninja</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr       \\\n"
"            --buildtype=release \\\n"
"            -Dgtk-doc=false     \\\n"
"            ..                  &amp;&amp;\n"
"ninja</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/netlibs/geoclue2.xml:113
#, xml-text
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/netlibs/geoclue2.xml:117
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) &quot;<systemitem "
"class=\"username\">root</systemitem>&quot;:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/networking/netlibs/geoclue2.xml:120
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr "<userinput>ninja install</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/networking/netlibs/geoclue2.xml:125
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/netlibs/geoclue2.xml:131
#, xml-text
msgid ""
"<option>-D3g-source=false</option>: This switch disables the 3G backend. Use"
" it if you have not installed the <application>ModemManager</application> "
"package."
msgstr ""
"<option>-D3g-source=false</option>: Essa chave desativa a estrutura de "
"retaguarda &quot;3G&quot;. Use-a se você não tiver instalado o pacote "
"&quot;<application>ModemManager</application>&quot;."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/netlibs/geoclue2.xml:137
#, xml-text
msgid ""
"<option>-Dmodem-gps-source=false</option>: This switch disables the modem "
"GPS backend. Use it if you have not installed the "
"<application>ModemManager</application> package."
msgstr ""
"<option>-Dmodem-gps-source=false</option>: Essa chave desativa a estrutura "
"de retaguarda &quot;GPS&quot; do modem. Use-a se você não tiver instalado o "
"pacote &quot;<application>ModemManager</application>&quot;."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/netlibs/geoclue2.xml:143
#, xml-text
msgid ""
"<option>-Dcdma-source=false</option>: This switch disables the CDMA source "
"backend. Use it if you have not installed the "
"<application>ModemManager</application> package."
msgstr ""
"<option>-Dcdma-source=false</option>: Essa chave desabilita a estrutura de "
"retaguarda fonte &quot;CDMA&quot;. Use-a se você não tiver instalado o "
"pacote &quot;<application>ModemManager</application>&quot;."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/netlibs/geoclue2.xml:149
#, xml-text
msgid ""
"<option>-Dnmea-source=false</option>: This switch disables the NMEA source. "
"Use it if you have not installed the <application>Avahi</application> "
"package."
msgstr ""
"<option>-Dnmea-source=false</option>: Essa chave desabilita a fonte "
"&quot;NMEA&quot;. Use-a se você não tiver instalado o pacote "
"&quot;<application>Avahi</application>&quot;."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/netlibs/geoclue2.xml:155
#, xml-text
msgid ""
"<option>-Ddemo-agent=false</option>: This switch disables the demo. Use it "
"if you have not installed the <application>libnotify</application> package."
msgstr ""
"<option>-Ddemo-agent=false</option>: Essa chave desabilita a demonstração. "
"Use-a se você não tiver instalado o pacote "
"&quot;<application>libnotify</application>&quot;."

