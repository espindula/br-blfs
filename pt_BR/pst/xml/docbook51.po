msgstr "Instalação do DocBook XML Schemas 5.1"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/pst/xml/docbook51.xml:91
#, xml-text
msgid ""
"Install <application>DocBook XML Schemas</application> by running the "
"following commands as the <systemitem class=\"username\">root</systemitem> "
"user:"
msgstr ""
"Instale o <application>DocBook XML Schemas</application> executando os "
"seguintes comandos como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/pst/xml/docbook51.xml:96
#, no-wrap, xml-text
msgid ""
"<userinput>install -vdm755 /usr/share/xml/docbook/schema/{rng,sch}/5.1         &amp;&amp;\n"
"install -m644   schemas/rng/* /usr/share/xml/docbook/schema/rng/5.1 &amp;&amp;\n"
"install -m644   schemas/sch/* /usr/share/xml/docbook/schema/sch/5.1 &amp;&amp;\n"
"install -m755   tools/db4-entities.pl /usr/bin                      &amp;&amp;\n"
"install -vdm755 /usr/share/xml/docbook/stylesheet/docbook5          &amp;&amp;\n"
"install -m644   tools/db4-upgrade.xsl \\\n"
"                /usr/share/xml/docbook/stylesheet/docbook5</userinput>"
msgstr ""
"<userinput>install -vdm755 /usr/share/xml/docbook/schema/{rng,sch}/5.1         &amp;&amp;\n"
"install -m644   schemas/rng/* /usr/share/xml/docbook/schema/rng/5.1 &amp;&amp;\n"
"install -m644   schemas/sch/* /usr/share/xml/docbook/schema/sch/5.1 &amp;&amp;\n"
"install -m755   tools/db4-entities.pl /usr/bin                      &amp;&amp;\n"
"install -vdm755 /usr/share/xml/docbook/stylesheet/docbook5          &amp;&amp;\n"
"install -m644   tools/db4-upgrade.xsl \\\n"
"                /usr/share/xml/docbook/stylesheet/docbook5</userinput>"

