#. type: Content of: <sect1><sect2><para>
#: blfs-en/pst/typesetting/asymptote.xml:165
#, xml-text
msgid ""
"First apply a patch to fix building without the Language Server Protocol :"
msgstr ""
"Primeiro aplique um remendo para corrigir a construção sem o Language Server"
" Protocol:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/pst/typesetting/asymptote.xml:168
#, no-wrap, xml-text
msgid ""
"<userinput>patch -Np1 -i ../asymptote-&asymptote-"
"version;-build_fix-1.patch</userinput>"
msgstr ""
"<userinput>patch -Np1 -i ../asymptote-&asymptote-"
"version;-build_fix-1.patch</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/pst/typesetting/asymptote.xml:171
#, xml-text
msgid ""
"Install <application>asymptote</application> by running the following "
"commands:"
msgstr ""
"Instale o <application>asymptote</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/pst/typesetting/asymptote.xml:175
#, no-wrap, xml-text
msgid ""
"<userinput>export TEXARCH=$(uname -m | sed -e 's/i.86/i386/' -e 's/$/-linux/') &amp;&amp;\n"
"\n"
"./configure --prefix=$TEXLIVE_PREFIX                          \\\n"
"            --bindir=$TEXLIVE_PREFIX/bin/$TEXARCH             \\\n"
"            --datarootdir=$TEXLIVE_PREFIX/texmf-dist          \\\n"
"            --infodir=$TEXLIVE_PREFIX/texmf-dist/doc/info     \\\n"
"            --libdir=$TEXLIVE_PREFIX/texmf-dist               \\\n"
"            --mandir=$TEXLIVE_PREFIX/texmf-dist/doc/man       \\\n"
"            --disable-lsp                                     \\\n"
"            --enable-gc=system                                \\\n"
"            --with-latex=$TEXLIVE_PREFIX/texmf-dist/tex/latex \\\n"
"            --with-context=$TEXLIVE_PREFIX/texmf-dist/tex/context/third &amp;&amp;\n"
"\n"
"make</userinput>"
msgstr ""
"<userinput>export TEXARCH=$(uname -m | sed -e 's/i.86/i386/' -e 's/$/-linux/') &amp;&amp;\n"
"\n"
"./configure --prefix=$TEXLIVE_PREFIX                          \\\n"
"            --bindir=$TEXLIVE_PREFIX/bin/$TEXARCH             \\\n"
"            --datarootdir=$TEXLIVE_PREFIX/texmf-dist          \\\n"
"            --infodir=$TEXLIVE_PREFIX/texmf-dist/doc/info     \\\n"
"            --libdir=$TEXLIVE_PREFIX/texmf-dist               \\\n"
"            --mandir=$TEXLIVE_PREFIX/texmf-dist/doc/man       \\\n"
"            --disable-lsp                                     \\\n"
"            --enable-gc=system                                \\\n"
"            --with-latex=$TEXLIVE_PREFIX/texmf-dist/tex/latex \\\n"
"            --with-context=$TEXLIVE_PREFIX/texmf-dist/tex/context/third &amp;&amp;\n"
"\n"
"make</userinput>"

