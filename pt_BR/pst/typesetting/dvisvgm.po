#. type: Content of: <sect1><sect2><title>
#: blfs-en/pst/typesetting/dvisvgm.xml:104
#, xml-text
msgid "Installation of dvisvgm"
msgstr "Instalação do dvisvgm"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/pst/typesetting/dvisvgm.xml:117
#, xml-text
msgid ""
"The test suite assumes that a modern version of "
"<application>Python</application> has been installed as plain "
"<command>python</command>. Changing this to use <command>python3</command> "
"requires a sed to one <filename>Makefile.in</filename> file."
msgstr ""
"A suíte de teste assume que uma versão moderna do "
"<application>Python</application> tenha sido instalada como "
"<command>python</command> simples. Mudar isso para usar o "
"<command>python3</command> exige um sed para um arquivo "
"<filename>Makefile.in</filename>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/pst/typesetting/dvisvgm.xml:124
#, xml-text
msgid ""
"Install <application>dvisvgm</application> by running the following "
"commands:"
msgstr ""
"Instale o <application>dvisvgm</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/pst/typesetting/dvisvgm.xml:128
#, no-wrap, xml-text
msgid ""
"<userinput>sed -i 's/python/&amp;3/' tests/Makefile.in         &amp;&amp;\n"
"./configure                                     \\\n"
"    --bindir=$TEXLIVE_PREFIX/bin/${TEXARCH}     \\\n"
"    --mandir=$TEXLIVE_PREFIX/texmf-dist/doc/man \\\n"
"    --with-kpathsea=$TEXLIVE_PREFIX             &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>sed -i 's/python/&amp;3/' tests/Makefile.in         &amp;&amp;\n"
"./configure                                     \\\n"
"    --bindir=$TEXLIVE_PREFIX/bin/${TEXARCH}     \\\n"
"    --mandir=$TEXLIVE_PREFIX/texmf-dist/doc/man \\\n"
"    --with-kpathsea=$TEXLIVE_PREFIX             &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/pst/typesetting/dvisvgm.xml:136
#, xml-text
msgid "To test the results, issue: <command>make check</command>."
msgstr "Para testar os resultados, emita: <command>make check</command>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/pst/typesetting/dvisvgm.xml:140
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/pst/typesetting/dvisvgm.xml:143
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/pst/typesetting/dvisvgm.xml:148
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/pst/typesetting/dvisvgm.xml:172
#, xml-text
msgid ""
"<parameter>--with-kpathsea=$TEXLIVE_PREFIX</parameter>: This allows the "
"build system to find the headers for <filename "
"class=\"libraryfile\">kpathsea</filename>"
msgstr ""
"<parameter>--with-kpathsea=$TEXLIVE_PREFIX</parameter>: Isso permite que o "
"sistema de construção encontre os cabeçalhos para <filename "
"class=\"libraryfile\">kpathsea</filename>"

