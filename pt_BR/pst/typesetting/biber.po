msgid ""
"<userinput>perl ./Build.PL &amp;&amp;\n"
"./Build</userinput>"
msgstr ""
"<userinput>perl ./Build.PL &amp;&amp;\n"
"./Build</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/pst/typesetting/biber.xml:280
#, xml-text
msgid "To test the results, enter: <command>./Build test</command>"
msgstr "Para testar os resultados, digite: <command>./Build test</command>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/pst/typesetting/biber.xml:284
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. <screen role="root">
#. <userinput>tar -xf ../biblatex-&biblatex-version;.tds.tgz -C
#. /opt/texlive/&texlive-year;/texmf-dist &amp;&amp;
#. texhash &amp;&amp;
