#. type: Content of: <sect1><sect2><title>
#: blfs-en/gnome/applications/gnome-terminal.xml:100
#, xml-text
msgid "Installation of GNOME Terminal"
msgstr "Instalação do GNOME Terminal"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/applications/gnome-terminal.xml:103
#, xml-text
msgid "First, fix some deprecated schema entries:"
msgstr "Primeiro, corrija algumas entradas obsoletas de esquema:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/gnome/applications/gnome-terminal.xml:106
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"pre\">sed -i -r 's:\"(/system):\"/org/gnome\\1:g' "
"src/external.gschema.xml</userinput>"
msgstr ""
"<userinput remap=\"pre\">sed -i -r 's:\"(/system):\"/org/gnome\\1:g' "
"src/external.gschema.xml</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/applications/gnome-terminal.xml:109
#, xml-text
msgid ""
"Install <application>GNOME Terminal</application> by running the following "
"commands:"
msgstr ""
"Instale o <application>GNOME Terminal</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/gnome/applications/gnome-terminal.xml:113
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr --buildtype=release .. &amp;&amp;\n"
"ninja</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr --buildtype=release .. &amp;&amp;\n"
"ninja</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/applications/gnome-terminal.xml:120
#, xml-text
msgid "To test the results, issue: <command>ninja test</command>."
msgstr "Para testar os resultados, emita: <command>ninja test</command>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/applications/gnome-terminal.xml:124
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/gnome/applications/gnome-terminal.xml:127
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr "<userinput>ninja install</userinput>"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/gnome/applications/gnome-terminal.xml:129
#, no-wrap, xml-text
msgid ""
"<userinput>ninja install &amp;&amp;\n"
"rm -v /usr/lib/systemd/user/gnome-terminal-server.service</userinput>"
msgstr ""
"<userinput>ninja install &amp;&amp;\n"
"rm -v /usr/lib/systemd/user/gnome-terminal-server.service</userinput>"

#. type: Content of: <sect1><sect2><note><para>
#: blfs-en/gnome/applications/gnome-terminal.xml:134
#, xml-text
msgid ""
"To run <application>GNOME Terminal</application>, the environment variable "
"<envar>LANG</envar> must be set to a UTF-8 locale <emphasis>prior</emphasis>"
" to starting the graphical environment."
msgstr ""
"Para executar o <application>GNOME Terminal</application>, a variável de "
"ambiente <envar>LANG</envar> precisa ser configurada como uma localidade "
"UTF-8 <emphasis>antes</emphasis> de iniciar o ambiente gráfico."

#. type: Content of: <sect1><sect2><title>
#: blfs-en/gnome/applications/gnome-terminal.xml:143
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/applications/gnome-terminal.xml:149
#, xml-text
msgid ""
"<option>-D search_provider=false</option>: This switch disables the "
"<quote>search <application>gnome-shell</application></quote> provider. Use "
"this option if you do not have gnome-shell installed."
msgstr ""
"<option>-D search_provider=false</option>: Essa chave desabilita o provedor "
"<quote><application>gnome-shell</application> de busca</quote>. Use essa "
"opção se você não tiver o gnome-shell instalado."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/applications/gnome-terminal.xml:155
#, xml-text
msgid ""
"<option>-D nautilus_extension=false</option>: This switch disables a "
"dependency on the <application>nautilus</application> file manager. Use this"
" option if you do not have Nautilus installed."
msgstr ""
"<option>-D nautilus_extension=false</option>: Essa chave desabilita uma "
"dependência do gerenciador de arquivos <application>nautilus</application>. "
"Use essa opção se você não tiver o Nautilus instalado."

