#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/applications/gnome-terminal.xml:31
#, xml-text
msgid ""
"The <application>GNOME Terminal</application> package contains the terminal "
"emulator for <application>GNOME</application> Desktop."
msgstr ""
"O pacote <application>GNOME Terminal</application> contém o emulador de "
"terminal para a Área de Trabalho do <application>GNOME</application>."

