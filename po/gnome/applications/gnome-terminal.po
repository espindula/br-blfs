"schemas\"/>, <xref linkend=\"itstool\"/>, <xref linkend=\"libhandy1\"/>, "
"<xref linkend=\"pcre2\"/>, and <xref linkend=\"vte\"/>"
msgstr ""
"<xref linkend=\"dconf\"/>, <phrase revision=\"systemd\"><xref "
"linkend=\"gnome-shell\"/>,</phrase> <xref linkend=\"gsettings-desktop-"
"schemas\"/>, <xref linkend=\"itstool\"/>, <xref linkend=\"libhandy1\"/>, "
"<xref linkend=\"pcre2\"/> e <xref linkend=\"vte\"/>"

