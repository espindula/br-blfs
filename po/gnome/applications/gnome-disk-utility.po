#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/applications/gnome-disk-utility.xml:30
#, xml-text
msgid ""
"The <application>GNOME Disk Utility</application> package provides "
"applications used for dealing with storage devices."
msgstr ""
"O pacote <application>GNOME Disk Utility</application> fornece aplicativos "
"usados para lidar com dispositivos de armazenamento."

