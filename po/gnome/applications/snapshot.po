#. type: Content of: <sect1><sect2><title>
#: blfs-en/gnome/applications/snapshot.xml:87
#, xml-text
msgid "Installation of Snapshot"
msgstr "Instalação do Snapshot"

#. type: Content of: <sect1><sect2><note><para>
#: blfs-en/gnome/applications/snapshot.xml:91
#, xml-text
msgid ""
"This package takes a long time to build because LTO is enabled, and the LTO "
"pass is not parallelized."
msgstr ""
"Esse pacote leva muito tempo para construir porque o LTO está habilitado e a"
" passagem do LTO não é paralelizada."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/applications/snapshot.xml:97
#, xml-text
msgid ""
"Install <application>Snapshot</application> by running the following "
"commands:"
msgstr ""
"Instale <application>Snapshot</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/gnome/applications/snapshot.xml:101
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr --buildtype=release .. &amp;&amp;\n"
"ninja</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr --buildtype=release .. &amp;&amp;\n"
"ninja</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/applications/snapshot.xml:108
#, xml-text
msgid "To test the results, issue: <command>ninja test</command>."
msgstr "Para testar os resultados, emita: <command>ninja test</command>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/applications/snapshot.xml:112
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/gnome/applications/snapshot.xml:115
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr "<userinput>ninja install</userinput>"

