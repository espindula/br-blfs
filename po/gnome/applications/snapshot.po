#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/applications/snapshot.xml:28
#, xml-text
msgid ""
"The <application>Snapshot</application> package contains a program that "
"takes pictures and videos from a Webcam."
msgstr ""
"O pacote <application>Snapshot</application> contém um programa que tira "
"fotos e vídeos a partir de uma web câmera."

