"<xref linkend=\"libadwaita1\"/>, <xref linkend=\"gst10-plugins-bad\"/>, and "
"<xref linkend=\"rust\"/>"
msgstr ""
"<xref linkend=\"libadwaita1\"/>, <xref linkend=\"gst10-plugins-bad\"/> e "
"<xref linkend=\"rust\"/>"

