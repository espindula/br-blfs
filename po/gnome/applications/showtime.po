#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/applications/showtime.xml:28
#, xml-text
msgid ""
"<application>Showtime</application> is an application used for playing audio"
" and video files on the <application>GNOME</application> desktop."
msgstr ""
"<application>Showtime</application> é um aplicativo usado para reproduzir "
"arquivos de áudio e vídeo na área de trabalho do "
"<application>GNOME</application>."

