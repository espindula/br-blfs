#. type: Content of: <sect1><sect2><title>
#: blfs-en/gnome/applications/gucharmap.xml:119
#, xml-text
msgid "Installation of Gucharmap"
msgstr "Instalação do Gucharmap"

#. type: Content of: <sect1><sect2><note><para>
#: blfs-en/gnome/applications/gucharmap.xml:123
#, xml-text
msgid ""
"This package uses two unversioned downloads. You may want to rename these to"
" a versioned name, e.g. <filename>UCD-15.zip</filename> to make upgrades "
"easier."
msgstr ""
"Esse pacote usa dois downloads não versionados. Você possivelmente queira "
"renomeá-los para um nome com versão, por exemplo, "
"<filename>UCD-15.zip</filename> para facilitar as atualizações."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/applications/gucharmap.xml:130
#, xml-text
msgid ""
"Install <application>Gucharmap</application> by running the following "
"commands:"
msgstr ""
"Instale o <application>Gucharmap</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/gnome/applications/gucharmap.xml:134
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build                   &amp;&amp;\n"
"cd    build                   &amp;&amp;\n"
"mkdir ucd                     &amp;&amp;\n"
"pushd ucd                     &amp;&amp;\n"
"  unzip ../../../UCD.zip      &amp;&amp;\n"
"  cp -v ../../../Unihan.zip . &amp;&amp;\n"
"popd                          &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr       \\\n"
"            --strip             \\\n"
"            --buildtype=release \\\n"
"            -D ucd_path=./ucd   \\\n"
"            -D docs=false       \\\n"
"            ..                  &amp;&amp;\n"
"ninja</userinput>"
msgstr ""
"<userinput>mkdir build                   &amp;&amp;\n"
"cd    build                   &amp;&amp;\n"
"mkdir ucd                     &amp;&amp;\n"
"pushd ucd                     &amp;&amp;\n"
"  unzip ../../../UCD.zip      &amp;&amp;\n"
"  cp -v ../../../Unihan.zip . &amp;&amp;\n"
"popd                          &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr       \\\n"
"            --strip             \\\n"
"            --buildtype=release \\\n"
"            -D ucd_path=./ucd   \\\n"
"            -D docs=false       \\\n"
"            ..                  &amp;&amp;\n"
"ninja</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/applications/gucharmap.xml:151
#, xml-text
msgid "This package does not have a test suite."
msgstr "Esse pacote não tem uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/applications/gucharmap.xml:155
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/gnome/applications/gucharmap.xml:158
#, no-wrap, xml-text
msgid ""
"<userinput>rm  -fv /usr/share/glib-2.0/schemas/org.gnome.Charmap.enums.xml &amp;&amp;\n"
"ninja install</userinput>"
msgstr ""
"<userinput>rm  -fv /usr/share/glib-2.0/schemas/org.gnome.Charmap.enums.xml &amp;&amp;\n"
"ninja install</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/gnome/applications/gucharmap.xml:164
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/applications/gucharmap.xml:167
#, xml-text
msgid ""
"<parameter>--strip</parameter>: Although the package defaults to a release "
"build without debug information, without this switch there will be some "
"debug information in the binaries."
msgstr ""
"<parameter>--strip</parameter>: Embora o padrão do pacote seja uma "
"construção de lançamento sem informações de depuração, sem essa chave "
"existirão algumas informações de depuração nos binários."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/applications/gucharmap.xml:173
#, xml-text
msgid ""
"<parameter>-D ucd_path=./ucd</parameter>: This points to where the extracted"
" main Unicode data files, and the zipped Unihan archive can be found."
msgstr ""
"<parameter>-D ucd_path=./ucd</parameter>: Isso aponta para onde os "
"principais arquivos de dados Unicode extraídos e o arquivamento Unihan "
"zipado podem ser encontrados."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/applications/gucharmap.xml:178
#, xml-text
msgid ""
"<command>rm -fv "
"/usr/share/glib-2.0/schemas/org.gnome.Charmap.enums.xml</command>: Old "
"versions of this package installed an obsolete file that prevents the "
"program from running, as if the main schema has not been installed.  "
"Forcibly removing works even if the old file is not present."
msgstr ""
"<command>rm -fv "
"/usr/share/glib-2.0/schemas/org.gnome.Charmap.enums.xml</command>: Versões "
"antigas desse pacote instalavam um arquivo obsoleto que impede o aplicativo "
"de executar, como se o esquema principal não tivesse sido instalado. A "
"remoção forçada funciona mesmo que o arquivo antigo não esteja presente."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/applications/gucharmap.xml:185
#, xml-text
msgid ""
"<parameter>-D docs=false</parameter>: This allows the package to build even "
"if <application>gtk-doc</application> has not been installed. Remove this if"
" you have installed that and wish to build the documentation."
msgstr ""
"<parameter>-D docs=false</parameter>: Isso permite que o pacote construa "
"mesmo se o <application>gtk-doc</application> não tenha sido instalado. "
"Remova isso se você o tiver instalado e desejar construir a documentação."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/applications/gucharmap.xml:191
#, xml-text
msgid ""
"<option>-D gir=false</option>: Use this if you have not installed &gobject-"
"introspection;."
msgstr ""
"<option>-D gir=false</option>: Use isso se você não tiver instalado "
"&gobject-introspection;."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/applications/gucharmap.xml:196
#, xml-text
msgid ""
"<option>-D vapi=false</option>: Use this if you have not installed <xref "
"linkend=\"vala\"/>."
msgstr ""
"<option>-D vapi=false</option>: Use isso se você não tiver instalado o <xref"
" linkend=\"vala\"/>."

