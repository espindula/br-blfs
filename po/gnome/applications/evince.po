#. type: Content of: <sect1><sect2><title>
#: blfs-en/gnome/applications/evince.xml:114
#, xml-text
msgid "Installation of Evince"
msgstr "Instalação do Evince"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/applications/evince.xml:129
#, xml-text
msgid ""
"Install <application>Evince</application> by running the following commands:"
msgstr ""
"Instale o <application>Evince</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/gnome/applications/evince.xml:133
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"CPPFLAGS+=\" -I/opt/texlive/&texlive-year;/include -DNO_DEBUG\" \\\n"
"meson setup --prefix=/usr                \\\n"
"            --buildtype=release          \\\n"
"            -D gtk_doc=false             \\\n"
"            --wrap-mode=nodownload       \\\n"
"            -D systemduserunitdir=no ..  &amp;&amp;\n"
"ninja</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"CPPFLAGS+=\" -I/opt/texlive/&texlive-year;/include -DNO_DEBUG\" \\\n"
"meson setup --prefix=/usr                \\\n"
"            --buildtype=release          \\\n"
"            -D gtk_doc=false             \\\n"
"            --wrap-mode=nodownload       \\\n"
"            -D systemduserunitdir=no ..  &amp;&amp;\n"
"ninja</userinput>"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/gnome/applications/evince.xml:144
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"CPPFLAGS+=\" -I/opt/texlive/&texlive-year;/include -DNO_DEBUG\" \\\n"
"meson setup --prefix=/usr                \\\n"
"            --buildtype=release          \\\n"
"            -D gtk_doc=false             \\\n"
"            --wrap-mode=nodownload       \\\n"
"            ..                           &amp;&amp;\n"
"ninja</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"CPPFLAGS+=\" -I/opt/texlive/&texlive-year;/include -DNO_DEBUG\" \\\n"
"meson setup --prefix=/usr                \\\n"
"            --buildtype=release          \\\n"
"            -D gtk_doc=false             \\\n"
"            --wrap-mode=nodownload       \\\n"
"            ..                           &amp;&amp;\n"
"ninja</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/applications/evince.xml:156
#, xml-text
msgid ""
"If you have <xref linkend='gi-docgen'/> installed and wish to build the API "
"documentation for this package, issue:"
msgstr ""
"Se você tiver <xref linkend='gi-docgen'/> instalado e desejar construir a "
"documentação da API para esse pacote, emita:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/gnome/applications/evince.xml:160
#, no-wrap, xml-text
msgid ""
"<userinput>sed \"/docs_dir/s@\\$@ / 'evince-&evince-version;'@\" -i ../help/meson.build &amp;&amp;\n"
"meson configure -D gtk_doc=true                                 &amp;&amp;\n"
"ninja</userinput>"
msgstr ""
"<userinput>sed \"/docs_dir/s@\\$@ / 'evince-&evince-version;'@\" -i ../help/meson.build &amp;&amp;\n"
"meson configure -D gtk_doc=true                                 &amp;&amp;\n"
"ninja</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/applications/evince.xml:165
#, xml-text
msgid "This package does not have a working test suite."
msgstr "Esse pacote não tem uma suíte funcional de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/applications/evince.xml:169
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/gnome/applications/evince.xml:172
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr "<userinput>ninja install</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/gnome/applications/evince.xml:180
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/applications/evince.xml:186
#, xml-text
msgid ""
"<parameter>CPPFLAGS+=\" -I/opt/texlive/&texlive-year;/include\"</parameter>:"
" Make sure that meson can find libkpathsea headers from TeXLive if it is "
"installed. This has no effect on systems without TeXLive installed."
msgstr ""
"<parameter>CPPFLAGS+=\" -I/opt/texlive/&texlive-year;/include\"</parameter>:"
" Certifique-se de que o meson possa encontrar os cabeçalhos libkpathsea "
"originários do TeXLive se estiver instalado. Isso não tem efeito em sistemas"
" sem o TeXLive instalado."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/applications/evince.xml:192
#, xml-text
msgid ""
"<parameter>--wrap-mode=nodownload</parameter>: This switch disables fetching"
" any dependency: the build system tries to fetch gi-docgen even if "
"<parameter>-D gtk_doc=false</parameter> is passed."
msgstr ""
"<parameter>--wrap-mode=nodownload</parameter>: Essa chave desabilita a busca"
" de qualquer dependência: o sistema de construção tenta buscar gi-docgen "
"mesmo se <parameter>-D gtk_doc=false</parameter> for passado."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/applications/evince.xml:198
#, xml-text
msgid "<parameter>-D gtk_doc=false</parameter>: &gi-doc-disable;"
msgstr "<parameter>-D gtk_doc=false</parameter>: &gi-doc-disable;"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/applications/evince.xml:202
#, xml-text
msgid ""
"<option>-D gspell=false</option>: This switch turns off support for the "
"spell checking plugin."
msgstr ""
"<option>-D gspell=false</option>: Essa chave desliga o suporte para o plugin"
" de verificação ortográfica."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/applications/evince.xml:207
#, xml-text
msgid ""
"<option>-D introspection=false</option>: Use this option if you don't have "
"built <xref linkend='glib2'/> with GObject Introspection and don't wish to "
"have introspection support built into Evince."
msgstr ""
"<option>-D introspection=false</option>: Use essa opção se você não tiver "
"construído <xref linkend='glib2'/> com GObject Introspection e não desejar "
"ter suporte de introspecção integrado ao Evince."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/applications/evince.xml:213
#, xml-text
msgid ""
"<option>-D nautilus=false</option>: This switch disables building the "
"<application>Nautilus</application> Plugin. Use this switch if "
"<application>Nautilus</application> is not installed."
msgstr ""
"<option>-D nautilus=false</option>: Essa chave desabilita a construção do "
"plug-in do <application>Nautilus</application>. Use essa chave se o "
"<application>Nautilus</application> não estiver instalado."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/applications/evince.xml:219
#, xml-text
msgid ""
"<option>-D keyring=false</option>: This switch disables the use of "
"<application>libsecret</application>. Use this switch if "
"<application>libsecret</application> is not installed."
msgstr ""
"<option>-D keyring=false</option>: Essa chave desabilita o uso da "
"<application>libsecret</application>. Use essa chave se a "
"<application>libsecret</application> não estiver instalada."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/applications/evince.xml:225
#, xml-text
msgid ""
"<option>-D ps=enabled</option>: Use this switch if "
"<application>libspectre</application> is installed and you want to view "
"PostScript files with <application>Evince</application>."
msgstr ""
"<option>-D ps=enabled</option>: Use essa chave se a "
"<application>libspectre</application> estiver instalada e você quiser "
"visualizar arquivos PostScript com o <application>Evince</application>."

