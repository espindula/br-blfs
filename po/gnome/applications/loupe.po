#, xml-text
msgid "Introduction to Loupe"
msgstr "Introdução ao Loupe"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/applications/loupe.xml:29
#, xml-text
msgid ""
"<application>Loupe</application> is an application used for viewing image "
"files on the <application>GNOME</application> Desktop."
msgstr ""
"<application>Loupe</application> é um aplicativo usado para visualizar "
"arquivos de imagem na área de trabalho do <application>GNOME</application>."

