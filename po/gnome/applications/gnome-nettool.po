msgstr "Dependências de Tempo de Execução"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/applications/gnome-nettool.xml:92
#, xml-text
msgid ""
"<xref role=\"runtime\" linkend=\"bind-utils\"/>, <xref role=\"runtime\" "
"linkend=\"nmap\"/>, <xref role=\"runtime\" linkend=\"net-tools\"/>, <xref "
"role=\"runtime\" linkend=\"traceroute\"/>, and <xref role=\"runtime\" "
"linkend=\"whois\"/>"
msgstr ""
"<xref role=\"runtime\" linkend=\"bind-utils\"/>, <xref role=\"runtime\" "
"linkend=\"nmap\"/>, <xref role=\"runtime\" linkend=\"net-tools\"/>, <xref "
"role=\"runtime\" linkend=\"traceroute\"/> e <xref role=\"runtime\" "
"linkend=\"whois\"/>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/gnome/applications/gnome-nettool.xml:102
#, xml-text
msgid "Installation of GNOME Nettool"
msgstr "Instalação do GNOME Nettool"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/applications/gnome-nettool.xml:105
#, xml-text
msgid ""
"First, adapt <application>GNOME Nettool</application> to changes in the "
"<application>ping</application>, <application>ping6</application>, and "
"<application>netstat</application> utilities:"
msgstr ""
"Primeiro, adapte o <application>GNOME Nettool</application> às mudanças nos "
"utilitários <application>ping</application>, "
"<application>ping6</application> e <application>netstat</application>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/gnome/applications/gnome-nettool.xml:110
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"pre\">patch -Np1 -i ../gnome-nettool-&gnome-nettool-"
"version;-ping_and_netstat_fixes-1.patch</userinput>"
msgstr ""
"<userinput remap=\"pre\">patch -Np1 -i ../gnome-nettool-&gnome-nettool-"
"version;-ping_and_netstat_fixes-1.patch</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/applications/gnome-nettool.xml:113
#, xml-text
msgid "Then add a fix for newer versions of meson:"
msgstr ""
"Em seguida, adicione uma correção para versões mais recentes do meson:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/gnome/applications/gnome-nettool.xml:116
#, no-wrap, xml-text
msgid "<userinput>sed -i '/merge_file/s/(.*/(/' data/meson.build</userinput>"
msgstr "<userinput>sed -i '/merge_file/s/(.*/(/' data/meson.build</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/applications/gnome-nettool.xml:119
#, xml-text
msgid ""
"Install <application>GNOME Nettool</application> by running the following "
"commands:"
msgstr ""
"Instale o <application>GNOME Nettool</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/gnome/applications/gnome-nettool.xml:123
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr --buildtype=release &amp;&amp;\n"
"ninja</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr --buildtype=release &amp;&amp;\n"
"ninja</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/applications/gnome-nettool.xml:130
#, xml-text
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/applications/gnome-nettool.xml:134
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr "Agora, como o(a) usante <systemitem class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/gnome/applications/gnome-nettool.xml:137
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr "<userinput>ninja install</userinput>"

