msgstr "Dependências do GNOME Nettool"

#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/gnome/applications/gnome-nettool.xml:83
#, xml-text
msgid "Required"
msgstr "Exigidas"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/applications/gnome-nettool.xml:85
#, xml-text
msgid ""
"<xref linkend=\"gtk3\"/>, <xref linkend=\"itstool\"/>, and <xref "
"linkend=\"libgtop\"/>"
msgstr ""
"<xref linkend=\"gtk3\"/>, <xref linkend=\"itstool\"/> e <xref "
"linkend=\"libgtop\"/>"

#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/gnome/applications/gnome-nettool.xml:90
#, xml-text
