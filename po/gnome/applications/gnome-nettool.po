#. type: Content of: <sect1><sect2><title>
#: blfs-en/gnome/applications/gnome-nettool.xml:27
#, xml-text
msgid "Introduction to GNOME Nettool"
msgstr "Introdução ao GNOME Nettool"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/applications/gnome-nettool.xml:30
#, xml-text
msgid ""
"The <application>GNOME Nettool</application> package is a network "
"information tool which provides GUI interface for some of the most common "
"command line network tools."
msgstr ""
"O pacote <application>GNOME Nettool</application> é uma ferramenta de "
"informações de rede de intercomunicação que fornece interface GUI para "
"algumas das ferramentas de rede de intercomunicação de linha de comando mais"
" comuns."

#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/gnome/applications/gnome-nettool.xml:37
#, xml-text
msgid "Package Information"
msgstr "Informação do Pacote"

