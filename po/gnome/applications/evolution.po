#. type: Content of: <sect1><sect2><title>
#: blfs-en/gnome/applications/evolution.xml:126
#, xml-text
msgid "Installation of Evolution"
msgstr "Instalação do Evolution"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/applications/evolution.xml:129
#, xml-text
msgid ""
"Install <application>Evolution</application> by running the following "
"commands:"
msgstr ""
"Instale o <application>Evolution</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/gnome/applications/evolution.xml:133
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr \\\n"
"      -D SYSCONF_INSTALL_DIR=/etc  \\\n"
"      -D ENABLE_INSTALLED_TESTS=ON \\\n"
"      -D ENABLE_PST_IMPORT=OFF     \\\n"
"      -D ENABLE_YTNEF=OFF          \\\n"
"      -D ENABLE_CONTACT_MAPS=OFF   \\\n"
"      -D ENABLE_MARKDOWN=OFF       \\\n"
"      -D ENABLE_WEATHER=ON         \\\n"
"      -G Ninja .. &amp;&amp;\n"
"ninja</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr \\\n"
"      -D SYSCONF_INSTALL_DIR=/etc  \\\n"
"      -D ENABLE_INSTALLED_TESTS=ON \\\n"
"      -D ENABLE_PST_IMPORT=OFF     \\\n"
"      -D ENABLE_YTNEF=OFF          \\\n"
"      -D ENABLE_CONTACT_MAPS=OFF   \\\n"
"      -D ENABLE_MARKDOWN=OFF       \\\n"
"      -D ENABLE_WEATHER=ON         \\\n"
"      -G Ninja .. &amp;&amp;\n"
"ninja</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/applications/evolution.xml:148
#, xml-text
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/applications/evolution.xml:152
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/gnome/applications/evolution.xml:155
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr "<userinput>ninja install</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/gnome/applications/evolution.xml:160
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/applications/evolution.xml:163
#, xml-text
msgid ""
"<parameter>-D ENABLE_YTNEF=OFF</parameter>: This switch is used to disable "
"the yTNEF library usage because <application>libytnef</application> is not "
"part of BLFS."
msgstr ""
"<parameter>-D ENABLE_YTNEF=OFF</parameter>: Essa chave é usada para "
"desabilitar o uso da biblioteca yTNEF porque a "
"<application>libytnef</application> não é parte do BLFS."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/applications/evolution.xml:169
#, xml-text
msgid ""
"<parameter>-D ENABLE_PST_IMPORT=OFF</parameter>: This switch is used to "
"disable the pst-import plugin because <application>libpst</application> is "
"not part of BLFS."
msgstr ""
"<parameter>-D ENABLE_PST_IMPORT=OFF</parameter>: Essa chave é usada para "
"desabilitar o plugin pst-import porque a <application>libpst</application> "
"não é parte do BLFS."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/applications/evolution.xml:175
#, xml-text
msgid ""
"<parameter>-D ENABLE_CONTACT_MAPS=OFF</parameter>: This switch disables "
"building the Contact Maps plugin. Remove this switch if you have installed "
"the necessary dependencies and wish to build the Contact Maps plugin."
msgstr ""
"<parameter>-D ENABLE_CONTACT_MAPS=OFF</parameter>: Essa chave desabilita a "
"construção do plug-in de Mapas de Contato. Remova essa chave se você tiver "
"instalado as dependências necessárias e desejar construir o plug-in de Mapas"
" de Contato."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/applications/evolution.xml:181
#, xml-text
msgid ""
"<parameter>-D ENABLE_MARKDOWN=OFF</parameter>: This switch allows building "
"without <ulink url=\"https://github.com/commonmark/cmark\">cmark</ulink>.  "
"Remove this switch if you need markdown support and you have installed the "
"necessary dependency."
msgstr ""
"<parameter>-D ENABLE_MARKDOWN=OFF</parameter>: Essa chave permite construir "
"sem <ulink url=\"https://github.com/commonmark/cmark\">cmark</ulink>. Remova"
" essa chave se você precisar de suporte a markdown e tiver instalado a "
"dependência necessária."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/applications/evolution.xml:189
#, xml-text
msgid ""
"<parameter>-D ENABLE_WEATHER=ON</parameter>: This switch allows building "
"against <xref linkend=\"libgweather\"/>."
msgstr ""
"<parameter>-D ENABLE_WEATHER=ON</parameter>: Essa chave permite construir "
"contra a <xref linkend=\"libgweather\"/>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/applications/evolution.xml:194
#, xml-text
msgid ""
"<option>-D WITH_HELP=OFF</option>: This switch disables building the manual "
"of this package.  Use this switch if you have not installed <xref "
"linkend='itstool'/>."
msgstr ""
"<option>-D WITH_HELP=OFF</option>: Essa chave desabilita construir o manual "
"desse pacote. Use essa chave se você não tiver instalado <xref "
"linkend='itstool'/>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/applications/evolution.xml:200
#, xml-text
msgid ""
"<option>-D WITH_OPENLDAP=OFF</option>: Use this switch if you have not "
"installed <xref linkend='openldap'/>."
msgstr ""
"<option>-D WITH_OPENLDAP=OFF</option>: Use essa chave se você não tiver "
"instalado o <xref linkend='openldap'/>."

