#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/gnome-autoar.xml:30
#, xml-text
msgid ""
"The <application>gnome-autoar</application> package provides a framework for"
" automatic archive extraction, compression, and management."
msgstr ""
"O pacote <application>gnome-autoar</application> fornece uma estrutura para "
"extração, compactação e gerenciamento automático de arquivamentos."

