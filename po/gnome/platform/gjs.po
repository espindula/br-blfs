#. type: Content of: <sect1><sect2><title>
#: blfs-en/gnome/platform/gjs.xml:98
#, xml-text
msgid "Installation of Gjs"
msgstr "Instalação do Gjs"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/gjs.xml:101
#, xml-text
msgid ""
"Install <application>Gjs</application> by running the following commands:"
msgstr ""
"Instale o <application>Gjs</application> executando os seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/gnome/platform/gjs.xml:105
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir gjs-build &amp;&amp;\n"
"cd    gjs-build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr          \\\n"
"            --buildtype=release    \\\n"
"            --wrap-mode=nofallback \\\n"
"            ..                     &amp;&amp;\n"
"ninja</userinput>"
msgstr ""
"<userinput>mkdir gjs-build &amp;&amp;\n"
"cd    gjs-build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr          \\\n"
"            --buildtype=release    \\\n"
"            --wrap-mode=nofallback \\\n"
"            ..                     &amp;&amp;\n"
"ninja</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/gjs.xml:115
#, xml-text
msgid ""
"To test the results, issue: <command>ninja test</command> in a graphical "
"session."
msgstr ""
"Para testar os resultados, emita: <command>ninja test</command> em uma "
"sessão gráfica."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/gjs.xml:120
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/gnome/platform/gjs.xml:123
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr "<userinput>ninja install</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/gnome/platform/gjs.xml:128
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/gjs.xml:137
#, xml-text
msgid ""
"<option>-D profiler=disabled</option>: prevents building the profiler "
"backend even if <ulink url=\"&sysprof-url;\">sysprof</ulink> is installed."
msgstr ""
"<option>-D profiler=disabled</option>: evita construir a estrutura de "
"retaguarda do perfilador, mesmo se <ulink url=\"&sysprof-"
"url;\">sysprof</ulink> estiver instalado."

