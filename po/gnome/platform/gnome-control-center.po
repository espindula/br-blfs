#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/gnome/platform/gnome-control-center.xml:70
#, xml-text
msgid "GNOME Control Center Dependencies"
msgstr "Dependências do GNOME Control Center"

#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/gnome/platform/gnome-control-center.xml:72
#, xml-text
msgid "Required"
msgstr "Exigidas"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/gnome-control-center.xml:74
#, xml-text
msgid ""
"<xref linkend=\"accountsservice\"/>, <xref linkend=\"blueprint-compiler\"/>,"
" <xref linkend=\"colord-gtk\"/>, <xref linkend=\"cups\"/>, <xref "
"linkend=\"gnome-bluetooth\"/>, <xref linkend=\"gnome-online-accounts\"/>, "
"<xref linkend=\"gnome-settings-daemon\"/>, <xref linkend=\"gsound\"/>, <xref"
" linkend=\"libadwaita1\"/>, <xref linkend=\"libgtop\"/>, <xref "
"linkend=\"libnma\"/>, <xref linkend=\"libpwquality\"/>, <xref "
"linkend=\"mitkrb\"/>, <xref linkend=\"ModemManager\"/>, <xref "
"linkend=\"samba\"/>, <xref linkend=\"shared-mime-info\"/>, <xref "
"linkend=\"tecla\"/>, and <xref linkend=\"udisks2\"/>"
msgstr ""
"<xref linkend=\"accountsservice\"/>, <xref linkend=\"blueprint-compiler\"/>,"
" <xref linkend=\"colord-gtk\"/>, <xref linkend=\"cups\"/>, <xref "
"linkend=\"gnome-bluetooth\"/>, <xref linkend=\"gnome-online-accounts\"/>, "
"<xref linkend=\"gnome-settings-daemon\"/>, <xref linkend=\"gsound\"/>, <xref"
" linkend=\"libadwaita1\"/>, <xref linkend=\"libgtop\"/>, <xref "
"linkend=\"libnma\"/>, <xref linkend=\"libpwquality\"/>, <xref "
"linkend=\"mitkrb\"/>, <xref linkend=\"ModemManager\"/>, <xref "
"linkend=\"samba\"/>, <xref linkend=\"shared-mime-info\"/>, <xref "
"linkend=\"tecla\"/> e <xref linkend=\"udisks2\"/>"

#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/gnome/platform/gnome-control-center.xml:94
#, xml-text
msgid "Recommended"
msgstr "Recomendadas"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/gnome-control-center.xml:96
#, xml-text
msgid "<xref linkend=\"bolt\"/> and <xref linkend=\"ibus\"/>"
msgstr "<xref linkend=\"bolt\"/> e <xref linkend=\"ibus\"/>"

#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/gnome/platform/gnome-control-center.xml:100
#, xml-text
msgid "Optional"
msgstr "Opcionais"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/gnome-control-center.xml:102
#, xml-text
msgid ""
"<command>Xvfb</command> (from <xref linkend='xorg-server'/> or <xref "
"role='nodep' linkend='xwayland'/>) and <xref linkend=\"python-dbusmock\"/> "
"(both for tests)"
msgstr ""
"<command>Xvfb</command> (originário de <xref linkend='xorg-server'/> ou "
"<xref role='nodep' linkend='xwayland'/>) e <xref linkend=\"python-"
"dbusmock\"/> (ambos para testes)"

#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/gnome/platform/gnome-control-center.xml:109
#, xml-text
msgid "Recommended (Runtime)"
msgstr "Recomendadas (tempo de execução)"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/gnome-control-center.xml:111
#, xml-text
msgid "<xref linkend=\"blocaled\" role=\"runtime\"/>"
msgstr "<xref linkend=\"blocaled\" role=\"runtime\"/>"

#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/gnome/platform/gnome-control-center.xml:114
#, xml-text
msgid "Optional Runtime Dependencies"
msgstr "Dependências Opcionais em Tempo de Execução"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/gnome-control-center.xml:116
#, xml-text
msgid ""
"<xref role=\"runtime\" linkend=\"cups-pk-helper\"/> (Printers panel), <xref "
"role=\"runtime\" linkend=\"gnome-color-manager\"/> (Color panel), <xref "
"role=\"runtime\" linkend=\"gnome-shell\"/> (Applications panel), and <xref "
"role=\"runtime\" linkend=\"sound-theme-freedesktop\"/> (Additional Sound "
"Effects in Sound panel)"
msgstr ""
"<xref role=\"runtime\" linkend=\"cups-pk-helper\"/> (painel de impressoras),"
" <xref role=\"runtime\" linkend=\"gnome-color-manager\"/> (painel de cores),"
" <xref role=\"runtime\" linkend=\"gnome-shell\"/> (painel Aplicativos) e "
"<xref role=\"runtime\" linkend=\"sound-theme-freedesktop\"/> (Efeitos "
"Sonoros Adicionais no painel Som)"

#. type: Content of: <sect1><sect2><note><para>
#: blfs-en/gnome/platform/gnome-control-center.xml:124
#, xml-text
msgid ""
"Recommended dependencies are not strictly required for this package to build"
" and function, but you may not get expected results at runtime if you don't "
"install them."
msgstr ""
"As dependências recomendadas não são estritamente exigidas para esse pacote "
"construir e funcionar, mas você possivelmente não obtenha os resultados "
"esperados em tempo de execução se não as instalar."

#. type: Content of: <sect1><sect2><title>
#: blfs-en/gnome/platform/gnome-control-center.xml:133
#, xml-text
msgid "Installation of GNOME Control Center"
msgstr "Instalação do GNOME Control Center"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/gnome-control-center.xml:136
#, xml-text
msgid ""
"Install <application>GNOME Control Center</application> by running the "
"following commands:"
msgstr ""
"Instale o <application>GNOME Control Center</application> executando os "
"seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/gnome/platform/gnome-control-center.xml:140
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr --buildtype=release .. &amp;&amp;\n"
"ninja</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr --buildtype=release .. &amp;&amp;\n"
"ninja</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/gnome-control-center.xml:149
#, xml-text
msgid ""
"To test the results, issue: <command>GTK_A11Y=none ninja test</command>. "
"Note that you must have the <application>python-dbusmock</application> "
"module installed in order for the tests to complete successfully."
msgstr ""
"Para testar os resultados, emita: <command>GTK_A11Y=none ninja "
"test</command>. Observe que você precisa ter o módulo <application>python-"
"dbusmock</application> instalado para a finalidade de que os testes "
"completem com sucesso."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/gnome-control-center.xml:156
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr "Agora, como o(a) usante <systemitem class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/gnome/platform/gnome-control-center.xml:159
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr "<userinput>ninja install</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/gnome/platform/gnome-control-center.xml:164
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/gnome-control-center.xml:170
#, xml-text
msgid ""
"<option>-D ibus=false</option>: Use this switch if you have not installed "
"the recommended <application>IBus</application> dependency."
msgstr ""
"<option>-D ibus=false</option>: Use essa chave se você não tiver instalado a"
" dependência recomendada do <application>IBus</application>."

