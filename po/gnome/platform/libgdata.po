#. type: Content of: <sect1><sect2><title>
#: blfs-en/gnome/platform/libgdata.xml:99
#, xml-text
msgid "Installation of libgdata"
msgstr "Instalação do libgdata"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/libgdata.xml:102
#, xml-text
msgid ""
"Install <application>libgdata</application> by running the following "
"commands:"
msgstr ""
"Instale o <application>libgdata</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/gnome/platform/libgdata.xml:106
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr               \\\n"
"            --buildtype=release         \\\n"
"            -D gtk_doc=false            \\\n"
"            -D always_build_tests=false \\\n"
"            ..                          &amp;&amp;\n"
"ninja</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr               \\\n"
"            --buildtype=release         \\\n"
"            -D gtk_doc=false            \\\n"
"            -D always_build_tests=false \\\n"
"            ..                          &amp;&amp;\n"
"ninja</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/libgdata.xml:132
#, xml-text
msgid "This package does not come with a functional test suite."
msgstr "Esse pacote não vem com uma suíte funcional de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/libgdata.xml:136
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr "Agora, como o(a) usante <systemitem class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/gnome/platform/libgdata.xml:139
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr "<userinput>ninja install</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/gnome/platform/libgdata.xml:144
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/libgdata.xml:150
#, xml-text
msgid ""
"<parameter>-D gtk_doc=false</parameter>: Remove this if you have <xref "
"linkend=\"gtk-doc\"/> installed and want to rebuild the documentation with "
"it."
msgstr ""
"<parameter>-D gtk_doc=false</parameter>: Remova isso se você tiver o <xref "
"linkend=\"gtk-doc\"/> instalado e quiser reconstruir a documentação com ele."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/libgdata.xml:155
#, xml-text
msgid ""
"<option>-D oauth1=enabled</option>: Use this option if you wish to build in "
"support for OAuth v1. Note that you must have <xref linkend=\"liboauth\"/> "
"installed in order to enable this option."
msgstr ""
"<option>-D oauth1=enabled</option>: Use essa opção se desejar incluir "
"suporte para OAuth v1. Observe que você precisa ter o <xref "
"linkend=\"liboauth\"/> instalado para a finalidade de habilitar essa opção."

