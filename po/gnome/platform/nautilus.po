"linkend=\"gnome-autoar\"/>, <xref linkend=\"gnome-desktop\"/>, <xref "
"linkend=\"libadwaita1\"/>, <xref linkend=\"libnotify\"/>, <xref "
"linkend=\"libportal\"/>, <xref linkend=\"libseccomp\"/> e <xref "
"linkend=\"tinysparql\"/>"

