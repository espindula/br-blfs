"linkend=\"glycin-gtk4\"/>, <xref linkend=\"gnome-autoar\"/>, <xref "
"linkend=\"gnome-desktop\"/>, <xref linkend=\"libadwaita1\"/>, <xref "
"linkend=\"libportal\"/>, <xref linkend=\"libseccomp\"/> e <xref "
"linkend=\"tinysparql\"/>"

#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/gnome/platform/nautilus.xml:85
#, xml-text
