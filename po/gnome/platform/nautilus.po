#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/nautilus.xml:87
#, xml-text
msgid ""
"<xref linkend=\"desktop-file-utils\"/>, &gobject-introspection;, <xref "
"linkend=\"gst10-plugins-base\"/>, <xref linkend=\"libcloudproviders\"/>, and"
" <xref linkend=\"localsearch\"/> (required at runtime)"
msgstr ""
