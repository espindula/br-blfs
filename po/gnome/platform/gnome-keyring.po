#. type: Content of: <sect1><sect2><title>
#: blfs-en/gnome/platform/gnome-keyring.xml:98
#, xml-text
msgid "Installation of GNOME Keyring"
msgstr "Instalação do GNOME Keyring"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/gnome-keyring.xml:101
#, xml-text
msgid ""
"Install <application>GNOME Keyring</application> by running the following "
"commands:"
msgstr ""
"Instale o <application>GNOME Keyring</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/gnome/platform/gnome-keyring.xml:105
#, no-wrap, xml-text
msgid ""
"<userinput>sed -i 's:\"/desktop:\"/org:' schema/*.xml &amp;&amp;\n"
"\n"
"mkdir build-gkr &amp;&amp;\n"
"cd    build-gkr &amp;&amp;\n"
"\n"
"meson setup ..            \\\n"
"      --prefix=/usr       \\\n"
"      --buildtype=release \\\n"
"      -D systemd=disabled &amp;&amp;\n"
"ninja</userinput>"
msgstr ""
"<userinput>sed -i 's:\"/desktop:\"/org:' schema/*.xml &amp;&amp;\n"
"\n"
"mkdir build-gkr &amp;&amp;\n"
"cd    build-gkr &amp;&amp;\n"
"\n"
"meson setup ..            \\\n"
"      --prefix=/usr       \\\n"
"      --buildtype=release \\\n"
"      -D systemd=disabled &amp;&amp;\n"
"ninja</userinput>"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/gnome/platform/gnome-keyring.xml:116
#, no-wrap, xml-text
msgid ""
"<userinput>sed -i 's:\"/desktop:\"/org:' schema/*.xml &amp;&amp;\n"
"\n"
"mkdir build-gkr &amp;&amp;\n"
"cd    build-gkr &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr --buildtype=release .. &amp;&amp;\n"
"ninja</userinput>"
msgstr ""
"<userinput>sed -i 's:\"/desktop:\"/org:' schema/*.xml &amp;&amp;\n"
"\n"
"mkdir build-gkr &amp;&amp;\n"
"cd    build-gkr &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr --buildtype=release .. &amp;&amp;\n"
"ninja</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/gnome-keyring.xml:125
#, xml-text
msgid ""
"A session bus address is necessary to run the tests. To test the results, "
"issue: <command>ninja test</command>."
msgstr ""
"Um endereço de barramento de sessão é necessário para executar os testes. "
"Para testar os resultados, emita: <command>ninja test</command>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/gnome-keyring.xml:130
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/gnome/platform/gnome-keyring.xml:133
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr "<userinput>ninja install</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/gnome/platform/gnome-keyring.xml:138
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/gnome-keyring.xml:141
#, xml-text
msgid ""
"<command>sed ... schema/*.xml</command>: This command fixes a deprecated "
"entry in the schema template."
msgstr ""
"<command>sed ... schema/*.xml</command>: Esse comando corrige uma entrada "
"obsoleta no modelo de esquema."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/gnome-keyring.xml:146
#, xml-text
msgid ""
"<parameter>-D systemd=disabled</parameter>: This switch prevents a failure "
"due to the build system requiring <application>systemd</application> by "
"default."
msgstr ""
"<parameter>-D systemd=disabled</parameter>: Essa chave evita uma falha "
"devido ao sistema de construção exigir <application>systemd</application> "
"por padrão."

