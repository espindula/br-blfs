#. type: Content of: <sect1><sect2><title>
#: blfs-en/gnome/platform/librest.xml:98
#, xml-text
msgid "Installation of librest"
msgstr "Instalação do librest"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/librest.xml:101
#, xml-text
msgid ""
"Install <application>librest</application> by running the following "
"commands:"
msgstr ""
"Instale <application>librest</application> executando os seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/gnome/platform/librest.xml:105
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr       \\\n"
"            --buildtype=release \\\n"
"            -D examples=false   \\\n"
"            -D gtk_doc=false    \\\n"
"            ..                  &amp;&amp;\n"
"ninja</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr       \\\n"
"            --buildtype=release \\\n"
"            -D examples=false   \\\n"
"            -D gtk_doc=false    \\\n"
"            ..                  &amp;&amp;\n"
"ninja</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/librest.xml:116
#, xml-text
msgid ""
"If you have <xref linkend='gi-docgen'/> installed and wish to build the API "
"documentation for this package, issue:"
msgstr ""
"Se você tiver <xref linkend='gi-docgen'/> instalado e desejar construir a "
"documentação da API para esse pacote, emita:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/gnome/platform/librest.xml:120
#, no-wrap, xml-text
msgid ""
"<userinput>sed \"/output/s/librest-1.0/librest-&librest-version;/\" -i ../docs/meson.build &amp;&amp;\n"
"meson configure -D gtk_doc=true                                    &amp;&amp;\n"
"ninja</userinput>"
msgstr ""
"<userinput>sed \"/output/s/librest-1.0/librest-&librest-version;/\" -i ../docs/meson.build &amp;&amp;\n"
"meson configure -D gtk_doc=true                                    &amp;&amp;\n"
"ninja</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/librest.xml:125
#, xml-text
msgid "To test the results, issue: <command>ninja test</command>."
msgstr "Para testar os resultados, emita: <command>ninja test</command>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/librest.xml:129
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/gnome/platform/librest.xml:132
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr "<userinput>ninja install</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/gnome/platform/librest.xml:137
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/librest.xml:143
#, xml-text
msgid "<parameter>-D gtk_doc=false</parameter>: &gi-doc-disable;"
msgstr "<parameter>-D gtk_doc=false</parameter>: &gi-doc-disable;"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/librest.xml:147
#, xml-text
msgid ""
"<parameter>-D examples=false</parameter>: Remove this option if <xref "
"linkend=\"libadwaita1\"/> and <xref linkend=\"gtksourceview5\"/> are "
"installed and you wish to build the demonstration application provided by "
"this package."
msgstr ""
"<parameter>-D examples=false</parameter>: Remova essa opção se <xref "
"linkend=\"libadwaita1\"/> e <xref linkend=\"gtksourceview5\"/> estiverem "
"instalados e você desejar construir o aplicativo de demonstração fornecido "
"por esse pacote."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/librest.xml:154
#, xml-text
msgid ""
"<option>-D vapi=true</option>: Use this switch if <xref linkend=\"vala\"/> "
"is installed and you wish to build the Vala bindings provided by this "
"package."
msgstr ""
"<option>-D vapi=true</option>: Use essa chave se <xref linkend=\"vala\"/> "
"estiver instalado e você desejar construir as ligações Vala fornecidas por "
"esse pacote."

