#. type: Content of: <sect1><sect2><title>
#: blfs-en/gnome/platform/librest.xml:26
#, xml-text
msgid "Introduction to librest"
msgstr "Introdução ao librest"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/librest.xml:29
#, xml-text
msgid ""
"The <application>librest</application> package contains a library that is "
"designed to make it easier to access web services that claim to be "
"\"RESTful\". It includes convenience wrappers for libsoup and libxml to make"
" remote usage of the RESTful API easier."
msgstr ""
"O pacote <application>librest</application> contém uma biblioteca que é "
"projetada para tornar mais fácil acessar serviços web que aleguem ser "
"\"RESTful\". Ele inclui envolucradores convenientes para libsoup e libxml "
"para tornar o uso remoto da API RESTful mais fácil."

