#. type: Content of: <sect1><sect2><title>
#: blfs-en/gnome/platform/gweather-locations.xml:78
#, xml-text
msgid "Installation of gweather-locations"
msgstr "Instalação do gweather-locations"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/gweather-locations.xml:81
#, xml-text
msgid ""
"Install <application>gweather-locations</application> by running the "
"following commands:"
msgstr ""
"Instale <application>gweather-locations</application> executando os "
"seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/gnome/platform/gweather-locations.xml:85
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr .. &amp;&amp;\n"
"ninja</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr .. &amp;&amp;\n"
"ninja</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/gweather-locations.xml:92
#, xml-text
msgid "To test the results, issue: <command>ninja test</command>"
msgstr "Para testar os resultados, emita: <command>ninja test</command>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/gweather-locations.xml:96
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/gnome/platform/gweather-locations.xml:99
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr "<userinput>ninja install</userinput>"

