#, xml-text
msgid "Introduction to GNOME Shell Extensions"
msgstr "Introdução ao GNOME Shell Extensions"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/gnome-shell-extensions.xml:30
#, xml-text
msgid ""
"The <application>GNOME Shell Extensions</application> package contains a "
"collection of extensions providing additional and optional functionality to "
"the <application>GNOME Shell</application>."
msgstr ""
"O pacote <application>GNOME Shell Extensions</application> contém uma "
"coleção de extensões que fornecem funcionalidades adicionais e opcionais "
"para o <application>GNOME Shell</application>."

