#. type: Content of: <sect1><sect2><title>
#: blfs-en/gnome/platform/gnome-shell-extensions.xml:93
#, xml-text
msgid "Installation of GNOME Shell Extensions"
msgstr "Instalação do GNOME Shell Extensions"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/gnome-shell-extensions.xml:104
#, xml-text
msgid ""
"Install <application>GNOME Shell Extensions</application> by running the "
"following commands:"
msgstr ""
"Instale o <application>GNOME Shell Extensions</application> executando os "
"seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/gnome/platform/gnome-shell-extensions.xml:108
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr .. </userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr .. </userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/gnome-shell-extensions.xml:114
#, xml-text
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/gnome-shell-extensions.xml:118
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr "Agora, como o(a) usante <systemitem class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/gnome/platform/gnome-shell-extensions.xml:121
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr "<userinput>ninja install</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/gnome/platform/gnome-shell-extensions.xml:126
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/gnome-shell-extensions.xml:129
#, xml-text
msgid ""
"<option>-D x11=true</option>: Enables X11 session support. This is "
"deprecated and X11 support for GNOME will be removed in GNOME 50."
msgstr ""
"<option>-D x11=true</option>: Habilita suporte a sessões do X11. Isso está "
"obsoleto e o suporte a X11 para GNOME será removido no GNOME 50."

