#. type: Content of: <sect1><sect2><title>
#: blfs-en/gnome/platform/dconf.xml:149
#, xml-text
msgid "Installation of DConf"
msgstr "Instalação do DConf"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/dconf.xml:152
#, xml-text
msgid "First, prevent unnecessary systemd units from being installed:"
msgstr ""
"Primeiro, evite que unidades desnecessárias do systemd sejam instaladas:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/gnome/platform/dconf.xml:155
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"pre\">sed -i 's/install_dir: systemd_userunitdir,//' "
"service/meson.build</userinput>"
msgstr ""
"<userinput remap=\"pre\">sed -i 's/install_dir: systemd_userunitdir,//' "
"service/meson.build</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/dconf.xml:158
#, xml-text
msgid ""
"Install <application>DConf</application> by running the following commands:"
msgstr ""
"Instale o <application>DConf</application> executando os seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/gnome/platform/dconf.xml:162
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr            \\\n"
"            --buildtype=release      \\\n"
"            -D bash_completion=false \\\n"
"            ..                       &amp;&amp;\n"
"ninja</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr            \\\n"
"            --buildtype=release      \\\n"
"            -D bash_completion=false \\\n"
"            ..                       &amp;&amp;\n"
"ninja</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/dconf.xml:172
#, xml-text
msgid ""
"To test the results, issue: <command>dbus-run-session ninja test</command>"
msgstr ""
"Para testar os resultados, emita: <command>dbus-run-session ninja "
"test</command>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/dconf.xml:176 blfs-en/gnome/platform/dconf.xml:196
#, xml-text
msgid "As the <systemitem class=\"username\">root</systemitem> user:"
msgstr "Como o(a) usuário(a) <systemitem class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/gnome/platform/dconf.xml:179 blfs-en/gnome/platform/dconf.xml:199
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr "<userinput>ninja install</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/dconf.xml:182
#, xml-text
msgid "Now, optionally install the editor:"
msgstr "Agora, opcionalmente, instale o editor:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/gnome/platform/dconf.xml:185
#, no-wrap, xml-text
msgid ""
"<userinput>cd ..              &amp;&amp;\n"
"tar -xf ../dconf-editor-&dconf-editor-version;.tar.xz &amp;&amp;\n"
"cd dconf-editor-&dconf-editor-version;                &amp;&amp;\n"
"\n"
"mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr --buildtype=release .. &amp;&amp;\n"
"ninja</userinput>"
msgstr ""
"<userinput>cd ..              &amp;&amp;\n"
"tar -xf ../dconf-editor-&dconf-editor-version;.tar.xz &amp;&amp;\n"
"cd dconf-editor-&dconf-editor-version;                &amp;&amp;\n"
"\n"
"mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr --buildtype=release .. &amp;&amp;\n"
"ninja</userinput>"

