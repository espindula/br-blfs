#. type: Content of: <sect1><sect2><title>
#: blfs-en/gnome/platform/gnome-backgrounds.xml:83
#, xml-text
msgid "Installation of GNOME Backgrounds"
msgstr "Instalação do GNOME Backgrounds"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/gnome-backgrounds.xml:86
#, xml-text
msgid ""
"Install <application>GNOME Backgrounds</application> by running the "
"following commands:"
msgstr ""
"Instale o <application>GNOME Backgrounds</application> executando os "
"seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/gnome/platform/gnome-backgrounds.xml:90
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr ..</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr ..</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/gnome-backgrounds.xml:96
#, xml-text
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/gnome-backgrounds.xml:100
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr "Agora, como o(a) usante <systemitem class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/gnome/platform/gnome-backgrounds.xml:103
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr "<userinput>ninja install</userinput>"

