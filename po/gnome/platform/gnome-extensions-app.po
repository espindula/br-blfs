#: blfs-en/gnome/platform/gnome-extensions-app.xml:80
#, xml-text
msgid "Installation of GNOME Extensions App"
msgstr "Instalação do GNOME Extensions App"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/gnome-extensions-app.xml:83
#, xml-text
msgid ""
"Install <application>GNOME Extensions App</application> by running the "
"following commands:"
msgstr ""
"Instale o <application>GNOME Extensions App</application> executando os "
"seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/gnome/platform/gnome-extensions-app.xml:87
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr ..</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr ..</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/gnome-extensions-app.xml:93
#, xml-text
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/gnome-extensions-app.xml:97
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/gnome/platform/gnome-extensions-app.xml:100
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr "<userinput>ninja install</userinput>"

