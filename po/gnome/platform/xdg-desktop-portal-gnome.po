#. type: Content of: <sect1><sect2><title>
#: blfs-en/gnome/platform/xdg-desktop-portal-gnome.xml:83
#, xml-text
msgid "Installation of xdg-desktop-portal-gnome"
msgstr "Instalação do xdg-desktop-portal-gnome"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/xdg-desktop-portal-gnome.xml:86
#, xml-text
msgid ""
"Install <application>xdg-desktop-portal-gnome</application> by running the "
"following commands:"
msgstr ""
"Instale <application>xdg-desktop-portal-gnome</application> executando os "
"seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/gnome/platform/xdg-desktop-portal-gnome.xml:90
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr              \\\n"
"            --buildtype=release        \\\n"
"            -D systemduserunitdir=/tmp \\\n"
"            ..                         &amp;&amp;\n"
"ninja</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr              \\\n"
"            --buildtype=release        \\\n"
"            -D systemduserunitdir=/tmp \\\n"
"            ..                         &amp;&amp;\n"
"ninja</userinput>"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/gnome/platform/xdg-desktop-portal-gnome.xml:99
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr --buildtype=release .. &amp;&amp;\n"
"ninja</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr --buildtype=release .. &amp;&amp;\n"
"ninja</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/xdg-desktop-portal-gnome.xml:106
#, xml-text
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/xdg-desktop-portal-gnome.xml:110
#, xml-text
msgid "Now, as the &root; user:"
msgstr "Agora, como o(a) usuário(a) &root;:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/gnome/platform/xdg-desktop-portal-gnome.xml:113
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr "<userinput>ninja install</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/xdg-desktop-portal-gnome.xml:116
#, xml-text
msgid "Remove systemd files that are useless (as the &root; user):"
msgstr ""
"Remova arquivos do systemd que são inúteis (como o(a) usuário(a) &root;):"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/gnome/platform/xdg-desktop-portal-gnome.xml:119
#, no-wrap, xml-text
msgid "<userinput>rm -vf /tmp/*.service</userinput>"
msgstr "<userinput>rm -vf /tmp/*.service</userinput>"

