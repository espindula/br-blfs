#. type: Content of: <sect1><sect2><title>
#: blfs-en/gnome/platform/grilo.xml:95
#, xml-text
msgid "Installation of Grilo"
msgstr "Instalação do Grilo"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/grilo.xml:98
#, xml-text
msgid ""
"Install <application>Grilo</application> by running the following commands:"
msgstr ""
"Instale o <application>Grilo</application> executando os seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/gnome/platform/grilo.xml:102
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build    &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr           \\\n"
"            --buildtype=release     \\\n"
"            -D enable-gtk-doc=false \\\n"
"            ..                     &amp;&amp;\n"
"ninja</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build    &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr           \\\n"
"            --buildtype=release     \\\n"
"            -D enable-gtk-doc=false \\\n"
"            ..                     &amp;&amp;\n"
"ninja</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/grilo.xml:112
#, xml-text
msgid "To test the results, issue: <command>ninja test</command>."
msgstr "Para testar os resultados, emita: <command>ninja test</command>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/grilo.xml:116
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr "Agora, como o(a) usante <systemitem class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/gnome/platform/grilo.xml:119
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr "<userinput>ninja install</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/gnome/platform/grilo.xml:124
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. Note that building the documentation is currently broken due to
#.       an incompatibility with gtk-doc.
#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/grilo.xml:130
#, xml-text
msgid ""
"<parameter>-D enable-gtk-doc=false</parameter>: This option disables "
"generating documentation. If you have <xref linkend=\"gtk-doc\"/> installed "
"and wish to generate documentation, remove this option."
msgstr ""
"<parameter>-D enable-gtk-doc=false</parameter>: Essa opção desabilita a "
"geração de documentação. Se você tiver o <xref linkend=\"gtk-doc\"/> "
"instalado e desejar gerar documentação, remova essa opção."

