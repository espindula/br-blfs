#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/gnome-bluetooth.xml:30
#, xml-text
msgid ""
"The <application>GNOME Bluetooth</application> package contains tools for "
"managing and manipulating Bluetooth devices using the "
"<application>GNOME</application> Desktop."
msgstr ""
"O pacote <application>GNOME Bluetooth</application> contém ferramentas para "
"gerenciar e manipular dispositivos Bluetooth usando a Área de Trabalho do "
"<application>GNOME</application>."

