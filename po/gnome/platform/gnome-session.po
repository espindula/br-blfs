#. type: Content of: <sect1><sect2><title>
#: blfs-en/gnome/platform/gnome-session.xml:94
#, xml-text
msgid "Installation of GNOME Session"
msgstr "Instalação do GNOME Session"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/gnome-session.xml:118
#, xml-text
msgid ""
"Install <application>GNOME Session</application> by running the following "
"commands:"
msgstr ""
"Instale o <application>GNOME Session</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/gnome/platform/gnome-session.xml:122
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr              \\\n"
"            --buildtype=release        \\\n"
"            -D man=false               \\\n"
"            -D docbook=false           \\\n"
"            -D systemduserunitdir=/tmp \\\n"
"            ..                         &amp;&amp;\n"
"ninja</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr              \\\n"
"            --buildtype=release        \\\n"
"            -D man=false               \\\n"
"            -D docbook=false           \\\n"
"            -D systemduserunitdir=/tmp \\\n"
"            ..                         &amp;&amp;\n"
"ninja</userinput>"

