#, xml-text
#~ msgid "9c14ac6880cbc6ebaf8f573e25d94c35"
#~ msgstr "9c14ac6880cbc6ebaf8f573e25d94c35"

#, xml-text
#~ msgid "392 KB"
#~ msgstr "392 KB"

#, xml-text
#~ msgid ""
#~ "This package creates two Xorg based <filename>.desktop</filename> files in "
#~ "the <filename class=\"directory\">/usr/share/wayland-sessions/</filename> "
#~ "directory.  Only one is needed on a BLFS system, so we prevent the extra "
#~ "file showing up as an option in a display manager.  As the &root; user:"
#~ msgstr ""
#~ "Esse pacote cria dois arquivos <filename>.desktop</filename> baseados em "
#~ "Xorg no diretório <filename class=\"directory\">/usr/share/wayland-"
#~ "sessions/</filename>. Somente um é necessário em um sistema BLFS, de modo "
#~ "que nós evitamos que o arquivo extra apareça como uma opção em um "
#~ "gerenciador de exibição. Como o(a) usuário(a) &root;:"

#, no-wrap, xml-text
#~ msgid "<userinput>rm -v /usr/share/wayland-sessions/gnome.desktop</userinput>"
#~ msgstr ""
#~ "<userinput>rm -v /usr/share/wayland-sessions/gnome.desktop</userinput>"

#, xml-text
#~ msgid "14d0c1ab840ff8a86348e333cd7835ec"
#~ msgstr "14d0c1ab840ff8a86348e333cd7835ec"

#, xml-text
#~ msgid "388 KB"
#~ msgstr "388 KB"

#, xml-text
#~ msgid "7.5 MB"
#~ msgstr "7,5 MB"

#, xml-text
#~ msgid "0.1 SBU"
#~ msgstr "0,1 UPC"

#, no-wrap, xml-text
#~ msgid ""
#~ "<userinput>rm -fv /usr/share/xsessions/gnome.desktop &amp;&amp;\n"
#~ "rm -v /usr/share/wayland-sessions/gnome.desktop</userinput>"
#~ msgstr ""
#~ "<userinput>rm -fv /usr/share/xsessions/gnome.desktop &amp;&amp;\n"
#~ "rm -v /usr/share/wayland-sessions/gnome.desktop</userinput>"

#, xml-text
#~ msgid ""
#~ "X11 support is deprecated and will be removed in GNOME 50. Please use the "
#~ "Wayland session wherever possible."
#~ msgstr ""
#~ "O suporte ao X11 está obsoleto e será removido no GNOME 50. Por favor, use a"
#~ " sessão Wayland sempre que possível."

#, xml-text
#~ msgid ""
#~ "To start <application>GNOME</application> using <xref role=\"nodep\" "
#~ "linkend=\"xinit\"/>, run the following commands:"
#~ msgstr ""
#~ "Para iniciar o <application>GNOME</application> usando <xref role=\"nodep\" "
#~ "linkend=\"xinit\"/>, execute os seguintes comandos:"

#, no-wrap, xml-text
#~ msgid ""
#~ "<userinput>cat &gt; ~/.xinitrc &lt;&lt; \"EOF\"\n"
#~ "<literal>dbus-run-session gnome-session</literal>\n"
#~ "EOF\n"
#~ "\n"
#~ "startx</userinput>"
#~ msgstr ""
#~ "<userinput>cat &gt; ~/.xinitrc &lt;&lt; \"EOF\"\n"
#~ "<literal>dbus-run-session gnome-session</literal>\n"
#~ "EOF\n"
#~ "\n"
#~ "startx</userinput>"

#, xml-text
#~ msgid ""
#~ "Alternatively, to start <application>GNOME</application> with Wayland "
#~ "support, run the following command:"
#~ msgstr ""
#~ "Alternativamente, para iniciar o <application>GNOME</application> com "
#~ "suporte ao Wayland, execute o seguinte comando:"

#, no-wrap, xml-text
#~ msgid ""
#~ "<userinput>XDG_SESSION_TYPE=wayland dbus-run-session gnome-"
