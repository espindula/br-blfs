#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/gnome/platform/libsecret.xml:69
#, xml-text
msgid "libsecret Dependencies"
msgstr "Dependências do libsecret"

#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/gnome/platform/libsecret.xml:71
#, xml-text
msgid "Required"
msgstr "Exigidas"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/libsecret.xml:73
#, xml-text
msgid "<xref linkend=\"glib2\"/> (GObject Introspection recommended)"
msgstr "<xref linkend=\"glib2\"/> (GObject Introspection recomendado)"

#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/gnome/platform/libsecret.xml:76
#, xml-text
msgid "Recommended"
msgstr "Recomendadas"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/libsecret.xml:78
#, xml-text
msgid ""
"<xref linkend=\"libgcrypt\"/> (or <xref role=\"nodep\" linkend=\"gnutls\"/>,"
" for cryptography), and <xref linkend=\"vala\"/>"
msgstr ""
"<xref linkend=\"libgcrypt\"/> (ou <xref role=\"nodep\" linkend=\"gnutls\"/>,"
" para criptografia) e <xref linkend=\"vala\"/>"

#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/gnome/platform/libsecret.xml:83
#, xml-text
msgid "Optional"
msgstr "Opcionais"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/libsecret.xml:85
#, xml-text
msgid ""
"<xref linkend=\"gi-docgen\"/> and <xref linkend=\"DocBook\"/>, <xref "
"linkend=\"docbook-xsl\"/>, <xref linkend=\"libxslt\"/> (to build manual "
"pages), and <xref linkend=\"valgrind\"/> (can be used in tests)"
msgstr ""
"<xref linkend=\"gi-docgen\"/> e <xref linkend=\"DocBook\"/>, <xref "
"linkend=\"docbook-xsl\"/>, <xref linkend=\"libxslt\"/> (para construir "
"páginas de manual) e <xref linkend=\"valgrind\"/> (pode ser usado em testes)"

#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/gnome/platform/libsecret.xml:92
#, xml-text
msgid "Optional (Required for the test suite)"
msgstr "Opcionais (exigidas para a suíte de teste)"

#.  Historically libsecret used to require Python2, but it has been
#.       fully ported to Python3.
#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/libsecret.xml:94
#, xml-text
msgid ""
"<xref linkend=\"dbus-python\"/>, <xref linkend=\"gjs\"/>, <xref "
"linkend=\"pygobject3\"/> (Python 3 module), and <ulink "
"url=\"https://github.com/tpm2-software/tpm2-tss\">tpm2-tss</ulink>"
msgstr ""
"<xref linkend=\"dbus-python\"/>, <xref linkend=\"gjs\"/>, <xref "
"linkend=\"pygobject3\"/> (módulo do Python 3) e <ulink "
"url=\"https://github.com/tpm2-software/tpm2-tss\">tpm2-tss</ulink>"

#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/gnome/platform/libsecret.xml:102
#, xml-text
msgid "Runtime Dependency"
msgstr "Dependência em Tempo de Execução"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/libsecret.xml:104
#, xml-text
msgid "<xref role=\"runtime\" linkend=\"gnome-keyring\"/>"
msgstr "<xref role=\"runtime\" linkend=\"gnome-keyring\"/>"

#. type: Content of: <sect1><sect2><note><para>
#: blfs-en/gnome/platform/libsecret.xml:109
#, xml-text
msgid ""
"Any package requiring <application>libsecret</application> expects "
"<application>GNOME Keyring</application> to be present at runtime."
msgstr ""
"Qualquer pacote que exija a <application>libsecret</application> espera que "
"o <application>GNOME Keyring</application> esteja presente em tempo de "
"execução."

#. type: Content of: <sect1><sect2><title>
#: blfs-en/gnome/platform/libsecret.xml:118
#, xml-text
msgid "Installation of libsecret"
msgstr "Instalação do libsecret"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/libsecret.xml:121
#, xml-text
msgid ""
"Install <application>libsecret</application> by running the following "
"commands:"
msgstr ""
"Instale o <application>libsecret</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/gnome/platform/libsecret.xml:125
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir bld &amp;&amp;\n"
"cd    bld &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr       \\\n"
"            --buildtype=release \\\n"
"            -D gtk_doc=false    \\\n"
"            ..                  &amp;&amp;\n"
"ninja</userinput>"
msgstr ""
"<userinput>mkdir bld &amp;&amp;\n"
"cd    bld &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr       \\\n"
"            --buildtype=release \\\n"
"            -D gtk_doc=false    \\\n"
"            ..                  &amp;&amp;\n"
"ninja</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/libsecret.xml:135
#, xml-text
msgid ""
"If you have <xref linkend='gi-docgen'/> installed and wish to build the API "
"documentation for this package, issue:"
msgstr ""
"Se você tiver <xref linkend='gi-docgen'/> instalado e desejar construir a "
"documentação da API para esse pacote, emita:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/gnome/platform/libsecret.xml:139
#, no-wrap, xml-text
msgid ""
"<userinput>sed \"s/api_version_major/'&libsecret-version;'/\"            \\\n"
"    -i ../docs/reference/libsecret/meson.build &amp;&amp;\n"
"meson configure -D gtk_doc=true                &amp;&amp;\n"
"ninja</userinput>"
msgstr ""
"<userinput>sed \"s/api_version_major/'&libsecret-version;'/\"            \\\n"
"    -i ../docs/reference/libsecret/meson.build &amp;&amp;\n"
"meson configure -D gtk_doc=true                &amp;&amp;\n"
"ninja</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/libsecret.xml:145
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/gnome/platform/libsecret.xml:148
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr "<userinput>ninja install</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/libsecret.xml:151
#, xml-text
msgid ""
"To test the results, issue: <command>dbus-run-session ninja test</command>."
msgstr ""
"Para testar os resultados, emita: <command>dbus-run-session ninja "
"test</command>."

#. type: Content of: <sect1><sect2><title>
#: blfs-en/gnome/platform/libsecret.xml:157
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/libsecret.xml:163
#, xml-text
msgid "<parameter>-D gtk_doc=false</parameter>: &gi-doc-disable;"
msgstr "<parameter>-D gtk_doc=false</parameter>: &gi-doc-disable;"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/libsecret.xml:167
#, xml-text
msgid ""
"<option>-D manpage=false</option>: Use this switch if you have not installed"
" <xref linkend=\"libxslt\"/> and DocBook packages."
msgstr ""
"<option>-D manpage=false</option>: Use essa chave se você não tiver "
"instalado os pacotes <xref linkend=\"libxslt\"/> e DocBook."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/libsecret.xml:173
#, xml-text
msgid ""
"<option>-D crypto=gnutls</option>: Use this switch if you want to use <xref "
"linkend=\"gnutls\" role=\"nodep\"/> for cryptography instead of <xref "
"linkend=\"libgcrypt\" role=\"nodep\"/>."
msgstr ""
"<option>-D crypto=gnutls</option>: Use essa chave se você quiser usar <xref "
"linkend=\"gnutls\" role=\"nodep\"/> para criptografia em vez de <xref "
"linkend=\"libgcrypt\" role=\"nodep\"/>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/libsecret.xml:179
#, xml-text
msgid ""
"<option>-D crypto=disabled</option>: Use this switch if you don't have <xref"
" linkend=\"gnutls\" role=\"nodep\"/> or <xref linkend=\"libgcrypt\" "
"role=\"nodep\"/> installed. Note that disabling transport encryption support"
" by doing this is not recommended."
msgstr ""
"<option>-D crypto=disabled</option>: Use essa chave se você não tiver <xref "
"linkend=\"gnutls\" role=\"nodep\"/> ou <xref linkend=\"libgcrypt\" "
"role=\"nodep\"/> instalado. Observe que desabilitar o suporte de encriptação"
" de transporte fazendo isso não é recomendado."

