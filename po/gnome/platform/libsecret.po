#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/libsecret.xml:29
#, xml-text
msgid ""
"The <application>libsecret</application> package contains a GObject based "
"library for accessing the Secret Service API."
msgstr ""
"O pacote <application>libsecret</application> contém uma biblioteca baseada "
"em GObject para acessar a API de Serviço Secreto."

