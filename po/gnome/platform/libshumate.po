#. type: Content of: <sect1><sect2><title>
#: blfs-en/gnome/platform/libshumate.xml:92
#, xml-text
msgid "Installation of libshumate"
msgstr "Instalação do libshumate"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/libshumate.xml:95
#, xml-text
msgid ""
"Install <application>libshumate</application> by running the following "
"commands:"
msgstr ""
"Instale o <application>libshumate</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/gnome/platform/libshumate.xml:99
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr          \\\n"
"            --buildtype=release    \\\n"
"            --wrap-mode=nodownload \\\n"
"            -D gtk_doc=false       \\\n"
"            ..                     &amp;&amp;\n"
"ninja</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr          \\\n"
"            --buildtype=release    \\\n"
"            --wrap-mode=nodownload \\\n"
"            -D gtk_doc=false       \\\n"
"            ..                     &amp;&amp;\n"
"ninja</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/libshumate.xml:110
#, xml-text
msgid ""
"If you have <xref linkend='gi-docgen'/> installed and wish to build the API "
"documentation for this package, issue:"
msgstr ""
"Se você tiver <xref linkend='gi-docgen'/> instalado e desejar construir a "
"documentação da API para esse pacote, emita:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/gnome/platform/libshumate.xml:114
#, no-wrap, xml-text
msgid ""
"<userinput>sed -e 's/lib_version/version/' \\\n"
"    -i ../docs/meson.build      &amp;&amp;\n"
"meson configure -D gtk_doc=true &amp;&amp;\n"
"ninja</userinput>"
msgstr ""
"<userinput>sed -e 's/lib_version/version/' \\\n"
"    -i ../docs/meson.build      &amp;&amp;\n"
"meson configure -D gtk_doc=true &amp;&amp;\n"
"ninja</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/libshumate.xml:120
#, xml-text
msgid "To test the results, issue: <command>ninja test</command>."
msgstr "Para testar os resultados, emita: <command>ninja test</command>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/libshumate.xml:131
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/gnome/platform/libshumate.xml:134
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr "<userinput>ninja install</userinput>"

