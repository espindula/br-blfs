#. type: Content of: <sect1><sect2><title>
#: blfs-en/gnome/platform/evolution-data-server.xml:170
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/evolution-data-server.xml:173
#, xml-text
msgid ""
"<parameter>-D ENABLE_VALA_BINDINGS=ON</parameter>: This switch enables "
"building the Vala bindings. Remove it if you don't have <xref "
"linkend=\"vala\"/> installed."
msgstr ""
"<parameter>-D ENABLE_VALA_BINDINGS=ON</parameter>: Essa chave habilita "
"construir as ligações Vala. Remova-a se você não tiver <xref "
"linkend=\"vala\"/> instalado."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/evolution-data-server.xml:179
#, xml-text
msgid ""
"<parameter>-D ENABLE_GTK_DOC=OFF</parameter>: This switch disables building "
"the API documentation. It is broken for this package due to the use of a "
"long deprecated gtk-doc program that is no longer available."
msgstr ""
"<parameter>-D ENABLE_GTK_DOC=OFF</parameter>: Essa chave desabilita a "
"construção da documentação da API. Ela está quebrada para esse pacote devido"
" ao uso de um aplicativo gtk-doc há muito obsoleto que não mais está "
"disponível."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/evolution-data-server.xml:186
#, xml-text
msgid ""
"<parameter>-D WITH_KRB5=OFF</parameter>: This switch allows building this "
"package without <xref linkend=\"mitkrb\"/>. If you need Kerberos support in "
"this package, for example to connect to a corporate network, change this "
"switch from OFF to ON."
msgstr ""
"<parameter>-D WITH_KRB5=OFF</parameter>: Essa chave permite construir esse "
"pacote sem <xref linkend=\"mitkrb\"/>. Se precisar de suporte Kerberos nesse"
" pacote, por exemplo, para se conectar a uma rede corporativa de "
"intercomunicação, mude essa chave de OFF para ON."

#. This package only uses
#.       &berkeley-db; to import data from very outdated releases.
#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/evolution-data-server.xml:193
#, xml-text
msgid ""
"<parameter>-D WITH_LIBDB=OFF</parameter>: This switch allows building this "
"package without &berkeley-db;.  sqlite is used for normal operation."
msgstr ""
"<parameter>-D WITH_LIBDB=OFF</parameter>: Essa chave permite construir esse "
"pacote sem &berkeley-db;. sqlite é usado para operação normal."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/evolution-data-server.xml:200
#, xml-text
msgid ""
"<option>-D ENABLE_OAUTH2_WEBKITGTK4=OFF</option>: Use this switch if you did"
" not build <xref linkend=\"webkitgtk\" role=\"nodep\"/> with GTK-4."
msgstr ""
"<option>-D ENABLE_OAUTH2_WEBKITGTK4=OFF</option>: Use essa chave se você não"
" construiu <xref linkend=\"webkitgtk\" role=\"nodep\"/> com GTK-4."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/evolution-data-server.xml:205
#, xml-text
msgid ""
"<parameter>-D WITH_SYSTEMDUSERUNITDIR=no</parameter>: This switch disables "
"installing the systemd units, which are not used for a Sysv build."
msgstr ""
"<parameter>-D WITH_SYSTEMDUSERUNITDIR=no</parameter>: Essa chave desabilita "
"a instalação das unidades do systemd, que não são usadas para uma construção"
" do Sysv."

#. type: Content of: <sect1><sect2><note><para>
#: blfs-en/gnome/platform/evolution-data-server.xml:212
#, xml-text
msgid ""
"To enable many of the optional dependencies, review the information from "
"<command>cmake -L CMakeLists.txt</command> for the necessary parameters you "
"must pass to the <command>cmake</command> command."
msgstr ""
"Para habilitar muitas das dependências opcionais, revise as informações "
"provenientes de <command>cmake -L CMakeLists.txt</command> para os "
"parâmetros necessários que você precisa passar para o comando "
"<command>cmake</command>."

