msgstr "Instalação do Evolution Data Server"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/evolution-data-server.xml:118
#, xml-text
msgid ""
"Install <application>Evolution Data Server</application> by running the "
"following commands:"
msgstr ""
"Instale o <application>Evolution Data Server</application> executando os "
"seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/gnome/platform/evolution-data-server.xml:122
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr  \\\n"
"      -D SYSCONF_INSTALL_DIR=/etc   \\\n"
"      -D ENABLE_VALA_BINDINGS=ON    \\\n"
"      -D ENABLE_INSTALLED_TESTS=ON  \\\n"
"      -D WITH_OPENLDAP=OFF          \\\n"
"      -D WITH_KRB5=OFF              \\\n"
"      -D ENABLE_INTROSPECTION=ON    \\\n"
"      -D ENABLE_GTK_DOC=OFF         \\\n"
"      -D WITH_LIBDB=OFF             \\\n"
"      -D WITH_SYSTEMDUSERUNITDIR=no \\\n"
"      -W no-dev -G Ninja ..         &amp;&amp;\n"
"ninja</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr  \\\n"
"      -D SYSCONF_INSTALL_DIR=/etc   \\\n"
"      -D ENABLE_VALA_BINDINGS=ON    \\\n"
"      -D ENABLE_INSTALLED_TESTS=ON  \\\n"
"      -D WITH_OPENLDAP=OFF          \\\n"
"      -D WITH_KRB5=OFF              \\\n"
"      -D ENABLE_INTROSPECTION=ON    \\\n"
"      -D ENABLE_GTK_DOC=OFF         \\\n"
"      -D WITH_LIBDB=OFF             \\\n"
"      -D WITH_SYSTEMDUSERUNITDIR=no \\\n"
"      -W no-dev -G Ninja ..         &amp;&amp;\n"
"ninja</userinput>"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/gnome/platform/evolution-data-server.xml:138
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr \\\n"
"      -D SYSCONF_INSTALL_DIR=/etc  \\\n"
"      -D ENABLE_VALA_BINDINGS=ON   \\\n"
"      -D ENABLE_INSTALLED_TESTS=ON \\\n"
"      -D WITH_OPENLDAP=OFF         \\\n"
"      -D WITH_KRB5=OFF             \\\n"
"      -D ENABLE_INTROSPECTION=ON   \\\n"
"      -D ENABLE_GTK_DOC=OFF        \\\n"
"      -D WITH_LIBDB=OFF            \\\n"
"      -W no-dev -G Ninja ..        &amp;&amp;\n"
"ninja</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
