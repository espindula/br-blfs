#: blfs-en/gnome/platform/totem-pl-parser.xml:79
#, xml-text
msgid "Optional"
msgstr "Opcionais"

#.  uses it to look for packages
#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/totem-pl-parser.xml:81
#, xml-text
msgid ""
"<xref linkend=\"cmake\"/>, <xref linkend=\"gtk-doc\"/>, <xref "
"linkend=\"gvfs\"/> (for some tests), <ulink url=\"https://github.com/linux-"
"test-project/lcov\">LCOV</ulink>, and <ulink "
"url=\"https://sourceforge.net/projects/quvi\">libquvi &gt;= 0.9.1 and "
"libquvi-scripts</ulink> - if they are installed, then <ulink "
"url=\"https://github.com/diegonehab/luasocket\">lua-socket (git)</ulink> is "
"necessary for the tests"
msgstr ""
"<xref linkend=\"cmake\"/>, <xref linkend=\"gtk-doc\"/>, <xref "
"linkend=\"gvfs\"/> (para alguns testes), <ulink "
"url=\"https://github.com/linux-test-project/lcov\">LCOV</ulink> e <ulink "
"url=\"https://sourceforge.net/projects/quvi\">libquvi &gt;= 0.9.1 e libquvi-"
"scripts</ulink> - se eles estiverem instalados, então <ulink "
"url=\"https://github.com/diegonehab/luasocket\">lua-socket (git)</ulink> é "
"necessário para os testes"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/gnome/platform/totem-pl-parser.xml:96
#, xml-text
msgid "Installation of Totem PL Parser"
msgstr "Instalação do Totem PL Parser"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/totem-pl-parser.xml:99
#, xml-text
msgid ""
"Install <application>Totem PL Parser</application> by running the following "
"commands:"
msgstr ""
"Instale o <application>Totem PL Parser</application> executando os seguintes"
" comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/gnome/platform/totem-pl-parser.xml:103
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr --buildtype=release .. &amp;&amp;\n"
"ninja</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr --buildtype=release .. &amp;&amp;\n"
"ninja</userinput>"

#.  It seems caused by geolocation-dependant resolving in
#.            iTunes.
#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/totem-pl-parser.xml:110
#, xml-text
msgid ""
"To test the results, issue: <command>ninja test</command>.  The test named "
"<filename>parser</filename> is known to fail."
msgstr ""
"Para testar os resultados, emita: <command>ninja test</command>. O teste "
"chamado <filename>parser</filename> é conhecido por falhar."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/totem-pl-parser.xml:117
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr "Agora, como o(a) usante <systemitem class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/gnome/platform/totem-pl-parser.xml:120
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr "<userinput>ninja install</userinput>"

