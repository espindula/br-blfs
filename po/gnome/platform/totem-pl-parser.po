#, xml-text
msgid "Introduction to Totem PL Parser"
msgstr "Introdução ao Totem PL Parser"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/totem-pl-parser.xml:30
#, xml-text
msgid ""
"The <application>Totem PL Parser</application> package contains a simple "
"GObject-based library used to parse multiple playlist formats."
msgstr ""
"O pacote <application>Totem PL Parser</application> contém uma biblioteca "
"simples baseada em GObject usada para analisar vários formatos de lista de "
"reprodução."

