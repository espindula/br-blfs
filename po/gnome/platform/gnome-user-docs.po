#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/gnome-user-docs.xml:84
#, xml-text
msgid ""
"Install <application>GNOME User Docs</application> by running the following "
"commands:"
msgstr ""
"Instale o <application>GNOME User Docs</application> executando os seguintes"
" comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/gnome/platform/gnome-user-docs.xml:88
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>./configure --prefix=/usr &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/gnome/platform/gnome-user-docs.xml:92
#, xml-text
