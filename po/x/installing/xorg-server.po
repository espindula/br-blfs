#. type: Content of: <sect1><sect2><title>
#: blfs-en/x/installing/xorg-server.xml:297
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/installing/xorg-server.xml:300
#, xml-text
msgid ""
"<parameter>-D glamor=true</parameter>: Ensure building the Glamor module.  "
"It's needed to build the &modesetting_drv; driver which replaces the "
"traditional Device Dependent X (DDX) drivers."
msgstr ""
"<parameter>-D glamor=true</parameter>: Certifique-se de construir o módulo "
"Glamour. Ele é necessário para construir o controlador &modesetting_drv; que"
" substitui os tradicionais controladores Device Dependent X (DDX)."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/installing/xorg-server.xml:306
#, xml-text
msgid ""
"<option>-D secure-rpc=false</option>: This option disables building RPC "
"support if <xref linkend=\"libtirpc\"/> is not installed."
msgstr ""
"<option>-D secure-rpc=false</option>: Essa opção desabilita construir "
"suporte RPC se <xref linkend=\"libtirpc\"/> não estiver instalado."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/installing/xorg-server.xml:311
#, xml-text
msgid ""
"<parameter>-D systemd_logind=true</parameter>: This switch makes the "
"building system error out if <xref linkend='dbus'/> is not installed.  The "
"BLFS editors discourage building this package without <xref linkend='dbus'/>"
" installed."
msgstr ""
"<parameter>-D systemd_logind=true</parameter>: Essa chave faz com que o "
"sistema de construção apresente erro se <xref linkend='dbus'/> não estiver "
"instalado. Os(As) editores(as) do BLFS desencorajam construir esse pacote "
"sem <xref linkend='dbus'/> instalado."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/installing/xorg-server.xml:318
#, xml-text
msgid ""
"<option>-D suid_wrapper=true</option>: Builds the suid-root wrapper for "
"legacy DDX driver support on rootless xserver systems."
msgstr ""
"<option>-D suid_wrapper=true</option>: Constrói o involucrador suid-root "
"para suporte de controlador legado DDX em sistemas xserver sem raiz."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/installing/xorg-server.xml:323
#, xml-text
msgid ""
"<command>cat &gt;&gt; /etc/sysconfig/createfiles...</command>: This command "
"creates the <filename class=\"directory\">/tmp/.ICE-unix</filename> and "
"<filename class=\"directory\">/tmp/.X11-unix</filename> directories at "
"startup, and ensures that the permissions and ownership are correct as "
"required by the server."
msgstr ""
"<command>cat &gt;&gt; /etc/sysconfig/createfiles...</command>: Esse comando "
"cria os diretórios <filename class=\"directory\">/tmp/.ICE-unix</filename> e"
" <filename class=\"directory\">/tmp/.X11-unix</filename> na inicialização e "
"garante que as permissões e titularidade da propriedade estejam corretas "
"conforme exigido pelo servidor."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/installing/xorg-server.xml:331
#, xml-text
msgid ""
"<option>-D xephyr=true</option>: This option allows building Xephyr if its "
"dependencies are met."
msgstr ""
"<option>-D xephyr=true</option>: Essa opção permite construir Xephyr se as "
"dependências dele forem atendidas."

