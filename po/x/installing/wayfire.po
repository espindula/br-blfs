#. type: Content of: <sect1><sect2><title>
#: blfs-en/x/installing/wayfire.xml:106
#, xml-text
msgid "Installation of Wayfire"
msgstr "Instalação do Wayfire"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/installing/wayfire.xml:109
#, xml-text
msgid "Install Wayfire by running the following commands:"
msgstr "Instale Wayfire executando os seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/x/installing/wayfire.xml:112
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr --buildtype=release .. &amp;&amp;\n"
"ninja</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr --buildtype=release .. &amp;&amp;\n"
"ninja</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/installing/wayfire.xml:119
#, xml-text
msgid "Now, as the &root; user:"
msgstr "Agora, como o(a) usuário(a) &root;:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/x/installing/wayfire.xml:122
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr "<userinput>ninja install</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/installing/wayfire.xml:125
#, xml-text
msgid "Remove some useless static libraries as the &root; user:"
msgstr "Remova algumas bibliotecas estáticas inúteis como o(a) usante &root;:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/x/installing/wayfire.xml:128
#, no-wrap, xml-text
msgid ""
"<userinput>rm -vf /usr/lib/libwftouch.a \\\n"
"       /usr/lib/libwayfire-{move-drag-interface,workspace-wall}.a</userinput>"
msgstr ""
"<userinput>rm -vf /usr/lib/libwftouch.a \\\n"
"       /usr/lib/libwayfire-{move-drag-interface,workspace-wall}.a</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/installing/wayfire.xml:132
#, xml-text
msgid ""
"Copy the default configuration file to <filename "
"class=\"directory\">/usr/share/wayfire</filename> as the &root; user:"
msgstr ""
"Copie o arquivo padrão de configuração para <filename "
"class=\"directory\">/usr/share/wayfire</filename> como o(a) usante &root;:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/x/installing/wayfire.xml:136
#, no-wrap, xml-text
msgid "<userinput>cp -v ../wayfire.ini /usr/share/wayfire</userinput>"
msgstr "<userinput>cp -v ../wayfire.ini /usr/share/wayfire</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/x/installing/wayfire.xml:141
#, xml-text
msgid "Configuring Wayfire"
msgstr "Configurando Wayfire"

#. type: Content of: <sect1><sect2><sect3><title>
#: blfs-en/x/installing/wayfire.xml:144
#, xml-text
msgid "Config Files"
msgstr "Arquivos de Configuração"

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/x/installing/wayfire.xml:146
#, xml-text
msgid ""
"<filename>~/.config/wayfire.ini</filename>. The default version is in "
"<filename class=\"directory\">/usr/share/wayfire</filename> and will not be "
"used and must be copied to <filename "
"class=\"directory\">~/.config</filename>"
msgstr ""
"<filename>~/.config/wayfire.ini</filename>. A versão padrão está em "
"<filename class=\"directory\">/usr/share/wayfire</filename> e não será usado"
" e precisa ser copiado para <filename "
"class=\"directory\">~/.config</filename>"

#. type: Content of: <sect1><sect2><sect3><indexterm><primary>
#: blfs-en/x/installing/wayfire.xml:153
#, xml-text
msgid "~/.config/wayfire.ini"
msgstr "~/.config/wayfire.ini"

#. type: Content of: <sect1><sect2><sect3><title>
#: blfs-en/x/installing/wayfire.xml:158
#, xml-text
msgid "Configuration Information"
msgstr "Informação de Configuração"

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/x/installing/wayfire.xml:161
#, xml-text
msgid "Copy the default configuration file:"
msgstr "Copie o arquivo padrão de configuração:"

#. type: Content of: <sect1><sect2><sect3><screen>
#: blfs-en/x/installing/wayfire.xml:164
#, no-wrap, xml-text
msgid "<userinput>cp /usr/share/wayfire/wayfire.ini ~/.config</userinput>"
msgstr "<userinput>cp /usr/share/wayfire/wayfire.ini ~/.config</userinput>"

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/x/installing/wayfire.xml:167
#, xml-text
msgid ""
"Now, inspect the file and make any changes to suit your workflow. If you "
"need to know which plugins are installed, examine the list of Installed "
"Plugins below."
msgstr ""
"Agora, inspecione o arquivo e faça quaisquer mudanças para adequar ao teu "
"fluxo de trabalho. Se você precisar saber quais plugins estão instalados, "
"examine a lista de Plugins Instalados abaixo."

