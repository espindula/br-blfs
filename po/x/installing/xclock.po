#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/installing/xclock.xml:85
#, xml-text
msgid ""
"Install <application>xclock</application> by running the following commands:"
msgstr ""
"Instale o &quot;<application>xclock</application>&quot; executando os "
"seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/x/installing/xclock.xml:89
#, no-wrap, xml-text
