#. type: Content of: <sect1><sect2><title>
#: blfs-en/x/installing/xcb-utilities.xml:92
#, xml-text
msgid "Downloading XCB Utilities"
msgstr "Baixando Utilitários XCB"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/installing/xcb-utilities.xml:95
#, xml-text
msgid ""
"First, create a list of files to be downloaded. This file will also be used "
"to verify the integrity of the downloads when complete:"
msgstr ""
"Primeiro, crie uma lista de arquivos a serem baixados. Esse arquivo também "
"será usado para verificar a integridade das transferências quando "
"concluídas:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/x/installing/xcb-utilities.xml:99
#, no-wrap, xml-text
msgid ""
"<userinput>cat &gt; xcb-utils.md5 &lt;&lt; \"EOF\"\n"
"<literal>&xcb-util-image-md5sum;  xcb-util-image-&xcb-util-image-version;.tar.xz\n"
"&xcb-util-keysyms-md5sum;  xcb-util-keysyms-&xcb-util-keysyms-version;.tar.xz\n"
"&xcb-util-renderutil-md5sum;  xcb-util-renderutil-&xcb-util-renderutil-version;.tar.xz\n"
"&xcb-util-wm-md5sum;  xcb-util-wm-&xcb-util-wm-version;.tar.xz\n"
"&xcb-util-cursor-md5sum;  xcb-util-cursor-&xcb-util-cursor-version;.tar.xz</literal>\n"
"EOF</userinput>"
msgstr ""
"<userinput>cat &gt; xcb-utils.md5 &lt;&lt; \"EOF\"\n"
"<literal>&xcb-util-image-md5sum;  xcb-util-image-&xcb-util-image-version;.tar.xz\n"
"&xcb-util-keysyms-md5sum;  xcb-util-keysyms-&xcb-util-keysyms-version;.tar.xz\n"
"&xcb-util-renderutil-md5sum;  xcb-util-renderutil-&xcb-util-renderutil-version;.tar.xz\n"
"&xcb-util-wm-md5sum;  xcb-util-wm-&xcb-util-wm-version;.tar.xz\n"
"&xcb-util-cursor-md5sum;  xcb-util-cursor-&xcb-util-cursor-version;.tar.xz</literal>\n"
"EOF</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/installing/xcb-utilities.xml:108
#, xml-text
msgid ""
"To download the needed files using <xref linkend='wget'/>, use the following"
" commands:"
msgstr ""
"Para baixar os arquivos necessários usando o <xref linkend='wget'/>, use os "
"seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/x/installing/xcb-utilities.xml:112
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir xcb-utils &amp;&amp;\n"
"cd xcb-utils &amp;&amp;\n"
"grep -v '^#' ../xcb-utils.md5 | awk '{print $2}' | wget -i- -c \\\n"
"    -B &xcb-utilities-download-http; &amp;&amp;\n"
"md5sum -c ../xcb-utils.md5</userinput>"
msgstr ""
"<userinput>mkdir xcb-utils &amp;&amp;\n"
"cd xcb-utils &amp;&amp;\n"
"grep -v '^#' ../xcb-utils.md5 | awk '{print $2}' | wget -i- -c \\\n"
"    -B &xcb-utilities-download-http; &amp;&amp;\n"
"md5sum -c ../xcb-utils.md5</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/x/installing/xcb-utilities.xml:121
#, xml-text
msgid "Installation of XCB Utilities"
msgstr "Instalao do XCB Utilities"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/installing/xcb-utilities.xml:126
#, xml-text
msgid "First, start a subshell that will exit on error:"
msgstr "Primeiro, inicie um sub shell que sairá em caso de erro:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/x/installing/xcb-utilities.xml:129
#, no-wrap, xml-text
msgid "<userinput>bash -e</userinput>"
msgstr "<userinput>bash -e</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/installing/xcb-utilities.xml:132
#, xml-text
msgid "Install all of the packages by running the following commands:"
msgstr "Instale todos os pacotes executando os seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/x/installing/xcb-utilities.xml:135
#, no-wrap, xml-text
msgid ""
"<userinput>for package in $(grep -v '^#' ../xcb-utils.md5 | awk '{print $2}')\n"
"do\n"
"  packagedir=${package%.tar.?z*}\n"
"  tar -xf $package\n"
"  pushd $packagedir\n"
"     ./configure $XORG_CONFIG\n"
"     make\n"
"     as_root make install\n"
"  popd\n"
"  rm -rf $packagedir\n"
"done</userinput>"
msgstr ""
"<userinput>for package in $(grep -v '^#' ../xcb-utils.md5 | awk '{print $2}')\n"
"do\n"
"  packagedir=${package%.tar.?z*}\n"
"  tar -xf $package\n"
"  pushd $packagedir\n"
"     ./configure $XORG_CONFIG\n"
"     make\n"
"     as_root make install\n"
"  popd\n"
"  rm -rf $packagedir\n"
"done</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/installing/xcb-utilities.xml:148
#, xml-text
msgid "Finally, exit the shell that was started earlier:"
msgstr "Finalmente, saia do shell que foi iniciado anteriormente:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/x/installing/xcb-utilities.xml:151
#, no-wrap, xml-text
msgid "<userinput>exit</userinput>"
msgstr "<userinput>exit</userinput>"

