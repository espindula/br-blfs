#. type: Content of: <sect1><sect2><title>
#: blfs-en/x/installing/xorgproto.xml:26
#, xml-text
msgid "Introduction to xorgproto"
msgstr "Introdução ao xorgproto"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/installing/xorgproto.xml:29
#, xml-text
msgid ""
"The <application>xorgproto</application> package provides the header files "
"required to build the X Window system, and to allow other applications to "
"build against the installed X Window system."
msgstr ""
"O pacote &quot;<application>xorgproto</application>&quot; fornece os "
"arquivos de cabeçalho exigidos para construir o Sistema de Janelas "
"&quot;X&quot; e para permitir que outros aplicativos construam contra o "
"Sistema de Janelas &quot;X&quot; instalado."

