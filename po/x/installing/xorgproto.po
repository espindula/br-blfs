#: blfs-en/x/installing/xorgproto.xml:70
#, xml-text
msgid "xorgproto Dependencies"
msgstr "Dependências do &quot;xorgproto&quot;"

#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/x/installing/xorgproto.xml:72
#, xml-text
msgid "Required"
msgstr "Exigidas"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/installing/xorgproto.xml:74
#, xml-text
msgid "<xref linkend=\"util-macros\"/>"
msgstr "<xref linkend=\"util-macros\"/>"

#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/x/installing/xorgproto.xml:77
#, xml-text
msgid "Optional"
msgstr "Opcionais"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/installing/xorgproto.xml:79
#, xml-text
msgid ""
"<xref linkend=\"fop\"/>, <xref linkend=\"libxslt\"/>, <xref "
"linkend=\"xmlto\"/> and <xref linkend=\"asciidoc\"/> (to build additional "
"documentation)"
msgstr ""
"<xref linkend=\"fop\"/>, <xref linkend=\"libxslt\"/>, <xref "
"linkend=\"xmlto\"/> e <xref linkend=\"asciidoc\"/> (para construir "
"documentação adicional)"

#. type: Content of: <sect1><sect2><note><para>
#: blfs-en/x/installing/xorgproto.xml:87
#, xml-text
msgid ""
"There is a reciprocal dependency with <xref linkend=\"fop\"/>. If you wish "
"to build the documentation, you'll need to re-install the Protocol Headers "
"after the installation is complete and <xref linkend=\"fop\"/> has been "
"installed."
msgstr ""
"Existe uma dependência recíproca com o &quot;<xref linkend=\"fop\"/>&quot;. "
"Se desejar construir a documentação, [então] você precisará reinstalar os "
"Cabeçalhos de Protocolo depois da instalação estar completa e o &quot;<xref "
"linkend=\"fop\"/>&quot; ter sido instalado."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/installing/xorgproto.xml:94
#, xml-text
msgid "Editor Notes: <ulink url='&blfs-wiki;/Xorg7ProtocolHeaders'/>"
msgstr ""
"Observações de Editor(a): <ulink url='&blfs-wiki;/Xorg7ProtocolHeaders'/>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/x/installing/xorgproto.xml:100
#, xml-text
msgid "Installation of xorgproto"
msgstr "Instalação do xorgproto"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/installing/xorgproto.xml:103
#, xml-text
msgid ""
"Install <application>xorgproto</application> by running the following "
"commands:"
msgstr ""
"Instale o &quot;<application>xorgproto</application>&quot; executando os "
"seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/x/installing/xorgproto.xml:107
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=$XORG_PREFIX .. &amp;&amp;\n"
"ninja</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=$XORG_PREFIX .. &amp;&amp;\n"
"ninja</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/installing/xorgproto.xml:114
#, xml-text
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/installing/xorgproto.xml:118
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr "Agora, como o(a) usante <systemitem class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/x/installing/xorgproto.xml:121
#, no-wrap, xml-text
msgid ""
"<userinput>ninja install &amp;&amp;\n"
"mv -v $XORG_PREFIX/share/doc/xorgproto{,-&xorgproto-version;}</userinput>"
msgstr ""
"<userinput>ninja install &amp;&amp;\n"
"mv -v $XORG_PREFIX/share/doc/xorgproto{,-&xorgproto-version;}</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/x/installing/xorgproto.xml:130
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/installing/xorgproto.xml:133
#, xml-text
msgid ""
"<option>-D legacy=true</option>: Installs legacy headers needed by old "
"programs (such as <ulink "
"url=\"https://lesstif.sourceforge.net/\">LessTif</ulink>)."
msgstr ""
"<option>-D legacy=true</option>: Instala cabeçalhos legados necessários para"
" aplicativos antigos (como o <ulink "
"url=\"https://lesstif.sourceforge.net/\">LessTif</ulink>)."

