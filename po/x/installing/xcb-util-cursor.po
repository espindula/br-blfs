#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/installing/xcb-util-cursor.xml:89
#, xml-text
msgid ""
"Install <application>xcb-util-cursor</application> by running the following "
"commands:"
msgstr ""
"Instale o &quot;<application>xcb-util-cursor</application>&quot; executando "
"os seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/x/installing/xcb-util-cursor.xml:93
#, no-wrap, xml-text
msgid ""
"<userinput>./configure $XORG_CONFIG &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>./configure $XORG_CONFIG &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
