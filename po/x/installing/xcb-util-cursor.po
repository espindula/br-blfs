#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/installing/xcb-util-cursor.xml:29
#, xml-text
msgid ""
"The <application>xcb-util-cursor</application> package provides a module "
"that implements the XCB cursor library.  It is the "
"<application>XCB</application> replacement for libXcursor."
msgstr ""
"O pacote &quot;<application>xcb-util-cursor</application>&quot; fornece um "
"módulo que implementa a biblioteca de cursores &quot;XCB&quot;. Ela é a "
"substituta do &quot;<application>XCB</application>&quot; para a "
"&quot;libXcursor&quot;."

