#. type: Content of: <sect2><sect3><bridgehead>
#: blfs-en/x/installing/x7driver-nouveau.xml:77
msgid "Xorg Nouveau Drivers Dependencies"
msgstr ""
"Dependências dos Controladores &quot;Nouveau&quot; do &quot;Xorg&quot;"

#. type: Content of: <sect2><sect3><bridgehead>
#: blfs-en/x/installing/x7driver-nouveau.xml:79
msgid "Required"
msgstr "Exigidas"

#. type: Content of: <sect2><sect3><para>
#: blfs-en/x/installing/x7driver-nouveau.xml:81
msgid ""
"<xref linkend=\"xorg-server\"/> (recommended to be built with glamor "
"enabled)"
msgstr ""
"<xref linkend=\"xorg-server\"/> (recomendado para ser construído com o "
"&quot;glamour&quot; habilitado)"

#.  I tested this driver with a GTX 1050ti - the above note is true.
#. type: Content of: <sect2><sect3><note><para>
#: blfs-en/x/installing/x7driver-nouveau.xml:86
msgid ""
"The new <quote>Maxwell</quote> and <quote>Pascal</quote> GPUs require Glamor"
" to be built with the Xorg server."
msgstr ""
"As novas &quot;GPUs&quot; <quote>Maxwell</quote> e <quote>Pascal</quote> "
"exigem o &quot;Glamor&quot; para serem construídas com o servidor "
"&quot;Xorg&quot;."

#. type: Content of: <sect2><sect3><para>
#: blfs-en/x/installing/x7driver-nouveau.xml:93
msgid "User Notes: <ulink url=\"&blfs-wiki;/xorg-nouveau-driver\"/>"
msgstr ""
"Observações de Usuário(a): <ulink url=\"&blfs-wiki;/xorg-nouveau-driver\"/>"

#. type: Content of: <sect2><sect3><title>
#: blfs-en/x/installing/x7driver-nouveau.xml:98
msgid "Kernel Configuration"
msgstr "Configuração do Núcleo"

#. type: Content of: <sect2><sect3><para>
#: blfs-en/x/installing/x7driver-nouveau.xml:101
msgid ""
"Enable the following options in the kernel configuration and recompile the "
"kernel if necessary:"
msgstr ""
"Habilite as seguintes opções na configuração do núcleo e recompile o núcleo,"
" se necessário:"

#. type: Content of: <sect2><sect3><screen>
#: blfs-en/x/installing/x7driver-nouveau.xml:105
#, no-wrap
msgid ""
"<literal>Device Drivers  ---&gt;\n"
"  Graphics support ---&gt;\n"
"   &lt;*&gt; Direct Rendering Manager (XFree86 ... support) ---&gt; [CONFIG_DRM]\n"
"   &lt;*&gt; Nouveau (NVIDIA) cards                              [CONFIG_DRM_NOUVEAU]\n"
"      [*]   Support for backlight control                     [CONFIG_DRM_NOUVEAU_BACKLIGHT]</literal>"
msgstr ""
"<literal>Device Drivers  ---&gt;\n"
"  Graphics support ---&gt;\n"
"   &lt;*&gt; Direct Rendering Manager (XFree86 ... support) ---&gt; [CONFIG_DRM]\n"
"   &lt;*&gt; Nouveau (NVIDIA) cards                               [CONFIG_DRM_NOUVEAU]\n"
"      [*]   Support for backlight control                     [CONFIG_DRM_NOUVEAU_BACKLIGHT]</literal>"

#. type: Content of: <sect2><sect3><title>
#: blfs-en/x/installing/x7driver-nouveau.xml:117
msgid "Installation of Xorg Nouveau Driver"
msgstr ""
"Instalação do Controlador <quote>Nouveau</quote> do <quote>Xorg</quote>"

#. type: Content of: <sect2><sect3><note><para>
#: blfs-en/x/installing/x7driver-nouveau.xml:121
msgid ""
"Please ensure that you have installed <xref role=\"nodep\" "
"linkend=\"mesa\"/> with the nouveau fixes patch prior to continuing."
msgstr ""
"Por favor, certifique-se de ter instalado o &quot;<xref role=\"nodep\" "
"linkend=\"mesa\"/>&quot; com o remendo de correções &quot;nouveau&quot; "
"antes de continuar."

#. type: Content of: <sect2><sect3><para>
#: blfs-en/x/installing/x7driver-nouveau.xml:127
msgid ""
"First, fix the <application>Xorg Nouveau Driver</application> to build with "
"the latest Xorg Server:"
msgstr ""
"Primeiro, corrija o <application>Controlador &quot;Nouveau&quot; do "
"&quot;Xorg&quot;</application> para construir com o Servidor "
"&quot;Xorg&quot; mais recente:"

#. type: Content of: <sect2><sect3><screen>
#: blfs-en/x/installing/x7driver-nouveau.xml:131
#, no-wrap
msgid ""
"<userinput remap=\"pre\">grep -rl slave | xargs sed -i "
"s/slave/secondary/</userinput>"
msgstr ""
"<userinput remap=\"pre\">grep -rl slave | xargs sed -i "
"s/slave/secondary/</userinput>"

#. type: Content of: <sect2><sect3><para>
#: blfs-en/x/installing/x7driver-nouveau.xml:134
msgid ""
"Install <application>Xorg Nouveau Driver</application> by running the "
"following commands:"
msgstr ""
"Instale o <application>Controlador &quot;Nouveau&quot; do "
"&quot;Xorg&quot;</application> executando os seguintes comandos:"

#. type: Content of: <sect2><sect3><screen>
#: blfs-en/x/installing/x7driver-nouveau.xml:138
#, no-wrap
msgid ""
"<userinput>./configure $XORG_CONFIG &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>./configure $XORG_CONFIG &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect2><sect3><para>
#: blfs-en/x/installing/x7driver-nouveau.xml:142
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect2><sect3><para>
#: blfs-en/x/installing/x7driver-nouveau.xml:146
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr "Agora, como o(a) usante <systemitem class=\"username\">root</systemitem>:"

#. type: Content of: <sect2><sect3><screen>
#: blfs-en/x/installing/x7driver-nouveau.xml:149
#, no-wrap
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

