#, xml-text
msgid "Installation of xcb-util-image"
msgstr "Instalação do xcb-util-image"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/installing/xcb-util-image.xml:87
#, xml-text
msgid ""
"Install <application>xcb-util-image</application> by running the following "
"commands:"
msgstr ""
"Instale o &quot;<application>xcb-util-image</application>&quot; executando "
"os seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/x/installing/xcb-util-image.xml:91
#, no-wrap, xml-text
msgid ""
"<userinput>./configure $XORG_CONFIG &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>./configure $XORG_CONFIG &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/installing/xcb-util-image.xml:95
#, xml-text
msgid ""
"To test the results, issue: <command>LD_LIBRARY_PATH=$XORG_PREFIX/lib make "
"check</command>."
msgstr ""
"Para testar os resultados, emita: "
"&quot;<command>LD_LIBRARY_PATH=$XORG_PREFIX/lib make check</command>&quot;."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/installing/xcb-util-image.xml:100
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) &quot;<systemitem "
"class=\"username\">root</systemitem>&quot;:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/x/installing/xcb-util-image.xml:103
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

