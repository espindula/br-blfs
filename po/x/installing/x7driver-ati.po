#: blfs-en/x/installing/x7driver-ati.xml:323
msgid "<filename class=\"libraryfile\">radeon_drv.so</filename>"
msgstr "<filename class=\"libraryfile\">radeon_drv.so</filename>"

#. type: Content of:
#. <sect2><sect3><variablelist><varlistentry><listitem><para>
#: blfs-en/x/installing/x7driver-ati.xml:326
msgid "is an Xorg video driver for ATI Radeon based video cards"
msgstr ""
"é um controlador de vídeo do &quot;Xorg&quot; para placas de vídeo baseadas "
