#. type: Content of: <sect2><sect3><para>
#: blfs-en/x/installing/x7driver-synaptics.xml:92
#, xml-text
msgid ""
"Install <application>Xorg Synaptics Driver</application> by running the "
"following commands:"
msgstr ""
"Instale o <application>Controlador &quot;Synaptics&quot; do "
"&quot;Xorg&quot;</application> executando os seguintes comandos:"

#. type: Content of: <sect2><sect3><screen>
#: blfs-en/x/installing/x7driver-synaptics.xml:96
#, no-wrap, xml-text
