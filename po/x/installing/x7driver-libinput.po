#. type: Content of: <sect2><sect3><title>
#: blfs-en/x/installing/x7driver-libinput.xml:87
#, xml-text
msgid "Installation of Xorg Libinput Driver"
msgstr "Instalação do Controlador Libinput do Xorg"

#. type: Content of: <sect2><sect3><para>
#: blfs-en/x/installing/x7driver-libinput.xml:90
#, xml-text
msgid ""
"Install <application>Xorg Libinput Driver</application> by running the "
"following commands:"
msgstr ""
"Instale o <application>Controlador &quot;Libinput&quot; do "
"&quot;Xorg&quot;</application> executando os seguintes comandos:"

#. type: Content of: <sect2><sect3><screen>
#: blfs-en/x/installing/x7driver-libinput.xml:94
#, no-wrap, xml-text
msgid ""
"<userinput>./configure $XORG_CONFIG &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>./configure $XORG_CONFIG &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect2><sect3><para>
#: blfs-en/x/installing/x7driver-libinput.xml:98
#, xml-text
msgid "To test the results, issue <command>make check</command>."
msgstr "Para testar os resultados, emita <command>make check</command>."

#. type: Content of: <sect2><sect3><para>
#: blfs-en/x/installing/x7driver-libinput.xml:102
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr "Agora, como o(a) usante <systemitem class=\"username\">root</systemitem>:"

#. type: Content of: <sect2><sect3><screen>
#: blfs-en/x/installing/x7driver-libinput.xml:105
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

