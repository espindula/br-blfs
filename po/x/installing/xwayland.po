#. type: Content of: <sect1><sect2><title>
#: blfs-en/x/installing/xwayland.xml:26
#, xml-text
msgid "Introduction to Xwayland"
msgstr "Introdução ao Xwayland"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/installing/xwayland.xml:29
#, xml-text
msgid ""
"The <application>Xwayland</application> package is an Xorg server running on"
" top of the wayland server. It has been separated from the main Xorg server "
"package. It allows running X clients inside a wayland session."
msgstr ""
"O pacote &quot;<application>Xwayland</application>&quot; é um servidor "
"&quot;Xorg&quot; executando sobre o servidor &quot;wayland&quot;. Ele foi "
"separado do pacote principal do servidor &quot;Xorg&quot;. Permite executar "
"clientes do &quot;X&quot; dentro de uma sessão &quot;wayland&quot;."

