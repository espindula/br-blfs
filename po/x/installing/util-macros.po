#. type: Content of: <sect1><sect2><title>
#: blfs-en/x/installing/util-macros.xml:82
#, xml-text
msgid "Installation of util-macros"
msgstr "Instalação do util-macros"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/installing/util-macros.xml:85
#, xml-text
msgid ""
"Install <application>util-macros</application> by running the following "
"commands:"
msgstr ""
"Instale o &quot;<application>util-macros</application>&quot; executando os "
"seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/x/installing/util-macros.xml:89
#, no-wrap, xml-text
msgid "<userinput>./configure $XORG_CONFIG</userinput>"
msgstr "<userinput>./configure $XORG_CONFIG</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/installing/util-macros.xml:92
#, xml-text
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/installing/util-macros.xml:96
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) &quot;<systemitem "
"class=\"username\">root</systemitem>&quot;:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/x/installing/util-macros.xml:99
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

