"experimental icesound) e <ulink url='https://gitlab.gnome.org/Archive/gdk-"
"pixbuf-xlib'> gdk-pixbuf-xlib</ulink>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/x/wm/icewm.xml:93
#, xml-text
msgid "Installation of IceWM"
msgstr "Instalação do IceWM"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/wm/icewm.xml:105
#, xml-text
msgid ""
"Install <application>IceWM</application> by running the following commands:"
msgstr ""
"Instale o &quot;<application>IceWM</application>&quot; executando os "
"seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/x/wm/icewm.xml:109
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr \\\n"
"      -D CMAKE_BUILD_TYPE=Release  \\\n"
"      -D CFGDIR=/etc               \\\n"
"      -D ENABLE_LTO=ON             \\\n"
"      -D DOCDIR=/usr/share/doc/icewm-&icewm-version;  \\\n"
"      .. &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr \\\n"
"      -D CMAKE_BUILD_TYPE=Release  \\\n"
"      -D CFGDIR=/etc               \\\n"
"      -D ENABLE_LTO=ON             \\\n"
"      -D DOCDIR=/usr/share/doc/icewm-&icewm-version;  \\\n"
"      .. &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/wm/icewm.xml:121
#, xml-text
msgid "This package does not have a working test suite."
msgstr "Esse pacote não tem uma suíte funcional de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/wm/icewm.xml:125
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) &quot;<systemitem "
"class=\"username\">root</systemitem>&quot;:"

#. <screen role="root">
#. <userinput>cp ../lib/IceWM.jpg lib &amp;&amp;
#. make install         &amp;&amp;
#. rm /usr/share/xsessions/icewm.desktop</userinput></screen>
#. type: Content of: <sect1><sect2><screen>
#: blfs-en/x/wm/icewm.xml:132
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/wm/icewm.xml:135
#, xml-text
msgid ""
"This package creates two <filename>.desktop</filename> files in the "
"<filename class=\"directory\">/usr/share/xsessions/</filename> directory.  "
"Both are not needed in a BLFS system, so prevent the extra file showing up "
"as an option in a display manager.  As the &root; user:"
msgstr ""
"Esse pacote cria dois arquivos &quot;<filename>.desktop</filename>&quot; no "
"diretório &quot;<filename "
"class=\"directory\">/usr/share/xsessions/</filename>&quot;. Ambos não são "
"necessários em um sistema BLFS, de forma que evite o arquivo extra "
"aparecendo como uma opção em um gerenciador de tela. Como o(a) usuário(a) "
"&quot;&root;&quot;:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/x/wm/icewm.xml:141
#, no-wrap, xml-text
msgid "<userinput>rm -v /usr/share/xsessions/icewm.desktop</userinput>"
msgstr "<userinput>rm -v /usr/share/xsessions/icewm.desktop</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/x/wm/icewm.xml:146
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/wm/icewm.xml:149
#, xml-text
msgid ""
"<parameter>-D ENABLE_LTO=ON</parameter>: This option enables Link Time "
"Optimization and is required for this package."
msgstr ""
"<parameter>-D ENABLE_LTO=ON</parameter>: Essa opção habilita Link Time "
"Optimization e é exigida para esse pacote."

#. type: Content of: <sect1><sect2><title>
#: blfs-en/x/wm/icewm.xml:169
#, xml-text
msgid "Configuring IceWM"
msgstr "Configurando o IceWM"

#. type: Content of: <sect1><sect2><sect3><title>
#: blfs-en/x/wm/icewm.xml:172
#, xml-text
msgid "Config Files"
msgstr "Arquivos de Configuração"

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/x/wm/icewm.xml:175
#, xml-text
msgid ""
"<filename>~/.icewm/keys</filename>, <filename>~/.icewm/menu</filename>, and "
"<filename>~/.icewm/preferences</filename>, and "
"<filename>~/.icewm/toolbar</filename>, and "
"<filename>~/.icewm/winoptions</filename>. The default versions are installed"
" in <filename class=\"directory\">/usr/share/icewm/</filename> and will be "
"used if you have not copied them to <filename "
"class=\"directory\">~/.icewm</filename>."
msgstr ""
"&quot;<filename>~/.icewm/keys</filename>&quot;, "
"&quot;<filename>~/.icewm/menu</filename>&quot; e "
"&quot;<filename>~/.icewm/preferences</filename>&quot; e "
"&quot;<filename>~/.icewm/toolbar</filename>&quot; e "
"&quot;<filename>~/.icewm/winoptions</filename>&quot;. As versões padrão são "
"instaladas em &quot;<filename "
"class=\"directory\">/usr/share/icewm/</filename>&quot; e serão usadas se "
"você não as tiver copiado para &quot;<filename "
"class=\"directory\">~/.icewm</filename>&quot;."

#. type: Content of: <sect1><sect2><sect3><indexterm><primary>
#: blfs-en/x/wm/icewm.xml:187
#, xml-text
msgid "~/.icewm/keys"
msgstr "~/.icewm/keys"

#. type: Content of: <sect1><sect2><sect3><indexterm><primary>
#: blfs-en/x/wm/icewm.xml:191
#, xml-text
msgid "~/.icewm/menu"
msgstr "~/.icewm/menu"

#. type: Content of: <sect1><sect2><sect3><indexterm><primary>
#: blfs-en/x/wm/icewm.xml:195
#, xml-text
msgid "~/.icewm/preferences"
msgstr "~/.icewm/preferences"

#. type: Content of: <sect1><sect2><sect3><indexterm><primary>
#: blfs-en/x/wm/icewm.xml:199
#, xml-text
msgid "~/.icewm/toolbar"
msgstr "~/.icewm/toolbar"

#. type: Content of: <sect1><sect2><sect3><indexterm><primary>
#: blfs-en/x/wm/icewm.xml:203
#, xml-text
msgid "~/.icewm/winoptions"
msgstr "~/.icewm/winoptions"

#. type: Content of: <sect1><sect2><sect3><title>
#: blfs-en/x/wm/icewm.xml:209
#, xml-text
msgid "Configuration Information"
msgstr "Informação de Configuração"

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/x/wm/icewm.xml:212
#, xml-text
msgid ""
"If <application>IceWM</application> is the only Window Manager you want to "
"use, you can start it with an <filename>.xinitrc</filename> file in your "
"home folder. Be sure to backup your current <filename>.xinitrc</filename> "
"before proceeding."
msgstr ""
"Se o &quot;<application>IceWM</application>&quot; for o único Gerenciador de"
" Janelas que você quer usar, [então] você pode iniciá-lo com um arquivo "
"&quot;<filename>.xinitrc</filename>&quot; em tua pasta inicial. Certifique-"
"se de produzir uma cópia de segurança do teu "
"&quot;<filename>.xinitrc</filename>&quot; atual antes de continuar."

#. type: Content of: <sect1><sect2><sect3><indexterm><primary>
#: blfs-en/x/wm/icewm.xml:219
#, xml-text
msgid "~/.xinitrc"
msgstr "~/.xinitrc"

#. type: Content of: <sect1><sect2><sect3><screen>
#: blfs-en/x/wm/icewm.xml:222
#, no-wrap, xml-text
msgid "<userinput>echo icewm-session &gt; ~/.xinitrc</userinput>"
msgstr "<userinput>echo icewm-session &gt; ~/.xinitrc</userinput>"

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/x/wm/icewm.xml:225
#, xml-text
msgid "Now create the <application>IceWM</application> configuration files:"
msgstr ""
"Agora crie os arquivos de configuração do "
"&quot;<application>IceWM</application>&quot;:"

#. type: Content of: <sect1><sect2><sect3><screen>
#: blfs-en/x/wm/icewm.xml:228
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir -pv ~/.icewm                                      &amp;&amp;\n"
"cp -v /usr/share/icewm/keys ~/.icewm/keys               &amp;&amp;\n"
"cp -v /usr/share/icewm/menu ~/.icewm/menu               &amp;&amp;\n"
"cp -v /usr/share/icewm/preferences ~/.icewm/preferences &amp;&amp;\n"
"cp -v /usr/share/icewm/toolbar ~/.icewm/toolbar         &amp;&amp;\n"
"cp -v /usr/share/icewm/winoptions ~/.icewm/winoptions</userinput>"
msgstr ""
"<userinput>mkdir -pv ~/.icewm                                       &amp;&amp;\n"
"cp -v /usr/share/icewm/keys ~/.icewm/keys               &amp;&amp;\n"
"cp -v /usr/share/icewm/menu ~/.icewm/menu               &amp;&amp;\n"
"cp -v /usr/share/icewm/preferences ~/.icewm/preferences &amp;&amp;\n"
"cp -v /usr/share/icewm/toolbar ~/.icewm/toolbar         &amp;&amp;\n"
"cp -v /usr/share/icewm/winoptions ~/.icewm/winoptions</userinput>"

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/x/wm/icewm.xml:236
#, xml-text
msgid ""
"You can now edit these files to meet your requirements. In particular, "
"review the <filename>preferences</filename> file. You can use "
"<command>Logout -> Restart-IceWM</command> on the main menu to load your "
"changed preferences, but changes to the background only take effect when "
"<application>IceWM</application> is started."
msgstr ""
"Agora você pode editar esses arquivos para atender às tuas necessidades. Em "
"particular, revise o arquivo &quot;<filename>preferences</filename>&quot;. "
"Você pode usar &quot;<command>Logout -> Restart-IceWM</command>&quot; no "
"menu principal para carregar tuas preferências mudadas, mas as mudanças para"
" o plano de fundo somente terão efeito quando o "
"&quot;<application>IceWM</application>&quot; for iniciado."

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/x/wm/icewm.xml:244
#, xml-text
msgid ""
"At this point you can <emphasis>either</emphasis> modify the traditional "
"menu files to suit your requirements, <emphasis>or</emphasis> use the newer "
"<command>icewm-menu-fdo</command> described later."
msgstr ""
"Neste ponto você pode <emphasis>ou</emphasis> modificar os arquivos "
"tradicionais de menu para atender às tuas necessidades, "
"<emphasis>ou</emphasis> usar o &quot;<command>icewm-menu-fdo</command>&quot;"
" mais recente descrito mais adiante."

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/x/wm/icewm.xml:251
#, xml-text
msgid ""
"The syntax of the menus is explained in the help files, which you can access"
" by running <command>help</command> from the menu, but some of the detail is"
" out of date and the default selections in the menus (a few old applications"
" on the main menu, everything else on the <command>Programs</command> menu) "
"will benefit from being updated to meet your needs. The following examples "
"are provided to encourage you to think about how you wish to organise your "
"menus. Please note the following:"
msgstr ""
"A sintaxe dos menus é explicada nos arquivos de ajuda, os quais você "
"consegue acessar executando &quot;<command>help</command>&quot; a partir do "
"menu, mas alguns detalhes estão desatualizados e as seleções padrão nos "
"menus (alguns antigos aplicativos no menu principal, todo o resto no menu "
"&quot;<command>Programas</command>&quot;) serão beneficiadas com a "
"atualização para atender às tuas necessidades. Os exemplos a seguir são "
"fornecidos para te incentivar a pensar a respeito do como deseja organizar "
"teus menus. Por favor observe o seguinte:"

#. type: Content of: <sect1><sect2><sect3><itemizedlist><listitem><para>
#: blfs-en/x/wm/icewm.xml:264
#, xml-text
msgid ""
"If a program listed in the menu has not been installed, it will not appear "
"when the menu is displayed. Similarly, if the program exists but the "
"specified icon does not, no icon will be displayed in the menu."
msgstr ""
"Se um aplicativo listado no menu não tiver sido instalado, [então] ele não "
"aparecerá quando o menu for exibido. Da mesma forma, se o aplicativo "
"existir, mas o ícone especificado não existir, [então] nenhum ícone será "
"exibido no menu."

#. type: Content of: <sect1><sect2><sect3><itemizedlist><listitem><para>
#: blfs-en/x/wm/icewm.xml:272
#, xml-text
msgid ""
"The icons can be either <filename>.xpm</filename> or "
"<filename>.png</filename> files, and there is no need to specify the "
"extension. If the icon is located in the &quot;library&quot; (<filename "
"class=\"directory\">/usr/share/icewm/icons</filename>)  there is no need to "
"specify the path."
msgstr ""
"Os ícones podem ser ou arquivos &quot;<filename>.xpm</filename>&quot; ou "
"&quot;<filename>.png</filename>&quot; e não existe necessidade de "
"especificar a extensão. Se o ícone estiver localizado na "
"&quot;biblioteca&quot; (&quot;<filename "
"class=\"directory\">/usr/share/icewm/icons</filename>&quot;), [então] não "
"existe necessidade de especificar o caminho."

#. type: Content of: <sect1><sect2><sect3><itemizedlist><listitem><para>
#: blfs-en/x/wm/icewm.xml:281
#, xml-text
msgid ""
"Most programs are in sub-menus, and the main menu will always append entries"
" for <literal>windows, help, settings, logout</literal> at the bottom."
msgstr ""
"A maioria dos aplicativos está em submenus, e o menu principal sempre "
"acrescentará entradas para <literal>&quot;janelas&quot;, &quot;ajuda&quot;, "
"&quot;configurações&quot;, &quot;logout&quot;</literal> na parte inferior."

#. type: Content of: <sect1><sect2><sect3><itemizedlist><listitem><para>
#: blfs-en/x/wm/icewm.xml:289
#, xml-text
msgid ""
"An icon for <application>firefox</application> was copied to the library "
"directory and given a meaningful name. The icon for "
"<application>xine</application> is <filename>xine.xpm</filename> which was "
"installed to a pixmap directory."
msgstr ""
"Um ícone para o &quot;<application>firefox</application>&quot; foi copiado "
"para o diretório da biblioteca e recebeu um nome significativo. O ícone para"
" o &quot;<application>xine</application>&quot; é "
"&quot;<filename>xine.xpm</filename>&quot; que foi instalado em um diretório "
"&quot;pixmap&quot;."

#. type: Content of: <sect1><sect2><sect3><itemizedlist><listitem><para>
#: blfs-en/x/wm/icewm.xml:297
#, xml-text
msgid "The default toolbar is not altered."
msgstr "A barra de ferramentas padrão não é alterada."

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/x/wm/icewm.xml:303
#, xml-text
msgid ""
"If you wish to use this traditional method, there are more examples in "
"previous releases of this book (e.g. BLFS-7.8)."
msgstr ""
"Se desejar usar esse método tradicional, [então] existem mais exemplos em "
"lançamentos anteriores deste livro (por exemplo, BLFS-7.8)."

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/x/wm/icewm.xml:308
#, xml-text
msgid ""
"<emphasis>Alternatively</emphasis>, you can create a menu which conforms to "
"the FDO Desktop Menu Specifications, where programs can be found because "
"they have a .desktop file in the XDG_DATA_HOME or XDG_DATA_DIR directories."
"  Unlike most windowmanagers, <application>icewm</application> does not "
"search for programs when the menu is invoked, so if you take this route you "
"will need to rerun the following command after installing or removing "
"programs:"
msgstr ""
"<emphasis>Alternativamente</emphasis>, você pode criar um menu que esteja em"
" conformidade com as Especificações de Menu de Área de Trabalho "
"&quot;FDO&quot;, onde os aplicativos podem ser encontrados porque tem um "
"arquivo &quot;.desktop&quot; nos diretórios &quot;XDG_DATA_HOME&quot; ou "
"&quot;XDG_DATA_DIR&quot;. Ao contrário da maioria dos gerenciadores de "
"janelas, o &quot;<application>icewm</application>&quot; não procura "
"aplicativos quando o menu é invocado, de forma que, se você seguir esse "
"caminho, [então] precisará executar novamente o seguinte comando depois de "
"instalar ou remover aplicativos:"

#. type: Content of: <sect1><sect2><sect3><screen>
#: blfs-en/x/wm/icewm.xml:317
#, no-wrap, xml-text
msgid "<userinput>icewm-menu-fdo >~/.icewm/menu</userinput>"
msgstr "<userinput>icewm-menu-fdo >~/.icewm/menu</userinput>"

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/x/wm/icewm.xml:320
#, xml-text
msgid ""
"If you wish to put icons on your desktop, you will need to install a program"
" such as <ulink "
"url='https://sourceforge.net/projects/rox/files/rox/2.11/'>rox-filer</ulink>"
" which provides a pinboard.  If you do that you will no longer be able to "
"access the menu by right-clicking on the desktop, you will have to use the "
"<application>IceWM</application> button. To ensure that the "
"<application>rox</application> pinboard is running, the following commands "
"will put it in the startup file:"
msgstr ""
"Se desejar colocar ícones em tua área de trabalho, você precisará instalar "
"um aplicativo como o <ulink "
"url='https://sourceforge.net/projects/rox/files/rox/2.11/'>rox-filer</ulink>"
" que fornece um quadro de avisos. Se fizer isso, você não mais poderá "
"acessar o menu clicando com o botão direito na área de trabalho; você terá "
"que usar o botão do <application>IceWM</application>. Para garantir que o "
"quadro de avisos do <application>rox</application> esteja executando, os "
"seguintes comandos o colocarão no arquivo de inicialização:"

#. type: Content of: <sect1><sect2><sect3><screen>
#: blfs-en/x/wm/icewm.xml:331
#, no-wrap, xml-text
msgid ""
"<userinput>cat &gt; ~/.icewm/startup &lt;&lt; \"EOF\"\n"
"<literal>rox -p Default &amp;\n"
"EOF &amp;&amp;\n"
"chmod +x ~/.icewm/startup</literal></userinput>"
msgstr ""
"<userinput>cat &gt; ~/.icewm/startup &lt;&lt; \"EOF\"\n"
"<literal>rox -p Default &amp;\n"
"EOF &amp;&amp;\n"
"chmod +x ~/.icewm/startup</literal></userinput>"

#. type: Content of: <sect1><sect2><sect3><tip><para>
#: blfs-en/x/wm/icewm.xml:338
#, xml-text
msgid ""
"There are a number of keyboard shortcuts in "
"<application>IceWM</application>:"
msgstr ""
"Existem vários atalhos de teclado no "
"&quot;<application>IceWM</application>&quot;:"

#. type: Content of: <sect1><sect2><sect3><tip><itemizedlist><listitem><para>
#: blfs-en/x/wm/icewm.xml:344
#, xml-text
msgid ""
"Ctrl + Alt + F<replaceable>N</replaceable> : go to "
"<filename>tty<replaceable>N</replaceable></filename>."
msgstr ""
"Ctrl + Alt + F<replaceable>N</replaceable>: vai para o "
"&quot;<filename>tty<replaceable>N</replaceable></filename>&quot;."

#. type: Content of: <sect1><sect2><sect3><tip><itemizedlist><listitem><para>
#: blfs-en/x/wm/icewm.xml:350
#, xml-text
msgid ""
"Ctrl + Alt + <replaceable>N</replaceable> : go to desktop number "
"<replaceable>N</replaceable>"
msgstr ""
"Ctrl + Alt + <replaceable>N</replaceable>: vai para a área de trabalho "
"número &quot;<replaceable>N</replaceable>&quot;"

#. type: Content of: <sect1><sect2><sect3><tip><itemizedlist><listitem><para>
#: blfs-en/x/wm/icewm.xml:356
#, xml-text
msgid ""
"Ctrl + Alt + Space : open a box on the taskbar where you can key in the name"
" of an application and run it."
msgstr ""
"Ctrl + Alt + Space: abre uma caixa na barra de tarefas onde você consegue "
"digitar o nome de um aplicativo e executá-lo."

