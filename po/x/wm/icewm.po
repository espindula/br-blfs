#. type: Content of: <sect1><sect2><title>
#: blfs-en/x/wm/icewm.xml:26
#, xml-text
msgid "Introduction to IceWM"
msgstr "Introdução ao IceWM"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/wm/icewm.xml:29
#, xml-text
msgid ""
"<application>IceWM</application> is a window manager with the goals of "
"speed, simplicity, and not getting in the user&apos;s way."
msgstr ""
"&quot;<application>IceWM</application>&quot; é um gerenciador de janelas com"
" os objetivos de velocidade, simplicidade e não atrapalhar o(a) usuário(a)."

