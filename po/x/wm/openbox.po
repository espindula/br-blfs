#. type: Content of: <sect1><indexterm><primary>
#: blfs-en/x/wm/openbox.xml:23
#, xml-text
msgid "Openbox"
msgstr "Openbox"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/x/wm/openbox.xml:27
#, xml-text
msgid "Introduction to openbox"
msgstr "Introdução ao openbox"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/wm/openbox.xml:30
#, xml-text
msgid ""
"<application>Openbox</application> is a highly configurable desktop window "
"manager with extensive standards support. It allows you to control almost "
"every aspect of how you interact with your desktop."
msgstr ""
"&quot;<application>Openbox</application>&quot; é um gerenciador de janelas "
"de área de trabalho altamente configurável com amplo suporte a padrões. Ele "
"te permite controlar quase todos os aspectos de como você interage com a tua"
" área de trabalho."

#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/x/wm/openbox.xml:37
#, xml-text
msgid "Package Information"
msgstr "Informação do Pacote"

#. type: Content of: <sect1><sect2><itemizedlist><listitem><para>
#: blfs-en/x/wm/openbox.xml:41
#, xml-text
