#. type: Content of: <sect1><sect2><title>
#: blfs-en/x/dm/lightdm.xml:155
#, xml-text
msgid "Installation of Lightdm"
msgstr "Instalação do Lightdm"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/dm/lightdm.xml:158
#, xml-text
msgid ""
"First, create a dedicated user and group to take control of the "
"<command>lightdm</command> daemon after it is started. Issue the following "
"commands as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Primeiro, crie um(a) usuário(a) e um grupo dedicado(a) para assumir o "
"controle do processo de segundo plano &quot;<command>lightdm</command>&quot;"
" depois de ele ser iniciado. Emita os seguintes comandos como o(a) "
"usuário(a) &quot;<systemitem class=\"username\">root</systemitem>&quot;:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/x/dm/lightdm.xml:164
#, no-wrap, xml-text
msgid ""
"<userinput>groupadd -g 65 lightdm       &amp;&amp;\n"
"useradd  -c \"Lightdm Daemon\" \\\n"
"         -d /var/lib/lightdm \\\n"
"         -u 65 -g lightdm    \\\n"
"         -s /bin/false lightdm</userinput>"
msgstr ""
"<userinput>groupadd -g 65 lightdm        &amp;&amp;\n"
"useradd  -c \"Lightdm Daemon\" \\\n"
"         -d /var/lib/lightdm \\\n"
"         -u 65 -g lightdm    \\\n"
"         -s /bin/false lightdm</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/dm/lightdm.xml:171
#, xml-text
msgid ""
"Then change the <application>Linux-PAM</application> configuration files so "
"that <application>elogind</application> is used:"
msgstr ""
"Em seguida, mude os arquivos de configuração do &quot;<application>Linux-"
"PAM</application>&quot;, de forma que o "
"&quot;<application>elogind</application>&quot; seja usado:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/x/dm/lightdm.xml:175
#, no-wrap, xml-text
msgid "<userinput>sed -i s/systemd/elogind/ data/pam/*</userinput>"
msgstr "<userinput>sed -i s/systemd/elogind/ data/pam/*</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/dm/lightdm.xml:178
#, xml-text
msgid ""
"Install <application>lightdm</application> by running the following "
"commands:"
msgstr ""
"Instale o &quot;<application>lightdm</application>&quot; executando os "
"seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/x/dm/lightdm.xml:182
#, fuzzy, no-wrap, xml-text
#| msgid ""
#| "<userinput>./configure --prefix=/usr                 \\\n"
#| "            --libexecdir=/usr/lib/lightdm \\\n"
#| "            --localstatedir=/var          \\\n"
#| "            --sbindir=/usr/bin            \\\n"
#| "            --sysconfdir=/etc             \\\n"
#| "            --disable-static              \\\n"
#| "            --disable-tests               \\\n"
#| "            --with-greeter-user=lightdm   \\\n"
#| "            --with-greeter-session=lightdm-gtk-greeter \\\n"
#| "            --docdir=/usr/share/doc/lightdm-&lightdm-version; &amp;&amp;\n"
#| "make</userinput>"
msgid ""
"<userinput>sed -i '/YELP_HELP/d' configure.ac help/Makefile.am    &amp;&amp;\n"
"\n"
"autoreconf -fiv                                        &amp;&amp;\n"
"\n"
"./configure --prefix=/usr                 \\\n"
"            --libexecdir=/usr/lib/lightdm \\\n"
"            --localstatedir=/var          \\\n"
"            --sbindir=/usr/bin            \\\n"
"            --sysconfdir=/etc             \\\n"
"            --disable-static              \\\n"
"            --disable-tests               \\\n"
"            --with-greeter-user=lightdm   \\\n"
"            --with-greeter-session=lightdm-gtk-greeter &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>./configure --prefix=/usr                  \\\n"
"            --libexecdir=/usr/lib/lightdm \\\n"
"            --localstatedir=/var          \\\n"
"            --sbindir=/usr/bin            \\\n"
"            --sysconfdir=/etc             \\\n"
"            --disable-static              \\\n"
"            --disable-tests               \\\n"
"            --with-greeter-user=lightdm   \\\n"
"            --with-greeter-session=lightdm-gtk-greeter \\\n"
"            --docdir=/usr/share/doc/lightdm-&lightdm-version; &amp;&amp;\n"
"make</userinput>"

