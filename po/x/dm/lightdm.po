#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/dm/lightdm.xml:38
#, xml-text
msgid ""
"The <application>lightdm</application> package contains a lightweight "
"display manager based upon GTK."
msgstr ""
"O pacote &quot;<application>lightdm</application>&quot; contém um "
"gerenciador de exibição leve baseado em no &quot;GTK&quot;."

