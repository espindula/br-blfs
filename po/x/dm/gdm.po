#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/dm/gdm.xml:29
#, xml-text
msgid ""
"<application>GDM</application> is a system service that is responsible for "
"providing graphical logins and managing local and remote displays."
msgstr ""
"&quot;<application>GDM</application>&quot; é um serviço de sistema que é "
"responsável por fornecer &quot;logins&quot; gráficos e gerenciar exibições "
"locais e remotas."

