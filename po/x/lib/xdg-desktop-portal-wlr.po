#. type: Content of: <sect1><sect2><title>
#: blfs-en/x/lib/xdg-desktop-portal-wlr.xml:94
#, xml-text
msgid "Installation of xdg-desktop-portal-wlr"
msgstr "Instalação do xdg-desktop-portal-wlr"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/lib/xdg-desktop-portal-wlr.xml:97
#, xml-text
msgid "Install xdg-desktop-portal-wlr by running the following commands:"
msgstr "Instale xdg-desktop-portal-wlr executando os seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/x/lib/xdg-desktop-portal-wlr.xml:100
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr       \\\n"
"            --buildtype=release \\\n"
"            .. &amp;&amp;\n"
"ninja</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr       \\\n"
"            --buildtype=release \\\n"
"            .. &amp;&amp;\n"
"ninja</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/lib/xdg-desktop-portal-wlr.xml:109
#, xml-text
msgid "This package doesn't come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/lib/xdg-desktop-portal-wlr.xml:113
#, xml-text
msgid "Now, as the &root; user:"
msgstr "Agora, como o(a) usante &root;:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/x/lib/xdg-desktop-portal-wlr.xml:116
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr "<userinput>ninja install</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/lib/xdg-desktop-portal-wlr.xml:119
#, xml-text
msgid "Ensure the portal can be detected as the &root; user:"
msgstr ""
"Certifique-se de que o portal possa ser detectado como o(a) usante &root;:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/x/lib/xdg-desktop-portal-wlr.xml:123
#, no-wrap, xml-text
msgid ""
"<userinput>cat &gt; /usr/share/xdg-desktop-portal/wlr-portals.conf &lt;&lt; \"EOF\"\n"
"<literal>[preferred]\n"
"default=wlr</literal>\n"
"EOF</userinput>"
msgstr ""
"<userinput>cat &gt; /usr/share/xdg-desktop-portal/wlr-portals.conf &lt;&lt; \"EOF\"\n"
"<literal>[preferred]\n"
"default=wlr</literal>\n"
"EOF</userinput>"

