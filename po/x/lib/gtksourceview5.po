#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/lib/gtksourceview5.xml:28
#, xml-text
msgid ""
"The <application>GtkSourceView</application> package contains a library used"
" for extending the <application>GTK</application> text functions to include "
"syntax highlighting."
msgstr ""
"O pacote &quot;<application>GtkSourceView</application>&quot; contém uma "
"biblioteca usada para estender as funções de texto do "
"&quot;<application>GTK</application>&quot; para incluir realce de sintaxe."

