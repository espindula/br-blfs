#. type: Content of: <sect1><sect2><title>
#: blfs-en/x/lib/gtksourceview5.xml:96
#, xml-text
msgid "Installation of GtkSourceView"
msgstr "Instalação do GtkSourceView"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/lib/gtksourceview5.xml:99
#, xml-text
msgid ""
"Install <application>GtkSourceView</application> by running the following "
"commands:"
msgstr ""
"Instale o &quot;<application>GtkSourceView</application>&quot; executando os"
" seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/x/lib/gtksourceview5.xml:103
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr --buildtype=release .. &amp;&amp;\n"
"ninja</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr --buildtype=release .. &amp;&amp;\n"
"ninja</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/lib/gtksourceview5.xml:110
#, xml-text
msgid "To test the results, issue: <command>ninja test</command>."
msgstr "Para testar os resultados, emita: <command>ninja test</command>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/lib/gtksourceview5.xml:114
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) &quot;<systemitem "
"class=\"username\">root</systemitem>&quot;:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/x/lib/gtksourceview5.xml:117
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr "<userinput>ninja install</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/x/lib/gtksourceview5.xml:121
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/lib/gtksourceview5.xml:124
#, xml-text
msgid ""
"<option>-D documentation=true</option>: Use this switch if you have <xref "
"linkend=\"gi-docgen\"/> installed and wish to generate the API "
"documentation."
msgstr ""
"<option>-D documentation=true</option>: Use essa chave se você tiver <xref "
"linkend=\"gi-docgen\"/> instalado e desejar gerar a documentação da API."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/lib/gtksourceview5.xml:130
#, xml-text
msgid ""
"<option>-D sysprof=true</option>: Use this switch if you have <ulink "
"url=\"&sysprof-url;\">sysprof</ulink> installed and wish to build with "
"sysprof profiler support."
msgstr ""
"<option>-D sysprof=true</option>: Use essa chave se você tiver <ulink "
"url=\"&sysprof-url;\">sysprof</ulink> instalado e desejar construir com "
"suporte de perfilador sysprof."

