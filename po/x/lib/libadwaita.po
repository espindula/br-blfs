#. type: Content of: <sect1><sect2><title>
#: blfs-en/x/lib/libadwaita.xml:93
#, xml-text
msgid "Installation of libadwaita"
msgstr "Instalação do libadwaita"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/lib/libadwaita.xml:96
#, xml-text
msgid ""
"Install <application>libadwaita</application> by running the following "
"commands:"
msgstr ""
"Instale o &quot;<application>libadwaita</application>&quot; executando os "
"seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/x/lib/libadwaita.xml:100
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr --buildtype=release .. &amp;&amp;\n"
"ninja</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr --buildtype=release .. &amp;&amp;\n"
"ninja</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/lib/libadwaita.xml:107
#, xml-text
msgid ""
"If you have <xref linkend='gi-docgen'/> installed and wish to build the API "
"documentation for this package, issue:"
msgstr ""
"Se você tiver <xref linkend='gi-docgen'/> instalado e desejar construir a "
"documentação da API para esse pacote, emita:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/x/lib/libadwaita.xml:111
#, no-wrap, xml-text
msgid ""
"<userinput>sed \"s/apiversion/'&libadwaita-version;'/\" -i ../doc/meson.build &amp;&amp;\n"
"meson configure -D gtk_doc=true                   &amp;&amp;\n"
"ninja</userinput>"
msgstr ""
"<userinput>sed \"s/apiversion/'&libadwaita-version;'/\" -i ../doc/meson.build &amp;&amp;\n"
"meson configure -D gtk_doc=true                   &amp;&amp;\n"
"ninja</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/lib/libadwaita.xml:116
#, xml-text
msgid ""
"To test the results, issue: <command>ninja test</command>.  The tests must "
"be run from a graphical session. Two tests will fail if <xref linkend=\"xdg-"
"desktop-portal\"/> is not installed."
msgstr ""
"Para testar os resultados, emita: <command>ninja test</command>. Os testes "
"precisam ser executados a partir de uma sessão gráfica. Dois testes falharão"
" se <xref linkend=\"xdg-desktop-portal\"/> não estiver instalado."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/lib/libadwaita.xml:122
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) &quot;<systemitem "
"class=\"username\">root</systemitem>&quot;:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/x/lib/libadwaita.xml:125
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr "<userinput>ninja install</userinput>"

