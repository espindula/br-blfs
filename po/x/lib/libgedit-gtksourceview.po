#. type: Content of: <sect1><sect2><title>
#: blfs-en/x/lib/libgedit-gtksourceview.xml:90
#, xml-text
msgid "Installation of libgedit-gtksourceview"
msgstr "Instalação do libgedit-gtksourceview"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/lib/libgedit-gtksourceview.xml:93
#, xml-text
msgid ""
"Install <application>libgedit-gtksourceview</application> by running the "
"following commands:"
msgstr ""
"Instale o <application>libgedit-gtksourceview</application> executando os "
"seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/x/lib/libgedit-gtksourceview.xml:97
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build-libgedit &amp;&amp;\n"
"cd    build-libgedit &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr       \\\n"
"            --buildtype=release \\\n"
"            -D gtk_doc=false    \\\n"
"            .. &amp;&amp;\n"
"ninja</userinput>"
msgstr ""
"<userinput>mkdir build-libgedit &amp;&amp;\n"
"cd    build-libgedit &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr       \\\n"
"            --buildtype=release \\\n"
"            -D gtk_doc=false    \\\n"
"            .. &amp;&amp;\n"
"ninja</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/lib/libgedit-gtksourceview.xml:107
#, xml-text
msgid "To test the results, issue: <command>ninja test</command>."
msgstr "Para testar os resultados, emita: <command>ninja test</command>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/lib/libgedit-gtksourceview.xml:111
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr "Agora, como o(a) usante <systemitem class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/x/lib/libgedit-gtksourceview.xml:114
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr "<userinput>ninja install</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/x/lib/libgedit-gtksourceview.xml:118
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/lib/libgedit-gtksourceview.xml:124
#, xml-text
msgid ""
"<parameter>-D gtk_doc=false</parameter>: Disables building the API "
"documentation. Remove if you have <xref linkend=\"gtk-doc\"/> installed and "
"wish to build the API documentation."
msgstr ""
"<parameter>-D gtk_doc=false</parameter>: Desabilita a construção da "
"documentação da API. Remova se você tiver o <xref linkend=\"gtk-doc\"/> "
"instalado e desejar construir a documentação da API."

