#. type: Content of: <sect1><sect2><title>
#: blfs-en/x/lib/xdg-desktop-portal-gtk.xml:86
#, xml-text
msgid "Installation of xdg-desktop-portal-gtk"
msgstr "Instalação do xdg-desktop-portal-gtk"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/lib/xdg-desktop-portal-gtk.xml:89
#, xml-text
msgid ""
"Install <application>xdg-desktop-portal-gtk</application> by running the "
"following commands:"
msgstr ""
"Instale <application>xdg-desktop-portal-gtk</application> executando os "
"seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/x/lib/xdg-desktop-portal-gtk.xml:93
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr --buildtype=release .. &amp;&amp;\n"
"ninja</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr --buildtype=release .. &amp;&amp;\n"
"ninja</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/lib/xdg-desktop-portal-gtk.xml:100
#, xml-text
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/lib/xdg-desktop-portal-gtk.xml:104
#, xml-text
msgid "Now, as the &root; user:"
msgstr "Agora, como o(a) usuário(a) &root;:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/x/lib/xdg-desktop-portal-gtk.xml:107
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr "<userinput>ninja install</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/lib/xdg-desktop-portal-gtk.xml:110
#, xml-text
msgid "Remove systemd files that are useless (as the &root; user):"
msgstr ""
"Remova arquivos do systemd que são inúteis (como o(a) usuário(a) &root;):"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/x/lib/xdg-desktop-portal-gtk.xml:113
#, no-wrap, xml-text
msgid "<userinput>rm -rvf /usr/lib/systemd</userinput>"
msgstr "<userinput>rm -rvf /usr/lib/systemd</userinput>"

