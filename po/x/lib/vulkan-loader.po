#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/lib/vulkan-loader.xml:28
#, xml-text
msgid ""
"The <application>Vulkan-Loader</application> package contains a library "
"which provides the Vulkan API and provides core support for graphics drivers"
" for Vulkan."
msgstr ""
"O pacote <application>Vulkan-Loader</application> contém uma biblioteca que "
"fornece a API do Vulkan e fornece suporte básico para controladores gráficos"
" para Vulkan."

