#. type: Content of: <sect1><sect2><title>
#: blfs-en/x/lib/wlroots.xml:27
#, xml-text
msgid "Introduction to wlroots"
msgstr "Introdução ao wlroots"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/lib/wlroots.xml:30
#, xml-text
msgid ""
"wlroots is a Wayland compositor library, the backbone of most Wayland "
"compositors. Compositors that use a different base may have used this "
"package in the beginning of the compositor's history for providing most of "
"the work."
msgstr ""
"wlroots é uma biblioteca de compositor Wayland e a base da maioria dos "
"compositores Wayland. Compositores que usem uma base diferente possivelmente"
" tenham usado esse pacote no início da estória do compositor para fornecer a"
" maior parte do trabalho."

