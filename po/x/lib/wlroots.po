msgstr "Instalação do wlroots"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/lib/wlroots.xml:162
#, xml-text
msgid "Install wlroots by running the following commands:"
msgstr "Instale wlroots executando os seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/x/lib/wlroots.xml:165
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr          \\\n"
"            --buildtype=release    \\\n"
"            --wrap-mode=nofallback \\\n"
"            .. &amp;&amp;\n"
"ninja</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr          \\\n"
"            --buildtype=release    \\\n"
"            --wrap-mode=nofallback \\\n"
"            .. &amp;&amp;\n"
"ninja</userinput>"

