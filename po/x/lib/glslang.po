#. type: Content of: <sect1><sect2><title>
#: blfs-en/x/lib/glslang.xml:79
#, xml-text
msgid "Installation of Glslang"
msgstr "Instalação do Glslang"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/lib/glslang.xml:82
#, xml-text
msgid ""
"Install <application>Glslang</application> by running the following "
"commands:"
msgstr ""
"Instale <application>Glslang</application> executando os seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/x/lib/glslang.xml:86
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr     \\\n"
"      -D CMAKE_BUILD_TYPE=Release      \\\n"
"      -D ALLOW_EXTERNAL_SPIRV_TOOLS=ON \\\n"
"      -D BUILD_SHARED_LIBS=ON          \\\n"
"      -D GLSLANG_TESTS=ON              \\\n"
"      -G Ninja .. &amp;&amp;\n"
"ninja</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr     \\\n"
"      -D CMAKE_BUILD_TYPE=Release      \\\n"
"      -D ALLOW_EXTERNAL_SPIRV_TOOLS=ON \\\n"
"      -D BUILD_SHARED_LIBS=ON          \\\n"
"      -D GLSLANG_TESTS=ON              \\\n"
"      -G Ninja .. &amp;&amp;\n"
"ninja</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/lib/glslang.xml:98
#, xml-text
msgid "To test the results, issue: <command>ninja test</command>."
msgstr "Para testar os resultados, emita: <command>ninja test</command>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/lib/glslang.xml:102
#, xml-text
msgid "Now, as the &root; user:"
msgstr "Agora, como o(a) usuário(a) &root;:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/x/lib/glslang.xml:105
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr "<userinput>ninja install</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/x/lib/glslang.xml:110
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/lib/glslang.xml:113
#, xml-text
msgid ""
"<parameter>-D ALLOW_EXTERNAL_SPIRV_TOOLS=ON</parameter>: This switch allows "
"the build system to use the system-installed copy of <xref linkend=\"spirv-"
"tools\" role=\"nodep\"/>, instead of downloading and installing it's own "
"copy."
msgstr ""
"<parameter>-D ALLOW_EXTERNAL_SPIRV_TOOLS=ON</parameter>: Essa chave permite "
"que o sistema de construção use a cópia instalada do sistema do <xref "
"linkend=\"spirv-tools\" role=\"nodep\"/>, em vez de baixar e instalar a "
"própria cópia dele."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/lib/glslang.xml:120
#, xml-text
msgid ""
"<parameter>-D BUILD_SHARED_LIBS=ON</parameter>: This switch builds shared "
"versions of the libraries, and does not install static versions of them."
msgstr ""
"<parameter>-D BUILD_SHARED_LIBS=ON</parameter>: Essa chave constrói versões "
"compartilhadas das bibliotecas e não instala versões estáticas delas."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/lib/glslang.xml:125
#, xml-text
msgid ""
"<parameter>-D GLSLANG_TESTS=ON</parameter>: This switch builds the tests for"
" the package."
msgstr ""
"<parameter>-D GLSLANG_TESTS=ON</parameter>: Essa chave constrói os testes "
"para o pacote."

