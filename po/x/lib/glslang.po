#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/lib/glslang.xml:28
#, xml-text
msgid ""
"The <application>Glslang</application> package contains an frontend and "
"validator for OpenGL, OpenGL ES, and Vulkan shaders."
msgstr ""
"O pacote <application>Glslang</application> contém uma estrutura de "
"interação direta com o(a) usante e um validador para sombreadores OpenGL, "
"OpenGL ES e Vulkan."

