#. type: Content of: <sect1><sect2><title>
#: blfs-en/x/lib/qt6.xml:406
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/lib/qt6.xml:408
#, xml-text
msgid ""
"<parameter>-nomake examples</parameter>: This switch disables building of "
"the example programs included in the source tarball. Remove it if you want "
"to build them."
msgstr ""
"<parameter>-nomake examples</parameter>: Essa chave desabilita construir os "
"programas de exemplo incluídos no tarball do fonte. Remova-a se você quiser "
"construí-los."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/lib/qt6.xml:415
#, xml-text
msgid ""
"<parameter>-skip qt3d</parameter>: This switch disables building qt3d "
"support. There is a problem building these files without an external library"
" and no packages in BLFS use qt3d."
msgstr ""
"<parameter>-skip qt3d</parameter>: Essa chave desabilita construir suporte "
"ao qt3d. Existe um problema ao construir esses arquivos sem uma biblioteca "
"externa e nenhum pacote no BLFS usa qt3d."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/lib/qt6.xml:422
#, xml-text
msgid ""
"<parameter>-system-sqlite</parameter>: This switch enables use of the system"
" version of <application>SQLite</application>."
msgstr ""
"<parameter>-system-sqlite</parameter>: Essa chave habilita uso da versão do "
"sistema do <application>SQLite</application>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/lib/qt6.xml:427
#, xml-text
msgid ""
"<parameter>-dbus-linked</parameter> <parameter>-openssl-linked</parameter>: "
"These switches enable explicit linking of the "
"<application>D-Bus</application> and <application>OpenSSL</application> "
"libraries into <application>Qt6</application> libraries instead of "
"<command>dlopen()</command>-ing them."
msgstr ""
"<parameter>-dbus-linked</parameter> <parameter>-openssl-linked</parameter>: "
"Essas chaves habilitam vinculação explícita das bibliotecas "
"<application>D-Bus</application> e <application>OpenSSL</application> nas "
"bibliotecas do <application>Qt6</application> em vez de abri-las com "
"<command>dlopen()</command>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/lib/qt6.xml:437
#, xml-text
msgid ""
"<parameter>-syslog</parameter>: This switch allows sending Qt messages to "
"the <command>syslog</command> logging system."
msgstr ""
"<parameter>-syslog</parameter>: Essa chave permite enviar mensagens do QT "
"para o sistema de registro <command>syslog</command>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/lib/qt6.xml:442
#, xml-text
msgid ""
"<parameter>-journald</parameter>: This switch allows sending Qt messages to "
"the <command>journald</command> logging system."
msgstr ""
"<parameter>-journald</parameter>: Essa chave permite enviar mensagens do QT "
"para o sistema de registro <command>journald</command>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/lib/qt6.xml:447
#, xml-text
msgid ""
"<parameter>-skip qtwebengine</parameter>: This switch disables building the "
"QtWebEngine. The BLFS editors have chosen to build <xref "
"linkend=\"qtwebengine\"/> separately."
msgstr ""
"<parameter>-skip qtwebengine</parameter>: Essa chave desabilita construir o "
"QtWebEngine. Os(As) editores(as) do BLFS optaram por construir <xref "
"linkend=\"qtwebengine\"/> separadamente."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/lib/qt6.xml:453
#, xml-text
msgid ""
"<parameter>-skip qtquick3dphysics</parameter>: This switch disables building"
" the Qt Quick 3D Physics submodule. On 32-bit systems, this will cause the "
"build process to fail with an inlining error in Qt6's bundled copy of the "
"PhysX SDK."
msgstr ""
"<parameter>-skip qtquick3dphysics</parameter>: Essa chave desabilita "
"construir o submódulo Quick 3D Physics do Qt. Em sistemas de 32 bits, isso "
"fará com que o processo de construção falhe com um erro embutido na cópia "
"agrupada do SDK PhysX do Qt6."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/lib/qt6.xml:460
#, xml-text
msgid ""
"<option>-libproxy</option>: This switch enables the usage of libproxy for "
"determining proxy server information."
msgstr ""
"<option>-libproxy</option>: Essa chave permite o uso da libproxy para "
"determinar informações de proxy do servidor."

#. type: Content of: <sect1><sect2><title>
#: blfs-en/x/lib/qt6.xml:467
#, xml-text
msgid "Configuring Qt6"
msgstr "Configurando Qt6"

#. type: Content of: <sect1><sect2><sect3><title>
#: blfs-en/x/lib/qt6.xml:470
#, xml-text
msgid "Configuration Information"
msgstr "Informação de Configuração"

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/x/lib/qt6.xml:473
#, xml-text
msgid ""
"If <xref linkend=\"sudo\"/> is installed, QT6DIR should be available to the "
"super user as well. Execute the following commands as the &root; user:"
msgstr ""
"Se <xref linkend=\"sudo\"/> estiver instalado, QT6DIR também deveria estar "
"disponível para o(a) superusuário(a). Execute os seguintes comandos como "
"o(a) usuário(a) &root;:"

#. type: Content of: <sect1><sect2><sect3><screen>
#: blfs-en/x/lib/qt6.xml:478
#, no-wrap, xml-text
msgid ""
"<userinput>cat &gt; /etc/sudoers.d/qt &lt;&lt; \"EOF\"\n"
"<literal>Defaults env_keep += QT6DIR</literal>\n"
"EOF</userinput>"
msgstr ""
"<userinput>cat &gt; /etc/sudoers.d/qt &lt;&lt; \"EOF\"\n"
"<literal>Defaults env_keep += QT6DIR</literal>\n"
"EOF</userinput>"

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/x/lib/qt6.xml:483
#, xml-text
msgid ""
"You now need to update the following configuration files so that "
"<application>Qt6</application> is correctly found by other packages and "
"system processes."
msgstr ""
"Agora você precisa atualizar os seguintes arquivos de configuração, de forma"
" que o <application>Qt6</application> seja encontrado corretamente por "
"outros pacotes e processos do sistema."

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/x/lib/qt6.xml:489
#, xml-text
msgid ""
"As the &root; user, update the <filename>/etc/ld.so.conf</filename> file and"
" the dynamic linker's run-time cache file:"
msgstr ""
"Como o(a) usuário(a) &root;, atualize o arquivo "
"<filename>/etc/ld.so.conf</filename> e o arquivo de cache de tempo de "
"execução do vinculador dinâmico:"

#. type: Content of: <sect1><sect2><sect3><screen>
#: blfs-en/x/lib/qt6.xml:494
#, no-wrap, xml-text
msgid ""
"<userinput>cat &gt;&gt; /etc/ld.so.conf &lt;&lt; EOF\n"
"<literal># Begin Qt addition\n"
"\n"
"/opt/qt6/lib\n"
"\n"
"# End Qt addition</literal>\n"
"EOF\n"
"\n"
"ldconfig</userinput>"
msgstr ""
"<userinput>cat &gt;&gt; /etc/ld.so.conf &lt;&lt; EOF\n"
"<literal># Inicia adição do Qt\n"
"\n"
"/opt/qt6/lib\n"
"\n"
"# Termina adição do Qt</literal>\n"
"EOF\n"
"\n"
"ldconfig</userinput>"

#. type: Content of: <sect1><sect2><sect3><indexterm><primary>
#: blfs-en/x/lib/qt6.xml:505
#, xml-text
msgid "/etc/ld.so.conf"
msgstr "/etc/ld.so.conf"

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/x/lib/qt6.xml:509
#, xml-text
msgid ""
"As the &root; user, create the <filename>/etc/profile.d/qt6.sh</filename> "
"file:"
msgstr ""
"Como o(a) usuário(a) &root;, crie o arquivo "
"<filename>/etc/profile.d/qt6.sh</filename>:"

#. type: Content of: <sect1><sect2><sect3><screen>
#: blfs-en/x/lib/qt6.xml:513
#, no-wrap, xml-text
msgid ""
"<userinput>cat &gt; /etc/profile.d/qt6.sh &lt;&lt; \"EOF\"\n"
"<literal># Begin /etc/profile.d/qt6.sh\n"
"\n"
"QT6DIR=/opt/qt6\n"
"\n"
"pathappend $QT6DIR/bin           PATH\n"
"pathappend $QT6DIR/lib/pkgconfig PKG_CONFIG_PATH\n"
"\n"
"export QT6DIR\n"
"\n"
"# End /etc/profile.d/qt6.sh</literal>\n"
"EOF</userinput>"
msgstr ""
"<userinput>cat &gt; /etc/profile.d/qt6.sh &lt;&lt; \"EOF\"\n"
"<literal># Inicia /etc/profile.d/qt6.sh\n"
"\n"
"QT6DIR=/opt/qt6\n"
"\n"
"pathappend $QT6DIR/bin           PATH\n"
"pathappend $QT6DIR/lib/pkgconfig PKG_CONFIG_PATH\n"
"\n"
"export QT6DIR\n"
"\n"
"# Termina /etc/profile.d/qt6.sh</literal>\n"
"EOF</userinput>"

