#. type: Content of: <sect1><sect2><title>
#: blfs-en/x/lib/qtwebengine.xml:184
#, xml-text
msgid "Installation of qtwebengine"
msgstr "Instalação do qtwebengine"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/lib/qtwebengine.xml:188
#, xml-text
msgid "First, make a fix to be compatible with glibc-2.43 and later:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/x/lib/qtwebengine.xml:191
#, no-wrap, xml-text
msgid ""
"<userinput>sed -e '/ifndef SYS_SECCOMP/,+2 d' \\\n"
"    -i src/3rdparty/chromium/sandbox/linux/system_headers/linux_seccomp.h</userinput>"
msgstr ""
"<userinput>sed -e '/ifndef SYS_SECCOMP/,+2 d' \\\n"
"    -i src/3rdparty/chromium/sandbox/linux/system_headers/linux_seccomp.h</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/lib/qtwebengine.xml:195
#, xml-text
msgid ""
"Install <application>qtwebengine</application> by running the following "
"commands:"
msgstr ""
"Instale o &quot;<application>qtwebengine</application>&quot; executando os "
"seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/x/lib/qtwebengine.xml:199
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_MESSAGE_LOG_LEVEL=STATUS             \\\n"
"      -D QT_FEATURE_webengine_system_ffmpeg=ON      \\\n"
"      -D QT_FEATURE_webengine_system_icu=ON         \\\n"
"      -D QT_FEATURE_webengine_system_libevent=ON    \\\n"
"      -D QT_FEATURE_webengine_proprietary_codecs=ON \\\n"
"      -D QT_FEATURE_webengine_webrtc_pipewire=ON    \\\n"
"      -D QT_BUILD_EXAMPLES_BY_DEFAULT=OFF           \\\n"
"      -D QT_GENERATE_SBOM=OFF                       \\\n"
"      -G Ninja ..                                   &amp;&amp;\n"
"ninja</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_MESSAGE_LOG_LEVEL=STATUS             \\\n"
"      -D QT_FEATURE_webengine_system_ffmpeg=ON      \\\n"
"      -D QT_FEATURE_webengine_system_icu=ON         \\\n"
"      -D QT_FEATURE_webengine_system_libevent=ON    \\\n"
"      -D QT_FEATURE_webengine_proprietary_codecs=ON \\\n"
"      -D QT_FEATURE_webengine_webrtc_pipewire=ON    \\\n"
"      -D QT_BUILD_EXAMPLES_BY_DEFAULT=OFF           \\\n"
"      -D QT_GENERATE_SBOM=OFF                       \\\n"
"      -G Ninja ..                                   &amp;&amp;\n"
"ninja</userinput>"

