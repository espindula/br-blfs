#. type: Content of: <sect1><sect2><title>
#: blfs-en/x/lib/libnotify.xml:114
#, xml-text
msgid "Installation of libnotify"
msgstr "Instalação do libnotify"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/lib/libnotify.xml:117
#, xml-text
msgid ""
"Install <application>libnotify</application> by running the following "
"commands:"
msgstr ""
"Instale o &quot;<application>libnotify</application>&quot; executando os "
"seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/x/lib/libnotify.xml:121
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr       \\\n"
"            --buildtype=release \\\n"
"            -D gtk_doc=false    \\\n"
"            -D man=false        \\\n"
"            ..                  &amp;&amp;\n"
"ninja</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr       \\\n"
"            --buildtype=release \\\n"
"            -D gtk_doc=false    \\\n"
"            -D man=false        \\\n"
"            ..                  &amp;&amp;\n"
"ninja</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/lib/libnotify.xml:132
#, xml-text
msgid "To test the results, issue: <command>ninja test</command>"
msgstr "Para testar os resultados, emita: <command>ninja test</command>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/lib/libnotify.xml:136
#, xml-text
msgid ""
"If you have <xref linkend='gi-docgen'/> installed and wish to build the API "
"documentation for this package, issue:"
msgstr ""
"Se você tiver <xref linkend='gi-docgen'/> instalado e desejar construir a "
"documentação da API para esse pacote, emita:"

#.  No &libnotify-version; here because we'll mv the doc dir anyway
#. type: Content of: <sect1><sect2><screen>
#: blfs-en/x/lib/libnotify.xml:141
#, no-wrap, xml-text
msgid ""
"<userinput>sed \"/docs_dir =/s@\\$@ / 'libnotify'@\" \\\n"
"    -i ../docs/reference/meson.build   &amp;&amp;\n"
"meson configure -D gtk_doc=true        &amp;&amp;\n"
"ninja</userinput>"
msgstr ""
"<userinput>sed \"/docs_dir =/s@\\$@ / 'libnotify'@\" \\\n"
"    -i ../docs/reference/meson.build   &amp;&amp;\n"
"meson configure -D gtk_doc=true        &amp;&amp;\n"
"ninja</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/lib/libnotify.xml:147
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) &quot;<systemitem "
"class=\"username\">root</systemitem>&quot;:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/x/lib/libnotify.xml:150
#, no-wrap, xml-text
msgid ""
"<userinput>ninja install &amp;&amp;\n"
"if [ -e /usr/share/doc/libnotify ]; then\n"
"  rm -rf /usr/share/doc/libnotify-&libnotify-version;\n"
"  mv -v  /usr/share/doc/libnotify{,-&libnotify-version;}\n"
"fi</userinput>"
msgstr ""
"<userinput>ninja install &amp;&amp;\n"
"if [ -e /usr/share/doc/libnotify ]; then\n"
"  rm -rf /usr/share/doc/libnotify-&libnotify-version;\n"
"  mv -v  /usr/share/doc/libnotify{,-&libnotify-version;}\n"
"fi</userinput>"

