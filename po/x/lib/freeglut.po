#. type: Content of: <sect1><sect2><title>
#: blfs-en/x/lib/freeglut.xml:89
#, xml-text
msgid "Installation of Freeglut"
msgstr "Instalação do Freeglut"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/lib/freeglut.xml:92
#, xml-text
msgid ""
"Install <application>Freeglut</application> by running the following "
"commands:"
msgstr ""
"Instale o &quot;<application>Freeglut</application>&quot; executando os "
"seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/x/lib/freeglut.xml:96
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr        \\\n"
"      -D CMAKE_BUILD_TYPE=Release         \\\n"
"      -D FREEGLUT_BUILD_DEMOS=OFF         \\\n"
"      -D FREEGLUT_BUILD_STATIC_LIBS=OFF   \\\n"
"      -W no-author .. &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr        \\\n"
"      -D CMAKE_BUILD_TYPE=Release         \\\n"
"      -D FREEGLUT_BUILD_DEMOS=OFF         \\\n"
"      -D FREEGLUT_BUILD_STATIC_LIBS=OFF   \\\n"
"      -W no-author .. &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/lib/freeglut.xml:107
#, xml-text
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/lib/freeglut.xml:111
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr "Agora, como o(a) usante <systemitem class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/x/lib/freeglut.xml:115
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/x/lib/freeglut.xml:120
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/lib/freeglut.xml:123
#, xml-text
msgid ""
"<parameter>-D FREEGLUT_BUILD_DEMOS=OFF</parameter>: Disable building "
"optional demo programs.  Note that if you choose to build them, their "
"installation must be done manually.  The demo programs are limited and "
"installation is not recommended."
msgstr ""
"<parameter>-D FREEGLUT_BUILD_DEMOS=OFF</parameter>: Desabilita construir "
"aplicativos opcionais de demonstração. Observe que, se você optar por "
"construí-los, a instalação deles precisa ser feita manualmente. Os "
"aplicativos de demonstração são limitados e a instalação não é recomendada."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/lib/freeglut.xml:130
#, xml-text
msgid ""
"<parameter>-D FREEGLUT_BUILD_STATIC_LIBS=OFF</parameter>: Do not build the "
"static library."
msgstr ""
"<parameter>-D FREEGLUT_BUILD_STATIC_LIBS=OFF</parameter>: Não construa a "
"biblioteca estática."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/lib/freeglut.xml:135
#, xml-text
msgid ""
"<option>-D FREEGLUT_GLES=ON</option>: This option makes FreeGLUT use OpenGL "
"ES instead of normal OpenGL. Use this if you have not installed <xref "
"linkend=\"glu\"/>."
msgstr ""
"<option>-D FREEGLUT_GLES=ON</option>: Essa opção induz FreeGLUT a usar "
"OpenGL ES em vez do normal OpenGL. Use isso se você não tiver instalado "
"<xref linkend=\"glu\"/>."

