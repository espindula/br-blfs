#: blfs-en/x/lib/gtk+3.xml:218
#, xml-text
msgid "~/.config/gtk-3.0/settings.ini"
msgstr "~/.config/gtk-3.0/settings.ini"

#. type: Content of: <sect1><sect2><sect3><indexterm><primary>
