#. type: Content of: <sect1><sect2><title>
#: blfs-en/x/lib/glu.xml:86
#, xml-text
msgid "Installation of GLU"
msgstr "Instalação do GLU"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/lib/glu.xml:89
#, xml-text
msgid ""
"Install <application>GLU</application> by running the following commands:"
msgstr ""
"Instale o &quot;<application>GLU</application>&quot; executando os seguintes"
" comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/x/lib/glu.xml:93
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup ..              \\\n"
"      --prefix=$XORG_PREFIX \\\n"
"      --buildtype=release   \\\n"
"      -D gl_provider=gl     \\\n"
"      -D default_library=shared &amp;&amp;\n"
"ninja</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup ..              \\\n"
"      --prefix=$XORG_PREFIX \\\n"
"      --buildtype=release   \\\n"
"      -D gl_provider=gl     \\\n"
"      -D default_library=shared &amp;&amp;\n"
"ninja</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/lib/glu.xml:104
#, xml-text
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/lib/glu.xml:108
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) &quot;<systemitem "
"class=\"username\">root</systemitem>&quot;:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/x/lib/glu.xml:111
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr "<userinput>ninja install</userinput>"

