msgstr "Transferência (HTTP): <ulink url=\"&keybinder2-download-http;\"/>"

#. type: Content of: <sect1><sect2><itemizedlist><listitem><para>
#: blfs-en/x/lib/keybinder2.xml:46
msgid "Download (FTP): <ulink url=\"&keybinder2-download-ftp;\"/>"
msgstr "Transferência (FTP): <ulink url=\"&keybinder2-download-ftp;\"/>"

#. type: Content of: <sect1><sect2><itemizedlist><listitem><para>
#: blfs-en/x/lib/keybinder2.xml:51
msgid "Download MD5 sum: &keybinder2-md5sum;"
msgstr "Soma de verificação MD5 da transferência: &keybinder2-md5sum;"

#. type: Content of: <sect1><sect2><itemizedlist><listitem><para>
#: blfs-en/x/lib/keybinder2.xml:56
msgid "Download size: &keybinder2-size;"
msgstr "Tamanho da transferência: &keybinder2-size;"

#. type: Content of: <sect1><sect2><itemizedlist><listitem><para>
#: blfs-en/x/lib/keybinder2.xml:61
msgid "Estimated disk space required: &keybinder2-buildsize;"
msgstr "Espaço em disco estimado exigido: &keybinder2-buildsize;"

#. type: Content of: <sect1><sect2><itemizedlist><listitem><para>
#: blfs-en/x/lib/keybinder2.xml:66
msgid "Estimated build time: &keybinder2-time;"
msgstr "Tempo de construção estimado: &keybinder2-time;"

#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/x/lib/keybinder2.xml:71
msgid "keybinder Dependencies"
msgstr "Dependências do &quot;keybinder&quot;"

#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/x/lib/keybinder2.xml:73
msgid "Required"
msgstr "Exigidas"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/lib/keybinder2.xml:75
msgid "<xref linkend=\"gtk2\"/>"
msgstr "<xref linkend=\"gtk2\"/>"

#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/x/lib/keybinder2.xml:78
msgid "Recommended"
msgstr "Recomendadas"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/lib/keybinder2.xml:80
msgid "<xref linkend=\"gobject-introspection\"/> and <xref linkend=\"pygtk\"/>"
msgstr "<xref linkend=\"gobject-introspection\"/> e <xref linkend=\"pygtk\"/>"

#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/x/lib/keybinder2.xml:84
msgid "Optional"
msgstr "Opcionais"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/lib/keybinder2.xml:86
msgid ""
"<xref linkend=\"gtk-doc\"/> and <xref linkend=\"lua\"/> (currently broken "
"because an older lua version is required)"
msgstr ""
"<xref linkend=\"gtk-doc\"/> e <xref linkend=\"lua\"/> (atualmente quebrado "
"porque uma versão mais antiga do &quot;Lua&quot; é exigida)"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/x/lib/keybinder2.xml:94
msgid "Installation of keybinder"
msgstr "Instalação do <quote>keybinder</quote>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/lib/keybinder2.xml:97
msgid ""
"Install <application>keybinder</application> by running the following "
"commands:"
msgstr ""
"Instale o &quot;<application>keybinder</application>&quot; executando os "
"seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/x/lib/keybinder2.xml:101
#, no-wrap
msgid ""
"<userinput>./configure --prefix=/usr --disable-lua &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>./configure --prefix=/usr --disable-lua &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/lib/keybinder2.xml:105
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/lib/keybinder2.xml:109
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/x/lib/keybinder2.xml:112
#, no-wrap
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/x/lib/keybinder2.xml:117
msgid "Command Explanations"
msgstr "Explicações dos Comandos"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/lib/keybinder2.xml:120
msgid ""
"<parameter>--disable-lua</parameter>: Use this switch to disable <xref "
"linkend=\"lua\"/> bindings (currently broken, because older lua version is "
"required)."
msgstr ""
"<parameter>--disable-lua</parameter>: Use essa chave para desabilitar "
"vinculações do &quot;<xref linkend=\"lua\"/>&quot; (atualmente quebradas, "
"porque uma versão mais antiga do &quot;Lua&quot; é exigida)."

