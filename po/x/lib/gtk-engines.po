#. type: Content of: <sect1><sect2><title>
#: blfs-en/x/lib/gtk-engines.xml:87
#, xml-text
msgid "Installation of GTK Engines"
msgstr "Instalação dos Mecanismos do GTK"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/lib/gtk-engines.xml:90
#, xml-text
msgid ""
"Install <application>GTK Engines</application> by running the following "
"commands:"
msgstr ""
"Instale os <application>Motores do &quot;GTK&quot;</application> executando "
"os seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/x/lib/gtk-engines.xml:94
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>./configure --prefix=/usr &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/lib/gtk-engines.xml:98
#, xml-text
msgid "To test the results, issue: <command>make check</command>."
msgstr "Para testar os resultados, emita: <command>make check</command>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/lib/gtk-engines.xml:102
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) &quot;<systemitem "
"class=\"username\">root</systemitem>&quot;:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/x/lib/gtk-engines.xml:105
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/x/lib/gtk-engines.xml:109
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/lib/gtk-engines.xml:112
#, xml-text
msgid ""
"<option>--enable-lua --with-system-lua</option>: Use these switches if you "
"installed <application>Lua</application> and want to build Lua theming "
"engine."
msgstr ""
"<option>--enable-lua --with-system-lua</option>: Use essas chaves se você "
"instalou o &quot;<application>Lua</application>&quot; e quer construir o "
"mecanismo de temas do &quot;Lua&quot;."

