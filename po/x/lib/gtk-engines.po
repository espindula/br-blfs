#. type: Content of: <sect1><sect2><title>
#: blfs-en/x/lib/gtk-engines.xml:27
#, xml-text
msgid "Introduction to GTK Engines"
msgstr "Introdução aos Mecanismos do GTK"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/lib/gtk-engines.xml:30
#, xml-text
msgid ""
"The <application>GTK Engines</application> package contains eight "
"themes/engines and two additional engines for "
"<application>GTK2</application>."
msgstr ""
"O pacote &quot;<application>GTK Engines</application>&quot; contém oito "
"temas/mecanismos e dois motores adicionais para o "
"&quot;<application>GTK2</application>&quot;."

