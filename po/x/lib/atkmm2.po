#, xml-text
msgid "Introduction to Atkmm"
msgstr "Introdução ao Atkmm"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/lib/atkmm2.xml:29
#, xml-text
msgid ""
"<application>Atkmm</application> is the official C++ interface for the ATK "
"accessibility toolkit library. This version is part of a new API for "
"supporting gtkmm-4."
msgstr ""
"<application>Atkmm</application> é a interface C++ oficial para a biblioteca"
" do kit de ferramentas de acessibilidade ATK. Essa versão é parte de uma "
"nova API para suporte ao gtkmm-4."

