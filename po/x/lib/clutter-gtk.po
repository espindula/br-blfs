#. type: Content of: <sect1><sect2><title>
#: blfs-en/x/lib/clutter-gtk.xml:28
msgid "Introduction to Clutter Gtk"
msgstr "Introdução ao <quote>Clutter Gtk</quote>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/lib/clutter-gtk.xml:31
msgid ""
"The <application>Clutter Gtk</application> package is a library providing "
"facilities to integrate <application>Clutter</application> into "
"<application>GTK+</application> applications."
msgstr ""
"O pacote &quot;<application>Clutter Gtk</application>&quot; é uma biblioteca"
" que fornece facilidades para integrar o "
"&quot;<application>Clutter</application>&quot; em aplicações "
"&quot;<application>GTK+</application>&quot;."

