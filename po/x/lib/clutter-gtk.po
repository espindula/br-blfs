#. type: Content of: <sect1><sect2><title>
#: blfs-en/x/lib/clutter-gtk.xml:93
msgid "Installation of Clutter Gtk"
msgstr "Instalação do <quote>Clutter Gtk</quote>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/lib/clutter-gtk.xml:96
msgid ""
"Install <application>Clutter Gtk</application> by running the following "
"commands:"
msgstr ""
"Instale o &quot;<application>Clutter Gtk</application>&quot; executando os "
"seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/x/lib/clutter-gtk.xml:100
#, no-wrap
msgid ""
"<userinput>./configure --prefix=/usr &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>./configure --prefix=/usr &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/lib/clutter-gtk.xml:104
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/lib/clutter-gtk.xml:108
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/x/lib/clutter-gtk.xml:111
#, no-wrap
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

