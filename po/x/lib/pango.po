#. type: Content of: <sect1><sect2><title>
#: blfs-en/x/lib/pango.xml:101
#, xml-text
msgid "Installation of Pango"
msgstr "Instalação do Pango"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/lib/pango.xml:104
#, xml-text
msgid ""
"Install <application>Pango</application> by running the following commands:"
msgstr ""
"Instale o &quot;<application>Pango</application>&quot; executando os "
"seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/x/lib/pango.xml:108
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr            \\\n"
"            --buildtype=release      \\\n"
"            --wrap-mode=nofallback   \\\n"
"            -D introspection=enabled \\\n"
"            ..                       &amp;&amp;\n"
"ninja</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr            \\\n"
"            --buildtype=release      \\\n"
"            --wrap-mode=nofallback   \\\n"
"            -D introspection=enabled \\\n"
"            ..                       &amp;&amp;\n"
"ninja</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/lib/pango.xml:119
#, xml-text
msgid ""
"If you have <xref linkend='gi-docgen'/> installed and wish to build the API "
"documentation for this package, issue:"
msgstr ""
"Se você tiver <xref linkend='gi-docgen'/> instalado e desejar construir a "
"documentação da API para esse pacote, emita:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/x/lib/pango.xml:123
#, no-wrap, xml-text
msgid ""
"<userinput>sed \"/docs_dir =/s@\\$@ / 'pango-&pango-version;'@\" -i ../docs/meson.build &amp;&amp;\n"
"meson configure -D documentation=true                            &amp;&amp;\n"
"ninja</userinput>"
msgstr ""
"<userinput>sed \"/docs_dir =/s@\\$@ / 'pango-&pango-version;'@\" -i ../docs/meson.build &amp;&amp;\n"
"meson configure -D documentation=true                            &amp;&amp;\n"
"ninja</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/lib/pango.xml:128
#, xml-text
msgid "To test the results, issue: <command>ninja test</command>."
msgstr "Para testar os resultados, emita: <command>ninja test</command>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/lib/pango.xml:132
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) &quot;<systemitem "
"class=\"username\">root</systemitem>&quot;:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/x/lib/pango.xml:135
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr "<userinput>ninja install</userinput>"

