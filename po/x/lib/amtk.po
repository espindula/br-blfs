#. type: Content of: <sect1><sect2><title>
#: blfs-en/x/lib/amtk.xml:88
msgid "Installation of Amtk"
msgstr "Instalação do <quote>Amtk</quote>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/lib/amtk.xml:91
msgid ""
"Install <application>Amtk</application> by running the following commands:"
msgstr ""
"Instale o &quot;<application>Amtk</application>&quot; executando os "
"seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/x/lib/amtk.xml:95
#, no-wrap
msgid ""
"<userinput>mkdir amtk-build &amp;&amp;\n"
"cd    amtk-build &amp;&amp;\n"
"\n"
"meson --prefix=/usr --buildtype=release -Dgtk_doc=false .. &amp;&amp;\n"
"ninja</userinput>"
msgstr ""
"<userinput>mkdir amtk-build &amp;&amp;\n"
"cd     amtk-build &amp;&amp;\n"
"\n"
"meson --prefix=/usr --buildtype=release -Dgtk_doc=false .. &amp;&amp;\n"
"ninja</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/lib/amtk.xml:102
msgid "To test the results, issue: <command>ninja test</command>."
msgstr "Para testar os resultados, emita: <command>ninja test</command>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/lib/amtk.xml:106
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/x/lib/amtk.xml:109
#, no-wrap
msgid "<userinput>ninja install</userinput>"
msgstr "<userinput>ninja install</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/x/lib/amtk.xml:113
msgid "Command Explanations"
msgstr "Explicações dos Comandos"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/lib/amtk.xml:119
msgid ""
"<parameter>-Dgtk_doc=false</parameter>: This switch prevents the build "
"system from generating and installing the API documentation. Omit this "
"switch if you have <xref linkend=\"gtk-doc\" role=\"nodep\"/> installed and "
"wish to generate and install the API documentation."
msgstr ""
"<parameter>-Dgtk_doc=false</parameter>: Essa chave impede que o sistema de "
"construção gere e instale a documentação da &quot;API&quot;. Omita essa "
"chave se você tiver o &quot;<xref linkend=\"gtk-doc\" role=\"nodep\"/>&quot;"
" instalado e desejar gerar e instalar a documentação da &quot;API&quot;."

