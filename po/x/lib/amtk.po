#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/lib/amtk.xml:29
msgid ""
"The <application>Amtk</application> package contains a basic GTKUIManager "
"replacement based on GAction."
msgstr ""
"O pacote &quot;<application>Amtk</application>&quot; contém uma substituição"
" básica do &quot;GTKUIManager&quot; baseada no &quot;GAction&quot;."

