#. type: Content of: <sect1><sect2><title>
#: blfs-en/x/icons/breeze-icons.xml:88
#, xml-text
msgid "Installation of Breeze Icons"
msgstr "Instalação do Ícones Breeze"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/icons/breeze-icons.xml:91
#, xml-text
msgid ""
"Install <application>Breeze Icons</application> by running the following "
"commands:"
msgstr ""
"Instale o &quot;<application>Ícones Breeze</application>&quot; executando os"
" seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/x/icons/breeze-icons.xml:95
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr \\\n"
"      -D BUILD_TESTING=OFF         \\\n"
"      -D WITH_ICON_GENERATION=OFF  \\\n"
"      -W no-author ..              &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr \\\n"
"      -D BUILD_TESTING=OFF         \\\n"
"      -D WITH_ICON_GENERATION=OFF  \\\n"
"      -W no-author ..              &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/icons/breeze-icons.xml:105
#, xml-text
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/icons/breeze-icons.xml:109
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr "Agora, como o(a) usante <systemitem class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/x/icons/breeze-icons.xml:112
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/x/icons/breeze-icons.xml:117
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/icons/breeze-icons.xml:120
#, xml-text
msgid ""
"<parameter>-D BUILD_TESTING=OFF</parameter>: This parameter disables "
"building the testing framework, which requires some modules from <xref "
"linkend=\"kf6-frameworks\"/>."
msgstr ""
"<parameter>-D BUILD_TESTING=OFF</parameter>: Esse parâmetro desabilita "
"construir a estrutura essencial de suporte de testes, a qual exige alguns "
"módulos originários do <xref linkend=\"kf6-frameworks\"/>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/icons/breeze-icons.xml:126
#, xml-text
msgid ""
"<parameter>-D WITH_ICON_GENERATION=OFF</parameter>: This parameter disables "
"generation of 24x24 dark icons, which requires the <xref linkend=\"lxml\"/> "
"python module. This parameter can be removed if <xref linkend=\"lxml\"/> is "
"installed."
msgstr ""
"<parameter>-D WITH_ICON_GENERATION=OFF</parameter>: Esse parâmetro "
"desabilita a geração de ícones escuros 24x24, os quais exigem o módulo "
"python <xref linkend=\"lxml\"/>. Esse parâmetro pode ser removido se <xref "
"linkend=\"lxml\"/> estiver instalado."

