#. type: Content of: <sect1><sect2><title>
#: blfs-en/x/icons/breeze-icons.xml:26
#, xml-text
msgid "Introduction to Breeze Icons"
msgstr "Introdução ao Ícones Breeze"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/icons/breeze-icons.xml:29
#, xml-text
msgid ""
"The <application>Breeze Icons</application> package contains the default "
"icons for <application>KDE Plasma</application> applications, but it can be "
"used for other window environments."
msgstr ""
"O pacote <application>Ícones Breeze</application> contém os ícones padrão "
"para aplicativos <application>KDE Plasma</application>, mas pode ser usado "
"para outros ambientes de janela."

