#. type: Content of: <sect1><sect2><title>
#: blfs-en/x/icons/gnome-icon-theme.xml:82
#, xml-text
msgid "Installation of GNOME Icon Theme"
msgstr "Instalação do Tema de Ícones do GNOME"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/icons/gnome-icon-theme.xml:85
#, xml-text
msgid ""
"Install <application>GNOME Icon Theme</application> by running the following"
" commands:"
msgstr ""
"Instale o &quot;<application>Tema de Ícone do GNOME</application>&quot; "
"executando os seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/x/icons/gnome-icon-theme.xml:89
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>./configure --prefix=/usr &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/icons/gnome-icon-theme.xml:93
#, xml-text
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/icons/gnome-icon-theme.xml:97
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) &quot;<systemitem "
"class=\"username\">root</systemitem>&quot;:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/x/icons/gnome-icon-theme.xml:100
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

