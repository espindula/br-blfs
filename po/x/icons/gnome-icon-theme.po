#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/icons/gnome-icon-theme.xml:30
#, xml-text
msgid ""
"The <application>GNOME Icon Theme</application> package contains an "
"assortment of non-scalable icons of different sizes and themes."
msgstr ""
"O pacote &quot;<application>Tema de Ícone do GNOME</application>&quot; "
"contém uma variedade de ícones não escaláveis de diferentes tamanhos e "
"temas."

