#. type: Content of: <sect1><sect2><title>
#: blfs-en/x/icons/gnome-themes-extra.xml:83
#, xml-text
msgid "Installation of GNOME Themes Extra"
msgstr "Instalação do Extra dos Temas do GNOME"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/icons/gnome-themes-extra.xml:86
#, xml-text
msgid ""
"Install <application>GNOME Themes Extra</application> by running the "
"following commands:"
msgstr ""
"Instale o &quot;<application>Extra dos Temas do GNOME</application>&quot; "
"executando os seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/x/icons/gnome-themes-extra.xml:90
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr --disable-gtk2-engine &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>./configure --prefix=/usr --disable-gtk2-engine &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/icons/gnome-themes-extra.xml:94
#, xml-text
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/icons/gnome-themes-extra.xml:98
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr "Agora, como o(a) usante <systemitem class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/x/icons/gnome-themes-extra.xml:101
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/x/icons/gnome-themes-extra.xml:106
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/icons/gnome-themes-extra.xml:109
#, xml-text
msgid ""
"<parameter>--disable-gtk2-engine</parameter>: This switch disables the "
"GTK+-2 theming engine because GTK+-2 is no longer part of BLFS."
msgstr ""
"<parameter>--disable-gtk2-engine</parameter>: Essa chave desabilita o "
"mecanismo de tema do GTK+-2 porque GTK+-2 não mais é parte do BLFS."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/x/icons/gnome-themes-extra.xml:114
#, xml-text
msgid ""
"<option>--disable-gtk3-engine</option>: This switch disables the GTK+-3 "
"theming engine."
msgstr ""
"<option>--disable-gtk3-engine</option>: Essa chave desabilita o mecanismo de"
" tema do &quot;GTK+-3&quot;."

