#, xml-text
msgid "Installation of Dovecot"
msgstr "Instalação do Dovecot"

#. type: Content of: <sect1><sect2><warning><para>
#: blfs-en/server/mail/dovecot.xml:124
#, xml-text
msgid ""
"There are significant changes in the configuration of this package that are "
"required when updating to Dovecot 2.4.0. Please review the documentation at "
"<ulink "
"url=\"https://doc.dovecot.org/2.4.0/installation/upgrade/2.3-to-2.4.html\">Dovecot"
" Upgrade Guide</ulink> before continuing if you are upgrading this package "
"from a previous version."
msgstr ""
"Existem mudanças significativas na configuração deste pacote que são "
"exigidas ao atualizar para o Dovecot 2.4.0. Por favor, revise a documentação"
" em <ulink "
"url=\"https://doc.dovecot.org/2.4.0/installation/upgrade/2.3-to-2.4.html\">Dovecot"
" Upgrade Guide</ulink> antes de continuar se você estiver atualizando este "
"pacote a partir de uma versão anterior."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/server/mail/dovecot.xml:134
#, xml-text
msgid ""
"There should be dedicated users and groups for unprivileged Dovecot "
"processes and for processing users' logins. Issue the following commands as "
"the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Deveria existir usantes e grupos dedicados(as) para processos "
"desprivilegiados do Dovecot e para processamento de logins de usantes. Emita"
" os seguintes comandos como o(a) usante <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/server/mail/dovecot.xml:139
#, no-wrap, xml-text
msgid ""
"<userinput>groupadd -g 42 dovecot &amp;&amp;\n"
"useradd -c \"Dovecot unprivileged user\" -d /dev/null -u 42 \\\n"
"        -g dovecot -s /bin/false dovecot &amp;&amp;\n"
"groupadd -g 43 dovenull &amp;&amp;\n"
"useradd -c \"Dovecot login user\" -d /dev/null -u 43 \\\n"
"        -g dovenull -s /bin/false dovenull</userinput>"
msgstr ""
"<userinput>groupadd -g 42 dovecot &amp;&amp;\n"
"useradd -c \"Dovecot unprivileged user\" -d /dev/null -u 42 \\\n"
"        -g dovecot -s /bin/false dovecot &amp;&amp;\n"
"groupadd -g 43 dovenull &amp;&amp;\n"
"useradd -c \"Dovecot login user\" -d /dev/null -u 43 \\\n"
"        -g dovenull -s /bin/false dovenull</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/server/mail/dovecot.xml:147
#, xml-text
msgid ""
"Install <application>Dovecot</application> by running the following "
"commands:"
msgstr ""
"Instale o &quot;<application>Dovecot</application>&quot; executando os "
"seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/server/mail/dovecot.xml:151
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr                          \\\n"
"            --sysconfdir=/etc                      \\\n"
"            --localstatedir=/var                   \\\n"
"            --with-systemd=no                      \\\n"
"            --docdir=/usr/share/doc/dovecot-&dovecot-version;  \\\n"
"            --disable-static                       \\\n"
"            CXX=\"g++ -std=gnu++17\" &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>./configure --prefix=/usr                          \\\n"
"            --sysconfdir=/etc                      \\\n"
"            --localstatedir=/var                   \\\n"
"            --with-systemd=no                      \\\n"
"            --docdir=/usr/share/doc/dovecot-&dovecot-version;  \\\n"
"            --disable-static                       \\\n"
"            CXX=\"g++ -std=gnu++17\" &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/server/mail/dovecot.xml:160
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr                          \\\n"
"            --sysconfdir=/etc                      \\\n"
"            --localstatedir=/var                   \\\n"
"            --docdir=/usr/share/doc/dovecot-&dovecot-version;  \\\n"
"            --disable-static                       \\\n"
"            CXX=\"g++ -std=gnu++17\"                 &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>./configure --prefix=/usr                          \\\n"
"            --sysconfdir=/etc                      \\\n"
"            --localstatedir=/var                   \\\n"
"            --docdir=/usr/share/doc/dovecot-&dovecot-version;  \\\n"
"            --disable-static                       \\\n"
"            CXX=\"g++ -std=gnu++17\"                 &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/server/mail/dovecot.xml:169
#, xml-text
msgid "To test the results, issue <command>make -k check</command>."
msgstr ""
"Para testar os resultados, emita &quot;<command>make -k "
"check</command>&quot;."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/server/mail/dovecot.xml:173
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr "Agora, como o(a) usante <systemitem class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/server/mail/dovecot.xml:176
#, no-wrap, xml-text
