#. type: Content of: <sect1><sect2><title>
#: blfs-en/server/mail/dovecot.xml:181
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/server/mail/dovecot.xml:187
#, xml-text
msgid ""
"<parameter>CXX=\"g++ -std=gnu++17\"</parameter>: This setting enables the "
"C++17 standard. It is needed if <xref linkend='xapian'/> is installed, and "
"does not hurt if not."
msgstr ""
"<parameter>CXX=\"g++ -std=gnu++17\"</parameter>: Essa configuração habilita "
"o padrão C++17. Ela é necessária se <xref linkend='xapian'/> estiver "
"instalado e não danifica se não."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/server/mail/dovecot.xml:193
#, xml-text
msgid ""
"<option>--with-ldap</option>: This switch enables "
"<application>OpenLDAP</application> authentication support."
msgstr ""
"<option>--with-ldap</option>: Essa chave habilita o suporte a autenticação "
"&quot;<application>OpenLDAP</application>&quot;."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/server/mail/dovecot.xml:198
#, xml-text
msgid ""
"<option>--with-pgsql</option>: This switch enables "
"<application>PostgreSQL</application> database support."
msgstr ""
"<option>--with-pgsql</option>: Essa chave habilita o suporte a base de dados"
" &quot;<application>PostgreSQL</application>&quot;."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/server/mail/dovecot.xml:203
#, xml-text
msgid ""
"<option>--with-mysql</option>: This switch enables "
"<application>MySQL</application> database support."
msgstr ""
"<option>--with-mysql</option>: Essa chave habilita o suporte a base de dados"
" &quot;<application>MySQL</application>&quot;."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/server/mail/dovecot.xml:208
#, xml-text
msgid ""
"<option>--with-sqlite</option>: This switch enables "
"<application>SQLite</application> database support."
msgstr ""
"<option>--with-sqlite</option>: Essa chave habilita o suporte a base de "
"dados &quot;<application>SQLite</application>&quot;."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/server/mail/dovecot.xml:213
#, xml-text
msgid ""
"<option>--with-lua=no</option>: This switch enables "
"<application>Lua</application> plugin support. This includes a mail and push"
" notification plugin."
msgstr ""
"<option>--with-lua=no</option>: Essa chave habilita o suporte de plugin do "
"<application>Lua</application>. Isso inclui um plugin de notificação de "
"mensagem e envio."

