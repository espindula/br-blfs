#, xml-text
#~ msgid "First, apply a patch to fix problems with OpenSSL-3:"
#~ msgstr ""
#~ "Primeiro, aplique um remendo para corrigir problemas com o "
#~ "&quot;OpenSSL-3&quot;:"

#, no-wrap, xml-text
#~ msgid ""
#~ "<userinput remap=\"pre\">patch -Np1 -i ../dovecot-&dovecot-"
#~ "version;-openssl3_fixes-1.patch</userinput>"
#~ msgstr ""
#~ "<userinput remap=\"pre\">patch -Np1 -i ../dovecot-&dovecot-"
#~ "version;-openssl3_fixes-1.patch</userinput>"

#, xml-text
#~ msgid "Now, fix the package to build with icu-76.1 or later:"
#~ msgstr "Agora, corrija o pacote para construir com icu-76.1 ou posterior:"

#, no-wrap, xml-text
#~ msgid ""
#~ "<userinput remap=\"pre\">sed -i 's/\\bPKG_CONFIG --libs \"icu-i18n\\b/&amp; "
#~ "icu-uc/' configure </userinput>"
#~ msgstr ""
#~ "<userinput remap=\"pre\">sed -i 's/\\bPKG_CONFIG --libs \"icu-i18n\\b/&amp; "
#~ "icu-uc/' configure </userinput>"

#, xml-text
