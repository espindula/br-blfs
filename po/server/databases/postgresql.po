msgstr ""
"<command>sed -i ...</command>: Esse &quot;sed&quot; muda o local do soquete "
"do servidor de &quot;<filename class=\"directory\">/tmp</filename>&quot; "
"para &quot;<filename class=\"directory\">/run/postgresql</filename>&quot;."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/server/databases/postgresql.xml:312
#, xml-text
msgid ""
"<option>--with-openssl</option>: builds the package with support for "
