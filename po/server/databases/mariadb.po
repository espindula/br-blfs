#. type: Content of: <sect1><sect2><title>
#: blfs-en/server/databases/mariadb.xml:119
#, xml-text
msgid "Installation of MariaDB"
msgstr "Instalação do MariaDB"

#. type: Content of: <sect1><sect2><warning><para>
#: blfs-en/server/databases/mariadb.xml:123
#, xml-text
msgid ""
"MariaDB and MySQL cannot be installed on the same system without extensive "
"changes to the build configuration of one of the two applications."
msgstr ""
"&quot;MariaDB&quot; e &quot;MySQL&quot; não podem ser instalados no mesmo "
"sistema sem grandes mudanças na configuração de construção de um dos dois "
"aplicativos."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/server/databases/mariadb.xml:129
#, xml-text
msgid ""
"For security reasons, running the server as an unprivileged user and group "
"is strongly encouraged. Issue the following (as <systemitem "
"class=\"username\">root</systemitem>) to create the user and group:"
msgstr ""
"Por motivos de segurança, executar o servidor como um(a) usuário(a) e grupo "
"sem privilégios é altamente encorajado. Emita o seguinte (como "
"&quot;<systemitem class=\"username\">root</systemitem>&quot;) para criar "
"o(a) usuário(a) e o grupo:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/server/databases/mariadb.xml:135
#, no-wrap, xml-text
msgid ""
"<userinput>groupadd -g 40 mariadb &amp;&amp;\n"
"useradd -c \"MariaDB Server\" -d /srv/mariadb -g mariadb -s /bin/false -u 40 mariadb</userinput>"
msgstr ""
"<userinput>groupadd -g 40 mariadb &amp;&amp;\n"
"useradd -c \"MariaDB Server\" -d /srv/mariadb -g mariadb -s /bin/false -u 40 mariadb</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/server/databases/mariadb.xml:139
#, xml-text
msgid ""
"Fix an issue introduced with <application>libxml2</application>-2.14.x:"
msgstr ""
"Corrija um problema introduzido com "
"<application>libxml2</application>-2.14.x:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/server/databases/mariadb.xml:141
#, no-wrap, xml-text
msgid ""
"<userinput>sed -e \"s/BASE_BUFFER_SIZE/__XML_TREE_H__/\" \\\n"
"    -i storage/connect/plgxml.h</userinput>"
msgstr ""
"<userinput>sed -e \"s/BASE_BUFFER_SIZE/__XML_TREE_H__/\" \\\n"
"    -i storage/connect/plgxml.h</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/server/databases/mariadb.xml:145
#, xml-text
msgid ""
"Install <application>MariaDB</application> by running the following "
"commands:"
msgstr ""
"Instale o &quot;<application>MariaDB</application>&quot; executando os "
"seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/server/databases/mariadb.xml:149
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_BUILD_TYPE=Release                       \\\n"
"      -D CMAKE_INSTALL_PREFIX=/usr                      \\\n"
"      -D CMAKE_POLICY_VERSION_MINIMUM=3.5               \\\n"
"      -D GRN_LOG_PATH=/var/log/groonga.log              \\\n"
"      -D INSTALL_DOCDIR=share/doc/mariadb-&mariadb-version;        \\\n"
"      -D INSTALL_DOCREADMEDIR=share/doc/mariadb-&mariadb-version;  \\\n"
"      -D INSTALL_MANDIR=share/man                       \\\n"
"      -D INSTALL_MYSQLSHAREDIR=share/mariadb            \\\n"
"      -D INSTALL_MYSQLTESTDIR=share/mariadb/test        \\\n"
"      -D INSTALL_PAMDIR=lib/security                    \\\n"
"      -D INSTALL_PAMDATADIR=/etc/security               \\\n"
"      -D INSTALL_PLUGINDIR=lib/mariadb/plugin           \\\n"
"      -D INSTALL_SBINDIR=sbin                           \\\n"
"      -D INSTALL_SCRIPTDIR=bin                          \\\n"
"      -D INSTALL_SQLBENCHDIR=share/mariadb/bench        \\\n"
"      -D INSTALL_SUPPORTFILESDIR=share/mariadb          \\\n"
"      -D MYSQL_DATADIR=/srv/mariadb                     \\\n"
"      -D MYSQL_UNIX_ADDR=/run/mariadb/mariadb.sock      \\\n"
"      -D WITH_EXTRA_CHARSETS=complex                    \\\n"
"      -D WITH_EMBEDDED_SERVER=ON                        \\\n"
"      -D SKIP_TESTS=ON                                  \\\n"
"      -D TOKUDB_OK=0                                    \\\n"
"      -W no-dev                                         \\\n"
"      .. &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_BUILD_TYPE=Release                       \\\n"
"      -D CMAKE_INSTALL_PREFIX=/usr                      \\\n"
"      -D CMAKE_POLICY_VERSION_MINIMUM=3.5               \\\n"
"      -D GRN_LOG_PATH=/var/log/groonga.log              \\\n"
"      -D INSTALL_DOCDIR=share/doc/mariadb-&mariadb-version;        \\\n"
"      -D INSTALL_DOCREADMEDIR=share/doc/mariadb-&mariadb-version;  \\\n"
"      -D INSTALL_MANDIR=share/man                       \\\n"
"      -D INSTALL_MYSQLSHAREDIR=share/mariadb            \\\n"
"      -D INSTALL_MYSQLTESTDIR=share/mariadb/test        \\\n"
"      -D INSTALL_PAMDIR=lib/security                    \\\n"
"      -D INSTALL_PAMDATADIR=/etc/security               \\\n"
"      -D INSTALL_PLUGINDIR=lib/mariadb/plugin           \\\n"
"      -D INSTALL_SBINDIR=sbin                           \\\n"
"      -D INSTALL_SCRIPTDIR=bin                          \\\n"
"      -D INSTALL_SQLBENCHDIR=share/mariadb/bench        \\\n"
"      -D INSTALL_SUPPORTFILESDIR=share/mariadb          \\\n"
"      -D MYSQL_DATADIR=/srv/mariadb                     \\\n"
"      -D MYSQL_UNIX_ADDR=/run/mariadb/mariadb.sock      \\\n"
"      -D WITH_EXTRA_CHARSETS=complex                    \\\n"
"      -D WITH_EMBEDDED_SERVER=ON                        \\\n"
"      -D SKIP_TESTS=ON                                  \\\n"
"      -D TOKUDB_OK=0                                    \\\n"
"      -W no-dev                                         \\\n"
"      .. &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/server/databases/mariadb.xml:179
#, xml-text
msgid ""
"To test the results, issue: <command>make test</command>.  Two tests, "
"my_tzinfo and test-connect, are known to fail."
msgstr ""
"Para testar os resultados, emita: <command>make test</command>. Dois testes,"
" my_tzinfo e test-connect, são conhecidos por falharem."

#. type: Content of: <sect1><sect2><note><para>
#: blfs-en/server/databases/mariadb.xml:184
#, xml-text
msgid "A more extensive set of tests can be run with the following:"
msgstr "Um conjunto mais extenso de testes pode ser executado com o seguinte:"

#. type: Content of: <sect1><sect2><note><screen>
#: blfs-en/server/databases/mariadb.xml:186
#, no-wrap, xml-text
msgid ""
"<userinput>pushd mysql-test\n"
"./mtr --parallel <replaceable>&lt;N&gt;</replaceable> --mem --force\n"
"popd</userinput>"
msgstr ""
"<userinput>pushd mysql-test\n"
"./mtr --parallel <replaceable>&lt;N&gt;</replaceable> --mem --force\n"
"popd</userinput>"

#. type: Content of: <sect1><sect2><note><para>
#: blfs-en/server/databases/mariadb.xml:191
#, xml-text
msgid ""
"Where N is the number of tests to run in parallel.  Over 5400 tests are run "
"in about 24 SBU with N=4.  A few tests may fail, mainly due to character set"
" issues."
msgstr ""
"Onde N é o número de testes a executar em paralelo. Mais que cinco mil e "
"quatrocentos (5.400) testes são executados em cerca de 24 UPC com N=4. Uns "
"poucos testes possivelmente falhem, principalmente devido a problemas no "
"conjunto de caracteres."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/server/databases/mariadb.xml:197
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) &quot;<systemitem "
"class=\"username\">root</systemitem>&quot;:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/server/databases/mariadb.xml:200
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/server/databases/mariadb.xml:214
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#.  https://jira.mariadb.org/browse/MDEV-36422
#. type: Content of: <sect1><sect2><para>
#: blfs-en/server/databases/mariadb.xml:217
#, xml-text
msgid ""
"<parameter>-D CMAKE_POLICY_VERSION_MINIMUM=3.5</parameter>: This switch "
"allows <application>MariaDB</application> to build with CMake 4.0 and later "
"by working around some removed features."
msgstr ""
"<parameter>-D CMAKE_POLICY_VERSION_MINIMUM=3.5</parameter>: Essa chave "
"permite que <application>MariaDB</application> construa com CMake 4.0 e "
"posteriores, contornando alguns recursos removidos."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/server/databases/mariadb.xml:224
#, xml-text
msgid ""
"<parameter>-D WITH_EMBEDDED_SERVER=ON</parameter>: This switch enables "
"compiling the embedded server library needed by certain applications, such "
"as <application>Amarok</application>."
msgstr ""
"<parameter>-D WITH_EMBEDDED_SERVER=ON</parameter>: Essa chave habilita "
"compilar a biblioteca incorporada do servidor necessária para determinados "
"aplicativos, como o &quot;<application>Amarok</application>&quot;."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/server/databases/mariadb.xml:230
#, xml-text
msgid ""
"<parameter>-D WITH_EXTRA_CHARSETS=complex</parameter>: This switch enables "
"support for the complex character sets."
msgstr ""
"<parameter>-D WITH_EXTRA_CHARSETS=complex</parameter>: Essa chave habilita "
"suporte para os conjuntos de caracteres complexos."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/server/databases/mariadb.xml:235
#, xml-text
msgid ""
"<parameter>-D SKIP_TESTS=ON</parameter>: This switch disables tests for "
"MariaDB Connector/C which are not supported without additional setup."
msgstr ""
"<parameter>-D SKIP_TESTS=ON</parameter>: Essa chave desabilita testes para "
"Connector/C do MariaDB que não são suportados sem configuração adicional."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/server/databases/mariadb.xml:241
#, xml-text
msgid ""
"<option>-D WITHOUT_SERVER=ON</option>: Use this switch if you don't want the"
" server and would like to build the client only."
msgstr ""
"<option>-D WITHOUT_SERVER=ON</option>: Use essa chave se você não quiser o "
"servidor e gostaria de construir somente o cliente."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/server/databases/mariadb.xml:247
#, xml-text
msgid ""
"<parameter>-W no-dev</parameter>: This switch turns off some warnings that "
"are only useful for developers."
msgstr ""
"<parameter>-W no-dev</parameter>: Essa chave desliga alguns avisos que são "
"úteis somente para desenvolvedores(as)."

#. type: Content of: <sect1><sect2><note><para>
#: blfs-en/server/databases/mariadb.xml:252
#, xml-text
msgid ""
"There are numerous options available to <command>cmake</command>. Check the "
"output of the <command>cmake . -LH</command> for additional customization "
"options."
msgstr ""
"Existem numerosas opções disponíveis para o "
"&quot;<command>cmake</command>&quot;. Verifique a saída gerada do "
"&quot;<command>cmake . -LH</command>&quot; para opções adicionais de "
"personalização."

#. type: Content of: <sect1><sect2><title>
#: blfs-en/server/databases/mariadb.xml:260
#, xml-text
msgid "Configuring MariaDB"
msgstr "Configurando MariaDB"

