#. type: Content of: <sect1><sect2><para>
#: blfs-en/server/databases/lmdb.xml:85
#, xml-text
msgid ""
"Install <application>lmdb</application> by running the following commands:"
msgstr ""
"Instale o &quot;<application>lmdb</application>&quot; executando os "
"seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/server/databases/lmdb.xml:89
#, no-wrap, xml-text
msgid ""
"<userinput>cd libraries/liblmdb &amp;&amp;\n"
"make                 &amp;&amp;\n"
"sed -i 's| liblmdb.a||' Makefile</userinput>"
msgstr ""
"<userinput>cd libraries/liblmdb &amp;&amp;\n"
"make                &amp;&amp;\n"
"sed -i 's| liblmdb.a||' Makefile</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/server/databases/lmdb.xml:94
#, xml-text
