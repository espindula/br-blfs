#, xml-text
#~ msgid "User Notes: <ulink url=\"&blfs-wiki;/vsftpd\"/>"
#~ msgstr "Observações de Usuário(a): <ulink url=\"&blfs-wiki;/vsftpd\"/>"

#, xml-text
#~ msgid ""
#~ "The vsftpd daemon uses seccomp to improve security by default.  But it's "
#~ "known to cause vsftpd unable to handle ftp <literal>LIST</literal> command "
#~ "with recent kernel versions.  Append a line to "
#~ "<filename>/etc/vsftpd.conf</filename> (as the <systemitem "
#~ "class=\"username\">root</systemitem> user) to disable seccomp and workaround"
#~ " this issue:"
#~ msgstr ""
#~ "O processo de segundo plano &quot;vsftpd&quot; usa &quot;seccomp&quot; para "
#~ "melhorar a segurança por padrão. Mas é conhecido por fazer com que o "
#~ "&quot;vsftpd&quot; não consiga lidar com o comando "
#~ "&quot;<literal>LIST</literal>&quot; do &quot;ftp&quot; com versões recentes "
#~ "do núcleo. Anexe uma linha a "
#~ "&quot;<filename>/etc/vsftpd.conf</filename>&quot; (como o(a) usuário(a) "
#~ "&quot;<systemitem class=\"username\">root</systemitem>&quot;) para "
#~ "desabilitar o &quot;seccomp&quot; e solucionar esse problema:"

#, no-wrap, xml-text
#~ msgid ""
#~ "<userinput>cat &gt;&gt; /etc/vsftpd.conf &lt;&lt; \"EOF\"\n"
#~ "<literal>seccomp_sandbox=NO</literal>\n"
#~ "EOF</userinput>"
#~ msgstr ""
#~ "<userinput>cat &gt;&gt; /etc/vsftpd.conf &lt;&lt; \"EOF\"\n"
#~ "<literal>seccomp_sandbox=NO</literal>\n"
#~ "EOF</userinput>"
