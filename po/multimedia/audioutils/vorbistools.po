#. type: Content of: <sect1><sect2><title>
#: blfs-en/multimedia/audioutils/vorbistools.xml:94
#, xml-text
msgid "Installation of Vorbis Tools"
msgstr "Instalação do Vorbis Tools"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/audioutils/vorbistools.xml:97
#, xml-text
msgid "First, apply a sed to fix a gcc-14 issue:"
msgstr "Primeiro, aplique um sed para corrigir um problema de gcc-14:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/multimedia/audioutils/vorbistools.xml:100
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"pre\">sed -i '/i18n.h/i #include \"utf8.h\"' "
"ogginfo/codec_skeleton.c</userinput>"
msgstr ""
"<userinput remap=\"pre\">sed -i '/i18n.h/i #include \"utf8.h\"' "
"ogginfo/codec_skeleton.c</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/audioutils/vorbistools.xml:103
#, xml-text
msgid "Next, apply a sed to fix a security vulnerability in 'oggenc':"
msgstr ""
"A seguir, aplique um sed para corrigir uma vulnerabilidade de segurança no "
"'oggenc':"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/multimedia/audioutils/vorbistools.xml:106
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"pre\">sed -i 's/start+1,/start + strspn(start, "
"PATH_SEPS),/' oggenc/platform.c</userinput>"
msgstr ""
"<userinput remap=\"pre\">sed -i 's/start+1,/start + strspn(start, "
"PATH_SEPS),/' oggenc/platform.c</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/audioutils/vorbistools.xml:109
#, xml-text
msgid ""
"Install <application>Vorbis Tools</application> by running the following "
"commands:"
msgstr ""
"Instale o <application>Vorbis Tools</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/multimedia/audioutils/vorbistools.xml:113
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr --enable-vcut &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>./configure --prefix=/usr --enable-vcut &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/audioutils/vorbistools.xml:117
#, xml-text
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/audioutils/vorbistools.xml:121
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/multimedia/audioutils/vorbistools.xml:124
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/multimedia/audioutils/vorbistools.xml:129
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/audioutils/vorbistools.xml:132
#, xml-text
msgid ""
"<parameter>--enable-vcut</parameter>: This parameter is used so that the "
"<command>vcut</command> program is built as it is not by default."
msgstr ""
"<parameter>--enable-vcut</parameter>: Esse parâmetro é usado de forma que o "
"aplicativo <command>vcut</command> seja construído como não é por padrão."

