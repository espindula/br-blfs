#, xml-text
msgid "Introduction to Vorbis Tools"
msgstr "Introdução ao Vorbis Tools"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/audioutils/vorbistools.xml:29
#, xml-text
msgid ""
"The <application>Vorbis Tools</application> package contains command-line "
"tools useful for encoding, playing or editing files using the Ogg codec."
msgstr ""
"O pacote <application>Vorbis Tools</application> contém ferramentas de linha"
" de comando úteis para codificar, reproduzir ou editar arquivos usando o "
"codec Ogg."

