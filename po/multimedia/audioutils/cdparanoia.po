#, xml-text
msgid "Introduction to CDParanoia"
msgstr "Introdução ao CDParanoia"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/audioutils/cdparanoia.xml:29
#, xml-text
msgid ""
"The <application>CDParanoia</application> package contains a CD audio "
"extraction tool. This is useful for extracting <filename>.wav</filename> "
"files from audio CDs. A CDDA capable CDROM drive is needed.  Practically all"
" drives supported by Linux can be used."
msgstr ""
"O pacote <application>CDParanoia</application> contém uma ferramenta de "
"extração de áudio de CD. Isso é útil para extrair arquivos "
"<filename>.wav</filename> a partir de CDs de áudio. Uma unidade de CDROM "
"compatível com CDDA é necessária. Praticamente todas as unidades suportadas "
"pelo Linux podem ser usadas."

