#, xml-text
msgid "Introduction to mpg123"
msgstr "Introdução ao mpg123"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/audioutils/mpg123.xml:29
#, xml-text
msgid ""
"The <application>mpg123</application> package contains a console-based MP3 "
"player. It claims to be the fastest MP3 decoder for Unix."
msgstr ""
"O pacote <application>mpg123</application> contém um reprodutor de MP3 "
"baseado em console. Ele afirma ser o decodificador de MP3 mais rápido para "
"Unix."

