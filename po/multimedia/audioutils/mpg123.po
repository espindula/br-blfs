#. type: Content of: <sect1><sect2><title>
#: blfs-en/multimedia/audioutils/mpg123.xml:88
#, xml-text
msgid "Installation of mpg123"
msgstr "Instalação do mpg123"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/audioutils/mpg123.xml:91
#, xml-text
msgid ""
"Install <application>mpg123</application> by running the following commands:"
msgstr ""
"Instale o <application>mpg123</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/multimedia/audioutils/mpg123.xml:95
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>./configure --prefix=/usr &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/audioutils/mpg123.xml:99
#, xml-text
msgid "To test the results, issue: <command>make check</command>."
msgstr "Para testar os resultados, emita: <command>make check</command>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/audioutils/mpg123.xml:103
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/multimedia/audioutils/mpg123.xml:106
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

