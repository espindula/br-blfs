#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/audioutils/pavucontrol.xml:120
#, xml-text
msgid ""
"<parameter>-D lynx=false</parameter>: This switch disables generating the "
"README file in text format. Remove this switch if you want the README file "
"in text format and have <xref linkend=\"lynx\"/> installed."
msgstr ""
"<parameter>-D lynx=false</parameter>: Essa chave desabilita gerar o arquivo "
"README em formato de texto. Remova essa chave se você quiser o arquivo "
"README em formato de texto e tiver <xref linkend=\"lynx\"/> instalado."

