#. type: Content of: <sect1><sect2><title>
#: blfs-en/multimedia/libdriv/libass.xml:95
#, xml-text
msgid "Installation of libass"
msgstr "Instalação do libass"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/libass.xml:98
#, xml-text
msgid ""
"Install <application>libass</application> by running the following commands:"
msgstr ""
"Instale o <application>libass</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/multimedia/libdriv/libass.xml:102
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr --disable-static &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>./configure --prefix=/usr --disable-static &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/libass.xml:106
#, xml-text
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/libass.xml:110
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/multimedia/libdriv/libass.xml:113
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/multimedia/libdriv/libass.xml:118
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/libass.xml:124
#, xml-text
msgid ""
"<option>--disable-fontconfig</option>: Use this switch if you didn't install"
" <application>Fontconfig</application>."
msgstr ""
"<option>--disable-fontconfig</option>: Use essa chave se você não instalou o"
" <application>Fontconfig</application>."

