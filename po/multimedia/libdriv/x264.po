#. type: Content of: <sect1><sect2><title>
#: blfs-en/multimedia/libdriv/x264.xml:87
#, xml-text
msgid "Installation of x264"
msgstr "Instalação do x264"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/x264.xml:98
#, xml-text
msgid ""
"Install <application>x264</application> by running the following commands:"
msgstr ""
"Instale o <application>x264</application> executando os seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/multimedia/libdriv/x264.xml:102
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr   \\\n"
"            --enable-shared \\\n"
"            --disable-cli   &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>./configure --prefix=/usr   \\\n"
"            --enable-shared \\\n"
"            --disable-cli   &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/x264.xml:108
#, xml-text
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/x264.xml:112
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr "Agora, como o(a) usante <systemitem class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/multimedia/libdriv/x264.xml:115
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/multimedia/libdriv/x264.xml:120
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/x264.xml:123
#, xml-text
msgid ""
"<parameter>--disable-cli</parameter>: This switch disables building the "
"command-line encoder which is redundant since it requires FFmpeg for most of"
" the input formats."
msgstr ""
"<parameter>--disable-cli</parameter>: Essa chave desabilita construir o "
"codificador de linha de comando, que é redundante, pois exige o FFmpeg para "
"a maioria dos formatos de entrada."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/x264.xml:129
#, xml-text
msgid ""
"<option>--disable-asm</option>: Use this switch if you didn't install NASM."
msgstr ""
"<option>--disable-asm</option>: Use essa chave se você não instalou o NASM."

