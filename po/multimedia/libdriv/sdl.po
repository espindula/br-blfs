#, xml-text
#~ msgid ""
#~ "<option>--disable-alsa-shared</option>: This switch disables dynamically "
#~ "loading ALSA shared libraries."
#~ msgstr ""
#~ "<option>--disable-alsa-shared</option>: Essa chave desabilita o carregamento"
#~ " dinâmico de bibliotecas compartilhadas ALSA."

#, xml-text
#~ msgid ""
#~ "<option>--disable-sdl-dlopen</option>: This switch disables using dlopen for"
#~ " shared object loading. Loading image backend libraries like libpng "
#~ "dynamically on the fly does not work."
