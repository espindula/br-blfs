#. type: Content of: <sect1><sect2><title>
#: blfs-en/multimedia/libdriv/gavl.xml:89
#, xml-text
msgid "Installation of Gavl"
msgstr "Instalação do Gavl"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/gavl.xml:92
#, xml-text
msgid "First, fix an issue with gcc-14 and later:"
msgstr "Primeiro, corrija um problema com o gcc-14 e posteriores:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/multimedia/libdriv/gavl.xml:95
#, no-wrap, xml-text
msgid ""
"<userinput>sed -i \"/stdio/a #include &lt;string.h&gt;\" "
"src/fill_test.c</userinput>"
msgstr ""
"<userinput>sed -i \"/stdio/a #include &lt;string.h&gt;\" "
"src/fill_test.c</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/gavl.xml:98
#, xml-text
msgid ""
"Now, install <application>Gavl</application> by running the following "
"commands:"
msgstr ""
"Agora, instale <application>Gavl</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/multimedia/libdriv/gavl.xml:102
#, no-wrap, xml-text
msgid ""
"<userinput>LIBS=-lm                         \\\n"
"./configure --prefix=/usr        \\\n"
"            --without-doxygen    \\\n"
"            --with-cpuflags=none \\\n"
"            --docdir=/usr/share/doc/gavl-&gavl-version; &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>LIBS=-lm                         \\\n"
"./configure --prefix=/usr        \\\n"
"            --without-doxygen    \\\n"
"            --with-cpuflags=none \\\n"
"            --docdir=/usr/share/doc/gavl-&gavl-version; &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/gavl.xml:110
#, xml-text
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/gavl.xml:114
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr "Agora, como o(a) usante <systemitem class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/multimedia/libdriv/gavl.xml:117
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/multimedia/libdriv/gavl.xml:122
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/gavl.xml:125
#, xml-text
msgid ""
"<envar>LIBS=-lm</envar>: This variable ensures the math library is searched "
"when linking."
msgstr ""
"<envar>LIBS=-lm</envar>: Essa variável garante que a biblioteca matemática "
"seja pesquisada durante a vinculação."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/gavl.xml:130
#, xml-text
msgid ""
"<parameter>--without-doxygen</parameter>: This switch disables use of "
"Doxygen. Omit if Doxygen is installed and you wish to build the API "
"documentation."
msgstr ""
"<parameter>--without-doxygen</parameter>: Essa chave desabilita o uso do "
"Doxygen. Omita se o Doxygen estiver instalado e você desejar construir a "
"documentação da API."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/gavl.xml:136
#, xml-text
msgid ""
"<parameter>--with-cpuflags=none</parameter>: This switch fixes a problem "
"identifying capabilities of the system architecture."
msgstr ""
"<parameter>--with-cpuflags=none</parameter>: Essa chave corrige um problema "
"de identificação de recursos da arquitetura do sistema."

