#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/libgstgtk4.xml:28
#, xml-text
msgid ""
"The <application>libgstgtk4</application> package contains a library that "
"binds the gstreamer multimedia framework to GTK-4."
msgstr ""
"O pacote <application>libgstgtk4</application> contém uma biblioteca que "
"vincula a estrutura de multimídia gstreamer ao GTK-4."

