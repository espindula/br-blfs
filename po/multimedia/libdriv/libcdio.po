#. _cdio_generic.c:63:20: error: implicit declaration of function ‘lseek64’
#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/libcdio.xml:97
#, xml-text
msgid ""
"If you are building on an i686 system, fix a build issue caused by large "
"file support:"
msgstr ""
"Se você estiver construindo em um sistema i686, corrija um problema de "
"construção causado pelo suporte a arquivos grandes:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/multimedia/libdriv/libcdio.xml:102
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"pre\">sed '/CDIO_LSEEK/s/lseek64/lseek/' -i "
"lib/driver/_cdio_generic.c</userinput>"
msgstr ""
"<userinput remap=\"pre\">sed '/CDIO_LSEEK/s/lseek64/lseek/' -i "
"lib/driver/_cdio_generic.c</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/libcdio.xml:105
#, xml-text
msgid ""
"Install <application>libcdio</application> by running the following "
"commands:"
msgstr ""
"Instale o <application>libcdio</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/multimedia/libdriv/libcdio.xml:109
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr --disable-static &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>./configure --prefix=/usr --disable-static &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/libcdio.xml:113
#, xml-text
msgid ""
"To test the results, issue: <command>make check -k</command>.  One test "
"named <filename>realpath</filename> is known to fail."
msgstr ""
"Para testar os resultados, emita: <command>make check -k</command>. Um teste"
" chamado <filename>realpath</filename> é conhecido por falhar."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/libcdio.xml:118
#: blfs-en/multimedia/libdriv/libcdio.xml:138
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/multimedia/libdriv/libcdio.xml:121
#: blfs-en/multimedia/libdriv/libcdio.xml:141
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/libcdio.xml:124
#, xml-text
msgid "Now install libcdio-paranoia:"
msgstr "Agora instale a libcdio-paranoia:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/multimedia/libdriv/libcdio.xml:127
#, no-wrap, xml-text
msgid ""
"<userinput>tar -xf ../&libcdio-paranoia;.tar.bz2 &amp;&amp;\n"
"cd &libcdio-paranoia; &amp;&amp;\n"
"\n"
"./configure --prefix=/usr --disable-static &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>tar -xf ../&libcdio-paranoia;.tar.bz2 &amp;&amp;\n"
"cd &libcdio-paranoia; &amp;&amp;\n"
"\n"
"./configure --prefix=/usr --disable-static &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/libcdio.xml:134
#, xml-text
msgid "To test the results, issue: <command>make check</command>."
msgstr "Para testar os resultados, emita: <command>make check</command>."

