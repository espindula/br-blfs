#. type: Content of: <sect1><sect2><title>
#: blfs-en/multimedia/libdriv/gst10-plugins-rs.xml:26
#, xml-text
msgid "Introduction to gst-plugins-rs"
msgstr "Introdução ao gst-plugins-rs"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/gst10-plugins-rs.xml:29
#, xml-text
msgid ""
"The <application>gst-plugins-rs</application> package provides several Rust "
"plugins for interacting with the gstreamer multimedia framework.  This page "
"has instructions for libgstdav1d and libgstgtk4."
msgstr ""
"O pacote <application>gst-plugins-rs</application> fornece diversos plugins "
"Rust para interagir com a estrutura essencial de suporte de multimídia "
"gstreamer. Esta página contém instruções para libgstdav1d e libgstgtk4."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/gst10-plugins-rs.xml:35
#, xml-text
msgid ""
"The libgstdav1d plugin provides AV1 decoding via dav1d through gstreamer."
msgstr ""
"O plugin libgstdav1d fornece decodificação de AV1 via dav1d por meio do "
"gstreamer."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/gst10-plugins-rs.xml:40
#, xml-text
msgid "The libgstgtk4 plugin binds gstreamer to GTK-4."
msgstr "O plugin libgstgtk4 vincula o gstreamer ao GTK-4."

