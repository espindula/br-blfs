#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/libdvdread.xml:28
#, xml-text
msgid ""
"<application>libdvdread</application> is a library which provides a simple "
"foundation for reading DVDs."
msgstr ""
"<application>libdvdread</application> é uma biblioteca que fornece uma base "
"simples para leitura de DVDs."

