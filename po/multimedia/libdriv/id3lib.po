#: blfs-en/multimedia/libdriv/id3lib.xml:29
#, xml-text
msgid ""
"<application>id3lib</application> is a library for reading, writing and "
"manipulating id3v1 and id3v2 multimedia data containers."
msgstr ""
"<application>id3lib</application> é uma biblioteca para leitura, escrita e "
"manipulação de contêineres de dados multimídia id3v1 e id3v2."

