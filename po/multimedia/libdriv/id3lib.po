#. type: Content of: <sect1><sect2><title>
#: blfs-en/multimedia/libdriv/id3lib.xml:82
#, xml-text
msgid "Installation of Id3lib"
msgstr "Instalação do Id3lib"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/id3lib.xml:85
#, xml-text
msgid ""
"Install <application>id3lib</application> by running the following commands:"
msgstr ""
"Instale o <application>id3lib</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/multimedia/libdriv/id3lib.xml:89
#, no-wrap, xml-text
msgid ""
"<userinput>patch -Np1 -i ../id3lib-&id3lib-version;-consolidated_patches-1.patch &amp;&amp;\n"
"\n"
"libtoolize -fc                &amp;&amp;\n"
"aclocal                       &amp;&amp;\n"
"autoconf                      &amp;&amp;\n"
"automake --add-missing --copy &amp;&amp;\n"
"\n"
"./configure --prefix=/usr --disable-static &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>patch -Np1 -i ../id3lib-&id3lib-version;-consolidated_patches-1.patch &amp;&amp;\n"
"\n"
"libtoolize -fc                &amp;&amp;\n"
"aclocal                       &amp;&amp;\n"
"autoconf                      &amp;&amp;\n"
"automake --add-missing --copy &amp;&amp;\n"
"\n"
"./configure --prefix=/usr --disable-static &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/id3lib.xml:100
#, xml-text
msgid "This packages does not come with a working test suite."
msgstr "Esse pacote não vem com uma suíte de teste funcional."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/id3lib.xml:104
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr "Agora, como o(a) usante <systemitem class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/multimedia/libdriv/id3lib.xml:107
#, no-wrap, xml-text
msgid ""
"<userinput>make install  &amp;&amp;\n"
"cp doc/man/* /usr/share/man/man1 &amp;&amp;\n"
"\n"
"install -v -m755 -d /usr/share/doc/id3lib-&id3lib-version; &amp;&amp;\n"
"install -v -m644 doc/*.{gif,jpg,png,ico,css,txt,php,html} \\\n"
"                    /usr/share/doc/id3lib-&id3lib-version;</userinput>"
msgstr ""
"<userinput>make install  &amp;&amp;\n"
"cp doc/man/* /usr/share/man/man1 &amp;&amp;\n"
"\n"
"install -v -m755 -d /usr/share/doc/id3lib-&id3lib-version; &amp;&amp;\n"
"install -v -m644 doc/*.{gif,jpg,png,ico,css,txt,php,html} \\\n"
"                    /usr/share/doc/id3lib-&id3lib-version;</userinput>"

