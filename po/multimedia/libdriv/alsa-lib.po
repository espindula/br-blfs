#, xml-text
msgid "Introduction to ALSA Library"
msgstr "Introdução ao ALSA Library"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/alsa-lib.xml:29
#, xml-text
msgid ""
"The <application>ALSA Library</application> package contains the ALSA "
"library used by programs (including <application>ALSA "
"Utilities</application>) requiring access to the ALSA sound interface."
msgstr ""
"O pacote <application>ALSA Library</application> contém a biblioteca ALSA "
"usada por aplicativos (incluindo <application>ALSA Utilities</application>) "
"que exigem acesso para a interface de som ALSA."

