#. type: Content of: <sect1><sect2><title>
#: blfs-en/multimedia/libdriv/libao.xml:86
#, xml-text
msgid "Installation of Libao"
msgstr "Instalação do Libao"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/libao.xml:89
#, xml-text
msgid "First, fix a gcc-14 issue:"
msgstr "Primeiro, corrija um problema do gcc-14:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/multimedia/libdriv/libao.xml:92
#, no-wrap, xml-text
msgid ""
"<userinput>sed -i '/limits.h/a #include &lt;time.h&gt;' "
"src/plugins/pulse/ao_pulse.c</userinput>"
msgstr ""
"<userinput>sed -i '/limits.h/a #include &lt;time.h&gt;' "
"src/plugins/pulse/ao_pulse.c</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/libao.xml:95
#, xml-text
msgid ""
"Install <application>libao</application> by running the following commands:"
msgstr ""
"Instale o <application>libao</application> executando os seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/multimedia/libdriv/libao.xml:99
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>./configure --prefix=/usr &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/libao.xml:103
#, xml-text
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/libao.xml:107
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/multimedia/libdriv/libao.xml:110
#, no-wrap, xml-text
msgid ""
"<userinput>make install &amp;&amp;\n"
"install -v -m644 README /usr/share/doc/libao-&libao-version;</userinput>"
msgstr ""
"<userinput>make install &amp;&amp;\n"
"install -v -m644 README /usr/share/doc/libao-&libao-version;</userinput>"

