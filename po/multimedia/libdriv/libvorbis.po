#. type: Content of: <sect1><sect2><title>
#: blfs-en/multimedia/libdriv/libvorbis.xml:88
#, xml-text
msgid "Installation of libvorbis"
msgstr "Instalação do libvorbis"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/libvorbis.xml:98
#, xml-text
msgid ""
"Install <application>libvorbis</application> by running the following "
"commands:"
msgstr ""
"Instale o <application>libvorbis</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/multimedia/libdriv/libvorbis.xml:102
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr --disable-static &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>./configure --prefix=/usr --disable-static &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/libvorbis.xml:106
#, xml-text
msgid "To test the results, issue: <command>make -j1 check</command>."
msgstr "Para testar os resultados, emita: <command>make -j1 check</command>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/libvorbis.xml:110
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr "Agora, como o(a) usante <systemitem class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/multimedia/libdriv/libvorbis.xml:113
#, no-wrap, xml-text
msgid ""
"<userinput>make install &amp;&amp;\n"
"install -v -m644 doc/Vorbis* /usr/share/doc/libvorbis-&libvorbis-version;</userinput>"
msgstr ""
"<userinput>make install &amp;&amp;\n"
"install -v -m644 doc/Vorbis* /usr/share/doc/libvorbis-&libvorbis-version;</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/multimedia/libdriv/libvorbis.xml:119
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/libvorbis.xml:125
#, xml-text
msgid ""
"<option>--enable-docs</option>: This switch enables building the "
"documentation in formats other than the supplied html."
msgstr ""
"<option>--enable-docs</option>: Essa chave habilita construir a documentação"
" em formatos diferentes do HTML fornecido."

