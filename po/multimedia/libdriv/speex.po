#. type: Content of: <sect1><sect2><title>
#: blfs-en/multimedia/libdriv/speex.xml:138
#, xml-text
msgid "Installation of Speex"
msgstr "Instalação do Speex"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/speex.xml:141
#, xml-text
msgid ""
"This package consists of two separate tarballs.  They need to be extracted "
"and built independently."
msgstr ""
"Esse pacote consiste de dois tarballs. Eles precisam ser extraídos e "
"construídos independentemente."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/speex.xml:146
#, xml-text
msgid ""
"Install <application>Speex</application> by running the following commands:"
msgstr ""
"Instale o <application>Speex</application> executando os seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/multimedia/libdriv/speex.xml:150
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr    \\\n"
"            --disable-static \\\n"
"            --docdir=/usr/share/doc/speex-&speex-version; &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>./configure --prefix=/usr    \\\n"
"            --disable-static \\\n"
"            --docdir=/usr/share/doc/speex-&speex-version; &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/speex.xml:156
#, xml-text
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/speex.xml:160
#, xml-text
msgid "As the <systemitem class=\"username\">root</systemitem> user:"
msgstr "Como o(a) usante <systemitem class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/multimedia/libdriv/speex.xml:163
#: blfs-en/multimedia/libdriv/speex.xml:182
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/speex.xml:166
#, xml-text
msgid "Now extract and install the speexdsp package:"
msgstr "Agora extraia e instale o pacote speexdsp:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/multimedia/libdriv/speex.xml:169
#, no-wrap, xml-text
msgid ""
"<userinput>cd ..                          &amp;&amp;\n"
"tar -xf speexdsp-&speexdsp-version;.tar.gz &amp;&amp;\n"
"cd speexdsp-&speexdsp-version;             &amp;&amp;\n"
"\n"
"./configure --prefix=/usr    \\\n"
"            --disable-static \\\n"
"            --docdir=/usr/share/doc/speexdsp-&speexdsp-version; &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>cd ..                          &amp;&amp;\n"
"tar -xf speexdsp-&speexdsp-version;.tar.gz &amp;&amp;\n"
"cd speexdsp-&speexdsp-version;             &amp;&amp;\n"
"\n"
"./configure --prefix=/usr    \\\n"
"            --disable-static \\\n"
"            --docdir=/usr/share/doc/speexdsp-&speexdsp-version; &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/speex.xml:179
#, xml-text
msgid "Again, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Novamente, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

