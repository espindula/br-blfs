#. type: Content of: <sect1><sect2><title>
#: blfs-en/multimedia/libdriv/speex.xml:34
#, xml-text
msgid "Introduction to Speex"
msgstr "Introdução ao Speex"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/speex.xml:37
#, xml-text
msgid ""
"<application>Speex</application> is an audio compression format designed "
"specifically for speech. It is well-adapted to internet applications and "
"provides useful features that are not present in most other CODECs."
msgstr ""
"<application>Speex</application> é um formato de compressão de áudio "
"projetado especificamente para fala. Ele é bem adaptado a aplicações de "
"Internet e oferece recursos úteis que não estão presentes na maioria dos "
"outros CODECs."

