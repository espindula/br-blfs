#. type: Content of: <sect1><sect2><title>
#: blfs-en/multimedia/libdriv/mlt.xml:121
#, xml-text
msgid "Installation of MLT"
msgstr "Instalação do MLT"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/mlt.xml:124
#, xml-text
msgid "Fix building this package with ffmpeg-9:"
msgstr "Corrija construir esse pacote com ffmpeg-9:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/multimedia/libdriv/mlt.xml:127
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"pre\">patch -Np1 -i ../mlt-&mlt-"
"version;-ffmpeg-9.0.patch</userinput>"
msgstr ""
"<userinput remap=\"pre\">patch -Np1 -i ../mlt-&mlt-"
"version;-ffmpeg-9.0.patch</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/mlt.xml:130
#, xml-text
msgid ""
"Install <application>MLT</application> by running the following commands:"
msgstr ""
"Instale <application>MLT</application> executando os seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/multimedia/libdriv/mlt.xml:133
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr \\\n"
"      -D CMAKE_BUILD_TYPE=Release  \\\n"
"      -D MOD_SOX=OFF               \\\n"
"      -D MOD_MOVIT=OFF             \\\n"
"      -D MOD_VIDSTAB=OFF           \\\n"
"      -D MOD_JACKRACK=OFF          \\\n"
"      -D MOD_RUBBERBAND=OFF        \\\n"
"      -W no-author .. &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr \\\n"
"      -D CMAKE_BUILD_TYPE=Release  \\\n"
"      -D MOD_SOX=OFF               \\\n"
"      -D MOD_MOVIT=OFF             \\\n"
"      -D MOD_VIDSTAB=OFF           \\\n"
"      -D MOD_JACKRACK=OFF          \\\n"
"      -D MOD_RUBBERBAND=OFF        \\\n"
"      -W no-author .. &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/mlt.xml:147
#, xml-text
msgid ""
"This package does not come with a test suite. However a test .mp4 file can "
"be played in a local graphical environment with <command>./out/bin/melt "
"&lt;filename&gt;.mp4</command>."
msgstr ""
"Esse pacote não vem com uma suíte de teste. No entanto, um arquivo .mp4 de "
"teste pode ser reproduzido em um ambiente gráfico local com "
"<command>./out/bin/melt &lt;nome_arquivo&gt;.mp4</command>."

#. type: Content of: <sect1><sect2><note><para>
#: blfs-en/multimedia/libdriv/mlt.xml:154
#, xml-text
msgid ""
"This application uses advanced graphical capabilities.  In some cases, "
"firmware for your specific graphics adaptor may be needed.  See <xref "
"linkend=\"video-firmware\"/> for more information."
msgstr ""
"Esse aplicativo usa recursos gráficos avançados. Em alguns casos, firmware "
"para o teu adaptador gráfico específico possivelmente seja necessário. Veja-"
"se <xref linkend=\"video-firmware\"/> para mais informações."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/mlt.xml:161
#, xml-text
msgid "Now, as the &root; user:"
msgstr "Agora, como o(a) usante &root;:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/multimedia/libdriv/mlt.xml:164
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/multimedia/libdriv/mlt.xml:169
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/mlt.xml:172
#, xml-text
msgid ""
"<parameter>-D MOD_*=OFF</parameter>: These switches allow the package to "
"build without some of the optional external packages."
msgstr ""
"<parameter>-D MOD_*=OFF</parameter>: Essas chaves permitem que o pacote "
"construa sem alguns dos pacotes opcionais externos."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/mlt.xml:177
#, xml-text
msgid ""
"<option>-D MOD_AVFORMAT=OFF</option>: This option allows building without "
"<xref linkend='ffmpeg'/>."
msgstr ""
"<option>-D MOD_AVFORMAT=OFF</option>: Essa opção permite construir sem <xref"
" linkend='ffmpeg'/>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/mlt.xml:182
#, xml-text
msgid ""
"<option>-D MOD_FREI0R=OFF</option>: This option allows building without "
"<xref linkend='frei0r'/>."
msgstr ""
"<option>-D MOD_FREI0R=OFF</option>: Essa opção permite construir sem <xref "
"linkend='frei0r'/>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/mlt.xml:187
#, xml-text
msgid ""
"<option>-D MOD_RESAMPLE=OFF</option>: This option allows building without "
"<xref linkend='libsamplerate'/>."
msgstr ""
"<option>-D MOD_RESAMPLE=OFF</option>: Essa opção permite construir sem <xref"
" linkend='libsamplerate'/>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/mlt.xml:192
#, xml-text
msgid ""
"<option>-D MOD_QT6=OFF</option>: This option allows building without <xref "
"linkend='qt6'/>."
msgstr ""
"<option>-D MOD_QT6=OFF</option>: Essa opção permite construir sem <xref "
"linkend='qt6'/>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/mlt.xml:197
#, xml-text
msgid ""
"<option>-D MOD_RNNOISE=OFF</option>: This option allows building without "
"<xref linkend='rnnoise'/>."
msgstr ""
"<option>-D MOD_RNNOISE=OFF</option>: Essa opção permite construir sem <xref "
"linkend='rnnoise'/>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/mlt.xml:202
#, xml-text
msgid ""
"<option>-D MOD_OPENCV=ON</option>: This option allows building some "
"additional modules that use <xref linkend=\"opencv\"/>."
msgstr ""
"<option>-D MOD_OPENCV=ON</option>: Essa opção permite construir alguns "
"módulos adicionais que usam <xref linkend=\"opencv\"/>."

