#. type: Content of: <sect1><sect2><title>
#: blfs-en/multimedia/libdriv/alsa-plugins.xml:100
#, xml-text
msgid "Installation of ALSA Plugins"
msgstr "Instalação do ALSA Plugins"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/alsa-plugins.xml:103
#, xml-text
msgid "Fix building this package with ffmpeg-9:"
msgstr "Corrija construir esse pacote com ffmpeg-9:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/multimedia/libdriv/alsa-plugins.xml:106
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"pre\">patch -Np1 -i ../alsa-plugins-&alsa-plugins-"
"version;-ffmpeg-9.0.patch</userinput>"
msgstr ""
"<userinput remap=\"pre\">patch -Np1 -i ../alsa-plugins-&alsa-plugins-"
"version;-ffmpeg-9.0.patch</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/alsa-plugins.xml:109
#, xml-text
msgid ""
"Install <application>ALSA Plugins</application> by running the following "
"commands:"
msgstr ""
"Instale o <application>ALSA Plugins</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/multimedia/libdriv/alsa-plugins.xml:113
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --sysconfdir=/etc &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>./configure --sysconfdir=/etc &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/alsa-plugins.xml:117
#, xml-text
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/alsa-plugins.xml:121
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr "Agora, como o(a) usante <systemitem class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/multimedia/libdriv/alsa-plugins.xml:124
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

