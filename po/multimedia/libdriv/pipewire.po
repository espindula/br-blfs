#, xml-text
msgid "Installation of Pipewire"
msgstr "Instalação do Pipewire"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/pipewire.xml:136
#, xml-text
msgid ""
"Install <application>pipewire</application> by running the following "
"commands:"
msgstr ""
"Instale o <application>pipewire</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/multimedia/libdriv/pipewire.xml:140
#, fuzzy, no-wrap, xml-text
#| msgid ""
#| "<userinput>mkdir build &amp;&amp;\n"
#| "cd    build &amp;&amp;\n"
#| "\n"
#| "meson setup ..                             \\\n"
#| "      --prefix=/usr                        \\\n"
#| "      --buildtype=release                  \\\n"
#| "      -D session-managers=\"[]\"             &amp;&amp;\n"
#| "ninja</userinput>"
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup ..                 \\\n"
"      --prefix=/usr            \\\n"
"      --buildtype=release      \\\n"
"      -D session-managers=\"[]\" &amp;&amp;\n"
"ninja</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup ..                             \\\n"
"      --prefix=/usr                        \\\n"
"      --buildtype=release                  \\\n"
"      -D session-managers=\"[]\"             &amp;&amp;\n"
"ninja</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/pipewire.xml:150
#, xml-text
msgid "To test the result, issue: <command>ninja test</command>."
msgstr "Para testar o resultado, emita: <command>ninja test</command>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/pipewire.xml:154
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr "Agora, como o(a) usante <systemitem class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/multimedia/libdriv/pipewire.xml:157
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr "<userinput>ninja install</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/multimedia/libdriv/pipewire.xml:161
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/pipewire.xml:167
#, xml-text
msgid ""
"<parameter>-D session-managers=\"[]\"</parameter>: This switch allows "
"specifying the session managers to build as subprojects.  We specify an "
"empty list to prevent <command>meson</command> from downloading any external"
" copy of the session managers. A Pipewire session manager recommended by the"
" PipeWire developers for general use, <xref linkend=\"wireplumber\" "
"role=\"nodep\"/>, is available as a separate BLFS package.  Build it after "
"installing Pipewire if you need to run the Pipewire daemon (for example in "
"order to support <xref linkend=\"snapshot\" role=\"nodep\"/>)."
msgstr ""
"<parameter>-D session-managers=\"[]\"</parameter>: Essa chave permite "
"especificar-se os gerenciadores de sessão para construir-se como "
"subprojetos. Nós especificamos uma lista vazia para evitar que "
"<command>meson</command> baixe qualquer cópia externa dos gerenciadores de "
"sessão. Um gerenciador de sessão do Pipewire recomendado pelos(as) "
"desenvolvedores(as) do PipeWire para uso geral, <xref "
"linkend=\"wireplumber\" role=\"nodep\"/>, está disponível como um pacote do "
"BLFS separado. Construa-o depois de instalar Pipewire se você precisar "
"executar o processo de segundo plano do Pipewire (por exemplo, para a "
"finalidade de suportar <xref linkend=\"snapshot\" role=\"nodep\"/>)."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/pipewire.xml:179
#, xml-text
msgid ""
"<option>-D docs=true</option>: This switch enables the generation of HTML "
"documentation. The optional dependencies for documentation need to be "
"installed for this to work."
msgstr ""
"<option>-D docs=true</option>: Essa chave habilita a geração de documentação"
" HTML. As dependências opcionais para documentação precisam estar instaladas"
" para isso funcionar."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/pipewire.xml:185
#, xml-text
msgid ""
"<option>-D man=true</option>: This switch enables the generation of manual "
"pages. The optional dependencies for documentation need to be installed for "
"this to work."
msgstr ""
"<option>-D man=true</option>: Essa chave habilita a geração de páginas de "
"manual. As dependências opcionais para documentação precisam estar "
"instaladas para isso funcionar."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/pipewire.xml:191
#, xml-text
msgid ""
"<option>-D ffmpeg=enabled</option>: This switch enables using ffmpeg for "
"audio conversion as a SPA backend."
msgstr ""
"<option>-D ffmpeg=enabled</option>: Essa chave habilita usar FFmpeg para "
"conversão de áudio como uma estrutura de retaguarda SPA."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/pipewire.xml:196
#, xml-text
msgid ""
"<option>-D vulkan=enabled</option>: This switch enables using Vulkan for "
"video rendering as a SPA backend."
msgstr ""
"<option>-D vulkan=enabled</option>: Essa chave habilita usar Vulkan para "
"renderização de vídeo como uma estrutura de retaguarda do SPA."

