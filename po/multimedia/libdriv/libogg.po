#. type: Content of: <sect1><sect2><title>
#: blfs-en/multimedia/libdriv/libogg.xml:73
#, xml-text
msgid "Installation of libogg"
msgstr "Instalação do libogg"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/libogg.xml:76
#, xml-text
msgid ""
"Install <application>libogg</application> by running the following commands:"
msgstr ""
"Instale o <application>libogg</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/multimedia/libdriv/libogg.xml:80
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr    \\\n"
"            --disable-static \\\n"
"            --docdir=/usr/share/doc/libogg-&libogg-version; &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>./configure --prefix=/usr    \\\n"
"            --disable-static \\\n"
"            --docdir=/usr/share/doc/libogg-&libogg-version; &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/libogg.xml:86
#, xml-text
msgid "To test the results, issue: <command>make check</command>."
msgstr "Para testar os resultados, emita: <command>make check</command>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/libogg.xml:90
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/multimedia/libdriv/libogg.xml:93
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

