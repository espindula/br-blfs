#. type: Content of: <sect1><sect2><title>
#: blfs-en/multimedia/libdriv/libdvdnav.xml:80
#, xml-text
msgid "Installation of Libdvdnav"
msgstr "Instalação do Libdvdnav"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/libdvdnav.xml:83
#, xml-text
msgid ""
"Install <application>libdvdnav</application> by running the following "
"commands:"
msgstr ""
"Instale o <application>libdvdnav</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/multimedia/libdriv/libdvdnav.xml:87
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr    \\\n"
"            --disable-static \\\n"
"            --docdir=/usr/share/doc/libdvdnav-&libdvdnav-version; &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>./configure --prefix=/usr    \\\n"
"            --disable-static \\\n"
"            --docdir=/usr/share/doc/libdvdnav-&libdvdnav-version; &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/libdvdnav.xml:93
#, xml-text
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/libdvdnav.xml:97
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/multimedia/libdriv/libdvdnav.xml:100
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

