#. type: Content of: <sect1><sect2><title>
#: blfs-en/multimedia/libdriv/libdvdnav.xml:80
#, xml-text
msgid "Installation of libdvdnav"
msgstr "Instalação do libdvdnav"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/libdvdnav.xml:83
#, xml-text
msgid "First, install the documentation in a versioned directory:"
msgstr "Primeiro, instale a documentação em um diretório versionado:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/multimedia/libdriv/libdvdnav.xml:86
#, no-wrap, xml-text
msgid ""
"<userinput>sed -i \"/get_option/s/libdvdnav/&amp;-&libdvdnav-version;/\" "
"meson.build</userinput>"
msgstr ""
"<userinput>sed -i \"/get_option/s/libdvdnav/&amp;-&libdvdnav-version;/\" "
"meson.build</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/libdvdnav.xml:89
#, xml-text
msgid ""
"Install <application>libdvdnav</application> by running the following "
"commands:"
msgstr ""
"Instale o <application>libdvdnav</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/multimedia/libdriv/libdvdnav.xml:93
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr       \\\n"
"            --buildtype=release \\\n"
"            --default-library=shared .. &amp;&amp;\n"
"ninja</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr       \\\n"
"            --buildtype=release \\\n"
"            --default-library=shared .. &amp;&amp;\n"
"ninja</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/libdvdnav.xml:102
#, xml-text
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/libdvdnav.xml:106
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/multimedia/libdriv/libdvdnav.xml:109
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr "<userinput>ninja install</userinput>"

