#: blfs-en/multimedia/libdriv/sound-theme-freedesktop.xml:76
#, xml-text
msgid ""
"Install <application>Sound Theme Freedesktop</application> by running the "
"following commands:"
msgstr ""
"Instale o <application>Sound Theme Freedesktop</application> executando os "
"seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/multimedia/libdriv/sound-theme-freedesktop.xml:80
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>./configure --prefix=/usr &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/sound-theme-freedesktop.xml:84
#, xml-text
msgid "This package does not come with a test suite."
