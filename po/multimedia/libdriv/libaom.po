#. type: Content of: <sect1><sect2><title>
#: blfs-en/multimedia/libdriv/libaom.xml:103
#, xml-text
msgid "Installation of libaom"
msgstr "Instalação do libaom"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/libaom.xml:117
#, xml-text
msgid "Prevent installing static versions of the libraries:"
msgstr "Impeça instalação de versões estáticas das bibliotecas:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/multimedia/libdriv/libaom.xml:120
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"pre\">sed -i 's/aom aom_static/aom/' "
"build/cmake/aom_install.cmake</userinput>"
msgstr ""
"<userinput remap=\"pre\">sed -i 's/aom aom_static/aom/' "
"build/cmake/aom_install.cmake</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/libaom.xml:123
#, xml-text
msgid ""
"Install <application>libaom</application> by running the following commands:"
msgstr ""
"Instale o <application>libaom</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/multimedia/libdriv/libaom.xml:127
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir aom-build &amp;&amp;\n"
"cd    aom-build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr \\\n"
"      -D CMAKE_BUILD_TYPE=Release  \\\n"
"      -D BUILD_SHARED_LIBS=1       \\\n"
"      -D ENABLE_DOCS=no            \\\n"
"      -G Ninja .. &amp;&amp;\n"
"ninja</userinput>"
msgstr ""
"<userinput>mkdir aom-build &amp;&amp;\n"
"cd    aom-build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr \\\n"
"      -D CMAKE_BUILD_TYPE=Release  \\\n"
"      -D BUILD_SHARED_LIBS=1       \\\n"
"      -D ENABLE_DOCS=no            \\\n"
"      -G Ninja .. &amp;&amp;\n"
"ninja</userinput>"

#. To test the results, issue: <command>
#. ninja testdata &amp;&amp; ninja runtests</command>.
#.       Note that the tests take an extremely long time to run.
#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/libaom.xml:138
#, xml-text
msgid "This package does not come with a working test suite."
msgstr "Esse pacote não vem com uma suíte de teste funcional."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/libaom.xml:144
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/multimedia/libdriv/libaom.xml:147
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr "<userinput>ninja install</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/multimedia/libdriv/libaom.xml:152
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/libaom.xml:155
#, xml-text
msgid ""
"<parameter>-D BUILD_SHARED_LIBS=1</parameter>: This switch builds shared "
"versions of the libraries."
msgstr ""
"<parameter>-D BUILD_SHARED_LIBS=1</parameter>: Essa chave constrói versões "
"compartilhadas das bibliotecas."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/libaom.xml:160
#, xml-text
msgid ""
"<parameter>-D ENABLE_DOCS=no</parameter>: This switch disables building the "
"documentation because it fails due to an incompatibility with the latest "
"version of <xref role=\"nodep\" linkend=\"doxygen\"/>."
msgstr ""
"<parameter>-D ENABLE_DOCS=no</parameter>: Essa chave desabilita a construção"
" da documentação porque ela falha devido a uma incompatibilidade com a "
"versão mais recente do <xref role=\"nodep\" linkend=\"doxygen\"/>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/libaom.xml:166
#, xml-text
msgid ""
"<option>-D ENABLE_NASM=yes</option>: Use this switch if you have both <xref "
"linkend=\"yasm\"/> and <xref role=\"nodep\" linkend=\"nasm\"/> installed and"
" wish to use nasm instead of yasm."
msgstr ""
"<option>-D ENABLE_NASM=yes</option>: Use essa chave se você tiver ambos, "
"<xref linkend=\"yasm\"/> e <xref role=\"nodep\" linkend=\"nasm\"/>, "
"instalados e desejar usar nasm em vez do yasm."

