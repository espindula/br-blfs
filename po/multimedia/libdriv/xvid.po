#. type: Content of: <sect1><sect2><title>
#: blfs-en/multimedia/libdriv/xvid.xml:78
#, xml-text
msgid "Installation of XviD"
msgstr "Instalação do XviD"

#. type: Content of: <sect1><sect2><note><para>
#: blfs-en/multimedia/libdriv/xvid.xml:82
#, xml-text
msgid ""
"This package tarball expands to <filename "
"class='directory'>xvidcore</filename>, not the expected <filename "
"class='directory'>xvidcore-&xvid-version;</filename>."
msgstr ""
"Esse tarball do pacote se expande para <filename "
"class='directory'>xvidcore</filename>, não para o esperado <filename "
"class='directory'>xvidcore-&xvid-version;</filename>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/xvid.xml:90
#, xml-text
msgid "First, fix a problem when building with gcc-15:"
msgstr "Primeiro, corrija um problema ao construir com gcc-15:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/multimedia/libdriv/xvid.xml:93
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"pre\">sed -i '/typedef int bool;/d' "
"src/encoder.h</userinput>"
msgstr ""
"<userinput remap=\"pre\">sed -i '/typedef int bool;/d' "
"src/encoder.h</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/xvid.xml:96
#, xml-text
msgid ""
"Install <application>XviD</application> by running the following commands:"
msgstr ""
"Instale o <application>XviD</application> executando os seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/multimedia/libdriv/xvid.xml:100
#, no-wrap, xml-text
msgid ""
"<userinput>cd build/generic &amp;&amp;\n"
"sed -i 's/^LN_S=@LN_S@/&amp; -f -v/' platform.inc.in &amp;&amp;\n"
"\n"
"./configure --prefix=/usr &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>cd build/generic &amp;&amp;\n"
"sed -i 's/^LN_S=@LN_S@/&amp; -f -v/' platform.inc.in &amp;&amp;\n"
"\n"
"./configure --prefix=/usr &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/xvid.xml:107
#, xml-text
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/xvid.xml:111
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/multimedia/libdriv/xvid.xml:114
#, no-wrap, xml-text
msgid ""
"<userinput>sed -i '/libdir.*STATIC_LIB/ s/^/#/' Makefile &amp;&amp;\n"
"make install &amp;&amp;\n"
"\n"
"chmod -v 755 /usr/lib/libxvidcore.so.4.3 &amp;&amp;\n"
"install -v -m755 -d /usr/share/doc/xvidcore-&xvid-version;/examples &amp;&amp;\n"
"install -v -m644 ../../doc/* /usr/share/doc/xvidcore-&xvid-version; &amp;&amp;\n"
"install -v -m644 ../../examples/* \\\n"
"    /usr/share/doc/xvidcore-&xvid-version;/examples</userinput>"
msgstr ""
"<userinput>sed -i '/libdir.*STATIC_LIB/ s/^/#/' Makefile &amp;&amp;\n"
"make install &amp;&amp;\n"
"\n"
"chmod -v 755 /usr/lib/libxvidcore.so.4.3 &amp;&amp;\n"
"install -v -m755 -d /usr/share/doc/xvidcore-&xvid-version;/examples &amp;&amp;\n"
"install -v -m644 ../../doc/* /usr/share/doc/xvidcore-&xvid-version; &amp;&amp;\n"
"install -v -m644 ../../examples/* \\\n"
"    /usr/share/doc/xvidcore-&xvid-version;/examples</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/multimedia/libdriv/xvid.xml:126
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/xvid.xml:129
#, xml-text
msgid ""
"<command>sed -i 's/^LN_S=@LN_S@/&amp; -f -v/' platform.inc.in</command>: Fix"
" error during <command>make install</command> if reinstalling or upgrading."
msgstr ""
"<command>sed -i 's/^LN_S=@LN_S@/&amp; -f -v/' platform.inc.in</command>: "
"Corrija erro durante <command>make install</command> se reinstalar ou "
"atualizar."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/xvid.xml:135
#, xml-text
msgid ""
"<command>sed -i '/libdir.*STATIC_LIB/ s/^/#/' Makefile</command>: This "
"command disables installing the static library."
msgstr ""
"<command>sed -i '/libdir.*STATIC_LIB/ s/^/#/' Makefile</command>: Esse "
"comando desabilita instalar a biblioteca estática."

