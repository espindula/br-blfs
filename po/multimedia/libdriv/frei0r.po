#. type: Content of: <sect1><sect2><title>
#: blfs-en/multimedia/libdriv/frei0r.xml:95
#, xml-text
msgid "Installation of frei0r"
msgstr "Instalação do frei0r"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/frei0r.xml:98
#, xml-text
msgid ""
"Install <application>Frei0r</application> by running the following commands:"
msgstr ""
"Instale o <application>Frei0r</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/multimedia/libdriv/frei0r.xml:102
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir -vp build &amp;&amp;\n"
"cd        build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr \\\n"
"      -D CMAKE_BUILD_TYPE=Release  \\\n"
"      -W no-dev .. &amp;&amp;\n"
"\n"
"make</userinput>"
msgstr ""
"<userinput>mkdir -vp build &amp;&amp;\n"
"cd        build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr \\\n"
"      -D CMAKE_BUILD_TYPE=Release  \\\n"
"      -W no-dev .. &amp;&amp;\n"
"\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/frei0r.xml:112
#, xml-text
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/frei0r.xml:116
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/multimedia/libdriv/frei0r.xml:119
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/multimedia/libdriv/frei0r.xml:124
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/frei0r.xml:127
#, xml-text
msgid ""
"<option>-D WITHOUT_OPENCV=TRUE</option>: This option instructs the make "
"procedure to disable building plugins dependent upon opencv."
msgstr ""
"<option>-D WITHOUT_OPENCV=TRUE</option>: Essa opção instrui o procedimento "
"make a desabilitar a construção de plugins dependentes do opencv."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/frei0r.xml:132
#, xml-text
msgid ""
"<option>-D WITHOUT_GAVL=TRUE</option>: This option instructs the make "
"procedure to disable building plugins dependent upon gavl."
msgstr ""
"<option>-D WITHOUT_GAVL=TRUE</option>: Essa opção instrui o procedimento "
"make a desabilitar a construção de plugins dependentes do gavl."

