#, xml-text
msgid "Introduction to Frei0r"
msgstr "Introdução ao Frei0r"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/frei0r.xml:29
#, xml-text
msgid ""
"<application>Frei0r</application> is a minimalistic plugin API for video "
"effects. Note that the 0 in the name is a zero, not a capital letter o."
msgstr ""
"<application>Frei0r</application> é uma API minimalista de plugin para "
"efeitos de vídeo. Observe que o 0 no nome é um zero, não uma letra maiúscula"
" o."

