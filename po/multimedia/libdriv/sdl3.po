#. type: Content of: <sect1><sect2><title>
#: blfs-en/multimedia/libdriv/sdl3.xml:100
#, xml-text
msgid "Installation of SDL3"
msgstr "Instalação do SDL3"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/sdl3.xml:103
#, xml-text
msgid ""
"Install <application>SDL3</application> by running the following commands:"
msgstr ""
"Instale <application>SDL3</application> executando os seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/multimedia/libdriv/sdl3.xml:107
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr \\\n"
"      -D CMAKE_BUILD_TYPE=Release  \\\n"
"      -D SDL_TEST_LIBRARY=OFF      \\\n"
"      -D SDL_STATIC=OFF            \\\n"
"      -D SDL_RPATH=OFF             \\\n"
"      -W no-dev -G Ninja ..       &amp;&amp;\n"
"\n"
"ninja</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr \\\n"
"      -D CMAKE_BUILD_TYPE=Release  \\\n"
"      -D SDL_TEST_LIBRARY=OFF      \\\n"
"      -D SDL_STATIC=OFF            \\\n"
"      -D SDL_RPATH=OFF             \\\n"
"      -W no-dev -G Ninja ..       &amp;&amp;\n"
"\n"
"ninja</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/sdl3.xml:120
#, xml-text
msgid "Now, as the &root; user:"
msgstr "Agora, como o(a) usuário(a) &root;:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/multimedia/libdriv/sdl3.xml:123
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr "<userinput>ninja install</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/multimedia/libdriv/sdl3.xml:128
#, xml-text
msgid "Testing SDL3"
msgstr "Testando SDL3"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/sdl3.xml:131
#, xml-text
msgid "If you want to build the tests, issue the following commands:"
msgstr "Se você quiser construir os testes, emita os seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/multimedia/libdriv/sdl3.xml:134
#, no-wrap, xml-text
msgid ""
"<literal>mkdir ../build-tests &amp;&amp;\n"
"cd    ../build-tests &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr \\\n"
"      -D CMAKE_BUILD_TYPE=Release  \\\n"
"      -D SDL_STATIC=OFF            \\\n"
"      -D SDL_RPATH=OFF             \\\n"
"      -D SDL_TESTS=ON              \\\n"
"      -D SDL_INSTALL_TESTS=ON      \\\n"
"      -W no-dev -G Ninja ..       &amp;&amp;\n"
"\n"
"ninja &amp;&amp;\n"
"DESTDIR=$PWD/TESTS ninja install</literal>"
msgstr ""
"<literal>mkdir ../build-tests &amp;&amp;\n"
"cd    ../build-tests &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr \\\n"
"      -D CMAKE_BUILD_TYPE=Release  \\\n"
"      -D SDL_STATIC=OFF            \\\n"
"      -D SDL_RPATH=OFF             \\\n"
"      -D SDL_TESTS=ON              \\\n"
"      -D SDL_INSTALL_TESTS=ON      \\\n"
"      -W no-dev -G Ninja ..       &amp;&amp;\n"
"\n"
"ninja &amp;&amp;\n"
"DESTDIR=$PWD/TESTS ninja install</literal>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/sdl3.xml:149
#, xml-text
msgid ""
"Now you will be able to run the tests in <filename "
"class=\"directory\">TESTS/usr/libexec/installed-tests/SDL3</filename>. You "
"will have to run the tests individually. Some of them may need to be "
"manually killed and audio will need to be working so that you can hear from "
"the default audio output."
msgstr ""
"Agora você estará apto(a) para executar os testes em <filename "
"class=\"directory\">TESTS/usr/libexec/installed-tests/SDL3</filename>. Você "
"terá que executar os testes individualmente. Alguns deles possivelmente "
"precisem ser encerrados manualmente e o áudio precisará estar funcionando "
"para que você consiga ouvir a partir da saída padrão de áudio."

#. type: Content of: <sect1><sect2><title>
#: blfs-en/multimedia/libdriv/sdl3.xml:159
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/sdl3.xml:162
#, xml-text
msgid ""
"<parameter>-D SDL_TEST_LIBRARY=OFF</parameter>: This parameter disables "
"building an unnecessary static library meant for the tests. It gets built in"
" the testing section."
msgstr ""
"<parameter>-D SDL_TEST_LIBRARY=OFF</parameter>: Esse parâmetro desabilita "
"construir uma biblioteca estática desnecessária destinada para os testes. "
"Ela será construída na seção de testagem."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/sdl3.xml:168
#, xml-text
msgid ""
"<parameter>-D SDL_STATIC=OFF</parameter>: This parameter disables building "
"static libraries."
msgstr ""
"<parameter>-D SDL_STATIC=OFF</parameter>: Esse parâmetro desabilita "
"construir bibliotecas estáticas."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/sdl3.xml:173
#, xml-text
msgid ""
"<parameter>-D SDL_RPATH=OFF</parameter>: This parameter disables installing "
"with rpath. It can cause security issues otherwise."
msgstr ""
"<parameter>-D SDL_RPATH=OFF</parameter>: Esse parâmetro desabilita instalar "
"com rpath. Caso contrário, isso pode causar problemas de segurança."

