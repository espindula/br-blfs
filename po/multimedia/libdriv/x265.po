#. type: Content of: <sect1><sect2><title>
#: blfs-en/multimedia/libdriv/x265.xml:89
#, xml-text
msgid "Installation of x265"
msgstr "Instalação do x265"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/x265.xml:92
#, xml-text
msgid ""
"Install <application>x265</application> by running the following commands:"
msgstr ""
"Instale o <application>x265</application> executando os seguintes comandos:"

#.  the default build is Release, no need to specify that
#. type: Content of: <sect1><sect2><screen>
#: blfs-en/multimedia/libdriv/x265.xml:97
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir bld &amp;&amp;\n"
"cd    bld &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr \\\n"
"      -D GIT_ARCHETYPE=1           \\\n"
"      -W no-dev                    \\\n"
"      ../source                    &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>mkdir bld &amp;&amp;\n"
"cd    bld &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr \\\n"
"      -D GIT_ARCHETYPE=1           \\\n"
"      -W no-dev                    \\\n"
"      ../source                    &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/x265.xml:107
#, xml-text
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/x265.xml:135
#, xml-text
msgid ""
"To install the package, first remove any old library versions.  After "
"installation, remove a static library.  As the &root; user:"
msgstr ""
"Para instalar o pacote, primeiro remova quaisquer versões antigas da "
"biblioteca. Depois da instalação, remova uma biblioteca estática. Como o(a) "
"usuário(a) &root;:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/multimedia/libdriv/x265.xml:140
#, no-wrap, xml-text
msgid ""
"<userinput>make install &amp;&amp;\n"
"rm -vf /usr/lib/libx265.a</userinput>"
msgstr ""
"<userinput>make install &amp;&amp;\n"
"rm -vf /usr/lib/libx265.a</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/multimedia/libdriv/x265.xml:146
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/x265.xml:149
#, xml-text
msgid ""
"<parameter>-W no-dev</parameter>: This switch is used to suppress warnings "
"intended for the package developers."
msgstr ""
"<parameter>-W no-dev</parameter>: Essa chave é usada para suprimir avisos "
"destinados para os(as) desenvolvedores(as) do pacote."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/x265.xml:154
#, xml-text
msgid ""
"<parameter>-D GIT_ARCHETYPE=1</parameter>: This switch is needed because the"
" build system will not generate a pkg-config file or install a shared "
"library unless <xref linkend=\"git\"/> is installed. Git isn't required for "
"anything else in this package, so this switch is used to work around it for "
"users who do not want to install Git as a build dependency."
msgstr ""
"<parameter>-D GIT_ARCHETYPE=1</parameter>: Essa chave é necessária porque o "
"sistema de construção não gerará um arquivo de pkg-config ou instalará uma "
"biblioteca compartilhada, a menos que <xref linkend=\"git\"/> esteja "
"instalado. O Git não é exigido para mais nada nesse pacote, de forma que "
"essa chave é usada para contornar isso para usuários(as) que não queiram "
"instalar o Git como uma dependência de construção."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/x265.xml:163
#, xml-text
msgid ""
"<command>rm -vf /usr/lib/libx265.a</command>: BLFS does not recommend using "
"static libraries."
msgstr ""
"<command>rm -vf /usr/lib/libx265.a</command>: O BLFS não recomenda usar "
"bibliotecas estáticas."

