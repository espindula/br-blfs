#, xml-text
msgid "Installation of libmpeg2"
msgstr "Instalação do libmpeg2"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/libmpeg2.xml:87
#, xml-text
msgid ""
"Install <application>libmpeg2</application> by running the following "
"commands:"
msgstr ""
"Instale o <application>libmpeg2</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/multimedia/libdriv/libmpeg2.xml:91
#, no-wrap, xml-text
msgid ""
"<userinput>sed -i 's/static const/static/' libmpeg2/idct_mmx.c &amp;&amp;\n"
"\n"
"./configure --prefix=/usr    \\\n"
"            --enable-shared  \\\n"
"            --disable-static &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>sed -i 's/static const/static/' libmpeg2/idct_mmx.c &amp;&amp;\n"
"\n"
"./configure --prefix=/usr    \\\n"
"            --enable-shared  \\\n"
"            --disable-static &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/libmpeg2.xml:99
#, xml-text
msgid ""
"To test the results, issue: <command>make check</command>. To perform a more"
" comprehensive regression test, see the file "
"<filename>test/README</filename> in the source tree."
msgstr ""
"Para testar os resultados, emita: <command>make check</command>. Para "
"realizar um teste de regressão mais abrangente, veja-se o arquivo "
"<filename>test/README</filename> na árvore do fonte."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/libmpeg2.xml:105
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/multimedia/libdriv/libmpeg2.xml:108
#, no-wrap, xml-text
msgid ""
"<userinput>make install &amp;&amp;\n"
"\n"
"install -v -m755 -d /usr/share/doc/libmpeg2-&libmpeg2-version; &amp;&amp;\n"
"install -v -m644 README doc/libmpeg2.txt \\\n"
"                    /usr/share/doc/libmpeg2-&libmpeg2-version;</userinput>"
msgstr ""
"<userinput>make install &amp;&amp;\n"
"\n"
"install -v -m755 -d /usr/share/doc/libmpeg2-&libmpeg2-version; &amp;&amp;\n"
"install -v -m644 README doc/libmpeg2.txt \\\n"
"                    /usr/share/doc/libmpeg2-&libmpeg2-version;</userinput>"

