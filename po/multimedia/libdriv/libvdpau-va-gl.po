#. type: Content of: <sect1><sect2><title>
#: blfs-en/multimedia/libdriv/libvdpau-va-gl.xml:98
#, xml-text
msgid "Installation of libvdpau-va-gl"
msgstr "Instalação do libvdpau-va-gl"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/libvdpau-va-gl.xml:101
#, xml-text
msgid ""
"Install <application>libvdpau-va-gl</application> by running the following "
"commands:"
msgstr ""
"Instale o <application>libvdpau-va-gl</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/multimedia/libdriv/libvdpau-va-gl.xml:105
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=$XORG_PREFIX \\\n"
"      -D CMAKE_POLICY_VERSION_MINIMUM=3.5  \\\n"
"      -D CMAKE_BUILD_TYPE=Release          \\\n"
"      -W no-dev ..                         &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=$XORG_PREFIX \\\n"
"      -D CMAKE_POLICY_VERSION_MINIMUM=3.5  \\\n"
"      -D CMAKE_BUILD_TYPE=Release          \\\n"
"      -W no-dev ..                         &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/libvdpau-va-gl.xml:115
#, xml-text
msgid ""
"To test the results, issue: <command>make check</command>.  The tests must "
"be run from an Xorg environment."
msgstr ""
"Para testar os resultados, emita: <command>make check</command>. Os testes "
"precisam ser executados a partir de um ambiente do Xorg."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/libvdpau-va-gl.xml:120
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/multimedia/libdriv/libvdpau-va-gl.xml:123
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/multimedia/libdriv/libvdpau-va-gl.xml:140
#, xml-text
msgid "Configuration"
msgstr "Configuração"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/libvdpau-va-gl.xml:143
#, xml-text
msgid ""
"To allow libvdpau to find libvdpau-va-gl, set an environment variable.  As "
"the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Para permitir que a libvdpau encontre libvdpau-va-gl, configure uma variável"
" de ambiente. Como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/multimedia/libdriv/libvdpau-va-gl.xml:147
#, no-wrap, xml-text
msgid ""
"<userinput>echo \"export VDPAU_DRIVER=va_gl\" >> "
"/etc/profile.d/xorg.sh</userinput>"
msgstr ""
"<userinput>echo \"export VDPAU_DRIVER=va_gl\" >> "
"/etc/profile.d/xorg.sh</userinput>"

