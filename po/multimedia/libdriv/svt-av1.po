#: blfs-en/multimedia/libdriv/svt-av1.xml:129
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/svt-av1.xml:132
#, xml-text
msgid ""
"<parameter>-D BUILD_SHARED_LIBS=ON</parameter>: This parameter forces "
"building shared versions of the libraries."
msgstr ""
"<parameter>-D BUILD_SHARED_LIBS=ON</parameter>: Esse parâmetro força "
"construir versões compartilhadas das bibliotecas."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/svt-av1.xml:140
#, xml-text
msgid ""
"<option>-D BUILD_TESTING=ON</option>: This option enables building the unit "
"tests."
msgstr ""
"<option>-D BUILD_TESTING=ON</option>: Essa opção habilita construir os "
"testes de unidade."

