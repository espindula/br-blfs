#. type: Content of: <sect1><sect2><title>
#: blfs-en/multimedia/libdriv/alsa-oss.xml:80
msgid "Installation of ALSA OSS"
msgstr "Instalação do ALSA OSS"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/alsa-oss.xml:83
msgid ""
"Install <application>ALSA OSS</application> by running the following "
"commands:"
msgstr ""
"Instale o <application>ALSA OSS</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/multimedia/libdriv/alsa-oss.xml:87
#, no-wrap
msgid ""
"<userinput>./configure --disable-static &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>./configure --disable-static &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/alsa-oss.xml:91
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/alsa-oss.xml:95
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/multimedia/libdriv/alsa-oss.xml:98
#, no-wrap
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

