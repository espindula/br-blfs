#. type: Content of: <sect1><sect2><title>
#: blfs-en/multimedia/libdriv/alsa-oss.xml:26
msgid "Introduction to alsa-oss"
msgstr "Introdução ao alsa-oss"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/alsa-oss.xml:29
msgid ""
"The <application>alsa-oss</application> package contains the alsa-oss "
"compatibility library. This is used by programs which wish to use the alsa-"
"oss sound interface."
msgstr ""
"O pacote <application>alsa-oss</application> contém a biblioteca de "
"compatibilidade alsa-oss. Isso é usado por aplicativos que desejem usar a "
"interface de som alsa-oss."

