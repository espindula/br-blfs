#. type: Content of: <sect1><sect2><title>
#: blfs-en/multimedia/libdriv/libsndfile.xml:90
#, xml-text
msgid "Installation of libsndfile"
msgstr "Instalação do libsndfile"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/libsndfile.xml:93
#, xml-text
msgid "Fix building with <application>GCC-15</application>:"
msgstr "Corrija construir com <application>GCC-15</application>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/multimedia/libdriv/libsndfile.xml:96
#, no-wrap, xml-text
msgid ""
"<userinput>sed -i '/typedef enum/,/bool ;/d' "
"src/ALAC/alac_{en,de}coder.c</userinput>"
msgstr ""
"<userinput>sed -i '/typedef enum/,/bool ;/d' "
"src/ALAC/alac_{en,de}coder.c</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/libsndfile.xml:99
#, xml-text
msgid ""
"Install <application>libsndfile</application> by running the following "
"commands:"
msgstr ""
"Instale o <application>libsndfile</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/multimedia/libdriv/libsndfile.xml:103
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr    \\\n"
"            --docdir=/usr/share/doc/libsndfile-&libsndfile-version; &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>./configure --prefix=/usr    \\\n"
"            --docdir=/usr/share/doc/libsndfile-&libsndfile-version; &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/libsndfile.xml:110
#, xml-text
msgid ""
"If running the test suite, disable the Opus tests which would fail with the "
"recent Opus release and cause the test suite to bail out early:"
msgstr ""
"Se executar a suíte de teste, desabilite os testes do Opus os quais "
"falhariam com o lançamento recente do Opus e faria com que a suíte de teste "
"saísse mais cedo:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/multimedia/libdriv/libsndfile.xml:114
#, no-wrap, xml-text
msgid ""
"<userinput>sed '/ogg_opus/,+1s/HAVE_[A-Z_]*/0/' -i "
"tests/lossy_comp_test.c</userinput>"
msgstr ""
"<userinput>sed '/ogg_opus/,+1s/HAVE_[A-Z_]*/0/' -i "
"tests/lossy_comp_test.c</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/libsndfile.xml:117
#, xml-text
msgid "To test the results, issue: <command>make check</command>."
msgstr "Para testar os resultados, emita: <command>make check</command>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/libsndfile.xml:121
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/multimedia/libdriv/libsndfile.xml:124
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

