#. type: Content of: <sect1><sect2><title>
#: blfs-en/multimedia/libdriv/libcanberra.xml:27
#, xml-text
msgid "Introduction to libcanberra"
msgstr "Introdução ao libcanberra"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/libdriv/libcanberra.xml:30
#, xml-text
msgid ""
"<application>libcanberra</application> is an implementation of the XDG Sound"
" Theme and Name Specifications, for generating event sounds on free "
"desktops, such as <application>GNOME</application>."
msgstr ""
"<application>libcanberra</application> é uma implementação das "
"Especificações de Nome e de Tema de Som XDG, para gerar sons de eventos em "
"áreas de trabalho livres, tais como o <application>GNOME</application>."

