#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/cdwriteutils/dvd+rw-tools.xml:97
#, xml-text
msgid ""
"First, apply a patch that fixes several bugs and fixes compiling with newer "
"versions of glibc and the kernel headers:"
msgstr ""
"Primeiro, aplique um remendo que corrige vários defeitos e corrige "
"compilação com versões mais recentes da glibc e os cabeçalhos do núcleo:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/multimedia/cdwriteutils/dvd+rw-tools.xml:101
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"pre\">patch -Np1 -i ../dvd+rw-tools-&dvd-rw-tools-"
"version;-consolidated_fixes-2.patch</userinput>"
msgstr ""
"<userinput remap=\"pre\">patch -Np1 -i ../dvd+rw-tools-&dvd-rw-tools-"
"version;-consolidated_fixes-2.patch</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/cdwriteutils/dvd+rw-tools.xml:104
#, xml-text
msgid ""
"Install <application>dvd+rw-tools</application> by running the following "
"commands:"
msgstr ""
"Instale o <application>dvd+rw-tools</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/multimedia/cdwriteutils/dvd+rw-tools.xml:108
#, no-wrap, xml-text
msgid "<userinput>make all rpl8 btcflash</userinput>"
msgstr "<userinput>make all rpl8 btcflash</userinput>"

