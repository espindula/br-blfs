#. type: Content of: <sect1><sect2><title>
#: blfs-en/multimedia/cdwriteutils/cdrdao.xml:26
#, xml-text
msgid "Introduction to Cdrdao"
msgstr "Introdução ao Cdrdao"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/cdwriteutils/cdrdao.xml:29
#, xml-text
msgid ""
"The <application>Cdrdao</application> package contains CD recording "
"utilities. These are useful for burning a CD in disk-at-once mode."
msgstr ""
"O pacote <application>Cdrdao</application> contém utilitários de gravação de"
" CD. Eles são úteis para gravar um CD no modo disco de uma vez."

