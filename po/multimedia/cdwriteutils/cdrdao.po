#. type: Content of: <sect1><sect2><title>
#: blfs-en/multimedia/cdwriteutils/cdrdao.xml:82
#, xml-text
msgid "Installation of Cdrdao"
msgstr "Instalação do Cdrdao"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/cdwriteutils/cdrdao.xml:85
#, xml-text
msgid ""
"Install <application>Cdrdao</application> by running the following commands:"
msgstr ""
"Instale o <application>Cdrdao</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/multimedia/cdwriteutils/cdrdao.xml:89
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr --mandir=/usr/share/man &amp;&amp;\n"
"make CC=\"gcc -std=gnu17\"</userinput>"
msgstr ""
"<userinput>./configure --prefix=/usr --mandir=/usr/share/man &amp;&amp;\n"
"make CC=\"gcc -std=gnu17\"</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/cdwriteutils/cdrdao.xml:93
#, xml-text
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/cdwriteutils/cdrdao.xml:97
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr "Agora, como o(a) usante <systemitem class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/multimedia/cdwriteutils/cdrdao.xml:100
#, no-wrap, xml-text
msgid ""
"<userinput>make install &amp;&amp;\n"
"install -v -m755 -d /usr/share/doc/cdrdao-&cdrdao-version; &amp;&amp;\n"
"install -v -m644 README /usr/share/doc/cdrdao-&cdrdao-version;</userinput>"
msgstr ""
"<userinput>make install &amp;&amp;\n"
"install -v -m755 -d /usr/share/doc/cdrdao-&cdrdao-version; &amp;&amp;\n"
"install -v -m644 README /usr/share/doc/cdrdao-&cdrdao-version;</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/multimedia/cdwriteutils/cdrdao.xml:107
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/cdwriteutils/cdrdao.xml:110
#, xml-text
msgid ""
"<command>--mandir=/usr/share/man</command>: Install manual pages in "
"/usr/share/man instead of /usr/man."
msgstr ""
"<command>--mandir=/usr/share/man</command>: Instale páginas de manual em "
"/usr/share/man em vez de /usr/man."

