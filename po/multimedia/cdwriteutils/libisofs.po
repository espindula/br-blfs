#. type: Content of: <sect1><sect2><title>
#: blfs-en/multimedia/cdwriteutils/libisofs.xml:87
#, xml-text
msgid "Installation of libisofs"
msgstr "Instalação do libisofs"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/cdwriteutils/libisofs.xml:90
#, xml-text
msgid ""
"Install <application>libisofs</application> by running the following "
"commands:"
msgstr ""
"Instale o <application>libisofs</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/multimedia/cdwriteutils/libisofs.xml:94
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr --disable-static &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>./configure --prefix=/usr --disable-static &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/cdwriteutils/libisofs.xml:98
#, xml-text
msgid ""
"If you have installed <application>Doxygen</application> and wish to "
"generate the HTML documentation, issue the following command:"
msgstr ""
"Se você tiver instalado o <application>Doxygen</application> e desejar gerar"
" a documentação HTML, emita o seguinte comando:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/multimedia/cdwriteutils/libisofs.xml:102
#, no-wrap, xml-text
msgid "<userinput>doxygen doc/doxygen.conf</userinput>"
msgstr "<userinput>doxygen doc/doxygen.conf</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/cdwriteutils/libisofs.xml:105
#, xml-text
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/cdwriteutils/libisofs.xml:109
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr "Agora, como o(a) usante <systemitem class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/multimedia/cdwriteutils/libisofs.xml:112
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/cdwriteutils/libisofs.xml:115
#, xml-text
msgid ""
"If you have built the HTML documentation, install it by running the "
"following commands as the <systemitem class=\"username\">root</systemitem> "
"user:"
msgstr ""
"Se você tiver construído a documentação HTML, instale-a executando os "
"seguintes comandos como o(a) usante <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/multimedia/cdwriteutils/libisofs.xml:120
#, no-wrap, xml-text
msgid ""
"<userinput>install -v -dm755 /usr/share/doc/libisofs-&libisofs-version; &amp;&amp;\n"
"install -v -m644 doc/html/* /usr/share/doc/libisofs-&libisofs-version;</userinput>"
msgstr ""
"<userinput>install -v -dm755 /usr/share/doc/libisofs-&libisofs-version; &amp;&amp;\n"
"install -v -m644 doc/html/* /usr/share/doc/libisofs-&libisofs-version;</userinput>"

