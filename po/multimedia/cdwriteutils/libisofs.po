#: blfs-en/multimedia/cdwriteutils/libisofs.xml:27
#, xml-text
msgid "Introduction to libisofs"
msgstr "Introdução ao libisofs"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/cdwriteutils/libisofs.xml:30
#, xml-text
msgid ""
"<application>libisofs</application> is a library to create an ISO-9660 "
"filesystem with extensions like RockRidge or Joliet."
msgstr ""
"<application>libisofs</application> é uma biblioteca para criar um sistema "
"de arquivos ISO-9660 com extensões como RockRidge ou Joliet."

