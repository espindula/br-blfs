#. type: Content of: <sect1><sect2><segmentedlist><seglistitem><seg>
#: blfs-en/multimedia/videoutils/ffmpeg.xml:527
#, xml-text
msgid ""
"/usr/include/libav{codec,device,filter,format,util}, "
