"mediaportal.com/extensions/mp2-plugins/atmolight\">AtmoLight</ulink>, <ulink"
" url=\"https://github.com/videolabs/libmicrodns\">libmicrodns</ulink> e "
"<ulink url=\"https://github.com/Haivision/srt\">Srt</ulink>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/multimedia/videoutils/vlc.xml:247
#, xml-text
msgid "Installation of VLC"
msgstr "Instalação do VLC"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/videoutils/vlc.xml:250
#, xml-text
msgid ""
"First, add corrections for problems of taglib-2.0 and ffmpeg-7 and later:"
msgstr ""
"Primeiro, adicione correções para problemas do taglib-2.0 e ffmpeg-7 e "
"posteriores:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/multimedia/videoutils/vlc.xml:253
#, no-wrap, xml-text
msgid ""
"<userinput>patch -Np1 -i ../vlc-&vlc-version;-taglib-1.patch         &amp;&amp;\n"
"patch -Np1 -i ../vlc-&vlc-version;-fedora_ffmpeg7-1.patch &amp;&amp;\n"
"patch -Np1 -i ../vlc-&vlc-version;-ffmpeg8-1.patch</userinput>"
msgstr ""
"<userinput>patch -Np1 -i ../vlc-&vlc-version;-taglib-1.patch         &amp;&amp;\n"
"patch -Np1 -i ../vlc-&vlc-version;-fedora_ffmpeg7-1.patch &amp;&amp;\n"
"patch -Np1 -i ../vlc-&vlc-version;-ffmpeg8-1.patch</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/videoutils/vlc.xml:258
#, xml-text
msgid ""
"Install <application>VLC</application> by running the following commands:"
msgstr ""
"Instale o <application>VLC</application> executando os seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/multimedia/videoutils/vlc.xml:261
#, no-wrap, xml-text
msgid ""
"<userinput>BUILDCC=gcc ./configure --prefix=/usr --disable-libplacebo &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>BUILDCC=gcc ./configure --prefix=/usr --disable-libplacebo &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/videoutils/vlc.xml:265
#, xml-text
msgid "To test the results, issue: <command>make check</command>."
msgstr "Para testar os resultados, emita: <command>make check</command>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/videoutils/vlc.xml:269
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/multimedia/videoutils/vlc.xml:272
#, no-wrap, xml-text
msgid ""
"<userinput>make docdir=/usr/share/doc/vlc-&vlc-version; install</userinput>"
msgstr ""
"<userinput>make docdir=/usr/share/doc/vlc-&vlc-version; install</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/multimedia/videoutils/vlc.xml:280
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/videoutils/vlc.xml:283
#, xml-text
msgid ""
"<parameter>--disable-libplacebo</parameter>: This switch is required to "
"disable support for using libplacebo as a rendering pipeline because VLC is "
"incompatible with the latest version of libplacebo."
msgstr ""
"<parameter>--disable-libplacebo</parameter>: Essa chave é exigida para "
"desabilitar suporte para usar libplacebo como um pipeline de renderização "
"porque o VLC é incompatível com a versão mais recente da libplacebo."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/videoutils/vlc.xml:289
#, xml-text
msgid ""
"<option>--disable-vpx</option>: Use this switch to disable "
"<application>libvpx</application>."
msgstr ""
"<option>--disable-vpx</option>: Use essa chave para desabilitar a "
"<application>libvpx</application>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/videoutils/vlc.xml:299
#, xml-text
msgid ""
"<option>--disable-mad</option>: Use this switch if you don't have "
"<application>libmad</application> installed."
msgstr ""
"<option>--disable-mad</option>: Use essa chave se você não tiver a "
"<application>libmad</application> instalada."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/videoutils/vlc.xml:304
#, xml-text
msgid ""
"<option>--disable-avcodec --disable-swscale</option>: Use these switches if "
"you don't have <application>FFmpeg</application> installed."
msgstr ""
"<option>--disable-avcodec --disable-swscale</option>: Use essas chaves se "
"você não tiver o <application>FFmpeg</application> instalado."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/videoutils/vlc.xml:309
#, xml-text
msgid ""
"<option>--disable-a52</option>: Use this switch if you don't have "
"<application>liba52</application> installed."
msgstr ""
"<option>--disable-a52</option>: Use essa chave se você não tiver a "
"<application>liba52</application> instalada."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/videoutils/vlc.xml:314
#, xml-text
msgid ""
"<option>--disable-xcb</option>: Use this switch if you don't have "
"<application>X Window System</application> installed."
msgstr ""
"<option>--disable-xcb</option>: Use essa chave se você não tiver o "
"<application>Sistema de Janelas X</application> instalado."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/videoutils/vlc.xml:319
#, xml-text
msgid ""
"<option>--disable-alsa</option>: Use this switch if you don't have "
"<application>ALSA</application> installed."
msgstr ""
"<option>--disable-alsa</option>: Use essa chave se você não tiver o "
"<application>ALSA</application> instalado."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/videoutils/vlc.xml:324
#, xml-text
msgid ""
"<option>--disable-libgcrypt</option>: Use this switch if you don't have "
"<application>libgcrypt</application> installed."
msgstr ""
"<option>--disable-libgcrypt</option>: Use essa chave se você não tiver a "
"<application>libgcrypt</application> instalada."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/multimedia/videoutils/vlc.xml:329
#, xml-text
msgid ""
"<option>--disable-sftp</option>: The default is to build the sftp module if "
"<xref linkend=\"libssh2\"/> is installed. Use this switch if you do not want"
" to build this module."
msgstr ""
"<option>--disable-sftp</option>: O padrão é o de construir o módulo sftp se "
"<xref linkend=\"libssh2\"/> estiver instalado. Use essa chave se você não "
"quiser construir esse módulo."

#. type: Content of: <sect1><sect2><note><para>
#: blfs-en/multimedia/videoutils/vlc.xml:336
#, xml-text
msgid ""
"There are many options to <application>VLC</application>'s "
"<command>configure</command> command. Check the <command>configure "
"--help</command> output for a complete list."
msgstr ""
"Existem muitas opções para o comando <command>configure</command> do "
"<application>VLC</application>. Verifique a saída gerada do "
"<command>configure --help</command> para uma lista completa."

