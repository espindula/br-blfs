#. type: Content of: <sect1><title>
#: blfs-en/introduction/welcome/newsserver.xml:12
#, xml-text
msgid "News Server"
msgstr "Servidor de Notícias"

#. type: Content of: <sect1><para>
#: blfs-en/introduction/welcome/newsserver.xml:14
#, xml-text
msgid ""
"All the mailing lists hosted at &lfs-domainname; are also accessible via the"
" NNTP server. All messages posted to a mailing list will be copied to its "
"correspondent newsgroup. Note, however, that as this is written, it is not "
"possible to write to the mailing lists via the NNTP service."
msgstr ""
"Todas as listas de discussão hospedadas em &lfs-domainname; também são "
"acessíveis via servidor NNTP. Todas as mensagens postadas para uma lista de "
"discussão serão copiadas para o grupo de notícias correspondente dela. "
"Observe, entretanto, que, a medida que isso for escrito, não é possível "
"escrever para as listas de discussão via serviço NNTP."

#. type: Content of: <sect1><para>
#: blfs-en/introduction/welcome/newsserver.xml:21
#, xml-text
msgid ""
"The news server can be reached at <ulink url=\"news:news.&lfs-"
"domainname;\">news.&lfs-domainname;</ulink>."
msgstr ""
"O servidor de notícias pode ser alcançado em <ulink url=\"news:news.&lfs-"
"domainname;\">news.&lfs-domainname;</ulink>."

