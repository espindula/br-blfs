"<userinput>mkdir gedit-pkgs &amp;&amp;\n"
"cd    gedit-pkgs &amp;&amp;\n"
"\n"
"grep -v '^#' ../gedit-dependencies-&gedit-version;.md5 | awk '{print $2}' | wget -i- -c \\\n"
