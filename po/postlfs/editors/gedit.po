"\n"
"grep -v '^#' ../gedit-&gedit-version;.md5 | awk '{print $2}' | wget -i- -c \\\n"
"     -B &gedit-download-http; &amp;&amp;\n"
"\n"
"while read -r md5 file; do\n"
"    package=$(basename \"$file\")\n"
"    echo \"$md5  $package\"\n"
