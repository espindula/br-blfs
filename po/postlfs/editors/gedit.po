#. type: Content of: <sect1><sect2><title>
#: blfs-en/postlfs/editors/gedit.xml:180
#, xml-text
msgid "Installation of Gedit"
msgstr "Instalação do Gedit"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/postlfs/editors/gedit.xml:183
#, xml-text
msgid "First, build the gfls library:"
msgstr "Primeiro, construa a biblioteca gfls:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/postlfs/editors/gedit.xml:186
#, no-wrap, xml-text
msgid ""
"<userinput>tar -xf ../libgedit-gfls-&libgedit-gfls-version;.tar.bz2 &amp;&amp;\n"
"pushd libgedit-gfls-&libgedit-gfls-version;             &amp;&amp;\n"
"\n"
"mkdir gfls-build &amp;&amp;\n"
"cd    gfls-build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr       \\\n"
"            --buildtype=release \\\n"
"            -D gtk_doc=false    \\\n"
"            ..                  &amp;&amp;\n"
"ninja</userinput>"
msgstr ""
"<userinput>tar -xf ../libgedit-gfls-&libgedit-gfls-version;.tar.bz2 &amp;&amp;\n"
"pushd libgedit-gfls-&libgedit-gfls-version;             &amp;&amp;\n"
"\n"
"mkdir gfls-build &amp;&amp;\n"
"cd    gfls-build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr       \\\n"
"            --buildtype=release \\\n"
"            -D gtk_doc=false    \\\n"
"            ..                  &amp;&amp;\n"
"ninja</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/postlfs/editors/gedit.xml:199 blfs-en/postlfs/editors/gedit.xml:231
#, xml-text
msgid "To test the results, run: <command>ninja test</command>."
msgstr "Para testar os resultados, execute: <command>ninja test</command>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/postlfs/editors/gedit.xml:203 blfs-en/postlfs/editors/gedit.xml:235
#: blfs-en/postlfs/editors/gedit.xml:266
#, xml-text
msgid "Now, as the &root; user:"
msgstr "Agora, como o(a) usuário(a) &root;:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/postlfs/editors/gedit.xml:206 blfs-en/postlfs/editors/gedit.xml:238
#: blfs-en/postlfs/editors/gedit.xml:269
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr "<userinput>ninja install</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/postlfs/editors/gedit.xml:209
#, xml-text
msgid "Change back to the top build directory:"
msgstr "Mude de volta para o diretório superior de construção:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/postlfs/editors/gedit.xml:212 blfs-en/postlfs/editors/gedit.xml:244
#, no-wrap, xml-text
msgid "<userinput>popd</userinput>"
msgstr "<userinput>popd</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/postlfs/editors/gedit.xml:215
#, xml-text
msgid "Second, build the tepl library:"
msgstr "Segundo, construa a biblioteca tepl:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/postlfs/editors/gedit.xml:218
#, no-wrap, xml-text
msgid ""
"<userinput>tar -xf ../libgedit-tepl-&libgedit-tepl-version;.tar.bz2 &amp;&amp;\n"
"pushd libgedit-tepl-&libgedit-tepl-version;             &amp;&amp;\n"
"\n"
"mkdir tepl-build &amp;&amp;\n"
"cd    tepl-build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr       \\\n"
"            --buildtype=release \\\n"
"            -D gtk_doc=false    \\\n"
"            ..                  &amp;&amp;\n"
"ninja</userinput>"
msgstr ""
"<userinput>tar -xf ../libgedit-tepl-&libgedit-tepl-version;.tar.bz2 &amp;&amp;\n"
"pushd libgedit-tepl-&libgedit-tepl-version;             &amp;&amp;\n"
"\n"
"mkdir tepl-build &amp;&amp;\n"
"cd    tepl-build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr       \\\n"
"            --buildtype=release \\\n"
"            -D gtk_doc=false    \\\n"
"            ..                  &amp;&amp;\n"
"ninja</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/postlfs/editors/gedit.xml:241
#, xml-text
msgid "Again, change back to the top build directory:"
msgstr "Novamente, mude de volta para o diretório superior de construção:"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/postlfs/editors/gedit.xml:248
#, xml-text
msgid ""
"Finally, install <application>Gedit</application> by running the following "
"commands:"
msgstr ""
"Finalmente, instale <application>Gedit</application> executando os seguintes"
" comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/postlfs/editors/gedit.xml:252
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir gedit-build &amp;&amp;\n"
"cd    gedit-build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr       \\\n"
"            --buildtype=release \\\n"
"            -D gtk_doc=false    \\\n"
"            .. &amp;&amp;\n"
"ninja</userinput>"
msgstr ""
"<userinput>mkdir gedit-build &amp;&amp;\n"
"cd    gedit-build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr       \\\n"
"            --buildtype=release \\\n"
"            -D gtk_doc=false    \\\n"
"            .. &amp;&amp;\n"
