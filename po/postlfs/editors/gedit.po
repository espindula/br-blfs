#. type: Content of: <sect1><sect2><para>
#: blfs-en/postlfs/editors/gedit.xml:262
#, xml-text
msgid "To test the results, issue: <command>ninja test</command>."
msgstr "Para testar os resultados, emita: <command>ninja test</command>."

#. type: Content of: <sect1><sect2><title>
#: blfs-en/postlfs/editors/gedit.xml:277
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/postlfs/editors/gedit.xml:280
#, xml-text
msgid ""
"<parameter>-D gtk_doc=false</parameter>: This switch disables generating the"
" API documentation. Omit this switch if you have <xref linkend=\"gtk-doc\"/>"
" installed and wish to generate the API documentation."
msgstr ""
"<parameter>-D gtk_doc=false</parameter>: Essa chave desabilita a geração da "
"documentação da API. Omita essa chave se você tiver <xref linkend=\"gtk-"
"doc\"/> instalado e desejar gerar a documentação da API."

