#, xml-text
msgid "Installation of Gedit"
msgstr "Instalação do Gedit"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/postlfs/editors/gedit.xml:157
#, xml-text
msgid ""
"All of the packages come with a test suite. If you wish to execute them, "
"either comment out the <command>rm -rf ...</command> below, so that, after "
"all the packages are installed, you can come back to the corresponding "
"directory and run <command>ninja test</command>, or do individual builds, "
"running the tests for each of the packages.  Alternatively, you can "
"uncomment the line #<command>ninja test ...</command>, and at the end, check"
" the test results with:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/postlfs/editors/gedit.xml:166
#, no-wrap, xml-text
msgid "<userinput>grep -A9 summary *ninja_test.log</userinput>"
msgstr "<userinput>grep -A9 summary *ninja_test.log</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/postlfs/editors/gedit.xml:169
#, xml-text
msgid ""
"<application>Libgedit-amtk's</application> test-action-map test is known to "
"fail."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/postlfs/editors/gedit.xml:174
#, xml-text
msgid "First, start a subshell that will exit on error:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/postlfs/editors/gedit.xml:177
#, no-wrap, xml-text
msgid "<userinput>bash -e</userinput>"
msgstr "<userinput>bash -e</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/postlfs/editors/gedit.xml:180
#, fuzzy, xml-text
#| msgid ""
#| "Finally, install <application>Gedit</application> by running the following "
#| "commands:"
msgid ""
"Install <application>Gedit</application> and its dependencies by running the"
" following commands:"
msgstr ""
"Finalmente, instale <application>Gedit</application> executando os seguintes"
" comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/postlfs/editors/gedit.xml:184
#, no-wrap, xml-text
#| msgid ""
#| "<userinput>for package in $(grep -v '^#' ../gedit{-dependencies,}-&gedit-version;.md5 | awk '{print $2}')\n"
#| "do\n"
#| "package=$(basename \"$package\")\n"
#| "packagedir=${package%.tar.?z*}\n"
#| "echo \"Building $packagedir\"\n"
#| "  tar -xf $package\n"
#| "  pushd \"$packagedir\"\n"
#| "  cd build\n"
#| "  meson setup --prefix=/usr       \\\n"
#| "              --buildtype=release \\\n"
#| "              -D gtk_doc=false    \\\n"
#| "              ..\n"
#| "  ninja\n"
#| "  #ninja test 2>&amp;1 | tee ../../$packagedir-ninja_test.log\n"
#| "  as_root ninja install\n"
#| "  popd\n"
#| "  rm -rf $packagedir\n"
#| "  as_root /sbin/ldconfig\n"
#| "done</userinput>"
msgid ""
"<userinput>for package in $(grep -v '^#' ../gedit{-dependencies,}-&gedit-version;.md5 | awk '{print $2}')\n"
"do\n"
"  package=$(basename \"$package\")\n"
"  packagedir=${package%.tar.?z*}\n"
"\n"
"  echo \"Building $packagedir\"\n"
"    tar -xf $package\n"
"    pushd $packagedir\n"
"      cd build\n"
"\n"
"      meson setup ..            \\\n"
"            --prefix=/usr       \\\n"
"            --buildtype=release \\\n"
"            -D gtk_doc=false \n"
"      ninja\n"
"\n"
"      #ninja test 2>&amp;1 | tee ../../$packagedir-ninja_test.log\n"
"  \n"
"      as_root ninja install\n"
"    popd\n"
"\n"
"  rm -rf $packagedir\n"
"  as_root /sbin/ldconfig\n"
"done</userinput>"
msgstr ""
"<userinput>for package in $(grep -v '^#' ../gedit{-dependencies,}-&gedit-version;.md5 | awk '{print $2}')\n"
"do\n"
"  package=$(basename \"$package\")\n"
"  packagedir=${package%.tar.?z*}\n"
"\n"
"  echo \"Building $packagedir\"\n"
"    tar -xf $package\n"
"    pushd $packagedir\n"
"      cd build\n"
"\n"
"      meson setup ..            \\\n"
"            --prefix=/usr       \\\n"
"            --buildtype=release \\\n"
"            -D gtk_doc=false \n"
"      ninja\n"
"\n"
"      #ninja test 2>&amp;1 | tee ../../$packagedir-ninja_test.log\n"
"  \n"
"      as_root ninja install\n"
"    popd\n"
"\n"
"  rm -rf $packagedir\n"
"  as_root /sbin/ldconfig\n"
"done</userinput>"

#. type: Content of: <sect1><sect2><para>
