msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/postlfs/editors/emacs.xml:159
#, xml-text
msgid ""
"<option>--with-imagemagick</option>: Use this if you have installed <xref "
"linkend=\"imagemagick\"/> and wish to link against it."
msgstr ""
"<option>--with-imagemagick</option>: Use isso se você tiver instalado o "
"<xref linkend=\"imagemagick\"/> e desejar vincular a ele."

