#. type: Content of: <sect1><sect2><title>
#: blfs-en/postlfs/editors/gnome-text-editor.xml:91
#, xml-text
msgid "Installation of gnome-text-editor"
msgstr "Instalação do gnome-text-editor"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/postlfs/editors/gnome-text-editor.xml:94
#, xml-text
msgid ""
"Install <application>gnome-text-editor</application> by running the "
"following commands:"
msgstr ""
"Instale <application>gnome-text-editor</application> executando os seguintes"
" comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/postlfs/editors/gnome-text-editor.xml:98
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup ..            \\\n"
"      --prefix=/usr       \\\n"
"      --buildtype=release &amp;&amp;\n"
"\n"
"ninja</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup ..            \\\n"
"      --prefix=/usr       \\\n"
"      --buildtype=release &amp;&amp;\n"
"\n"
"ninja</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/postlfs/editors/gnome-text-editor.xml:108
#, xml-text
msgid "To test the results, run: <command>ninja test</command>,"
msgstr "Para testar os resultados, execute: <command>ninja test</command>,"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/postlfs/editors/gnome-text-editor.xml:112
#, xml-text
msgid "Now, as the &root; user:"
msgstr "Agora, como o(a) usuário(a) &root;:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/postlfs/editors/gnome-text-editor.xml:115
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr "<userinput>ninja install</userinput>"

