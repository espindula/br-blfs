#. type: Content of: <sect1><sect2><title>
#: blfs-en/postlfs/editors/joe.xml:73
#, xml-text
msgid "Installation of JOE"
msgstr "Instalação do \"JOE\""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/postlfs/editors/joe.xml:76
#, xml-text
msgid ""
"Install <application>JOE</application> by running the following commands:"
msgstr ""
"Instale <application>JOE</application> executando os seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/postlfs/editors/joe.xml:80
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr     \\\n"
"            --sysconfdir=/etc \\\n"
"            --docdir=/usr/share/doc/joe-&joe-version; &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>./configure --prefix=/usr    \\\n"
"            --sysconfdir=/etc \\\n"
"            --docdir=/usr/share/doc/joe-&joe-version; &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/postlfs/editors/joe.xml:86
#, xml-text
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/postlfs/editors/joe.xml:90
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr "Agora, como o(a) usante <systemitem class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/postlfs/editors/joe.xml:93
#, no-wrap, xml-text
msgid ""
"<userinput>make install &amp;&amp;\n"
"\n"
"install -vm 755 joe/util/{stringify,termidx,uniproc} /usr/bin</userinput>"
msgstr ""
"<userinput>make install &amp;&amp;\n"
"\n"
"install -vm 755 joe/util/{stringify,termidx,uniproc} /usr/bin</userinput>"

