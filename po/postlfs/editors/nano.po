#: blfs-en/postlfs/editors/nano.xml:117
#, xml-text
msgid "<filename>/etc/nanorc</filename> and <filename>~/.nanorc</filename>"
msgstr "<filename>/etc/nanorc</filename> e <filename>~/.nanorc</filename>"

#. type: Content of: <sect1><sect2><sect3><indexterm><primary>
#: blfs-en/postlfs/editors/nano.xml:122
#, xml-text
msgid "/etc/nanorc"
msgstr "/etc/nanorc"

#. type: Content of: <sect1><sect2><sect3><indexterm><primary>
#: blfs-en/postlfs/editors/nano.xml:126
#, xml-text
msgid "~/.nanorc"
msgstr "~/.nanorc"

#. type: Content of: <sect1><sect2><sect3><title>
#: blfs-en/postlfs/editors/nano.xml:132
#, xml-text
msgid "Configuration Information"
msgstr "Informação de Configuração"

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/postlfs/editors/nano.xml:135
#, xml-text
msgid ""
"Example configuration (create as a system-wide "
"<filename>/etc/nanorc</filename> or a personal "
"<filename>~/.nanorc</filename> file)"
msgstr ""
"Configuração de exemplo (crie como um arquivo "
"<filename>/etc/nanorc</filename> de todo o sistema ou como um arquivo "
"pessoal <filename>~/.nanorc</filename>)"

#. type: Content of: <sect1><sect2><sect3><screen>
#: blfs-en/postlfs/editors/nano.xml:140
#, no-wrap, xml-text
msgid ""
"<literal>set autoindent\n"
"set constantshow\n"
"set fill 72\n"
"set historylog\n"
"set multibuffer\n"
"set nohelp\n"
"set positionlog\n"
"set quickblank\n"
"set regexp</literal>"
msgstr ""
"<literal>set autoindent\n"
"set constantshow\n"
"set fill 72\n"
"set historylog\n"
"set multibuffer\n"
"set nohelp\n"
"set positionlog\n"
"set quickblank\n"
"set regexp</literal>"

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/postlfs/editors/nano.xml:151
#, xml-text
msgid ""
"Check the <filename>sample.nanorc</filename> file in the installed "
"documentation directory. It includes color configurations and has some "
"documentation included in the comments."
msgstr ""
"Verifique o arquivo <filename>sample.nanorc</filename> no diretório "
"instalado da documentação. Inclui configurações de cores e tem alguma "
"documentação incluída nos comentários."

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/postlfs/editors/nano.xml:157
#, xml-text
msgid ""
"Syntax highlighting is provided for several file types, in <filename "
"class=\"directory\">/usr/share/nano/</filename> directory.  E.g., for shell "
"scripts, you can insert <option>include /usr/share/nano/sh.nanorc</option> "
"in the personal or global configuration file. If you wish highlighting for "
"all supported files, use <option>include /usr/share/nano/*.nanorc</option>. "
"This include does not descend into the <filename "
"class=\"directory\">extra</filename> directory. Move required files one "
"level up."
msgstr ""
"O realce de sintaxe é fornecido para vários tipos de arquivo, no diretório "
"<filename class=\"directory\">/usr/share/nano/</filename>. Por exemplo, para"
" scripts do shell, você pode inserir <option>include "
"/usr/share/nano/sh.nanorc</option> no arquivo de configuração pessoal ou no "
"global. Se você deseja realçar todos os arquivos suportados, [então] use "
"<option>include /usr/share/nano/*.nanorc</option>. Essa inclusão não desce "
"para o diretório <filename class=\"directory\">extra</filename>. Mova os "
"arquivos exigidos um nível acima."

