#. type: Content of: <sect1><sect2><title>
#: blfs-en/postlfs/editors/nano.xml:27
#, xml-text
msgid "Introduction to Nano"
msgstr "Introdução ao Nano"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/postlfs/editors/nano.xml:30
#, xml-text
msgid ""
"The <application>Nano</application> package contains a small, simple text "
"editor which aims to replace <application>Pico</application>, the default "
"editor in the <application>Pine</application> package."
msgstr ""
"O pacote <application>Nano</application> contém um pequeno e simples editor "
"de texto que pretende substituir o <application>Pico</application>, o editor"
" padrão no pacote <application>Pine</application>."

