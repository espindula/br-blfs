#~ "cp -av -T --no-preserve=ownership sof      \\\n"
#~ "   /usr/lib/firmware/intel/sof             &amp;&amp;\n"
#~ "cp -av -T --no-preserve=ownership sof-tplg \\\n"
#~ "   /usr/lib/firmware/intel/sof-tplg</userinput>"

