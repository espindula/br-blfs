#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/postlfs/shells/dash.xml:165
#, xml-text
msgid ""
"Update <filename>/etc/shells</filename> to include the "
"<application>Dash</application> shell by issuing the following command as "
"the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Atualize <filename>/etc/shells</filename> para incluir o shell "
"<application>Dash</application> emitindo o seguinte comando como o(a) "
"usuário(a) <systemitem class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><sect3><screen>
#: blfs-en/postlfs/shells/dash.xml:170
#, no-wrap, xml-text
msgid ""
"<userinput>cat &gt;&gt; /etc/shells &lt;&lt; \"EOF\"\n"
"<literal>/bin/dash</literal>\n"
"EOF</userinput>"
msgstr ""
"<userinput>cat &gt;&gt; /etc/shells &lt;&lt; \"EOF\"\n"
"<literal>/bin/dash</literal>\n"
"EOF</userinput>"

