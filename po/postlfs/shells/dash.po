#. type: Content of: <sect1><sect2><title>
#: blfs-en/postlfs/shells/dash.xml:86
#, xml-text
msgid "Installation of Dash"
msgstr "Instalação do Dash"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/postlfs/shells/dash.xml:89
#, xml-text
msgid ""
"Install <application>Dash</application> by running the following commands:"
msgstr ""
"Instale <application>Dash</application> executando os seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/postlfs/shells/dash.xml:93
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --bindir=/bin --mandir=/usr/share/man &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>./configure --bindir=/bin --mandir=/usr/share/man &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/postlfs/shells/dash.xml:97
#, xml-text
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/postlfs/shells/dash.xml:101
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/postlfs/shells/dash.xml:104
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/postlfs/shells/dash.xml:107
#, xml-text
msgid ""
"If you would like to make <command>dash</command> the default "
"<command>sh</command>, recreate the <filename>/bin/sh</filename> symlink as "
"the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Se você gostaria de tornar <command>dash</command> o <command>sh</command> "
"padrão, [então] recrie o link simbólico <filename>/bin/sh</filename> como "
"o(a) usuário(a) <systemitem class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><note><para>
#: blfs-en/postlfs/shells/dash.xml:114
#, xml-text
msgid ""
"If you create the symbolic link from <command>dash</command> to "
"<command>sh</command>, you will need to reset the link to "
"<command>bash</command> to build LFS."
msgstr ""
"Se criar o link simbólico do <command>dash</command> para "
"<command>sh</command>, [então] você precisará reconfigurar o link para "
"<command>bash</command> para construir o LFS."

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/postlfs/shells/dash.xml:120
#, no-wrap, xml-text
msgid "<userinput>ln -svf dash /bin/sh</userinput>"
msgstr "<userinput>ln -svf dash /bin/sh</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/postlfs/shells/dash.xml:125
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/postlfs/shells/dash.xml:128
#, xml-text
msgid ""
"<parameter>--bindir=/bin</parameter>: This parameter places the "
"<command>dash</command> binary into the root filesystem."
msgstr ""
"<parameter>--bindir=/bin</parameter>: Esse parâmetro coloca o binário "
"<command>dash</command> no sistema de arquivos raiz."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/postlfs/shells/dash.xml:133
#, xml-text
msgid ""
"<option>--with-libedit</option>: To compile <application>Dash</application> "
"with libedit support."
msgstr ""
"<option>--with-libedit</option>: Para compilar "
"<application>Dash</application> com suporte a libedit."

