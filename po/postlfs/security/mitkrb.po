#. type: Content of: <sect1><sect2><para>
#: blfs-en/postlfs/security/mitkrb.xml:127
#, xml-text
msgid ""
"Build <application>MIT Kerberos V5</application> by running the following "
"commands:"
msgstr ""
"Construa <application>MIT Kerberos V5</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/postlfs/security/mitkrb.xml:131
#, no-wrap, xml-text
msgid ""
"<userinput>cd src &amp;&amp;\n"
"sed -i -e '/eq 0/{N;s/12 //}' plugins/kdb/db2/libdb2/test/run.test &amp;&amp;\n"
"\n"
"./configure --prefix=/usr            \\\n"
"            --sysconfdir=/etc        \\\n"
"            --localstatedir=/var/lib \\\n"
"            --runstatedir=/run       \\\n"
"            --with-system-et         \\\n"
"            --with-system-ss         \\\n"
"            --with-system-verto=no   \\\n"
"            --enable-dns-for-realm   \\\n"
"            --disable-rpath          &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>cd src &amp;&amp;\n"
"sed -i -e '/eq 0/{N;s/12 //}' plugins/kdb/db2/libdb2/test/run.test &amp;&amp;\n"
"\n"
"./configure --prefix=/usr            \\\n"
"            --sysconfdir=/etc        \\\n"
"            --localstatedir=/var/lib \\\n"
"            --runstatedir=/run       \\\n"
"            --with-system-et         \\\n"
"            --with-system-ss         \\\n"
"            --with-system-verto=no   \\\n"
"            --enable-dns-for-realm   \\\n"
"            --disable-rpath          &amp;&amp;\n"
"make</userinput>"

