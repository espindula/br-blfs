msgstr "Instalação do gpgmepp"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/postlfs/security/gpgmepp.xml:82
#, xml-text
msgid ""
"Install <application>gpgmepp</application> by running the following "
"commands:"
msgstr ""
"Instale <application>gpgmepp</application> executando os seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/postlfs/security/gpgmepp.xml:86
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr .. &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr .. &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/postlfs/security/gpgmepp.xml:93
#, xml-text
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/postlfs/security/gpgmepp.xml:97
#, xml-text
msgid "Now, as the &root; user:"
msgstr "Agora, como o(a) usante &root;:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/postlfs/security/gpgmepp.xml:100
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

