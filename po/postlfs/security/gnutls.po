#. type: Content of: <sect1><sect2><title>
#: blfs-en/postlfs/security/gnutls.xml:159
#, xml-text
msgid "Installation of GnuTLS"
msgstr "Instalação do GnuTLS"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/postlfs/security/gnutls.xml:171
#, xml-text
msgid ""
"Install <application>GnuTLS</application> by running the following commands:"
msgstr ""
"Instale <application>GnuTLS</application> executando os seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/postlfs/security/gnutls.xml:175
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr \\\n"
"            --docdir=/usr/share/doc/gnutls-&gnutls-version; \\\n"
"            --with-default-trust-store-pkcs11=\"pkcs11:\" &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>./configure --prefix=/usr \\\n"
"           --docdir=/usr/share/doc/gnutls-&gnutls-version; \\\n"
"           --with-default-trust-store-pkcs11=\"pkcs11:\" &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/postlfs/security/gnutls.xml:189
#, xml-text
msgid "To test the results, now issue: <command>make check</command>."
msgstr ""
"Para testar os resultados, agora emita: <command>make check</command>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/postlfs/security/gnutls.xml:193
#, xml-text
msgid "Now, install the package as the &root; user:"
msgstr "Agora, instale o pacote como o(a) usuário(a) &root;:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/postlfs/security/gnutls.xml:196
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/postlfs/security/gnutls.xml:201
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/postlfs/security/gnutls.xml:204
#, xml-text
msgid ""
"<parameter>--with-default-trust-store-pkcs11=\"pkcs11:\"</parameter>: This "
"switch tells gnutls to use the PKCS #11 trust store as the default trust.  "
"Omit this switch if <xref linkend=\"p11-kit\"/> is not installed."
msgstr ""
"<parameter>--with-default-trust-store-pkcs11=\"pkcs11:\"</parameter>: Essa "
"chave diz ao gnutls para usar o armazenamento de confiança PKCS #11 como a "
"confiança padrão. Omita essa chave se <xref linkend=\"p11-kit\"/> não "
"estiver instalado."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/postlfs/security/gnutls.xml:217
#, xml-text
msgid ""
"<option>--with-default-trust-store-file=/etc/pki/tls/certs/ca-"
"bundle.crt</option>: This switch tells <command>configure</command> where to"
" find the legacy CA certificate bundle and to use it instead of PKCS #11 "
"module by default. Use this if <xref linkend=\"p11-kit\"/> is not installed."
msgstr ""
"<option>--with-default-trust-store-file=/etc/pki/tls/certs/ca-"
"bundle.crt</option>: Essa chave informa ao <command>configure</command> onde"
" encontrar o pacote legado de certificados da AC e usá-lo em vez do módulo "
"PKCS #11 por padrão. Use isso se <xref linkend=\"p11-kit\"/> não estiver "
"instalado."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/postlfs/security/gnutls.xml:227
#, xml-text
msgid ""
"<option>--enable-openssl-compatibility</option>: Use this switch if you wish"
" to build the OpenSSL compatibility library."
msgstr ""
"<option>--enable-openssl-compatibility</option>: Use essa chave se desejar "
"construir a biblioteca de compatibilidade OpenSSL."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/postlfs/security/gnutls.xml:232
#, xml-text
msgid ""
"<option>--without-p11-kit</option>: Use this switch if you have not "
"installed <xref linkend=\"p11-kit\"/>."
msgstr ""
"<option>--without-p11-kit</option>: Use essa chave se você não tiver "
"instalado o <xref linkend=\"p11-kit\"/>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/postlfs/security/gnutls.xml:237
#, xml-text
msgid ""
"<option>--with-included-unistring</option>: This switch uses the bundled "
"version of libunistring, instead of the system one. Use this switch if you "
"have not installed <xref linkend=\"libunistring\"/>."
msgstr ""
"<option>--with-included-unistring</option>: Essa chave usa a versão "
"empacotada da libunistring, em vez da do sistema. Use essa chave se você não"
" tiver instalado <xref linkend=\"libunistring\"/>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/postlfs/security/gnutls.xml:243
#, xml-text
msgid ""
"<option>--disable-dsa</option>: This switch completely disables DSA "
"algorithm support."
msgstr ""
"<option>--disable-dsa</option>: Essa chave desabilita completamente o "
"suporte ao algoritmo DSA."

