#. type: Content of: <sect1><sect2><title>
#: blfs-en/postlfs/security/shadow.xml:99
#, xml-text
msgid "Installation of Shadow"
msgstr "Instalação do Shadow"

#. type: Content of: <sect1><sect2><important><para>
#: blfs-en/postlfs/security/shadow.xml:103
#, xml-text
msgid ""
"The installation commands shown below are for installations where "
"<application>Linux-PAM</application> has been installed and "
"<application>Shadow</application> is being reinstalled to support the "
"<application>Linux-PAM</application> installation."
msgstr ""
"Os comandos de instalação mostrados abaixo são para instalações onde o "
"<application>Linux-PAM</application> tenha sido instalado e o "
"<application>Shadow</application> esteja sendo reinstalado para suportar a "
"instalação do <application>Linux-PAM</application>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/postlfs/security/shadow.xml:120
#, xml-text
msgid ""
"Reinstall <application>Shadow</application> by running the following "
"commands:"
msgstr ""
"Reinstale <application>Shadow</application> executando os seguintes "
"comandos:"

#. <screen>
#. <userinput>patch -Np1 -i ../shadow-4.10-useradd_segfault-1.patch &amp;&amp;
#. This is the default:            - -with-group-name-max-length=32 &amp;&amp;
#. type: Content of: <sect1><sect2><screen>
#: blfs-en/postlfs/security/shadow.xml:126
#, no-wrap, xml-text
msgid ""
"<userinput>sed -i 's/groups$(EXEEXT) //' src/Makefile.in          &amp;&amp;\n"
"\n"
"find man -name Makefile.in -exec sed -i 's/groups\\.1 / /'   {} \\; &amp;&amp;\n"
"find man -name Makefile.in -exec sed -i 's/getspnam\\.3 / /' {} \\; &amp;&amp;\n"
"find man -name Makefile.in -exec sed -i 's/passwd\\.5 / /'   {} \\; &amp;&amp;\n"
"\n"
"sed -e 's@#ENCRYPT_METHOD DES@ENCRYPT_METHOD YESCRYPT@' \\\n"
"    -e 's@/var/spool/mail@/var/mail@'                   \\\n"
"    -e '/PATH=/{s@/sbin:@@;s@/bin:@@}'                  \\\n"
"    -i etc/login.defs                                   &amp;&amp;\n"
"\n"
"./configure --sysconfdir=/etc   \\\n"
"            --disable-static    \\\n"
"            --without-libbsd    \\\n"
"            --with-{b,yes}crypt &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>sed -i 's/groups$(EXEEXT) //' src/Makefile.in          &amp;&amp;\n"
"\n"
"find man -name Makefile.in -exec sed -i 's/groups\\.1 / /'   {} \\; &amp;&amp;\n"
"find man -name Makefile.in -exec sed -i 's/getspnam\\.3 / /' {} \\; &amp;&amp;\n"
"find man -name Makefile.in -exec sed -i 's/passwd\\.5 / /'   {} \\; &amp;&amp;\n"
"\n"
"sed -e 's@#ENCRYPT_METHOD DES@ENCRYPT_METHOD YESCRYPT@' \\\n"
"    -e 's@/var/spool/mail@/var/mail@'                   \\\n"
"    -e '/PATH=/{s@/sbin:@@;s@/bin:@@}'                  \\\n"
"    -i etc/login.defs                                   &amp;&amp;\n"
"\n"
"./configure --sysconfdir=/etc   \\\n"
"            --disable-static    \\\n"
"            --without-libbsd    \\\n"
"            --with-{b,yes}crypt &amp;&amp;\n"
"make</userinput>"

