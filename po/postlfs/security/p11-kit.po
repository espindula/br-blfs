#. type: Content of: <sect1><sect2><para>
#: blfs-en/postlfs/security/p11-kit.xml:28
#, xml-text
msgid ""
"The <application>p11-kit</application> package provides a way to load and "
"enumerate PKCS #11 (a Cryptographic Token Interface Standard) modules."
msgstr ""
"O pacote <application>p11-kit</application> fornece uma maneira de carregar "
"e de enumerar módulos PKCS #11 (um padrão de interface de token "
"criptográfico)."

