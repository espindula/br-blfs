#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/postlfs/security/volume_key.xml:70
msgid "volume_key Dependencies"
msgstr "Dependências do volume_key"

#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/postlfs/security/volume_key.xml:72
msgid "Required"
msgstr "Exigidas"

#.  To editors: if GnuPG is not installed, a wrong path to gpg will
#.            be hard-coded into the library.  Even if GnuPG is installed, we
#.            still need the 's/gpg2/gpg/' sed below.  I can't find an elegant
#.            way to specify the path manually (so I can't make it a runtime
#.            dependency).
#. type: Content of: <sect1><sect2><para>
#: blfs-en/postlfs/security/volume_key.xml:74
msgid ""
"<xref linkend=\"cryptsetup\"/>, <xref linkend=\"glib2\"/>, <xref "
"linkend=\"gnupg2\"/>, <xref linkend=\"gpgme\"/>, and <xref linkend=\"nss\"/>"
msgstr ""
"<xref linkend=\"cryptsetup\"/>, <xref linkend=\"glib2\"/>, <xref "
"linkend=\"gnupg2\"/>, <xref linkend=\"gpgme\"/> e <xref linkend=\"nss\"/>"

#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/postlfs/security/volume_key.xml:86
msgid "Recommended"
msgstr "Recomendadas"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/postlfs/security/volume_key.xml:88
msgid "<xref linkend=\"swig\"/>"
msgstr "<xref linkend=\"swig\"/>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/postlfs/security/volume_key.xml:99
msgid "Installation of volume_key"
msgstr "Instalação do volume_key"

#. type: Content of: <sect1><sect2><note><para>
#: blfs-en/postlfs/security/volume_key.xml:103
msgid ""
"This package expands to the directory volume_key-volume_key-&volume_key-"
"version;."
msgstr ""
"Esse pacote se expande para o diretório volume_key-volume_key-&volume_key-"
"version;."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/postlfs/security/volume_key.xml:109
msgid "Tell the building system how to locate GPGME and GnuPG correctly:"
msgstr ""
"Diga ao sistema de construção como localizar o GPGME e o GnuPG corretamente:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/postlfs/security/volume_key.xml:112
#, no-wrap
msgid ""
"<userinput remap='pre'>sed -e '/AM_PATH_GPGME/iAM_PATH_GPG_ERROR' \\\n"
"    -e 's/gpg2/gpg/' -i configure.ac</userinput>"
msgstr ""
"<userinput remap='pre'>sed -e '/AM_PATH_GPGME/iAM_PATH_GPG_ERROR' \\\n"
"    -e 's/gpg2/gpg/' -i configure.ac</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/postlfs/security/volume_key.xml:116
msgid ""
"Install <application>volume_key</application> by running the following "
"commands:"
msgstr ""
"Instale <application>volume_key</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/postlfs/security/volume_key.xml:120
#, no-wrap
msgid ""
"<userinput>autoreconf -fiv              &amp;&amp;\n"
"./configure --prefix=/usr    \\\n"
"            --without-python &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>autoreconf -fiv             &amp;&amp;\n"
"./configure --prefix=/usr    \\\n"
"            --without-python &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/postlfs/security/volume_key.xml:126
msgid "To test the results, issue: <command>make check</command>."
msgstr "Para testar os resultados, emita: <command>make check</command>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/postlfs/security/volume_key.xml:130
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/postlfs/security/volume_key.xml:133
#, no-wrap
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/postlfs/security/volume_key.xml:138
msgid "Command Explanations"
msgstr "Explicações dos Comandos"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/postlfs/security/volume_key.xml:141
msgid ""
"<parameter>--without-python</parameter>: This parameter prevents building "
"the <application>Python 2</application> bindings, if <xref "
"linkend=\"python2\"/> is installed."
msgstr ""
"<parameter>--without-python</parameter>: Esse parâmetro impede a construção "
"das ligações <application>Python 2</application>, se <xref "
"linkend=\"python2\"/> estiver instalado."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/postlfs/security/volume_key.xml:147
msgid ""
"<option>--without-python3</option>: Use this option if you do not want to "
"build the <application>Python 3</application> bindings. In this case, <xref "
"linkend=\"swig\"/> is not needed."
msgstr ""
"<option>--without-python3</option>: Use essa opção se você não quiser "
"construir as ligações <application>Python 3</application>. Nesse caso, <xref"
" linkend=\"swig\"/> não é necessário."

