#, xml-text
#~ msgid "Configuring Polkit"
#~ msgstr "Configurando Polkit"

#, xml-text
#~ msgid ""
#~ "If you did not build <application>Polkit</application> with "
#~ "<application>Linux PAM</application> support, you can skip this section."
#~ msgstr ""
#~ "Se não construiu o <application>Polkit</application> com suporte para "
#~ "<application>Linux PAM</application>, [então] você pode pular esta seção."

#, xml-text
#~ msgid ""
#~ "If you have built <application>Polkit</application> with <application>Linux "
#~ "PAM</application> support, you need to modify the default PAM configuration "
#~ "file which was installed by default to get <application>Polkit</application>"
#~ " to work correctly with BLFS. Issue the following commands as the "
#~ "<systemitem class=\"username\">root</systemitem> user to create the "
#~ "configuration file for <application>Linux PAM</application>:"
#~ msgstr ""
#~ "Se tiver construído o <application>Polkit</application> com suporte para "
#~ "<application>Linux PAM</application>, [então] você precisa modificar o "
#~ "arquivo padrão de configuração PAM que foi instalado por padrão para fazer o"
#~ " <application>Polkit</application> funcionar corretamente com o BLFS. Emita "
#~ "os seguintes comandos como o(a) usuário(a) <systemitem "
#~ "class=\"username\">root</systemitem> para criar o arquivo de configuração "
#~ "para <application>Linux PAM</application>:"

#, no-wrap, xml-text
#~ msgid ""
#~ "<userinput>cat &gt; /etc/pam.d/polkit-1 &lt;&lt; \"EOF\"\n"
#~ "<literal># Begin /etc/pam.d/polkit-1\n"
#~ "\n"
#~ "auth     include        system-auth\n"
#~ "account  include        system-account\n"
#~ "password include        system-password\n"
#~ "session  include        system-session\n"
#~ "\n"
#~ "# End /etc/pam.d/polkit-1</literal>\n"
#~ "EOF</userinput>"
#~ msgstr ""
#~ "<userinput>cat &gt; /etc/pam.d/polkit-1 &lt;&lt; \"EOF\"\n"
#~ "<literal># Início /etc/pam.d/polkit-1\n"
#~ "\n"
#~ "auth     include        system-auth\n"
#~ "account  include        system-account\n"
#~ "password include        system-password\n"
#~ "session  include        system-session\n"
#~ "\n"
#~ "# Fim /etc/pam.d/polkit-1</literal>\n"
#~ "EOF</userinput>"
