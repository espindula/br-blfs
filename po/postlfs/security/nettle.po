#: blfs-en/postlfs/security/nettle.xml:185
#, xml-text
msgid ""
"converts private and public RSA keys from PKCS #1 format to sexp format"
msgstr ""
"converte chaves RSA privadas e públicas do formato PKCS #1 para o formato "
"sexp"

