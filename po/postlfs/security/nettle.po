#. type: Content of: <sect1><sect2><variablelist><varlistentry><term>
#: blfs-en/postlfs/security/nettle.xml:152
#, xml-text
msgid "<command>nettle-lfib-stream</command>"
msgstr "<command>nettle-lfib-stream</command>"

#. type: Content of:
#. <sect1><sect2><variablelist><varlistentry><listitem><para>
#: blfs-en/postlfs/security/nettle.xml:155
#, xml-text
msgid ""
"outputs a sequence of pseudorandom (non-cryptographic)  bytes, using Knuth's"
" lagged fibonacci generator. The stream is useful for testing, but should "
"not be used to generate cryptographic keys or anything else that needs real "
"randomness"
msgstr ""
"gera uma sequência de bytes pseudo-aleatórios (não criptográficos), usando o"
" gerador fibonacci defasado de Knuth. O fluxo é útil para testes, mas não "
"deveria ser usado para gerar chaves criptográficas ou qualquer outra coisa "
"que precise de aleatoriedade real"

#. type: Content of:
#. <sect1><sect2><variablelist><varlistentry><listitem><indexterm><primary>
#: blfs-en/postlfs/security/nettle.xml:161
#, xml-text
msgid "nettle-lfib-stream"
msgstr "nettle-lfib-stream"

#. type: Content of: <sect1><sect2><variablelist><varlistentry><term>
#: blfs-en/postlfs/security/nettle.xml:167
#, xml-text
msgid "<command>nettle-pbkdf2</command>"
msgstr "<command>nettle-pbkdf2</command>"

#. type: Content of:
#. <sect1><sect2><variablelist><varlistentry><listitem><para>
#: blfs-en/postlfs/security/nettle.xml:170
#, xml-text
msgid ""
"is a password-based key derivation function that takes a password or a "
"passphrase as input and returns a strengthened password, which is protected "
"against pre-computation attacks by using salting and other expensive "
"computations."
msgstr ""
"é uma função de derivação de chave baseada em senha que usa uma senha ou "
"frase secreta como entrada e retorna uma senha reforçada, que é protegida "
"contra ataques de pré-computação usando salting e outros cálculos "
"dispendiosos."

#. type: Content of:
#. <sect1><sect2><variablelist><varlistentry><listitem><indexterm><primary>
#: blfs-en/postlfs/security/nettle.xml:176
#, xml-text
msgid "nettle-pbkdf2"
msgstr "nettle-pbkdf2"

