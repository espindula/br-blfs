#. type: Content of: <sect1><sect2><para>
#: blfs-en/postlfs/filesystems/btrfs-progs.xml:29
#, xml-text
msgid ""
"The <application>btrfs-progs</application> package contains administration "
"and debugging tools for the B-tree file system (btrfs)."
msgstr ""
"O pacote <application>btrfs-progs</application> contém ferramentas de "
"administração e de depuração para o sistema de arquivos B-tree (btrfs)."

