#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/postlfs/filesystems/fuse3.xml:203
#, xml-text
msgid ""
"Some options regarding mount policy can be set in the file "
"<filename>/etc/fuse.conf</filename>. To install the file run the following "
"command as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Algumas opções relacionadas à política de montagem podem ser configuradas no"
" arquivo <filename>/etc/fuse.conf</filename>. Para instalar o arquivo, "
"execute o seguinte comando como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><sect3><screen>
#: blfs-en/postlfs/filesystems/fuse3.xml:209
#, no-wrap, xml-text
msgid ""
"<userinput>cat &gt; /etc/fuse.conf &lt;&lt; \"EOF\"\n"
"<literal># Set the maximum number of FUSE mounts allowed to non-root users.\n"
"# The default is 1000.\n"
"#\n"
"#mount_max = 1000\n"
"\n"
"# Allow non-root users to specify the 'allow_other' or 'allow_root'\n"
"# mount options.\n"
"#\n"
"#user_allow_other</literal>\n"
"EOF</userinput>"
msgstr ""
"<userinput>cat &gt; /etc/fuse.conf &lt;&lt; \"EOF\"\n"
"<literal># Configura o número máximo de montagens FUSE permitidas para usuários(as) não root.\n"
"# O padrão é 1000.\n"
"#\n"
"#mount_max = 1000\n"
"\n"
"# Permitir que usuários(as) não root especifiquem as\n"
"# opções de montagem 'allow_other' ou 'allow_root'.\n"
"#\n"
"#user_allow_other</literal>\n"
"EOF</userinput>"

