msgstr "Dependências do GRUB"

#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/postlfs/filesystems/uefi-bootloaders/grub-efi.xml:107
#, xml-text
msgid "Recommended"
msgstr "Recomendadas"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/postlfs/filesystems/uefi-bootloaders/grub-efi.xml:109
#, xml-text
msgid "<xref role=\"runtime\" linkend=\"efibootmgr\"/> (runtime)"
msgstr "<xref role=\"runtime\" linkend=\"efibootmgr\"/> (tempo de execução)"

#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/postlfs/filesystems/uefi-bootloaders/grub-efi.xml:112
#, xml-text
msgid "Optional"
msgstr "Opcionais"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/postlfs/filesystems/uefi-bootloaders/grub-efi.xml:114
#, xml-text
msgid ""
"<xref linkend=\"freetype2\"/>, <xref linkend=\"fuse3\"/>, and <xref "
"linkend=\"lvm2\"/>"
msgstr ""
"<xref linkend=\"freetype2\"/>, <xref linkend=\"fuse3\"/> e <xref "
"linkend=\"lvm2\"/>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/postlfs/filesystems/uefi-bootloaders/grub-efi.xml:120
#, xml-text
msgid ""
"If you are building GRUB for a 32-bit LFS system to boot it on a 64-bit UEFI"
" firmware, rebuild <xref linkend=\"gcc\"/> with the <parameter>--enable-"
"targets=all</parameter> switch appended to the "
"<command>../configure</command> command."
msgstr ""
"Se você estiver construindo o GRUB para um sistema LFS de 32 bits para "
"inicializá-lo em um firmware UEFI de 64 bits, reconstrua <xref "
"linkend=\"gcc\"/> com a chave <parameter>--enable-targets=all</parameter> "
"posposta ao comando <command>../configure</command>."

#. type: Content of: <sect1><sect2><title>
#: blfs-en/postlfs/filesystems/uefi-bootloaders/grub-efi.xml:128
#, xml-text
msgid "Installation of GRUB"
msgstr "Instalação do GRUB"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/postlfs/filesystems/uefi-bootloaders/grub-efi.xml:131
#, xml-text
msgid ""
"First, install font data as the <systemitem "
"class=\"username\">root</systemitem> user if you've downloaded it and you've"
" installed the optional dependency <xref linkend='freetype2'/>:"
msgstr ""
"Primeiro, instale os dados da fonte como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem> se você os tiver baixado e tiver "
"instalado a dependência opcional <xref linkend='freetype2'/>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/postlfs/filesystems/uefi-bootloaders/grub-efi.xml:137
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir -pv /usr/share/fonts/unifont &amp;&amp;\n"
"gunzip -c ../unifont-&unifont-version;.pcf.gz > /usr/share/fonts/unifont/unifont.pcf</userinput>"
msgstr ""
"<userinput>mkdir -pv /usr/share/fonts/unifont &amp;&amp;\n"
"gunzip -c ../unifont-&unifont-version;.pcf.gz > /usr/share/fonts/unifont/unifont.pcf</userinput>"

#. type: Content of: <sect1><sect2><warning><para>
#: blfs-en/postlfs/filesystems/uefi-bootloaders/grub-efi.xml:141
#, xml-text
msgid "Unset any environment variables which may affect the build:"
msgstr ""
"Desconfigure quaisquer variáveis de ambiente que possivelmente afetem a "
"construção:"

#. type: Content of: <sect1><sect2><warning><screen>
#: blfs-en/postlfs/filesystems/uefi-bootloaders/grub-efi.xml:143
#, no-wrap, xml-text
msgid "<userinput>unset {C,CPP,CXX,LD}FLAGS</userinput>"
msgstr "<userinput>unset {C,CPP,CXX,LD}FLAGS</userinput>"

#. type: Content of: <sect1><sect2><warning><para>
#: blfs-en/postlfs/filesystems/uefi-bootloaders/grub-efi.xml:145
#, xml-text
msgid ""
"Don't try <quote>tuning</quote> this package with custom compilation flags: "
"this package is a bootloader, with low-level operations in the source code "
"which is likely to be broken by some aggressive optimizations."
msgstr ""
"Não tente <quote>ajustar</quote> esse pacote com sinalizadores "
"personalizados de compilação: esse pacote é um carregador de inicialização, "
"com operações de baixo nível no código-fonte, as quais provavelmente sejam "
"quebradas por algumas otimizações agressivas."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/postlfs/filesystems/uefi-bootloaders/grub-efi.xml:152
#, xml-text
msgid "Add a file missing from the release tarball:"
msgstr "Adicionar um arquivo ausente proveniente do tarball de lançamento:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/postlfs/filesystems/uefi-bootloaders/grub-efi.xml:155
#, no-wrap, xml-text
msgid ""
"<userinput>echo <literal>depends bli part_gpt</literal> > grub-"
"core/extra_deps.lst</userinput>"
msgstr ""
"<userinput>echo <literal>depends bli part_gpt</literal> > grub-"
"core/extra_deps.lst</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/postlfs/filesystems/uefi-bootloaders/grub-efi.xml:158
#, xml-text
msgid "Build <application>GRUB</application> with the following commands:"
msgstr "Construa o <application>GRUB</application> com os seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/postlfs/filesystems/uefi-bootloaders/grub-efi.xml:161
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr        \\\n"
"            --sysconfdir=/etc    \\\n"
"            --disable-efiemu     \\\n"
"            --with-platform=efi  \\\n"
"            --target=x86_64      \\\n"
"            --disable-werror     &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>./configure --prefix=/usr        \\\n"
"            --sysconfdir=/etc    \\\n"
"            --disable-efiemu     \\\n"
"            --with-platform=efi  \\\n"
"            --target=x86_64      \\\n"
"            --disable-werror     &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/postlfs/filesystems/uefi-bootloaders/grub-efi.xml:170
#, xml-text
msgid "This package does not have a test suite providing meaningful results."
msgstr ""
"Esse pacote não tem uma suíte de teste que forneça resultados "
"significativos."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/postlfs/filesystems/uefi-bootloaders/grub-efi.xml:174
#, xml-text
msgid ""
"Now, if you've skipped the LFS GRUB package, as the <systemitem "
"class=\"username\">root</systemitem> user install GRUB and skip the "
"remaining instructions in this section:"
msgstr ""
"Agora, se você tiver pulado o pacote GRUB do LFS, como o(a) usuário(a) "
"<systemitem class=\"username\">root</systemitem>, instale o GRUB e pule as "
"instruções restantes nesta seção:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/postlfs/filesystems/uefi-bootloaders/grub-efi.xml:179
#, no-wrap, xml-text
msgid ""
"<userinput>make install &amp;&amp;\n"
"mv -v /etc/bash_completion.d/grub /usr/share/bash-completion/completions</userinput>"
msgstr ""
"<userinput>make install &amp;&amp;\n"
"mv -v /etc/bash_completion.d/grub /usr/share/bash-completion/completions</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/postlfs/filesystems/uefi-bootloaders/grub-efi.xml:183
#, xml-text
msgid ""
"If you've not skipped LFS GRUB package, as the &root; user, only install the"
" components not installed from the LFS GRUB package instead:"
msgstr ""
"Se você não tiver ignorado o pacote GRUB do LFS, como o(a) usuário(a) "
"&root;, instale somente os componentes não instalados a partir do pacote "
"GRUB do LFS:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/postlfs/filesystems/uefi-bootloaders/grub-efi.xml:187
#, no-wrap, xml-text
msgid "<userinput>make -C grub-core install</userinput>"
msgstr "<userinput>make -C grub-core install</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/postlfs/filesystems/uefi-bootloaders/grub-efi.xml:190
#, xml-text
msgid ""
"If you've installed the optional font data and <xref linkend='freetype2'/>, "
"install the <command>grub-mkfont</command> program and the font data files "
"(without the font data files GRUB can still function normally, but the boot "
"menu will be displayed using a coarse font or in a smaller region on the "
"screen)."
msgstr ""
"Se você tiver instalado os dados opcionais de fonte e <xref "
"linkend='freetype2'/>, instale o programa <command>grub-mkfont</command> e "
"os arquivos de dados de fonte (sem os arquivos de dados de fonte, o GRUB "
"ainda pode funcionar normalmente, mas o menu de inicialização será exibido "
"usando uma fonte grosseira ou em uma região menor na tela)."

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/postlfs/filesystems/uefi-bootloaders/grub-efi.xml:198
#, no-wrap, xml-text
msgid ""
"<userinput>install -vm755 grub-mkfont /usr/bin/ &amp;&amp;\n"
"install -vm644 ascii.h widthspec.h *.pf2 /usr/share/grub/</userinput>"
msgstr ""
"<userinput>install -vm755 grub-mkfont /usr/bin/ &amp;&amp;\n"
"install -vm644 ascii.h widthspec.h *.pf2 /usr/share/grub/</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/postlfs/filesystems/uefi-bootloaders/grub-efi.xml:202
#, xml-text
msgid ""
"If both <xref linkend='fuse3'/> and <xref linkend='lvm2'/> are installed, "
"also install the <command>grub-mount</command> program:"
msgstr ""
"Se <xref linkend='fuse3'/> e <xref linkend='lvm2'/> estiverem instalados, "
"instale também o programa <command>grub-mount</command>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/postlfs/filesystems/uefi-bootloaders/grub-efi.xml:206
#, no-wrap, xml-text
msgid "<userinput>install -vm755 grub-mount /usr/bin/</userinput>"
msgstr "<userinput>install -vm755 grub-mount /usr/bin/</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/postlfs/filesystems/uefi-bootloaders/grub-efi.xml:211
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/postlfs/filesystems/uefi-bootloaders/grub-efi.xml:229
#, xml-text
msgid ""
"<parameter>--with-platform=efi</parameter>: Ensures building GRUB with EFI "
"enabled."
msgstr ""
"<parameter>--with-platform=efi</parameter>: Garante a construção do GRUB com"
" EFI habilitado."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/postlfs/filesystems/uefi-bootloaders/grub-efi.xml:234
#, xml-text
msgid ""
"<parameter>--target=x86_64</parameter>: Ensures building GRUB for x86_64 "
"even if building on a 32-bit LFS system.  Most EFI firmware on x86_64 does "
"not support 32-bit bootloaders."
msgstr ""
"<parameter>--target=x86_64</parameter>: Garante a construção do GRUB para "
"x86_64, mesmo se construir em um sistema LFS de 32 bits. A maioria do "
"firmware EFI em x86_64 não suporta carregadores de inicialização de 32 bits."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/postlfs/filesystems/uefi-bootloaders/grub-efi.xml:240
#, xml-text
msgid ""
"<option>--target=i386</option>: A few 32-bit x86 platforms have EFI support."
"  And, some x86_64 platforms have a 32-bit EFI implementation, but they are "
"very old and rare. Use this instead of "
"<parameter>--target=x86_64</parameter> if you are <emphasis "
"role='bold'>absolutely sure</emphasis> that LFS is running on such a system."
msgstr ""
"<option>--target=i386</option>: Algumas plataformas x86 de 32 bits tem "
"suporte EFI. E algumas plataformas x86_64 tem uma implementação EFI de 32 "
"bits, mas são muito antigas e raras. Use isso ao invés de "
"<parameter>--target=x86_64</parameter> se você estiver <emphasis "
"role='bold'>absolutamente seguro(a)</emphasis> de que o LFS está executando "
"em tal sistema."

#. type: Content of: <sect1><sect2><title>
#: blfs-en/postlfs/filesystems/uefi-bootloaders/grub-efi.xml:251
#, xml-text
msgid "Configuring GRUB"
msgstr "Configurando o GRUB"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/postlfs/filesystems/uefi-bootloaders/grub-efi.xml:254
#, xml-text
msgid ""
"Using GRUB to make the LFS system bootable on UEFI platform will be "
"discussed in <xref linkend=\"grub-setup\"/>."
msgstr ""
"Usar o GRUB para tornar o sistema LFS inicializável na plataforma UEFI será "
"discutido em <xref linkend=\"grub-setup\"/>."

#. type: Content of: <sect1><sect2><title>
#: blfs-en/postlfs/filesystems/uefi-bootloaders/grub-efi.xml:260
#, xml-text
msgid "Contents"
msgstr "Conteúdo"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/postlfs/filesystems/uefi-bootloaders/grub-efi.xml:263
#, xml-text
msgid ""
"A list of the installed files, along with their short descriptions can be "
"found at <ulink url=\"&lfs-root;/chapter08/grub.html#contents-gRUB\"/>."
msgstr ""
"Uma lista dos arquivos instalados, juntamente com descrições curtas deles, "
"pode ser encontrada em <ulink url=\"&lfs-root;/chapter08/grub.html#contents-"
"gRUB\"/>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/postlfs/filesystems/uefi-bootloaders/grub-efi.xml:269
#, xml-text
msgid ""
"Listed below are the newly installed programs along with short descriptions."
msgstr ""
"Listados abaixo estão os programas recém-instalados, juntamente com "
"descrições curtas."

#. type: Content of: <sect1><sect2><segmentedlist><segtitle>
#: blfs-en/postlfs/filesystems/uefi-bootloaders/grub-efi.xml:274
#, xml-text
msgid "Installed Programs"
msgstr "Aplicativos Instalados"

#. type: Content of: <sect1><sect2><segmentedlist><segtitle>
#: blfs-en/postlfs/filesystems/uefi-bootloaders/grub-efi.xml:275
#, xml-text
msgid "Installed Directories"
msgstr "Diretórios Instalados"

#. type: Content of: <sect1><sect2><segmentedlist><seglistitem><seg>
#: blfs-en/postlfs/filesystems/uefi-bootloaders/grub-efi.xml:278
#, xml-text
msgid "grub-mkfont and grub-mount (optional)"
msgstr "grub-mkfont e grub-mount (opcional)"

#. type: Content of: <sect1><sect2><segmentedlist><seglistitem><seg>
#: blfs-en/postlfs/filesystems/uefi-bootloaders/grub-efi.xml:279
#, xml-text
msgid "/usr/lib/grub/x86_64-efi"
msgstr "/usr/lib/grub/x86_64-efi"

#. type: Content of: <sect1><sect2><variablelist><bridgehead>
#: blfs-en/postlfs/filesystems/uefi-bootloaders/grub-efi.xml:284
#, xml-text
msgid "Short Descriptions"
msgstr "Descrições Curtas"

