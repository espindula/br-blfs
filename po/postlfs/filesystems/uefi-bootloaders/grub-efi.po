#. type: Content of: <sect1><sect2><title>
#: blfs-en/postlfs/filesystems/uefi-bootloaders/grub-efi.xml:30
#, xml-text
msgid "Introduction to GRUB"
msgstr "Introdução ao GRUB"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/postlfs/filesystems/uefi-bootloaders/grub-efi.xml:33
#, xml-text
msgid ""
"The <application>GRUB</application> package provides GRand Unified "
"Bootloader.  In this page it will be built with UEFI support, which is not "
"enabled for GRUB built in LFS."
msgstr ""
"O pacote <application>GRUB</application> fornece o GRand Unified Bootloader."
" Nesta página, ele será construído com suporte UEFI, que não está habilitado"
" para o GRUB construído no LFS."

