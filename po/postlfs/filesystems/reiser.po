msgstr "Instalação do reiserfsprogs"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/postlfs/filesystems/reiser.xml:92
msgid ""
"Install <application>reiserfsprogs</application> by running the following "
"commands:"
msgstr ""
"Instale <application>reiserfsprogs</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/postlfs/filesystems/reiser.xml:96
#, no-wrap
msgid ""
"<userinput>sed -i '/parse_time.h/i #define _GNU_SOURCE' lib/parse_time.c &amp;&amp;\n"
"autoreconf -fiv           &amp;&amp;\n"
"\n"
"./configure --prefix=/usr &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>sed -i '/parse_time.h/i #define _GNU_SOURCE' lib/parse_time.c &amp;&amp;\n"
"autoreconf -fiv          &amp;&amp;\n"
"\n"
"./configure --prefix=/usr &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/postlfs/filesystems/reiser.xml:103
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/postlfs/filesystems/reiser.xml:107
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/postlfs/filesystems/reiser.xml:110
#, no-wrap
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

