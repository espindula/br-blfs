#. type: Content of: <sect1><sect2><title>
#: blfs-en/postlfs/filesystems/smartmontools.xml:116
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/postlfs/filesystems/smartmontools.xml:119
#, xml-text
msgid ""
"<parameter>--with-initscriptdir=no</parameter>: This switch suppresses the "
"default initialization script.  See below for the BLFS script."
msgstr ""
"<parameter>--with-initscriptdir=no</parameter>: Essa chave suprime o script "
"padrão de inicialização. Veja-se abaixo para o script do BLFS."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/postlfs/filesystems/smartmontools.xml:124
#, xml-text
msgid ""
"<parameter>--with-libsystemd=no</parameter>: This switch disables support "
"for the sd-notify notification system provided by systemd."
msgstr ""
"<parameter>--with-libsystemd=no</parameter>: Essa chave desabilita o suporte"
" para o sistema de notificação sd-notify fornecido pelo systemd."

