#. type: Content of: <sect1><sect2><title>
#: blfs-en/postlfs/filesystems/smartmontools.xml:26
#, xml-text
msgid "Introduction to smartmontools"
msgstr "Introdução ao smartmontools"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/postlfs/filesystems/smartmontools.xml:29
#, xml-text
msgid ""
"The <application>smartmontools</application> package contains utility "
"programs (smartctl, smartd) to control/monitor storage systems using the "
"Self-Monitoring, Analysis and Reporting Technology System (S.M.A.R.T.)  "
"built into most modern ATA and SCSI disks."
msgstr ""
"O pacote <application>smartmontools</application> contém aplicativos "
"utilitários (smartctl, smartd) para controlar/monitorar sistemas de "
"armazenamento usando o Self-Monitoring, Analysis and Reporting Technology "
"System (S.M.A.R.T.) embutido nos discos ATA e SCSI mais modernos."

