#. type: Content of: <sect1><sect2><title>
#: blfs-en/postlfs/filesystems/smartmontools.xml:84
#, xml-text
msgid "Installation of smartmontools"
msgstr "Instalação do smartmontools"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/postlfs/filesystems/smartmontools.xml:87
#, xml-text
msgid ""
"Install <application>smartmontools</application> by running the following "
"commands:"
msgstr ""
"Instale <application>smartmontools</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/postlfs/filesystems/smartmontools.xml:91
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr           \\\n"
"            --sysconfdir=/etc       \\\n"
"            --with-initscriptdir=no \\\n"
"            --with-libsystemd=no    \\\n"
"            --docdir=/usr/share/doc/smartmontools-&smartmontools-version; &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>./configure --prefix=/usr          \\\n"
"            --sysconfdir=/etc       \\\n"
"            --with-initscriptdir=no \\\n"
"            --with-libsystemd=no    \\\n"
"            --docdir=/usr/share/doc/smartmontools-&smartmontools-version; &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/postlfs/filesystems/smartmontools.xml:98
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr           \\\n"
"            --sysconfdir=/etc       \\\n"
"            --docdir=/usr/share/doc/smartmontools-&smartmontools-version; &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>./configure --prefix=/usr          \\\n"
"            --sysconfdir=/etc       \\\n"
"            --docdir=/usr/share/doc/smartmontools-&smartmontools-version; &amp;&amp;\n"
"make</userinput>"

