#, xml-text
msgid "Introduction to dosfstools"
msgstr "Introdução ao dosfstools"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/postlfs/filesystems/dosfstools.xml:29
#, xml-text
msgid ""
"The <application>dosfstools</application> package contains various utilities"
" for use with the FAT family of file systems."
msgstr ""
"O pacote <application>dosfstools</application> contém vários utilitários "
"para uso com a família FAT de sistemas de arquivos."

