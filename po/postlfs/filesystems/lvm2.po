#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/postlfs/filesystems/lvm2.xml:365
#, xml-text
msgid ""
"The default configuration still references the obsolete <filename "
"class=\"directory\">/var/lock</filename> directory. This creates a deadlock "
"at boot time. Change this (as the <systemitem "
"class=\"username\">root</systemitem> user):"
msgstr ""
"A configuração padrão ainda referencia o obsoleto diretório <filename "
"class=\"directory\">/var/lock</filename>. Isso cria um impasse ao tempo da "
"inicialização. Mude isso (como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>):"

#. type: Content of: <sect1><sect2><sect3><screen>
#: blfs-en/postlfs/filesystems/lvm2.xml:371
#, no-wrap, xml-text
msgid ""
"<userinput>sed -e '/locking_dir =/{s/#//;s/var/run/}' \\\n"
"    -i /etc/lvm/lvm.conf</userinput>"
msgstr ""
"<userinput>sed -e '/locking_dir =/{s/#//;s/var/run/}' \\\n"
"   -i /etc/lvm/lvm.conf</userinput>"

