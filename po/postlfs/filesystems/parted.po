#. type: Content of: <sect1><sect2><para>
#: blfs-en/postlfs/filesystems/parted.xml:29
#, xml-text
msgid ""
"The <application>Parted</application> package is a disk partitioning and "
"partition resizing tool."
msgstr ""
"O pacote <application>Parted</application> é uma ferramenta de "
"particionamento de disco e de redimensionamento de partição."

