#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/postlfs/filesystems/parted.xml:196
#, xml-text
msgid ""
"<option>--disable-device-mapper</option>: This option disables device mapper"
" support. Add this parameter if you have not installed "
"<application>LVM2</application>."
msgstr ""
"<option>--disable-device-mapper</option>: Essa opção desabilita o suporte a "
"mapeador de dispositivos. Adicione esse parâmetro se você não tiver "
"instalado o <application>LVM2</application>."

