#. type: Content of: <sect1><sect2><title>
#: blfs-en/postlfs/filesystems/xfsprogs.xml:102
#, xml-text
msgid "Installation of xfsprogs"
msgstr "Instalação do xfsprogs"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/postlfs/filesystems/xfsprogs.xml:105
#, xml-text
msgid "First, adapt the configure script to ICU-76::"
msgstr ""
"Primeiro, adapte o conjunto de comandos sequenciais configure para ICU-76::"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/postlfs/filesystems/xfsprogs.xml:108
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"pre\">sed -i 's/icu-i18n/icu-uc &amp;/' "
"configure</userinput>"
msgstr ""
"<userinput remap=\"pre\">sed -i 's/icu-i18n/icu-uc &amp;/' "
"configure</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/postlfs/filesystems/xfsprogs.xml:111
#, xml-text
msgid ""
"Install <application>xfsprogs</application> by running the following "
"commands:"
msgstr ""
"Instale <application>xfsprogs</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/postlfs/filesystems/xfsprogs.xml:115
#, no-wrap, xml-text
msgid ""
"<userinput>make DEBUG=-DNDEBUG     \\\n"
"     INSTALL_USER=root  \\\n"
"     INSTALL_GROUP=root \\\n"
"     LOCAL_CONFIGURE_OPTIONS=\"--localstatedir=/var\"</userinput>"
msgstr ""
"<userinput>make DEBUG=-DNDEBUG     \\\n"
"     INSTALL_USER=root  \\\n"
"     INSTALL_GROUP=root \\\n"
"     LOCAL_CONFIGURE_OPTIONS=\"--localstatedir=/var\"</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/postlfs/filesystems/xfsprogs.xml:121
#, xml-text
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/postlfs/filesystems/xfsprogs.xml:125
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/postlfs/filesystems/xfsprogs.xml:128
#, no-wrap, xml-text
msgid ""
"<userinput>make PKG_DOC_DIR=/usr/share/doc/xfsprogs-&xfsprogs-version; install     &amp;&amp;\n"
"make PKG_DOC_DIR=/usr/share/doc/xfsprogs-&xfsprogs-version; install-dev &amp;&amp;\n"
"\n"
"rm -rfv /usr/lib/libhandle.{a,la}</userinput>"
msgstr ""
"<userinput>make PKG_DOC_DIR=/usr/share/doc/xfsprogs-&xfsprogs-version; install    &amp;&amp;\n"
"make PKG_DOC_DIR=/usr/share/doc/xfsprogs-&xfsprogs-version; install-dev &amp;&amp;\n"
"\n"
"rm -rfv /usr/lib/libhandle.{a,la}</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/postlfs/filesystems/xfsprogs.xml:136
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/postlfs/filesystems/xfsprogs.xml:139
#, xml-text
msgid "<parameter>DEBUG=-DNDEBUG</parameter>: Turns off debugging symbols."
msgstr ""
"<parameter>DEBUG=-DNDEBUG</parameter>: Desliga os símbolos de depuração."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/postlfs/filesystems/xfsprogs.xml:144
#, xml-text
msgid ""
"<parameter>INSTALL_USER=root</parameter> "
"<parameter>INSTALL_GROUP=root</parameter>: This sets the owner and group of "
"the installed files."
msgstr ""
"<parameter>INSTALL_USER=root</parameter> "
"<parameter>INSTALL_GROUP=root</parameter>: Isso configura o(a) "
"proprietário(a) e o grupo dos arquivos instalados."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/postlfs/filesystems/xfsprogs.xml:150
#, xml-text
msgid ""
"<parameter>LOCAL_CONFIGURE_OPTIONS=\"--localstatedir=/var\"</parameter>: "
"This sets the state directory to /var, preventing /usr/var from being "
"created."
msgstr ""
"<parameter>LOCAL_CONFIGURE_OPTIONS=\"--localstatedir=/var\"</parameter>: "
"Isso configura o diretório de estado como /var, impedindo que /usr/var seja "
"criado."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/postlfs/filesystems/xfsprogs.xml:156
#, xml-text
msgid ""
"<option>OPTIMIZER=\"...\"</option>: Adding this parameter to the end of the "
"<command>make</command> command overrides the default optimization settings."
msgstr ""
"<option>OPTIMIZER=\"...\"</option>: Adicionar esse parâmetro ao final do "
"comando <command>make</command> substitui as configurações padrão de "
"otimização."

