#. type: Content of: <sect1><sect2><title>
#: blfs-en/pst/scanning/xsane.xml:26
msgid "Introduction to XSane"
msgstr "Introdução ao XSane"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/pst/scanning/xsane.xml:29
msgid ""
"<application>XSane</application> is another front end for <xref "
"linkend=\"sane\"/>. It has additional features to improve the image quality "
"and ease of use compared to <command>xscanimage</command>."
msgstr ""
"<application>XSane</application> é outra estrutura de interação direta com "
"o(a) usuário(a) para <xref linkend=\"sane\"/>. Ela tem recursos adicionais "
"para melhorar a qualidade da imagem e facilidade de uso comparado com o "
"<command>xscanimage</command>."

