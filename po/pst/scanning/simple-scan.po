#. type: Content of: <sect1><sect2><title>
#: blfs-en/pst/scanning/simple-scan.xml:84
#, xml-text
msgid "Installation of Simple-scan"
msgstr "Instalação do Simple-scan"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/pst/scanning/simple-scan.xml:87
#, xml-text
msgid ""
"Install <application>Simple-scan</application> by running the following "
"commands:"
msgstr ""
"Instale <application>Simple-scan</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/pst/scanning/simple-scan.xml:91
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr --buildtype=release .. &amp;&amp;\n"
"ninja</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr --buildtype=release .. &amp;&amp;\n"
"ninja</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/pst/scanning/simple-scan.xml:98
#, xml-text
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/pst/scanning/simple-scan.xml:102
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/pst/scanning/simple-scan.xml:105
#, no-wrap, xml-text
msgid ""
"<userinput>ninja install &amp;&amp;\n"
"gtk-update-icon-cache -qtf /usr/share/icons/hicolor</userinput>"
msgstr ""
"<userinput>ninja install &amp;&amp;\n"
"gtk-update-icon-cache -qtf /usr/share/icons/hicolor</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/pst/scanning/simple-scan.xml:111
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/pst/scanning/simple-scan.xml:117
#, xml-text
msgid ""
"<command>gtk-update-icon-cache [...]</command>: This command updates the "
"system-wide GTK+ icon cache since Simple-scan's build system does not update"
" it to account for the icons that it installs."
msgstr ""
"<command>gtk-update-icon-cache [...]</command>: Esse comando atualiza o "
"cache de ícones do GTK+ abrangente a todo o sistema, pois o sistema de "
"construção do Simple-scan não o atualiza para dar conta dos ícones que ele "
"instala."

