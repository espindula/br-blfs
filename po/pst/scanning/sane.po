#~ "\n"
#~ "sed -i -e \"/SANE_CAP_ALWAYS_SETTABLE/d\" src/gtkglue.c &amp;&amp;\n"
#~ "./configure --prefix=/usr --mandir=/usr/share/man &amp;&amp;\n"
#~ "make</userinput>"
#~ msgstr ""
