#. type: Content of: <sect1><sect2><para>
#: blfs-en/pst/xml/docbook5.xml:175
#, xml-text
msgid ""
"Create (or update) and populate the system XML catalog "
"(<filename>/etc/xml/catalog</filename>) by running the following commands as"
" the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Crie (ou atualize) e povoe o catálogo XML do sistema "
"(<filename>/etc/xml/catalog</filename>) executando os seguintes comandos "
"como o(a) usuário(a) <systemitem class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/pst/xml/docbook5.xml:181
#, no-wrap, xml-text
msgid ""
"<userinput>if [ ! -e /etc/xml/catalog ]; then\n"
"    install -v -d -m755 /etc/xml &amp;&amp;\n"
"    xmlcatalog --noout --create /etc/xml/catalog\n"
"fi &amp;&amp;\n"
"xmlcatalog --noout --add \"delegatePublic\" \\\n"
"  \"-//OASIS//DTD DocBook XML 5.0//EN\" \\\n"
"  \"file:///usr/share/xml/docbook/schema/dtd/5.0/catalog.xml\" \\\n"
"  /etc/xml/catalog &amp;&amp;\n"
"xmlcatalog --noout --add \"delegateSystem\" \\\n"
"  \"http://docbook.org/xml/5.0/dtd/\" \\\n"
"  \"file:///usr/share/xml/docbook/schema/dtd/5.0/catalog.xml\" \\\n"
"  /etc/xml/catalog &amp;&amp;\n"
