#. type: Content of: <sect1><sect2><screen>
#: blfs-en/pst/xml/docbook5.xml:94
#, no-wrap, xml-text
msgid ""
"<userinput>install -vdm755 /usr/share/xml/docbook/schema/{dtd,rng,sch,xsd}/5.0 &amp;&amp;\n"
"install -vm644  dtd/* /usr/share/xml/docbook/schema/dtd/5.0         &amp;&amp;\n"
"install -vm644  rng/* /usr/share/xml/docbook/schema/rng/5.0         &amp;&amp;\n"
"install -vm644  sch/* /usr/share/xml/docbook/schema/sch/5.0         &amp;&amp;\n"
"install -vm644  xsd/* /usr/share/xml/docbook/schema/xsd/5.0</userinput>"
msgstr ""
