"    \"-//OASIS//ENTITIES DocBook XML Additional General Entities V&docBook-45-xml-version;//EN\" \\\n"
"    \"file:///usr/share/xml/docbook/xml-dtd-&docBook-45-xml-version;/dbgenent.mod\"              \\\n"
"    /etc/xml/docbook &amp;&amp;\n"
"\n"
"xmlcatalog --noout --add \"rewriteSystem\" &spacing-to-match-versi;    \\\n"
"    \"http://www.oasis-open.org/docbook/xml/&docBook-45-xml-version;\" \\\n"
