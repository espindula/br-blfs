#. type: Content of: <sect1><sect2><para>
#: blfs-en/pst/xml/docbook-45-xml.xml:99
#, xml-text
msgid ""
"Install <application>DocBook XML DTD</application> by running the following "
"commands as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Instale o <application>DocBook XML DTD</application> executando os seguintes"
" comandos como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/pst/xml/docbook-45-xml.xml:104
#, no-wrap, xml-text
msgid ""
"<userinput>install -v -d -m755 /usr/share/xml/docbook/xml-dtd-&docBook-45-xml-version;         &amp;&amp;\n"
"install -v -d -m755 /etc/xml                                   &amp;&amp;\n"
"cp -v -af --no-preserve=ownership docbook.cat *.dtd ent/ *.mod \\\n"
"    /usr/share/xml/docbook/xml-dtd-&docBook-45-xml-version;</userinput>"
msgstr ""
"<userinput>install -v -d -m755 /usr/share/xml/docbook/xml-dtd-&docBook-45-xml-version;         &amp;&amp;\n"
"install -v -d -m755 /etc/xml                                   &amp;&amp;\n"
"cp -v -af --no-preserve=ownership docbook.cat *.dtd ent/ *.mod \\\n"
"    /usr/share/xml/docbook/xml-dtd-&docBook-45-xml-version;</userinput>"

