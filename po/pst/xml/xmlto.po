#. type: Content of: <sect1><sect2><title>
#: blfs-en/pst/xml/xmlto.xml:105
#, xml-text
msgid "Installation of xmlto"
msgstr "Instalação do xmlto"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/pst/xml/xmlto.xml:108
#, xml-text
msgid ""
"Install <application>xmlto</application> by running the following commands:"
msgstr ""
"Instale o <application>xmlto</application> executando os seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/pst/xml/xmlto.xml:112
#, no-wrap, xml-text
msgid ""
"<userinput>autoreconf -fiv                                  &amp;&amp;\n"
"LINKS=\"/usr/bin/links\" ./configure --prefix=/usr &amp;&amp;\n"
"\n"
"make</userinput>"
msgstr ""
"<userinput>autoreconf -fiv                                  &amp;&amp;\n"
"LINKS=\"/usr/bin/links\" ./configure --prefix=/usr &amp;&amp;\n"
"\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/pst/xml/xmlto.xml:118
#, xml-text
msgid "To test the results, issue: <command>make check</command>."
msgstr "Para testar os resultados, emita: <command>make check</command>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/pst/xml/xmlto.xml:122
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/pst/xml/xmlto.xml:125
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/pst/xml/xmlto.xml:130
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/pst/xml/xmlto.xml:133
#, xml-text
msgid ""
"<envar>LINKS=\"/usr/bin/links\"</envar>: This environment variable fixes a "
"bug causing <command>xmlto</command> to think that <command>links</command> "
"command is the same as <command>elinks</command>. Setting this variable does"
" not cause problems if <xref linkend=\"Links\"/> is not installed, unless "
"you have <ulink url=\"http://elinks.or.cz/\">ELinks</ulink> installed, and "
"you wish to use it for text backend post-processing. If you do wish to "
"ELinks, you should remove this environment variable."
msgstr ""
"<envar>LINKS=\"/usr/bin/links\"</envar>: Essa variável de ambiente corrige "
"um defeito que faz com que o <command>xmlto</command> pense que o comando "
"<command>links</command> é o mesmo que <command>elinks</command>. Configurar"
" essa variável não causa problemas se o <xref linkend=\"Links\"/> não "
"estiver instalado, a menos que você tenha o <ulink "
"url=\"http://elinks.or.cz/\">ELinks</ulink> instalado e deseje usá-lo para "
"pós-processamento da estrutura de retaguarda de texto. Se desejar ELinks, "
"você deveria remover essa variável de ambiente."

