#. type: Content of: <sect1><sect2><title>
#: blfs-en/pst/xml/xmlto.xml:26
#, xml-text
msgid "Introduction to xmlto"
msgstr "Introdução ao xmlto"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/pst/xml/xmlto.xml:29
#, xml-text
msgid ""
"The <application>xmlto</application> package is a front-end to a XSL "
"toolchain. It chooses an appropriate stylesheet for the conversion you want "
"and applies it using an external XSLT processor. It also performs any "
"necessary post-processing."
msgstr ""
"O pacote <application>xmlto</application> é uma estrutura de interação "
"direta com o(a) usante para uma cadeia de ferramentas de XSL. Ela escolhe "
"uma folha de estilo apropriada para a conversão que você queira e a aplica "
"usando um processador externo de XSLT. Ele também realiza qualquer pós-"
"processamento necessário."

