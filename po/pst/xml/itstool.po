#. type: Content of: <sect1><sect2><title>
#: blfs-en/pst/xml/itstool.xml:81
#, xml-text
msgid "Installation of itstool"
msgstr "Instalação do itstool"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/pst/xml/itstool.xml:84
#, xml-text
msgid "First, fix some compatibility problems with Python-3.12:"
msgstr ""
"Primeiro, corrija alguns problemas de compatibilidade com Python-3.12:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/pst/xml/itstool.xml:87
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"pre\">sed -i 's/re.sub(/re.sub(r/'         itstool.in &amp;&amp;\n"
"sed -i 's/re.compile(/re.compile(r/' itstool.in</userinput>"
msgstr ""
"<userinput remap=\"pre\">sed -i 's/re.sub(/re.sub(r/'         itstool.in &amp;&amp;\n"
"sed -i 's/re.compile(/re.compile(r/' itstool.in</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/pst/xml/itstool.xml:91
#, xml-text
msgid ""
"Install <application>itstool</application> by running the following "
"commands:"
msgstr ""
"Instale o <application>itstool</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/pst/xml/itstool.xml:95
#, no-wrap, xml-text
msgid ""
"<userinput>PYTHON=/usr/bin/python3 ./configure --prefix=/usr &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>PYTHON=/usr/bin/python3 ./configure --prefix=/usr &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/pst/xml/itstool.xml:105
#, xml-text
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/pst/xml/itstool.xml:109
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/pst/xml/itstool.xml:112
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

