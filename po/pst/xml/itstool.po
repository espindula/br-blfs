#. type: Content of: <sect1><sect2><title>
#: blfs-en/pst/xml/itstool.xml:92
#, xml-text
msgid "Installation of itstool"
msgstr "Instalação do itstool"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/pst/xml/itstool.xml:95
#, xml-text
msgid ""
"First, apply a patch to use <xref linkend='lxml'/> for handling the XML "
"files instead of the deprecated (disabled by default) Python module from "
"<xref linkend='libxml2'/>:"
msgstr ""
"Primeiro, aplique um remendo para usar <xref linkend='lxml'/> para manusear "
"os arquivos XML em vez do módulo Python obsoleto (desabilitado por padrão) "
"originário de <xref linkend='libxml2'/>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/pst/xml/itstool.xml:100
#, no-wrap, xml-text
msgid ""
"<userinput>patch -Np1 -i ../itstool-&itstool-"
"version;-lxml-1.patch</userinput>"
msgstr ""
"<userinput>patch -Np1 -i ../itstool-&itstool-"
"version;-lxml-1.patch</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/pst/xml/itstool.xml:103
#, xml-text
msgid ""
"Install <application>itstool</application> by running the following "
"commands:"
msgstr ""
"Instale o <application>itstool</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/pst/xml/itstool.xml:107
#, no-wrap, xml-text
msgid ""
"<userinput>PYTHON=/usr/bin/python3 ./autogen.sh --prefix=/usr &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>PYTHON=/usr/bin/python3 ./autogen.sh --prefix=/usr &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/pst/xml/itstool.xml:111
#, xml-text
msgid ""
"To test the results, issue: <command>python3 tests/run_tests.py</command>."
msgstr ""
"Para testar os resultados, emita: <command>python3 "
"tests/run_tests.py</command>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/pst/xml/itstool.xml:115
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr "Agora, como o(a) usante <systemitem class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/pst/xml/itstool.xml:118
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

