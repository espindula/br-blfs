#. type: Content of: <sect1><sect2><title>
#: blfs-en/pst/ps/enscript.xml:105
#, xml-text
msgid "Installation of Enscript"
msgstr "Instalação do Enscript"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/pst/ps/enscript.xml:108
#, xml-text
msgid ""
"Install <application>Enscript</application> by running the following "
"commands:"
msgstr ""
"Instale o <application>Enscript</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/pst/ps/enscript.xml:112
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr              \\\n"
"            --sysconfdir=/etc/enscript \\\n"
"            --localstatedir=/var       \\\n"
"            --with-media=Letter        &amp;&amp;\n"
"make CC=\"gcc -std=gnu17\"               &amp;&amp;\n"
"\n"
"pushd docs &amp;&amp;\n"
"  makeinfo --plaintext -o enscript.txt enscript.texi &amp;&amp;\n"
"popd</userinput>"
msgstr ""
"<userinput>./configure --prefix=/usr              \\\n"
"            --sysconfdir=/etc/enscript \\\n"
"            --localstatedir=/var       \\\n"
"            --with-media=Letter        &amp;&amp;\n"
"make CC=\"gcc -std=gnu17\"               &amp;&amp;\n"
"\n"
"pushd docs &amp;&amp;\n"
"  makeinfo --plaintext -o enscript.txt enscript.texi &amp;&amp;\n"
"popd</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/pst/ps/enscript.xml:123
#, xml-text
msgid ""
"If you have <xref linkend=\"texlive\"/> installed, you can create Postscript"
" and PDF documentation by issuing (does not support parallel make):"
msgstr ""
"Se tiver <xref linkend=\"texlive\"/> instalado, você consegue criar "
"documentação PostScript e PDF emitindo (não suporta make paralelo):"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/pst/ps/enscript.xml:128
#, no-wrap, xml-text
msgid "<userinput>make -j1 -C docs ps pdf</userinput>"
msgstr "<userinput>make -j1 -C docs ps pdf</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/pst/ps/enscript.xml:131
#, xml-text
msgid "To test the results, issue: <command>make check</command>."
msgstr "Para testar os resultados, emita: <command>make check</command>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/pst/ps/enscript.xml:135
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/pst/ps/enscript.xml:138
#, no-wrap, xml-text
msgid ""
"<userinput>make install &amp;&amp;\n"
"\n"
"install -v -m755 -d /usr/share/doc/enscript-&enscript-version; &amp;&amp;\n"
"install -v -m644    README* *.txt docs/*.txt \\\n"
"                    /usr/share/doc/enscript-&enscript-version;</userinput>"
msgstr ""
"<userinput>make install &amp;&amp;\n"
"\n"
"install -v -m755 -d /usr/share/doc/enscript-&enscript-version; &amp;&amp;\n"
"install -v -m644    README* *.txt docs/*.txt \\\n"
"                    /usr/share/doc/enscript-&enscript-version;</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/pst/ps/enscript.xml:145
#, xml-text
msgid ""
"If you built Postscript and PDF documentation, install it using the "
"following command as the <systemitem class=\"username\">root</systemitem> "
"user:"
msgstr ""
"Se você construiu documentação PostScript e PDF, instale-a usando o seguinte"
" comando como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/pst/ps/enscript.xml:151
#, no-wrap, xml-text
msgid ""
"<userinput>install -v -m644 docs/*.{dvi,pdf,ps} \\\n"
"                 /usr/share/doc/enscript-&enscript-version;</userinput>"
msgstr ""
"<userinput>install -v -m644 docs/*.{dvi,pdf,ps} \\\n"
"                 /usr/share/doc/enscript-&enscript-version;</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/pst/ps/enscript.xml:156
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/pst/ps/enscript.xml:159
#, xml-text
msgid ""
"<parameter>--sysconfdir=/etc/enscript</parameter>: This switch puts "
"configuration data in <filename class=\"directory\">/etc/enscript</filename>"
" instead of <filename class=\"directory\">/usr/etc</filename>."
msgstr ""
"<parameter>--sysconfdir=/etc/enscript</parameter>: Essa chave coloca os "
"dados de configuração em <filename "
"class=\"directory\">/etc/enscript</filename> em vez de <filename "
"class=\"directory\">/usr /etc</filename>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/pst/ps/enscript.xml:165
#, xml-text
msgid ""
"<parameter>--localstatedir=/var</parameter>: This switch sets the directory "
"for runtime data to <filename class=\"directory\">/var</filename> instead of"
" <filename class=\"directory\">/usr/var</filename>."
msgstr ""
"<parameter>--localstatedir=/var</parameter>: Essa chave configura o "
"diretório para dados de tempo de execução como <filename "
"class=\"directory\">/var</filename> em vez de <filename "
"class=\"directory\">/usr/var</filename>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/pst/ps/enscript.xml:171
#, xml-text
msgid ""
"<parameter>--with-media=Letter</parameter>: This switch sets the medium "
"format to letter size instead of the A4 default."
msgstr ""
"<parameter>--with-media=Letter</parameter>: Essa chave configura o formato "
"de mídias para tamanho carta em vez do padrão A4."

