#. type: Content of: <sect1><sect2><title>
#: blfs-en/pst/ps/enscript.xml:30
#, xml-text
msgid "Introduction to Enscript"
msgstr "Introdução ao Enscript"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/pst/ps/enscript.xml:33
#, xml-text
msgid ""
"<application>Enscript</application> converts ASCII text files to PostScript,"
" HTML, RTF, ANSI and overstrikes."
msgstr ""
"<application>Enscript</application> converte arquivos de texto ASCII em "
"PostScript, HTML, RTF, ANSI e sobreposições."

#. type: Content of: <sect1><sect2><caution><para>
#: blfs-en/pst/ps/enscript.xml:41
#, xml-text
msgid ""
"<application>Enscript</application> cannot convert UTF-8 encoded text to "
"PostScript. The issue is discussed in detail in the <xref linkend=\"locale-"
"not-valid-option\"/> section of the <xref linkend=\"locale-issues\"/> page."
"  The solution is to use <xref linkend=\"paps\"/>, instead of "
"<application>Enscript</application>, for converting UTF-8 encoded text to "
"PostScript."
msgstr ""
"<application>Enscript</application> não pode converter texto codificado em "
"UTF-8 para PostScript. O problema é discutido detalhadamente na seção <xref "
"linkend=\"locale-not-valid-option\"/> da página <xref linkend=\"locale-"
"issues\"/>. A solução é usar <xref linkend=\"paps\"/>, em vez de "
"<application>Enscript</application>, para converter texto codificado em "
"UTF-8 para PostScript."

