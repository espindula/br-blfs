#. type: Content of: <sect1><sect2><title>
#: blfs-en/pst/printing/cups-browsed.xml:88
#, xml-text
msgid "Installation of cups-browsed"
msgstr "Instalação do cups-browsed"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/pst/printing/cups-browsed.xml:91
#, xml-text
msgid ""
"Install <application>cups-browsed</application> by running the following "
"commands:"
msgstr ""
"Instale <application>cups-browsed</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/pst/printing/cups-browsed.xml:95
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr                \\\n"
"            --with-cups-rundir=/run/cups \\\n"
"            --without-rcdir              \\\n"
"            --disable-static             \\\n"
"            --docdir=/usr/share/doc/cups-browsed-&cups-browsed-version; &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>./configure --prefix=/usr                \\\n"
"            --with-cups-rundir=/run/cups \\\n"
"            --without-rcdir              \\\n"
"            --disable-static             \\\n"
"            --docdir=/usr/share/doc/cups-browsed-&cups-browsed-version; &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/pst/printing/cups-browsed.xml:107
#, xml-text
msgid "This package does not come with a functional test suite."
msgstr "Esse pacote não vem com uma suíte de teste funcional."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/pst/printing/cups-browsed.xml:111
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/pst/printing/cups-browsed.xml:114
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/pst/printing/cups-browsed.xml:117
#, xml-text
msgid ""
"Install the systemd unit by running the following command as the <systemitem"
" class=\"username\">root</systemitem> user:"
msgstr ""
"Instale a unidade do systemd executando o seguinte comando como o(a) "
"usuário(a) <systemitem class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/pst/printing/cups-browsed.xml:121
#, no-wrap, xml-text
msgid ""
"<userinput>install -v -m644 daemon/cups-browsed.service "
"/lib/systemd/system/cups-browsed.service</userinput>"
msgstr ""
"<userinput>install -v -m644 daemon/cups-browsed.service "
"/lib/systemd/system/cups-browsed.service</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/pst/printing/cups-browsed.xml:126
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/pst/printing/cups-browsed.xml:132
#, xml-text
msgid ""
"<parameter>--with-cups-rundir=/run/cups</parameter>: Defines the directory "
"containing transient printing data. The default <filename "
"class=\"directory\">/var/run/cups</filename> is obsolete."
msgstr ""
"<parameter>--with-cups-rundir=/run/cups</parameter>: Define o diretório que "
"contém dados transitórios de impressão. O padrão <filename "
"class=\"directory\">/var/run/cups</filename> está obsoleto."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/pst/printing/cups-browsed.xml:138
#, xml-text
msgid ""
"<parameter>--without-rcdir</parameter>: This switch disables installation of"
" the bundled bootscript which is not compatible with BLFS."
msgstr ""
"<parameter>--without-rcdir</parameter>: Essa chave desabilita instalação do "
"conjunto incluído de comandos sequenciais de inicialização que não é "
"compatível com o BLFS."

#. type: Content of: <sect1><sect2><title>
#: blfs-en/pst/printing/cups-browsed.xml:147
#, xml-text
msgid "Configuring cups-browsed"
msgstr "Configurando cups-browsed"

#. type: Content of: <sect1><sect2><sect3><title>
#: blfs-en/pst/printing/cups-browsed.xml:150
#, xml-text
msgid "Systemd Unit"
msgstr "Unidade do Systemd"

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/pst/printing/cups-browsed.xml:153
#, xml-text
msgid ""
"To start the <command>cups-browsed</command> daemon at boot, enable the "
"previously installed systemd unit by running the following command as the "
"<systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Para iniciar o processo de segundo plano <command>cups-browsed</command> na "
"inicialização, habilite a unidade do systemd instalada anteriormente "
"executando o seguinte comando como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><sect3><screen>
#: blfs-en/pst/printing/cups-browsed.xml:162
#, no-wrap, xml-text
msgid "<userinput>systemctl enable cups-browsed</userinput>"
msgstr "<userinput>systemctl enable cups-browsed</userinput>"

