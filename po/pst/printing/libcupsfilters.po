#. type: Content of: <sect1><sect2><para>
#: blfs-en/pst/printing/libcupsfilters.xml:117
#, xml-text
msgid ""
"Install <application>libcupsfilters</application> by running the following "
"commands:"
msgstr ""
"Instale <application>libcupsfilters</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/pst/printing/libcupsfilters.xml:121
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr    \\\n"
"            --disable-static \\\n"
"            --docdir=/usr/share/doc/libcupsfilters-&libcupsfilters-version; &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>./configure --prefix=/usr    \\\n"
"            --disable-static \\\n"
"            --docdir=/usr/share/doc/libcupsfilters-&libcupsfilters-version; &amp;&amp;\n"
"make</userinput>"

