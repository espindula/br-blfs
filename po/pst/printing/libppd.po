#. type: Content of: <sect1><sect2><title>
#: blfs-en/pst/printing/libppd.xml:80
#, xml-text
msgid "Installation of libppd"
msgstr "Instalação do libppd"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/pst/printing/libppd.xml:83
#, xml-text
msgid ""
"Install <application>libppd</application> by running the following commands:"
msgstr ""
"Instale <application>libppd</application> executando os seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/pst/printing/libppd.xml:87
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr                \\\n"
"            --disable-static             \\\n"
"            --with-cups-rundir=/run/cups \\\n"
"            --enable-ppdc-utils          \\\n"
"            --docdir=/usr/share/doc/libppd-&libppd-version; &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>./configure --prefix=/usr                \\\n"
"            --disable-static             \\\n"
"            --with-cups-rundir=/run/cups \\\n"
"            --enable-ppdc-utils          \\\n"
"            --docdir=/usr/share/doc/libppd-&libppd-version; &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/pst/printing/libppd.xml:95
#, xml-text
msgid "To test the results, issue <command>make check</command>."
msgstr "Para testar os resultados, emita <command>make check</command>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/pst/printing/libppd.xml:99
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/pst/printing/libppd.xml:102
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/pst/printing/libppd.xml:107
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/pst/printing/libppd.xml:113
#, xml-text
msgid ""
"<parameter>--with-cups-rundir=/run/cups</parameter>: Defines the directory "
"containing transient printing data. The default <filename "
"class=\"directory\">/var/run/cups</filename> is obsolete."
msgstr ""
"<parameter>--with-cups-rundir=/run/cups</parameter>: Define o diretório que "
"contém dados transitórios de impressão. O padrão <filename "
"class=\"directory\">/var/run/cups</filename> está obsoleto."

#.  This is not required until cups v3 is out, since those utilities
#.       are also installed by cups v2. But since cups v3 should be out before
#.       our next release, I put it here. Pierre
#. type: Content of: <sect1><sect2><para>
#: blfs-en/pst/printing/libppd.xml:119
#, xml-text
msgid ""
"<parameter>--enable-ppdc-utils</parameter>: Allows building utilities to "
"manipulate <emphasis>.ppd</emphasis> files."
msgstr ""
"<parameter>--enable-ppdc-utils</parameter>: Permite construir utilitários "
"para manipular arquivos <emphasis>.ppd</emphasis>."

