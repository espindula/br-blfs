#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/pst/sgml/docbook-4.5-dtd.xml:153
#, xml-text
msgid ""
"Using only the most current 4.x version of <application>DocBook SGML "
"DTD</application> requires the following (perform as the <systemitem "
"class=\"username\">root</systemitem> user):"
msgstr ""
"Usar somente a versão 4.x mais atual do <application>DocBook SGML "
"DTD</application> exige o seguinte (realizar como o(a) usuário(a) "
"<systemitem class=\"username\">root</systemitem>):"

#. type: Content of: <sect1><sect2><sect3><screen>
#: blfs-en/pst/sgml/docbook-4.5-dtd.xml:158
#, no-wrap, xml-text
msgid ""
"<userinput>cat &gt;&gt; /usr/share/sgml/docbook/sgml-dtd-&docbook-4.5-dtd-version;/catalog &lt;&lt; \"EOF\"\n"
"<literal>  -- Begin Single Major Version catalog changes --\n"
"\n"
"PUBLIC \"-//OASIS//DTD DocBook V4.4//EN\" \"docbook.dtd\"\n"
"PUBLIC \"-//OASIS//DTD DocBook V4.3//EN\" \"docbook.dtd\"\n"
"PUBLIC \"-//OASIS//DTD DocBook V4.2//EN\" \"docbook.dtd\"\n"
"PUBLIC \"-//OASIS//DTD DocBook V4.1//EN\" \"docbook.dtd\"\n"
"PUBLIC \"-//OASIS//DTD DocBook V4.0//EN\" \"docbook.dtd\"\n"
"\n"
"  -- End Single Major Version catalog changes --</literal>\n"
"EOF</userinput>"
msgstr ""
"<userinput>cat &gt;&gt; /usr/share/sgml/docbook/sgml-dtd-&docbook-4.5-dtd-version;/catalog &lt;&lt; \"EOF\"\n"
"<literal>  -- Inicia mudanças no catálogo de Versão Principal Única --\n"
"\n"
"PUBLIC \"-//OASIS//DTD DocBook V4.4//EN\" \"docbook.dtd\"\n"
"PUBLIC \"-//OASIS//DTD DocBook V4.3//EN\" \"docbook.dtd\"\n"
"PUBLIC \"-//OASIS//DTD DocBook V4.2//EN\" \"docbook.dtd\"\n"
"PUBLIC \"-//OASIS//DTD DocBook V4.1//EN\" \"docbook.dtd\"\n"
"PUBLIC \"-//OASIS//DTD DocBook V4.0//EN\" \"docbook.dtd\"\n"
"\n"
"  -- Termina mudanças no catálogo de Versão Principal Única --</literal>\n"
"EOF</userinput>"

