#. type: Content of: <sect1><sect2><title>
#: blfs-en/pst/sgml/opensp.xml:97
#, xml-text
msgid "Installation of OpenSP"
msgstr "Instalação do OpenSP"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/pst/sgml/opensp.xml:100
#, xml-text
msgid ""
"Install <application>OpenSP</application> by running the following commands:"
msgstr ""
"Instale o <application>OpenSP</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/pst/sgml/opensp.xml:104
#, no-wrap, xml-text
msgid ""
"<userinput>patch -Np1 -i ../OpenSP-&opensp-version;-gcc14-1.patch              &amp;&amp;\n"
"sed -i 's/32,/253,/' lib/Syntax.cxx                      &amp;&amp;\n"
"sed -i 's/LITLEN          240 /LITLEN          8092/'    \\\n"
"    unicode/{gensyntax.pl,unicode.syn}                   &amp;&amp;\n"
"\n"
"./configure --prefix=/usr                                \\\n"
"            --disable-static                             \\\n"
"            --disable-doc-build                          \\\n"
"            --enable-default-catalog=/etc/sgml/catalog   \\\n"
"            --enable-http                                \\\n"
"            --enable-default-search-path=/usr/share/sgml &amp;&amp;\n"
"\n"
"make pkgdatadir=/usr/share/sgml/OpenSP-&opensp-version;</userinput>"
msgstr ""
"<userinput>patch -Np1 -i ../OpenSP-&opensp-version;-gcc14-1.patch              &amp;&amp;\n"
"sed -i 's/32,/253,/' lib/Syntax.cxx                      &amp;&amp;\n"
"sed -i 's/LITLEN          240 /LITLEN          8092/'    \\\n"
"    unicode/{gensyntax.pl,unicode.syn}                   &amp;&amp;\n"
"\n"
"./configure --prefix=/usr                                \\\n"
"            --disable-static                             \\\n"
"            --disable-doc-build                          \\\n"
"            --enable-default-catalog=/etc/sgml/catalog   \\\n"
"            --enable-http                                \\\n"
"            --enable-default-search-path=/usr/share/sgml &amp;&amp;\n"
"\n"
"make pkgdatadir=/usr/share/sgml/OpenSP-&opensp-version;</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/pst/sgml/opensp.xml:119
#, xml-text
msgid ""
"To test the results, issue: <command>make check</command>. The "
"<filename>catalog-2</filename>, <filename>af-7</filename>, "
"<filename>af-8</filename>, <filename>af-9</filename>, "
"<filename>af-10</filename>, and <filename>af-11</filename> tests are known "
"to fail."
msgstr ""
"Para testar os resultados, emita: <command>make check</command>. Os testes "
"<filename>catalog-2</filename>, <filename>af-7</filename>, "
"<filename>af-8</filename>, <filename>af-9</filename>, "
"<filename>af-10</filename> e <filename>af-11</filename> são conhecidos por "
"falharem."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/pst/sgml/opensp.xml:127
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/pst/sgml/opensp.xml:130
#, no-wrap, xml-text
msgid ""
"<userinput>make pkgdatadir=/usr/share/sgml/OpenSP-&opensp-version; \\\n"
"     docdir=/usr/share/doc/OpenSP-&opensp-version;      \\\n"
"     install &amp;&amp;\n"
"\n"
"ln -v -sf onsgmls   /usr/bin/nsgmls   &amp;&amp;\n"
"ln -v -sf osgmlnorm /usr/bin/sgmlnorm &amp;&amp;\n"
"ln -v -sf ospam     /usr/bin/spam     &amp;&amp;\n"
"ln -v -sf ospcat    /usr/bin/spcat    &amp;&amp;\n"
"ln -v -sf ospent    /usr/bin/spent    &amp;&amp;\n"
"ln -v -sf osx       /usr/bin/sx       &amp;&amp;\n"
"ln -v -sf osx       /usr/bin/sgml2xml &amp;&amp;\n"
"ln -v -sf libosp.so /usr/lib/libsp.so</userinput>"
msgstr ""
"<userinput>make pkgdatadir=/usr/share/sgml/OpenSP-&opensp-version; \\\n"
"     docdir=/usr/share/doc/OpenSP-&opensp-version;      \\\n"
"     install &amp;&amp;\n"
"\n"
"ln -v -sf onsgmls   /usr/bin/nsgmls   &amp;&amp;\n"
"ln -v -sf osgmlnorm /usr/bin/sgmlnorm &amp;&amp;\n"
"ln -v -sf ospam     /usr/bin/spam     &amp;&amp;\n"
"ln -v -sf ospcat    /usr/bin/spcat    &amp;&amp;\n"
"ln -v -sf ospent    /usr/bin/spent    &amp;&amp;\n"
"ln -v -sf osx       /usr/bin/sx       &amp;&amp;\n"
"ln -v -sf osx       /usr/bin/sgml2xml &amp;&amp;\n"
"ln -v -sf libosp.so /usr/lib/libsp.so</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/pst/sgml/opensp.xml:146
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/pst/sgml/opensp.xml:149
#, xml-text
msgid ""
"<command>sed -i 's/32,/253,/...unicode.syn}</command>: These seds prevent "
"some annoying messages that may otherwise appear while running "
"<command>openjade</command>."
msgstr ""
"<command>sed -i 's/32,/253,/...unicode.syn}</command>: Esses seds evitam "
"algumas mensagens irritantes que possivelmente apareçam durante a execução "
"do <command>openjade</command>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/pst/sgml/opensp.xml:158
#, xml-text
msgid ""
"<parameter>--enable-http</parameter>: This switch adds support for HTTP."
msgstr ""
"<parameter>--enable-http</parameter>: Essa chave adiciona suporte para HTTP."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/pst/sgml/opensp.xml:163
#, xml-text
msgid ""
"<parameter>--disable-doc-build</parameter>: This switch prevents the "
"<command>configure</command> script checking if you have "
"<application>xmlto</application> installed. If you have "
"<application>xmlto</application>, you can remove this option."
msgstr ""
"<parameter>--disable-doc-build</parameter>: Essa chave evita que o conjunto "
"de comandos sequenciais <command>configure</command> verifique se você tem o"
" <application>xmlto</application> instalado. Se você tiver o "
"<application>xmlto</application>, poderá remover essa opção."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/pst/sgml/opensp.xml:170
#, xml-text
msgid ""
"<parameter>--enable-default-catalog=/etc/sgml/catalog</parameter>: This "
"switch sets the path to the centralized catalog."
msgstr ""
"<parameter>--enable-default-catalog=/etc/sgml/catalog</parameter>: Essa "
"chave configura o caminho para o catálogo centralizado."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/pst/sgml/opensp.xml:175
#, xml-text
msgid ""
"<parameter>--enable-default-search-path</parameter>: This switch sets the "
"default value of <envar>SGML_SEARCH_PATH</envar>."
msgstr ""
"<parameter>--enable-default-search-path</parameter>: Essa chave configura o "
"valor padrão de <envar>SGML_SEARCH_PATH</envar>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/pst/sgml/opensp.xml:180
#, xml-text
msgid ""
"<option>--enable-xml-messages</option>: This switch adds support for XML "
"Formatted Messages."
msgstr ""
"<option>--enable-xml-messages</option>: Essa chave adiciona suporte para "
"mensagens formatadas em XML."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/pst/sgml/opensp.xml:185
#, xml-text
msgid ""
"<command> make pkgdatadir=/usr/share/sgml/OpenSP-&opensp-version; "
"</command>: This sets the pkgdatadir variable in the "
"<filename>Makefile</filename> from <filename "
"class=\"directory\">/usr/share/OpenSP</filename> to <filename "
"class=\"directory\">/usr/share/sgml/OpenSP-&opensp-version;</filename>."
msgstr ""
"<command> make pkgdatadir=/usr/share/sgml/OpenSP-&opensp-version; "
"</command>: Isso configura a variável pkgdatadir no "
"<filename>Makefile</filename> de <filename "
"class=\"directory\">/usr/share/OpenSP</filename> para <filename "
"class=\"directory\">/usr/share/sgml/OpenSP-&opensp-version;</filename>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/pst/sgml/opensp.xml:194
#, xml-text
msgid ""
"<command>ln -v -sf ...</command>: These commands create the "
"<application>SP</application> equivalents of "
"<application>OpenSP</application> executables and libraries."
msgstr ""
"<command>ln -v -sf ...</command>: Esses comandos criam os equivalentes "
"<application>SP</application> dos executáveis e bibliotecas "
"<application>OpenSP</application>."

