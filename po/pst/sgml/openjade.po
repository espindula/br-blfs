#. type: Content of: <sect1><sect2><title>
#: blfs-en/pst/sgml/openjade.xml:90
#, xml-text
msgid "Installation of OpenJade"
msgstr "Instalação do OpenJade"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/pst/sgml/openjade.xml:93
#, xml-text
msgid "First fix problems when building with newer compilers:"
msgstr ""
"Primeiro corrija os problemas ao construir com compiladores mais recentes:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/pst/sgml/openjade.xml:96
#, no-wrap, xml-text
msgid ""
"<userinput>patch -Np1 -i ../openjade-&openjade-"
"version;-upstream-1.patch</userinput>"
msgstr ""
"<userinput>patch -Np1 -i ../openjade-&openjade-"
"version;-upstream-1.patch</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/pst/sgml/openjade.xml:99
#, xml-text
msgid "Now fix a compilation problem with perl-5.16 and later:"
msgstr "Agora corrija um problema de compilação com perl-5.16 e posterior:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/pst/sgml/openjade.xml:102
#, no-wrap, xml-text
msgid ""
"<userinput>sed -i -e '/getopts/{N;s#&amp;G#g#;s#do .getopts.pl.;##;}' \\\n"
"       -e '/use POSIX/ause Getopt::Std;' msggen.pl</userinput>"
msgstr ""
"<userinput>sed -i -e '/getopts/{N;s#&amp;G#g#;s#do .getopts.pl.;##;}' \\\n"
"       -e '/use POSIX/ause Getopt::Std;' msggen.pl</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/pst/sgml/openjade.xml:106
#, xml-text
msgid ""
"Install <application>OpenJade</application> by running the following "
"commands:"
msgstr ""
"Instale o <application>OpenJade</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/pst/sgml/openjade.xml:110
#, no-wrap, xml-text
msgid ""
"<userinput>export CXXFLAGS=\"${CXXFLAGS:--O2 -g} -fno-lifetime-dse\"            &amp;&amp;\n"
"./configure --prefix=/usr                                \\\n"
"            --mandir=/usr/share/man                      \\\n"
"            --enable-http                                \\\n"
"            --disable-static                             \\\n"
"            --enable-default-catalog=/etc/sgml/catalog   \\\n"
"            --enable-default-search-path=/usr/share/sgml \\\n"
"            --datadir=/usr/share/sgml/openjade-&openjade-version;   &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>export CXXFLAGS=\"${CXXFLAGS:--O2 -g} -fno-lifetime-dse\"            &amp;&amp;\n"
"./configure --prefix=/usr                                \\\n"
"            --mandir=/usr/share/man                      \\\n"
"            --enable-http                                \\\n"
"            --disable-static                             \\\n"
"            --enable-default-catalog=/etc/sgml/catalog   \\\n"
"            --enable-default-search-path=/usr/share/sgml \\\n"
"            --datadir=/usr/share/sgml/openjade-&openjade-version;   &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/pst/sgml/openjade.xml:121
#, xml-text
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/pst/sgml/openjade.xml:125
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr "Agora, como o(a) usante <systemitem class=\"username\">root</systemitem>:"

#.  Be careful of spacing here
#. type: Content of: <sect1><sect2><screen>
#: blfs-en/pst/sgml/openjade.xml:129
#, no-wrap, xml-text
msgid ""
"<userinput>make install                                                   &amp;&amp;\n"
"make install-man                                               &amp;&amp;\n"
"ln -v -sf openjade /usr/bin/jade                               &amp;&amp;\n"
"ln -v -sf libogrove.so /usr/lib/libgrove.so                    &amp;&amp;\n"
"ln -v -sf libospgrove.so /usr/lib/libspgrove.so                &amp;&amp;\n"
"ln -v -sf libostyle.so /usr/lib/libstyle.so                    &amp;&amp;\n"
"\n"
"install -v -m644 dsssl/catalog /usr/share/sgml/openjade-&openjade-version;/ &amp;&amp;\n"
"\n"
"install -v -m644 dsssl/*.{dtd,dsl,sgm}              \\\n"
"    /usr/share/sgml/openjade-&openjade-version;                             &amp;&amp;\n"
"\n"
"install-catalog --add /etc/sgml/openjade-&openjade-version;.cat  \\\n"
"    /usr/share/sgml/openjade-&openjade-version;/catalog                     &amp;&amp;\n"
"\n"
"install-catalog --add /etc/sgml/sgml-docbook.cat    \\\n"
"    /etc/sgml/openjade-&openjade-version;.cat</userinput>"
msgstr ""
"<userinput>make install                                                   &amp;&amp;\n"
"make install-man                                               &amp;&amp;\n"
"ln -v -sf openjade /usr/bin/jade                               &amp;&amp;\n"
"ln -v -sf libogrove.so /usr/lib/libgrove.so                    &amp;&amp;\n"
"ln -v -sf libospgrove.so /usr/lib/libspgrove.so                &amp;&amp;\n"
"ln -v -sf libostyle.so /usr/lib/libstyle.so                    &amp;&amp;\n"
"\n"
"install -v -m644 dsssl/catalog /usr/share/sgml/openjade-&openjade-version;/ &amp;&amp;\n"
"\n"
"install -v -m644 dsssl/*.{dtd,dsl,sgm}              \\\n"
"    /usr/share/sgml/openjade-&openjade-version;                             &amp;&amp;\n"
"\n"
"install-catalog --add /etc/sgml/openjade-&openjade-version;.cat  \\\n"
"    /usr/share/sgml/openjade-&openjade-version;/catalog                     &amp;&amp;\n"
"\n"
"install-catalog --add /etc/sgml/sgml-docbook.cat    \\\n"
"    /etc/sgml/openjade-&openjade-version;.cat</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/pst/sgml/openjade.xml:150
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/pst/sgml/openjade.xml:153
#, xml-text
msgid ""
"<command>export CXXFLAGS=...</command>: This command prevents segmentation "
"faults when the package is compiled with <application>gcc-6.1</application>."
msgstr ""
"<command>export CXXFLAGS=...</command>: Esse comando evita falhas de "
"segmentação quando o pacote é compilado com "
"<application>gcc-6.1</application>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/pst/sgml/openjade.xml:159
#, xml-text
msgid ""
"<command>make install-man</command>: This command installs the "
"<command>openjade</command> man page."
msgstr ""
"<command>make install-man</command>: Esse comando instala a página de manual"
" do <command>openjade</command>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/pst/sgml/openjade.xml:164
#, xml-text
msgid ""
"<parameter>--disable-static</parameter>: This switch prevents the building "
"of the static library."
msgstr ""
"<parameter>--disable-static</parameter>: Essa chave evita a construção da "
"biblioteca estática."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/pst/sgml/openjade.xml:169
#, xml-text
msgid ""
"<parameter>--enable-http</parameter>: This switch adds support for HTTP."
msgstr ""
"<parameter>--enable-http</parameter>: Essa chave adiciona suporte para HTTP."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/pst/sgml/openjade.xml:174
#, xml-text
msgid ""
"<parameter>--enable-default-catalog=/etc/sgml/catalog</parameter>: This "
"switch sets the path to the centralized catalog."
msgstr ""
"<parameter>--enable-default-catalog=/etc/sgml/catalog</parameter>: Essa "
"chave configura o caminho para o catálogo centralizado."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/pst/sgml/openjade.xml:179
#, xml-text
msgid ""
"<parameter>--enable-default-search-path</parameter>: This switch sets the "
"default value of <envar>SGML_SEARCH_PATH</envar>."
msgstr ""
"<parameter>--enable-default-search-path</parameter>: Essa chave configura o "
"valor padrão de <envar>SGML_SEARCH_PATH</envar>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/pst/sgml/openjade.xml:184
#, xml-text
msgid ""
"<parameter> --datadir=/usr/share/sgml/openjade-&openjade-"
"version;</parameter>: This switch puts data files in "
"<filename>/usr/share/sgml/openjade-&openjade-version;</filename> instead of "
"<filename class=\"directory\">/usr/share</filename>."
msgstr ""
"<parameter> --datadir=/usr/share/sgml/openjade-&openjade-"
"version;</parameter>: Essa chave coloca os arquivos de dados em "
"<filename>/usr/share/sgml/openjade-&openjade-version;</filename> em vez de "
"<filename class=\"directory\">/usr/share</filename>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/pst/sgml/openjade.xml:192
#, xml-text
msgid ""
"<command>ln -v -sf ...</command>: These commands create the "
"<application>Jade</application> equivalents of "
"<application>OpenJade</application> executables and libraries."
msgstr ""
"<command>ln -v -sf ...</command>: Esses comandos criam os equivalentes "
"<application>Jade</application> dos executáveis e bibliotecas "
"<application>OpenJade</application>."

#. type: Content of: <sect1><sect2><title>
