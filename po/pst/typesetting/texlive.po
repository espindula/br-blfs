#, xml-text
#~ msgid ""
#~ "TeXLive includes some files for ConTeXt but the source of that is separate "
#~ "and has moved on from using luatex in the previous 'mkiv' version to using "
#~ "luametatex which can be pulled with git from <ulink "
#~ "url=\"https://github.com/contextgarden/luametatex/tags\">github "
#~ "luametatex</ulink>.  LuaMetaTeX uses meson and ninja, but it does not fit "
#~ "easily into the BLFS layout of TeXLive."
#~ msgstr ""
#~ "TeXLive inclui alguns arquivos para ConTeXt, mas o fonte deles é separado e "
#~ "passou do uso de luatex na versão 'mkiv' anterior para o uso de luametatex, "
#~ "que pode ser extraído com git a partir de <ulink "
#~ "url=\"https://github.com/contextgarden/luametatex/tags\">luametatex do "
#~ "github</ulink>. LuaMetaTeX usa meson e ninja, mas não se encaixa facilmente "
#~ "no esquema do BLFS do TeXLive."

#, xml-text
#~ msgid ""
#~ "However, with a little extra work 'mkiv' files can still be processed using "
#~ "the files shipped in texmf."
#~ msgstr ""
#~ "Entretanto, com um pouco de trabalho extra, os arquivos 'mkiv' ainda podem "
#~ "ser processados usando os arquivos enviados no texmf."

#, xml-text
#~ msgid ""
#~ "<emphasis>Fixes to use ConTeXt will be removed when the texlive source next "
#~ "has to be updated for either a vulnerability fix which requires backporting "
#~ "luatex changes, or for TeXLive 2024. If you are a BLFS user of ConTeXt you "
#~ "should be prepared to use the latest tag from github (the link is in first "
#~ "paragraph of this Note). Building and installing that to work with a BLFS "
#~ "install of TeXLive will not be a trivial exercise.</emphasis>"
#~ msgstr ""
#~ "<emphasis>As correções para usar o ConTeXt serão removidas quando o fonte do"
#~ " texlive tiver que ser atualizado para uma correção de vulnerabilidade que "
#~ "exija backporting das mudanças do luatex ou para o TeXLive 2024. Se você for"
#~ " um(a) usuário(a) BLFS do ConTeXt, você deveria estar preparado(a) para usar"
#~ " a etiqueta mais recente a partir do GitHub (o link está no primeiro "
#~ "parágrafo desta Observação). Construir e instalar isso para funcionar com "
#~ "uma instalação BLFS do TeXLive não será um exercício trivial.</emphasis>"

#, xml-text
#~ msgid ""
#~ "The following steps, run as the <systemitem "
#~ "class=\"username\">root</systemitem> user, will create "
#~ "<command>mtxrun</command> and <command>context</command>."
#~ msgstr ""
#~ "As seguintes etapas, executadas como o(a) usuário(a) <systemitem "
#~ "class=\"username\">root</systemitem>, criarão <command>mtxrun</command> e "
#~ "<command>context</command>."

#, no-wrap, xml-text
#~ msgid ""
#~ "<userinput>sed -e '/local template=\\[\\[--ini/s/\\(primaryflags%\\)\\(.*\\)/\\1 --socket --shell-escape \\2/' \\\n"
#~ " -e '/local template=\\[\\[%primaryflags%/s/\\(primaryflags%\\)\\(.*\\)/\\1 --socket --shell-escape \\2/' \\\n"
#~ "  -i $TEXLIVE_PREFIX/texmf-dist/scripts/context/lua/mtxrun.lua &amp;&amp;\n"
#~ "\n"
#~ "mkdir -pv $TEXLIVE_PREFIX/texmf-var/luatex-cache/context/ &amp;&amp;\n"
#~ "\n"
#~ "ln -sfv /$TEXLIVE_PREFIX/texmf-dist/scripts/context/lua/mtxrun.lua \\\n"
#~ "        /$TEXLIVE_PREFIX/bin/$TEXARCH/mtxrun &amp;&amp;\n"
#~ "\n"
#~ "cat > $TEXLIVE_PREFIX/bin/$TEXARCH/context &lt;&lt; EOF\n"
#~ "#!/bin/sh\n"
#~ "export TEXMF=$TEXLIVE_PREFIX/texmf-dist;\n"
#~ "export TEXMFCNF=$TEXLIVE_PREFIX/texmf-dist/web2c;\n"
#~ "export TEXMFCACHE=$TEXLIVE_PREFIX/texmf-var/luatex-cache/context/;\n"
#~ "$TEXLIVE_PREFIX/bin/$TEXARCH/mtxrun --script context \"\\$@\"\n"
#~ "EOF\n"
#~ "chmod -v 0755 $TEXLIVE_PREFIX/bin/$TEXARCH/context</userinput>"
#~ msgstr ""
#~ "<userinput>sed -e '/local template=\\[\\[--ini/s/\\(primaryflags%\\)\\(.*\\)/\\1 --socket --shell-escape \\2/' \\\n"
#~ " -e '/local template=\\[\\[%primaryflags%/s/\\(primaryflags%\\)\\(.*\\)/\\1 --socket --shell-escape \\2/' \\\n"
#~ "  -i $TEXLIVE_PREFIX/texmf-dist/scripts/context/lua/mtxrun.lua &amp;&amp;\n"
#~ "\n"
#~ "mkdir -pv $TEXLIVE_PREFIX/texmf-var/luatex-cache/context/ &amp;&amp;\n"
#~ "\n"
#~ "ln -sfv /$TEXLIVE_PREFIX/texmf-dist/scripts/context/lua/mtxrun.lua \\\n"
#~ "        /$TEXLIVE_PREFIX/bin/$TEXARCH/mtxrun &amp;&amp;\n"
#~ "\n"
#~ "cat > $TEXLIVE_PREFIX/bin/$TEXARCH/context &lt;&lt; EOF\n"
#~ "#!/bin/sh\n"
#~ "export TEXMF=$TEXLIVE_PREFIX/texmf-dist;\n"
#~ "export TEXMFCNF=$TEXLIVE_PREFIX/texmf-dist/web2c;\n"
#~ "export TEXMFCACHE=$TEXLIVE_PREFIX/texmf-var/luatex-cache/context/;\n"
#~ "$TEXLIVE_PREFIX/bin/$TEXARCH/mtxrun --script context \"\\$@\"\n"
#~ "EOF\n"
#~ "chmod -v 0755 $TEXLIVE_PREFIX/bin/$TEXARCH/context</userinput>"

