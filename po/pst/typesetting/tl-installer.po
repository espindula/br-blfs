#, xml-text
#~ msgid "20230313"
#~ msgstr "20230313"

#, xml-text
#~ msgid ""
#~ "The binary version of asy is linked to libGLX.so.0 from <ulink "
#~ "url=\"https://gitlab.freedesktop.org/glvnd/libglvnd/\">libglvnd</ulink>, but"
#~ " installing that will break future updates of BLFS packages such as <xref "
#~ "linkend=\"mesa\"/>. Work around that by creating a symlink as the "
#~ "<systemitem class=\"username\">root</systemitem> user:"
#~ msgstr ""
#~ "A versão binária do asy está vinculada à libGLX.so.0 originária de <ulink "
#~ "url=\"https://gitlab.freedesktop.org/glvnd/libglvnd/\">libglvnd</ulink>, mas"
#~ " instalar isso quebrará atualizações futuras dos pacotes do BLFS, como <xref"
#~ " linkend=\"mesa\"/>. Contorne isso criando um link simbólico como o(a) "
#~ "usuário(a) <systemitem class=\"username\">root</systemitem>:"

#, no-wrap, xml-text
#~ msgid "<userinput>ln -sv libGL.so.1 /usr/lib/libGLX.so.0</userinput>"
#~ msgstr "<userinput>ln -sv libGL.so.1 /usr/lib/libGLX.so.0</userinput>"

#, no-wrap, xml-text
#~ msgid ""
#~ "<userinput>cat > /etc/profile.d/texlive.sh &lt;&lt; EOF\n"
#~ "# Begin texlive setup\n"
#~ "TEXLIVE_PREFIX=/opt/texlive/2024\n"
#~ "export TEXLIVE_PREFIX\n"
#~ "\n"
#~ "pathappend $TEXLIVE_PREFIX/bin/x86_64-linux\n"
#~ "# End texlive setup\n"
#~ "EOF</userinput>"
#~ msgstr ""
#~ "<userinput>cat > /etc/profile.d/texlive.sh &lt;&lt; EOF\n"
#~ "# Begin texlive setup\n"
#~ "TEXLIVE_PREFIX=/opt/texlive/2024\n"
#~ "export TEXLIVE_PREFIX\n"
#~ "\n"
#~ "pathappend $TEXLIVE_PREFIX/bin/x86_64-linux\n"
#~ "# End texlive setup\n"
#~ "EOF</userinput>"

#, xml-text
#~ msgid ""
#~ "Immediately after installation, update the current PATH for your current "
#~ "shell as a normal user:"
#~ msgstr ""
#~ "Imediatamente depois da instalação, atualize o PATH atual para teu shell "
#~ "atual como um(a) usuário(a) normal:"

#, no-wrap, xml-text
#~ msgid "<userinput>source /etc/profile.d/texlive.sh</userinput>"
#~ msgstr "<userinput>source /etc/profile.d/texlive.sh</userinput>"

#, xml-text
#~ msgid ""
#~ "It has been established by Debian that the <command>python</command> scripts"
#~ " in <filename class=\"directory\">latex-make</filename> will work with "
#~ "<command>python3</command>, so update them to invoke that by running the "
#~ "following command as the <systemitem class=\"username\">root</systemitem> "
#~ "user:"
#~ msgstr ""
#~ "Foi estabelecido pelo Debian que os conjuntos de comandos sequenciais do "
#~ "<command>python</command> em <filename class=\"directory\">latex-"
#~ "make</filename> funcionarão com <command>python3</command>, de forma que "
#~ "atualize-os para invocar isso executando o seguinte comando como o(a) "
#~ "usuário(a) <systemitem class=\"username\">root</systemitem>:"

#, no-wrap, xml-text
#~ msgid ""
#~ "<userinput>for F in /opt/texlive/&texlive-year;/texmf-dist/scripts/latex-make/*.py ; do\n"
#~ "  test -f $F &amp;&amp; sed -i 's%/usr/bin/env python%/usr/bin/python3%' $F || true\n"
#~ "done\n"
#~ "</userinput>"
#~ msgstr ""
#~ "<userinput>for F in /opt/texlive/&texlive-year;/texmf-dist/scripts/latex-make/*.py ; do\n"
#~ "  test -f $F &amp;&amp; sed -i 's%/usr/bin/env python%/usr/bin/python3%' $F || true\n"
#~ "done\n"
#~ "</userinput>"

#, xml-text
#~ msgid ""
#~ "<command>test -f $F &amp;&amp; sed ...</command>: in a small install these "
#~ "files might not be present, so test if they exist and if not return 'true' "
#~ "to avoid any error if this command has been copied into one of your own "
#~ "install scripts."
#~ msgstr ""
#~ "<command>test -f $F &amp;&amp; sed ...</command>: em uma instalação pequena "
#~ "esses arquivos podem não estar presentes, de forma que teste se eles existem"
#~ " e se não retornam 'true' para evitar qualquer erro se esse comando tiver "
#~ "sido copiado em um de teus próprios conjuntos de comandos sequenciais de "
#~ "instalação."

#, xml-text
#~ msgid ""
#~ "If you have installed any of the luatex programs (luatex, luahbtex, "
#~ "luajitex, luajithbtex) or ConTeXt with the luametatex backend there was a "
#~ "security issue fixed by the introduction of luatex v1.17.0.  You should "
#~ "check the version with 'luatex --version' and if it is less than 1.17.0 you "
#~ "can use tlmgr to update."
#~ msgstr ""
#~ "Se você tiver instalado algum dos aplicativos do luatex (luatex, luahbtex, "
#~ "luajitex, luajithbtex) ou do ConTeXt com o backend luametatex, existiu um "
#~ "problema de segurança corrigido pela introdução do luatex v1.17.0. Você "
#~ "deveria verificar a versão com 'luatex --version' e se ela for inferior a "
#~ "1.17.0, você pode usar o tlmgr para atualizar."

