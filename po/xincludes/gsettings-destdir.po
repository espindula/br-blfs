msgstr "<note>"

#. type: Content of: <note><para>
#: blfs-en/xincludes/gsettings-destdir.xml:7
#, xml-text
msgid ""
"If you installed the package to your system using a <quote>DESTDIR</quote> "
"method, <filename>/usr/share/glib-2.0/schemas/gschemas.compiled</filename> "
"was not updated/created. Create (or update) the file using the following "
"command as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Se você instalou o pacote em teu sistema usando um método "
"<quote>DESTDIR</quote>, "
"<filename>/usr/share/glib-2.0/schemas/gschemas.compiled</filename> não foi "
"atualizado/criado. Crie (ou atualize) o arquivo usando o seguinte comando "
"como o(a) usuário(a) <systemitem class=\"username\">root</systemitem>:"

#. type: Content of: <note><screen>
#: blfs-en/xincludes/gsettings-destdir.xml:14
#, no-wrap, xml-text
msgid ""
"<userinput>glib-compile-schemas /usr/share/glib-2.0/schemas</userinput>"
msgstr ""
"<userinput>glib-compile-schemas /usr/share/glib-2.0/schemas</userinput>"

