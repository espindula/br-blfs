#. type: Content of: <note>
#: blfs-en/xincludes/gtk-update-icon-cache.xml:5
#, xml-text
msgid "<note>"
msgstr "<note>"

#. type: Content of: <note><para>
#: blfs-en/xincludes/gtk-update-icon-cache.xml:7
#, xml-text
msgid ""
"This package installs icon files into the <filename "
"class=\"directory\">/usr/share/icons/hicolor</filename> hierarchy and you "
"can improve system performance and memory usage by updating "
"<filename>/usr/share/icons/hicolor/index.theme</filename>. To perform the "
"update you must have <xref linkend=\"gtk3\"/> installed and issue the "
"following command as the <systemitem class=\"username\">root</systemitem> "
"user:"
msgstr ""
"Esse pacote instala arquivos de ícone na hierarquia <filename "
"class=\"directory\">/usr/share/icons/hicolor</filename> e você pode melhorar"
" o desempenho do sistema e o uso de memória atualizando "
"<filename>/usr/share/icons/hicolor/index.theme</filename>. Para realizar a "
"atualização, você precisa ter o <xref linkend=\"gtk3\"/> instalado e emitir "
"o seguinte comando como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <note><screen>
#: blfs-en/xincludes/gtk-update-icon-cache.xml:16
#, no-wrap, xml-text
msgid ""
"<userinput>gtk-update-icon-cache -qtf /usr/share/icons/hicolor</userinput>"
msgstr ""
"<userinput>gtk-update-icon-cache -qtf /usr/share/icons/hicolor</userinput>"

