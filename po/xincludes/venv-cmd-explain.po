#, xml-text
msgid ""
"<parameter>--system-site-packages</parameter>: Allow the "
"<application>Python3</application> venv module to access the system-"
"installed <filename "
"class=\"directory\">/usr/lib/python&python3-majorver;/site-"
"packages</filename> directory."
msgstr ""
"<parameter>--system-site-packages</parameter>: Permita que o módulo venv do "
"<application>Python3</application> acesse o diretório <filename "
"class=\"directory\">/usr/lib/python&python3-majorver;/site-"
"packages</filename> do sistema instalado."
