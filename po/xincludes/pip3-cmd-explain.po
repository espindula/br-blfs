#. type: Content of: <sect3><title>
#: blfs-en/xincludes/pip3-cmd-explain.xml:9
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect3><para>
#: blfs-en/xincludes/pip3-cmd-explain.xml:12
#, xml-text
msgid ""
"<parameter>-w dist</parameter>: builds the appropriate \"wheel\" for this "
"module in the directory <filename class=\"directory\">dist</filename>."
msgstr ""
"<parameter>-w dist</parameter>: constrói o \"wheel\" apropriado para esse "
"módulo no diretório <filename class=\"directory\">dist</filename>."

#. type: Content of: <sect3><para>
#: blfs-en/xincludes/pip3-cmd-explain.xml:18
#, xml-text
msgid ""
"<parameter>--no-build-isolation</parameter>: tells pip3 to run the build in "
"the system environment instead of creating a temporary build environment."
msgstr ""
"<parameter>--no-build-isolation</parameter>: informa ao pip3 para executar a"
" construção no ambiente do sistema em vez de criar um ambiente temporário de"
" construção."

#. type: Content of: <sect3><para>
#: blfs-en/xincludes/pip3-cmd-explain.xml:24
#, xml-text
msgid ""
"<parameter>--no-deps</parameter>: prevents pip3 from building wheels for the"
" project's dependencies."
msgstr ""
"<parameter>--no-deps</parameter>: impede o pip3 de construir wheels para as "
"dependências do projeto."

#. type: Content of: <sect3><para>
#: blfs-en/xincludes/pip3-cmd-explain.xml:29
#, xml-text
msgid ""
"<parameter>--no-index</parameter>: ignores the package index (only looking "
"at --find-links URLs instead)."
msgstr ""
"<parameter>--no-index</parameter>: ignora o índice do pacote (olhando apenas"
" para URLs do --find-links)."

#. type: Content of: <sect3><para>
#: blfs-en/xincludes/pip3-cmd-explain.xml:34
#, xml-text
msgid ""
"<parameter>--find-links dist</parameter>: looks for links to archives such "
"as wheel (.whl) files in the directory <filename "
"class=\"directory\">dist</filename>."
msgstr ""
"<parameter>--find-links dist</parameter>: procura linques para "
"arquivamentos, como arquivos wheel (.whl), no diretório <filename "
"class=\"directory\">dist</filename>."

#. type: Content of: <sect3><para>
#: blfs-en/xincludes/pip3-cmd-explain.xml:40
#, xml-text
msgid ""
"<parameter>--no-cache-dir</parameter>: Disables the cache to prevent a "
"warning when installing as the &root; user."
msgstr ""
"<parameter>--no-cache-dir</parameter>: Desabilita o cache para evitar um "
"aviso ao instalar como o(a) usuário(a) &root;."

#. type: Content of: <sect3><para>
#: blfs-en/xincludes/pip3-cmd-explain.xml:45
#, xml-text
msgid ""
"<parameter>--no-user</parameter>: Prevent mistakenly running the install "
"command as a non-root user."
msgstr ""
"<parameter>--no-user</parameter>: Evite executar erroneamente o comando de "
"instalação como um(a) usuário(a) não root."

#. type: Content of: <sect3><para>
#: blfs-en/xincludes/pip3-cmd-explain.xml:50
#, xml-text
msgid ""
"<option>--upgrade</option>: Upgrade the package to the newest available "
"version.  This option is used with the install command if a version of the "
"package is already installed."
msgstr ""
"<option>--upgrade</option>: Atualize o pacote para a versão mais recente "
"disponível. Essa opção é usada com o comando de instalação se uma versão do "
"pacote já estiver instalada."

#. type: Content of: <sect3><para>
#: blfs-en/xincludes/pip3-cmd-explain.xml:56
#, xml-text
msgid ""
"<option>--force-reinstall</option>: Reinstall the package even if it is up-"
"to-date. This option is used with the install command if reinstalling the "
"package or reverting to an earlier version of the package."
msgstr ""
"<option>--force-reinstall</option>: Reinstale o pacote mesmo se ele estiver "
"atualizado. Essa opção é usada com o comando de instalação se reinstalar-se "
"o pacote ou reverter-se para uma versão anterior do pacote."

#. type: Content of: <sect3><para>
#: blfs-en/xincludes/pip3-cmd-explain.xml:63
#, xml-text
msgid ""
"<option>--no-deps</option>: Do not install package dependencies.  This "
"option may be needed with the --upgrade or --force-reinstall options."
msgstr ""
"<option>--no-deps</option>: Não instale dependências do pacote. Essa opção "
"possivelmente seja necessária com as opções --upgrade ou --force-reinstall."
