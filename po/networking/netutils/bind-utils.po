#. type: Content of: <sect1><sect2><title>
#: blfs-en/networking/netutils/bind-utils.xml:94
#, xml-text
msgid "Installation of BIND Utilities"
msgstr "Instalação dos Utilitários BIND"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/netutils/bind-utils.xml:97
#, xml-text
msgid ""
"Install <application>BIND Utilities</application> by running the following "
"commands:"
msgstr ""
"Instale os &quot;<application>Utilitários BIND</application>&quot; "
"executando os seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/networking/netutils/bind-utils.xml:100
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr --sysconfdir=/etc &amp;&amp;\n"
"make -C lib/isc      &amp;&amp;\n"
"make -C lib/dns      &amp;&amp;\n"
"make -C lib/ns       &amp;&amp;\n"
"make -C lib/isccfg   &amp;&amp;\n"
"make -C lib/isccc    &amp;&amp;\n"
"make -C bin/dig      &amp;&amp;\n"
"make -C bin/nsupdate &amp;&amp;\n"
"make -C bin/rndc     &amp;&amp;\n"
"make -C doc</userinput>"
msgstr ""
"<userinput>./configure --prefix=/usr --sysconfdir=/etc &amp;&amp;\n"
"make -C lib/isc      &amp;&amp;\n"
"make -C lib/dns      &amp;&amp;\n"
"make -C lib/ns       &amp;&amp;\n"
"make -C lib/isccfg   &amp;&amp;\n"
"make -C lib/isccc    &amp;&amp;\n"
"make -C bin/dig      &amp;&amp;\n"
"make -C bin/nsupdate &amp;&amp;\n"
"make -C bin/rndc     &amp;&amp;\n"
"make -C doc</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/netutils/bind-utils.xml:112
#, xml-text
msgid "This portion of the package does not come with a test suite."
msgstr "Essa parte do pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/netutils/bind-utils.xml:115
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr "Agora, como o(a) usante <systemitem class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/networking/netutils/bind-utils.xml:117
#, no-wrap, xml-text
msgid ""
"<userinput>make -C lib/isc      install &amp;&amp;\n"
"make -C lib/dns      install &amp;&amp;\n"
"make -C lib/ns       install &amp;&amp;\n"
"make -C lib/isccfg   install &amp;&amp;\n"
"make -C lib/isccc    install &amp;&amp;\n"
"make -C bin/dig      install &amp;&amp;\n"
"make -C bin/nsupdate install &amp;&amp;\n"
"make -C bin/rndc     install &amp;&amp;\n"
"cp -v doc/man/{dig.1,host.1,nslookup.1,nsupdate.1} /usr/share/man/man1 &amp;&amp;\n"
"cp -v doc/man/rndc.8 /usr/share/man/man8</userinput>"
msgstr ""
"<userinput>make -C lib/isc      install &amp;&amp;\n"
"make -C lib/dns      install &amp;&amp;\n"
"make -C lib/ns       install &amp;&amp;\n"
"make -C lib/isccfg   install &amp;&amp;\n"
"make -C lib/isccc    install &amp;&amp;\n"
"make -C bin/dig      install &amp;&amp;\n"
"make -C bin/nsupdate install &amp;&amp;\n"
"make -C bin/rndc     install &amp;&amp;\n"
"cp -v doc/man/{dig.1,host.1,nslookup.1,nsupdate.1} /usr/share/man/man1 &amp;&amp;\n"
"cp -v doc/man/rndc.8 /usr/share/man/man8</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/networking/netutils/bind-utils.xml:131
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/netutils/bind-utils.xml:134
#, xml-text
msgid ""
"<option>--sysconfdir=/etc</option>: Use this option to ensure installed "
"packages look in <filename class='directory'>/etc</filename> for "
"configuration files."
msgstr ""
"<option>--sysconfdir=/etc</option>: Use essa opção para garantir que os "
"pacotes instalados procurem em <filename class='directory'>/etc</filename> "
"por arquivos de configuração."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/netutils/bind-utils.xml:139
#, xml-text
msgid ""
"<option>--disable-doh</option>: Use this option if you have not installed "
"<xref linkend=\"nghttp2\" role=\"nodep\"/> and you don't need DNS over HTTPS"
" support."
msgstr ""
"<option>--disable-doh</option>: Use essa opção se você não tiver instalado o"
" &quot;<xref linkend=\"nghttp2\" role=\"nodep\"/>&quot; e não precisar de "
"suporte &quot;DNS&quot; sobre &quot;HTTPS&quot;."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/netutils/bind-utils.xml:145
#, xml-text
msgid ""
"<command>make -C lib/...</command>: These commands build the libraries that "
"are needed for the client programs."
msgstr ""
"<command>make -C lib/...</command>: Esses comandos constroem as bibliotecas "
"que são necessárias para os aplicativos clientes."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/netutils/bind-utils.xml:150
#, xml-text
msgid ""
"<command>make -C bin/...</command>: This command builds the client programs."
msgstr ""
"<command>make -C bin/...</command>: Esse comando constrói os programas "
"clientes."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/netutils/bind-utils.xml:155
#, xml-text
msgid ""
"<command>make -C doc</command>: This command builds the manual pages if the "
"optional Python module <xref linkend=\"sphinx\"/> is installed."
msgstr ""
"<command>make -C doc</command>: Esse comando constrói as páginas de manual "
"se o módulo opcional &quot;<xref linkend=\"sphinx\"/>&quot; do "
"&quot;Python&quot; estiver instalado."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/netutils/bind-utils.xml:161
#, xml-text
msgid ""
"Use <command>cp -v doc/man/... /usr/share/man/man...</command> to install "
"the manual pages if they have been built."
msgstr ""
"Use <command>cp -v doc/man/... /usr/share/man/man...</command> para instalar"
" as páginas de manual se elas tiverem sido construídas."

