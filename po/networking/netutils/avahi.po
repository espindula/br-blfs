#. type: Content of: <sect1><sect2><title>
#: blfs-en/networking/netutils/avahi.xml:105
#, xml-text
msgid "Installation of Avahi"
msgstr "Instalação do Avahi"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/netutils/avahi.xml:108
#, xml-text
msgid ""
"There should be a dedicated user and group to take control of the "
"<command>avahi-daemon</command> daemon after it is started. Issue the "
"following commands as the <systemitem class=\"username\">root</systemitem> "
"user:"
msgstr ""
"Deveria existir um(a) usuário(a) e um grupo dedicado(a) para assumir o "
"controle do processo de segundo plano &quot;<command>avahi-"
"daemon</command>&quot; depois que ele for iniciado. Emita os seguintes "
"comandos como o(a) usuário(a) &quot;<systemitem "
"class=\"username\">root</systemitem>&quot;:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/networking/netutils/avahi.xml:114
#, no-wrap, xml-text
msgid ""
"<userinput>groupadd -fg 84 avahi &amp;&amp;\n"
"useradd -c \"Avahi Daemon Owner\" -d /run/avahi-daemon -u 84 \\\n"
"        -g avahi -s /bin/false avahi</userinput>"
msgstr ""
"<userinput>groupadd -fg 84 avahi &amp;&amp;\n"
"useradd -c \"Proprietário(a) do Processo de Segundo Plano Avahi\" -d /run/avahi-daemon -u 84 \\\n"
"        -g avahi -s /bin/false avahi</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/netutils/avahi.xml:119
#, xml-text
msgid ""
"There should also be a dedicated privileged access group for "
"<application>Avahi</application> clients. Issue the following command as the"
" <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Também deveria existir um grupo de acesso privilegiado dedicado para "
"clientes do &quot;<application>Avahi</application>&quot;. Emita o seguinte "
"comando como o(a) usuário(a) &quot;<systemitem "
"class=\"username\">root</systemitem>&quot;:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/networking/netutils/avahi.xml:124
#, no-wrap, xml-text
msgid "<userinput>groupadd -fg 86 netdev</userinput>"
msgstr "<userinput>groupadd -fg 86 netdev</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/netutils/avahi.xml:127
#, xml-text
msgid ""
"Fix a regression that results in a race condition when IPv6 is in use and "
"multiple network adapters are present on the system:"
msgstr ""
"Corrija uma regressão que resulta em uma condição de corrida quando o "
"&quot;IPv6&quot; está em uso e vários adaptadores de rede de "
"intercomunicação estiverem presentes no sistema:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/networking/netutils/avahi.xml:131
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"pre\">patch -Np1 -i ../avahi-&avahi-"
"version;-ipv6_race_condition_fix-1.patch</userinput>"
msgstr ""
"<userinput remap=\"pre\">patch -Np1 -i ../avahi-&avahi-"
"version;-ipv6_race_condition_fix-1.patch</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/netutils/avahi.xml:134
#, xml-text
msgid "Fix a security vulnerability in <command>avahi-daemon</command>:"
msgstr ""
"Corrija uma vulnerabilidade de segurança no &quot;<command>avahi-"
"daemon</command>&quot;:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/networking/netutils/avahi.xml:137
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"pre\">sed -i '426a if (events &amp; AVAHI_WATCH_HUP) { \\\n"
"client_free(c); \\\n"
"return; \\\n"
"}' avahi-daemon/simple-protocol.c</userinput>"
msgstr ""
"<userinput remap=\"pre\">sed -i '426a if (events &amp; AVAHI_WATCH_HUP) { \\\n"
"client_free(c); \\\n"
"return; \\\n"
"}' avahi-daemon/simple-protocol.c</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/netutils/avahi.xml:143
#, xml-text
msgid ""
"Install <application>Avahi</application> by running the following commands:"
msgstr ""
"Instale o &quot;<application>Avahi</application>&quot; executando os "
"seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/networking/netutils/avahi.xml:147
#, no-wrap, xml-text
msgid ""
"<userinput>./configure \\\n"
"    --prefix=/usr                  \\\n"
"    --sysconfdir=/etc              \\\n"
"    --localstatedir=/var           \\\n"
"    --disable-static               \\\n"
"    --disable-libevent             \\\n"
"    --disable-mono                 \\\n"
"    --disable-monodoc              \\\n"
"    --disable-python               \\\n"
"    --disable-qt3                  \\\n"
"    --disable-qt4                  \\\n"
"    --disable-qt5                  \\\n"
"    --enable-core-docs             \\\n"
"    --with-distro=none             \\\n"
"    --with-systemdsystemunitdir=no \\\n"
"    --with-dbus-system-address='unix:path=/run/dbus/system_bus_socket' &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>./configure \\\n"
"    --prefix=/usr                  \\\n"
"    --sysconfdir=/etc              \\\n"
"    --localstatedir=/var           \\\n"
"    --disable-static               \\\n"
"    --disable-libevent             \\\n"
"    --disable-mono                 \\\n"
"    --disable-monodoc              \\\n"
"    --disable-python               \\\n"
"    --disable-qt3                  \\\n"
"    --disable-qt4                  \\\n"
"    --disable-qt5                  \\\n"
"    --enable-core-docs             \\\n"
"    --with-distro=none             \\\n"
"    --with-systemdsystemunitdir=no \\\n"
"    --with-dbus-system-address='unix:path=/run/dbus/system_bus_socket' &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/networking/netutils/avahi.xml:165
#, no-wrap, xml-text
msgid ""
"<userinput>./configure \\\n"
"    --prefix=/usr        \\\n"
"    --sysconfdir=/etc    \\\n"
"    --localstatedir=/var \\\n"
"    --disable-static     \\\n"
"    --disable-libevent   \\\n"
"    --disable-mono       \\\n"
"    --disable-monodoc    \\\n"
"    --disable-python     \\\n"
"    --disable-qt3        \\\n"
"    --disable-qt4        \\\n"
"    --disable-qt5        \\\n"
"    --enable-core-docs   \\\n"
"    --with-distro=none   \\\n"
"    --with-dbus-system-address='unix:path=/run/dbus/system_bus_socket' &amp;&amp;\n"
