#. type: Content of: <sect1><sect2><title>
#: blfs-en/networking/netutils/avahi.xml:195
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/netutils/avahi.xml:201
#, xml-text
msgid ""
"<parameter>--disable-libevent</parameter>: This parameter disables the use "
"of <xref linkend=\"libevent\"/>. Remove if you have it installed."
msgstr ""
"<parameter>--disable-libevent</parameter>: Esse parâmetro desabilita o uso "
"da &quot;<xref linkend=\"libevent\"/>&quot;. Remova se você a tiver "
"instalado."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/netutils/avahi.xml:206
#, xml-text
msgid ""
"<parameter>--disable-mono</parameter>: This parameter disables the "
"<application>Mono</application> bindings."
msgstr ""
"<parameter>--disable-mono</parameter>: Esse parâmetro desabilita as ligações"
" &quot;<application>Mono</application>&quot;."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/netutils/avahi.xml:211
#, xml-text
msgid ""
"<parameter>--disable-monodoc</parameter>: This parameter disables "
"documentation for the <application>Mono</application> bindings."
msgstr ""
"<parameter>--disable-monodoc</parameter>: Esse parâmetro desabilita a "
"documentação para as ligações &quot;<application>Mono</application>&quot;."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/netutils/avahi.xml:216
#, xml-text
msgid ""
"<parameter>--disable-python</parameter>: This parameter disables the scripts"
" that depend on <application>Python</application>. It also allows a regular "
"install to complete successfully."
msgstr ""
"<parameter>--disable-python</parameter>: Esse parâmetro desabilita os "
"conjuntos de comandos sequenciais que dependem do "
"<application>Python</application>. Ele também permite que uma instalação "
"regular complete exitosamente."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/netutils/avahi.xml:222
#, xml-text
msgid ""
"<parameter>--disable-qt3</parameter>: This parameter disables the attempt to"
" build the obsolete <application>Qt3</application> portions of the package."
msgstr ""
"<parameter>--disable-qt3</parameter>: Esse parâmetro desabilita a tentativa "
"de construir as partes obsoletas do "
"&quot;<application>Qt3</application>&quot; do pacote."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/netutils/avahi.xml:228
#, xml-text
msgid ""
"<parameter>--disable-qt4</parameter>: This parameter disables the attempt to"
" build the obsolete <application>Qt4Core</application> portions of the "
"package."
msgstr ""
"<parameter>--disable-qt4</parameter>: Esse parâmetro desabilita a tentativa "
"de construir as partes obsoletas "
"&quot;<application>Qt4Core</application>&quot; do pacote."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/netutils/avahi.xml:234
#, xml-text
msgid ""
"<parameter>--disable-qt5</parameter>: This parameter disables the use of "
"<application>Qt5</application>, and allows building without it."
msgstr ""
"<parameter>--disable-qt5</parameter>: Esse parâmetro desabilita o uso do "
"<application>Qt5</application> e permite construir sem ele."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/netutils/avahi.xml:240
#, xml-text
msgid ""
"<parameter>--enable-core-docs</parameter>: This parameter enables the "
"building of documentation."
msgstr ""
"<parameter>--enable-core-docs</parameter>: Esse parâmetro habilita a "
"construção da documentação."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/netutils/avahi.xml:245
#, xml-text
msgid ""
"<parameter>--with-distro=none</parameter>: There is an obsolete boot script "
"in the distribution for LFS. This option disables it."
msgstr ""
"<parameter>--with-distro=none</parameter>: Existe um conjunto de comandos "
"sequenciais obsoletos de inicialização na distribuição para o LFS. Essa "
"opção o desabilita."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/netutils/avahi.xml:250
#, xml-text
msgid ""
"<parameter>--with-systemdsystemunitdir=no</parameter>: Without it, the "
"daemon fails to start in BLFS, which does not support "
"<application>systemd</application>."
msgstr ""
"<parameter>--with-systemdsystemunitdir=no</parameter>: Sem ele, o processo "
"de segundo plano falha ao iniciar no BLFS, que não suporta "
"&quot;<application>systemd</application>&quot;."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/netutils/avahi.xml:256
#, xml-text
msgid ""
"<parameter>--with-dbus-system-address=</parameter>: This option prevents the"
" package from referring to the deprecated <filename "
"class='directory'>/var/run</filename> directory."
msgstr ""
"<parameter>--with-dbus-system-address=</parameter>: Essa opção evita que o "
"pacote referencie o diretório obsoleto <filename "
"class='directory'>/var/run</filename>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/netutils/avahi.xml:262
#, xml-text
msgid ""
"<option>--disable-dbus</option>: This parameter disables the use of "
"<application>D-Bus</application>."
msgstr ""
"<option>--disable-dbus</option>: Esse parâmetro desabilita o uso do "
"&quot;<application>D-Bus</application>&quot;."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/netutils/avahi.xml:267
#, xml-text
msgid ""
"<option>--disable-gtk</option>: This parameter disables the use of "
"<application>GTK+2</application>."
msgstr ""
"<option>--disable-gtk</option>: Esse parâmetro desabilita o uso do "
"&quot;<application>GTK+2</application>&quot;."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/netutils/avahi.xml:272
#, xml-text
msgid ""
"<option>--disable-gtk3</option>: This parameter disables the use of "
"<application>GTK+3</application>."
msgstr ""
"<option>--disable-gtk3</option>: Esse parâmetro desabilita o uso do "
"&quot;<application>GTK+3</application>&quot;."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/netutils/avahi.xml:277
#, xml-text
msgid ""
"<option>--disable-libdaemon</option>: This parameter disables the use of "
"<application>libdaemon</application>. If you use this option, "
"<command>avahi-daemon</command> won't be built."
msgstr ""
"<option>--disable-libdaemon</option>: Esse parâmetro desabilita o uso do "
"&quot;<application>libdaemon</application>&quot;. Se você usar essa opção, "
"[então] o &quot;<command>avahi-daemon</command>&quot; não será construído."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/netutils/avahi.xml:283
#, xml-text
msgid ""
"<option>--enable-tests</option>: This option enables the building of tests "
"and examples."
msgstr ""
"<option>--enable-tests</option>: Essa opção habilita a construção de testes "
"e exemplos."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/netutils/avahi.xml:288
#, xml-text
msgid ""
"<option>--enable-compat-howl</option>: This option enables the compatibility"
" layer for <application>HOWL</application>."
msgstr ""
"<option>--enable-compat-howl</option>: Essa opção habilita a camada de "
"compatibilidade para o &quot;<application>HOWL</application>&quot;."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/netutils/avahi.xml:293
#, xml-text
msgid ""
"<option>--enable-compat-libdns_sd</option>: This option enables the "
"compatibility layer for <application>libdns_sd</application>."
msgstr ""
"<option>--enable-compat-libdns_sd</option>: Essa opção habilita a camada de "
"compatibilidade para o &quot;<application>libdns_sd</application>&quot;."

#. type: Content of: <sect1><sect2><title>
#: blfs-en/networking/netutils/avahi.xml:300
#, xml-text
msgid "Configuring avahi"
msgstr "Configurando o avahi"

#. type: Content of: <sect1><sect2><sect3><title>
#: blfs-en/networking/netutils/avahi.xml:303
#, xml-text
msgid "Boot Script"
msgstr "Conjunto de Comandos Sequenciais de Inicialização"

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/networking/netutils/avahi.xml:306
#, xml-text
msgid ""
"To automatically start the <command>avahi-daemon</command> when the system "
"is rebooted, install the <filename>/etc/rc.d/init.d/avahi</filename> "
"bootscript from the <xref linkend=\"bootscripts\"/> package."
msgstr ""
"Para iniciar automaticamente o &quot;<command>avahi-daemon</command>&quot; "
"quando o sistema for reinicializado, instale o conjunto de comandos "
"sequenciais de inicialização "
"&quot;<filename>/etc/rc.d/init.d/avahi</filename>&quot; a partir do pacote "
"&quot;<xref linkend=\"bootscripts\"/>&quot;."

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/networking/netutils/avahi.xml:313
#, xml-text
msgid ""
"The <command>avahi-daemon</command> will conflict with <command>systemd-"
"resolved</command> under the default configuration if both are running "
"simultaneously on a system because both will act as a Multicast DNS resolver"
" and responder.  If you must run the Avahi daemon (the BLFS editors don't "
"recommend to do that unless you really need its functionality), disable the "
"Multicast DNS support of <command>systemd-resolved</command> and enable the "
"previously installed systemd unit by running the following command as the "
"<systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"O <command>avahi-daemon</command> conflitará com <command>systemd-"
"resolved</command> sob a configuração padrão se ambos estiverem executando "
"simultaneamente em um sistema, pois ambos atuarão como um resolvedor e "
"respondedor de DNS Multicast. Se você precisar executar o processo de "
"segundo plano Avahi (os(as) editores(as) do BLFS não recomendam fazer isso, "
"a menos que você realmente precise da funcionalidade dele), desabilite o "
"suporte a DNS Multicast do <command>systemd-resolved</command> e habiite a "
"unidade systemd instalada anteriormente executando o seguinte comando como "
"o(a) usuário(a) <systemitem class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><sect3><indexterm><primary>
#: blfs-en/networking/netutils/avahi.xml:325
#, xml-text
msgid "avahi"
msgstr "avahi"

#. type: Content of: <sect1><sect2><sect3><screen>
#: blfs-en/networking/netutils/avahi.xml:328
#, no-wrap, xml-text
msgid "<userinput>make install-avahi</userinput>"
msgstr "<userinput>make install-avahi</userinput>"

#. type: Content of: <sect1><sect2><sect3><screen>
#: blfs-en/networking/netutils/avahi.xml:330
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir -pv /etc/systemd/resolved.conf.d &amp;&amp;\n"
"cat &gt; /etc/systemd/resolved.conf.d/no-mdns.conf &lt;&lt; EOF &amp;&amp;\n"
"<literal>[Resolve]\n"
"MulticastDNS=no\n"
"</literal>EOF\n"
"systemctl enable avahi-daemon</userinput>"
msgstr ""
"<userinput>mkdir -pv /etc/systemd/resolved.conf.d &amp;&amp;\n"
"cat &gt; /etc/systemd/resolved.conf.d/no-mdns.conf &lt;&lt; EOF &amp;&amp;\n"
"<literal>[Resolve]\n"
"MulticastDNS=no\n"
"</literal>EOF\n"
"systemctl enable avahi-daemon</userinput>"

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/networking/netutils/avahi.xml:338
#, xml-text
msgid ""
"To start the <command>avahi-dnsconfd</command> daemon at boot, enable the "
"previously installed systemd unit by running the following command as the "
"<systemitem class=\"username\">root</systemitem> user (note that the "
"following command will also implicitly enable <command>avahi-"
"daemon</command>, so if you are running it, you need to make sure you've "
"disabled the <command>systemd-resolved</command> Multicast DNS support as "
"mentioned above):"
msgstr ""
"Para iniciar o processo de segundo plano <command>avahi-dnsconfd</command> "
"na inicialização, habilite a unidade systemd instalada anteriormente "
"executando o seguinte comando como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem> (observe que o seguinte comando também "
"habilitará implicitamente o <command>avahi-daemon</command>, de forma que, "
"se você o estiver executando, precisará certificar-se de que tenha "
"desabilitado o suporte a DNS multicast do <command>systemd-"
"resolved</command>, conforme mencionado acima):"

#. type: Content of: <sect1><sect2><sect3><screen>
#: blfs-en/networking/netutils/avahi.xml:347
#, no-wrap, xml-text
msgid "<userinput>systemctl enable avahi-dnsconfd</userinput>"
msgstr "<userinput>systemctl enable avahi-dnsconfd</userinput>"

