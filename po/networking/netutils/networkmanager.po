#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/netutils/networkmanager.xml:163
#, xml-text
msgid ""
"Fix the python scripts so that they use <application>Python 3</application>:"
msgstr ""
"Corrija os conjuntos sequenciais de comandos &quot;Python&quot;, de forma "
"que eles usem &quot;<application>Python 3</application>&quot;:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/networking/netutils/networkmanager.xml:167
#, no-wrap, xml-text
msgid ""
"<userinput>grep -rl '^#!.*python$' | xargs sed -i "
"'1s/python/&amp;3/'</userinput>"
msgstr ""
"<userinput>grep -rl '^#!.*python$' | xargs sed -i "
"'1s/python/&amp;3/'</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/netutils/networkmanager.xml:170
#, xml-text
msgid ""
"Install <application>NetworkManager</application> by running the following "
"commands:"
msgstr ""
"Instale o <application>NetworkManager</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/networking/netutils/networkmanager.xml:174
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup ..                    \\\n"
"      --prefix=/usr               \\\n"
"      --buildtype=release         \\\n"
"      -D libaudit=no              \\\n"
"      -D nmtui=true               \\\n"
"      -D ovs=false                \\\n"
"      -D ppp=false                \\\n"
"      -D selinux=false            \\\n"
"      -D session_tracking=elogind \\\n"
"      -D modem_manager=false      \\\n"
"      -D systemdsystemunitdir=no  \\\n"
"      -D systemd_journal=false    \\\n"
"      -D nm_cloud_setup=false     \\\n"
"      -D qt=false                 &amp;&amp;\n"
"ninja</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup ..                    \\\n"
"      --prefix=/usr               \\\n"
"      --buildtype=release         \\\n"
"      -D libaudit=no              \\\n"
"      -D nmtui=true               \\\n"
"      -D ovs=false                \\\n"
"      -D ppp=false                \\\n"
"      -D selinux=false            \\\n"
"      -D session_tracking=elogind \\\n"
"      -D modem_manager=false      \\\n"
"      -D systemdsystemunitdir=no  \\\n"
"      -D systemd_journal=false    \\\n"
"      -D nm_cloud_setup=false     \\\n"
"      -D qt=false                 &amp;&amp;\n"
"ninja</userinput>"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/networking/netutils/networkmanager.xml:193
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup ..                    \\\n"
"      --prefix=/usr               \\\n"
"      --buildtype=release         \\\n"
"      -D libaudit=no              \\\n"
"      -D nmtui=true               \\\n"
"      -D ovs=false                \\\n"
"      -D ppp=false                \\\n"
"      -D selinux=false            \\\n"
"      -D qt=false                 \\\n"
"      -D session_tracking=systemd \\\n"
"      -D nm_cloud_setup=false     \\\n"
"      -D modem_manager=false      &amp;&amp;\n"
