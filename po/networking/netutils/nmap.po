#. type: Content of: <sect1><sect2><title>
#: blfs-en/networking/netutils/nmap.xml:122
#, xml-text
msgid "Installation of Nmap"
msgstr "Instalação do Nmap"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/netutils/nmap.xml:125
#, xml-text
msgid ""
"Make the build system use the <application>Setuptools</application> Python "
"module from LFS instead of downloading a copy from the Internet, and install"
" the Python wheels already created when running the <command>make</command> "
"instead of rebuilding them again on <command>make install</command>:"
msgstr ""
"Faça o sistema de construção usar o módulo Python "
"<application>Setuptools</application> proveniente do LFS em vez de baixar "
"uma cópia a partir da Internet e instale as rodas Python já criadas ao "
"executar o <command>make</command> em vez de reconstruí-las novamente no "
"<command>make install</command>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/networking/netutils/nmap.xml:132
#, no-wrap, xml-text
msgid ""
"<userinput>sed -ri Makefile.in \\\n"
"    -e 's#-m build#&amp; --no-isolation#'  \\\n"
"    -e '/pip install/s#(ZENMAP|NDIFF)DIR\\)/#&amp;dist/*.whl#'</userinput>"
msgstr ""
"<userinput>sed -ri Makefile.in \\\n"
"    -e 's#-m build#&amp; --no-isolation#'  \\\n"
"    -e '/pip install/s#(ZENMAP|NDIFF)DIR\\)/#&amp;dist/*.whl#'</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/netutils/nmap.xml:137
#, xml-text
msgid "Remove a useless dependency on setuptools-gettext:"
msgstr "Remova uma dependência inútil em setuptools-gettext:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/networking/netutils/nmap.xml:140
#, no-wrap, xml-text
msgid ""
"<userinput>sed 's/, \"setuptools-gettext\"//' -i "
"zenmap/pyproject.toml</userinput>"
msgstr ""
"<userinput>sed 's/, \"setuptools-gettext\"//' -i "
"zenmap/pyproject.toml</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/netutils/nmap.xml:144
#, xml-text
msgid "Fix a packaging error that makes the build fail:"
msgstr "Corrija um erro de empacotamento que faz a construção falhar:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/networking/netutils/nmap.xml:147
#, no-wrap, xml-text
msgid ""
"<userinput>sed '/py-modules/s/f\"/&amp;, \"Version\"/' -i "
"ndiff/pyproject.toml</userinput>"
msgstr ""
"<userinput>sed '/py-modules/s/f\"/&amp;, \"Version\"/' -i "
"ndiff/pyproject.toml</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/netutils/nmap.xml:150
#, xml-text
msgid "Fix compiling this package against OpenSSL-4:"
msgstr "Corrija compilar esse pacote contra OpenSSL-4:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/networking/netutils/nmap.xml:153
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"pre\">patch -Np1 -i ../nmap-&nmap-"
"version;-openssl4_fixes-1.patch</userinput>"
msgstr ""
"<userinput remap=\"pre\">patch -Np1 -i ../nmap-&nmap-"
"version;-openssl4_fixes-1.patch</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/netutils/nmap.xml:156
#, xml-text
msgid ""
"Install <application>Nmap</application> by running the following commands:"
msgstr ""
"Instale o &quot;<application>Nmap</application>&quot; executando os "
"seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/networking/netutils/nmap.xml:160
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>./configure --prefix=/usr &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/netutils/nmap.xml:164
#, xml-text
msgid "If you wish to run the test suite, run the following command:"
msgstr "Se você deseja executar a suíte de teste, execute o seguinte comando:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/networking/netutils/nmap.xml:167
#, no-wrap, xml-text
msgid ""
"<userinput>sed -e '/import imp/d'                \\\n"
"    -e 's/^ndiff = .*$/import ndiff/' \\\n"
"    -i ndiff/ndifftest.py</userinput>"
msgstr ""
"<userinput>sed -e '/import imp/d'                \\\n"
"    -e 's/^ndiff = .*$/import ndiff/' \\\n"
"    -i ndiff/ndifftest.py</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/netutils/nmap.xml:172
#, xml-text
msgid ""
"Tests need a graphical session and to be run as the &root; user.  To test "
"the results, issue:"
msgstr ""
"Os testes precisam de uma sessão gráfica e serem executados como o(a) "
"usuário(a) &root;. Para testar os resultados, emita:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/networking/netutils/nmap.xml:176
#, no-wrap, xml-text
msgid "<userinput>make check</userinput>"
msgstr "<userinput>make check</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/netutils/nmap.xml:179
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) &quot;<systemitem "
"class=\"username\">root</systemitem>&quot;:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/networking/netutils/nmap.xml:182
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

