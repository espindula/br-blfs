#. type: Content of: <sect1><sect2><title>
#: blfs-en/networking/netprogs/rpcbind.xml:81
#, xml-text
msgid "Installation of rpcbind"
msgstr "Instalação do rpcbind"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/netprogs/rpcbind.xml:84
#, xml-text
msgid ""
"There should be a dedicated user and group to take control of the "
"<command>rpcbind</command> daemon after it is started.  Issue the following "
"commands as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Deveria existir um(a) usuário(a) e um grupo dedicado(a) para assumir o "
"controle do processo de segundo plano &quot;<command>rpcbind</command>&quot;"
" depois de ele ser iniciado. Emita os seguintes comandos como o(a) "
"usuário(a) &quot;<systemitem class=\"username\">root</systemitem>&quot;:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/networking/netprogs/rpcbind.xml:90
#, no-wrap, xml-text
msgid ""
"<userinput>groupadd -g 28 rpc &amp;&amp;\n"
"useradd -c \"RPC Bind Daemon Owner\" -d /dev/null -g rpc \\\n"
"        -s /bin/false -u 28 rpc</userinput>"
msgstr ""
"<userinput>groupadd -g 28 rpc &amp;&amp;\n"
"useradd -c \"Proprietário(a) do Processo de Segundo Plano de Ligação RPC\" -d /dev/null -g rpc \\\n"
"        -s /bin/false -u 28 rpc</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/netprogs/rpcbind.xml:96
#, xml-text
msgid ""
"In order to get <application>rpcbind</application> to work properly, first "
"fix the package to use correct service name:"
msgstr ""
"Para a finalidade de conseguir que o "
"&quot;<application>rpcbind</application>&quot; funcione corretamente, "
"primeiro corrija o pacote para usar o nome correto do serviço:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/networking/netprogs/rpcbind.xml:100
#, no-wrap, xml-text
msgid ""
"<userinput>sed -i \"/servname/s:rpcbind:sunrpc:\" src/rpcbind.c</userinput>"
msgstr ""
"<userinput>sed -i \"/servname/s:rpcbind:sunrpc:\" src/rpcbind.c</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/netprogs/rpcbind.xml:103
#, xml-text
msgid ""
"Install <application>rpcbind</application> by running the following "
"commands:"
msgstr ""
"Instale o &quot;<application>rpcbind</application>&quot; executando os "
"seguintes comandos:"

#.  Previously, there were switches for bindir= and sbindir= pointing to /sbin
#.      However, with a DESTDIR= install after merged-/usr changes, I think we
#. can
#.      just run bindir=/usr/sbin to get rpcinfo in /usr/sbin, and leave
#. sbindir=
#.      alone. -renodr
#. type: Content of: <sect1><sect2><screen>
#: blfs-en/networking/netprogs/rpcbind.xml:112
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr                                  \\\n"
"            --bindir=/usr/sbin                             \\\n"
"            --with-rpcuser=root                            \\\n"
"            --enable-warmstarts                            \\\n"
"            --without-systemdsystemunitdir                 &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>./configure --prefix=/usr                                  \\\n"
"            --bindir=/usr/sbin                             \\\n"
"            --with-rpcuser=root                            \\\n"
"            --enable-warmstarts                            \\\n"
"            --without-systemdsystemunitdir                 &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/networking/netprogs/rpcbind.xml:119
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr       \\\n"
"            --bindir=/usr/sbin  \\\n"
"            --enable-warmstarts \\\n"
"            --with-rpcuser=rpc  &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>./configure --prefix=/usr       \\\n"
"            --bindir=/usr/sbin  \\\n"
"            --enable-warmstarts \\\n"
"            --with-rpcuser=rpc  &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/netprogs/rpcbind.xml:126
#, xml-text
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/netprogs/rpcbind.xml:130
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) &quot;<systemitem "
"class=\"username\">root</systemitem>&quot;:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/networking/netprogs/rpcbind.xml:133
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/networking/netprogs/rpcbind.xml:138
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/netprogs/rpcbind.xml:141
#, xml-text
msgid ""
"<command>--with-rpcuser=root</command>: This works around an error in the "
"configure script."
msgstr ""
"<command>--with-rpcuser=root</command>: Isso contorna um erro no conjunto de"
" comandos sequenciais de configuração."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/netprogs/rpcbind.xml:146
#, xml-text
msgid ""
"<command>--without-systemdsystemunitdir</command>: This version of BLFS does"
" not support systemd."
msgstr ""
"<command>--without-systemdsystemunitdir</command>: Essa versão do BLFS não "
"suporte o &quot;systemd&quot;."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/netprogs/rpcbind.xml:151
#, xml-text
msgid ""
"<parameter>--with-rpcuser=rpc</parameter>: This switch is used so the "
"<command>rpcbind</command> daemon will run as an unprivileged user instead "
"of the <systemitem class=\"username\">root</systemitem> user."
msgstr ""
"<parameter>--with-rpcuser=rpc</parameter>: Essa chave é usada de forma que o"
" processo de segundo plano &quot;<command>rpcbind</command>&quot; executará "
"como um(a) usuário(a) sem privilégios em vez do(a) usuário(a) "
"&quot;<systemitem class=\"username\">root</systemitem>&quot;."

#. type: Content of: <sect1><sect2><title>
#: blfs-en/networking/netprogs/rpcbind.xml:160
#, xml-text
msgid "Configuring rpcbind"
msgstr "Configurando rpcbind"

#. type: Content of: <sect1><sect2><sect3><title>
#: blfs-en/networking/netprogs/rpcbind.xml:163
#, xml-text
msgid ""
"<phrase revision=\"sysv\">Boot Script</phrase> <phrase "
"revision=\"systemd\">Systemd Unit</phrase>"
msgstr ""
"<phrase revision=\"sysv\">Conjunto de Comandos Sequenciais de "
"Inicialização</phrase> <phrase revision=\"systemd\">Unidade do "
"systemd</phrase>"

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/networking/netprogs/rpcbind.xml:167
#, xml-text
msgid ""
"Install the <phrase "
"revision=\"sysv\"><filename>/etc/rc.d/init.d/rpcbind</filename> init "
"script</phrase> included in the <xref linkend=\"bootscripts\"/> package."
msgstr ""
"Instale o conjunto de comandos sequenciais de iniciação <phrase "
"revision=\"sysv\">&quot;<filename>/etc/rc.d/init.d/rpcbind</filename>&quot;</phrase>"
" incluso no pacote &quot;<xref linkend=\"bootscripts\"/>&quot;."

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/networking/netprogs/rpcbind.xml:174
#, xml-text
msgid "Enable the systemd unit installed with the package:"
msgstr "Habilite a unidade do &quot;systemd&quot; instalada com o pacote:"

#. type: Content of: <sect1><sect2><sect3><screen>
#: blfs-en/networking/netprogs/rpcbind.xml:181
#, no-wrap, xml-text
msgid "<userinput>make install-rpcbind</userinput>"
msgstr "<userinput>make install-rpcbind</userinput>"

#. type: Content of: <sect1><sect2><sect3><screen>
#: blfs-en/networking/netprogs/rpcbind.xml:183
#, no-wrap, xml-text
msgid "<userinput>systemctl enable rpcbind</userinput>"
msgstr "<userinput>systemctl enable rpcbind</userinput>"

