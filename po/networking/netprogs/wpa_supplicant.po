#~ "    [*]     cfg80211 wireless extensions compatibility    [CONFIG_CFG80211_WEXT]\n"
#~ "    &lt;*/M&gt; Generic IEEE 802.11 Networking Stack (mac80211) [CONFIG_MAC80211]\n"
