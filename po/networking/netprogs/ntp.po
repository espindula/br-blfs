#, xml-text
msgid "Introduction to ntp"
msgstr "Introdução ao ntp"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/netprogs/ntp.xml:29
#, xml-text
msgid ""
"The <application>ntp</application> package contains a client and server to "
"keep the time synchronized between various computers over a network. This "
"package is the official reference implementation of the NTP protocol."
msgstr ""
"O pacote &quot;<application>ntp</application>&quot; contém um cliente e um "
"servidor para manter a hora sincronizada entre vários computadores em uma "
"rede de intercomunicação. Esse pacote é a implementação de referência "
"oficial do protocolo &quot;NTP&quot;."

