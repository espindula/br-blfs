#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/netprogs/nfs-utils.xml:76
#, xml-text
msgid ""
"<xref linkend=\"libevent\"/>, <xref linkend=\"libnl\"/>, <xref "
"linkend=\"libtirpc\"/>, <xref linkend=\"libxml2\"/>, and <xref "
"linkend=\"rpcsvc-proto\"/>"
msgstr ""
"<xref linkend=\"libevent\"/>, <xref linkend=\"libnl\"/>, <xref "
"linkend=\"libtirpc\"/>, <xref linkend=\"libxml2\"/> e <xref "
"linkend=\"rpcsvc-proto\"/>"

#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/networking/netprogs/nfs-utils.xml:83
#, xml-text
msgid "Optional"
msgstr "Opcionais"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/netprogs/nfs-utils.xml:85
#, xml-text
msgid ""
"<xref linkend=\"cyrus-sasl\"/> (for SASL authentication), <xref "
"linkend=\"libnsl\"/> (for NIS client support), <xref linkend=\"lvm2\"/> "
"(libdevmapper for NFSv4 support), <xref linkend=\"openldap\"/> (for LDAP "
"authentication), <xref linkend=\"mitkrb\"/> or <ulink "
"url=\"http://www.citi.umich.edu/projects/nfsv4/linux/\"> libgssapi</ulink>, "
"and <ulink url=\"http://www.citi.umich.edu/projects/nfsv4/linux/\"> "
"librpcsecgss </ulink> (for GSS and RPC security support), and <xref "
"linkend=\"libcap-pam\"/>"
msgstr ""
"<xref linkend=\"cyrus-sasl\"/> (para autenticação SASL), <xref "
"linkend=\"libnsl\"/> (para suporte ao cliente NIS), <xref linkend=\"lvm2\"/>"
" (libdevmapper para suporte a NFSv4), <xref linkend=\"openldap\"/> (para "
"autenticação LDAP), <xref linkend=\"mitkrb\"/> ou <ulink "
"url=\"http://www.citi.umich.edu/projects/nfsv4/linux/\"> libgssapi </ulink> "
"e <ulink url=\"http://www.citi.umich.edu/projects/nfsv4/linux/\"> "
"librpcsecgss </ulink> (para suporte de segurança GSS e RPC), e <xref "
"linkend=\"libcap-pam\"/>"

