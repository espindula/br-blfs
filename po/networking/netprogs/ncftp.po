#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/netprogs/ncftp.xml:116
#, xml-text
msgid ""
"To install <application>NcFTP</application>, run the following commands:"
msgstr ""
"Para instalar o <application>NcFTP</application>, execute os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/networking/netprogs/ncftp.xml:119
#, no-wrap, xml-text
msgid ""
"<userinput>CC=/usr/bin/gcc \\\n"
"./configure --prefix=/usr --sysconfdir=/etc &amp;&amp;\n"
"make -C libncftp shared &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>CC=/usr/bin/gcc \\\n"
"./configure --prefix=/usr --sysconfdir=/etc &amp;&amp;\n"
"make -C libncftp shared &amp;&amp;\n"
"make</userinput>"

