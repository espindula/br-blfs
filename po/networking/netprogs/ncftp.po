#. type: Content of: <sect1><sect2><title>
#: blfs-en/networking/netprogs/ncftp.xml:26
#, xml-text
msgid "Introduction to NcFTP"
msgstr "Introdução ao NcFTP"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/netprogs/ncftp.xml:29
#, xml-text
msgid ""
"The <application>NcFTP</application> package contains a powerful and "
"flexible interface to the Internet standard File Transfer Protocol.  It is "
"intended to replace or supplement the stock <command>ftp</command> program."
msgstr ""
"O pacote &quot;<application>NcFTP</application>&quot; contém uma interface "
"poderosa e flexível para o protocolo de transferência de arquivos padrão da "
"Internet. Destina-se a substituir ou complementar o aplicativo "
"&quot;<command>ftp</command>&quot; padrão."

