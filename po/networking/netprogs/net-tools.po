#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/netprogs/net-tools.xml:169
#, xml-text
msgid ""
"<command>sed -e ...</command>: This disables building protocols that are not"
" available anymore in the kernel."
msgstr ""
"<command>sed -e ...</command>: Isso desabilita construir protocolos que não "
"mais estão disponíveis no núcleo."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/netprogs/net-tools.xml:174
#, xml-text
msgid "<command>rm ...</command>: Remove unneeded programs and man pages."
