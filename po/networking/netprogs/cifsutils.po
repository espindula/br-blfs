#. type: Content of: <sect1><sect2><title>
#: blfs-en/networking/netprogs/cifsutils.xml:119
#, xml-text
msgid "Installation of cifs-utils"
msgstr "Instalação do cifs-utils"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/netprogs/cifsutils.xml:122
#, xml-text
msgid ""
"Install <application>cifs-utils</application> by running the following "
"commands:"
msgstr ""
"Instale <application>cifs-utils</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/networking/netprogs/cifsutils.xml:126
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr \\\n"
"            --disable-pam \\\n"
"            --disable-systemd &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>./configure --prefix=/usr \\\n"
"           --disable-pam \\\n"
"           --disable-systemd &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/networking/netprogs/cifsutils.xml:131
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr \\\n"
"            --disable-pam &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>./configure --prefix=/usr \\\n"
"           --disable-pam &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/netprogs/cifsutils.xml:136
#, xml-text
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/netprogs/cifsutils.xml:140
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) &quot;<systemitem "
"class=\"username\">root</systemitem>&quot;:"

#.  Note to editors: You need to define ROOTSBINDIR and man8dir, like this:
#.      ROOTSBINDIR=<DESTDIR>
#. /sbin man8dir=<DESTDIR>/usr/share/man/man8
#.      This is due to a bug in the makefile for cifs-utils-6.10, since it
#. tries
#.      to install symlinks for mount.smb3 without thinking about DESTDIR
#.      installations.
#. type: Content of: <sect1><sect2><screen>
#: blfs-en/networking/netprogs/cifsutils.xml:149
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/networking/netprogs/cifsutils.xml:154
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/netprogs/cifsutils.xml:157
#, xml-text
msgid ""
"<parameter>--disable-pam</parameter>: Do not build PAM support.  Remove it "
"and use <option>--with-pamdir</option> (see below), if <xref "
"linkend=\"linux-pam\"/> is installed and you wish PAM support."
msgstr ""
"<parameter>--disable-pam</parameter>: Não construa suporte &quot;PAM&quot;. "
"Remova-a e use &quot;<option>--with-pamdir</option>&quot; (veja-se abaixo), "
"se &quot;<xref linkend=\"linux-pam\"/>&quot; estiver instalado e você "
"desejar suporte &quot;PAM&quot;."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/netprogs/cifsutils.xml:164
#, xml-text
msgid ""
"<parameter>--disable-systemd</parameter>: Disable systemd specific behavior "
"for <command>mount.cifs</command>."
msgstr ""
"<parameter>--disable-systemd</parameter>: Desabilite o comportamento "
"específico do &quot;systemd&quot; para "
"&quot;<command>mount.cifs</command>&quot;."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/netprogs/cifsutils.xml:169
#, xml-text
msgid ""
"<option>--with-pamdir=/usr/lib/security</option>: Install the PAM module in "
"<filename class=\"directory\">/usr/lib/security</filename>."
msgstr ""
"<option>--with-pamdir=/usr/lib/security</option>: Instale o módulo "
"&quot;PAM&quot; em &quot;<filename "
"class=\"directory\">/usr/lib/security</filename>&quot;."

