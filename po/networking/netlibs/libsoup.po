#. type: Content of: <sect1><sect2><title>
#: blfs-en/networking/netlibs/libsoup.xml:27
#, xml-text
msgid "Introduction to libsoup"
msgstr "Introdução ao libsoup"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/netlibs/libsoup.xml:30
#, xml-text
msgid ""
"The <application>libsoup</application> is a HTTP client/server library for "
"<application>GNOME</application>. It uses GObject and the GLib main loop to "
"integrate with <application>GNOME</application> applications and it also has"
" an asynchronous API for use in threaded applications."
msgstr ""
"A &quot;<application>libsoup</application>&quot; é uma biblioteca "
"&quot;HTTP&quot; cliente/servidor para o "
"&quot;<application>GNOME</application>&quot;. Ela usa &quot;GObject&quot; e "
"o &quot;loop&quot; principal &quot;GLib&quot; para integração com "
"aplicativos &quot;<application>GNOME</application>&quot; e também tem uma "
"&quot;API&quot; assíncrona para uso em aplicativos em camadas."

