#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) &quot;<systemitem "
"class=\"username\">root</systemitem>&quot;:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/networking/netlibs/libtirpc.xml:114
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/networking/netlibs/libtirpc.xml:119
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/netlibs/libtirpc.xml:125
#, xml-text
msgid ""
"<parameter>--disable-gssapi</parameter>: This switch is needed if no GSSAPI "
"is installed. Remove this switch if you have one installed (for example "
"<xref linkend=\"mitkrb\"/>) and you wish to use it."
msgstr ""
"<parameter>--disable-gssapi</parameter>: Essa chave é necessária se nenhum "
"&quot;GSSAPI&quot; estiver instalado. Remova essa chave se você tiver uma "
"instalada (por exemplo &quot;<xref linkend=\"mitkrb\"/>&quot;) e desejar "
"usá-la."

