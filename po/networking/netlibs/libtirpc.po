#, xml-text
msgid "Introduction to libtirpc"
msgstr "Introdução ao libtirpc"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/netlibs/libtirpc.xml:29
#, xml-text
msgid ""
"The <application>libtirpc</application> package contains libraries that "
"support programs that use the Remote Procedure Call (RPC)  API. It replaces "
"the RPC, but not the NIS library entries that used to be in glibc."
msgstr ""
"O pacote &quot;<application>libtirpc</application>&quot; contém bibliotecas "
"que suportam aplicativos que usam a &quot;API&quot; &quot;Remote Procedure "
"Call&quot; (&quot;RPC&quot;). Ele substitui o &quot;RPC&quot;, mas não as "
"entradas da biblioteca &quot;NIS&quot; que costumavam estar na "
"&quot;glibc&quot;."

