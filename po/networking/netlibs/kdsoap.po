#, xml-text
msgid "Installation of kdsoap"
msgstr "Instalação do kdsoap"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/netlibs/kdsoap.xml:84
#, xml-text
msgid ""
"Install <application>kdsoap</application> by running the following commands:"
msgstr ""
"Instale <application>kdsoap</application> executando os seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/networking/netlibs/kdsoap.xml:88
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr \\\n"
"      -D CMAKE_BUILD_TYPE=Release  \\\n"
"      -D KDSoap_QT6=ON             \\\n"
"      -D CMAKE_INSTALL_DOCDIR=/usr/share/doc/kdsoap-&kdsoap-version; \\\n"
"      .. &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr \\\n"
"      -D CMAKE_BUILD_TYPE=Release  \\\n"
"      -D KDSoap_QT6=ON             \\\n"
"      -D CMAKE_INSTALL_DOCDIR=/usr/share/doc/kdsoap-&kdsoap-version; \\\n"
"      .. &amp;&amp;\n"
"make</userinput>"

