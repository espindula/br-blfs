#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/netlibs/libnsl.xml:29
#, xml-text
msgid ""
"The <application>libnsl</application> package contains the public client "
"interface for NIS(YP). It replaces the NIS library that used to be in glibc."
msgstr ""
"O pacote &quot;<application>libnsl</application>&quot; contém a interface "
"pública cliente para &quot;NIS(YP)&quot;. Ele substitui a biblioteca "
"&quot;NIS&quot; que costumava estar na &quot;glibc&quot;."

