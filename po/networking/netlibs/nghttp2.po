#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/netlibs/nghttp2.xml:29
#, xml-text
msgid ""
"<application>nghttp2</application> is an implementation of HTTP/2 and its "
"header compression algorithm, HPACK."
msgstr ""
"&quot;<application>nghttp2</application>&quot; é uma implementação de "
"&quot;HTTP/2&quot; e do algoritmo de compressão de cabeçalho dele, "
"&quot;HPACK&quot;."

