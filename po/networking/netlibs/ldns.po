#. type: Content of: <sect1><sect2><title>
#: blfs-en/networking/netlibs/ldns.xml:84
#, xml-text
msgid "Installation of ldns"
msgstr "Instalação do ldns"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/netlibs/ldns.xml:87
#, xml-text
msgid ""
"Install <application>ldns</application> by running the following commands:"
msgstr ""
"Instale o &quot;<application>ldns</application>&quot; executando os "
"seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/networking/netlibs/ldns.xml:91
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr     \\\n"
"            --sysconfdir=/etc \\\n"
"            --disable-static  \\\n"
"            --with-drill      &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>./configure --prefix=/usr     \\\n"
"            --sysconfdir=/etc \\\n"
"            --disable-static  \\\n"
"            --with-drill      &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/netlibs/ldns.xml:98
#, xml-text
msgid ""
"If you have <xref linkend=\"doxygen\"/> installed and want to build html "
"documentation, run the following command:"
msgstr ""
"Se você tiver o &quot;<xref linkend=\"doxygen\"/>&quot; instalado e desejar "
"construir a documentação &quot;HTML&quot;, [então] execute o seguinte "
"comando:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/networking/netlibs/ldns.xml:102
#, no-wrap, xml-text
msgid "<userinput>make doc</userinput>"
msgstr "<userinput>make doc</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/netlibs/ldns.xml:105
#, xml-text
msgid "This package does not come with a working test suite."
msgstr "Esse pacote não vem com uma suíte de teste funcional."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/netlibs/ldns.xml:109
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) &quot;<systemitem "
"class=\"username\">root</systemitem>&quot;:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/networking/netlibs/ldns.xml:112
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/netlibs/ldns.xml:115
#, xml-text
msgid ""
"If you built html documentation, install it by running the following "
"commands as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Se você construiu a documentação &quot;HTML&quot;, [então] instale-a "
"executando os seguintes comandos como o(a) usuário(a) &quot;<systemitem "
"class=\"username\">root</systemitem>&quot;:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/networking/netlibs/ldns.xml:120
#, no-wrap, xml-text
msgid ""
"<userinput>install -v -m755 -d /usr/share/doc/ldns-&ldns-version; &amp;&amp;\n"
"install -v -m644 doc/html/* /usr/share/doc/ldns-&ldns-version;</userinput>"
msgstr ""
"<userinput>install -v -m755 -d /usr/share/doc/ldns-&ldns-version; &amp;&amp;\n"
"install -v -m644 doc/html/* /usr/share/doc/ldns-&ldns-version;</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/networking/netlibs/ldns.xml:126
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/netlibs/ldns.xml:132
#, xml-text
msgid ""
"<parameter>--with-drill</parameter>: This option enables building of the "
"<command>drill</command> tool (used for obtaining debug information from "
"DNS(SEC))"
msgstr ""
"<parameter>--with-drill</parameter>: Essa opção habilita a construção da "
"ferramenta &quot;<command>drill</command>&quot; (usada para obter "
"informações de depuração a partir do &quot;DNS(SEC)&quot;)"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/netlibs/ldns.xml:147
#, xml-text
msgid ""
"<option>--with-examples</option>: This option enables building of the "
"example programs."
msgstr ""
"<option>--with-examples</option>: Essa opção habilita a construção dos "
"aplicativos de exemplo."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/netlibs/ldns.xml:152
#, xml-text
msgid ""
"<option>--with-pyldns</option>: This option enables building of the Python "
"bindings. If you use this option, you will need to add "
"PYTHON=/usr/bin/python3 to the configure line as well."
msgstr ""
"<option>--with-pyldns</option>: Essa opção habilita construção das ligações "
"Python. Se você usar essa opção, precisará adicionar PYTHON=/usr/bin/python3"
" à linha do configure também."

