msgstr "Opcionais"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/netlibs/neon.xml:74
#, xml-text
msgid ""
"<xref linkend=\"gnutls\"/>, <xref linkend=\"libxml2\"/>, <xref "
"linkend=\"mitkrb\"/>, <xref linkend=\"nss\"/> (for some tests), <xref "
"linkend=\"xmlto\"/> (to regenerate the documentation), <ulink "
"url=\"https://github.com/libproxy/libproxy\">libproxy</ulink>, and <ulink "
"url=\"https://www.manyfish.co.uk/pakchois/\">PaKChoiS</ulink>"
msgstr ""
"<xref linkend=\"gnutls\"/>, <xref linkend=\"libxml2\"/>, <xref "
"linkend=\"mitkrb\"/>, <xref linkend=\"nss\"/> (para alguns testes), <xref "
"linkend=\"xmlto\"/> (para regenerar a documentação), <ulink "
"url=\"https://github.com/libproxy/libproxy\">libproxy</ulink> e <ulink "
"url=\"https://www.manyfish.co.uk/pakchois/\">PaKChoiS</ulink>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/networking/netlibs/neon.xml:86
#, xml-text
msgid "Installation of neon"
msgstr "Instalação do neon"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/netlibs/neon.xml:98
#, xml-text
msgid ""
"Install <application>neon</application> by running the following commands:"
msgstr ""
"Instale o &quot;<application>neon</application>&quot; executando os "
"seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/networking/netlibs/neon.xml:102
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr    \\\n"
"            --with-ssl       \\\n"
"            --enable-shared  \\\n"
"            --disable-static &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>./configure --prefix=/usr   \\\n"
"            --with-ssl       \\\n"
"            --enable-shared  \\\n"
"            --disable-static &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/netlibs/neon.xml:109
#, xml-text
msgid "To test the results, issue: <command>make check</command>."
msgstr "Para testar os resultados, emita: <command>make check</command>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/netlibs/neon.xml:113
#, xml-text
msgid "If you wish to regenerate the documentation, issue:"
msgstr "Se você desejar regenerar a documentação, emita:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/networking/netlibs/neon.xml:116
#, no-wrap, xml-text
msgid "<userinput>make docs</userinput>"
msgstr "<userinput>make docs</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/netlibs/neon.xml:119
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) &quot;<systemitem "
"class=\"username\">root</systemitem>&quot;:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/networking/netlibs/neon.xml:122
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/networking/netlibs/neon.xml:127
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/netlibs/neon.xml:130
#, xml-text
msgid ""
"<parameter>--with-ssl</parameter>: This switch enables SSL support using "
"<application>OpenSSL</application>.  <application>GnuTLS</application> can "
"be used instead, by passing <option>--with-ssl=gnutls</option> and "
"<option>--with-ca-bundle=/etc/pki/tls/certs/ca-bundle.crt</option> to the "
"<command>configure</command> script."
msgstr ""
"<parameter>--with-ssl</parameter>: Essa chave habilita o suporte "
"&quot;SSL&quot; usando o &quot;<application>OpenSSL</application>&quot;. O "
"&quot;<application>GnuTLS</application>&quot; pode ser usado em vez disso, "
"passando-se &quot;<option>--with-ssl=gnutls</option>&quot; e "
"&quot;<option>--with-ca-bundle=/etc/pki/tls/certs/ca-"
"bundle.crt</option>&quot; para o conjunto de comandos sequenciais "
"&quot;<command>configure</command>&quot;."

