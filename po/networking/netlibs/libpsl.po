#, xml-text
msgid "Installation of libpsl"
msgstr "Instalação do libpsl"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/netlibs/libpsl.xml:92
#, xml-text
msgid ""
"Install <application>libpsl</application> by running the following commands:"
msgstr ""
"Instale o &quot;<application>libpsl</application>&quot; executando os "
"seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/networking/netlibs/libpsl.xml:96
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr --buildtype=release &amp;&amp;\n"
"\n"
"ninja</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr --buildtype=release &amp;&amp;\n"
"\n"
"ninja</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/netlibs/libpsl.xml:104
#, xml-text
msgid "To test the results, issue: <command>ninja test</command>."
msgstr "Para testar os resultados, emita: <command>ninja test</command>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/netlibs/libpsl.xml:108
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr "Agora, como o(a) usante <systemitem class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/networking/netlibs/libpsl.xml:111
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr "<userinput>ninja install</userinput>"

