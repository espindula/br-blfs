#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/netlibs/c-ares.xml:82
#, xml-text
msgid ""
"Install <application>c-ares</application> by running the following commands:"
msgstr ""
"Instale <application>c-ares</application> executando os seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/networking/netlibs/c-ares.xml:86
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake  -D CMAKE_INSTALL_PREFIX=/usr .. &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake  -D CMAKE_INSTALL_PREFIX=/usr .. &amp;&amp;\n"
"make</userinput>"

