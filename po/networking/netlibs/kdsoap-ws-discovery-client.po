#. type: Content of: <sect1><sect2><title>
#: blfs-en/networking/netlibs/kdsoap-ws-discovery-client.xml:75
#, xml-text
msgid "Installation of kdsoap-ws-discovery-client"
msgstr "Instalação do kdsoap-ws-discovery-client"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/netlibs/kdsoap-ws-discovery-client.xml:78
#, xml-text
msgid ""
"Install <application>kdsoap-ws-discovery-client</application> by running the"
" following commands:"
msgstr ""
"Instale <application>kdsoap-ws-discovery-client</application> executando os "
"seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/networking/netlibs/kdsoap-ws-discovery-client.xml:82
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr    \\\n"
"      -D CMAKE_BUILD_TYPE=Release     \\\n"
"      -D CMAKE_SKIP_INSTALL_RPATH=ON  \\\n"
"      -D QT_MAJOR_VERSION=6           \\\n"
"      -W no-author .. &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr    \\\n"
"      -D CMAKE_BUILD_TYPE=Release     \\\n"
"      -D CMAKE_SKIP_INSTALL_RPATH=ON  \\\n"
"      -D QT_MAJOR_VERSION=6           \\\n"
"      -W no-author .. &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/netlibs/kdsoap-ws-discovery-client.xml:93
#, xml-text
msgid "To test the results, issue: <command>make test</command>."
msgstr "Para testar os resultados, emita: <command>make test</command>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/netlibs/kdsoap-ws-discovery-client.xml:97
#, xml-text
msgid "Now, as the &root; user:"
msgstr "Agora, como o(a) usuário(a) &root;:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/networking/netlibs/kdsoap-ws-discovery-client.xml:100
#, no-wrap, xml-text
msgid ""
"<userinput>make install &amp;&amp;\n"
"mv -v /usr/share/doc/KDSoapWSDiscoveryClient{,-&kdsoap-ws-discovery-client-version;}</userinput>"
msgstr ""
"<userinput>make install &amp;&amp;\n"
"mv -v /usr/share/doc/KDSoapWSDiscoveryClient{,-&kdsoap-ws-discovery-client-version;}</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/networking/netlibs/kdsoap-ws-discovery-client.xml:106
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/netlibs/kdsoap-ws-discovery-client.xml:112
#, xml-text
msgid ""
"<command>mv -v /usr/share/doc/KDSoapWSDiscoveryClient[...]:</command>: This "
"command moves the documentation to a versioned directory."
msgstr ""
"<command>mv -v /usr/share/doc/KDSoapWSDiscoveryClient[...]:</command>: Esse "
"comando move a documentação para um diretório versionado."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/netlibs/kdsoap-ws-discovery-client.xml:117
#, xml-text
msgid ""
"<parameter>-D QT_MAJOR_VERSION=6</parameter>: This parameter tells the build"
" system to build the Qt6 version of this package instead of the Qt5 version."
msgstr ""
"<parameter>-D QT_MAJOR_VERSION=6</parameter>: Esse parâmetro informa ao "
"sistema de construção para construir a versão Qt6 deste pacote em vez da "
"versão Qt5."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/netlibs/kdsoap-ws-discovery-client.xml:123
#, xml-text
msgid ""
"<option>-D BUILD_QCH=ON</option>: This option tells the build system to "
"create documentation that can be used with QtCreator, QtAssistant, or "
"KDevelop."
msgstr ""
"<option>-D BUILD_QCH=ON</option>: Essa opção informa ao sistema de "
"construção para criar documentação que pode ser usada com QtCreator, "
"QtAssistant ou KDevelop."

