#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/networking/netlibs/libsoup3.xml:72
#, xml-text
msgid "libsoup3 Dependencies"
msgstr "Dependências do &quot;libsoup3&quot;"

#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/networking/netlibs/libsoup3.xml:74
#, xml-text
msgid "Required"
msgstr "Exigidas"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/netlibs/libsoup3.xml:76
#, xml-text
msgid ""
"<xref linkend=\"glib-networking\"/>, <xref linkend=\"libpsl\"/>, <xref "
"linkend=\"libxml2\"/>, <xref linkend=\"nghttp2\"/>, and <xref "
"linkend=\"sqlite\"/>"
msgstr ""
"<xref linkend=\"glib-networking\"/>, <xref linkend=\"libpsl\"/>, <xref "
"linkend=\"libxml2\"/>, <xref linkend=\"nghttp2\"/> e <xref "
"linkend=\"sqlite\"/>"

#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/networking/netlibs/libsoup3.xml:83
#, xml-text
msgid "Recommended"
msgstr "Recomendadas"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/netlibs/libsoup3.xml:85
#, xml-text
msgid "&gobject-introspection; and <xref linkend=\"vala\"/>"
msgstr "&gobject-introspection; e <xref linkend=\"vala\"/>"

#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/networking/netlibs/libsoup3.xml:89
#, xml-text
msgid "Optional"
msgstr "Opcionais"

#.  It seems that XMLRPC is part of PHP 5.4.10
#. <xref linkend="sysprof"/>
#.  (for profiling),
#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/netlibs/libsoup3.xml:91
#, xml-text
msgid ""
"<xref linkend=\"apache\"/> (required to run the test suite), <xref "
"linkend=\"brotli\"/>, <xref linkend=\"curl\"/> (required to run the test "
"suite), <xref linkend=\"gi-docgen\"/>, <xref linkend=\"mitkrb\"/> (required "
"to run the test suite), <xref linkend=\"php\"/> compiled with XMLRPC-EPI "
"support (only used for the XMLRPC regression tests), <xref "
"linkend=\"samba\"/> (ntlm_auth is required to run the test suite), <ulink "
"url=\"&sysprof-url;\">sysprof</ulink>, and <ulink "
"url=\"https://github.com/posener/wstest\">wstest</ulink>"
msgstr ""
"<xref linkend=\"apache\"/> (exigido para executar a suíte de teste), <xref "
"linkend=\"brotli\"/>, <xref linkend=\"curl\"/> (exigido para executar a "
"suíte de teste), <xref linkend=\"gi-docgen\"/>, <xref linkend=\"mitkrb\"/> "
"(exigido para executar a suíte de teste), <xref linkend=\"php\"/> compilado "
"com suporte XMLRPC-EPI (usado somente para os testes de regressão XMLRPC), "
"<xref linkend=\"samba\"/> (ntlm_auth é exigido para executar a suíte de "
"teste), <ulink url=\"&sysprof-url;\">sysprof</ulink> e <ulink "
"url=\"https://github.com/posener/wstest\">wstest</ulink>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/networking/netlibs/libsoup3.xml:108
#, xml-text
msgid "Installation of libsoup3"
msgstr "Instalação do libsoup3"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/netlibs/libsoup3.xml:111
#, xml-text
msgid "Fix the installation path of API documentation:"
msgstr "Corrija o caminho de instalação da documentação da &quot;API&quot;:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/networking/netlibs/libsoup3.xml:114
#, no-wrap, xml-text
msgid ""
"<userinput>sed 's/apiversion/soup_version/' -i "
"docs/reference/meson.build</userinput>"
msgstr ""
"<userinput>sed 's/apiversion/soup_version/' -i "
"docs/reference/meson.build</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/netlibs/libsoup3.xml:117
#, xml-text
msgid ""
"Install <application>libsoup3</application> by running the following "
"commands:"
msgstr ""
"Instale o &quot;<application>libsoup3</application>&quot; executando os "
"seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/networking/netlibs/libsoup3.xml:121
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr          \\\n"
"            --buildtype=release    \\\n"
"            --wrap-mode=nofallback \\\n"
"            ..                     &amp;&amp;\n"
"ninja</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr          \\\n"
"            --buildtype=release    \\\n"
"            --wrap-mode=nofallback \\\n"
"            ..                     &amp;&amp;\n"
"ninja</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/netlibs/libsoup3.xml:131
#, xml-text
msgid "To test the results, issue: <command>ninja test</command>."
msgstr "Para testar os resultados, emita: <command>ninja test</command>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/netlibs/libsoup3.xml:135
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) &quot;<systemitem "
"class=\"username\">root</systemitem>&quot;:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/networking/netlibs/libsoup3.xml:138
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr "<userinput>ninja install</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/networking/netlibs/libsoup3.xml:143
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/netlibs/libsoup3.xml:152
#, xml-text
msgid ""
"<option>-D docs=enabled</option>: If <xref linkend='gi-docgen'/> is "
"installed, the API documentation will be built and installed no matter if "
"this option is used or not.  This option causes the <command>meson</command>"
" command to fail if <xref linkend='gi-docgen'/> is not installed."
msgstr ""
"<option>-D docs=enabled</option>: Se <xref linkend='gi-docgen'/> estiver "
"instalado, a documentação da API será construída e instalada "
"independentemente de essa opção ser usada ou não. Essa opção faz com que o "
"comando <command>meson</command> falhe se <xref linkend='gi-docgen'/> não "
"estiver instalado."

