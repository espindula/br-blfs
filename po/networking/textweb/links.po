#. type: Content of: <sect1><sect2><sect3><title>
#: blfs-en/networking/textweb/links.xml:166
#, xml-text
msgid "Configuration Information"
msgstr "Informação de Configuração"

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/networking/textweb/links.xml:169
#, xml-text
msgid ""
"<application>Links</application> stores its configuration in per-user files "
"in the <filename class=\"directory\">~/.links</filename> directory.  These "
"files are created automatically when <command>links</command> is run for the"
" first time."
msgstr ""
"O &quot;<application>Links</application>&quot; armazena a configuração dele "
"em arquivos por usuário(a) no diretório &quot;<filename "
"class=\"directory\">~/.links</filename>&quot;. Esses arquivos são criados "
"automaticamente quando o &quot;<command>links</command>&quot; for executado "
"pela primeira vez."

