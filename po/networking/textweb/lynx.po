#. type: Content of: <sect1><sect2><title>
#: blfs-en/networking/textweb/lynx.xml:81
#, xml-text
msgid "Installation of Lynx"
msgstr "Instalação do Lynx"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/textweb/lynx.xml:84
#, xml-text
msgid ""
"Install <application>Lynx</application> by running the following commands:"
msgstr ""
"Instale o &quot;<application>Lynx</application>&quot; executando os "
"seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/networking/textweb/lynx.xml:88
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr           \\\n"
"            --sysconfdir=/etc/lynx  \\\n"
"            --with-zlib             \\\n"
"            --with-bzlib            \\\n"
"            --with-ssl              \\\n"
"            --with-screen=ncursesw  \\\n"
"            --enable-locale-charset \\\n"
"            --datadir=/usr/share/doc/lynx-&lynx-version; &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>./configure --prefix=/usr           \\\n"
"            --sysconfdir=/etc/lynx  \\\n"
"            --with-zlib             \\\n"
"            --with-bzlib            \\\n"
"            --with-ssl              \\\n"
"            --with-screen=ncursesw  \\\n"
"            --enable-locale-charset \\\n"
"            --datadir=/usr/share/doc/lynx-&lynx-version; &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/textweb/lynx.xml:99
#, xml-text
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/textweb/lynx.xml:105
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) &quot;<systemitem "
"class=\"username\">root</systemitem>&quot;:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/networking/textweb/lynx.xml:108
#, no-wrap, xml-text
msgid ""
"<userinput>make install-full\n"
"chgrp -v -R root /usr/share/doc/lynx-&lynx-version;/lynx_doc</userinput>"
msgstr ""
"<userinput>make install-full\n"
"chgrp -v -R root /usr/share/doc/lynx-&lynx-version;/lynx_doc</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/networking/textweb/lynx.xml:114
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/textweb/lynx.xml:117
#, xml-text
msgid ""
"<parameter>--sysconfdir=/etc/lynx</parameter>: This parameter is used so "
"that the configuration files are located in <filename "
"class=\"directory\">/etc/lynx</filename> instead of <filename "
"class=\"directory\">/usr/etc</filename>."
msgstr ""
"<parameter>--sysconfdir=/etc/lynx</parameter>: Esse parâmetro é usado para "
"que os arquivos de configuração estejam localizados em <filename "
"class=\"directory\">/etc/lynx</filename> em vez de <filename "
"class=\"directory\">/usr/etc</filename>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/textweb/lynx.xml:124
#, xml-text
msgid ""
"<parameter>--datadir=/usr/share/doc/lynx-&lynx-version;</parameter>: This "
"parameter is used so that the documentation files are installed into "
"<filename class=\"directory\">/usr/share/doc/lynx-&lynx-version;</filename> "
"instead of <filename "
"class=\"directory\">/usr/share/lynx_{doc,help}</filename>."
msgstr ""
"<parameter>--datadir=/usr/share/doc/lynx-&lynx-version;</parameter>: Esse "
"parâmetro é usado para que os arquivos da documentação sejam instalados em "
"<filename class=\"directory\">/usr/share/doc/lynx-&lynx-version;</filename> "
"em vez de <filename "
"class=\"directory\">/usr/share/lynx_{doc,help}</filename>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/textweb/lynx.xml:132
#, xml-text
msgid ""
"<parameter>--with-zlib</parameter>: This enables support for linking "
"<filename class=\"libraryfile\">libz</filename> into "
"<application>Lynx</application>."
msgstr ""
"<parameter>--with-zlib</parameter>: Isso habilita o suporte para vincular a "
"&quot;<filename class=\"libraryfile\">libz</filename>&quot; no "
"&quot;<application>Lynx</application>&quot;."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/textweb/lynx.xml:138
#, xml-text
msgid ""
"<parameter>--with-bzlib</parameter>: This enables support for linking "
"<filename class=\"libraryfile\">libbz2</filename> into "
"<application>Lynx</application>."
msgstr ""
"<parameter>--with-bzlib</parameter>: Isso habilita o suporte para vincular a"
" &quot;<filename class=\"libraryfile\">libbz2</filename>&quot; no "
"&quot;<application>Lynx</application>&quot;."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/textweb/lynx.xml:144
#, xml-text
msgid ""
"<parameter>--with-ssl</parameter>: This enables support for linking SSL into"
" <application>Lynx</application>."
msgstr ""
"<parameter>--with-ssl</parameter>: Isso habilita o suporte para vincular a "
"&quot;SSL&quot; no &quot;<application>Lynx</application>&quot;."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/textweb/lynx.xml:149
#, xml-text
msgid ""
"<parameter>--with-screen=ncursesw</parameter>: This switch enables the use "
"of advanced wide-character support present in the system "
"<application>NCurses</application> library. This is needed for proper "
"display of characters and line wrapping in multibyte locales."
msgstr ""
"<parameter>--with-screen=ncursesw</parameter>: Essa chave habilita o uso do "
"suporte avançado a caracteres largos presente na biblioteca do sistema "
"&quot;<application>NCurses</application>&quot;. Isso é necessário para a "
"exibição adequada de caracteres e quebra de linha em localidades multi byte."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/textweb/lynx.xml:156
#, xml-text
msgid ""
"<parameter>--enable-locale-charset</parameter>: This switch allows "
"<application>Lynx</application> to deduce the proper character encoding for "
"terminal output from the current locale. A configuration step is still "
"needed (see below), but unlike the situation without this switch, the "
"configuration step becomes the same for all users (without the switch one "
"must specify the display character set explicitly). This is important for "
"environments such as a LiveCD, where the amount of system-specific "
"configuration steps has to be reduced to the minimum."
msgstr ""
"<parameter>--enable-locale-charset</parameter>: Essa chave permite que o "
"&quot;<application>Lynx</application>&quot; deduza a codificação de "
"caracteres adequada para a saída gerada de terminal a partir do local atual."
" Uma etapa de configuração ainda é necessária (veja-se abaixo), mas "
"diferentemente da situação sem essa chave, a etapa de configuração se torna "
"a mesma para todos(as) os(as) usuários(as) (sem a chave é preciso "
"especificar explicitamente o conjunto de caracteres de exibição). Isso é "
"importante para ambientes, como um &quot;LiveCD&quot;, onde a quantidade de "
"etapas específicas de configuração do sistema tem de ser reduzida ao mínimo."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/textweb/lynx.xml:167
#, xml-text
msgid ""
"<option>--enable-ipv6</option>: This switch allows "
"<application>Lynx</application> to use IPv6, along with IPv4.  Use it if "
"your ISP provides an IPv6 configuration."
msgstr ""
"<option>--enable-ipv6</option>: Essa chave permite que o "
"&quot;<application>Lynx</application>&quot; use &quot;IPv6&quot;, juntamente"
" com &quot;IPv4&quot;. Use-a se o teu &quot;ISP&quot; fornecer uma "
"configuração de &quot;IPv6&quot;."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/textweb/lynx.xml:173
#, xml-text
msgid ""
"<option>--enable-nls</option>: This switch allows "
"<application>Lynx</application> to print translated messages (such as "
"questions about cookies and SSL certificates)."
msgstr ""
"<option>--enable-nls</option>: Essa chave permite que o "
"&quot;<application>Lynx</application>&quot; imprima mensagens traduzidas "
"(como perguntas relativas a &quot;cookies&quot; e certificados "
"&quot;SSL&quot;)."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/textweb/lynx.xml:179
#, xml-text
msgid ""
"<option>--with-gnutls</option>: This enables experimental support for "
"linking <application>GnuTLS</application> into "
"<application>Lynx</application>. Remove the <parameter>--with-"
"ssl</parameter> switch if you want to use gnutls."
msgstr ""
"<option>--with-gnutls</option>: Isso habilita o suporte experimental para "
"vincular o &quot;<application>GnuTLS</application>&quot; no "
"&quot;<application>Lynx</application>&quot;. Remova a chave "
"&quot;<parameter>--with-ssl</parameter>&quot; se quiser usar o "
"&quot;GnuTLS&quot;."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/textweb/lynx.xml:186
#, xml-text
msgid ""
"<command>make install-full</command>: In addition to the standard "
"installation, this target installs the documentation and help files."
msgstr ""
"<command>make install-full</command>: Além da instalação padrão, esse alvo "
"instala a documentação e os arquivos de ajuda."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/textweb/lynx.xml:191
#, xml-text
msgid ""
"<command> chgrp -v -R root /usr/share/doc/lynx-&lynx-version;/lynx_doc "
"</command>: This command corrects the improper group ownership of installed "
"documentation files."
msgstr ""
"<command> chgrp -v -R root /usr/share/doc/lynx-&lynx-version;/lynx_doc "
"</command>: Esse comando corrige a propriedade imprópria do grupo dos "
"arquivos de documentação instalados."

#. type: Content of: <sect1><sect2><title>
#: blfs-en/networking/textweb/lynx.xml:214
#, xml-text
msgid "Configuring Lynx"
msgstr "Configurando o Lynx"

#. type: Content of: <sect1><sect2><sect3><title>
#: blfs-en/networking/textweb/lynx.xml:217
#, xml-text
msgid "Config Files"
msgstr "Arquivos de Configuração"

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/networking/textweb/lynx.xml:220
#, xml-text
msgid "<filename>/etc/lynx/lynx.cfg</filename>"
msgstr "<filename>/etc/lynx/lynx.cfg</filename>"

#. type: Content of: <sect1><sect2><sect3><indexterm><primary>
#: blfs-en/networking/textweb/lynx.xml:224
#, xml-text
msgid "/etc/lynx/lynx.cfg"
msgstr "/etc/lynx/lynx.cfg"

#. type: Content of: <sect1><sect2><sect3><title>
#: blfs-en/networking/textweb/lynx.xml:230
#, xml-text
msgid "Configuration Information"
msgstr "Informação de Configuração"

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/networking/textweb/lynx.xml:233
#, xml-text
msgid ""
"The proper way to get the display character set is to examine the current "
"locale. However, <application>Lynx</application> does not do this by "
"default. As the <systemitem class=\"username\">root</systemitem> user, "
"change this setting:"
msgstr ""
"A maneira correta de obter o conjunto de caracteres de exibição é a de "
"examinar a localidade atual. Entretanto, o "
"&quot;<application>Lynx</application>&quot; não faz isso por padrão. Como "
"o(a) usuário(a) &quot;<systemitem "
"class=\"username\">root</systemitem>&quot;, mude essa configuração:"

#. type: Content of: <sect1><sect2><sect3><screen>
#: blfs-en/networking/textweb/lynx.xml:239
#, no-wrap, xml-text
msgid ""
"<userinput>sed -e '/#LOCALE/     a LOCALE_CHARSET:TRUE'     \\\n"
"    -i /etc/lynx/lynx.cfg</userinput>"
msgstr ""
"<userinput>sed -e '/#LOCALE/     a LOCALE_CHARSET:TRUE'    \\\n"
"    -i /etc/lynx/lynx.cfg</userinput>"

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/networking/textweb/lynx.xml:243
#, xml-text
msgid ""
"The built-in editor in <application>Lynx</application> <xref "
"linkend=\"locale-wrong-multibyte-characters\"/>. This issue manifests itself"
" in multibyte locales, e.g., as the Backspace key not erasing non-ASCII "
"characters properly, and as incorrect data being sent to the network when "
"one edits the contents of text areas. The only solution to this problem is "
"to configure <application>Lynx</application> to use an external editor "
"(bound to the <quote>Ctrl+X e</quote> key combination by default). Still as "
"the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"O editor integrado no &quot;<application>Lynx</application>&quot; <xref "
"linkend=\"locale-wrong-multibyte-characters\"/>. Esse problema se manifesta "
"em localidades multi byte, por exemplo, quando a tecla &quot;Backspace&quot;"
" não apaga caracteres não &quot;ASCII&quot; corretamente e quando dados "
"incorretos são enviados para a rede de intercomunicação quando se edita o "
"conteúdo de áreas de texto. A única solução para esse problema é a de "
"configurar o &quot;<application>Lynx</application>&quot; para usar um editor"
" externo (ligado à combinação de teclas <quote>Ctrl+X e</quote> por padrão)."
" Ainda como o(a) usuário(a) &quot;<systemitem "
"class=\"username\">root</systemitem>&quot;:"

#. type: Content of: <sect1><sect2><sect3><screen>
#: blfs-en/networking/textweb/lynx.xml:254
#, no-wrap, xml-text
msgid ""
"<userinput>sed -e '/#DEFAULT_ED/ a DEFAULT_EDITOR:vi'       \\\n"
"    -i /etc/lynx/lynx.cfg</userinput>"
msgstr ""
"<userinput>sed -e '/#DEFAULT_ED/ a DEFAULT_EDITOR:vi'      \\\n"
"    -i /etc/lynx/lynx.cfg</userinput>"

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/networking/textweb/lynx.xml:258
#, xml-text
msgid ""
"<application>Lynx</application> handles the following values of the "
"DEFAULT_EDITOR option specially by adding cursor-positioning arguments: "
"<literal>emacs</literal>, <literal>jed</literal>, <literal>jmacs</literal>, "
"<literal>joe</literal>, <literal>jove</literal>, <literal>jpico</literal>, "
"<literal>jstar</literal>, <literal>nano</literal>, <literal>pico</literal>, "
"<literal>rjoe</literal>, <literal>vi</literal> (but not "
"<literal>vim</literal>: in order to position the cursor in <xref "
"linkend=\"vim\"/>, set this option to <literal>vi</literal>)."
msgstr ""
"<application>Lynx</application> lida com os seguintes valores da opção "
"DEFAULT_EDITOR especialmente adicionando argumentos de posicionamento do "
"cursor: <literal>emacs</literal>, <literal>jed</literal>, "
"<literal>jmacs</literal> , <literal>joe</literal>, <literal>jove</literal>, "
"<literal>jpico</literal>, <literal>jstar</literal>, <literal>nano</literal>,"
" <literal>pico</literal>, <literal>rjoe</literal>, <literal>vi</literal> "
"(mas não <literal>vim</literal>: para a finalidade de posicionar o cursor no"
" <xref linkend=\"vim\"/>, configure essa opção como <literal>vi</literal>)."

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/networking/textweb/lynx.xml:269
#, xml-text
msgid ""
"By default, <application>Lynx</application> doesn't save cookies between "
"sessions. Again as the <systemitem class=\"username\">root</systemitem> "
"user, change this setting:"
msgstr ""
"Por padrão, o &quot;<application>Lynx</application>&quot; não salva "
"&quot;cookies&quot; entre sessões. Novamente como o(a) usuário(a) "
"&quot;<systemitem class=\"username\">root</systemitem>&quot;, mude essa "
"configuração:"

#. type: Content of: <sect1><sect2><sect3><screen>
#: blfs-en/networking/textweb/lynx.xml:274
#, no-wrap, xml-text
msgid ""
"<userinput>sed -e '/#PERSIST/    a PERSISTENT_COOKIES:TRUE' \\\n"
"    -i /etc/lynx/lynx.cfg</userinput>"
msgstr ""
"<userinput>sed -e '/#PERSIST/    a PERSISTENT_COOKIES:TRUE' \\\n"
"   -i /etc/lynx/lynx.cfg</userinput>"

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/networking/textweb/lynx.xml:278
#, xml-text
msgid ""
"Many other system-wide settings such as proxies can also be set in the "
"<filename>/etc/lynx/lynx.cfg</filename> file."
msgstr ""
"Muitas outras configurações abrangentes a todo o sistema, como "
"&quot;proxies&quot;, também conseguem ser configuradas no arquivo "
"&quot;<filename>/etc/lynx/lynx.cfg</filename>&quot;."

