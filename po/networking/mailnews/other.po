#. type: Content of: <sect1><title>
#: blfs-en/networking/mailnews/other.xml:12
#, xml-text
msgid "Other Mail and News Programs"
msgstr "Outros Aplicativos de Mensagem e Notícias"

#. type: Content of: <sect1><para>
#: blfs-en/networking/mailnews/other.xml:31
#, xml-text
msgid "<xref linkend=\"balsa\"/> is a GTK2 based mail client."
msgstr ""
"<xref linkend=\"balsa\"/> é um cliente de mensagem baseado em "
"&quot;GTK2&quot;."

#. type: Content of: <sect1><para>
#: blfs-en/networking/mailnews/other.xml:35
#, xml-text
msgid ""
"<xref linkend=\"seamonkey\"/> includes both a mail client and newsreader in "
"its installation."
msgstr ""
"<xref linkend=\"seamonkey\"/> inclui um cliente de mensagem e um leitor de "
"notícias na instalação dele."

#. type: Content of: <sect1><para>
#: blfs-en/networking/mailnews/other.xml:40
#, xml-text
msgid ""
"<xref linkend=\"thunderbird\"/> is a mail/news client based on the "
"<application>Mozilla</application> code base."
msgstr ""
"<xref linkend=\"thunderbird\"/> é um cliente de mensagem/notícias baseado na"
" base do código do &quot;<application>Mozilla</application>&quot;."

#. type: Content of: <sect1><para>
#: blfs-en/networking/mailnews/other.xml:45
#, xml-text
msgid ""
"<xref linkend=\"evolution\"/> is a mail client and organizer from the "
"<application>GNOME</application> desktop."
msgstr ""
"<xref linkend=\"evolution\"/> é um cliente de mensagens e organizador "
"originário da área de trabalho <application>GNOME</application>."
