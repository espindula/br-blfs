#: blfs-en/networking/mailnews/fetchmail.xml:110
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>./configure --prefix=/usr &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/mailnews/fetchmail.xml:114
#, xml-text
msgid "To test the results, issue: <command>make check</command>."
msgstr "Para testar os resultados, emita: <command>make check</command>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/networking/mailnews/fetchmail.xml:118
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) &quot;<systemitem "
"class=\"username\">root</systemitem>&quot;:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/networking/mailnews/fetchmail.xml:121
#, no-wrap, xml-text
msgid ""
"<userinput>make install &amp;&amp;\n"
"chown -v fetchmail:nogroup /usr/bin/fetchmail</userinput>"
msgstr ""
"<userinput>make install &amp;&amp;\n"
"chown -v fetchmail:nogroup /usr/bin/fetchmail</userinput>"

