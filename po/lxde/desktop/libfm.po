msgstr "Transferência (FTP): <ulink url=\"&libfm-download-ftp;\"/>"

#. type: Content of: <sect1><sect2><itemizedlist><listitem><para>
#: blfs-en/lxde/desktop/libfm.xml:49
msgid "Download MD5 sum: &libfm-md5sum;"
msgstr "Soma de verificação MD5 da transferência: &libfm-md5sum;"

