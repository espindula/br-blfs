msgstr "Tempo de construção estimado: &libfm-time;"

#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/lxde/desktop/libfm.xml:69
msgid "libfm Dependencies"
msgstr "Dependências do libfm"

#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/lxde/desktop/libfm.xml:71
msgid "Required"
msgstr "Exigidas"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/lxde/desktop/libfm.xml:73
msgid ""
"<xref linkend=\"gtk2\"/> or <xref role=\"nodep\" linkend=\"gtk3\"/> (GTK+-2 "
"recommended since LXDE GTK+-3 support is still experimental), and <xref "
"linkend=\"menu-cache\"/>"
msgstr ""
"<xref linkend=\"gtk2\"/> ou <xref role=\"nodep\" linkend=\"gtk3\"/> (GTK+-2 "
"recomendado já que o suporte GTK+-3 do LXDE ainda é experimental) e <xref "
"linkend=\"menu-cache\"/>"

#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/lxde/desktop/libfm.xml:78
msgid "Recommended"
msgstr "Recomendadas"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/lxde/desktop/libfm.xml:80
msgid ""
"<xref linkend=\"libexif\"/>, <xref linkend=\"vala\"/>, and <xref "
"linkend=\"lxmenu-data\"/>"
msgstr ""
"<xref linkend=\"libexif\"/>, <xref linkend=\"vala\"/> e <xref "
"linkend=\"lxmenu-data\"/>"

#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/lxde/desktop/libfm.xml:85
msgid "Optional"
msgstr "Opcionais"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/lxde/desktop/libfm.xml:87
msgid ""
"<xref linkend=\"gtk-doc\"/>, <xref linkend=\"dbus-glib\"/> and <xref "
"linkend=\"gvfs\"/> or <ulink "
"url=\"https://hal.freedesktop.org/releases/\">udisks</ulink> (for volume "
"management - experimental)"
msgstr ""
"<xref linkend=\"gtk-doc\"/>, <xref linkend=\"dbus-glib\"/> e <xref "
"linkend=\"gvfs\"/> ou <ulink "
"url=\"https://hal.freedesktop.org/releases/\">udisks</ulink> (para "
"gerenciamento de volumes - experimental)"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/lxde/desktop/libfm.xml:97
msgid "Installation of libfm"
msgstr "Instalação do libfm"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/lxde/desktop/libfm.xml:100
msgid ""
"Install <application>libfm</application> by running the following commands:"
msgstr ""
"Instale o <application>libfm</application> executando os seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/lxde/desktop/libfm.xml:104
#, no-wrap
msgid ""
"<userinput>./configure --prefix=/usr     \\\n"
"            --sysconfdir=/etc \\\n"
"            --disable-static  &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>./configure --prefix=/usr     \\\n"
"            --sysconfdir=/etc \\\n"
"            --disable-static  &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/lxde/desktop/libfm.xml:110
msgid "To test the results, issue: <command>make check</command>."
msgstr "Para testar os resultados, emita: <command>make check</command>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/lxde/desktop/libfm.xml:114
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/lxde/desktop/libfm.xml:117
#, no-wrap
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/lxde/desktop/libfm.xml:122
msgid "Command Explanations"
msgstr "Explicações dos Comandos"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/lxde/desktop/libfm.xml:125
msgid ""
"<option>--with-gtk=3</option>: This option selects the version of gtk+ to "
"use.  The default is gtk+-2."
msgstr ""
"<option>--with-gtk=3</option>: Essa opção seleciona a versão do gtk+ a usar."
" O padrão é gtk+-2."

