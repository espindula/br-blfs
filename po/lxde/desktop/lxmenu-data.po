#. type: Content of: <sect1><sect2><title>
#: blfs-en/lxde/desktop/lxmenu-data.xml:26
msgid "Introduction to LXMenu Data"
msgstr "Introdução ao LXMenu Data"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/lxde/desktop/lxmenu-data.xml:29
msgid ""
"The <application>LXMenu Data</application> package provides files required "
"to build freedesktop.org menu spec-compliant desktop menus for "
"<application>LXDE</application>."
msgstr ""
"O pacote <application>LXMenu Data</application> fornece os arquivos exigidos"
" para construir menus de área de trabalho compatíveis com as especificações "
"de menu da freedesktop.org para o <application>LXDE</application>."

