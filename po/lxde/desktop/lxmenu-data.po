#. type: Content of: <sect1><sect2><title>
#: blfs-en/lxde/desktop/lxmenu-data.xml:73
msgid "Installation of LXMenu Data"
msgstr "Instalação do LXMenu Data"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/lxde/desktop/lxmenu-data.xml:76
msgid ""
"Install <application>LXMenu Data</application> by running the following "
"commands:"
msgstr ""
"Instale o <application>LXMenu Data</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/lxde/desktop/lxmenu-data.xml:80
#, no-wrap
msgid ""
"<userinput>./configure --prefix=/usr --sysconfdir=/etc &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>./configure --prefix=/usr --sysconfdir=/etc &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/lxde/desktop/lxmenu-data.xml:84
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/lxde/desktop/lxmenu-data.xml:88
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/lxde/desktop/lxmenu-data.xml:91
#, no-wrap
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

