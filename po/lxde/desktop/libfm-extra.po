#. type: Content of: <sect1><sect2><title>
#: blfs-en/lxde/desktop/libfm-extra.xml:92
msgid "Installation of libfm-extra"
msgstr "Instalação do libfm-extra"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/lxde/desktop/libfm-extra.xml:95
msgid ""
"Install <application>libfm-extra</application> by running the following "
"commands:"
msgstr ""
"Instale o <application>libfm-extra</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/lxde/desktop/libfm-extra.xml:99
#, no-wrap
msgid ""
"<userinput>./configure --prefix=/usr     \\\n"
"            --sysconfdir=/etc \\\n"
"            --with-extra-only \\\n"
"            --with-gtk=no     \\\n"
"            --disable-static  &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>./configure --prefix=/usr     \\\n"
"            --sysconfdir=/etc \\\n"
"            --with-extra-only \\\n"
"            --with-gtk=no     \\\n"
"            --disable-static  &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/lxde/desktop/libfm-extra.xml:107
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/lxde/desktop/libfm-extra.xml:111
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/lxde/desktop/libfm-extra.xml:114
#, no-wrap
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/lxde/desktop/libfm-extra.xml:119
msgid "Command Explanations"
msgstr "Explicações dos Comandos"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/lxde/desktop/libfm-extra.xml:122
msgid ""
"<parameter>--with-extra-only</parameter>: This switch disables all "
"components except for the libfm-extra library."
msgstr ""
"<parameter>--with-extra-only</parameter>: Essa chave desabilita todos os "
"componentes, exceto a biblioteca libfm-extra."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/lxde/desktop/libfm-extra.xml:127
msgid ""
"<parameter>--with-gtk=no</parameter>: This switch disables support for "
"<application>GTK+</application> because it is not necessary for this "
"package."
msgstr ""
"<parameter>--with-gtk=no</parameter>: Essa chave desabilita o suporte para "
"<application>GTK+</application> porque ele não é necessário para esse "
"pacote."

