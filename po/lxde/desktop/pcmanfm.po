#. type: Content of: <sect1><sect2><title>
#: blfs-en/lxde/desktop/pcmanfm.xml:26
msgid "Introduction to PCManFM"
msgstr "Introdução ao PCManFM"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/lxde/desktop/pcmanfm.xml:29
msgid ""
"The <application>PCManFM</application> package contains an extremely fast, "
"lightweight, yet feature-rich file manager with tabbed browsing."
msgstr ""
"O pacote <application>PCManFM</application> contém um gerenciador de "
"arquivos extremamente rápido, leve, mas rico em recursos, com navegação por "
"guias."

