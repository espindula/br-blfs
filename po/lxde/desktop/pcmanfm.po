#: blfs-en/lxde/desktop/pcmanfm.xml:71
msgid "Required"
msgstr "Exigidas"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/lxde/desktop/pcmanfm.xml:73
msgid "<xref linkend=\"libfm\"/>"
msgstr "<xref linkend=\"libfm\"/>"

#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/lxde/desktop/pcmanfm.xml:76
msgid "Recommended"
msgstr "Recomendadas"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/lxde/desktop/pcmanfm.xml:78
msgid ""
"<xref linkend=\"adwaita-icon-theme\"/> or <xref role=\"nodep\" "
"linkend=\"oxygen-icons5\"/> or <xref linkend=\"lxde-icon-theme\"/>, and "
"<xref linkend=\"fribidi\"/>"
msgstr ""
"<xref linkend=\"adwaita-icon-theme\"/> ou <xref role=\"nodep\" "
"linkend=\"oxygen-icons5\"/> ou <xref linkend=\"lxde-icon-theme\"/> e <xref "
"linkend=\"fribidi\"/>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/lxde/desktop/pcmanfm.xml:87
msgid "Installation of PCManFM"
msgstr "Instalação do PCManFM"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/lxde/desktop/pcmanfm.xml:90
msgid ""
"Install <application>PCManFM</application> by running the following "
"commands:"
msgstr ""
"Instale o <application>PCManFM</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/lxde/desktop/pcmanfm.xml:94
#, no-wrap
msgid ""
"<userinput>./configure --prefix=/usr     \\\n"
"            --sysconfdir=/etc &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>./configure --prefix=/usr     \\\n"
"            --sysconfdir=/etc &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/lxde/desktop/pcmanfm.xml:99
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/lxde/desktop/pcmanfm.xml:103
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/lxde/desktop/pcmanfm.xml:106
#, no-wrap
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/lxde/desktop/pcmanfm.xml:111
msgid "Command Explanations"
msgstr "Explicações dos Comandos"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/lxde/desktop/pcmanfm.xml:114
msgid ""
"<option>--with-gtk=3</option>: Selects the version of GTK+ to use.  You must"
" use this switch if you have built <xref linkend=\"libfm\"/> with GTK+3 "
"support."
msgstr ""
"<option>--with-gtk=3</option>: Seleciona a versão do GTK+ a usar. Você "
"precisa usar essa chave se tiver construído <xref linkend=\"libfm\"/> com "
"suporte GTK+3."

