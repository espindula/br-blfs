#. type: Content of: <sect1><sect2><title>
#: blfs-en/lxde/desktop/libwnck2.xml:92
msgid "Installation of libwnck"
msgstr "Instalação do libwnck"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/lxde/desktop/libwnck2.xml:95
msgid ""
"Install <application>libwnck</application> by running the following "
"commands:"
msgstr ""
"Instale o <application>libwnck</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/lxde/desktop/libwnck2.xml:99
#, no-wrap
msgid ""
"<userinput>./configure --prefix=/usr \\\n"
"            --disable-static \\\n"
"            --program-suffix=-1 &amp;&amp;\n"
"make GETTEXT_PACKAGE=libwnck-1</userinput>"
msgstr ""
"<userinput>./configure --prefix=/usr \\\n"
"            --disable-static \\\n"
"            --program-suffix=-1 &amp;&amp;\n"
"make GETTEXT_PACKAGE=libwnck-1</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/lxde/desktop/libwnck2.xml:105
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/lxde/desktop/libwnck2.xml:109
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/lxde/desktop/libwnck2.xml:112
#, no-wrap
msgid "<userinput>make GETTEXT_PACKAGE=libwnck-1 install</userinput>"
msgstr "<userinput>make GETTEXT_PACKAGE=libwnck-1 install</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/lxde/desktop/libwnck2.xml:117
msgid "Command Explanations"
msgstr "Explicações dos Comandos"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/lxde/desktop/libwnck2.xml:123
msgid ""
"<parameter>--program-suffix=-1</parameter>: This option adds -1 to the end "
"of the names of the installed programs to avoid overwriting the programs "
"installed by <xref linkend=\"libwnck\"/>."
msgstr ""
"<parameter>--program-suffix=-1</parameter>: Essa opção adiciona -1 ao final "
"dos nomes dos aplicativos instalados para evitar sobrescrever os aplicativos"
" instalados por <xref linkend=\"libwnck\"/>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/lxde/desktop/libwnck2.xml:129
msgid ""
"<parameter>GETTEXT_PACKAGE=libwnck-1</parameter>: This parameter adds -1 to "
"the end of the names of the gettext files installed by the package to avoid "
"overwriting the files installed by <xref linkend=\"libwnck\"/>."
msgstr ""
"<parameter>GETTEXT_PACKAGE=libwnck-1</parameter>: Esse parâmetro adiciona -1"
" ao final dos nomes dos arquivos gettext instalados pelo pacote para evitar "
"sobrescrever os arquivos instalados por <xref linkend=\"libwnck\"/>."

