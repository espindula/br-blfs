#. type: Content of: <sect1><sect2><title>
#: blfs-en/lxde/desktop/lxappearance.xml:26
msgid "Introduction to LXAppearance"
msgstr "Introdução ao LXAppearance"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/lxde/desktop/lxappearance.xml:29
msgid ""
"The <application>LXAppearance</application> package contains a desktop-"
"independent theme switcher for <application>GTK+</application>."
msgstr ""
"O pacote <application>LXAppearance</application> contém um comutador de tema"
" independente de área de trabalho para <application>GTK+</application>."

