#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/lxde/desktop/lxsession.xml:69
msgid "LXSession Dependencies"
msgstr "Dependências do LXSession"

#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/lxde/desktop/lxsession.xml:71
msgid "Required"
msgstr "Exigidas"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/lxde/desktop/lxsession.xml:73
msgid ""
"<xref linkend=\"dbus-glib\"/>, <xref linkend=\"libunique\"/>, <xref "
"linkend=\"polkit\"/>, and <xref linkend=\"vala\"/>"
msgstr ""
"<xref linkend=\"dbus-glib\"/>, <xref linkend=\"libunique\"/>, <xref "
"linkend=\"polkit\"/> e <xref linkend=\"vala\"/>"

#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/lxde/desktop/lxsession.xml:79
msgid "Optional"
msgstr "Opcionais"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/lxde/desktop/lxsession.xml:81
msgid ""
"<xref role=\"runtime\" linkend=\"lsb-tools\"/> (may be used at runtime to "
"display the distribution release in the logout dialog), <xref "
"linkend=\"gtk3\"/>, and <xref linkend=\"libxslt\"/> with <xref "
"linkend=\"DocBook\"/> and <xref linkend=\"docbook-xsl\"/> (to build man "
"pages)"
msgstr ""
"<xref role=\"runtime\" linkend=\"lsb-tools\"/> (pode ser usado em tempo de "
"execução para exibir o lançamento da distribuição na caixa de diálogo de "
"logout), <xref linkend=\"gtk3\"/> e <xref linkend=\"libxslt\"/> com <xref "
"linkend=\"DocBook\"/> e <xref linkend=\"docbook-xsl\"/> (para construir "
"páginas de manual)"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/lxde/desktop/lxsession.xml:92
msgid "Installation of LXSession"
msgstr "Instalação do LXSession"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/lxde/desktop/lxsession.xml:95
msgid ""
"Install <application>LXSession</application> by running the following "
"commands:"
msgstr ""
"Instale o <application>LXSession</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/lxde/desktop/lxsession.xml:99
#, no-wrap
msgid ""
"<userinput>./configure --prefix=/usr --disable-man &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>./configure --prefix=/usr --disable-man &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/lxde/desktop/lxsession.xml:103
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/lxde/desktop/lxsession.xml:107
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/lxde/desktop/lxsession.xml:110
#, no-wrap
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/lxde/desktop/lxsession.xml:115
msgid "Command Explanations"
msgstr "Explicações dos Comandos"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/lxde/desktop/lxsession.xml:118
msgid ""
"<parameter>--disable-man</parameter>: This switch disables building of the "
"manual pages. Remove it if you have installed optional dependencies and wish"
" to build the manual pages."
msgstr ""
"<parameter>--disable-man</parameter>: Essa chave desabilita a construção das"
" páginas de manual. Remova-a se você tiver instalado dependências opcionais "
"e desejar construir as páginas de manual."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/lxde/desktop/lxsession.xml:124
msgid ""
"<option>--enable-gtk3</option>: Builds against <application>GTK+-3 "
"</application> instead of <application>GTK+-2</application>, which is "
"required anyway by <application>libunique</application>."
msgstr ""
"<option>--enable-gtk3</option>: Constrói contra o <application>GTK+-3 "
"</application> em vez de <application>GTK+-2</application>, o que é exigido "
"de qualquer maneira pela <application>libunique</application>."

