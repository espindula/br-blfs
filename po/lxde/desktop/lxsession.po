#. type: Content of: <sect1><sect2><para>
#: blfs-en/lxde/desktop/lxsession.xml:29
msgid ""
"The <application>LXSession</application> package contains the default "
"session manager for <application>LXDE</application>."
msgstr ""
"O pacote <application>LXSession</application> contém o gerenciador padrão de"
" sessão para o <application>LXDE</application>."

