#: blfs-en/lxde/apps/lxtask.xml:91
msgid "Installation of LXTask"
msgstr "Instalação do LXTask"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/lxde/apps/lxtask.xml:103
msgid ""
"Install <application>LXTask</application> by running the following commands:"
msgstr ""
"Instale o <application>LXTask</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/lxde/apps/lxtask.xml:107
#, no-wrap
msgid ""
"<userinput>./configure --prefix=/usr &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>./configure --prefix=/usr &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/lxde/apps/lxtask.xml:111
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/lxde/apps/lxtask.xml:115
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr "Agora, como o(a) usante <systemitem class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/lxde/apps/lxtask.xml:118
#, no-wrap
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

