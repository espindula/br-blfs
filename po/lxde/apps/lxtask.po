#. type: Content of: <sect1><sect2><para>
#: blfs-en/lxde/apps/lxtask.xml:29
msgid ""
"The <application>LXTask</application> package contains a lightweight and "
"desktop-independent task manager."
msgstr ""
"O pacote <application>LXTask</application> contém um gerenciador de tarefas "
"leve e independente da área de trabalho."

