#. type: Content of: <sect1><sect2><title>
#: blfs-en/lxde/apps/gpicview.xml:79
msgid "Installation of GPicView"
msgstr "Instalação do GPicView"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/lxde/apps/gpicview.xml:82
msgid ""
"Install <application>GPicView</application> by running the following "
"commands:"
msgstr ""
"Instale o <application>GPicView</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/lxde/apps/gpicview.xml:86
#, no-wrap
msgid ""
"<userinput>./configure --prefix=/usr &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>./configure --prefix=/usr &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/lxde/apps/gpicview.xml:90
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/lxde/apps/gpicview.xml:94
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/lxde/apps/gpicview.xml:97
#, no-wrap
msgid ""
"<userinput>make install &amp;&amp;\n"
"sed -i 's/Utility;//' /usr/share/applications/gpicview.desktop</userinput>"
msgstr ""
"<userinput>make install &amp;&amp;\n"
"sed -i 's/Utility;//' /usr/share/applications/gpicview.desktop</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/lxde/apps/gpicview.xml:101
msgid ""
"If you have <xref linkend=\"xdg-utils\"/> installed, as the <systemitem "
"class=\"username\">root</systemitem> user, you should run the <command>xdg-"
"icon-resource forceupdate --theme hicolor</command> command, for the "
"installed icon to be displayed in the menu item."
msgstr ""
"Se tiver o <xref linkend=\"xdg-utils\"/> instalado, como o(a) usuário(a) "
"<systemitem class=\"username\">root</systemitem>, você deveria executar o "
"comando <command>xdg-icon-resource forceupdate --theme hicolor</command>, "
"para que o ícone instalado seja exibido no item de menu."

#. type: Content of: <sect1><sect2><title>
#: blfs-en/lxde/apps/gpicview.xml:110
msgid "Command Explanations"
msgstr "Explicações dos Comandos"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/lxde/apps/gpicview.xml:113
msgid ""
"<command>sed -i ...</command>: Fixes submenu for "
"<application>GPicView</application>."
msgstr ""
"<command>sed -i ...</command>: Corrige o submenu para o "
"<application>GPicView</application>."

