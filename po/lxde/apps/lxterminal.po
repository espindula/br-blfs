#. type: Content of: <sect1><sect2><title>
#: blfs-en/lxde/apps/lxterminal.xml:26
msgid "Introduction to LXTerminal"
msgstr "Introdução ao LXTerminal"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/lxde/apps/lxterminal.xml:29
msgid ""
"The <application>LXTerminal</application> package contains a VTE-based "
"terminal emulator for <application>LXDE</application> with support for "
"multiple tabs."
msgstr ""
"O pacote <application>LXTerminal</application> contém um emulador de "
"terminal baseado em VTE para o <application>LXDE</application> com suporte "
"para múltiplas guias."

