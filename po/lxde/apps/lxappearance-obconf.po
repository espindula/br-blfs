#. type: Content of: <sect1><sect2><para>
#: blfs-en/lxde/apps/lxappearance-obconf.xml:29
msgid ""
"The <application>LXAppearance OBconf</application> package contains a plugin"
" for <application>LXAppearance</application> to configure "
"<application>OpenBox</application>."
msgstr ""
"O pacote <application>LXAppearance OBconf</application> contém um plugin "
"para o <application>LXAppearance</application> para configurar o "
"<application>OpenBox</application>."

