#. type: Content of: <sect1><sect2><title>
#: blfs-en/lxde/apps/lxappearance-obconf.xml:81
msgid "Installation of LXAppearance OBconf"
msgstr "Instalação do LXAppearance OBconf"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/lxde/apps/lxappearance-obconf.xml:84
msgid ""
"Install <application>LXAppearance OBconf</application> by running the "
"following commands:"
msgstr ""
"Instale o <application>LXAppearance OBconf</application> executando os "
"seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/lxde/apps/lxappearance-obconf.xml:88
#, no-wrap
msgid ""
"<userinput>./configure --prefix=/usr --disable-static &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>./configure --prefix=/usr --disable-static &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/lxde/apps/lxappearance-obconf.xml:92
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/lxde/apps/lxappearance-obconf.xml:96
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/lxde/apps/lxappearance-obconf.xml:99
#, no-wrap
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

