#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/lxde/apps/lxrandr.xml:69
msgid "LXRandR Dependencies"
msgstr "Dependências do LXRandR"

#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/lxde/apps/lxrandr.xml:71
msgid "Required"
msgstr "Exigidas"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/lxde/apps/lxrandr.xml:73
msgid "<xref linkend=\"gtk2\"/> and <xref linkend=\"xorg7-app\"/>"
msgstr "<xref linkend=\"gtk2\"/> e <xref linkend=\"xorg7-app\"/>"

#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/lxde/apps/lxrandr.xml:77
msgid "Optional"
msgstr "Opcionais"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/lxde/apps/lxrandr.xml:79
msgid ""
"<xref linkend=\"libxslt\"/> with <xref linkend=\"DocBook\"/> and <xref "
"linkend=\"docbook-xsl\"/> (to build man pages)"
msgstr ""
"<xref linkend=\"libxslt\"/> com <xref linkend=\"DocBook\"/> e <xref "
"linkend=\"docbook-xsl\"/> (para construir páginas de manual)"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/lxde/apps/lxrandr.xml:87
msgid "Installation of LXRandR"
msgstr "Instalação do LXRandR"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/lxde/apps/lxrandr.xml:90
msgid ""
"Install <application>LXRandR</application> by running the following "
"commands:"
msgstr ""
"Instale o <application>LXRandR</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/lxde/apps/lxrandr.xml:94
#, no-wrap
msgid ""
"<userinput>./configure --prefix=/usr &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>./configure --prefix=/usr &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/lxde/apps/lxrandr.xml:98
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/lxde/apps/lxrandr.xml:102
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr "Agora, como o(a) usante <systemitem class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/lxde/apps/lxrandr.xml:105
#, no-wrap
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/lxde/apps/lxrandr.xml:110
msgid "Command Explanations"
msgstr "Explicações dos Comandos"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/lxde/apps/lxrandr.xml:113
msgid ""
"<option>--enable-man</option>: Use this switch if you have installed "
"optional dependencies and wish to build the manual pages."
msgstr ""
"<option>--enable-man</option>: Use essa chave se você tiver instalado "
"dependências opcionais e desejar construir as páginas de manual."

