#. type: Content of: <sect1><sect2><title>
#: blfs-en/lxde/apps/lxrandr.xml:26
msgid "Introduction to LXRandR"
msgstr "Introdução ao LXRandR"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/lxde/apps/lxrandr.xml:29
msgid ""
"The <application>LXRandR</application> package contains a monitor "
"configuration tool for <application>LXDE</application>."
msgstr ""
"O pacote <application>LXRandR</application> contém uma ferramenta de "
"configuração de monitor para o <application>LXDE</application>."

