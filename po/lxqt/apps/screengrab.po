#. type: Content of: <sect1><sect2><title>
#: blfs-en/lxqt/apps/screengrab.xml:80
#, xml-text
msgid "Installation of screengrab"
msgstr "Instalação do screengrab"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/lxqt/apps/screengrab.xml:83
#, xml-text
msgid ""
"Install <application>screengrab</application> by running the following "
"commands:"
msgstr ""
"Instale o <application>screengrab</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/lxqt/apps/screengrab.xml:87
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_BUILD_TYPE=Release  \\\n"
"      -D CMAKE_INSTALL_PREFIX=/usr \\\n"
"      ..                           &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_BUILD_TYPE=Release  \\\n"
"      -D CMAKE_INSTALL_PREFIX=/usr \\\n"
"      ..                           &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/lxqt/apps/screengrab.xml:96
#, xml-text
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/lxqt/apps/screengrab.xml:100
#, xml-text
msgid "Now, as the &root; user:"
msgstr "Agora, como o(a) usuário(a) &root;:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/lxqt/apps/screengrab.xml:103
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/lxqt/apps/screengrab.xml:106
#, xml-text
msgid ""
"If you have <xref linkend=\"xdg-utils\"/> installed, as the &root; user, run"
" <command>xdg-icon-resource forceupdate --theme hicolor</command>."
msgstr ""
"Se você tiver o <xref linkend=\"xdg-utils\"/> instalado, como o(a) "
"usuário(a) &root;, execute <command>xdg-icon-resource forceupdate --theme "
"hicolor</command>."

