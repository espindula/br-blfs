#. type: Content of: <sect1><sect2><title>
#: blfs-en/lxqt/apps/qps.xml:79
#, xml-text
msgid "Installation of qps"
msgstr "Instalação do qps"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/lxqt/apps/qps.xml:82
#, xml-text
msgid ""
"Install <application>qps</application> by running the following commands:"
msgstr ""
"Instale o <application>qps</application> executando os seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/lxqt/apps/qps.xml:86
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_BUILD_TYPE=Release  \\\n"
"      -D CMAKE_INSTALL_PREFIX=/usr \\\n"
"      ..                           &amp;&amp;\n"
"\n"
"make</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_BUILD_TYPE=Release  \\\n"
"      -D CMAKE_INSTALL_PREFIX=/usr \\\n"
"      ..                           &amp;&amp;\n"
"\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/lxqt/apps/qps.xml:96
#, xml-text
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/lxqt/apps/qps.xml:100
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/lxqt/apps/qps.xml:103
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/lxqt/apps/qps.xml:106
#, xml-text
msgid ""
"If you have <xref linkend=\"xdg-utils\"/> installed, as the &root; user, run"
" <command>xdg-icon-resource forceupdate --theme hicolor</command>."
msgstr ""
"Se você tiver o <xref linkend=\"xdg-utils\"/> instalado, como o(a) "
"usuário(a) &root;, execute <command>xdg-icon-resource forceupdate --theme "
"hicolor</command>."

