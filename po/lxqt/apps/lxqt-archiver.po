#. type: Content of: <sect1><sect2><para>
#: blfs-en/lxqt/apps/lxqt-archiver.xml:29
#, xml-text
msgid ""
"The <application>lxqt-archiver</application> package is a simple and "
"lightweight desktop-agnostic Qt file archiver."
msgstr ""
"O pacote <application>lxqt-archiver</application> é um arquivador Qt de "
"arquivos simples e leve, independente de área de trabalho."

