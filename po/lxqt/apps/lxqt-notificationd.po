#: blfs-en/lxqt/apps/lxqt-notificationd.xml:79
#, xml-text
msgid "Installation of lxqt-notificationd"
msgstr "Instalação do lxqt-notificationd"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/lxqt/apps/lxqt-notificationd.xml:82
#, xml-text
msgid ""
"Install <application>lxqt-notificationd</application> by running the "
"following commands:"
msgstr ""
"Instale o <application>lxqt-notificationd</application> executando os "
"seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/lxqt/apps/lxqt-notificationd.xml:86
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_BUILD_TYPE=Release  \\\n"
"      -D CMAKE_INSTALL_PREFIX=/usr \\\n"
"      ..                           &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_BUILD_TYPE=Release  \\\n"
"      -D CMAKE_INSTALL_PREFIX=/usr \\\n"
"      ..                           &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/lxqt/apps/lxqt-notificationd.xml:95
#, xml-text
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/lxqt/apps/lxqt-notificationd.xml:99
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/lxqt/apps/lxqt-notificationd.xml:102
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

