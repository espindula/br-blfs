#, xml-text
msgid "Installation of lxqt-wayland-session"
msgstr "Instalação do lxqt-wayland-session"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/lxqt/desktop/lxqt-wayland-session.xml:84
#, xml-text
msgid ""
"Install <application>lxqt-wayland-session</application> by running the "
"following commands:"
msgstr ""
"Instale <application>lxqt-wayland-session</application> executando os "
"seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/lxqt/desktop/lxqt-wayland-session.xml:88
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr \\\n"
"      -D CMAKE_BUILD_TYPE=Release  \\\n"
"      ..                           &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr \\\n"
"      -D CMAKE_BUILD_TYPE=Release  \\\n"
"      ..                           &amp;&amp;\n"
"make</userinput>"

