#. type: Content of: <sect1><sect2><para>
#: blfs-en/lxqt/desktop/pcmanfm-qt.xml:28
#, xml-text
msgid ""
"The <application>pcmanfm-qt</application> is a file manager and desktop icon"
" manager (a <application>Qt</application> port of "
"<application>pcmanfm</application> and <application>libfm</application>)."
msgstr ""
"O <application>pcmanfm-qt</application> é um gerenciador de arquivos e "
"gerenciador de ícones da área de trabalho (uma porta "
"<application>Qt</application> do <application>pcmanfm</application> e "
"<application>libfm</application>)."

