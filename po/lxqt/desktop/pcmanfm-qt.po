#. type: Content of: <sect1><sect2><title>
#: blfs-en/lxqt/desktop/pcmanfm-qt.xml:89
#, xml-text
msgid "Installation of pcmanfm-qt"
msgstr "Instalação do pcmanfm-qt"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/lxqt/desktop/pcmanfm-qt.xml:92
#, xml-text
msgid ""
"If libLayerShellQtInterface.so is installed in /opt, help this package find "
"it.  As the &root; user:"
msgstr ""
"Se libLayerShellQtInterface.so for instalado em /opt, ajude esse pacote a "
"encontrá-lo. Como o(a) usuário(a) &root;:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/lxqt/desktop/pcmanfm-qt.xml:96
#, no-wrap, xml-text
msgid ""
"<userinput>if [   -e /opt/kf6/lib/libLayerShellQtInterface.so -a \\\n"
"     ! -e /usr/lib/libLayerShellQtInterface.so ]; then\n"
"\n"
"    ln -sv /opt/kf6/lib/libLayerShellQtInterface.so \\\n"
"           /usr/lib/libLayerShellQtInterface.so\n"
"fi</userinput>"
msgstr ""
"<userinput>if [   -e /opt/kf6/lib/libLayerShellQtInterface.so -a \\\n"
"     ! -e /usr/lib/libLayerShellQtInterface.so ]; then\n"
"\n"
"    ln -sv /opt/kf6/lib/libLayerShellQtInterface.so \\\n"
"           /usr/lib/libLayerShellQtInterface.so\n"
"fi</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/lxqt/desktop/pcmanfm-qt.xml:104
#, xml-text
msgid ""
"Install <application>pcmanfm-qt</application> by running the following "
"commands:"
msgstr ""
"Instale o <application>pcmanfm-qt</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/lxqt/desktop/pcmanfm-qt.xml:108
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr \\\n"
"      -D CMAKE_BUILD_TYPE=Release  \\\n"
"      ..                           &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr \\\n"
"      -D CMAKE_BUILD_TYPE=Release  \\\n"
"      ..                           &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/lxqt/desktop/pcmanfm-qt.xml:117
#, xml-text
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/lxqt/desktop/pcmanfm-qt.xml:121
#, xml-text
msgid "Now, as the &root; user:"
msgstr "Agora, como o(a) usuário(a) &root;:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/lxqt/desktop/pcmanfm-qt.xml:124
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/lxqt/desktop/pcmanfm-qt.xml:127
#, xml-text
msgid ""
"To make <application>pcmanfm-qt</application> easier to find in menus, "
"adjust the .desktop file. Again, as the &root; user:"
msgstr ""
"Para facilitar a localização do <application>pcmanfm-qt</application> nos "
"menus, ajuste o arquivo .desktop. Novamente, como o(a) usuário(a) &root;:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/lxqt/desktop/pcmanfm-qt.xml:131
#, no-wrap, xml-text
msgid ""
"<userinput>sed -e '/Categories=/s/=/=System;FileTools;/' \\\n"
"    -e '/Name=/s/=.*/=File Manager PCManFM-Qt'/ \\\n"
"    -i /usr/share/applications/pcmanfm-qt.desktop</userinput>"
msgstr ""
"<userinput>sed -e '/Categories=/s/=/=System;FileTools;/' \\\n"
"    -e '/Name=/s/=.*/=Gerenciador de Arquivos PCManFM-Qt'/ \\\n"
"    -i /usr/share/applications/pcmanfm-qt.desktop</userinput>"

