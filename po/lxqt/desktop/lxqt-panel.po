msgstr "Dependências do lxqt-panel"

#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/lxqt/desktop/lxqt-panel.xml:71
#, xml-text
msgid "Required"
msgstr "Exigidas"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/lxqt/desktop/lxqt-panel.xml:73
#, xml-text
msgid ""
"<xref linkend=\"lxqt-layer-shell-qt\"/>, <xref linkend=\"libdbusmenu-"
"lxqt\"/>, <xref linkend=\"liblxqt\"/>, <xref linkend=\"lxqt-globalkeys\"/>, "
"<xref linkend=\"lxqt-menu-data\"/>, <xref linkend=\"lxqt-solid\"/>, and "
"<xref linkend=\"menu-cache\"/>"
msgstr ""
"<xref linkend=\"lxqt-layer-shell-qt\"/>, <xref linkend=\"libdbusmenu-"
"lxqt\"/>, <xref linkend=\"liblxqt\"/>, <xref linkend=\"lxqt-globalkeys\"/>, "
"<xref linkend=\"lxqt-menu-data\"/>, <xref linkend=\"lxqt-solid\"/> e <xref "
"linkend=\"menu-cache\"/>"

#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/lxqt/desktop/lxqt-panel.xml:87
#, xml-text
msgid "Recommended"
msgstr "Recomendadas"

#. <xref linkend="alsa-lib"/>
#.  or
#.  (volume plugin; see Command Explanations below
#.          if not present)
#. type: Content of: <sect1><sect2><para>
#: blfs-en/lxqt/desktop/lxqt-panel.xml:90
#, xml-text
msgid ""
"<xref linkend=\"pulseaudio\"/>, <xref linkend=\"libstatgrab\"/> (network "
"monitor and CPU load plugins), <xref linkend=\"libsysstat\"/> (CPU and "
"network monitor plugins), <xref linkend=\"libxkbcommon\"/> (keyboard "
"indicator plugin), and <xref linkend=\"lm_sensors\"/> (sensors plugin)"
msgstr ""
"<xref linkend=\"pulseaudio\"/>, <xref linkend=\"libstatgrab\"/> (monitor de "
"rede de intercomunicação e plugins de carga da CPU), <xref "
"linkend=\"libsysstat\"/> (plugins monitores de CPU e de rede de "
"intercomunicação), <xref linkend=\"libxkbcommon\"/> (plugin indicador de "
"teclado) e <xref linkend=\"lm_sensors\"/> (plugin de sensores)"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/lxqt/desktop/lxqt-panel.xml:101
#, xml-text
msgid "Installation of lxqt-panel"
msgstr "Instalação do lxqt-panel"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/lxqt/desktop/lxqt-panel.xml:114
#, xml-text
msgid ""
"Install <application>lxqt-panel</application> by running the following "
"commands:"
msgstr ""
"Instale o <application>lxqt-panel</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/lxqt/desktop/lxqt-panel.xml:118
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr \\\n"
"      -D CMAKE_BUILD_TYPE=Release  \\\n"
"      ..                           &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr \\\n"
"      -D CMAKE_BUILD_TYPE=Release  \\\n"
"      ..                           &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/lxqt/desktop/lxqt-panel.xml:127
#, xml-text
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/lxqt/desktop/lxqt-panel.xml:131
#, xml-text
msgid "Now, as the &root; user:"
msgstr "Agora, como o(a) usuário(a) &root;:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/lxqt/desktop/lxqt-panel.xml:134
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

