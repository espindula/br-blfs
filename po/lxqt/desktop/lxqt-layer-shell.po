#. type: Content of: <sect1><sect2><para>
#: blfs-en/lxqt/desktop/lxqt-layer-shell.xml:94
#, xml-text
msgid ""
"Install <application>layer-shell-qt</application> by running the following "
"commands:"
msgstr ""
"Instale <application>layer-shell-qt</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/lxqt/desktop/lxqt-layer-shell.xml:98
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr \\\n"
"      -D CMAKE_BUILD_TYPE=Release  \\\n"
"      -W no-author ..              &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr \\\n"
"      -D CMAKE_BUILD_TYPE=Release  \\\n"
"      -W no-author ..              &amp;&amp;\n"
"make</userinput>"

