#. type: Content of: <sect1><sect2><para>
#: blfs-en/lxqt/desktop/lxqt-runner.xml:29
#, xml-text
msgid ""
"The <application>lxqt-runner</application> package provides a tool used to "
"launch programs quickly by typing their names."
msgstr ""
"O pacote <application>lxqt-runner</application> fornece uma ferramenta usada"
" para iniciar aplicativos rapidamente, digitando-se os nomes deles."

