#. type: Content of: <sect1><sect2><title>
#: blfs-en/lxqt/desktop/lxqt-runner.xml:81
#, xml-text
msgid "Installation of lxqt-runner"
msgstr "Instalação do lxqt-runner"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/lxqt/desktop/lxqt-runner.xml:84
#, xml-text
msgid ""
"Install <application>lxqt-runner</application> by running the following "
"commands:"
msgstr ""
"Instale o <application>lxqt-runner</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/lxqt/desktop/lxqt-runner.xml:88
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr \\\n"
"      -D CMAKE_BUILD_TYPE=Release  \\\n"
"      ..                           &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr \\\n"
"      -D CMAKE_BUILD_TYPE=Release  \\\n"
"      ..                           &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/lxqt/desktop/lxqt-runner.xml:97
#, xml-text
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/lxqt/desktop/lxqt-runner.xml:101
#, xml-text
msgid "Now, as the &root; user:"
msgstr "Agora, como o(a) usuário(a) &root;:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/lxqt/desktop/lxqt-runner.xml:104
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/lxqt/desktop/lxqt-runner.xml:109
#, xml-text
msgid "Using lxqt-runner"
msgstr "Usando o lxqt-runner"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/lxqt/desktop/lxqt-runner.xml:112
#, xml-text
msgid ""
"To use <application>lxqt-runner</application>, simultaneously press the "
"Alt-F2 keys. A dialog window appears in the top center of the screen.  When "
"you start typing a command, a list of possible matches appears and changes "
"as you keep typing."
msgstr ""
"Para usar o <application>lxqt-runner</application>, pressione "
"simultaneamente as teclas Alt-F2. Uma janela de diálogo aparece na parte "
"superior central da tela. Quando você começa a digitar um comando, uma lista"
" de possíveis correspondências aparece e muda conforme você continua "
"digitando."

