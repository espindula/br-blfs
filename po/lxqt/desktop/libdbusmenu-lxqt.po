#. type: Content of: <sect1><sect2><title>
#: blfs-en/lxqt/desktop/libdbusmenu-lxqt.xml:86
#, xml-text
msgid "Installation of libdbusmenu-lxqt"
msgstr "Instalação do libdbusmenu-lxqt"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/lxqt/desktop/libdbusmenu-lxqt.xml:89
#, xml-text
msgid ""
"Install <application>libdbusmenu-lxqt</application> by running the following"
" commands:"
msgstr ""
"Instale <application>libdbusmenu-lxqt</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/lxqt/desktop/libdbusmenu-lxqt.xml:93
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr \\\n"
"      -D CMAKE_BUILD_TYPE=Release  \\\n"
"      -W no-dev ..                 &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr \\\n"
"      -D CMAKE_BUILD_TYPE=Release  \\\n"
"      -W no-dev ..                 &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/lxqt/desktop/libdbusmenu-lxqt.xml:102
#, xml-text
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/lxqt/desktop/libdbusmenu-lxqt.xml:106
#, xml-text
msgid "Now, as the &root; user:"
msgstr "Agora, como o(a) usuário(a) &root;:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/lxqt/desktop/libdbusmenu-lxqt.xml:109
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

