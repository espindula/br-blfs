#. type: Content of: <sect1><sect2><title>
#: blfs-en/lxqt/desktop/xdg-desktop-portal-lxqt.xml:81
#, xml-text
msgid "Installation of xdg-desktop-portal-lxqt"
msgstr "Instalação do xdg-desktop-portal-lxqt"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/lxqt/desktop/xdg-desktop-portal-lxqt.xml:84
#, xml-text
msgid ""
"Install <application>xdg-desktop-portal-lxqt</application> by running the "
"following commands:"
msgstr ""
"Instale <application>xdg-desktop-portal-lxqt</application> executando os "
"seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/lxqt/desktop/xdg-desktop-portal-lxqt.xml:88
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr \\\n"
"      -D CMAKE_BUILD_TYPE=Release  \\\n"
"      ..                           &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr \\\n"
"      -D CMAKE_BUILD_TYPE=Release  \\\n"
"      ..                           &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/lxqt/desktop/xdg-desktop-portal-lxqt.xml:97
#, xml-text
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/lxqt/desktop/xdg-desktop-portal-lxqt.xml:101
#, xml-text
msgid "Now, as the &root; user:"
msgstr "Agora, como o(a) usuário(a) &root;:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/lxqt/desktop/xdg-desktop-portal-lxqt.xml:104
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

