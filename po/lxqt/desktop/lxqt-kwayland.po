#, xml-text
msgid "Introduction to kwayland"
msgstr "Introdução ao kwayland"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/lxqt/desktop/lxqt-kwayland.xml:29
#, xml-text
msgid ""
"<application>kwayland</application> is a Qt-style API to interact with the "
"<application>wayland-client</application> and <application>wayland-"
"server</application> API."
msgstr ""
"<application>kwayland</application> é uma API estilo Qt para interagir com a"
" API do <application>wayland-client</application> e do <application>wayland-"
"server</application>."

#. type: Content of: <sect1><sect2><important><para>
#: blfs-en/lxqt/desktop/lxqt-kwayland.xml:38
#, xml-text
msgid ""
"This package is extracted from the KF6 set of packages.  If <xref "
"linkend=\"kf6-frameworks\"/> is built, do <emphasis "
"role=\"bold\">NOT</emphasis> also build this package as presented here."
msgstr ""
"Esse pacote é extraído a partir do conjunto de pacotes do KF6. Se o <xref "
"linkend=\"kf6-frameworks\"/> for construído, <emphasis "
"role=\"bold\">NÃO</emphasis> construa também esse pacote conforme "
"apresentado aqui."

