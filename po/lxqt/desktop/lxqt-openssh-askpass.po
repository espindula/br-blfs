#. type: Content of: <sect1><sect2><para>
#: blfs-en/lxqt/desktop/lxqt-openssh-askpass.xml:29
#, xml-text
msgid ""
"The <application>lxqt-openssh-askpass</application> package is a GUI to "
"query credentials on behalf of other programs."
msgstr ""
"O pacote <application>lxqt-openssh-askpass</application> é uma GUI para "
"consultar credenciais em nome de outros aplicativos."

