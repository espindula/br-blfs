#. type: Content of: <sect1><sect2><title>
#: blfs-en/lxqt/desktop/lxqt-solid.xml:26
#, xml-text
msgid "Introduction to solid"
msgstr "Introdução ao solid"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/lxqt/desktop/lxqt-solid.xml:29
#, xml-text
msgid ""
"<application>Solid</application> is a device integration framework.  It "
"provides a way of querying and interacting with hardware independently of "
"the underlying operating system."
msgstr ""
"<application>Solid</application> é uma estrutura de integração de "
"dispositivos. Ela fornece uma maneira de consultar e interagir com o "
"hardware independentemente do sistema operacional subjacente."

#. type: Content of: <sect1><sect2><important><para>
#: blfs-en/lxqt/desktop/lxqt-solid.xml:38
#, xml-text
msgid ""
"This package is extracted from the KF6 set of packages.  If <xref "
"linkend=\"kf6-frameworks\"/> is built, do <emphasis "
"role=\"bold\">NOT</emphasis> also build this package as presented here."
msgstr ""
"Esse pacote é extraído a partir do conjunto de pacotes do KF6. Se o <xref "
"linkend=\"kf6-frameworks\"/> for construído, <emphasis "
"role=\"bold\">NÃO</emphasis> construa também esse pacote conforme "
"apresentado aqui."

