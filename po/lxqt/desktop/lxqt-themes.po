#, xml-text
msgid "Installation of lxqt-themes"
msgstr "Instalação do lxqt-themes"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/lxqt/desktop/lxqt-themes.xml:87
#, xml-text
msgid ""
"Install <application>lxqt-themes</application> by running the following "
"commands:"
msgstr ""
"Instale o <application>lxqt-themes</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/lxqt/desktop/lxqt-themes.xml:91
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr \\\n"
"      -D CMAKE_BUILD_TYPE=Release  \\\n"
"      ..                           &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr \\\n"
"      -D CMAKE_BUILD_TYPE=Release  \\\n"
"      ..                           &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/lxqt/desktop/lxqt-themes.xml:100
#, xml-text
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/lxqt/desktop/lxqt-themes.xml:104
#, xml-text
msgid "Now, as the &root; user:"
msgstr "Agora, como o(a) usuário(a) &root;:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/lxqt/desktop/lxqt-themes.xml:107
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

