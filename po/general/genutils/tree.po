#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/genutils/tree.xml:72
#, xml-text
msgid "Installation of tree"
msgstr "Instalação do \"tree\""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genutils/tree.xml:75
#, xml-text
msgid ""
"Install <application>tree</application> by running the following commands:"
msgstr ""
"Instale <application>tree</application> executando os seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genutils/tree.xml:79
#, no-wrap, xml-text
msgid "<userinput>make</userinput>"
msgstr "<userinput>make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genutils/tree.xml:82
#, xml-text
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genutils/tree.xml:86
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#.  Without MANDIR=/usr/share/man, it'll create /usr/share/man1/man1 and
#.          install 'tree.1' there. Also, without prefix=/usr, it'll install
#. the
#.          'tree' command in /usr/local/bin.
#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genutils/tree.xml:93
#, no-wrap, xml-text
msgid "<userinput>make PREFIX=/usr MANDIR=/usr/share/man install</userinput>"
msgstr "<userinput>make PREFIX=/usr MANDIR=/usr/share/man install</userinput>"

