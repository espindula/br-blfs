#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genutils/tree.xml:29
#, xml-text
msgid ""
"The <application>tree</application> application is useful to display a "
"dictionary tree's contents, including files, directories, and links."
msgstr ""
"O aplicativo <application>tree</application> é útil para exibir um conteúdo "
"de árvore de dicionário, incluindo arquivos, diretórios e links."

