#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/genutils/graphviz.xml:183
#, xml-text
msgid "Installation of Graphviz"
msgstr "Instalação do Graphviz"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genutils/graphviz.xml:186
#, xml-text
msgid ""
"Install <application>Graphviz</application> by running the following "
"commands:"
msgstr ""
"Instale <application>Graphviz</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genutils/graphviz.xml:190
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr \\\n"
"      -D CMAKE_BUILD_TYPE=Release  \\\n"
"      ..                           &amp;&amp;\n"
"\n"
"sed -i '/GZIP/s/:.*$/=/' CMakeCache.txt &amp;&amp;\n"
"\n"
"make</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr \\\n"
"      -D CMAKE_BUILD_TYPE=Release  \\\n"
"      ..                           &amp;&amp;\n"
"\n"
"sed -i '/GZIP/s/:.*$/=/' CMakeCache.txt &amp;&amp;\n"
"\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genutils/graphviz.xml:202
#, xml-text
msgid ""
"This package does not come with a test suite that provides meaningful "
"results."
msgstr ""
"Esse pacote não vem com uma suíte de teste que forneça resultados "
"significativos."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genutils/graphviz.xml:207
#, xml-text
msgid "Now, as the &root; user:"
msgstr "Agora, como o(a) usuário(a) &root;:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genutils/graphviz.xml:210
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

