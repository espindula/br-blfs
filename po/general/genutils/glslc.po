#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genutils/glslc.xml:28
#, xml-text
msgid ""
"The <application>glslc</application> program is Google's command line "
"compiler for OpenGL Shading Language/High Level Shading Language (GLSL/HLSL)"
"  to Standard Portable Intermediate Representation (SPIR-V)."
msgstr ""
"O programa <application>glslc</application> é o compilador de linha de "
"comando do Google para OpenGL Shading Language/High Level Shading Language "
"(GLSL/HLSL) para Standard Portable Intermediate Representation (SPIR-V)."

