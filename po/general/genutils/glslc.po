#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/genutils/glslc.xml:81
#, xml-text
msgid "Installation of glslc"
msgstr "Instalação do glslc"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genutils/glslc.xml:84
#, xml-text
msgid ""
"First, allow building with system <xref linkend=\"glslang\"/> and <xref "
"linkend=\"spirv-tools\"/>:"
msgstr ""
"Primeiro, permita construir com <xref linkend=\"glslang\"/> e <xref "
"linkend=\"spirv-tools\"/> do sistema:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genutils/glslc.xml:88
#, no-wrap, xml-text
msgid ""
"<userinput>sed '/build-version/d'   -i glslc/CMakeLists.txt            &amp;&amp;\n"
"sed '/third_party/d'     -i CMakeLists.txt                  &amp;&amp;\n"
"sed 's|SPIRV|glslang/&amp;|' -i libshaderc_util/src/compiler.cc &amp;&amp;\n"
"\n"
"echo '\"&shaderc-version;\"' > glslc/src/build-version.inc</userinput>"
msgstr ""
"<userinput>sed '/build-version/d'   -i glslc/CMakeLists.txt            &amp;&amp;\n"
"sed '/third_party/d'     -i CMakeLists.txt                  &amp;&amp;\n"
"sed 's|SPIRV|glslang/&amp;|' -i libshaderc_util/src/compiler.cc &amp;&amp;\n"
"\n"
"echo '\"&shaderc-version;\"' > glslc/src/build-version.inc</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genutils/glslc.xml:95
#, xml-text
msgid ""
"Now install <application>glslc</application> by running the following "
"commands:"
msgstr ""
"Agora instale <application>glslc</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genutils/glslc.xml:99
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr \\\n"
"      -D CMAKE_BUILD_TYPE=Release  \\\n"
"      -D SHADERC_SKIP_TESTS=ON     \\\n"
"      -G Ninja ..\n"
"ninja</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr \\\n"
"      -D CMAKE_BUILD_TYPE=Release  \\\n"
"      -D SHADERC_SKIP_TESTS=ON     \\\n"
"      -G Ninja ..\n"
"ninja</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genutils/glslc.xml:109
#, xml-text
msgid "Now, as the &root; user:"
msgstr "Agora, como o(a) usuário(a) &root;:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genutils/glslc.xml:112
#, no-wrap, xml-text
msgid "<userinput>install -vm755 glslc/glslc /usr/bin</userinput>"
msgstr "<userinput>install -vm755 glslc/glslc /usr/bin</userinput>"

