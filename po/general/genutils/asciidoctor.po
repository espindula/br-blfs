#, xml-text
msgid "Installation of Asciidoctor"
msgstr "Instalação do Asciidoctor"

#. type: Content of: <sect1><sect2><note><para><screen>
#: blfs-en/general/genutils/asciidoctor.xml:86
#, no-wrap, xml-text
msgid "fatal: not a git repository (or any of the parent directories): .git"
msgstr "fatal: not a git repository (or any of the parent directories): .git"

#. type: Content of: <sect1><sect2><note><para>
#: blfs-en/general/genutils/asciidoctor.xml:85
#, xml-text
msgid ""
"When building this package, the following message may appear: <placeholder "
"type=\"screen\" id=\"0\"/>.  This is normal, and the package will continue "
"building past this point."
msgstr ""
"Quando construir esse pacote, a seguinte mensagem possivelmente apareça: "
"<placeholder type=\"screen\" id=\"0\"/>. Isso é normal e o pacote continuará"
" sendo construído após esse ponto."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genutils/asciidoctor.xml:92
#, xml-text
msgid "Build the Ruby gem:"
msgstr "Construa a gema Ruby:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genutils/asciidoctor.xml:95
#, no-wrap, xml-text
msgid "<userinput>gem build asciidoctor.gemspec</userinput>"
msgstr "<userinput>gem build asciidoctor.gemspec</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genutils/asciidoctor.xml:98
#, xml-text
msgid "The test suite needs many Ruby gems beyond the scope of BLFS."
msgstr "A suíte de teste precisa de muitas gemas Ruby além do escopo do BLFS."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genutils/asciidoctor.xml:102
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genutils/asciidoctor.xml:105
#, no-wrap, xml-text
msgid ""
"<userinput>gem install asciidoctor-&asciidoctor-version;.gem &amp;&amp;\n"
"install -vm644 man/asciidoctor.1 /usr/share/man/man1</userinput>"
msgstr ""
"<userinput>gem install asciidoctor-&asciidoctor-version;.gem &amp;&amp;\n"
"install -vm644 man/asciidoctor.1 /usr/share/man/man1</userinput>"

