#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/genutils/asciidoctor.xml:26
#, xml-text
msgid "Introduction to Asciidoctor"
msgstr "Introdução ao Asciidoctor"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genutils/asciidoctor.xml:29
#, xml-text
msgid ""
"Asciidoctor is a fast, open source text processor and publishing toolchain "
"for converting AsciiDoc content to HTML5, DocBook, PDF, and other formats."
msgstr ""
"O \"Asciidoctor\" é um processador de texto de fonte aberto rápido e um "
"conjunto de ferramentas de publicação para converter conteúdo \"AsciiDoc\" "
"em \"HTML5\", \"DocBook\", \"PDF\" e outros formatos."

