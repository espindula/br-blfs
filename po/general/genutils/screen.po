#: blfs-en/general/genutils/screen.xml:95
#, xml-text
msgid "Installation of Screen"
msgstr "Instalação do Screen"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genutils/screen.xml:98
#, xml-text
msgid ""
"Install <application>Screen</application> by running the following commands:"
msgstr ""
"Instale <application>Screen</application> executando os seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genutils/screen.xml:102
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr                   \\\n"
"            --infodir=/usr/share/info       \\\n"
"            --mandir=/usr/share/man         \\\n"
"            --disable-pam                   \\\n"
"            --enable-socket-dir=/run/screen \\\n"
"            --with-pty-group=5              \\\n"
"            --with-system_screenrc=/etc/screenrc &amp;&amp;\n"
"\n"
"sed -i -e \"s%/usr/local/etc/screenrc%/etc/screenrc%\" {etc,doc}/* &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>./configure --prefix=/usr                   \\\n"
"            --infodir=/usr/share/info       \\\n"
"            --mandir=/usr/share/man         \\\n"
"            --disable-pam                   \\\n"
"            --enable-socket-dir=/run/screen \\\n"
"            --with-pty-group=5              \\\n"
"            --with-system_screenrc=/etc/screenrc &amp;&amp;\n"
"\n"
"sed -i -e \"s%/usr/local/etc/screenrc%/etc/screenrc%\" {etc,doc}/* &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genutils/screen.xml:114
#, xml-text
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genutils/screen.xml:118
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genutils/screen.xml:121
#, no-wrap, xml-text
msgid ""
"<userinput>make install &amp;&amp;\n"
"install -m 644 etc/etcscreenrc /etc/screenrc</userinput>"
msgstr ""
"<userinput>make install &amp;&amp;\n"
"install -m 644 etc/etcscreenrc /etc/screenrc</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/genutils/screen.xml:127
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genutils/screen.xml:130
#, xml-text
msgid ""
"<parameter>--disable-pam</parameter>: This option removes a build dependency"
" on Linux-PAM. Remove this option if you want PAM support."
msgstr ""
"<parameter>--disable-pam</parameter>: Essa opção remove uma dependência de "
"construção de Linux-PAM. Remova essa opção se você quiser suporte a PAM."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genutils/screen.xml:135
#, xml-text
msgid ""
"<parameter>--enable-socket-dir=/run/screen</parameter>: This option places "
"the per-user sockets in a standard location."
msgstr ""
"<parameter>--enable-socket-dir=/run/screen</parameter>: Essa opção coloca os"
" soquetes por usuário(a) em um local padrão."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genutils/screen.xml:140
#, xml-text
msgid ""
"<parameter>--with-system_screenrc=/etc/screenrc</parameter>: This option "
"places the global screenrc file in <filename "
"class='directory'>/etc</filename>."
msgstr ""
"<parameter>--with-system_screenrc=/etc/screenrc</parameter>: Essa opção "
"coloca o arquivo global screenrc em <filename "
"class='directory'>/etc</filename>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genutils/screen.xml:146
#, xml-text
msgid ""
"<parameter>--with-pty-group=5</parameter>: This option sets the gid to the "
"value used by LFS."
msgstr ""
"<parameter>--with-pty-group=5</parameter>: Essa opção configura o \"GID\" "
"para o valor usado pelo LFS."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genutils/screen.xml:151
#, xml-text
msgid ""
"<command>sed -i -e \"s%/usr/local/etc/screenrc%/etc/screenrc%\" "
"{etc,doc}/*</command>: This command corrects the configuration and "
"documentation files to the location that is used here for the global "
"screenrc file."
msgstr ""
"<command>sed -i -e \"s%/usr/local/etc/screenrc%/etc/screenrc%\" "
"{etc,doc}/*</command>: Esse comando corrige os arquivos de configuração e "
"documentação para o local que é usado aqui para o arquivo global "
"\"screenrc\"."

