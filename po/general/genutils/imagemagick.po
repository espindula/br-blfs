"carregáveis dinamicamente."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genutils/imagemagick.xml:293
#, xml-text
msgid ""
"<parameter>--with-perl</parameter>: Enables building and installing of "
"PerlMagick."
msgstr ""
"<parameter>--with-perl</parameter>: Habilita a construção e instalação do "
"\"PerlMagick\"."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genutils/imagemagick.xml:301
#, xml-text
msgid ""
"<option>--with-fftw</option>: Enables support for the "
"<application>FFTW</application> shared library."
msgstr ""
"<option>--with-fftw</option>: Habilita suporte para a biblioteca "
"compartilhada <application>FFTW</application>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genutils/imagemagick.xml:306
#, xml-text
msgid ""
"<option>--with-rsvg</option>: Enables support for the "
"<application>librsvg</application> library."
msgstr ""
"<option>--with-rsvg</option>: Habilita suporte para a biblioteca "
"<application>librsvg</application>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genutils/imagemagick.xml:311
#, xml-text
msgid ""
"<option>--with-autotrace</option>: Enables support for the "
"<application>Autotrace</application> library."
msgstr ""
"<option>--with-autotrace</option>: Habilita suporte para a biblioteca "
"<application>Autotrace</application>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genutils/imagemagick.xml:316
#, xml-text
msgid ""
"<option>--with-wmf</option>: Enables support for the "
"<application>libwmf</application> library."
msgstr ""
"<option>--with-wmf</option>: Habilita suporte para a biblioteca "
"<application>libwmf</application>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genutils/imagemagick.xml:321
#, xml-text
msgid ""
"<option>--with-gvc</option>: Enables support for "
"<application>GraphViz</application>."
msgstr ""
"<option>--with-gvc</option>: Habilita suporte para "
"<application>GraphViz</application>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genutils/imagemagick.xml:326
#, xml-text
msgid ""
"<option>--with-security-policy=open|limited|secure|websafe</option>: If you "
"wish to enforce a policy other than the default 'open' see "
"<filename>www/security-policy.html</filename> in the source for details."
