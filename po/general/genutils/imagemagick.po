#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/genutils/imagemagick.xml:236
#, xml-text
msgid "Installation of ImageMagick"
msgstr "Instalação do ImageMagick"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genutils/imagemagick.xml:239
#, xml-text
msgid ""
"Install <application>ImageMagick</application> by running the following "
"commands:"
msgstr ""
"Instale <application>ImageMagick</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genutils/imagemagick.xml:243
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr     \\\n"
"            --sysconfdir=/etc \\\n"
"            --enable-hdri     \\\n"
"            --with-modules    \\\n"
"            --with-perl       \\\n"
"            --disable-static  &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>./configure --prefix=/usr    \\\n"
"            --sysconfdir=/etc \\\n"
"            --enable-hdri     \\\n"
"            --with-modules    \\\n"
"            --with-perl       \\\n"
"            --disable-static  &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genutils/imagemagick.xml:252
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr "Agora, como o(a) usante <systemitem class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genutils/imagemagick.xml:255
#, no-wrap, xml-text
msgid ""
"<userinput>make DOCUMENTATION_PATH=/usr/share/doc/imagemagick-&imagemagick-"
"version; install</userinput>"
msgstr ""
"<userinput>make DOCUMENTATION_PATH=/usr/share/doc/imagemagick-&imagemagick-"
"version; install</userinput>"

#.  seems to have been dropped                         A more
#.       comprehensive test is the <application>
#. ImageMagick</application>
#.       validation suite. If <command>make check</command> has not been
#. executed,
#.       run <command>make tests/validate</command> to compile it.  Issue
#.       <command>tests/validate 2>&amp;1 | tee validate.log</command> to run
#. the
#.       validation suite.
#.  summary is last line of output
#.        The result summary may be obtained with <command>
#. grep
#.       "validation suite" validate.log</command>.
#.  I'm not convinced that Helvetica is required, I don't install the gs
#.       fonts. But lots of references to it. Surely fontconfig provides it?
#. ken
#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genutils/imagemagick.xml:258
#, xml-text
msgid ""
"To test the installation, issue: <command>make check</command>.  Note that "
"the EPS, PS, and PDF tests require a working "
"<application>Ghostscript</application>. One test in 'make check' needs "
"<quote>Helvetica</quote> from <quote>Ghostscript Standard Fonts,</quote> "
"which are optionally installed in <xref linkend=\"gs\"/> - that test, and "
"one other, might fail, but all the validation can still pass."
msgstr ""
"Para testar a instalação, emita: <command>make check</command>. Observe que "
"os testes EPS, PS e PDF exigem um <application>Ghostscript</application> "
"funcional. Um teste em 'make check' precisa da <quote>Helvetica</quote> "
"originário de <quote>Ghostscript Standard Fonts</quote>, que são "
"opcionalmente instaladas em <xref linkend=\"gs\"/> - esse teste, e um outro,"
" pode falhar, mas toda a validação ainda pode passar."

#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/genutils/imagemagick.xml:280
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genutils/imagemagick.xml:283
#, xml-text
msgid ""
"<parameter>--enable-hdri</parameter>: Enables building of a high dynamic "
"range version of ImageMagick."
msgstr ""
"<parameter>--enable-hdri</parameter>: Permite construir uma versão de alta "
"faixa dinâmica do \"ImageMagick\"."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genutils/imagemagick.xml:288
#, xml-text
msgid ""
"<parameter>--with-modules</parameter>: Enables support for dynamically "
"loadable modules."
