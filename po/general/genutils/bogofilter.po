#: blfs-en/general/genutils/bogofilter.xml:91
#, xml-text
msgid ""
"If you do not install the recommended <xref linkend=\"gsl\"/> package then a"
" statically linked shipped version will be used instead."
msgstr ""
"Se você não instalar o pacote <xref linkend=\"gsl\"/> recomendado, então uma"
" versão enviada estaticamente vinculada será usada."

#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/genutils/bogofilter.xml:99
#, xml-text
msgid "Installation of Bogofilter"
msgstr "Instalação do Bogofilter"

#. type: Content of: <sect1><sect2><note><para>
#: blfs-en/general/genutils/bogofilter.xml:103
#, xml-text
msgid ""
"If you plan to change the version of your database library on an existing "
"installation, or to change to a different database, read the warning at the "
"top of the RELEASE.NOTES file."
msgstr ""
"Se você planeja mudar a versão de sua biblioteca de base de dados em uma "
"instalação existente ou mudar para uma base de dados diferente, [então] leia"
" o aviso na parte superior do arquivo \"RELEASE.NOTES\"."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genutils/bogofilter.xml:110
#, xml-text
msgid ""
"Install <application>Bogofilter</application> by running the following "
"commands:"
msgstr ""
"Instale <application>Bogofilter</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genutils/bogofilter.xml:114
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr                \\\n"
"            --sysconfdir=/etc/bogofilter \\\n"
"            --with-database=sqlite3      &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>./configure --prefix=/usr                \\\n"
"            --sysconfdir=/etc/bogofilter \\\n"
"            --with-database=sqlite3      &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genutils/bogofilter.xml:120
#, xml-text
msgid "To test the results, issue <command>make check</command>."
msgstr "Para testar os resultados, emita <command>make check</command>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genutils/bogofilter.xml:124
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genutils/bogofilter.xml:127
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/genutils/bogofilter.xml:132
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#.  which is beyond the scope of BLFS (slated for removal)
#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genutils/bogofilter.xml:135
#, xml-text
msgid ""
"<parameter>--with-database=sqlite3</parameter>: This switch makes Bogofilter"
" use <xref linkend='sqlite'/> as the database, instead of Berkeley DB."
msgstr ""
"<parameter>--with-database=sqlite3</parameter>: Essa chave faz com que "
"Bogofilter use <xref linkend='sqlite'/> como a base de dados, em vez de "
"Berkeley DB."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genutils/bogofilter.xml:141
#, xml-text
msgid ""
"<option>--with-database={lmdb,qdbm,tokyocabinet}</option>: This switch also "
"allows to use lmdb, qdbm, or tokyocabinet as the database."
msgstr ""
"<option>--with-database={lmdb,qdbm,tokyocabinet}</option>: Essa chave também"
" permite usar lmdb, qdbm ou tokyocabinet como a base de dados."

