#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/genutils/bogofilter.xml:26
#, xml-text
msgid "Introduction to Bogofilter"
msgstr "Introdução ao Bogofilter"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genutils/bogofilter.xml:29
#, xml-text
msgid ""
"The <application>Bogofilter</application> application is a mail filter that "
"classifies mail as spam or ham (non-spam) by a statistical analysis of the "
"message's header and content (body)."
msgstr ""
"O aplicativo <application>Bogofilter</application> é um filtro de mensagens "
"que classifica a mensagem como \"spam\" ou \"ham\" (não \"spam\") por meio "
"de uma análise estatística do cabeçalho e conteúdo (corpo) da mensagem."

