#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genutils/sharutils.xml:29
#, xml-text
msgid ""
"The <application>Sharutils</application> package contains utilities that can"
" create 'shell' archives."
msgstr ""
"O pacote <application>Sharutils</application> contém utilitários que "
"conseguem criar arquivamentos \"shell\"."

