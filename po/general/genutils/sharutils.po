#. type: Content of: <sect1><sect2><variablelist><varlistentry><term>
#: blfs-en/general/genutils/sharutils.xml:152
#, xml-text
msgid "<command>shar</command>"
msgstr "<command>shar</command>"

#. type: Content of:
#. <sect1><sect2><variablelist><varlistentry><listitem><para>
#: blfs-en/general/genutils/sharutils.xml:155
#, xml-text
msgid ""
"creates \"shell archives\" (or shar files) which are in text format and can "
"be mailed"
msgstr ""
"cria \"arquivamentos shell\" (ou arquivos \"shar\") que estão em formato de "
"texto e conseguem ser enviados por correio"

#. type: Content of:
#. <sect1><sect2><variablelist><varlistentry><listitem><indexterm><primary>
#: blfs-en/general/genutils/sharutils.xml:159
#, xml-text
msgid "shar"
msgstr "shar"

#. type: Content of: <sect1><sect2><variablelist><varlistentry><term>
#: blfs-en/general/genutils/sharutils.xml:165
#, xml-text
msgid "<command>unshar</command>"
msgstr "<command>unshar</command>"

#. type: Content of:
#. <sect1><sect2><variablelist><varlistentry><listitem><para>
#: blfs-en/general/genutils/sharutils.xml:168
#, xml-text
msgid "unpacks a shar file"
msgstr "desempacota um arquivo \"shar\""

#. type: Content of:
#. <sect1><sect2><variablelist><varlistentry><listitem><indexterm><primary>
#: blfs-en/general/genutils/sharutils.xml:171
#, xml-text
msgid "unshar"
msgstr "unshar"

#. type: Content of: <sect1><sect2><variablelist><varlistentry><term>
#: blfs-en/general/genutils/sharutils.xml:177
#, xml-text
msgid "<command>uudecode</command>"
msgstr "<command>uudecode</command>"

#. type: Content of:
#. <sect1><sect2><variablelist><varlistentry><listitem><para>
#: blfs-en/general/genutils/sharutils.xml:180
#, xml-text
msgid ""
"reads a file (or by default the standard input) and writes an encoded "
"version to the standard output. The encoding uses only printing ASCII "
"characters"
msgstr ""
"lê um arquivo (ou, por padrão, a entrada gerada padrão) e grava uma versão "
"codificada na saída gerada padrão. A codificação usa somente caracteres de "
"impressão \"ASCII\""

#. type: Content of:
#. <sect1><sect2><variablelist><varlistentry><listitem><indexterm><primary>
#: blfs-en/general/genutils/sharutils.xml:185
#, xml-text
msgid "uudecode"
msgstr "uudecode"

#. type: Content of: <sect1><sect2><variablelist><varlistentry><term>
#: blfs-en/general/genutils/sharutils.xml:191
#, xml-text
msgid "<command>uuencode</command>"
msgstr "<command>uuencode</command>"

#. type: Content of:
#. <sect1><sect2><variablelist><varlistentry><listitem><para>
#: blfs-en/general/genutils/sharutils.xml:194
#, xml-text
msgid ""
"reads a file (or by default the standard input) and decodes the uuencoded "
"version to the standard output"
msgstr ""
"lê um arquivo (ou, por padrão, a entrada gerada padrão) e decodifica a "
"versão \"uuencoded\" para a saída gerada padrão"

#. type: Content of:
#. <sect1><sect2><variablelist><varlistentry><listitem><indexterm><primary>
#: blfs-en/general/genutils/sharutils.xml:198
#, xml-text
msgid "uuencode"
msgstr "uuencode"

#, xml-text
#~ msgid "Fix a heap buffer overflow, and an issue exposed by GCC-10:"
#~ msgstr ""
#~ "Corrija um estouro de \"buffer\" de uma coleção desordenada de objetos "
#~ "colocados ao acaso uns sobre os outros e um problema exposto pelo "
#~ "\"GCC-10\":"

#, no-wrap, xml-text
#~ msgid ""
#~ "<userinput>sed -i 's/BUFSIZ/rw_base_size/' src/unshar.c &amp;&amp;\n"
#~ "sed -i '/program_name/s/^/extern /' src/*opts.h</userinput>"
#~ msgstr ""
#~ "<userinput>sed -i 's/BUFSIZ/rw_base_size/' src/unshar.c &amp;&amp;\n"
#~ "sed -i '/program_name/s/^/extern /' src/*opts.h</userinput>"

#, no-wrap, xml-text
#~ msgid ""
#~ "<userinput>sed -i 's/IO_ftrylockfile/IO_EOF_SEEN/' lib/*.c        &amp;&amp;\n"
#~ "echo \"#define _IO_IN_BACKUP 0x100\" >> lib/stdio-impl.h &amp;&amp;\n"
#~ "\n"
#~ "./configure --prefix=/usr &amp;&amp;\n"
#~ "make</userinput>"
#~ msgstr ""
#~ "<userinput>sed -i 's/IO_ftrylockfile/IO_EOF_SEEN/' lib/*.c       &amp;&amp;\n"
#~ "echo \"#define _IO_IN_BACKUP 0x100\" >> lib/stdio-impl.h &amp;&amp;\n"
#~ "\n"
#~ "./configure --prefix=/usr &amp;&amp;\n"
#~ "make</userinput>"

#, xml-text
#~ msgid "&gnu-ftp;/sharutils/sharutils-&sharutils-version;.tar.xz"
#~ msgstr "&gnu-ftp;/sharutils/sharutils-&sharutils-version;.tar.xz"

