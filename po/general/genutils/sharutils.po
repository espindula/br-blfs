#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/genutils/sharutils.xml:81
#, xml-text
msgid "Installation of Sharutils"
msgstr "Instalação do Sharutils"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genutils/sharutils.xml:84
#, xml-text
msgid "First, fix issues exposed by current GCC versions:"
msgstr "Primeiro, corrija problemas expostos por versões atuais do GCC:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genutils/sharutils.xml:87
#, no-wrap, xml-text
msgid ""
"<userinput>patch -Np1 -i ../sharutils-&sharutils-"
"version;-consolidated-1.patch</userinput>"
msgstr ""
"<userinput>patch -Np1 -i ../sharutils-&sharutils-"
"version;-consolidated-1.patch</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genutils/sharutils.xml:90
#, xml-text
msgid ""
"Install <application>Sharutils</application> by running the following "
"commands:"
msgstr ""
"Instale <application>Sharutils</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genutils/sharutils.xml:94
#, no-wrap, xml-text
msgid ""
"<userinput>autoreconf -fiv                                         &amp;&amp;\n"
"./configure --prefix=/usr --disable-dependency-tracking &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>autoreconf -fiv                                         &amp;&amp;\n"
"./configure --prefix=/usr --disable-dependency-tracking &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genutils/sharutils.xml:99
#, xml-text
msgid "To test the results, issue <command>make check</command>."
msgstr "Para testar os resultados, emita <command>make check</command>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genutils/sharutils.xml:103
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr "Agora, como o(a) usante <systemitem class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genutils/sharutils.xml:106
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/genutils/sharutils.xml:111
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genutils/sharutils.xml:114
#, xml-text
msgid ""
"<parameter>--disable-dependency-tracking</parameter>: This switch is used to"
" disable unneeded code in the build system."
msgstr ""
"<parameter>--disable-dependency-tracking</parameter>: Essa chave é usada "
"para desablitar código desnecessário no sistema de construção."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genutils/sharutils.xml:119
#, xml-text
msgid ""
"<parameter>--with-openssl</parameter>: This optional switch is used to "
"enable incorporation of integrity checks into the package's executable "
"programs."
msgstr ""
"<parameter>--with-openssl</parameter>: Essa chave opcional é usada para "
"habilitar incorporação de verificações de integridade nos programas "
"executáveis do pacote."

