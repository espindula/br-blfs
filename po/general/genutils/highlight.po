#: blfs-en/general/genutils/highlight.xml:93
#, no-wrap, xml-text
msgid "<userinput>sed -i '/GZIP/s/^/#/' makefile</userinput>"
msgstr "<userinput>sed -i '/GZIP/s/^/#/' makefile</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genutils/highlight.xml:96
#, xml-text
msgid ""
"To build <application>Highlight</application> run the following command:"
msgstr ""
"Para construir <application>Highlight</application> execute o seguinte "
"comando:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genutils/highlight.xml:100
#, no-wrap, xml-text
msgid "<userinput>make</userinput>"
msgstr "<userinput>make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genutils/highlight.xml:103
#, xml-text
msgid ""
"To build the <application>qt6</application> GUI front-end, run the following"
" command:"
msgstr ""
"Para construir a estrutura GUI do <application>qt6</application>, execute o "
"seguinte comando:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genutils/highlight.xml:107
#, no-wrap, xml-text
msgid ""
"<userinput>make doc_dir=/usr/share/doc/highlight-&highlight-version;/ "
"gui</userinput>"
msgstr ""
"<userinput>make doc_dir=/usr/share/doc/highlight-&highlight-version;/ "
"gui</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genutils/highlight.xml:116
#, xml-text
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genutils/highlight.xml:120
#, xml-text
msgid ""
"To install <application>Highlight</application>, run the following command "
"as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Para instalar <application>Highlight</application>, execute o seguinte "
"comando como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genutils/highlight.xml:125
#, no-wrap, xml-text
msgid ""
"<userinput>make doc_dir=/usr/share/doc/highlight-&highlight-version;/ "
"install</userinput>"
msgstr ""
"<userinput>make doc_dir=/usr/share/doc/highlight-&highlight-version;/ "
"install</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genutils/highlight.xml:128
#, xml-text
msgid ""
"To install the GUI program, run the following command as the <systemitem "
"class=\"username\">root</systemitem> user:"
msgstr ""
"Para instalar o aplicativo &quot;GUI&quot;, execute o seguinte comando como "
"o(a) usuário(a) <systemitem class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genutils/highlight.xml:132
#, no-wrap, xml-text
msgid "<userinput>make install-gui</userinput>"
msgstr "<userinput>make install-gui</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/genutils/highlight.xml:144
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genutils/highlight.xml:147
#, xml-text
msgid ""
"<parameter>doc_dir=/usr/share/doc/highlight-&highlight-"
"version;/</parameter>: installs the highlight documentation into a versioned"
" directory. This parameter is also needed for <command>make gui</command>, "
"because its value would be hardcoded into the gui executable.  Note that the"
" trailing <quote>/</quote> is necessary."
msgstr ""
"<parameter>doc_dir=/usr/share/doc/highlight-&highlight-"
"version;/</parameter>: instala a documentação do highlight em um diretório "
"versionado. Esse parâmetro também é necessário para <command>make "
"gui</command>, pois o valor dele seria rigidamente codificado no executável "
"GUI. Observe que a <quote>/</quote> à direita é necessária."

