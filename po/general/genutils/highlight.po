#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genutils/highlight.xml:29
#, xml-text
msgid ""
"<application>Highlight</application> is a utility that converts source code "
"to formatted text with syntax highlighting."
msgstr ""
"<application>Highlight</application> é um utilitário que converte o código-"
"fonte em texto formatado com realce de sintaxe."

