#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/genutils/editorconfig-core-c.xml:74
#, xml-text
msgid "Installation of editorconfig-core-c"
msgstr "Instalação do editorconfig-core-c"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genutils/editorconfig-core-c.xml:77
#, xml-text
msgid ""
"Install <application>editorconfig-core-c</application> by running the "
"following commands:"
msgstr ""
"Instale <application>editorconfig-core-c</application> executando os "
"seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genutils/editorconfig-core-c.xml:81
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr \\\n"
"      -D CMAKE_BUILD_TYPE=Release  \\\n"
"      -D BUILD_DOCUMENTATION=OFF   \\\n"
"      ..                           &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr \\\n"
"      -D CMAKE_BUILD_TYPE=Release  \\\n"
"      -D BUILD_DOCUMENTATION=OFF   \\\n"
"      ..                           &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genutils/editorconfig-core-c.xml:91
#, xml-text
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genutils/editorconfig-core-c.xml:95
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genutils/editorconfig-core-c.xml:98
#, no-wrap, xml-text
msgid ""
"<userinput>make install &amp;&amp;\n"
"rm -fv /usr/lib/libeditorconfig_static.a</userinput>"
msgstr ""
"<userinput>make install &amp;&amp;\n"
"rm -fv /usr/lib/libeditorconfig_static.a</userinput>"

