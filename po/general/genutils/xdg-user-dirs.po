#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/genutils/xdg-user-dirs.xml:81
#, xml-text
msgid "Installation of Xdg-user-dirs"
msgstr "Instalação do \"Xdg-user-dirs\""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genutils/xdg-user-dirs.xml:84
#, xml-text
msgid ""
"Install <application>xdg-user-dirs</application> by running the following "
"commands:"
msgstr ""
"Instale <application>xdg-user-dirs</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genutils/xdg-user-dirs.xml:88
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr       \\\n"
"            --buildtype=release \\\n"
"            -D docs=false       \\\n"
"            .. &amp;&amp;\n"
"ninja</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr       \\\n"
"            --buildtype=release \\\n"
"            -D docs=false       \\\n"
"            .. &amp;&amp;\n"
"ninja</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genutils/xdg-user-dirs.xml:98
#, xml-text
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genutils/xdg-user-dirs.xml:102
#, xml-text
msgid "Now, as the &root; user:"
msgstr "Agora, como o(a) usuário(a) &root;:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genutils/xdg-user-dirs.xml:105
#, no-wrap, xml-text
msgid ""
"<userinput>ninja install</userinput><userinput revision=\"sysv\"> &amp;&amp;\n"
"rm -rvf /usr/lib/systemd</userinput>"
msgstr ""
"<userinput>ninja install</userinput><userinput revision=\"sysv\"> &amp;&amp;\n"
"rm -rvf /usr/lib/systemd</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/genutils/xdg-user-dirs.xml:110
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genutils/xdg-user-dirs.xml:113
#, xml-text
msgid ""
"<parameter>-D docs=false</parameter>: Disable the installation of the man "
"pages. Remove this switch if you've installed the optional dependencies and "
"you wish to install the man pages of this package."
msgstr ""
"<parameter>-D docs=false</parameter>: Desabilita a instalação das páginas de"
" manual. Remova essa chave se você tiver instalado as dependências opcionais"
" e desejar instalar as páginas de manual desse pacote."

