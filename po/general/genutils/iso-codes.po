#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/genutils/iso-codes.xml:73
#, xml-text
msgid "Installation of ISO Codes"
msgstr "Instalação do ISO Codes"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genutils/iso-codes.xml:76
#, xml-text
msgid ""
"Install <application>ISO Codes</application> by running the following "
"commands:"
msgstr ""
"Instale <application>ISO Codes</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genutils/iso-codes.xml:80
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>./configure --prefix=/usr &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genutils/iso-codes.xml:84
#, xml-text
msgid "To test the results, issue: <command>make check</command>."
msgstr "Para testar os resultados, emita: <command>make check</command>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genutils/iso-codes.xml:88
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genutils/iso-codes.xml:91
#, no-wrap, xml-text
msgid "<userinput>make install LN_S='ln -sfn'</userinput>"
msgstr "<userinput>make install LN_S='ln -sfn'</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/genutils/iso-codes.xml:96
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genutils/iso-codes.xml:99
#, xml-text
msgid ""
"<parameter>LN_S='ln -sfn'</parameter>: This override ensures the installed "
"symlinks correctly recreated in case we are upgrading or reinstalling the "
"package.  It's unneeded but harmless when installing the package onto the "
"system for the first time."
msgstr ""
"<parameter>LN_S='ln -sfn'</parameter>: Essa substituição garante os links "
"simbólicos instalados recriados corretamente caso nós estejamos atualizando "
"ou reinstalando o pacote. Ela é desnecessária, mas inofensiva, ao instalar o"
" pacote no sistema pela primeira vez."

