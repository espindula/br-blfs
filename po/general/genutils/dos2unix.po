#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/genutils/dos2unix.xml:73
#, xml-text
msgid "Installation of dos2unix"
msgstr "Instalação do dos2unix"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genutils/dos2unix.xml:76
#, xml-text
msgid ""
"Build <application>dos2unix</application> by running the following commands:"
msgstr ""
"Construa <application>dos2unix</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genutils/dos2unix.xml:80
#, no-wrap, xml-text
msgid "<userinput>make</userinput>"
msgstr "<userinput>make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genutils/dos2unix.xml:83
#, xml-text
msgid "To test the results, issue: <command>make check</command>."
msgstr "Para testar os resultados, emita: <command>make check</command>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genutils/dos2unix.xml:87
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genutils/dos2unix.xml:90
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

