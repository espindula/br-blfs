#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/genutils/telepathy-mission-control.xml:27
msgid "Introduction to Telepathy Mission Control"
msgstr "Introdução ao \"Telepathy Mission Control\""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genutils/telepathy-mission-control.xml:30
msgid ""
"<application>Telepathy Mission Control</application> is an account manager "
"and channel dispatcher for the <application>Telepathy</application> "
"framework, allowing user interfaces and other clients to share connections "
"to real-time communication services without conflicting."
msgstr ""
"<application>Telepathy Mission Control</application> é um gerenciador de "
"contas e despachante de canal para a estrutura "
"<application>Telepathy</application>, permitindo que interfaces de "
"usuário(a) e outros clientes compartilhem conexões com serviços de "
"comunicação em tempo real sem conflitos."

