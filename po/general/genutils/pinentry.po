msgstr "Instalação do PIN-Entry"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genutils/pinentry.xml:109
#, xml-text
msgid ""
"Install <application>PIN-Entry</application> by running the following "
"commands:"
msgstr ""
"Instale <application>PIN-Entry</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genutils/pinentry.xml:113
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr          \\\n"
"            --enable-pinentry-tty  \\\n"
"            --disable-pinentry-qt5 &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>./configure --prefix=/usr          \\\n"
"            --enable-pinentry-tty  \\\n"
"            --disable-pinentry-qt5 &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genutils/pinentry.xml:119
#, xml-text
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genutils/pinentry.xml:123
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genutils/pinentry.xml:126
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

