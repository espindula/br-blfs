#: blfs-en/general/genutils/pinentry.xml:131
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genutils/pinentry.xml:134
#, xml-text
msgid ""
"<option>--disable-pinentry-qt5</option>: Don't use qt5 even if it is "
"available.  Qt5 is deprecated."
msgstr ""
"<option>--disable-pinentry-qt5</option>: Não use qt5 mesmo se ele estiver "
"disponível. Qt5 está obsoleto."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genutils/pinentry.xml:139
#, xml-text
msgid "<option>--enable-inside-emacs=yes/no</option>: Default is no."
msgstr "<option>--enable-inside-emacs=yes/no</option>: Padrão é \"no\"."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genutils/pinentry.xml:143
#, xml-text
msgid "<option>--enable-pinentry-qt=yes/no</option>: Default is yes."
msgstr "<option>--enable-pinentry-qt=yes/no</option>: Padrão é \"yes\"."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genutils/pinentry.xml:147
#, xml-text
msgid ""
"<option>--enable-pinentry-gnome3=yes/no</option>: Default is yes.  This "
"option uses <xref linkend='gcr4'/> (or <xref linkend='gcr'/> if the former "
"is not installed) for the pinentry dialog."
msgstr ""
"<option>--enable-pinentry-gnome3=yes/no</option>: O padrão é sim. Essa opção"
" usa <xref linkend='gcr4'/> (ou <xref linkend='gcr'/> se o primeiro não "
"estiver instalado) para a caixa de diálogo do pinentry."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genutils/pinentry.xml:154
#, xml-text
msgid "<parameter>--enable-pinentry-tty</parameter>: Default is 'maybe'."
msgstr "<parameter>--enable-pinentry-tty</parameter>: Padrão é \"maybe\"."

