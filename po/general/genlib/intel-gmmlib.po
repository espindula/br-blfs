#: blfs-en/general/genlib/intel-gmmlib.xml:82
#, xml-text
msgid "Installation of gmmlib"
msgstr "Instalação do gmmlib"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/intel-gmmlib.xml:85
#, xml-text
msgid ""
"Install <application>gmmlib</application> by running the following commands:"
msgstr ""
"Instale <application>gmmlib</application> executando os seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genlib/intel-gmmlib.xml:89
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr \\\n"
"      -D BUILD_TYPE=Release        \\\n"
"      -G Ninja                     \\\n"
"      -W no-author ..              &amp;&amp;\n"
"ninja</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr \\\n"
"      -D BUILD_TYPE=Release        \\\n"
"      -G Ninja                     \\\n"
"      -W no-author ..              &amp;&amp;\n"
"ninja</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/intel-gmmlib.xml:99
#, xml-text
msgid ""
"The test suite is normally run by <command>ninja</command> unless -D "
"RUN_TEST_SUITE=NO is passed to cmake."
msgstr ""
"A suíte de teste normalmente é executada por <command>ninja</command>, a "
"menos que -D RUN_TEST_SUITE=NO seja passado para cmake."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/intel-gmmlib.xml:104
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genlib/intel-gmmlib.xml:107
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr "<userinput>ninja install</userinput>"

