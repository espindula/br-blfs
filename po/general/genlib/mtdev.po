#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/genlib/mtdev.xml:26
#, xml-text
msgid "Introduction to mtdev"
msgstr "Introdução ao mtdev"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/mtdev.xml:29
#, xml-text
msgid ""
"The <application>mtdev</application> package contains Multitouch Protocol "
"Translation Library which is used to transform all variants of kernel MT "
"(Multitouch) events to the slotted type B protocol."
msgstr ""
"O pacote <application>mtdev</application> contém a biblioteca de tradução do"
" protocolo multitoque que é usada para transformar todas as variantes de "
"eventos \"MT\" (multitoque) do núcleo para o protocolo fendido tipo B."

