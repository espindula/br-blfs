#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/genlib/spirv-llvm-translator.xml:75
#, xml-text
msgid "Installation of SPIRV-LLVM-Translator"
msgstr "Instalação do SPIRV-LLVM-Translator"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/spirv-llvm-translator.xml:78
#, xml-text
msgid ""
"Install <application>SPIRV-LLVM-Translator</application> by running the "
"following commands:"
msgstr ""
"Instale <application>SPIRV-LLVM-Translator</application> executando os "
"seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genlib/spirv-llvm-translator.xml:82
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr                   \\\n"
"      -D CMAKE_BUILD_TYPE=Release                    \\\n"
"      -D BUILD_SHARED_LIBS=ON                        \\\n"
"      -D CMAKE_SKIP_INSTALL_RPATH=ON                 \\\n"
"      -D LLVM_EXTERNAL_SPIRV_HEADERS_SOURCE_DIR=/usr \\\n"
"      -G Ninja ..                                    &amp;&amp;\n"
"ninja</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr                   \\\n"
"      -D CMAKE_BUILD_TYPE=Release                    \\\n"
"      -D BUILD_SHARED_LIBS=ON                        \\\n"
"      -D CMAKE_SKIP_INSTALL_RPATH=ON                 \\\n"
"      -D LLVM_EXTERNAL_SPIRV_HEADERS_SOURCE_DIR=/usr \\\n"
"      -G Ninja ..                                    &amp;&amp;\n"
"ninja</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/spirv-llvm-translator.xml:96
#, xml-text
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/spirv-llvm-translator.xml:100
#, xml-text
msgid "Now, as the &root; user:"
msgstr "Agora, como o(a) usuário(a) &root;:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genlib/spirv-llvm-translator.xml:103
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr "<userinput>ninja install</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/genlib/spirv-llvm-translator.xml:108
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/spirv-llvm-translator.xml:111
#, xml-text
msgid ""
"<parameter>-D BUILD_SHARED_LIBS=ON</parameter>: This parameter forces "
"building shared versions of the libraries."
msgstr ""
"<parameter>-D BUILD_SHARED_LIBS=ON</parameter>: Esse parâmetro força "
"construir versões compartilhadas das bibliotecas."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/spirv-llvm-translator.xml:119
#, xml-text
msgid ""
"<parameter>-D LLVM_EXTERNAL_SPIRV_HEADERS_SOURCE_DIR=/usr</parameter>: This "
"parameter allows the build system to use the version of SPIRV-Headers that "
"should have been installed as a dependency of SPIRV-Tools, instead of "
"redownloading an unnecessary copy of the headers."
msgstr ""
"<parameter>-D LLVM_EXTERNAL_SPIRV_HEADERS_SOURCE_DIR=/usr</parameter>: Esse "
"parâmetro permite que o sistema de construção use a versão do SPIRV-Headers "
"que deveria ter sido instalada como uma dependência do SPIRV-Tools, em vez "
"de baixar novamente uma cópia desnecessária dos cabeçalhos."

