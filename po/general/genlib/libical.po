#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/genlib/libical.xml:97
#, xml-text
msgid "Installation of libical"
msgstr "Instalação do libical"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libical.xml:110
#, xml-text
msgid ""
"Install <application>libical</application> by running the following "
"commands:"
msgstr ""
"Instale <application>libical</application> executando os seguintes comandos:"

#.  Needs confirmation, but I got a race condition at -j8,
#.   -j1 allowed the build to pass. Pierre 2019-12-06
#.   I always have it actually. Hence the entity.
#.   Works at -j8 and -j4 for version 3.0.18
#.     &parallel_issues;
#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genlib/libical.xml:120
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr  \\\n"
"      -D CMAKE_BUILD_TYPE=Release   \\\n"
"      -D SHARED_ONLY=yes            \\\n"
"      -D ICAL_BUILD_DOCS=false      \\\n"
"      -D ICAL_BUILD_EXAMPLES=false  \\\n"
"      -D GOBJECT_INTROSPECTION=true \\\n"
"      -D ICAL_GLIB_VAPI=true        \\\n"
"      .. &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr  \\\n"
"      -D CMAKE_BUILD_TYPE=Release   \\\n"
"      -D SHARED_ONLY=yes            \\\n"
"      -D ICAL_BUILD_DOCS=false      \\\n"
"      -D ICAL_BUILD_EXAMPLES=false  \\\n"
"      -D GOBJECT_INTROSPECTION=true \\\n"
"      -D ICAL_GLIB_VAPI=true        \\\n"
"      .. &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libical.xml:134
#, xml-text
msgid ""
"If you have <xref linkend=\"doxygen\"/>, <xref linkend=\"graphviz\"/>, and "
"<xref linkend=\"gtk-doc\"/> installed and wish to build the API "
"documentation, you should remove the <parameter>-D "
"ICAL_BUILD_DOCS=false</parameter> switch and issue:"
msgstr ""
"Se tiver <xref linkend=\"doxygen\"/>, <xref linkend=\"graphviz\"/> e <xref "
"linkend=\"gtk-doc\"/> instalados e desejar construir a documentação da API, "
"você deveria remover a chave <parameter>-D ICAL_BUILD_DOCS=false</parameter>"
" e emitir:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genlib/libical.xml:141
#, no-wrap, xml-text
msgid "<userinput>make docs</userinput>"
msgstr "<userinput>make docs</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libical.xml:144
#, xml-text
msgid "To test the results, issue: <command>make test</command>."
msgstr "Para testar os resultados, emita: <command>make test</command>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libical.xml:148
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genlib/libical.xml:151
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libical.xml:154
#, xml-text
msgid ""
"If you have built the API documentation, install by issuing, as <systemitem "
"class=\"username\">root</systemitem> user:"
msgstr ""
"Se você tiver construído a documentação da API, [então] instale emitindo, "
"como usuário(a) <systemitem class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genlib/libical.xml:159
#, no-wrap, xml-text
msgid ""
"<userinput>install -vdm755 /usr/share/doc/libical-&libical-version;/html &amp;&amp;\n"
"cp -vr apidocs/html/* /usr/share/doc/libical-&libical-version;/html</userinput>"
msgstr ""
"<userinput>install -vdm755 /usr/share/doc/libical-&libical-version;/html &amp;&amp;\n"
"cp -vr apidocs/html/* /usr/share/doc/libical-&libical-version;/html</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/genlib/libical.xml:165
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libical.xml:168
#, xml-text
msgid ""
"<parameter>-D CMAKE_BUILD_TYPE=Release</parameter>: This switch is used to "
"apply higher level of the compiler optimizations."
msgstr ""
"<parameter>-D CMAKE_BUILD_TYPE=Release</parameter>: Essa chave é usada para "
"aplicar um nível mais alto de otimização à compilação."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libical.xml:173
#, xml-text
msgid ""
"<parameter>-D SHARED_ONLY=yes</parameter>: This switch is used in order to "
"only build the shared libraries."
msgstr ""
"<parameter>-D SHARED_ONLY=yes</parameter>: Essa chave é usada para a "
"finalidade de construir somente as bibliotecas compartilhadas."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libical.xml:178
#, xml-text
msgid ""
"<parameter>-D ICAL_BUILD_DOCS=false</parameter>: This switch prevents "
"building the <application>GTK</application> documentation. Remove if you "
"want to build the documentation."
msgstr ""
"<parameter>-D ICAL_BUILD_DOCS=false</parameter>: Essa chave evita construir "
"a documentação do <application>GTK</application>. Remova se você desejar "
"construir a documentação."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libical.xml:184
#, xml-text
msgid ""
"<parameter>-D ICAL_BUILD_EXAMPLES=false</parameter>: This switch prevents "
"building examples. Remove if you want to build them."
msgstr ""
"<parameter>-D ICAL_BUILD_EXAMPLES=false</parameter>: Essa chave impede "
"construir exemplos. Remova se você quiser construí-los."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libical.xml:189
#, xml-text
msgid ""
"<parameter>-D GOBJECT_INTROSPECTION=true</parameter>: This switch is used to"
" generate GObject metadata bindings."
msgstr ""
"<parameter>-D GOBJECT_INTROSPECTION=true</parameter>: Essa chave é usada "
"para gerar ligações de meta dados do GObject."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libical.xml:194
#, xml-text
msgid ""
"<parameter>-D ICAL_GLIB_VAPI=true</parameter>: This switch is used in order "
"to build bindings for <xref linkend=\"vala\"/>."
msgstr ""
"<parameter>-D ICAL_GLIB_VAPI=true</parameter>: Essa chave é usada para a "
"finalidade de construir ligações para <xref linkend=\"vala\"/>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libical.xml:199
#, xml-text
msgid ""
"<option>-D USE_BUILTIN_TZDATA=yes</option>: This switch is used in order to "
"build using your own timezone data."
msgstr ""
"<option>-D USE_BUILTIN_TZDATA=yes</option>: Essa chave é usada para a "
"finalidade de construir usando teus próprios dados de fuso horário."

