#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/genlib/libical.xml:99
#, xml-text
msgid "Installation of libical"
msgstr "Instalação do libical"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libical.xml:102
#, xml-text
msgid ""
"Install <application>libical</application> by running the following "
"commands:"
msgstr ""
"Instale <application>libical</application> executando os seguintes comandos:"

#.  Still needed for version 4.0.0
#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genlib/libical.xml:109
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr  \\\n"
"      -D CMAKE_BUILD_TYPE=Release   \\\n"
"      -D LIBICAL_STATIC=NO          \\\n"
"      -D LIBICAL_BUILD_DOCS=false   \\\n"
"      -D LIBICAL_GLIB_VAPI=true     \\\n"
"      -D LIBICAL_JAVA_BINDINGS=OFF  \\\n"
"      -D LIBICAL_GOBJECT_INTROSPECTION=true \\\n"
"      .. &amp;&amp;\n"
"make -j1</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr  \\\n"
"      -D CMAKE_BUILD_TYPE=Release   \\\n"
"      -D LIBICAL_STATIC=NO          \\\n"
"      -D LIBICAL_BUILD_DOCS=false   \\\n"
"      -D LIBICAL_GLIB_VAPI=true     \\\n"
"      -D LIBICAL_JAVA_BINDINGS=OFF  \\\n"
"      -D LIBICAL_GOBJECT_INTROSPECTION=true \\\n"
"      .. &amp;&amp;\n"
"make -j1</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libical.xml:123
#, xml-text
msgid ""
"If you have <xref linkend=\"doxygen\"/>, <xref linkend=\"graphviz\"/>, and "
"<xref linkend=\"gtk-doc\"/> installed and wish to build the API "
"documentation, you should remove the <parameter>-D "
"LIBICAL_BUILD_DOCS=false</parameter> switch and issue:"
msgstr ""
"Se tiver <xref linkend=\"doxygen\"/>, <xref linkend=\"graphviz\"/> e <xref "
"linkend=\"gtk-doc\"/> instalados e desejar construir a documentação da API, "
"você deveria remover a chave <parameter>-D "
"LIBCAL_BUILD_DOCS=false</parameter> e emitir:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genlib/libical.xml:130
#, no-wrap, xml-text
msgid "<userinput>make docs</userinput>"
msgstr "<userinput>make docs</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libical.xml:133
#, xml-text
msgid "If you wish to run the tests, issue:"
msgstr "Se você desejar executar os testes, emita:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genlib/libical.xml:136
#, no-wrap, xml-text
msgid ""
"<userinput>cmake .. -D LIBICAL_BUILD_TESTING=ON &amp;&amp;\n"
"make &amp;&amp;\n"
"make test</userinput>"
msgstr ""
"<userinput>cmake .. -D LIBICAL_BUILD_TESTING=ON &amp;&amp;\n"
"make &amp;&amp;\n"
"make test</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libical.xml:141
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr "Agora, como o(a) usante <systemitem class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genlib/libical.xml:144
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libical.xml:147
#, xml-text
msgid ""
"If you have built the API documentation, install by issuing, as <systemitem "
"class=\"username\">root</systemitem> user:"
msgstr ""
"Se você tiver construído a documentação da API, [então] instale emitindo, "
"como usuário(a) <systemitem class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genlib/libical.xml:152
#, no-wrap, xml-text
msgid ""
"<userinput>install -vdm755 /usr/share/doc/libical-&libical-version;/html &amp;&amp;\n"
"cp -vr apidocs/html/* /usr/share/doc/libical-&libical-version;/html</userinput>"
msgstr ""
"<userinput>install -vdm755 /usr/share/doc/libical-&libical-version;/html &amp;&amp;\n"
"cp -vr apidocs/html/* /usr/share/doc/libical-&libical-version;/html</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/genlib/libical.xml:158
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libical.xml:161
#, xml-text
msgid ""
"<parameter>-D CMAKE_BUILD_TYPE=Release</parameter>: This switch is used to "
"apply higher level of the compiler optimizations."
msgstr ""
"<parameter>-D CMAKE_BUILD_TYPE=Release</parameter>: Essa chave é usada para "
"aplicar um nível mais alto de otimização à compilação."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libical.xml:166
#, xml-text
msgid ""
"<parameter>-D LIBICAL_STATIC=NO</parameter>: This switch is used in order to"
" only build the shared libraries."
msgstr ""
"<parameter>-D LIBICAL_STATIC=NO</parameter>: Essa chave é usada para a "
"finalidade de construir somente as bibliotecas compartilhadas."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libical.xml:171
#, xml-text
msgid ""
"<parameter>-D LIBICAL_BUILD_DOCS=false</parameter>: This switch prevents "
"building the <application>GTK</application> documentation. Remove if you "
"want to build the documentation."
msgstr ""
"<parameter>-D LIBCAL_BUILD_DOCS=false</parameter>: Essa chave evita "
"construir a documentação do <application>GTK</application>. Remova se você "
"quiser construir a documentação."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libical.xml:177
#, xml-text
msgid ""
"<parameter>-D LIBICAL_GOBJECT_INTROSPECTION=true</parameter>: This switch is"
" used to generate GObject metadata bindings."
msgstr ""
"<parameter>-D LIBICAL_GOBJECT_INTROSPECTION=true</parameter>: Essa chave é "
"usada para gerar ligações de meta dados do GObject."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libical.xml:182
#, xml-text
msgid ""
"<parameter>-D LIBICAL_GLIB_VAPI=true</parameter>: This switch is used to "
"build bindings for <xref linkend=\"vala\"/>."
msgstr ""
"<parameter>-D LIBICAL_GLIB_VAPI=true</parameter>: Essa chave é usada para "
"construir ligações para <xref linkend=\"vala\"/>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libical.xml:195
#, xml-text
msgid ""
"<option>-D LIBICAL_ENABLE_BUILTIN_TZDATA=true</option>: This switch is used "
"to use the included timezone data."
msgstr ""
"<option>-D LIBICAL_ENABLE_BUILTIN_TZDATA=true</option>: Essa chave é usada "
"para usar os dados de fuso horário incluídos."

