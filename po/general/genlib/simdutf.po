#: blfs-en/general/genlib/simdutf.xml:74
#, xml-text
msgid "Installation of simdutf"
msgstr "Instalação do simdutf"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/simdutf.xml:77
#, xml-text
msgid ""
"Install <application>simdutf</application> by running the following "
"commands:"
msgstr ""
"Instale <application>simdutf</application> executando os seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genlib/simdutf.xml:81
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr  \\\n"
"      -D CMAKE_BUILD_TYPE=Release   \\\n"
"      -D BUILD_SHARED_LIBS=ON       \\\n"
"      -G Ninja ..                   &amp;&amp;\n"
"ninja</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr  \\\n"
"      -D CMAKE_BUILD_TYPE=Release   \\\n"
"      -D BUILD_SHARED_LIBS=ON       \\\n"
"      -G Ninja ..                   &amp;&amp;\n"
"ninja</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/simdutf.xml:91
#, xml-text
msgid "To test the results, issue: <command>ninja test</command>."
msgstr "Para testar os resultados, emita: <command>ninja test</command>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/simdutf.xml:95
#, xml-text
msgid "Now, as the &root; user:"
msgstr "Agora, como o(a) usuário(a) &root;:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genlib/simdutf.xml:98
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr "<userinput>ninja install</userinput>"

