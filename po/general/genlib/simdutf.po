#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/simdutf.xml:28
#, xml-text
msgid ""
"The <application>simdutf</application> package contains a library used for "
"processing Unicode characters with SIMD optimizations. This includes the "
"SSE2 and AVX2 instruction sets and more."
msgstr ""
"O pacote <application>simdutf</application> contém uma biblioteca usada para"
" processar caracteres Unicode com otimizações SIMD. Isso inclui os conjuntos"
" de instruções SSE2 e AVX2 e mais."

