#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libusb.xml:29
#, xml-text
msgid ""
"The <application>libusb</application> package contains a library used by "
"some applications for USB device access."
msgstr ""
"O pacote <application>libusb</application> contém uma biblioteca usada por "
"alguns aplicativos para acesso a dispositivos USB."

