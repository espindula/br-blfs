#, xml-text
msgid "Installation of libxkbcommon"
msgstr "Instalação do libxkbcommon"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libxkbcommon.xml:112
#, xml-text
msgid "Fix an issue introduced in libxkbcommon-1.13.2:"
msgstr "Corrija um problema introduzido na libxkbcommon-1.13.2:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genlib/libxkbcommon.xml:115
#, no-wrap, xml-text
msgid ""
"<userinput>patch -Np1 -i ../libxkbcommon-&libxkbcommon-"
"version;-upstream_fix-1.patch</userinput>"
msgstr ""
"<userinput>patch -Np1 -i ../libxkbcommon-&libxkbcommon-"
"version;-upstream_fix-1.patch</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libxkbcommon.xml:118
#, xml-text
msgid ""
"Install <application>libxkbcommon</application> by running the following "
"commands:"
msgstr ""
"Instale <application>libxkbcommon</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genlib/libxkbcommon.xml:122
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup ..             \\\n"
"      --prefix=/usr        \\\n"
"      --buildtype=release  \\\n"
"      -D enable-docs=false &amp;&amp;\n"
"ninja</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup ..             \\\n"
"      --prefix=/usr        \\\n"
"      --buildtype=release  \\\n"
"      -D enable-docs=false &amp;&amp;\n"
"ninja</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libxkbcommon.xml:132
#, xml-text
msgid ""
"To test the results, ensure <command>Xvfb</command> and <xref "
"linkend='xkeyboard-config'/> are available, then issue: <command>ninja "
"test</command>."
msgstr ""
"Para testar os resultados, garanta que <command>Xvfb</command> e <xref "
"linkend='xkeyboard-config'/> estão disponíveis, então emita: <command>ninja "
"test</command>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libxkbcommon.xml:138
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genlib/libxkbcommon.xml:141
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr "<userinput>ninja install</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/genlib/libxkbcommon.xml:146
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libxkbcommon.xml:152
#, xml-text
msgid ""
"<option>-D enable-docs=true</option>: This switch enables documentation "
"generation. <xref linkend=\"doxygen\"/> is required."
msgstr ""
"<option>-D enable-docs=true</option>: Essa chave habilita geração de "
"documentação. <xref linkend=\"doxygen\"/> é exigido."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libxkbcommon.xml:158
#, xml-text
msgid ""
"<command>mv -v /usr/share/doc/libxkbcommon{,-&libxkbcommon-"
"version;}</command>: If you built the documentation, use this command to "
"install it in a versioned directory."
msgstr ""
"<command>mv -v /usr/share/doc/libxkbcommon{,-&libxkbcommon-"
"version;}</command>: se você construiu a documentação, use esse comando para"
" instalá-la em um diretório versionado."

