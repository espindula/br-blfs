#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/liburcu.xml:80
#, xml-text
msgid ""
"Install <application>liburcu</application> by running the following "
"commands:"
msgstr ""
"Instale <application>liburcu</application> executando os seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genlib/liburcu.xml:84
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr    \\\n"
"            --disable-static \\\n"
"            --docdir=/usr/share/doc/liburcu-&liburcu-version; &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>./configure --prefix=/usr   \\\n"
"            --disable-static \\\n"
"            --docdir=/usr/share/doc/liburcu-&liburcu-version; &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/liburcu.xml:90
#, xml-text
