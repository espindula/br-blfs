#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/genlib/spirv-tools.xml:79
#, xml-text
msgid "Installation of SPIRV-Tools"
msgstr "Instalação do SPIRV-Tools"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/spirv-tools.xml:82
#, xml-text
msgid ""
"Install <application>SPIRV-Tools</application> by running the following "
"commands:"
msgstr ""
"Instale <application>SPIRV-Tools</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genlib/spirv-tools.xml:86
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr     \\\n"
"      -D CMAKE_BUILD_TYPE=Release      \\\n"
"      -D SPIRV_WERROR=OFF              \\\n"
"      -D BUILD_SHARED_LIBS=ON          \\\n"
"      -D SPIRV_TOOLS_BUILD_STATIC=OFF  \\\n"
"      -D SPIRV-Headers_SOURCE_DIR=/usr \\\n"
"      -G Ninja .. &amp;&amp;\n"
"ninja</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr     \\\n"
"      -D CMAKE_BUILD_TYPE=Release      \\\n"
"      -D SPIRV_WERROR=OFF              \\\n"
"      -D BUILD_SHARED_LIBS=ON          \\\n"
"      -D SPIRV_TOOLS_BUILD_STATIC=OFF  \\\n"
"      -D SPIRV-Headers_SOURCE_DIR=/usr \\\n"
"      -G Ninja .. &amp;&amp;\n"
"ninja</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/spirv-tools.xml:99
#, xml-text
msgid "To test the results, issue: <command>ninja test</command>."
msgstr "Para testar os resultados, emita: <command>ninja test</command>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/spirv-tools.xml:103
#, xml-text
msgid "Now, as the &root; user:"
msgstr "Agora, como o(a) usuário(a) &root;:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genlib/spirv-tools.xml:106
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr "<userinput>ninja install</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/genlib/spirv-tools.xml:111
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/spirv-tools.xml:114
#, xml-text
msgid ""
"<parameter>-D SPIRV_WERROR=OFF</parameter>: This switch stops the build "
"system from treating warnings as errors."
msgstr ""
"<parameter>-D SPIRV_WERROR=OFF</parameter>: Essa chave impede que o sistema "
"de construção trate avisos como erros."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/spirv-tools.xml:119
#, xml-text
msgid ""
"<parameter>-D BUILD_SHARED_LIBS=ON</parameter>: This switch forces the build"
" system to install shared libraries instead of static libraries."
msgstr ""
"<parameter>-D BUILD_SHARED_LIBS=ON</parameter>: Essa chave força o sistema "
"de construção a instalar bibliotecas compartilhadas em vez de bibliotecas "
"estáticas."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/spirv-tools.xml:124
#, xml-text
msgid ""
"<parameter>-D SPIRV_TOOLS_BUILD_STATIC=OFF</parameter>: This switch disables"
" building static versions of the libraries."
msgstr ""
"<parameter>-D SPIRV_TOOLS_BUILD_STATIC=OFF</parameter>: Essa chave "
"desabilita construir versões estáticas das bibliotecas."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/spirv-tools.xml:129
#, xml-text
msgid ""
"<parameter>-D SPIRV-Headers_SOURCE_DIR</parameter>: This switch tells the "
"build system that <xref linkend=\"spirv-headers\" role=\"nodep\"/> is "
"installed in /usr. This is needed since the build system tries to use a copy"
" at <filename class='directory'>external/spirv-headers</filename> in the "
"source directory by default and the copy is not shipped (i.e. you need to "
"manually extract <xref linkend=\"spirv-headers\" role=\"nodep\"/> there if "
"you want to build with the copy)."
msgstr ""
"<parameter>-D SPIRV-Headers_SOURCE_DIR</parameter>: Essa chave informa ao "
"sistema de construção que <xref linkend=\"spirv-headers\" role=\"nodep\"/> "
"está instalado em /usr. Isso é necessário porque o sistema de construção "
"tenta usar uma cópia em <filename class='directory'>external/spirv-"
"headers</filename> no diretório do fonte por padrão e a cópia não é enviada "
"(ou seja, você precisa extrair manualmente <xref linkend=\"spirv-headers\" "
"role=\"nodep\"/> para lá se quiser construir com a cópia)."

