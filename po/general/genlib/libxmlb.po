#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/genlib/libxmlb.xml:89
#, xml-text
msgid "Installation of libxmlb"
msgstr "Instalação do libxmlb"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libxmlb.xml:92
#, xml-text
msgid ""
"Install <application>libxmlb</application> by running the following "
"commands:"
msgstr ""
"Instale <application>libxmlb</application> executando os seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genlib/libxmlb.xml:96
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr --buildtype=release -D gtkdoc=false .. &amp;&amp;\n"
"ninja</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr --buildtype=release -D gtkdoc=false .. &amp;&amp;\n"
"ninja</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libxmlb.xml:103
#, xml-text
msgid "To test the results, issue: <command>ninja test</command>."
msgstr "Para testar os resultados, emita: <command>ninja test</command>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libxmlb.xml:107
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genlib/libxmlb.xml:110
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr "<userinput>ninja install</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/genlib/libxmlb.xml:115
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libxmlb.xml:124
#, xml-text
msgid ""
"<parameter>-D gtkdoc=false</parameter>: This switch disables building the "
"API documentation. Remove it if you have <xref linkend=\"gtk-doc\" "
"role=\"nodep\"/> installed and wish to build the API documentation."
msgstr ""
"<parameter>-D gtkdoc=false</parameter>: Essa chave desabilita construir a "
"documentação da API. Remova-a se você tiver <xref linkend=\"gtk-doc\" "
"role=\"nodep\"/> instalado e desejar construir a documentação da API."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libxmlb.xml:131
#, xml-text
msgid ""
"<option>-D introspection=false</option>: Use this switch if you have not "
"built <xref linkend='glib2'/> with GObject Introspection."
msgstr ""
"<option>-D introspection=false</option>: Use essa chave se você não tiver "
"construído <xref linkend='glib2'/> com GObject Introspection."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libxmlb.xml:136
#, xml-text
msgid ""
"<option>-D stemmer=true</option>: Use this switch if you have <ulink "
"url=\"https://github.com/zvelo/libstemmer\">libstemmer</ulink> installed and"
" wish to build stemmer support."
msgstr ""
"<option>-D stemmer=true</option>: Use essa chave se você tiver <ulink "
"url=\"https://github.com/zvelo/libstemmer\">libstemmer</ulink> instalado e "
"desejar construir suporte para lematizador."

