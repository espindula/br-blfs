#, no-wrap, xml-text
msgid ""
"<userinput>make install &amp;&amp;\n"
"ln -sf node /usr/share/doc/node-&nodejs-version;</userinput>"
msgstr ""
"<userinput>make install &amp;&amp;\n"
"ln -sf node /usr/share/doc/node-&nodejs-version;</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/genlib/nodejs.xml:180
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/nodejs.xml:183
#, xml-text
msgid ""
"<parameter>--with-intl=system-icu</parameter>: This parameter uses the "
"system version of <application>ICU</application>. Other values are "
"<option>full-icu</option> (to build a local, full "
"<application>icu</application> library) and <option>small-icu</option> (to "
"build a local, minimal <application>ICU</application> library)."
msgstr ""
"<parameter>--with-intl=system-icu</parameter>: Esse parâmetro usa a versão "
"do sistema do <application>ICU</application>. Outros valores são "
"<option>full-icu</option> (para construir uma biblioteca completa local "
"<application>icu</application>) e <option>small-icu</option> (para construir"
" uma biblioteca mínima local <application>ICU</application>)."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/nodejs.xml:191
#, xml-text
msgid ""
"<parameter>--shared-{brotli,cares,libuv,nghttp2,openssl,simdutf,zlib}</parameter>:"
" This parameter uses the system installed libraries instead of local copies."
msgstr ""
"<parameter>--shared-{brotli,cares,libuv,nghttp2,openssl,simdutf,zlib}</parameter>:"
" Esse parâmetro usa as bibliotecas instaladas do sistema em vez das cópias "
"locais."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/nodejs.xml:197
#, xml-text
msgid ""
"<option>--without-npm</option>: This option tells the build system to not "
"build <application>npm</application> (use if you'd like to build a separate "
"<application>npm</application> later)."
msgstr ""
"<option>--without-npm</option>: Essa opção diz para o sistema de construção "
"para não construir <application>npm</application> (use se você gostaria de "
"construir um <application>npm</application> separado posteriormente)."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/nodejs.xml:203
#, xml-text
msgid ""
"<option>--shared-http-parser</option>: This option uses the system installed"
" <application>http-parser</application> library instead of a local copy if "
"you have installed it."
msgstr ""
"<option>--shared-http-parser</option>: Essa opção usa a biblioteca do "
"<application>http-parser</application> instalada do sistema em vez de uma "
"cópia local se você a tiver instalado."

