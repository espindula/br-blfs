#: blfs-en/general/genlib/wv.xml:85
#, xml-text
msgid "Installation of wv"
msgstr "Instalação do wv"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/wv.xml:88
#, xml-text
msgid ""
"Install <application>wv</application> by running the following commands:"
msgstr ""
"Instale <application>wv</application> executando os seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genlib/wv.xml:91
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr --disable-static &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>./configure --prefix=/usr --disable-static &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/wv.xml:95
#, xml-text
msgid "This package does not have a test suite."
msgstr "Esse pacote não tem uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/wv.xml:99
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr "Agora, como o(a) usante <systemitem class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genlib/wv.xml:102
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

