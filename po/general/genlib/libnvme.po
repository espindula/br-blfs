#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/genlib/libnvme.xml:85
#, xml-text
msgid "Installation of libnvme"
msgstr "Instalação do libnvme"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libnvme.xml:88
#, xml-text
msgid ""
"Install <application>libnvme</application> by running the following "
"commands:"
msgstr ""
"Instale o <application>libnvme</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genlib/libnvme.xml:92
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr --buildtype=release -D libdbus=auto .. &amp;&amp;\n"
"ninja</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr --buildtype=release -D libdbus=auto .. &amp;&amp;\n"
"ninja</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libnvme.xml:99
#, xml-text
msgid "To run the tests, issue: <command>ninja test</command>."
msgstr "Para executar os testes, emita: <command>ninja test</command>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libnvme.xml:103
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genlib/libnvme.xml:106
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr "<userinput>ninja install</userinput>"

