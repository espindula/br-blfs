#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/liblinear.xml:98
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genlib/liblinear.xml:101
#, no-wrap, xml-text
msgid ""
"<userinput>install -vm644 linear.h /usr/include   &amp;&amp;\n"
"install -vm755 liblinear.so.6 /usr/lib &amp;&amp;\n"
"ln -sfv liblinear.so.6 /usr/lib/liblinear.so</userinput>"
msgstr ""
"<userinput>install -vm644 linear.h /usr/include   &amp;&amp;\n"
"install -vm755 liblinear.so.6 /usr/lib &amp;&amp;\n"
"ln -sfv liblinear.so.6 /usr/lib/liblinear.so</userinput>"

