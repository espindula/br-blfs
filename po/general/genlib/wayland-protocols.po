#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/wayland-protocols.xml:29
#, xml-text
msgid ""
"The <application>Wayland-Protocols</application> package contains additional"
" Wayland protocols that add functionality outside of protocols already in "
"the Wayland core."
msgstr ""
"O pacote <application>Wayland-Protocols</application> contém protocolos "
"adicionais do Wayland que adicionam funcionalidade fora dos protocolos já no"
" núcleo do Wayland."

