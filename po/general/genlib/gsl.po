#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/genlib/gsl.xml:80
#, xml-text
msgid "Installation of Gsl"
msgstr "Instalação do Gsl"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/gsl.xml:83
#, xml-text
msgid ""
"Install <application>Gsl</application> by running the following commands:"
msgstr ""
"Instale <application>Gsl</application> executando os seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genlib/gsl.xml:86
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr --disable-static &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>./configure --prefix=/usr --disable-static &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/gsl.xml:90
#, xml-text
msgid ""
"If you have <xref linkend=\"sphinx_rtd_theme\"/> installed, build the "
"documentation with:"
msgstr ""
"Se você tiver <xref linkend=\"sphinx_rtd_theme\"/> instalado, [então] "
"construa a documentação com:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genlib/gsl.xml:94
#, no-wrap, xml-text
msgid "<userinput>make html</userinput>"
msgstr "<userinput>make html</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/gsl.xml:97
#, xml-text
msgid "To test the results, issue: <command>make check</command>."
msgstr "Para testar os resultados, emita: <command>make check</command>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/gsl.xml:101
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr "Agora, como o(a) usante <systemitem class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genlib/gsl.xml:104
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/gsl.xml:107
#, xml-text
msgid ""
"If you built the documentation, install it (as <systemitem "
"class=\"username\">root</systemitem>) with:"
msgstr ""
"Se você construiu a documentação, [então] instale-a (como <systemitem "
"class=\"username\">root</systemitem>) com:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genlib/gsl.xml:112
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir                   /usr/share/doc/gsl-&gsl-version; &amp;&amp;\n"
"cp -R doc/_build/html/* /usr/share/doc/gsl-&gsl-version;</userinput>"
msgstr ""
"<userinput>mkdir                   /usr/share/doc/gsl-&gsl-version; &amp;&amp;\n"
"cp -R doc/_build/html/* /usr/share/doc/gsl-&gsl-version;</userinput>"

