#: blfs-en/general/genlib/double-conversion.xml:80
#, xml-text
msgid "Installation of Double-conversion"
msgstr "Instalação do Double-conversion"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/double-conversion.xml:83
#, xml-text
msgid ""
"Install <application>Double-conversion</application> by running the "
"following commands:"
msgstr ""
"Instale <application>Double-conversion</application> executando os seguintes"
" comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genlib/double-conversion.xml:88
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr        \\\n"
"      -D CMAKE_POLICY_VERSION_MINIMUM=3.5 \\\n"
"      -D BUILD_SHARED_LIBS=ON             \\\n"
"      -D BUILD_TESTING=ON                 \\\n"
"      ..                                  &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr        \\\n"
"      -D CMAKE_POLICY_VERSION_MINIMUM=3.5 \\\n"
"      -D BUILD_SHARED_LIBS=ON             \\\n"
"      -D BUILD_TESTING=ON                 \\\n"
"      ..                                  &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/double-conversion.xml:99
#, xml-text
msgid "To test the results, issue: <command>make test</command>."
msgstr "Para testar os resultados, emita: <command>make test</command>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/double-conversion.xml:103
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr "Agora, como o(a) usante <systemitem class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genlib/double-conversion.xml:106
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/genlib/double-conversion.xml:110
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/double-conversion.xml:116
#, xml-text
msgid ""
"<parameter>-D BUILD_SHARED_LIBS=ON</parameter>: This switch forces cmake to "
"build a shared version of the library instead of the static version."
msgstr ""
"<parameter>-D BUILD_SHARED_LIBS=ON</parameter>: Essa chave força o cmake a "
"construir uma versão compartilhada da biblioteca em vez da versão estática."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/double-conversion.xml:121
#, xml-text
msgid ""
"<parameter>-D BUILD_TESTING=ON</parameter>: This switch builds the test "
"programs."
msgstr ""
"<parameter>-D BUILD_TESTING=ON</parameter>: Essa chave constrói os "
"aplicativos de teste."

