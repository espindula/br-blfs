#, xml-text
#~ msgid "fcf38f534bb8996984dba978ee3e27f4"
#~ msgstr "fcf38f534bb8996984dba978ee3e27f4"

#, xml-text
#~ msgid "1.9 MB"
#~ msgstr "1,9 MB"

#, xml-text
#~ msgid "Required"
#~ msgstr "Exigidas"

#, xml-text
#~ msgid ""
#~ "<xref linkend=\"git\"/> (used by meson during configuration to determine the"
#~ " version of libxml2 being built)"
#~ msgstr ""
#~ "<xref linkend=\"git\"/> (usado por meson durante a configuração para "
#~ "determinar a versão da libxml2 sendo construída)"

#, xml-text
#~ msgid "4f44fc1e16ed59c91022e4e89864bcdb"
#~ msgstr "4f44fc1e16ed59c91022e4e89864bcdb"

#, xml-text
#~ msgid "84 MB (with tests)"
#~ msgstr "84 MB (com testes)"

#, xml-text
#~ msgid ""
#~ "Required patch: <ulink url=\"&patch-"
#~ "root;/libxml2-&libxml2-version;-upstream_fix-1.patch\"/>"
#~ msgstr ""
#~ "Remendo exigido: <ulink url=\"&patch-"
#~ "root;/libxml2-&libxml2-version;-upstream_fix-1.patch\"/>"

#, xml-text
#~ msgid "Optional"
#~ msgstr "Opcionais"

#, xml-text
#~ msgid "<xref linkend=\"valgrind\"/> (may be used in the tests)"
#~ msgstr "<xref linkend=\"valgrind\"/> (possivelmente seja usado nos testes)"

#, xml-text
#~ msgid ""
#~ "First, apply a patch from upstream to fix a failure parsing not normalized "
#~ "yet attribute values (for example, the source of BLFS itself and the source "
#~ "of <xref linkend='postgresql'/> contain such values):"
#~ msgstr ""
#~ "Primeiro, aplique um remendo originário do fluxo de desenvolvimento para "
#~ "corrigir uma falha na análise de valores de atributos ainda não normalizados"
#~ " (por exemplo, o fonte do próprio BLFS e o fonte de <xref "
#~ "linkend='postgresql'/> contêm esses valores):"

#, no-wrap, xml-text
#~ msgid ""
#~ "<userinput>patch -Np1 -i "
#~ "../libxml2-&libxml2-version;-upstream_fix-1.patch</userinput>"
#~ msgstr ""
#~ "<userinput>patch -Np1 -i "
#~ "../libxml2-&libxml2-version;-upstream_fix-1.patch</userinput>"

#, no-wrap, xml-text
#~ msgid ""
#~ "<userinput>./configure --prefix=/usr     \\\n"
#~ "            --sysconfdir=/etc \\\n"
#~ "            --disable-static  \\\n"
#~ "            --with-history    \\\n"
#~ "            --with-icu        \\\n"
#~ "            --docdir=/usr/share/doc/libxml2-&libxml2-version; &amp;&amp;\n"
#~ "make</userinput>"
#~ msgstr ""
#~ "<userinput>./configure --prefix=/usr     \\\n"
#~ "            --sysconfdir=/etc \\\n"
