#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/genlib/appstream.xml:94
#, xml-text
msgid "Installation of AppStream"
msgstr "Instalação do AppStream"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/appstream.xml:97
#, xml-text
msgid ""
"Install <application>AppStream</application> by running the following "
"commands:"
msgstr ""
"Instale <application>AppStream</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genlib/appstream.xml:101
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr       \\\n"
"            --buildtype=release \\\n"
"            -D apidocs=false    \\\n"
"            -D stemming=false   .. &amp;&amp;\n"
"ninja</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr       \\\n"
"            --buildtype=release \\\n"
"            -D apidocs=false    \\\n"
"            -D stemming=false   .. &amp;&amp;\n"
"ninja</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/appstream.xml:111
#, xml-text
msgid "To test the results, issue: <command>ninja test</command>."
msgstr "Para testar os resultados, emita: <command>ninja test</command>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/appstream.xml:115
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genlib/appstream.xml:118
#, no-wrap, xml-text
msgid ""
"<userinput>ninja install &amp;&amp;\n"
"mv -v /usr/share/doc/appstream{,-&appstream-version;}</userinput>"
msgstr ""
"<userinput>ninja install &amp;&amp;\n"
"mv -v /usr/share/doc/appstream{,-&appstream-version;}</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/genlib/appstream.xml:124
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/appstream.xml:130
#, xml-text
msgid ""
"<parameter>-D apidocs=false</parameter>: This switch disables building the "
"API documentation. Remove it if you have <xref linkend=\"gi-docgen\" "
"role=\"nodep\"/> installed and wish to regenerate the API documentation.  "
"When the API documentation is not regenerated, a pre-built copy is installed"
" anyway."
msgstr ""
"<parameter>-D apidocs=false</parameter>: Essa chave desabilita construir a "
"documentação da API. Remova-a se você tiver <xref linkend=\"gi-docgen\" "
"role=\"nodep\"/> instalado e desejar regerar a documentação da API. Quando a"
" documentação da API não for regerada, uma cópia pré construída será "
"instalada de qualquer maneira."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/appstream.xml:138
#, xml-text
msgid ""
"<parameter>-D stemming=false</parameter>: This switch disables stemming "
"support. Remove this switch if you have <ulink "
"url=\"https://github.com/zvelo/libstemmer\">libstemmer</ulink> installed and"
" want faster searches."
msgstr ""
"<parameter>-D stemming=false</parameter>: Essa chave desabilita o suporte de"
" lematização. Remova essa chave se você tiver <ulink "
"url=\"https://github.com/zvelo/libstemmer\">libstemmer</ulink> instalado e "
"quiser pesquisas mais rápidas."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/appstream.xml:145
#, xml-text
msgid ""
"<option>-D qt=true</option>: Use this option if you have <xref "
"linkend=\"qt6\" role=\"nodep\"/> installed and you want to build support for"
" Qt6 applications into this package."
msgstr ""
"<option>-D qt=true</option>: Use essa opção se você tiver <xref "
"linkend=\"qt6\" role=\"nodep\"/> instalado e quiser construir suporte para "
"aplicativos Qt6 nesse pacote."

#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/genlib/appstream.xml:153
#, xml-text
msgid "Configuring AppStream"
msgstr "Configurando AppStream"

#. type: Content of: <sect1><sect2><sect3><title>
#: blfs-en/general/genlib/appstream.xml:156
#, xml-text
msgid "Config Files"
msgstr "Arquivos de Configuração"

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/general/genlib/appstream.xml:159
#, xml-text
msgid "<filename>/usr/share/metainfo/org.linuxfromscratch.lfs.xml</filename>"
msgstr "<filename>/usr/share/metainfo/org.linuxfromscratch.lfs.xml</filename>"

#. type: Content of: <sect1><sect2><sect3><title>
#: blfs-en/general/genlib/appstream.xml:164
#, xml-text
msgid "Configuration Information"
msgstr "Informação de Configuração"

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/general/genlib/appstream.xml:167
#, xml-text
msgid ""
"<application>AppStream</application> expects an operating system metainfo "
"file describing the GNU/Linux distribution.  As the &root; user, create the "
"file describing LFS:"
msgstr ""
"<application>AppStream</application> espera um arquivo de meta informações "
"do sistema operacional que descreva a distribuição GNU/Linux. Como o(a) "
"usuário(a) &root;, crie o arquivo descrevendo o LFS:"

#. type: Content of: <sect1><sect2><sect3><indexterm><primary>
#: blfs-en/general/genlib/appstream.xml:174
#, xml-text
msgid "/usr/share/metainfo/org.linuxfromscratch.lfs.xml"
msgstr "/usr/share/metainfo/org.linuxfromscratch.lfs.xml"

#. type: Content of: <sect1><sect2><sect3><screen>
#: blfs-en/general/genlib/appstream.xml:178
#, no-wrap, xml-text
msgid ""
"<userinput>install -vdm755 /usr/share/metainfo &amp;&amp;\n"
"cat > /usr/share/metainfo/org.linuxfromscratch.lfs.xml &lt;&lt; EOF\n"
"<literal>&lt;?xml version=\"1.0\" encoding=\"UTF-8\"?&gt;\n"
"&lt;component type=\"operating-system\"&gt;\n"
"  &lt;id&gt;org.linuxfromscratch.lfs&lt;/id&gt;\n"
"  &lt;name&gt;Linux From Scratch&lt;/name&gt;\n"
"  &lt;summary&gt;A customized Linux system built entirely from source&lt;/summary&gt;\n"
"  &lt;description&gt;\n"
"    &lt;p&gt;\n"
"      Linux From Scratch (LFS) is a project that provides you with\n"
"      step-by-step instructions for building your own customized Linux\n"
"      system entirely from source.\n"
"    &lt;/p&gt;\n"
"  &lt;/description&gt;\n"
"  &lt;url type=\"homepage\"&gt;https://www.linuxfromscratch.org/lfs/&lt;/url&gt;\n"
"  &lt;metadata_license&gt;MIT&lt;/metadata_license&gt;\n"
"  &lt;developer id='linuxfromscratch.org'&gt;\n"
"    &lt;name&gt;The Linux From Scratch Editors&lt;/name&gt;\n"
"  &lt;/developer&gt;\n"
"\n"
"  &lt;releases&gt;\n"
"    &lt;release version=\"&lfs-appstream-meta-ver;\" type=\"&lfs-appstream-meta-type;\" date=\"&lfs-appstream-meta-date;\"&gt;\n"
"      &lt;description&gt;\n"
"        &lt;p&gt;Now contains Binutils 2.45, GCC-15.2.0, Glibc-2.42,\n"
"        Linux kernel 6.16, and twelve security updates.&lt;/p&gt;\n"
"      &lt;/description&gt;\n"
"    &lt;/release&gt;\n"
"\n"
"    &lt;release version=\"12.3\" type=\"stable\" date=\"2025-03-05\"&gt;\n"
"      &lt;description&gt;\n"
"        &lt;p&gt;Now contains Binutils 2.44, GCC-14.2.0, Glibc-2.41, and\n"
"        Linux Kernel 6.13, and three security updates.&lt;/p&gt;\n"
"      &lt;/description&gt;\n"
"    &lt;/release&gt;\n"
"  &lt;/releases&gt;\n"
"&lt;/component&gt;</literal>\n"
"EOF</userinput>"
msgstr ""
"<userinput>install -vdm755 /usr/share/metainfo &amp;&amp;\n"
"cat > /usr/share/metainfo/org.linuxfromscratch.lfs.xml &lt;&lt; EOF\n"
"<literal>&lt;?xml version=\"1.0\" encoding=\"UTF-8\"?&gt;\n"
"&lt;component type=\"operating-system\"&gt;\n"
"  &lt;id&gt;org.linuxfromscratch.lfs&lt;/id&gt;\n"
"  &lt;name&gt;Linux From Scratch&lt;/name&gt;\n"
"  &lt;summary&gt;A customized Linux system built entirely from source&lt;/summary&gt;\n"
"  &lt;description&gt;\n"
"    &lt;p&gt;\n"
"      Linux From Scratch (LFS) is a project that provides you with\n"
"      step-by-step instructions for building your own customized Linux\n"
"      system entirely from source.\n"
"    &lt;/p&gt;\n"
"  &lt;/description&gt;\n"
"  &lt;url type=\"homepage\"&gt;https://www.linuxfromscratch.org/lfs/&lt;/url&gt;\n"
"  &lt;metadata_license&gt;MIT&lt;/metadata_license&gt;\n"
"  &lt;developer id='linuxfromscratch.org'&gt;\n"
"    &lt;name&gt;The Linux From Scratch Editors&lt;/name&gt;\n"
"  &lt;/developer&gt;\n"
"\n"
"  &lt;releases&gt;\n"
"    &lt;release version=\"&lfs-appstream-meta-ver;\" type=\"&lfs-appstream-meta-type;\" date=\"&lfs-appstream-meta-date;\"&gt;\n"
"      &lt;description&gt;\n"
"        &lt;p&gt;Now contains Binutils 2.45, GCC-15.2.0, Glibc-2.42,\n"
"        Linux kernel 6.16, and twelve security updates.&lt;/p&gt;\n"
"      &lt;/description&gt;\n"
"    &lt;/release&gt;\n"
"\n"
"    &lt;release version=\"12.3\" type=\"stable\" date=\"2025-03-05\"&gt;\n"
"      &lt;description&gt;\n"
"        &lt;p&gt;Now contains Binutils 2.44, GCC-14.2.0, Glibc-2.41, and\n"
"        Linux Kernel 6.13, and three security updates.&lt;/p&gt;\n"
"      &lt;/description&gt;\n"
"    &lt;/release&gt;\n"
"  &lt;/releases&gt;\n"
"&lt;/component&gt;</literal>\n"
"EOF</userinput>"

