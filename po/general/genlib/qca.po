#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/genlib/qca.xml:107
#, xml-text
msgid "Installation of Qca"
msgstr "Instalação do Qca"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/qca.xml:110
#, xml-text
msgid "Fix the location of the CA certificates:"
msgstr "Corrija o local dos certificados de AC:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genlib/qca.xml:113
#, no-wrap, xml-text
msgid ""
"<userinput>sed -i 's@cert.pem@certs/ca-bundle.crt@' "
"CMakeLists.txt</userinput>"
msgstr ""
"<userinput>sed -i 's@cert.pem@certs/ca-bundle.crt@' "
"CMakeLists.txt</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/qca.xml:116
#, xml-text
msgid ""
"Install <application>Qca</application> by running the following commands:"
msgstr ""
"Instale <application>Qca</application> executando os seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genlib/qca.xml:120
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=$QT6DIR            \\\n"
"      -D CMAKE_BUILD_TYPE=Release                \\\n"
"      -D QT6=ON                                  \\\n"
"      -D QCA_INSTALL_IN_QT_PREFIX=ON             \\\n"
"      -D QCA_MAN_INSTALL_DIR:PATH=/usr/share/man \\\n"
"      .. &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=$QT6DIR            \\\n"
"      -D CMAKE_BUILD_TYPE=Release                \\\n"
"      -D QT6=ON                                  \\\n"
"      -D QCA_INSTALL_IN_QT_PREFIX=ON             \\\n"
"      -D QCA_MAN_INSTALL_DIR:PATH=/usr/share/man \\\n"
"      .. &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/qca.xml:132
#, xml-text
msgid "To test the results, issue <command>make test</command>."
msgstr "Para testar os resultados, emita: <command>make test</command>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/qca.xml:136
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genlib/qca.xml:139
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/genlib/qca.xml:144
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/qca.xml:147
#, xml-text
msgid ""
"<parameter>-D CMAKE_BUILD_TYPE=Release</parameter>: This switch is used to "
"apply a higher level of compiler optimizations."
msgstr ""
"<parameter>-D CMAKE_BUILD_TYPE=Release</parameter>: Essa chave é usada para "
"aplicar um nível mais alto de otimização à compilação."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/qca.xml:152
#, xml-text
msgid ""
"<parameter>-D QT6=ON</parameter>: Ensure the packages is built with <xref "
"linkend=\"qt6\"/>."
msgstr ""
"<parameter>-D QT6=ON</parameter>: Assegura que os pacotes sejam construídos "
"com <xref linkend=\"qt6\"/>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/qca.xml:157
#, xml-text
msgid ""
"<parameter>-D QCA_MAN_INSTALL_DIR:PATH=/usr/share/man</parameter>: Install "
"the qca man page in the normal location."
msgstr ""
"<parameter>-D QCA_MAN_INSTALL_DIR:PATH=/usr/share/man</parameter>: Instala a"
" página de manual do qca no local normal."

