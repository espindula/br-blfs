#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/genlib/protobuf.xml:78
#, xml-text
msgid "Installation of Protobuf"
msgstr "Instalação do Protobuf"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/protobuf.xml:81
#, xml-text
msgid ""
"Install <application>Protobuf</application> by running the following "
"commands:"
msgstr ""
"Instale <application>Protobuf</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genlib/protobuf.xml:85
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr      \\\n"
"      -D CMAKE_BUILD_TYPE=Release       \\\n"
"      -D CMAKE_SKIP_INSTALL_RPATH=ON    \\\n"
"      -D protobuf_BUILD_TESTS=OFF       \\\n"
"      -D protobuf_BUILD_SHARED_LIBS=ON  \\\n"
"      -G Ninja ..                       &amp;&amp;\n"
"ninja</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr      \\\n"
"      -D CMAKE_BUILD_TYPE=Release       \\\n"
"      -D CMAKE_SKIP_INSTALL_RPATH=ON    \\\n"
"      -D protobuf_BUILD_TESTS=OFF       \\\n"
"      -D protobuf_BUILD_SHARED_LIBS=ON  \\\n"
"      -G Ninja ..                       &amp;&amp;\n"
"ninja</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/protobuf.xml:97
#, xml-text
msgid ""
"This package does come with a test suite, but it requires <ulink "
"url=\"https://github.com/google/googletest\">gtest</ulink>, which is not "
"part of BLFS."
msgstr ""
"Esse pacote vem com uma suíte de teste, mas ela exige <ulink "
"url=\"https://github.com/google/googletest\">gtest</ulink>, que não é parte "
"do BLFS."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/protobuf.xml:103
#, xml-text
msgid "Now, as the &root; user:"
msgstr "Agora, como o(a) usuário(a) &root;:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genlib/protobuf.xml:106
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr "<userinput>ninja install</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/genlib/protobuf.xml:117
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/protobuf.xml:123
#, xml-text
msgid ""
"<parameter>-D protobuf_BUILD_TESTS=OFF</parameter>: This parameter prevents "
"the tests from being built because <ulink "
"url=\"https://github.com/google/googletest\">gtest</ulink> is not part of "
"BLFS."
msgstr ""
"<parameter>-D protobuf_BUILD_TESTS=OFF</parameter>: Esse parâmetro impede os"
" testes de serem construídos porque <ulink "
"url=\"https://github.com/google/googletest\">gtest</ulink> não faz parte do "
"BLFS."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/protobuf.xml:138
#, xml-text
msgid ""
"<parameter>-D protobuf_BUILD_SHARED_LIBS=ON</parameter>: This parameter "
"enables building shared versions of the libraries provided by this package "
"instead of static versions."
msgstr ""
"<parameter>-D protobuf_BUILD_SHARED_LIBS=ON</parameter>: Esse parâmetro "
"habilita construir versões compartilhadas das bibliotecas fornecidas por "
"esse pacote em vez das versões estáticas."

