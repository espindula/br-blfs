#, xml-text
msgid "Introduction to libseccomp"
msgstr "Introdução ao libseccomp"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libseccomp.xml:34
#, xml-text
msgid ""
"The <application>libseccomp</application> package provides an easy to use "
"and platform independent interface to the <application>Linux</application> "
"kernel's syscall filtering mechanism."
msgstr ""
"O pacote <application>libseccomp</application> fornece uma interface fácil "
"de usar e independente de plataforma para o mecanismo de filtragem "
"\"syscall\" do núcleo <application>Linux</application>."

