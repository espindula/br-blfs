#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/genlib/fmt.xml:26
#, xml-text
msgid "Introduction to fmt"
msgstr "Introdução ao fmt"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/fmt.xml:29
#, xml-text
msgid ""
"The <application>fmt</application> package is an open-source formatting "
"library providing a fast and safe alternative to C stdio and C++ iostreams."
msgstr ""
"O pacote <application>fmt</application> é uma biblioteca de formatação de "
"fonte aberto que fornece uma alternativa rápida e segura ao stdio do C e ao "
"iostreams do C++."

