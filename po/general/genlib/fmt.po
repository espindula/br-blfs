#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/genlib/fmt.xml:88
#, xml-text
msgid "Installation of fmt"
msgstr "Instalação do fmt"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/fmt.xml:91
#, xml-text
msgid ""
"Install <application>fmt</application> by running the following commands:"
msgstr ""
"Instale <application>fmt</application> executando os seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genlib/fmt.xml:95
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr     \\\n"
"      -D CMAKE_INSTALL_LIBDIR=/usr/lib \\\n"
"      -D BUILD_SHARED_LIBS=ON          \\\n"
"      -D FMT_TEST=OFF                  \\\n"
"      -G Ninja ..                      &amp;&amp;\n"
"ninja</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr     \\\n"
"      -D CMAKE_INSTALL_LIBDIR=/usr/lib \\\n"
"      -D BUILD_SHARED_LIBS=ON          \\\n"
"      -D FMT_TEST=OFF                  \\\n"
"      -G Ninja ..                      &amp;&amp;\n"
"ninja</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/fmt.xml:106
#, xml-text
msgid "If you have enabled tests, issue: <command>ninja test</command>."
msgstr ""
"Se você tiver habilitado testes, emita: <command>ninja test</command>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/fmt.xml:110
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genlib/fmt.xml:113
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr "<userinput>ninja install</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/genlib/fmt.xml:118
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/fmt.xml:121
#, xml-text
msgid ""
"<parameter>-D FMT_TEST=OFF</parameter>: This switch initializes the package "
"tests.  Set to ON if you wish to run tests."
msgstr ""
"<parameter>-D FMT_TEST=OFF</parameter>: Essa chave inicializa os testes do "
"pacote. Configure para ON se você desejar executar testes."

