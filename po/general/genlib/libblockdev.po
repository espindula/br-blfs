#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/genlib/libblockdev.xml:107
#, xml-text
msgid "Installation of libblockdev"
msgstr "Instalação do libblockdev"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libblockdev.xml:116
#, xml-text
msgid ""
"Install <application>libblockdev</application> by running the following "
"commands:"
msgstr ""
"Instale o <application>libblockdev</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genlib/libblockdev.xml:120
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr      \\\n"
"            --sysconfdir=/etc  \\\n"
"            --with-python3     \\\n"
"            --without-escrow   \\\n"
"            --without-gtk-doc  \\\n"
"            --without-lvm      \\\n"
"            --without-lvm_dbus \\\n"
"            --without-nvdimm   \\\n"
"            --without-tools    &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>./configure --prefix=/usr      \\\n"
"            --sysconfdir=/etc  \\\n"
"            --with-python3     \\\n"
"            --without-escrow   \\\n"
"            --without-gtk-doc  \\\n"
"            --without-lvm      \\\n"
"            --without-lvm_dbus \\\n"
"            --without-nvdimm   \\\n"
"            --without-tools    &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libblockdev.xml:132
#, xml-text
msgid ""
"The test suite requires <application>targetcli</application>, which is not a"
" part of BLFS."
msgstr ""
"A suíte de teste exige <application>targetcli</application>, que não é parte"
" do BLFS."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libblockdev.xml:137
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genlib/libblockdev.xml:140
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/genlib/libblockdev.xml:145
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libblockdev.xml:148
#, xml-text
msgid ""
"<parameter>--without-escrow</parameter>: This switch allows building "
"<application>libblockdev</application> without volume_key installed."
msgstr ""
"<parameter>--without-escrow</parameter>: Essa chave permite construir "
"<application>libblockdev</application> sem volume_key instalado."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libblockdev.xml:153
#, xml-text
msgid ""
"<parameter>--without-lvm</parameter> <parameter>--without-"
"lvm_dbus</parameter> <parameter>--without-tools</parameter>: The combination"
" of these switches allows building <application>libblockdev</application> "
"without <xref linkend=\"parted\"/> installed.  Remove it if you've installed"
" <xref linkend=\"parted\"/> and wish to build the <command>lvm-cache-"
"stats</command> or <command>vfat-resize</command> utilities, or wish "
"<application>libblockdev</application> to support logical volumes."
msgstr ""
"<parameter>--without-lvm</parameter> <parameter>--without-"
"lvm_dbus</parameter> <parameter>--without-tools</parameter>: A combinação "
"dessas chaves permite construir <application>libblockdev</application> sem "
"<xref linkend=\"parted\"/> instalado. Remova-as se você tiver instalado "
"<xref linkend=\"parted\"/> e desejar construir os utilitários <command>lvm-"
"cache-stats</command> ou <command>vfat-resize</command>, ou desejar que "
"<application>libblockdev</application> suporte volumes lógicos."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libblockdev.xml:166
#, xml-text
msgid ""
"<option>--without-btrfs --without-mdraid --without-tools</option>: The "
"combination of these switches allows building "
"<application>libblockdev</application> without <xref "
"linkend=\"libbytesize\"/> installed.  The <option>--without-mdraid</option> "
"option will break <xref linkend=\"udisks2\"/>, so don't use it unless you "
"really know what you are doing."
msgstr ""
"<option>--without-btrfs --without-mdraid --without-tools</option>: A "
"combinação dessas chaves permite construir "
"<application>libblockdev</application> sem <xref linkend=\"libbytesize\"/> "
"instalado. A opção <option>--without-mdraid</option> quebrará <xref "
"linkend=\"udisks2\"/>, de forma que não a use, a menos que você realmente "
"saiba o que está fazendo."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libblockdev.xml:176
#, xml-text
msgid ""
"<option>--without-crypto</option>: This switch allows building "
"<application>libblockdev</application> without <xref "
"linkend=\"cryptsetup\"/> or <xref linkend=\"keyutils\"/> installed.  This "
"switch will break <xref linkend=\"udisks2\"/>, so don't use it unless you "
"really know what you are doing."
msgstr ""
"<option>--without-crypto</option>: Essa chave permite construir "
"<application>libblockdev</application> sem <xref linkend=\"cryptsetup\"/> ou"
" <xref linkend=\"keyutils\"/> instalado. Essa chave quebrará <xref "
"linkend=\"udisks2\"/>, de forma que não a use, a menos que você realmente "
"saiba o que está fazendo."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libblockdev.xml:184
#, xml-text
msgid ""
"<option>--without-dm --without-lvm --without-lvm_dbus --without-"
"mpath</option>: The combination of these switches allows building "
"<application>libblockdev</application> without <xref linkend=\"lvm2\"/> "
"installed.  The <option>--without-dm</option> and <option>--without-"
"mpath</option> options are not in the instructions provided by the book "
"because <xref linkend=\"lvm2\"/> is required for <xref "
"linkend=\"cryptsetup\"/> and <xref linkend=\"cryptsetup\"/> is a recommended"
" dependency of <application>libblockdev</application> anyway."
msgstr ""
"<option>--without-dm --without-lvm --without-lvm_dbus --without-"
"mpath</option>: A combinação dessas chaves permite construir "
"<application>libblockdev</application> sem <xref linkend=\"lvm2\"/> "
"instalado. As opções <option>--without-dm</option> e <option>--without-"
"mpath</option> não estão nas instruções fornecidas pelo livro, porque <xref "
"linkend=\"lvm2\"/> é exigido para <xref linkend=\"cryptsetup\"/> e <xref "
"linkend=\"cryptsetup\"/> é uma dependência recomendada de "
"<application>libblockdev</application> de qualquer maneira."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libblockdev.xml:195
#, xml-text
msgid ""
"<option>--without-nvme</option>: This switch allows building "
"<application>libblockdev</application> without <xref linkend=\"libnvme\"/> "
"installed.  This switch will break <xref linkend=\"udisks2\"/>, so don't use"
" it unless you really know what you are doing."
msgstr ""
"<option>--without-nvme</option>: Essa chave permite construir "
"<application>libblockdev</application> sem <xref linkend=\"libnvme\"/> "
"instalado. Essa chave quebrará <xref linkend=\"udisks2\"/>, de forma que não"
" a use, a menos que você realmente saiba o que está fazendo."

