#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/genlib/popt.xml:80
#, xml-text
msgid "Installation of Popt"
msgstr "Instalação do Popt"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/popt.xml:83
#, xml-text
msgid ""
"Install <application>popt</application> by running the following commands:"
msgstr ""
"Instale <application>popt</application> executando os seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genlib/popt.xml:87
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr --disable-static &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>./configure --prefix=/usr --disable-static &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/popt.xml:91
#, xml-text
msgid ""
"If you have <xref linkend=\"doxygen\"/> installed and wish to build the API "
"documentation, issue:"
msgstr ""
"Se você tiver <xref linkend=\"doxygen\"/> instalado e desejar construir a "
"documentação da API, [então] emita:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genlib/popt.xml:95
#, no-wrap, xml-text
msgid ""
"<userinput>sed -i 's@\\./@src/@' Doxyfile &amp;&amp;\n"
"doxygen</userinput>"
msgstr ""
"<userinput>sed -i 's@\\./@src/@' Doxyfile &amp;&amp;\n"
"doxygen</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/popt.xml:99
#, xml-text
msgid "To test the results, issue: <command>make check</command>."
msgstr "Para testar os resultados, emita: <command>make check</command>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/popt.xml:103
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genlib/popt.xml:106
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/popt.xml:109
#, xml-text
msgid ""
"If you built the API documentation, install it using the following commands "
"issued by the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Se você construiu a documentação da API, [então] instale-a usando os "
"seguintes comandos emitidos pelo(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genlib/popt.xml:115
#, no-wrap, xml-text
msgid ""
"<userinput>install -v -m755 -d /usr/share/doc/popt-&popt-version; &amp;&amp;\n"
"install -v -m644 doxygen/html/* /usr/share/doc/popt-&popt-version;</userinput>"
msgstr ""
"<userinput>install -v -m755 -d /usr/share/doc/popt-&popt-version; &amp;&amp;\n"
"install -v -m644 doxygen/html/* /usr/share/doc/popt-&popt-version;</userinput>"

