#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/genlib/yyjson.xml:76
#, xml-text
msgid "Installation of yyjson"
msgstr "Instalação do yyjson"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/yyjson.xml:79
#, xml-text
msgid "Install yyjson by running the following commands:"
msgstr "Instale yyjson executando os seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genlib/yyjson.xml:83
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr \\\n"
"      -D CMAKE_BUILD_TYPE=Release  \\\n"
"      -D BUILD_SHARED_LIBS=ON      \\\n"
"      -D YYJSON_BUILD_TESTS=ON     \\\n"
"      -G Ninja .. &amp;&amp;\n"
"ninja</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr \\\n"
"      -D CMAKE_BUILD_TYPE=Release  \\\n"
"      -D BUILD_SHARED_LIBS=ON      \\\n"
"      -D YYJSON_BUILD_TESTS=ON     \\\n"
"      -G Ninja .. &amp;&amp;\n"
"ninja</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/yyjson.xml:94
#, xml-text
msgid "To run the test suite, issue <command>ninja test</command>."
msgstr "Para executar a suíte de teste, emita: <command>ninja test</command>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/yyjson.xml:98
#, xml-text
msgid "Now, as the &root; user:"
msgstr "Agora, como o(a) usuário(a) &root;:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genlib/yyjson.xml:101
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr "<userinput>ninja install</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/genlib/yyjson.xml:106
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/yyjson.xml:109
#, xml-text
msgid ""
"<parameter>-D YYJSON_BUILD_TESTS=ON</parameter>: This parameter enables "
"building the test suite. You may remove it if you don't want to run it."
msgstr ""
"<parameter>-D YYJSON_BUILD_TESTS=ON</parameter>: Esse parâmetro habilita "
"construir a suíte de teste. Você pode removê-lo se não quiser executá-la."

