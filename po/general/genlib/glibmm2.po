msgid "Introduction to GLibmm"
msgstr "Introdução ao GLibmm"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/glibmm2.xml:29
#, xml-text
msgid ""
"The <application>GLibmm</application> package is a set of C++ bindings for "
"<application>GLib</application>. This version is part of a new API for "
"supporting gtkmm-4."
msgstr ""
"O pacote <application>GLibmm</application> é um conjunto de ligações C++ "
"para <application>GLib</application>. Essa versão é parte de uma nova API "
"para suporte ao gtkmm-4."

