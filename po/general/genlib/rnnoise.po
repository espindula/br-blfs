msgstr "Instalação do rnnoise"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/rnnoise.xml:75
#, xml-text
msgid ""
"Install <application>rnnoise</application> by running the following "
"commands:"
msgstr ""
"Instale <application>rnnoise</application> executando os seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genlib/rnnoise.xml:79
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr \\\n"
"            --disable-static \\\n"
"            --docdir=/usr/share/doc/rnnoise-&rnnoise-version; &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>./configure --prefix=/usr \\\n"
"            --disable-static \\\n"
"            --docdir=/usr/share/doc/rnnoise-&rnnoise-version; &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/rnnoise.xml:85
#, xml-text
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/rnnoise.xml:89
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
