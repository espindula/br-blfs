#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/genlib/libunique.xml:96
msgid "Installation of libunique"
msgstr "Instalação do libunique"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libunique.xml:99
msgid ""
"Install <application>libunique</application> by running the following "
"commands:"
msgstr ""
"Instale <application>libunique</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genlib/libunique.xml:103
#, no-wrap
msgid ""
"<userinput>patch -Np1 -i ../libunique-&libunique-version;-upstream_fixes-1.patch &amp;&amp;\n"
"autoreconf -fi &amp;&amp;\n"
"\n"
"./configure --prefix=/usr  \\\n"
"            --disable-dbus \\\n"
"            --disable-static &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>patch -Np1 -i ../libunique-&libunique-version;-upstream_fixes-1.patch &amp;&amp;\n"
"autoreconf -fi &amp;&amp;\n"
"\n"
"./configure --prefix=/usr \\\n"
"            --disable-dbus \\\n"
"            --disable-static &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libunique.xml:112
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libunique.xml:116
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr "Agora, como o(a) usante <systemitem class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genlib/libunique.xml:120
#, no-wrap
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/genlib/libunique.xml:124
msgid "Command Explanations"
msgstr "Explicações dos Comandos"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libunique.xml:127
msgid ""
"<parameter>--disable-dbus</parameter>: This switch disables "
"<application>D-Bus</application> backend in favor of the GDBus backend."
msgstr ""
"<parameter>--disable-dbus</parameter>: Essa chave desabilita a "
"infraestrutura de retaguarda <application>D-Bus</application> em favor da "
"infraestrutura de retaguarda \"GDBus\"."

