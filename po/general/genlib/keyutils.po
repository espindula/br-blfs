#: blfs-en/general/genlib/keyutils.xml:26
#, xml-text
msgid "Introduction to keyutils"
msgstr "Introdução ao keyutils"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/keyutils.xml:29
#, xml-text
msgid ""
"<application>Keyutils</application> is a set of utilities for managing the "
"key retention facility in the kernel, which can be used by filesystems, "
"block devices and more to gain and retain the authorization and encryption "
"keys required to perform secure operations."
msgstr ""
"<application>Keyutils</application> é um conjunto de utilitários para "
"gerenciar o recurso de retenção de chave no núcleo, que pode ser usado por "
"sistemas de arquivos, dispositivos de bloco e muito mais para obter e reter "
"as chaves de autorização e de encriptação exigidas para realizar operações "
"seguras."

