#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/genlib/libproxy.xml:25
#, xml-text
msgid "Introduction to libproxy"
msgstr "Introdução ao libproxy"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libproxy.xml:27
#, xml-text
msgid ""
"The <application>libproxy</application> package is a library that provides "
"automatic proxy configuration management. This is useful in standardizing a "
"way of dealing with proxy settings across all scenarios."
msgstr ""
"O pacote <application>libproxy</application> é uma biblioteca que fornece "
"gerenciamento automático de configuração de proxy. Isso é útil para "
"padronizar uma maneira de lidar com configurações de proxy em todos os "
"cenários."

