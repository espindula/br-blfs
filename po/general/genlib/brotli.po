#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/genlib/brotli.xml:90
#, xml-text
msgid "Installation of Brotli"
msgstr "Instalação do Brotli"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/brotli.xml:93
#, xml-text
msgid ""
"Install <application>brotli</application> by running the following commands:"
msgstr ""
"Instale o <application>brotli</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genlib/brotli.xml:97
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr \\\n"
"      -D CMAKE_BUILD_TYPE=Release  \\\n"
"      -G Ninja .. &amp;&amp;\n"
"ninja</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr \\\n"
"      -D CMAKE_BUILD_TYPE=Release  \\\n"
"      -G Ninja .. &amp;&amp;\n"
"ninja</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/brotli.xml:106
#, xml-text
msgid "To test the results, issue: <command>ninja test</command>."
msgstr "Para testar os resultados, emita: <command>ninja test</command>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/brotli.xml:110
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr "Agora, como o(a) usante <systemitem class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genlib/brotli.xml:113
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr "<userinput>ninja install</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/brotli.xml:116
#, xml-text
msgid "If desired, build the <application>Python3</application> bindings:"
msgstr "Se desejado, construa as ligações <application>Python3</application>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genlib/brotli.xml:120
#, no-wrap, xml-text
msgid ""
"<userinput>cd .. &amp;&amp;\n"
"\n"
"sed -e '/libraries +=/s/=.*/= [required_system_library[3:]]/' \\\n"
"    -e '/package_configuration/d'                             \\\n"
"    -e '/pkgconfig/d'                                         \\\n"
"    -i setup.py                                               &amp;&amp;\n"
"\n"
"USE_SYSTEM_BROTLI=1 \\\n"
"&build-wheel-cmd; $PWD</userinput>"
msgstr ""
"<userinput>cd .. &amp;&amp;\n"
"\n"
"sed -e '/libraries +=/s/=.*/= [required_system_library[3:]]/' \\\n"
"    -e '/package_configuration/d'                             \\\n"
"    -e '/pkgconfig/d'                                         \\\n"
"    -i setup.py                                               &amp;&amp;\n"
"\n"
"USE_SYSTEM_BROTLI=1 \\\n"
"&build-wheel-cmd; $PWD</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/brotli.xml:131
#, xml-text
msgid ""
"Install the <application>Python3</application> bindings as the &root; user:"
msgstr ""
"Instale as ligações <application>Python3</application> como o(a) usuário(a) "
"&root;:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genlib/brotli.xml:135
#, no-wrap, xml-text
msgid "<userinput>&install-wheel; Brotli</userinput>"
msgstr "<userinput>&install-wheel; Brotli</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/brotli.xml:139
#, xml-text
msgid ""
"To test the <application>Python3</application> binding, issue: "
"<command>pytest</command>."
msgstr ""
"Para testar a ligação <application>Python3</application>, emita: "
"<command>pytest</command>."

#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/genlib/brotli.xml:145
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/brotli.xml:150
#, xml-text
msgid ""
"<command>sed ... -i setup.py</command>: Allow building the "
"<application>Python3</application> binding with "
"<envar>USE_SYSTEM_BROTLI=1</envar> but without the Python 3 pkgconfig module"
" (that BLFS does not provide) installed."
msgstr ""
"<command>sed ... -i setup.py</command>: Permitir construir a vinculação do "
"<application>Python3</application> com <envar>USE_SYSTEM_BROTLI=1</envar>, "
"mas sem o módulo pkgconfig do Python 3 (que o BLFS não fornece) instalado."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/brotli.xml:157
#, xml-text
msgid ""
"<envar>USE_SYSTEM_BROTLI=1</envar>: Stop <filename>setup.py</filename> from "
"rebuilding the entire package all over again, use the already installed "
"libraries for the <application>Python3</application> binding instead."
msgstr ""
"<envar>USE_SYSTEM_BROTLI=1</envar>: Parar <filename>setup.py</filename> de "
"reconstruir o pacote todo novamente e, em vez disso, usar as bibliotecas já "
"instaladas para a vinculação do <application>Python3</application>."

