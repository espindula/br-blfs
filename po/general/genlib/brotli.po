#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/genlib/brotli.xml:27
#, xml-text
msgid "Introduction to Brotli"
msgstr "Introdução ao Brotli"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/brotli.xml:30
#, xml-text
msgid ""
"<application>Brotli</application> provides a general-purpose lossless "
"compression algorithm that compresses data using a combination of a modern "
"variant of the LZ77 algorithm, Huffman coding and 2nd order context "
"modeling. Its libraries are particularly used for WOFF2 fonts on webpages."
msgstr ""
"<application>Brotli</application> fornece um algoritmo de compressão sem "
"perdas de propósito geral que comprime dados usando uma combinação de uma "
"variante moderna do algoritmo LZ77, codificação Huffman e modelagem de "
"contexto de segunda ordem. As bibliotecas dele são usadas principalmente "
"para fontes WOFF2 em páginas da web."

