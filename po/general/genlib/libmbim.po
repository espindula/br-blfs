#, xml-text
msgid "Introduction to libmbim"
msgstr "Introdução ao libmbim"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libmbim.xml:29
#, xml-text
msgid ""
"The <application>libmbim</application> package contains a GLib-based library"
" for talking to WWAN modems and devices which speak the Mobile Interface "
"Broadband Model (MBIM) protocol."
msgstr ""
"O pacote <application>libmbim</application> contém uma biblioteca baseada em"
" \"GLib\" para comunicação com modems \"WWAN\" e dispositivos que falam o "
"protocolo \"Mobile Interface Broadband Model\" (MBIM)."

