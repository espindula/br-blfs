#: blfs-en/general/genlib/libxslt.xml:105
#, xml-text
msgid ""
"<xref linkend=\"libgcrypt\"/> (only needed for the deprecated EXSLT crypto "
"extension, see Command Explanations)"
msgstr ""
"<xref linkend=\"libgcrypt\"/> (necessário somente para a extensão de "
"criptografia obsoleta EXSLT; vejam-se Explicações dos Comandos)"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/genlib/libxslt.xml:112
#, xml-text
msgid "Installation of libxslt"
msgstr "Instalação do libxslt"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libxslt.xml:115
#, xml-text
msgid ""
"Install <application>libxslt</application> by running the following "
"commands:"
msgstr ""
"Instale <application>libxslt</application> executando os seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genlib/libxslt.xml:119
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr    \\\n"
"            --disable-static \\\n"
"            --without-python \\\n"
"            --docdir=/usr/share/doc/libxslt-&libxslt-version; &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>./configure --prefix=/usr    \\\n"
"            --disable-static \\\n"
"            --without-python \\\n"
"            --docdir=/usr/share/doc/libxslt-&libxslt-version; &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libxslt.xml:126
#, xml-text
msgid "To test the results, issue: <command>make check</command>."
msgstr "Para testar os resultados, emita: <command>make check</command>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libxslt.xml:130
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr "Agora, como o(a) usante <systemitem class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genlib/libxslt.xml:133
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/genlib/libxslt.xml:138
#, xml-text
msgid "Command Explanations"
msgstr "Explicações dos Comandos"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libxslt.xml:144
#, xml-text
msgid ""
"<parameter>--without-python</parameter>: Disable the Python binding of this "
"package.  The binding only works if the Python binding of <xref "
"linkend='libxml2'/> is installed, but we've not enabled the deprecated "
"Python binding when we built <xref linkend='libxml2'/>."
msgstr ""
"<parameter>--without-python</parameter>: Desabilitar a ligação Python deste "
"pacote. A ligação só funciona se a ligação Python da <xref "
"linkend='libxml2'/> estiver instalada, mas nós não habilitamos a ligação "
"Python obsoleta quando construímos a <xref linkend='libxml2'/>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libxslt.xml:151
#, xml-text
msgid ""
"<option>--with-crypto</option>: Enable the non-standard and deprecated EXSLT"
" crypto extension feature.  It needs <xref linkend='libgcrypt'/> and the "
"upstream will remove it in the future."
msgstr ""
"<option>--with-crypto</option>: Habilita o recurso de extensão de "
"criptografia EXSLT não padrão e obsoleto. Ele precisa da <xref "
"linkend='libgcrypt'/> e o fluxo de desenvolvimento o removerá no futuro."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libxslt.xml:157
#, xml-text
msgid ""
"<option>--with-debug</option>: Enables thorough diagnostics with the "
"<option>-v, --verbose</option> of <command>xsltproc</command>.  Use it if "
"you plan to debug XSLT stylesheets."
msgstr ""
"<option>--with-debug</option>: Habilita diagnósticos completos com "
"<option>-v, --verbose</option> do <command>xsltproc</command>. Use-o se você"
" planeja depurar folhas de estilo XSLT."

