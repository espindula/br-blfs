#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/genlib/log4cplus.xml:80
#, xml-text
msgid "Installation of log4cplus"
msgstr "Instalação do log4cplus"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/log4cplus.xml:83
#, xml-text
msgid ""
"Build <application>log4cplus</application> by running the following command:"
msgstr ""
"Construa o <application>log4cplus</application> executando o seguinte "
"comando:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genlib/log4cplus.xml:87
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>./configure --prefix=/usr &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/log4cplus.xml:91
#, xml-text
msgid "To test the results, issue: <command>make check</command>."
msgstr "Para testar os resultados, emita: <command>make check</command>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/log4cplus.xml:95
#, xml-text
msgid ""
"Now, install the package as the <systemitem "
"class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, instale o pacote como o(a) usante <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genlib/log4cplus.xml:99
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

