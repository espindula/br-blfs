#. type: Content of:
#. <sect1><sect2><variablelist><varlistentry><listitem><para>
#: blfs-en/general/genlib/js102.xml:335
msgid ""
"provides a command line interface to the "
"<application>JavaScript</application> engine"
msgstr ""
