#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/genlib/opentimelineio.xml:95
#, xml-text
msgid "Installation of OpenTimelineIO"
msgstr "Instalação do OpenTimelineIO"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/opentimelineio.xml:98
#, xml-text
msgid ""
"First, install a substitute for RapidJSON.  This updates the upstream "
"version that has not been updated since 2016 and avoids downloading untagged"
" releases of external submodules."
msgstr ""
"Primeiro, instale um substituto para RapidJSON. Isso atualiza a versão de "
"fluxo de desenvolvimento, que não tem sido atualizada desde 2016, e evita "
"baixar lançamentos não etiquetados de submódulos externos."

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genlib/opentimelineio.xml:103
#, no-wrap, xml-text
msgid ""
"<userinput>tar -xvf ../OpenTimelineIO-rapidjson-20260513.tar.xz \\\n"
"    --strip-components=1 -C src/deps</userinput>"
msgstr ""
"<userinput>tar -xvf ../OpenTimelineIO-rapidjson-20260513.tar.xz \\\n"
"    --strip-components=1 -C src/deps</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/opentimelineio.xml:107
#, xml-text
msgid ""
"Install <application>OpenTimelineIO</application> by running the following "
"commands:"
msgstr ""
"Instale <application>OpenTimelineIO</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genlib/opentimelineio.xml:111
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr     \\\n"
"      -D OTIO_FIND_IMATH=ON            \\\n"
"      -D OTIO_AUTOMATIC_SUBMODULES=OFF \\\n"
"      -D OTIO_DEPENDENCIES_INSTALL=OFF \\\n"
"      .. &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr     \\\n"
"      -D OTIO_FIND_IMATH=ON            \\\n"
"      -D OTIO_AUTOMATIC_SUBMODULES=OFF \\\n"
"      -D OTIO_DEPENDENCIES_INSTALL=OFF \\\n"
"      .. &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/opentimelineio.xml:122
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr "Agora, como o(a) usante <systemitem class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genlib/opentimelineio.xml:125
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

