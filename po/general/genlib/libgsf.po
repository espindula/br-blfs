#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/genlib/libgsf.xml:105
#, xml-text
msgid "Installation of libgsf"
msgstr "Instalação do libgsf"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libgsf.xml:114
#, xml-text
msgid ""
"Install <application>libgsf</application> by running the following commands:"
msgstr ""
"Instale <application>libgsf</application> executando os seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genlib/libgsf.xml:118
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr --disable-static &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>./configure --prefix=/usr --disable-static &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libgsf.xml:122
#, xml-text
msgid ""
"To test the results, issue: <command>make check</command>.  Two tests "
"related to <xref linkend=\"valgrind\"/> are known to fail."
msgstr ""
"Para testar os resultados, emita: <command>make check</command>. Dois testes"
" relacionados ao <xref linkend=\"valgrind\"/> são conhecidos por falharem."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libgsf.xml:127
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genlib/libgsf.xml:130
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

