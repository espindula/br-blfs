#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/genlib/lzo.xml:73
#, xml-text
msgid "Installation of LZO"
msgstr "Instalação do LZO"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/lzo.xml:76
#, xml-text
msgid ""
"Install <application>LZO</application> by running the following commands:"
msgstr ""
"Instale <application>LZO</application> executando os seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genlib/lzo.xml:80
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr    \\\n"
"            --enable-shared  \\\n"
"            --disable-static \\\n"
"            --docdir=/usr/share/doc/lzo-&lzo-version; &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>./configure --prefix=/usr    \\\n"
"            --enable-shared  \\\n"
"            --disable-static \\\n"
"            --docdir=/usr/share/doc/lzo-&lzo-version; &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/lzo.xml:87
#, xml-text
msgid ""
"To test the results, issue: <command>make check</command>. All the checks "
"should pass. Now issue <command>make test</command> to run the full suite of"
" tests."
msgstr ""
"Para testar os resultados, emita: <command>make check</command>. Todas as "
"verificações deveriam passar. Agora emita <command>make test</command> para "
"executar a suíte completa de testes."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/lzo.xml:93
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr "Agora, como o(a) usante <systemitem class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genlib/lzo.xml:96
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

