#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/genlib/lzo.xml:26
#, xml-text
msgid "Introduction to LZO"
msgstr "Introdução ao LZO"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/lzo.xml:29
#, xml-text
msgid ""
"<application>LZO</application> is a data compression library which is "
"suitable for data decompression and compression in real-time. This means it "
"favors speed over compression ratio."
msgstr ""
"<application>LZO</application> é uma biblioteca de compressão de dados "
"adequada para descompressão e compressão de dados em tempo real. Isso "
"significa que ela favorece a velocidade sobre a taxa de compressão."

