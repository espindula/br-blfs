#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/genlib/libiodbc.xml:80
#, xml-text
msgid "Installation of libiodbc"
msgstr "Instalação do libiodbc"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libiodbc.xml:83
#, xml-text
msgid ""
"Install <application>libiodbc</application> by running the following "
"commands:"
msgstr ""
"Instale <application>libiodbc</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genlib/libiodbc.xml:87
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr                   \\\n"
"            --with-iodbc-inidir=/etc/iodbc  \\\n"
"            --includedir=/usr/include/iodbc \\\n"
"            --disable-libodbc               \\\n"
"            --disable-static                &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>./configure --prefix=/usr                 \\\n"
"            --with-iodbc-inidir=/etc/iodbc  \\\n"
"            --includedir=/usr/include/iodbc \\\n"
"            --disable-libodbc               \\\n"
"            --disable-static                &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libiodbc.xml:95
#, xml-text
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libiodbc.xml:99
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genlib/libiodbc.xml:102
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/genlib/libiodbc.xml:107
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libiodbc.xml:110
#, xml-text
msgid ""
"<parameter>--with-iodbc-inidir=/etc/iodbc</parameter>: "
"<application>libiodbc</application> will install configuration files in this"
" directory."
msgstr ""
"<parameter>--with-iodbc-inidir=/etc/iodbc</parameter>: "
"<application>libiodbc</application> instalará arquivos de configuração nesse"
" diretório."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libiodbc.xml:116
#, xml-text
msgid ""
"<parameter>--includedir=/usr/include/iodbc</parameter>: This installs the "
"interface headers to a private directory to avoid a conflict with headers "
"installed by <application>unixODBC</application>."
msgstr ""
"<parameter>--includedir=/usr/include/iodbc</parameter>: Isso instala os "
"cabeçalhos de interface em um diretório privado, para evitar um conflito com"
" os cabeçalhos instalados pelo <application>unixODBC</application>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libiodbc.xml:122
#, xml-text
msgid ""
"<parameter>--disable-libodbc</parameter>: This prevents the installation of "
"the <filename class=\"symlink\">libodbc.so</filename> symbolic link to avoid"
" a conflict with <application>unixODBC</application>."
msgstr ""
"<parameter>--disable-libodbc</parameter>: Isso evita a instalação do link "
"simbólico <filename class=\"symlink\">libodbc.so</filename>, para evitar um "
"conflito com o <application>unixODBC</application>."

