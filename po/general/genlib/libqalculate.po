#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/genlib/libqalculate.xml:86
#, xml-text
msgid "Installation of libqalculate"
msgstr "Instalação do libqalculate"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libqalculate.xml:89
#, xml-text
msgid ""
"Install <application>libqalculate</application> by running the following "
"commands:"
msgstr ""
"Instale <application>libqalculate</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genlib/libqalculate.xml:93
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr    \\\n"
"            --disable-static \\\n"
"            --docdir=/usr/share/doc/libqalculate-&libqalculate-version; &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>./configure --prefix=/usr   \\\n"
"            --disable-static \\\n"
"            --docdir=/usr/share/doc/libqalculate-&libqalculate-version; &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libqalculate.xml:99
#, xml-text
msgid "To test the results, issue: <command>make check</command>."
msgstr "Para testar os resultados, emita: <command>make check</command>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libqalculate.xml:103
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genlib/libqalculate.xml:106
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genlib/libqalculate.xml:111
#, no-wrap, xml-text
msgid "<userinput>rm -v /usr/lib/libqalculate.la</userinput>"
msgstr "<userinput>rm -v /usr/lib/libqalculate.la</userinput>"

