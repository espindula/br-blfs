#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libgpg-error.xml:29
#, xml-text
msgid ""
"The <application>libgpg-error</application> package contains a library that "
"defines common error values for all <application>GnuPG</application> "
"components."
msgstr ""
"O pacote <application>libgpg-error</application> contém uma biblioteca que "
"define valores comuns de erro para todos os componentes do "
"<application>GnuPG</application>."

