#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/genlib/libgusb.xml:26
#, xml-text
msgid "Introduction to libgusb"
msgstr "Introdução ao libgusb"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libgusb.xml:29
#, xml-text
msgid ""
"The <application>libgusb</application> package contains the GObject wrappers"
" for <application>libusb-1.0</application> that makes it easy to do "
"asynchronous control, bulk and interrupt transfers with proper cancellation "
"and integration into a mainloop."
msgstr ""
"O pacote <application>libgusb</application> contém os amarradores GObject "
"para a <application>libusb-1.0</application> que tornam fácil fazer controle"
" assíncrono, transferências em massa e de interrupções com cancelamento "
"adequado e integração em um loop principal."

