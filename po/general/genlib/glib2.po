#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/genlib/glib2.xml:321
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/glib2.xml:327
#, xml-text
msgid ""
"<parameter>-D man-pages=enabled</parameter>: This switch causes the build to"
" create and install the package man pages."
msgstr ""
"<parameter>-D man-pages=enabled</parameter>: Essa chave faz com que a "
"construção crie e instale as páginas de manual do pacote."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/glib2.xml:332
#, xml-text
msgid ""
"<parameter>-D glib_debug=disabled</parameter>: This switch causes the build "
"to not include some expensive checks for debugging in the built programs and"
" libraries."
msgstr ""
"<parameter>-D glib_debug=disabled</parameter>: Essa chave faz com que a "
"construção não inclua algumas verificações caras para depuração nos "
"programas e bibliotecas construídos."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/glib2.xml:338
#, xml-text
msgid ""
"<parameter>-D sysprof=disabled</parameter>: This switch disables the tracing"
" support for sysprof.  Remove this option if you want the tracing support.  "
"Note that if sysprof is not installed, removing this option will cause the "
"build system to download a copy of sysprof from the Internet."
msgstr ""
"<parameter>-D sysprof=disabled</parameter>: Essa chave desabilita o suporte "
"de rastreamento para sysprof. Remova essa opção se você quiser o suporte de "
"rastreamento. Observe que se o sysprof não estiver instalado, remover essa "
"opção fará com que o sistema de construção baixe uma cópia do sysprof a "
"partir da Internet."

