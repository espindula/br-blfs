#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libunwind.xml:91
#, xml-text
msgid ""
"Install <application>libunwind</application> by running the following "
"commands:"
msgstr ""
"Instale <application>libunwind</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genlib/libunwind.xml:95
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr --disable-static &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>./configure --prefix=/usr --disable-static &amp;&amp;\n"
"make</userinput>"

#. Two
#.       tests, run-coredump-unwind and run-coredump-unwind-mdi are known
#.       to fail.
