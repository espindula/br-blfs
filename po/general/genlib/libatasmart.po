#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/genlib/libatasmart.xml:75
#, xml-text
msgid "Installation of libatasmart"
msgstr "Instalação do libatasmart"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libatasmart.xml:78
#, xml-text
msgid ""
"Install <application>libatasmart</application> by running the following "
"commands:"
msgstr ""
"Instale <application>libatasmart</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genlib/libatasmart.xml:82
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr --disable-static &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>./configure --prefix=/usr --disable-static &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libatasmart.xml:86
#, xml-text
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libatasmart.xml:90
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genlib/libatasmart.xml:93
#, no-wrap, xml-text
msgid ""
"<userinput>make docdir=/usr/share/doc/libatasmart-&libatasmart-version; "
"install</userinput>"
msgstr ""
"<userinput>make docdir=/usr/share/doc/libatasmart-&libatasmart-version; "
"install</userinput>"

