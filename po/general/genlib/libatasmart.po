#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libatasmart.xml:29
#, xml-text
msgid ""
"The <application>libatasmart</application> package is a disk reporting "
"library. It only supports a subset of the ATA S.M.A.R.T. functionality."
msgstr ""
"O pacote <application>libatasmart</application> é uma biblioteca de informe "
"de disco. Ela suporta somente um subconjunto da funcionalidade S.M.A.R.T. do"
" ATA."

