#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/duktape.xml:29
#, xml-text
msgid ""
"<application>duktape</application> is an embeddable Javascript engine, with "
"a focus on portability and compact footprint."
msgstr ""
"<application>duktape</application> é um mecanismo embutível Javascript, com "
"foco em portabilidade e pegada compacta."

