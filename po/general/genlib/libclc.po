#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/genlib/libclc.xml:78
#, xml-text
msgid "Installation of libclc"
msgstr "Instalação do libclc"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libclc.xml:81
#, xml-text
msgid ""
"Install <application>libclc</application> by running the following commands:"
msgstr ""
"Instale <application>libclc</application> executando os seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genlib/libclc.xml:85
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir libclc/build &amp;&amp;\n"
"cd    libclc/build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr \\\n"
"      -D CMAKE_BUILD_TYPE=Release  \\\n"
"      -G Ninja ..                  &amp;&amp;\n"
"ninja</userinput>"
msgstr ""
"<userinput>mkdir libclc/build &amp;&amp;\n"
"cd    libclc/build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr \\\n"
"      -D CMAKE_BUILD_TYPE=Release  \\\n"
"      -G Ninja ..                  &amp;&amp;\n"
"ninja</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libclc.xml:94
#, xml-text
msgid "To test the results, issue: <command>ninja test</command>."
msgstr "Para testar os resultados, emita: <command>ninja test</command>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libclc.xml:98
#, xml-text
msgid "Now, as the &root; user:"
msgstr "Agora, como o(a) usante &root;:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genlib/libclc.xml:101
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr "<userinput>ninja install</userinput>"

