#: blfs-en/general/genlib/utfcpp.xml:78
#, xml-text
msgid "Installation of utfcpp"
msgstr "Instalação do utfcpp"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/utfcpp.xml:81
#, xml-text
msgid ""
"Install <application>utfcpp</application> by running the following commands:"
msgstr ""
"Instale <application>utfcpp</application> executando os seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genlib/utfcpp.xml:85
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr ..</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr ..</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/utfcpp.xml:92
#, xml-text
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/utfcpp.xml:96
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genlib/utfcpp.xml:99
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

