#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/fast_float.xml:29
#, xml-text
msgid ""
"<application>Fast_float</application> provides a set of C++ header files for"
" efficient string to float operations."
msgstr ""
"<application>Fast_float</application> fornece um conjunto de arquivos de "
"cabeçalho C++ para sequência eficiente de caracteres para operações de "
"flutuação."

