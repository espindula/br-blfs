#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/genlib/fast_float.xml:86
#, xml-text
msgid "Installation of Fast_float"
msgstr "Instalação do Fast_float"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/fast_float.xml:89
#, xml-text
msgid ""
"Install <application>fast_float</application> by running the following "
"commands:"
msgstr ""
"Instale <application>fast_float</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genlib/fast_float.xml:93
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr \\\n"
"      -D CMAKE_BUILD_TYPE=Release  \\\n"
"      -G Ninja ..\n"
"</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr \\\n"
"      -D CMAKE_BUILD_TYPE=Release  \\\n"
"      -G Ninja ..\n"
"</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/fast_float.xml:102
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genlib/fast_float.xml:105
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr "<userinput>ninja install</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/fast_float.xml:108
#, fuzzy, xml-text
#| msgid ""
#| "To test the results, issue: <command>cmake .. -D FASTFLOAT_TEST=ON -D "
#| "CMAKE_POLICY_VERSION_MINIMUM=3.5 &amp;&amp; ninja &amp;&amp; ninja "
#| "test</command>.  Note that it'll download some test files from the Internet,"
#| " and those files would be installed if the test suite had run before "
#| "<command>ninja install</command>.  So don't run the test suite before "
#| "installation."
msgid ""
"To test the results, issue: <command>cmake .. -D FASTFLOAT_TEST=ON "
"&amp;&amp; ninja &amp;&amp; ninja test</command>.  Note that it'll download "
"some test files from the Internet, and those files would be installed if the"
" test suite had run before <command>ninja install</command>.  So don't run "
"the test suite before installation."
msgstr ""
"Para testar os resultados, emita: <command>cmake .. -D FASTFLOAT_TEST=ON -D "
"CMAKE_POLICY_VERSION_MINIMUM=3.5 &amp;&amp; ninja &amp;&amp; ninja "
"test</command>. Observe que ele baixará alguns arquivos de teste a partir da"
" internet, e esses arquivos seriam instalados se a suíte de teste tivesse "
"executado antes de <command>ninja install</command>. Portanto, não execute a"
" suíte de teste antes da instalação."

