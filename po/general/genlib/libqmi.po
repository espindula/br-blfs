#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/genlib/libqmi.xml:93
#, xml-text
msgid "Installation of libqmi"
msgstr "Instalação do libqmi"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libqmi.xml:96
#, xml-text
msgid ""
"Install <application>libqmi</application> by running the following commands:"
msgstr ""
"Instale <application>libqmi</application> executando os seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genlib/libqmi.xml:100
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup ..                 \\\n"
"      --prefix=/usr            \\\n"
"      --buildtype=release      \\\n"
"      -D bash_completion=false \\\n"
"      -D qrtr=false            \\\n"
"      -D man=false             &amp;&amp;\n"
"\n"
"ninja</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup ..                 \\\n"
"      --prefix=/usr            \\\n"
"      --buildtype=release      \\\n"
"      -D bash_completion=false \\\n"
"      -D qrtr=false            \\\n"
"      -D man=false             &amp;&amp;\n"
"\n"
"ninja</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libqmi.xml:113
#, xml-text
msgid "To test the results, issue: <command>ninja test</command>."
msgstr "Para testar os resultados, emita: <command>ninja test</command>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libqmi.xml:117
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genlib/libqmi.xml:120
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr "<userinput>ninja install</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/genlib/libqmi.xml:126
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libqmi.xml:132
#, xml-text
msgid ""
"<parameter>-D bash_completion=false</parameter>: Use this option if the "
"external <ulink url=\"https://github.com/scop/bash-completion\">bash-"
"completion</ulink> package is not installed."
msgstr ""
"<parameter>-D bash_completion=false</parameter>: Use essa opção se o pacote "
"externo <ulink url=\"https://github.com/scop/bash-completion\">bash-"
"completion</ulink> não estiver instalado."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libqmi.xml:139
#, xml-text
msgid ""
"<parameter>-D man=false</parameter>: Use this option if the external <ulink "
"url=\"https://ftpmirror.gnu.org/gnu/help2man/\">help2man</ulink> package is "
"not installed."
msgstr ""
"<parameter>-D man=false</parameter>: Use essa opção se o pacote externo "
"<ulink url=\"https://ftpmirror.gnu.org/gnu/help2man/\">help2man</ulink> não "
"estiver instalado."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libqmi.xml:146
#, xml-text
msgid ""
"<parameter>-D qrtr=false</parameter>: This switch disables support for the "
"QRTR protocol which needs the external <ulink "
"url=\"https://gitlab.freedesktop.org/mobile-broadband/libqrtr-"
"glib\">libqrtr-glib</ulink> package."
msgstr ""
"<parameter>-D qrtr=false</parameter>: Essa chave desabilita suporte para o "
"protocolo QRTR, que precisa do pacote externo <ulink "
"url=\"https://gitlab.freedesktop.org/mobile-broadband/libqrtr-"
"glib\">libqrtr-glib</ulink>."

