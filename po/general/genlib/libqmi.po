#, xml-text
msgid "Introduction to libqmi"
msgstr "Introdução ao libqmi"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libqmi.xml:29
#, xml-text
msgid ""
"The <application>libqmi</application> package contains a GLib-based library "
"for talking to WWAN modems and devices which speak the Qualcomm MSM "
"Interface (QMI) protocol."
msgstr ""
"O pacote <application>libqmi</application> contém uma biblioteca baseada em "
"GLib para comunicação com modems WWAN e dispositivos que falam o protocolo "
"Qualcomm MSM Interface (QMI)."

