#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/genlib/libfyaml.xml:27
#, xml-text
msgid "Introduction to libfyaml"
msgstr "Introdução ao libfyaml"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libfyaml.xml:30
#, xml-text
msgid ""
"The <application>libfyaml</application> package contains a YAML 1.3 parser "
"and writer. It also supports YAML 0.1 with the help of the libyaml library."
msgstr ""
"O pacote <application>libfyaml</application> contém um analisador e escritor"
" YAML 1.3. Ele também suporta YAML 0.1 com a ajuda da biblioteca libyaml."

