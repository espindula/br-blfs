#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/genlib/libfyaml.xml:76
#, xml-text
msgid "Installation of libfyaml"
msgstr "Instalação do libfyaml"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libfyaml.xml:79
#, xml-text
msgid ""
"Install <application>libfyaml</application> by running the following "
"commands:"
msgstr ""
"Instale <application>libfyaml</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genlib/libfyaml.xml:83
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr --disable-static &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>./configure --prefix=/usr --disable-static &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libfyaml.xml:87
#, xml-text
msgid "To test the results, issue: <command>make check</command>."
msgstr "Para testar os resultados, emita: <command>make check</command>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libfyaml.xml:91
#, xml-text
msgid "Now, as the &root; user:"
msgstr "Agora, como o(a) usuário(a) &root;:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genlib/libfyaml.xml:94
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

