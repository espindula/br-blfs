#. type: Content of: <sect1><sect2><segmentedlist><seglistitem><seg>
#: blfs-en/general/genlib/libfyaml.xml:114
#, xml-text
msgid ""
"fy-compose (link to fy-tool), fy-dump (link to fy-tool), fy-filter (link to "
"fy-tool), fy-join (link to fy-tool), fy-testsuite (link to fy-tool), fy-"
"tool, and fy-ypath (link to fy-tool)"
msgstr ""
"fy-compose (linque para fy-tool), fy-dump (linque para fy-tool), fy-filter "
"(linque para fy-tool), fy-join (linque para fy-tool), fy-testsuite (linque "
"para fy-tool), fy-tool e fy-ypath (linque para fy-tool)"

