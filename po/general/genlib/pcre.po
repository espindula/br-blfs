#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/genlib/pcre.xml:82
#, xml-text
msgid "Installation of PCRE"
msgstr "Instalação do PCRE"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/pcre.xml:85
#, xml-text
msgid ""
"Install <application>PCRE</application> by running the following commands:"
msgstr ""
"Instale <application>PCRE</application> executando os seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genlib/pcre.xml:89
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr                     \\\n"
"            --docdir=/usr/share/doc/pcre-&pcre-version; \\\n"
"            --enable-unicode-properties       \\\n"
"            --enable-pcre16                   \\\n"
"            --enable-pcre32                   \\\n"
"            --enable-pcregrep-libz            \\\n"
"            --enable-pcregrep-libbz2          \\\n"
"            --enable-pcretest-libreadline     \\\n"
"            --disable-static                 &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>./configure --prefix=/usr                    \\\n"
"            --docdir=/usr/share/doc/pcre-&pcre-version; \\\n"
"            --enable-unicode-properties       \\\n"
"            --enable-pcre16                   \\\n"
"            --enable-pcre32                   \\\n"
"            --enable-pcregrep-libz            \\\n"
"            --enable-pcregrep-libbz2          \\\n"
"            --enable-pcretest-libreadline     \\\n"
"            --disable-static                 &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/pcre.xml:101
#, xml-text
msgid "To test the results, issue: <command>make check</command>."
msgstr "Para testar os resultados, emita: <command>make check</command>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/pcre.xml:105
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genlib/pcre.xml:108
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/genlib/pcre.xml:113
#, xml-text
msgid "Command Explanations"
msgstr "Explicações dos Comandos"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/pcre.xml:116
#, xml-text
msgid ""
"<parameter>--enable-unicode-properties</parameter>: This switch enables "
"Unicode properties support and includes the code for handling UTF-8/16/32 "
"character strings in the library. You need this switch if you are going to "
"build <xref linkend=\"glib2\"/>."
msgstr ""
"<parameter>--enable-unicode-properties</parameter>: Essa chave habilita o "
"suporte a propriedades Unicode e inclui o código para lidar com sequências "
"dos caracteres de carácter UTF-8/16/32 na biblioteca. Você precisa dessa "
"chave se for construir <xref linkend=\"glib2\"/>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/pcre.xml:123
#, xml-text
msgid ""
"<parameter>--enable-pcre16</parameter>: This switch enables 16 bit character"
" support."
msgstr ""
"<parameter>--enable-pcre16</parameter>: Essa chave habilita o suporte a "
"caracteres de 16 bits."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/pcre.xml:128
#, xml-text
msgid ""
"<parameter>--enable-pcre32</parameter>: This switch enables 32 bit character"
" support."
msgstr ""
"<parameter>--enable-pcre32</parameter>: Essa chave habilita o suporte a "
"caracteres de 32 bits."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/pcre.xml:133
#, xml-text
msgid ""
"<parameter>--enable-pcregrep-libz</parameter>: This switch adds support to "
"<command>pcregrep</command> to read <filename "
"class=\"extension\">.gz</filename> compressed files."
msgstr ""
"<parameter>--enable-pcregrep-libz</parameter>: Essa chave adiciona suporte "
"para o <command>pcregrep</command> ler arquivos comprimidos <filename "
"class=\"extension\">.gz</filename>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/pcre.xml:139
#, xml-text
msgid ""
"<parameter>--enable-pcregrep-libbz2</parameter>: This switch adds support to"
" <command>pcregrep</command> to read <filename "
"class=\"extension\">.bz2</filename> compressed files."
msgstr ""
"<parameter>--enable-pcregrep-libbz2</parameter>: Essa chave adiciona suporte"
" para o <command>pcregrep</command> ler arquivos comprimidos <filename "
"class=\"extension\">.bz2</filename>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/pcre.xml:145
#, xml-text
msgid ""
"<parameter>--enable-pcretest-libreadline</parameter>: This switch adds line "
"editing and history features to <command>pcretest</command> program."
msgstr ""
"<parameter>--enable-pcretest-libreadline</parameter>: Essa chave adiciona "
"recursos de edição de linha e de histórico ao aplicativo "
"<command>pcretest</command>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/pcre.xml:162
#, xml-text
msgid ""
"<option>--enable-jit</option>: this option enables Just-in-time compiling, "
"which can greatly speed up pattern matching."
msgstr ""
"<option>--enable-jit</option>: essa opção habilita a compilação \"na hora "
"certa\", que consegue acelerar bastante a correspondência de padrões."

