#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/genlib/pcre.xml:26
#, xml-text
msgid "Introduction to PCRE"
msgstr "Introdução ao PCRE"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/pcre.xml:29
#, xml-text
msgid ""
"The <application>PCRE</application> package contains "
"<application>Perl</application> Compatible Regular Expression libraries. "
"These are useful for implementing regular expression pattern matching using "
"the same syntax and semantics as <application>Perl</application> 5."
msgstr ""
"O pacote <application>PCRE</application> contém as bibliotecas "
"<application>Perl</application> de Expressões Regulares Compatíveis. Elas "
"são úteis para implementar correspondência de padrão de expressão regular "
"usando a mesma sintaxe e semântica da <application>Perl</application> 5."

