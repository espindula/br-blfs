#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/genlib/libspelling.xml:92
#, xml-text
msgid "Installation of libspelling"
msgstr "Instalação do libspelling"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libspelling.xml:95
#, xml-text
msgid ""
"Install <application>libspelling</application> by running the following "
"commands:"
msgstr ""
"Instale <application>libspelling</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genlib/libspelling.xml:99
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr       \\\n"
"            --buildtype=release \\\n"
"            -D docs=false       \\\n"
"            -D sysprof=false    \\\n"
"            ..                  &amp;&amp;\n"
"ninja</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr       \\\n"
"            --buildtype=release \\\n"
"            -D docs=false       \\\n"
"            -D sysprof=false    \\\n"
"            ..                  &amp;&amp;\n"
"ninja</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libspelling.xml:110
#, xml-text
msgid "To test the results, issue: <command>ninja test</command>."
msgstr "Para testar os resultados, emita: <command>ninja test</command>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libspelling.xml:114
#, xml-text
msgid "Now, as the &root; user:"
msgstr "Agora, como o(a) usuário(a) &root;:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genlib/libspelling.xml:117
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr "<userinput>ninja install</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/genlib/libspelling.xml:122
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libspelling.xml:125
#, xml-text
msgid ""
"<parameter>-D docs=false</parameter>: Prevents building the documentation. "
"Remove this if you have <application>gi-docgen</application> installed and "
"wish to build the documentation."
msgstr ""
"<parameter>-D docs=false</parameter>: Impede construir a documentação. "
"Remova isso se você tiver o <application>gi-docgen</application> instalado e"
" desejar construir a documentação."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libspelling.xml:132
#, xml-text
msgid ""
"<parameter>-D sysprof=false</parameter>: Prevents building with profiler "
"data. Remove this if you have <application>sysprof</application> installed "
"and wish to generate data for performance profiling."
msgstr ""
"<parameter>-D sysprof=false</parameter>: Impede construir com dados de "
"perfilamento. Remova isso se você tiver o <application>sysprof</application>"
" instalado e desejar gerar dados para perfilamento de desempenho."

