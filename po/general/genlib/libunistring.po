#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/libunistring.xml:29
#, xml-text
msgid ""
"<application>libunistring</application> is a library that provides functions"
" for manipulating Unicode strings and for manipulating C strings according "
"to the Unicode standard."
msgstr ""
"<application>libunistring</application> é uma biblioteca que fornece funções"
" para manipular sequências de caracteres Unicode e para manipular sequências"
" de caracteres C de acordo com o padrão Unicode."

