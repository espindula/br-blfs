#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/genlib/talloc.xml:26
#, xml-text
msgid "Introduction to Talloc"
msgstr "Introdução ao Talloc"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/talloc.xml:29
#, xml-text
msgid ""
"<application>Talloc</application> provides a hierarchical, reference counted"
" memory pool system with destructors. It is the core memory allocator used "
"in <application>Samba</application>."
msgstr ""
"<application>Talloc</application> fornece um sistema hierárquico de "
"agrupamento de memória contada por referência com destruidores. É o alocador"
" de memória usado no <application>Samba</application>."

