#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/genlib/talloc.xml:88
#, xml-text
msgid "Installation of Talloc"
msgstr "Instalação do Talloc"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/talloc.xml:91
#, xml-text
msgid ""
"Install <application>Talloc</application> by running the following commands:"
msgstr ""
"Instale <application>Talloc</application> executando os seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genlib/talloc.xml:95
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>./configure --prefix=/usr &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/talloc.xml:99
#, xml-text
msgid "To check the results, issue <command>make check</command>."
msgstr "Para verificar os resultados, emita <command>make check</command>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/genlib/talloc.xml:103
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/genlib/talloc.xml:106
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

