#, xml-text
#~ msgid ""
#~ "If you have downloaded <application>compiler-rt</application>, install it "
#~ "into the source tree by running the following commands, and modify the "
#~ "building system so it will find the <filename class='directory'> llvm-"
#~ "cmake-&llvm-maj-version;.src</filename> directory correctly:"
#~ msgstr ""
#~ "Se você tiver baixado <application>compiler-rt</application>, instale-o na "
#~ "árvore do fonte executando os seguintes comandos e modifique o sistema de "
#~ "construção, de forma que ele encontre o <filename class='directory'>llvm-"
#~ "cmake-&llvm-maj-version;.src</filename> corretamente:"

#, no-wrap, xml-text
#~ msgid ""
#~ "<userinput>tar -xf ../compiler-rt-&llvm-version;.src.tar.xz -C projects    &amp;&amp;\n"
#~ "mv projects/compiler-rt-&llvm-version;.src projects/compiler-rt &amp;&amp;\n"
#~ "sed '/^set(LLVM_COMMON_CMAKE_UTILS/d'                   \\\n"
#~ "    -i projects/compiler-rt/CMakeLists.txt</userinput>"
#~ msgstr ""
#~ "<userinput>tar -xf ../compiler-rt-&llvm-version;.src.tar.xz -C projects    &amp;&amp;\n"
#~ "mv projects/compiler-rt-&llvm-version;.src projects/compiler-rt &amp;&amp;\n"
#~ "sed '/^set(LLVM_COMMON_CMAKE_UTILS/d'                   \\\n"
#~ "    -i projects/compiler-rt/CMakeLists.txt</userinput>"

#, xml-text
#~ msgid ""
#~ "If you have downloaded <application>clang</application>, apply the following"
#~ " patch to enable <xref linkend=\"gSSP\"/> by default in compiled programs."
#~ msgstr ""
#~ "Se você tiver baixado o <application>clang</application>, [então] aplique o "
#~ "seguinte remendo para habilitar <xref linkend=\"gSSP\"/> por padrão em "
#~ "aplicativos compilados."

#, no-wrap, xml-text
#~ msgid ""
#~ "<userinput remap=\"pre\">patch -Np2 -d tools/clang &lt;../clang-&llvm-maj-"
#~ "version;-enable_default_ssp-1.patch</userinput>"
#~ msgstr ""
#~ "<userinput remap=\"pre\">patch -Np2 -d tools/clang &lt;../clang-&llvm-maj-"
#~ "version;-enable_default_ssp-1.patch</userinput>"

