#~ "<userinput>install -v -d -m755 /usr/share/doc/llvm-&llvm-version;            &amp;&amp;\n"
#~ "mv -v /usr/share/doc/LLVM/llvm /usr/share/doc/llvm-&llvm-version; &amp;&amp;\n"
#~ "rmdir -v --ignore-fail-on-non-empty /usr/share/doc/LLVM</userinput>"
