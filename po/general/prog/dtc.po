msgid "Installation of Dtc"
msgstr "Instalação do Dtc"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/prog/dtc.xml:100
#, xml-text
msgid ""
"Install <application>dtc</application> by running the following commands:"
msgstr ""
"Instale <application>dtc</application> executando os seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/prog/dtc.xml:104
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup ..                  \\\n"
"      --prefix=/usr             \\\n"
"      --buildtype=release       \\\n"
"      -D default_library=shared \\\n"
"      -D python=disabled        &amp;&amp;\n"
"ninja</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup ..                  \\\n"
"      --prefix=/usr             \\\n"
"      --buildtype=release       \\\n"
"      -D default_library=shared \\\n"
"      -D python=disabled        &amp;&amp;\n"
"ninja</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/prog/dtc.xml:115
#, xml-text
msgid "To test the results, issue: <command>ninja test</command>."
msgstr "Para testar os resultados, emita: <command>ninja test</command>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/prog/dtc.xml:119
#, xml-text
