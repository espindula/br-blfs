#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/prog/sysprof.xml:88
msgid "Installation of Sysprof"
msgstr "Instalação do <quote>Sysprof</quote>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/prog/sysprof.xml:91
msgid ""
"Install <application>Sysprof</application> by running the following "
"commands:"
msgstr ""
"Instale &quot;<application>Sysprof</application>&quot; executando os "
"seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/prog/sysprof.xml:95
#, no-wrap
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr         \\\n"
"            --buildtype=release   \\\n"
"            -Dsystemdunitdir=/tmp \\\n"
"            ..                    &amp;&amp;\n"
"ninja</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr         \\\n"
"            --buildtype=release   \\\n"
"            -Dsystemdunitdir=/tmp \\\n"
"            ..                    &amp;&amp;\n"
"ninja</userinput>"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/prog/sysprof.xml:104
#, no-wrap
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr --buildtype=release .. &amp;&amp;\n"
"ninja</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr --buildtype=release .. &amp;&amp;\n"
"ninja</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/prog/sysprof.xml:111
msgid "To test the results, issue: <command>ninja test</command>."
msgstr "Para testar os resultados, emita: <command>ninja test</command>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/prog/sysprof.xml:115
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr "Agora, como o(a) usante <systemitem class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/prog/sysprof.xml:118
#, no-wrap
msgid ""
"<userinput>ninja install &amp;&amp;\n"
"rm -v /tmp/*.service</userinput>"
msgstr ""
"<userinput>ninja install &amp;&amp;\n"
"rm -v /tmp/*.service</userinput>"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/prog/sysprof.xml:121
#, no-wrap
msgid "<userinput>ninja install</userinput>"
msgstr "<userinput>ninja install</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/prog/sysprof.xml:126
msgid "Command Explanations"
msgstr "Explicações dos Comandos"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/prog/sysprof.xml:129
msgid ""
"<command>rm -v /tmp/*.service</command>: This command removes systemd units "
"which have no use on SysV systems."
msgstr ""
"<command>rm -v /tmp/*.service</command>: Esse comando remove unidades "
"&quot;systemd&quot; que não tem uso em sistemas &quot;SysV&quot;."

#.  for sd-bus
#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/prog/sysprof.xml:134
msgid ""
"<parameter>-Dsystemdunitdir=/tmp</parameter>: This parameter puts systemd "
"units in /tmp on SysV systems so that they can be removed. It also bypasses "
"a check for systemd in the meson.build file."
msgstr ""
"<parameter>-Dsystemdunitdir=/tmp</parameter>: Esse parâmetro coloca unidades"
" &quot;systemd&quot; em &quot;/tmp&quot; em sistemas &quot;SysV&quot; de "
"forma que elas consigam ser removidas. Ele também ignora uma verificação do "
"&quot;systemd&quot; no arquivo &quot;meson.build&quot;."

