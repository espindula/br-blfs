#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/prog/cbindgen.xml:81
#, xml-text
msgid "Installation of cbindgen"
msgstr "Instalação do \"cbindgen\""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/prog/cbindgen.xml:83
#, xml-text
msgid ""
"Install <application>cbindgen</application> by running the following "
"commands:"
msgstr ""
"Instale <application>cbindgen</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/prog/cbindgen.xml:87
#, no-wrap, xml-text
msgid "<userinput>cargo build --release</userinput>"
msgstr "<userinput>cargo build --release</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/prog/cbindgen.xml:90
#, xml-text
msgid ""
"To test the results, issue: <command>cargo test --release</command>.  Three "
"tests in <filename>profile.rs</filename> are known to fail because they "
"expect some Rust unstable features disabled in the BLFS <xref "
"linkend='rust'/> configuration."
msgstr ""
"Para testar os resultados, emita: <command>cargo test --release</command>. "
"Três testes em <filename>profile.rs</filename> são conhecidos por falharem "
"porque eles esperam alguns recursos instáveis da Rust desabilitados no na "
"configuração de <xref linkend='rust'/> do BLFS."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/prog/cbindgen.xml:97
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr "Agora, como o(a) usante <systemitem class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/prog/cbindgen.xml:100
#, no-wrap, xml-text
msgid ""
"<userinput>install -Dm755 target/release/cbindgen /usr/bin/</userinput>"
msgstr ""
"<userinput>install -Dm755 target/release/cbindgen /usr/bin/</userinput>"

