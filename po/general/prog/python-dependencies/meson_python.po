#: blfs-en/general/prog/python-dependencies/meson_python.xml:27
#, xml-text
msgid ""
"The <application>Meson_python</application> module contains a Python build "
"backend (PEP 517) for Meson projects."
msgstr ""
"O módulo &quot;<application>Meson_python</application>&quot; contém uma "
"estrutura de retaguarda de construção &quot;Python&quot; (&quot;PEP&quot; "
"517) para projetos &quot;Meson&quot;."

