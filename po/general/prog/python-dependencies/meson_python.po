#. type: Content of: <sect2><sect3><title>
#: blfs-en/general/prog/python-dependencies/meson_python.xml:93
#, xml-text
msgid "Installation of Meson_python"
msgstr "Instalação do Meson_python"

#. type: Content of: <sect2><sect3><para>
#: blfs-en/general/prog/python-dependencies/meson_python.xml:95
#, xml-text
msgid "Build the module:"
msgstr "Construa o módulo:"

#. type: Content of: <sect2><sect3><para>
#: blfs-en/general/prog/python-dependencies/meson_python.xml:100
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) &quot;<systemitem "
"class=\"username\">root</systemitem>&quot;:"

#. type: Content of: <sect2><sect3><screen>
#: blfs-en/general/prog/python-dependencies/meson_python.xml:103
#, no-wrap, xml-text
msgid "<userinput>&install-wheel; meson_python</userinput>"
msgstr "<userinput>&install-wheel; meson_python</userinput>"

#. type: Content of: <sect2><sect3><para>
#: blfs-en/general/prog/python-dependencies/meson_python.xml:106
#, xml-text
msgid ""
"To test the installation, make sure <xref linkend='git'/>, <xref "
"linkend='patchelf'/>, and <xref linkend='pytest'/> are installed, then issue"
" (<literal>HOME=</literal> prevents the <filename>.gitconfig</filename> file"
" in the home directory from interfering the tests):"
msgstr ""
"Para testar a instalação, certifique-se de que <xref linkend='git'/>, <xref "
"linkend='patchelf'/> e <xref linkend='pytest'/> estejam instalados e, em "
"seguida, emita (<literal>HOME=</literal> impede que o arquivo "
"<filename>.gitconfig</filename> no diretório inicial interfira nos testes):"

#. type: Content of: <sect2><sect3><screen>
#: blfs-en/general/prog/python-dependencies/meson_python.xml:114
#, no-wrap, xml-text
msgid ""
"<userinput>python3 -m venv --system-site-packages testenv &amp;&amp;\n"
"testenv/bin/pip3 install --group=test          &amp;&amp;\n"
"HOME= testenv/bin/python -m pytest</userinput>"
msgstr ""
"<userinput>python3 -m venv --system-site-packages testenv &amp;&amp;\n"
"testenv/bin/pip3 install --group=test          &amp;&amp;\n"
"HOME= testenv/bin/python -m pytest</userinput>"

