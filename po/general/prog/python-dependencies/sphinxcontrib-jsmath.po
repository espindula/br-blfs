#. type: Content of: <sect2><sect3><para>
#: blfs-en/general/prog/python-dependencies/sphinxcontrib-jsmath.xml:92
#, xml-text
msgid "The installation can be tested with the following commands:"
msgstr "A instalação pode ser testada com os seguintes comandos:"

#. type: Content of: <sect2><sect3><screen>
#: blfs-en/general/prog/python-dependencies/sphinxcontrib-jsmath.xml:95
#, no-wrap, xml-text
msgid ""
"<userinput>sed -i 's/text()/read_&amp;/' tests/test_jsmath.py &amp;&amp;\n"
"pytest</userinput>"
msgstr ""
"<userinput>sed -i 's/text()/read_&amp;/' tests/test_jsmath.py &amp;&amp;\n"
"pytest</userinput>"

#. type: Content of: <sect2><sect3><para>
#: blfs-en/general/prog/python-dependencies/sphinxcontrib-jsmath.xml:99
#, xml-text
msgid ""
"the <command>sed ...</command> command is needed because of a change in "
"<application>Sphinx</application> API for versions greater than 5.0."
msgstr ""
"o comando &quot;<command>sed ...</command>&quot; é necessário devido a uma "
"mudança na &quot;API&quot; &quot;<application>Sphinx</application>&quot; "
"para lançamentos superiores a 5.0."

