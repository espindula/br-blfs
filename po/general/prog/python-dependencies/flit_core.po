#. type: Content of: <sect2><sect3><title>
#: blfs-en/general/prog/python-dependencies/flit_core.xml:24
msgid "Introduction to Flit_core Module"
msgstr "Introdução ao Módulo <quote>Flit_core</quote>"

#. type: Content of: <sect2><sect3><para>
#: blfs-en/general/prog/python-dependencies/flit_core.xml:27
msgid ""
"The <application>Flit_core</application> module is the key component of the "
"<application>Flit</application> system, which provides a simple way to put "
"Python packages and modules on PyPi."
msgstr ""
"O módulo &quot;<application>Flit_core</application>&quot; é o componente "
"chave do sistema &quot;<application>Flit</application>&quot;, que fornece "
"uma maneira simples de colocar pacotes e módulos &quot;Python&quot; no "
"&quot;PyPi&quot;."

