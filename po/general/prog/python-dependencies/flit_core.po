#: blfs-en/general/prog/python-dependencies/flit_core.xml:72
msgid ""
"<xref linkend=\"pytest\"/> and <ulink "
"url=\"https://pypi.org/project/testpath/\">testpath</ulink>"
msgstr ""
"<xref linkend=\"pytest\"/> e <ulink "
"url=\"https://pypi.org/project/testpath/\">testpath</ulink>"

#. type: Content of: <sect2><sect3><title>
#: blfs-en/general/prog/python-dependencies/flit_core.xml:79
msgid "Installation of Flit_core"
msgstr "Instalação do <quote>Flit_core</quote>"

#. type: Content of: <sect2><sect3><para>
#: blfs-en/general/prog/python-dependencies/flit_core.xml:82
msgid "Build the module:"
msgstr "Construa o módulo:"

#. type: Content of: <sect2><sect3><screen>
#: blfs-en/general/prog/python-dependencies/flit_core.xml:85
#, no-wrap
msgid ""
"<userinput>pip3 wheel -w dist --no-build-isolation --no-deps "
"$PWD</userinput>"
msgstr ""
"<userinput>pip3 wheel -w dist --no-build-isolation --no-deps "
"$PWD</userinput>"

#. type: Content of: <sect2><sect3><para>
#: blfs-en/general/prog/python-dependencies/flit_core.xml:88
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect2><sect3><screen>
#: blfs-en/general/prog/python-dependencies/flit_core.xml:91
#, no-wrap
msgid ""
"<userinput>pip3 install --no-index --find-links dist --no-cache-dir --no-"
"user flit_core</userinput>"
msgstr ""
"<userinput>pip3 install --no-index --find-links dist --no-cache-dir --no-"
"user flit_core</userinput>"

#. type: Content of: <sect2><sect3><para>
#: blfs-en/general/prog/python-dependencies/flit_core.xml:94
msgid ""
"Assuming <xref linkend=\"pytest\"/> is installed, but the other optional "
"dependency is not, the installation can be tested with the following "
"commands:"
msgstr ""
"Supondo que &quot;<xref linkend=\"pytest\"/>&quot; esteja instalado, mas a "
"outra dependência opcional não esteja, a instalação pode ser testada com os "
"seguintes comandos:"

#.  no && in case there is an error
#. type: Content of: <sect2><sect3><screen>
#: blfs-en/general/prog/python-dependencies/flit_core.xml:99
#, no-wrap
msgid ""
"<userinput>python3 -m venv --system-site-packages testenv &amp;&amp;\n"
"source testenv/bin/activate                    &amp;&amp;\n"
"pip3 install testpath                          &amp;&amp;\n"
"python3 /usr/bin/pytest\n"
"deactivate</userinput>"
msgstr ""
"<userinput>python3 -m venv --system-site-packages testenv &amp;&amp;\n"
"source testenv/bin/activate                   &amp;&amp;\n"
"pip3 install testpath                          &amp;&amp;\n"
"python3 /usr/bin/pytest\n"
"deactivate</userinput>"

