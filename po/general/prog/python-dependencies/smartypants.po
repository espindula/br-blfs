#: blfs-en/general/prog/python-dependencies/smartypants.xml:94
#, no-wrap, xml-text
msgid "<userinput>&install-wheel; smartypants</userinput>"
msgstr "<userinput>&install-wheel; smartypants</userinput>"

#. type: Content of: <sect2><sect3><para>
#: blfs-en/general/prog/python-dependencies/smartypants.xml:97
#, xml-text
msgid "To test the results, issue:"
msgstr "Para testar os resultados, emita:"

#. type: Content of: <sect2><sect3><screen>
#: blfs-en/general/prog/python-dependencies/smartypants.xml:100
#, no-wrap, xml-text
msgid ""
"<userinput>cp /usr/bin/smartypants . &amp;&amp;\n"
"pytest</userinput>"
msgstr ""
"<userinput>cp /usr/bin/smartypants . &amp;&amp;\n"
"pytest</userinput>"

#. type: Content of: <sect2><sect3><para>
#: blfs-en/general/prog/python-dependencies/smartypants.xml:104
#, xml-text
msgid ""
"One test, <filename>SetupTestCase::test_long_description</filename>, is "
"known to print a warning about upcoming changes in docutils."
msgstr ""
"Um teste, <filename>SetupTestCase::test_long_description</filename>, é "
"conhecido por imprimir um aviso acerca de próximas mudanças no docutils."

