#. type: Content of: <sect2><sect3><para>
#: blfs-en/general/prog/python-dependencies/smartypants.xml:27
#, xml-text
msgid ""
"<application>Smartypants</application> translates plain ASCII punctuation "
"characters into <quote>smart</quote> typographic punctuation HTML entities."
msgstr ""
"&quot;<application>Smartypants</application>&quot; traduz caracteres de "
"pontuação &quot;ASCII&quot; simples em entidades &quot;HTML&quot; de "
"pontuação tipográfica <quote>inteligente</quote>."

