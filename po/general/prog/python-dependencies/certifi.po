#. type: Content of: <sect2><sect3><title>
#: blfs-en/general/prog/python-dependencies/certifi.xml:24
#, xml-text
msgid "Introduction to Certifi Module"
msgstr "Introdução ao Certifi Module"

#. type: Content of: <sect2><sect3><para>
#: blfs-en/general/prog/python-dependencies/certifi.xml:27
#, xml-text
msgid ""
"The <application>certifi</application> module provides Mozilla’s carefully "
"curated collection of Root Certificates for validating the trustworthiness "
"of SSL certificates while verifying the identity of TLS hosts."
msgstr ""
"O módulo <application>certifi</application> fornece uma coleção "
"cuidadosamente selecionada de Certificados Raiz da Mozilla para validar a "
"confiabilidade dos certificados SSL enquanto verifica a identidade dos "
"dispositivos TLS."

