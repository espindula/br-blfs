#. type: Content of: <sect2><sect3><title>
#: blfs-en/general/prog/python-dependencies/trove-classifiers.xml:79
#, xml-text
msgid "Installation of Trove-Classifiers"
msgstr "Instalação do Trove-Classifiers"

#. type: Content of: <sect2><sect3><para>
#: blfs-en/general/prog/python-dependencies/trove-classifiers.xml:82
#, xml-text
msgid ""
"First, hard code the package version into <filename>setup.py</filename> to "
"work around an issue causing the generated wheel to contain an incorrect "
"version string when the <application>calver</application> module is not "
"installed:"
msgstr ""
"Primeiro, codifique rigidamente a versão do pacote em "
"<filename>setup.py</filename> para contornar um problema que faz com que a "
"roda gerada contenha uma sequência incorreta de caracteres de versão quando "
"o módulo <application>calver</application> não estiver instalado:"

#. type: Content of: <sect2><sect3><screen>
#: blfs-en/general/prog/python-dependencies/trove-classifiers.xml:88
#, no-wrap, xml-text
msgid ""
"<userinput>sed -i '/calver/s/^/#/;$iversion=\"&trove-classifiers-version;\"'"
" setup.py</userinput>"
msgstr ""
"<userinput>sed -i '/calver/s/^/#/;$iversion=\"&trove-classifiers-version;\"'"
" setup.py</userinput>"

#. type: Content of: <sect2><sect3><para>
#: blfs-en/general/prog/python-dependencies/trove-classifiers.xml:90
#, xml-text
msgid "Build the module:"
msgstr "Construa o módulo:"

#. type: Content of: <sect2><sect3><para>
#: blfs-en/general/prog/python-dependencies/trove-classifiers.xml:95
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect2><sect3><screen>
#: blfs-en/general/prog/python-dependencies/trove-classifiers.xml:98
#, no-wrap, xml-text
msgid "<userinput>&install-wheel; trove-classifiers</userinput>"
msgstr "<userinput>&install-wheel; trove-classifiers</userinput>"

#. type: Content of: <sect2><sect3><para>
#: blfs-en/general/prog/python-dependencies/trove-classifiers.xml:101
#, xml-text
msgid "To test the installation, issue: <command>pytest</command>."
msgstr "Para testar a instalação, emita: <command>pytest</command>."

