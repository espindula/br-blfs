msgid "Introduction to vcs_versioning Module"
msgstr "Introdução ao vcs_versioning Module"

#. type: Content of: <sect2><sect3><para>
#: blfs-en/general/prog/python-dependencies/vcs_versioning.xml:27
#, xml-text
msgid ""
"<application>vcs_versioning</application> provides essential functionality "
"for setuptools_scm that allows that module to properly set version control "
"metadata."
msgstr ""
"<application>vcs_versioning</application> fornece uma funcionalidade "
"essencial para setuptools_scm, que permite que esse módulo configure "
"adequadamente metadados de controle de versão."

