msgid "Introduction to Poetry-core Module"
msgstr "Introdução ao Poetry-core Module"

#. type: Content of: <sect2><sect3><para>
#: blfs-en/general/prog/python-dependencies/poetry-core.xml:27
#, xml-text
msgid ""
"<application>Poetry-core</application> is an extensible, standards compliant"
" build backend for python modules."
msgstr ""
"<application>Poetry-core</application> é uma estrutura de retaguarda de "
"construção extensível e em conformidade com padrões para módulos Python."

