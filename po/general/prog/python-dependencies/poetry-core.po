msgstr "Opcionais (para testes)"

#. type: Content of: <sect2><sect3><para>
#: blfs-en/general/prog/python-dependencies/poetry-core.xml:71
#, xml-text
msgid ""
"<xref linkend=\"pytest\"/>, <xref linkend=\"pypa-build\"/>, <ulink "
"url=\"https://pypi.org/project/pytest-cov/\">pytest-cov</ulink>, <ulink "
"url=\"https://pypi.org/project/pytest-mock/\">pytest-mock</ulink>, and "
"<ulink url=\"https://pypi.org/project/virtualenv/\">virtualenv</ulink>"
msgstr ""
"<xref linkend=\"pytest\"/>, <xref linkend=\"pypa-build\"/>, <ulink "
"url=\"https://pypi.org/project/pytest-cov/\">pytest-cov</ulink>, <ulink "
"url=\"https://pypi.org/project/pytest-mock/\">pytest-mock</ulink> e <ulink "
"url=\"https://pypi.org/project/virtualenv/\">virtualenv</ulink>"

#. type: Content of: <sect2><sect3><title>
#: blfs-en/general/prog/python-dependencies/poetry-core.xml:81
#, xml-text
msgid "Installation of Poetry-core"
msgstr "Instalação do Poetry-core"

#. type: Content of: <sect2><sect3><para>
#: blfs-en/general/prog/python-dependencies/poetry-core.xml:83
#, xml-text
msgid "Build the module:"
msgstr "Construa o módulo:"

#. type: Content of: <sect2><sect3><para>
#: blfs-en/general/prog/python-dependencies/poetry-core.xml:88
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr "Agora, como o(a) usante <systemitem class=\"username\">root</systemitem>:"

#. type: Content of: <sect2><sect3><screen>
#: blfs-en/general/prog/python-dependencies/poetry-core.xml:91
#, no-wrap, xml-text
msgid "<userinput>&install-wheel; poetry-core</userinput>"
msgstr "<userinput>&install-wheel; poetry-core</userinput>"

#. type: Content of: <sect2><sect3><para>
#: blfs-en/general/prog/python-dependencies/poetry-core.xml:94
#, xml-text
msgid ""
"To test the installation, make sure <xref linkend='pytest'/> and <xref "
"linkend='pypa-build'/> are installed, then issue:"
msgstr ""
"Para testar a instalação, assegure-se de que <xref linkend='pytest'/> e "
"<xref linkend='pypa-build'/> estejam instalados, então emita:"

#. type: Content of: <sect2><sect3><screen>
#: blfs-en/general/prog/python-dependencies/poetry-core.xml:99
#, no-wrap, xml-text
msgid ""
"<userinput>python3 -m venv --system-site-packages testenv                &amp;&amp;\n"
"testenv/bin/pip3 install pytest-{cov,mock} tomli-w virtualenv &amp;&amp;\n"
"testenv/bin/python -m pytest</userinput>"
msgstr ""
"<userinput>python3 -m venv --system-site-packages testenv                &amp;&amp;\n"
"testenv/bin/pip3 install pytest-{cov,mock} tomli-w virtualenv &amp;&amp;\n"
"testenv/bin/python -m pytest</userinput>"

