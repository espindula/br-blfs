#. type: Content of: <sect2><sect3><para>
#: blfs-en/general/prog/python-dependencies/attrs.xml:103
#, xml-text
msgid "To test the installation, run:"
msgstr "Para testar a instalação, execute:"

#. type: Content of: <sect2><sect3><screen>
#: blfs-en/general/prog/python-dependencies/attrs.xml:106
#, no-wrap, xml-text
msgid ""
"<userinput>python3 -m venv --system-site-packages testenv           &amp;&amp;\n"
"testenv/bin/pip3 install 'attrs[tests]'                  &amp;&amp;\n"
"PATH=$PWD/testenv/bin:$PATH testenv/bin/python -m pytest</userinput>"
msgstr ""
"<userinput>python3 -m venv --system-site-packages testenv           &amp;&amp;\n"
"testenv/bin/pip3 install 'attrs[tests]'                  &amp;&amp;\n"
"PATH=$PWD/testenv/bin:$PATH testenv/bin/python -m pytest</userinput>"

