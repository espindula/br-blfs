#: blfs-en/general/prog/python-dependencies/pyproject-metadata.xml:89
#, no-wrap, xml-text
msgid "<userinput>&install-wheel; pyproject-metadata</userinput>"
msgstr "<userinput>&install-wheel; pyproject-metadata</userinput>"

#. type: Content of: <sect2><sect3><para>
#: blfs-en/general/prog/python-dependencies/pyproject-metadata.xml:93
#, xml-text
msgid ""
"To test the installation, make sure <xref linkend='pytest'/> is installed "
"and run:"
msgstr ""
"Para testar a instalação, assegure-se de que <xref linkend='pytest'/> esteja"
" instalado e execute:"

#. type: Content of: <sect2><sect3><screen>
#: blfs-en/general/prog/python-dependencies/pyproject-metadata.xml:97
#, no-wrap, xml-text
msgid ""
"<userinput>python3 -m venv --system-site-packages testenv &amp;&amp;\n"
"testenv/bin/pip3 install exceptiongroup        &amp;&amp;\n"
"testenv/bin/python3 -m pytest</userinput>"
msgstr ""
"<userinput>python3 -m venv --system-site-packages testenv &amp;&amp;\n"
"testenv/bin/pip3 install exceptiongroup        &amp;&amp;\n"
"testenv/bin/python3 -m pytest</userinput>"

