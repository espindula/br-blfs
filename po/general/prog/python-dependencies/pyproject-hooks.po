#. type: Content of: <sect2><sect3><para>
#: blfs-en/general/prog/python-dependencies/pyproject-hooks.xml:27
#, xml-text
msgid ""
"<application>Pyproject_Hooks</application> is a low-level library for "
"calling build-backends in <filename>pyproject.toml</filename>-based "
"projects."
msgstr ""
"<application>Pyproject_Hooks</application> é uma biblioteca de baixo nível "
"para chamar estruturas de retaguarda de construção em projetos baseados em "
"<filename>pyproject.toml</filename>."

