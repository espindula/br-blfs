#: blfs-en/general/prog/python-dependencies/pyproject-hooks.xml:79
#, xml-text
msgid "Installation of Pyproject_Hooks"
msgstr "Instalação do Pyproject_Hooks"

#. type: Content of: <sect2><sect3><para>
#: blfs-en/general/prog/python-dependencies/pyproject-hooks.xml:81
#, xml-text
msgid "Build the module:"
msgstr "Construa o módulo:"

#. type: Content of: <sect2><sect3><para>
#: blfs-en/general/prog/python-dependencies/pyproject-hooks.xml:86
#, xml-text
msgid "Now, as the &root; user:"
msgstr "Agora, como o(a) usuário(a) &root;:"

#. type: Content of: <sect2><sect3><screen>
#: blfs-en/general/prog/python-dependencies/pyproject-hooks.xml:89
#, no-wrap, xml-text
msgid "<userinput>&install-wheel; pyproject_hooks</userinput>"
msgstr "<userinput>&install-wheel; pyproject_hooks</userinput>"

#. type: Content of: <sect2><sect3><para>
#: blfs-en/general/prog/python-dependencies/pyproject-hooks.xml:92
#, xml-text
msgid ""
"Assuming <xref linkend=\"pytest\"/> is installed, but the other optional "
"dependency is not, the installation can be tested with the following "
"commands:"
msgstr ""
"Supondo que <xref linkend=\"pytest\"/> esteja instalado, mas a outra "
"dependência opcional não esteja, a instalação pode ser testada com os "
"seguintes comandos:"

#.  no && because of a possible error
#. type: Content of: <sect2><sect3><screen>
#: blfs-en/general/prog/python-dependencies/pyproject-hooks.xml:97
#, no-wrap, xml-text
msgid ""
"<userinput>python3 -m venv --system-site-packages testenv &amp;&amp;\n"
"source testenv/bin/activate                    &amp;&amp;\n"
"pip3 install testpath                          &amp;&amp;\n"
"python3 -m pytest\n"
"deactivate</userinput>"
msgstr ""
"<userinput>python3 -m venv --system-site-packages testenv &amp;&amp;\n"
"source testenv/bin/activate                    &amp;&amp;\n"
"pip3 install testpath                          &amp;&amp;\n"
"python3 -m pytest\n"
"deactivate</userinput>"

