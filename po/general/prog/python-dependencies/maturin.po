#. type: Content of: <sect2><sect3><title>
#: blfs-en/general/prog/python-dependencies/maturin.xml:92
#, xml-text
msgid "Installation of maturin"
msgstr "Instalação do maturin"

#. type: Content of: <sect2><sect3><para>
#: blfs-en/general/prog/python-dependencies/maturin.xml:95
#, xml-text
msgid "Build the module:"
msgstr "Construa o módulo:"

#. type: Content of: <sect2><sect3><para>
#: blfs-en/general/prog/python-dependencies/maturin.xml:101
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr "Agora, como o(a) usante <systemitem class=\"username\">root</systemitem>:"

#. type: Content of: <sect2><sect3><screen>
#: blfs-en/general/prog/python-dependencies/maturin.xml:104
#, no-wrap, xml-text
msgid "<userinput>&install-wheel; maturin</userinput>"
msgstr "<userinput>&install-wheel; maturin</userinput>"

#. type: Content of: <sect2><sect3><para>
#: blfs-en/general/prog/python-dependencies/maturin.xml:107
#, xml-text
msgid "To test the installation, issue:"
msgstr "Para testar a instalação, emita:"

#. type: Content of: <sect2><sect3><screen>
#: blfs-en/general/prog/python-dependencies/maturin.xml:110
#, no-wrap, xml-text
msgid ""
"<userinput>python3 -m venv --system-site-packages testenv     &amp;&amp;\n"
"testenv/bin/pip3 install cffi pycparser virtualenv &amp;&amp;\n"
"PATH=$PWD/testenv/bin:$PATH cargo test</userinput>"
msgstr ""
"<userinput>python3 -m venv --system-site-packages testenv     &amp;&amp;\n"
"testenv/bin/pip3 install cffi pycparser virtualenv &amp;&amp;\n"
"PATH=$PWD/testenv/bin:$PATH cargo test</userinput>"

#. type: Content of: <sect2><sect3><para>
#: blfs-en/general/prog/python-dependencies/maturin.xml:115
#, xml-text
msgid ""
"Six tests, "
"<filename>errors::pypi_compatibility_unsupported_target</filename>, "
"<filename>integration::integration_cffi_cases::case_2_cffi_mixed</filename>,"
" <filename>integration::integration_wasm_hello_world</filename>, "
"<filename>sdist::external_python_source_sdist</filename>, "
"<filename>sdist::lib_with_parent_workspace_path_dep_sdist</filename>, and "
"<filename>sdist::pyo3_mixed_include_exclude_sdist</filename> are known to "
"fail."
msgstr ""
"Seis testes, "
"<filename>errors::pypi_compatibility_unsupported_target</filename>, "
"<filename>integration::integration_cffi_cases::case_2_cffi_mixed</filename>,"
" <filename>integration::integration_wasm_hello_world</filename>, "
"<filename>sdist::external_python_source_sdist</filename>, "
"<filename>sdist::lib_with_parent_workspace_path_dep_sdist</filename> e "
"<filename>sdist::pyo3_mixed_include_exclude_sdist</filename> são conhecidos "
"por falharem."

