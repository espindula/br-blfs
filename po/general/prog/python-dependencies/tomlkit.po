#. type: Content of: <sect2><sect3><title>
#: blfs-en/general/prog/python-dependencies/tomlkit.xml:24
#, xml-text
msgid "Introduction to Tomlkit Module"
msgstr "Introdução ao Tomlkit Module"

#. type: Content of: <sect2><sect3><para>
#: blfs-en/general/prog/python-dependencies/tomlkit.xml:27
#, xml-text
msgid ""
"<application>Tomlkit</application> is an extensible, standards compliant "
"build backend for python modules."
msgstr ""
"<application>Tomlkit</application> é uma estrutura de retaguarda de "
"construção extensível e em conformidade com padrões para módulos Python."

