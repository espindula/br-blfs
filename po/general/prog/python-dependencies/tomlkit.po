#. type: Content of: <sect2><sect3><title>
#: blfs-en/general/prog/python-dependencies/tomlkit.xml:83
#, xml-text
msgid "Installation of Tomlkit"
msgstr "Instalação do Tomlkit"

#. type: Content of: <sect2><sect3><para>
#: blfs-en/general/prog/python-dependencies/tomlkit.xml:85
#, xml-text
msgid "Build the module:"
msgstr "Construa o módulo:"

#. type: Content of: <sect2><sect3><para>
#: blfs-en/general/prog/python-dependencies/tomlkit.xml:90
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr "Agora, como o(a) usante <systemitem class=\"username\">root</systemitem>:"

#. type: Content of: <sect2><sect3><screen>
#: blfs-en/general/prog/python-dependencies/tomlkit.xml:93
#, no-wrap, xml-text
msgid "<userinput>&install-wheel; tomlkit</userinput>"
msgstr "<userinput>&install-wheel; tomlkit</userinput>"

#. type: Content of: <sect2><sect3><para>
#: blfs-en/general/prog/python-dependencies/tomlkit.xml:96
#, xml-text
msgid ""
"To test the installation, make sure <xref linkend='pytest'/> is installed, "
"then issue:"
msgstr ""
"Para testar a instalação, assegure-se de que <xref linkend='pytest'/> esteja"
" instalado, então emita:"

#. type: Content of: <sect2><sect3><screen>
#: blfs-en/general/prog/python-dependencies/tomlkit.xml:101
#, no-wrap, xml-text
msgid ""
"<userinput>python3 -m venv --system-site-packages testenv &amp;&amp;\n"
"testenv/bin/pip3 install pytest-cov            &amp;&amp;\n"
"testenv/bin/python -m pytest</userinput>"
msgstr ""
"<userinput>python3 -m venv --system-site-packages testenv &amp;&amp;\n"
"testenv/bin/pip3 install pytest-cov            &amp;&amp;\n"
"testenv/bin/python -m pytest</userinput>"

