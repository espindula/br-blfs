"url=\"https://pypi.org/project/freezegun/\">freezegun</ulink>, and <ulink "
"url=\"https://pypi.org/project/pytest-cov/\">pytest-cov</ulink>"
msgstr ""
"<xref linkend=\"pytest\"/>, <ulink "
"url=\"https://pypi.org/project/freezegun/\">freezegun</ulink> e <ulink "
"url=\"https://pypi.org/project/pytest-cov/\">pytest-cov</ulink>"

#. type: Content of: <sect2><sect3><title>
#: blfs-en/general/prog/python-dependencies/Babel.xml:86
#, xml-text
msgid "Installation of Babel"
msgstr "Instalação do Babel"

#. type: Content of: <sect2><sect3><para>
#: blfs-en/general/prog/python-dependencies/Babel.xml:87
#, xml-text
msgid "Build the module:"
msgstr "Construa o módulo:"

#. type: Content of: <sect2><sect3><para>
#: blfs-en/general/prog/python-dependencies/Babel.xml:92
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) &quot;<systemitem "
"class=\"username\">root</systemitem>&quot;:"

#. type: Content of: <sect2><sect3><screen>
#: blfs-en/general/prog/python-dependencies/Babel.xml:95
#, no-wrap, xml-text
msgid "<userinput>&install-wheel; Babel</userinput>"
msgstr "<userinput>&install-wheel; Babel</userinput>"

#. type: Content of: <sect2><sect3><para>
#: blfs-en/general/prog/python-dependencies/Babel.xml:98
#, xml-text
msgid ""
"Assuming <xref linkend=\"pytest\"/> is installed, but the other optional "
"dependencies are not, the installation can be tested with the following "
"commands:"
msgstr ""
"Supondo que <xref linkend=\"pytest\"/> esteja instalado, mas as outras "
"dependências opcionais não estejam, a instalação pode ser testada com os "
"seguintes comandos:"

#. type: Content of: <sect2><sect3><screen>
#: blfs-en/general/prog/python-dependencies/Babel.xml:103
#, no-wrap, xml-text
msgid ""
"<userinput>python3 -m venv --system-site-packages testenv &amp;&amp;\n"
"source testenv/bin/activate                    &amp;&amp;\n"
"pip3 install pytest-cov freezegun              &amp;&amp;\n"
"python3 /usr/bin/pytest\n"
"deactivate</userinput>"
msgstr ""
"<userinput>python3 -m venv --system-site-packages testenv &amp;&amp;\n"
"source testenv/bin/activate                    &amp;&amp;\n"
"pip3 install pytest-cov freezegun              &amp;&amp;\n"
"python3 /usr/bin/pytest\n"
"deactivate</userinput>"

