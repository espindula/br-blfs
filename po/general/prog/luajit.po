#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/prog/luajit.xml:68
#, xml-text
msgid "Installation of luajit"
msgstr "Instalação do luajit"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/prog/luajit.xml:71
#, xml-text
msgid ""
"Install <application>luajit</application> by running the following commands:"
msgstr ""
"Instale <application>luajit</application> executando os seguintes comandos:"

#.  We need to specify PREFIX=/usr here so it loads plugins from
#.      /usr/lib/luajit instead of /usr/local/lib/luajit.
#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/prog/luajit.xml:78
#, no-wrap, xml-text
msgid "<userinput>make PREFIX=/usr amalg</userinput>"
msgstr "<userinput>make PREFIX=/usr amalg</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/prog/luajit.xml:81
#, xml-text
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/prog/luajit.xml:85
#, xml-text
msgid "Now, as the &root; user:"
msgstr "Agora, como o(a) usuário(a) &root;:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/prog/luajit.xml:88
#, no-wrap, xml-text
msgid ""
"<userinput>make PREFIX=/usr install &amp;&amp;\n"
"rm -v /usr/lib/libluajit-5.1.a</userinput>"
msgstr ""
"<userinput>make PREFIX=/usr install &amp;&amp;\n"
"rm -v /usr/lib/libluajit-5.1.a</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/prog/luajit.xml:94
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/prog/luajit.xml:97
#, xml-text
msgid ""
"<parameter>amalg</parameter>: This ensures an amalgamated build, i.e. the "
"LuaJIT core is compiled as one huge C file, allowing GCC to generate faster "
"and shorter code."
msgstr ""
"<parameter>amalg</parameter>: Isso garante uma construção amalgamada, ou "
"seja, o núcleo LuaJIT é compilado como um grande arquivo C, permitindo que o"
" GCC gere código mais rápido e mais curto."

