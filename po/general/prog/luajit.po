#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/prog/luajit.xml:24
#, xml-text
msgid "Introduction to luajit"
msgstr "Introdução ao luajit"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/prog/luajit.xml:27
#, xml-text
msgid ""
"The <application>luajit</application> package contains a Just-In-Time "
"compiler for Lua. It is often used as scripting middleware, and it is high "
"performance while also having a low memory footprint."
msgstr ""
"O pacote <application>luajit</application> contém um compilador Just-In-Time"
" para Lua. Ele frequentemente é usado como middleware de automação, e tem "
"alto desempenho, ao mesmo tempo em que ocupa pouca memória."

