#: blfs-en/general/prog/python-modules/cython.xml:150
#, xml-text
msgid ""
"is a compiler for code written in the Cython language. It outputs an "
"extension module which is directly importable from Python"
msgstr ""
"é um compilador para código escrito na linguagem Cython. Ele gera um módulo "
"de extensão que é importável diretamente a partir do Python"

