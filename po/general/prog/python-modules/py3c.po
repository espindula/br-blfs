#. type: Content of: <sect2><sect3><title>
#: blfs-en/general/prog/python-modules/py3c.xml:25
#, xml-text
msgid "Introduction to Py3c"
msgstr "Introdução ao Py3c"

#. type: Content of: <sect2><sect3><para>
#: blfs-en/general/prog/python-modules/py3c.xml:28
#, xml-text
msgid ""
"<application>Py3c</application> helps you port C extensions to Python 3. It "
"provides a detailed guide as well as a set of macros to make porting easier "
"and reduce boilerplate."
msgstr ""
"<application>Py3c</application> te ajuda a portar extensões da C para Python"
" 3. Ele fornece um guia detalhado bem como um conjunto de macros para "
"facilitar a portabilidade e reduzir o clichê."

