#. type: Content of: <sect2><sect3><title>
#: blfs-en/general/prog/python-modules/py3c.xml:80
#, xml-text
msgid "Installation of Py3c"
msgstr "Instalação do Py3c"

#. type: Content of: <sect2><sect3><para>
#: blfs-en/general/prog/python-modules/py3c.xml:83
#, xml-text
msgid ""
"The <application>Py3c</application> package is a headers-only package and "
"because of that, no configuration or compilation is required."
msgstr ""
"O pacote <application>Py3c</application> é um pacote somente de cabeçalhos "
"e, por isso, nenhuma configuração ou compilação é exigida."

#. type: Content of: <sect2><sect3><para>
#: blfs-en/general/prog/python-modules/py3c.xml:88
#, xml-text
msgid "To test the package, issue:"
msgstr "Para testar o pacote, emita:"

#. type: Content of: <sect2><sect3><screen>
#: blfs-en/general/prog/python-modules/py3c.xml:91
#, no-wrap, xml-text
msgid ""
"<userinput>make test-python3     &amp;&amp;\n"
"make test-python3-cpp</userinput>"
msgstr ""
"<userinput>make test-python3     &amp;&amp;\n"
"make test-python3-cpp</userinput>"

#. type: Content of: <sect2><sect3><para>
#: blfs-en/general/prog/python-modules/py3c.xml:95
#, xml-text
msgid ""
"To install the <application>py3c</application> module, run the following "
"command as the &root; user:"
msgstr ""
"Para instalar o módulo <application>py3c</application>, execute o seguinte "
"comando como o(a) usuário(a) &root;:"

#.  Note:
#.   Now, doing a DESTDIR install is just
#.     "make prefix=/usr DESTDIR=<dest> install"
#. type: Content of: <sect2><sect3><screen>
#: blfs-en/general/prog/python-modules/py3c.xml:103
#, no-wrap, xml-text
msgid "<userinput>make prefix=/usr install</userinput>"
msgstr "<userinput>make prefix=/usr install</userinput>"

