#. type: Content of: <sect2><sect3><title>
#: blfs-en/general/prog/python-modules/jinja2.xml:25
msgid "Introduction to Jinja2 Module"
msgstr "Introdução ao Módulo <quote>Jinja2</quote>"

#. type: Content of: <sect2><sect3><para>
#: blfs-en/general/prog/python-modules/jinja2.xml:28
msgid ""
"<application>Jinja2</application> is a <application>Python</application> "
"module that implements a simple pythonic template language."
msgstr ""
"&quot;<application>Jinja2</application>&quot; é um módulo "
"&quot;<application>Python</application>&quot; que implementa uma linguagem "
"simples de modelo pitônico."

#. type: Content of: <sect2><sect3><note><para>
#: blfs-en/general/prog/python-modules/jinja2.xml:34
msgid ""
"<application>Jinja2</application> was installed in LFS.  The instruction is "
"only kept here for SysV revision."
msgstr ""
"&quot;<application>Jinja2</application>&quot; foi instalado no LFS. A "
"instrução é mantida aqui somente para a revisão &quot;SysV&quot;."

