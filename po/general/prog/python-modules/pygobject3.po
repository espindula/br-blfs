#. type: Content of: <sect2><sect3><para>
#: blfs-en/general/prog/python-modules/pygobject3.xml:29
#, xml-text
msgid ""
"<application>PyGObject3</application> provides "
"<application>Python</application> bindings to the GObject class from "
"<application>GLib</application>."
msgstr ""
"&quot;<application>PyGObject3</application>&quot; fornece ligações "
"&quot;<application>Python</application>&quot; para a classe "
"&quot;GObject&quot; originária da "
"&quot;<application>GLib</application>&quot;."

