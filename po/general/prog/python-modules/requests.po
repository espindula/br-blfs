#. type: Content of: <sect2><sect3><title>
#: blfs-en/general/prog/python-modules/requests.xml:24
#, xml-text
msgid "Introduction to Requests Module"
msgstr "Introdução ao Módulo Requests"

#. type: Content of: <sect2><sect3><para>
#: blfs-en/general/prog/python-modules/requests.xml:27
#, xml-text
msgid ""
"The <application>Requests</application> package is an elegant and simple "
"HTTP library for Python, built for human beings. It allows sending HTTP/1.1 "
"requests extremely easily."
msgstr ""
"O pacote &quot;<application>Requests</application>&quot; é uma biblioteca "
"&quot;HTTP&quot; elegante e simples para &quot;Python&quot;, construída para"
" seres humanos. Permite enviar solicitações &quot;HTTP/1.1&quot; "
"extremamente facilmente."

#. type: Content of: <sect2><sect3><bridgehead>
#: blfs-en/general/prog/python-modules/requests.xml:34
#, xml-text
msgid "Package Information"
msgstr "Informação do Pacote"

