#: blfs-en/general/prog/python-modules/html5lib.xml:110
#, xml-text
msgid "To build the <application>Python 3</application> module, run:"
msgstr ""
"Para construir o módulo do <application>Python 3</application>, execute:"

#. type: Content of: <sect2><sect3><para>
#: blfs-en/general/prog/python-modules/html5lib.xml:116
#, xml-text
msgid "To install the module, issue the following command as the &root; user:"
msgstr ""
"Para instalar o módulo, emita o seguinte comando como o(a) usuário(a) "
"&root;:"

#. type: Content of: <sect2><sect3><screen>
#: blfs-en/general/prog/python-modules/html5lib.xml:119
#, no-wrap, xml-text
msgid "<userinput>&install-wheel; html5lib</userinput>"
msgstr "<userinput>&install-wheel; html5lib</userinput>"

#. type: Content of: <sect2><sect3><para>
#: blfs-en/general/prog/python-modules/html5lib.xml:122
#, xml-text
msgid ""
"This package does have a test suite, but it is not functional due to "
"depending on several hardcoded versions of packages that are only usable "
"with Python 3.6."
msgstr ""
"Esse pacote tem uma suíte de teste, mas ela não é funcional devido à "
"dependência de várias versões rigidamente codificadas de pacotes que só são "
"usáveis com o Python 3.6."

