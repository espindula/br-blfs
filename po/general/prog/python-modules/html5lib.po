#. type: Content of: <sect2><sect3><para>
#: blfs-en/general/prog/python-modules/html5lib.xml:93
#, xml-text
msgid ""
"First, fix a build failure with Python 3.14 caused by the removal of several"
" methods from the 'ast' module:"
msgstr ""
"Primeiro, corrija uma falha de construção com o Python 3.14 causada pela "
"remoção de vários métodos originários do módulo 'ast':"

#. type: Content of: <sect2><sect3><screen>
#: blfs-en/general/prog/python-modules/html5lib.xml:97
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"pre\">patch -Np1 -i ../html5lib-&html5lib-"
"version;-python_3.14_buildfix-1.patch</userinput>"
msgstr ""
"<userinput remap=\"pre\">patch -Np1 -i ../html5lib-&html5lib-"
"version;-python_3.14_buildfix-1.patch</userinput>"

#.  Loosely based on upstream PR#592, primarily excluding additional
#.              guards that we don't need because we're only supporting
#.              setuptools-82 and later.
#. type: Content of: <sect2><sect3><para>
#: blfs-en/general/prog/python-modules/html5lib.xml:103
#, xml-text
msgid "Next, fix a build failure with setuptools-82.0.0:"
msgstr "A seguir, corrija uma falha de construção com setuptools-82.0.0:"

#. type: Content of: <sect2><sect3><screen>
#: blfs-en/general/prog/python-modules/html5lib.xml:106
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"pre\">sed -i 's/from pkg_resources import/from packaging.version import parse as/' setup.py &amp;&amp;\n"
"sed -i 's/import pkg_resources/pkg_resources = None/' setup.py</userinput>"
msgstr ""
"<userinput remap=\"pre\">sed -i 's/from pkg_resources import/from packaging.version import parse as/' setup.py &amp;&amp;\n"
"sed -i 's/import pkg_resources/pkg_resources = None/' setup.py</userinput>"

