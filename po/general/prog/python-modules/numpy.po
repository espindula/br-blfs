#. type: Content of: <sect2><sect3><title>
#: blfs-en/general/prog/python-modules/numpy.xml:119
#, xml-text
msgid "Installation of NumPy"
msgstr "Instalação do NumPy"

#. type: Content of: <sect2><sect3><para>
#: blfs-en/general/prog/python-modules/numpy.xml:121
#, xml-text
msgid "Build the module:"
msgstr "Construa o módulo:"

#. type: Content of: <sect2><sect3><screen>
#: blfs-en/general/prog/python-modules/numpy.xml:123
#, no-wrap, xml-text
msgid ""
"<userinput>pip3 wheel -w dist --no-build-isolation --no-deps --no-cache-dir \\\n"
"           -C setup-args=-Dallow-noblas=true $PWD</userinput>"
msgstr ""
"<userinput>pip3 wheel -w dist --no-build-isolation --no-deps --no-cache-dir \\\n"
"           -C setup-args=-Dallow-noblas=true $PWD</userinput>"

#. type: Content of: <sect2><sect3><para>
#: blfs-en/general/prog/python-modules/numpy.xml:127
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect2><sect3><screen>
#: blfs-en/general/prog/python-modules/numpy.xml:130
#, no-wrap, xml-text
msgid "<userinput>&install-wheel; numpy</userinput>"
msgstr "<userinput>&install-wheel; numpy</userinput>"

#. type: Content of: <sect2><sect3><para>
#: blfs-en/general/prog/python-modules/numpy.xml:133
#, xml-text
msgid "The installation can be tested with the following commands:"
msgstr "A instalação pode ser testada com os seguintes comandos:"

#. type: Content of: <sect2><sect3><screen>
#: blfs-en/general/prog/python-modules/numpy.xml:136
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir -p test                                  &amp;&amp;\n"
"cd       test                                  &amp;&amp;\n"
"python3 -m venv --system-site-packages testenv &amp;&amp;\n"
"source testenv/bin/activate                    &amp;&amp;\n"
"pip3 install hypothesis attrs                  &amp;&amp;\n"
"python3 -c \"import numpy, sys; sys.exit(numpy.test() is False)\"\n"
"deactivate</userinput>"
msgstr ""
"<userinput>mkdir -p test                                  &amp;&amp;\n"
"cd       test                                  &amp;&amp;\n"
"python3 -m venv --system-site-packages testenv &amp;&amp;\n"
"source testenv/bin/activate                    &amp;&amp;\n"
"pip3 install hypothesis attrs                  &amp;&amp;\n"
"python3 -c \"import numpy, sys; sys.exit(numpy.test() is False)\"\n"
"deactivate</userinput>"

