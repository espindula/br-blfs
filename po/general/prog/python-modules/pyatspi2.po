#. type: Content of: <sect2><sect3><title>
#: blfs-en/general/prog/python-modules/pyatspi2.xml:87
#, xml-text
msgid "Installation of PyAtSpi2"
msgstr "Instalação do PyAtSpi2"

#. type: Content of: <sect2><sect3><para>
#: blfs-en/general/prog/python-modules/pyatspi2.xml:90
#, fuzzy, xml-text
#| msgid ""
#| "To build <application>PyAtSpi2</application> as a <application>Python "
#| "3</application> module, run the following commands:"
msgid ""
"To build <application>PyAtSpi2</application>, run the following commands:"
msgstr ""
"Para construir &quot;<application>PyAtSpi2</application>&quot; como um "
"módulo &quot;<application>Python 3</application>&quot;, execute os seguintes"
" comandos:"

#. type: Content of: <sect2><sect3><screen>
#: blfs-en/general/prog/python-modules/pyatspi2.xml:94
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr --buildtype=release -D enable_tests=true .. &amp;&amp;\n"
"ninja</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr --buildtype=release -D enable_tests=true .. &amp;&amp;\n"
"ninja</userinput>"

#. type: Content of: <sect2><sect3><para>
#: blfs-en/general/prog/python-modules/pyatspi2.xml:102
#, xml-text
msgid ""
"To run the tests issue: <command>ninja test</command>. The tests need to be "
"run in a graphical environment."
msgstr ""
"Para executar os testes, emita: <command>ninja test</command>. Os testes "
"precisam ser executados em um ambiente gráfico."

#. type: Content of: <sect2><sect3><para>
#: blfs-en/general/prog/python-modules/pyatspi2.xml:107
#, fuzzy, xml-text
#| msgid ""
#| "To install the <application>Python 3</application> module, run the following"
#| " command as the <systemitem class=\"username\">root</systemitem> user:"
msgid "To install the module, run the following command as the &root; user:"
msgstr ""
"Para instalar o módulo &quot;<application>Python 3</application>&quot;, "
"execute o seguinte comando como o(a) usuário(a) &quot;<systemitem "
"class=\"username\">root</systemitem>&quot;:"

#. type: Content of: <sect2><sect3><screen>
#: blfs-en/general/prog/python-modules/pyatspi2.xml:110
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr "<userinput>ninja install</userinput>"

