msgstr "Transferências Adicionais"

#. type: Content of: <sect2><sect3><itemizedlist><listitem><para>
#: blfs-en/general/prog/python-modules/pyxdg.xml:73
#, xml-text
msgid ""
"Required patch: <ulink url=\"&patch-root;/pyxdg-&pyxdg-"
"version;-python3_14-fixes-1.patch\"/>"
msgstr ""
"Remendo exigido: <ulink url=\"&patch-root;/pyxdg-&pyxdg-"
"version;-python3_14-fixes-1.patch\"/>"

#. type: Content of: <sect2><sect3><bridgehead>
#: blfs-en/general/prog/python-modules/pyxdg.xml:78
#, xml-text
msgid "PyXDG Dependencies"
msgstr "Dependências do PyXDG"

#. type: Content of: <sect2><sect3><bridgehead>
#: blfs-en/general/prog/python-modules/pyxdg.xml:80
#, xml-text
msgid "Optional (for testing)"
msgstr "Opcionais (para testagem)"

#. type: Content of: <sect2><sect3><para>
#: blfs-en/general/prog/python-modules/pyxdg.xml:82
#, xml-text
msgid "<xref linkend=\"pytest\"/> and <xref linkend=\"shared-mime-info\"/>"
msgstr "<xref linkend=\"pytest\"/> e <xref linkend=\"shared-mime-info\"/>"

#. type: Content of: <sect2><sect3><title>
#: blfs-en/general/prog/python-modules/pyxdg.xml:89
#, xml-text
msgid "Installation of PyXDG"
msgstr "Instalação do PyXDG"

#. type: Content of: <sect2><sect3><para>
#: blfs-en/general/prog/python-modules/pyxdg.xml:92
#, xml-text
msgid "First, fix several problems caused by Python 3.14:"
msgstr "Primeiro, corrija vários problemas causados pelo Python 3.14:"

#. type: Content of: <sect2><sect3><screen>
#: blfs-en/general/prog/python-modules/pyxdg.xml:95
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"pre\">patch -Np1 -i ../pyxdg-&pyxdg-"
"version;-python3_14-fixes-1.patch</userinput>"
msgstr ""
"<userinput remap=\"pre\">patch -Np1 -i ../pyxdg-&pyxdg-"
"version;-python3_14-fixes-1.patch</userinput>"

#. type: Content of: <sect2><sect3><para>
#: blfs-en/general/prog/python-modules/pyxdg.xml:98
#, xml-text
msgid "Build the module:"
msgstr "Construa o módulo:"

#. type: Content of: <sect2><sect3><para>
#: blfs-en/general/prog/python-modules/pyxdg.xml:104
#, xml-text
msgid "Install the module as the &root; user:"
msgstr "Instale o módulo como o(a) usante &root;:"

#. type: Content of: <sect2><sect3><screen>
#: blfs-en/general/prog/python-modules/pyxdg.xml:107
#, no-wrap, xml-text
msgid "<userinput>&install-wheel; pyxdg</userinput>"
msgstr "<userinput>&install-wheel; pyxdg</userinput>"

#. type: Content of: <sect2><sect3><para>
#: blfs-en/general/prog/python-modules/pyxdg.xml:110
#, xml-text
msgid ""
"To test the results, issue: <command>pytest</command>. Note that two tests, "
"<filename>MimeTest::test_get_type</filename> and "
"<filename>MimeTest::test_get_type2</filename>, are known to fail due to "
"small differences in MIME types from the recent versions of the shared-mime-"
"info package."
msgstr ""
"Para testar os resultados, emita: <command>pytest</command>. Observe-se que "
"dois testes, <filename>MimeTest::test_get_type</filename> e "
"<filename>MimeTest::test_get_type2</filename>, são conhecidos por falharem "
"devido a pequenas diferenças nos tipos MIME a partir das recentes versões do"
" pacote shared-mime-info."

#. type: Content of: <sect2><sect3><title>
#: blfs-en/general/prog/python-modules/pyxdg.xml:123
#, xml-text
msgid "Contents"
msgstr "Conteúdo"

#. type: Content of: <sect2><sect3><segmentedlist><segtitle>
#: blfs-en/general/prog/python-modules/pyxdg.xml:126
#, xml-text
msgid "Installed Directory"
msgstr "Diretório Instalado"

#. type: Content of: <sect2><sect3><segmentedlist><seglistitem><seg>
#: blfs-en/general/prog/python-modules/pyxdg.xml:130
#, xml-text
msgid ""
"/usr/lib/python&python3-majorver;/site-packages/xdg and "
"/usr/lib/python&python3-majorver;/site-packages/pyxdg-&pyxdg-version;.dist-"
"info"
msgstr ""
"/usr/lib/python&python3-majorver;/site-packages/xdg e "
"/usr/lib/python&python3-majorver;/site-packages/pyxdg-&pyxdg-version;.dist-"
"info"

