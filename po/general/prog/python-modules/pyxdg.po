#. type: Content of: <sect2><sect3><title>
#: blfs-en/general/prog/python-modules/pyxdg.xml:26
#, xml-text
msgid "Introduction to PyXDG Module"
msgstr "Introdução ao Módulo PyXDG"

#. type: Content of: <sect2><sect3><para>
#: blfs-en/general/prog/python-modules/pyxdg.xml:29
#, xml-text
msgid ""
"<application>PyXDG</application> is a <application>Python</application> "
"library to access freedesktop.org standards."
msgstr ""
"&quot;<application>PyXDG</application>&quot; é uma biblioteca "
"&quot;<application>Python</application>&quot; para acessar os padrões do "
"&quot;freedesktop.org&quot;."

#. type: Content of: <sect2><sect3><bridgehead>
#: blfs-en/general/prog/python-modules/pyxdg.xml:35
#, xml-text
msgid "Package Information"
msgstr "Informação do Pacote"

#. type: Content of: <sect2><sect3><itemizedlist><listitem><para>
#: blfs-en/general/prog/python-modules/pyxdg.xml:39
#, xml-text
msgid "Download (HTTP): <ulink url=\"&pyxdg-download-http;\"/>"
msgstr "Transferência (HTTP): <ulink url=\"&pyxdg-download-http;\"/>"

