#. type: Content of: <sect2><sect3><para>
#: blfs-en/general/prog/python-modules/python-dbusmock.xml:28
#, xml-text
msgid ""
"<application>dbusmock</application> is a Python library useful for writing "
"tests for software which talks to D-Bus services."
msgstr ""
"<application>dbusmock</application> é uma biblioteca &quot;Python&quot; útil"
" para escrever testes para logiciário que se comunique com serviços "
"&quot;D-Bus&quot;."

