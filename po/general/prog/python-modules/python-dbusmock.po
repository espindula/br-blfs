#. type: Content of: <sect2><sect3><bridgehead>
#: blfs-en/general/prog/python-modules/python-dbusmock.xml:68
#, xml-text
msgid "dbusmock Dependencies"
msgstr "Dependências do dbusmock"

#. type: Content of: <sect2><sect3><bridgehead>
#: blfs-en/general/prog/python-modules/python-dbusmock.xml:70
#, xml-text
msgid "Required"
msgstr "Exigidas"

#. type: Content of: <sect2><sect3><para>
#: blfs-en/general/prog/python-modules/python-dbusmock.xml:72
#, xml-text
msgid "<xref linkend=\"dbus-python\"/>"
msgstr "<xref linkend=\"dbus-python\"/>"

#. type: Content of: <sect2><sect3><bridgehead>
#: blfs-en/general/prog/python-modules/python-dbusmock.xml:75
#, xml-text
msgid "Optional"
msgstr "Opcionais"

#. type: Content of: <sect2><sect3><para>
#: blfs-en/general/prog/python-modules/python-dbusmock.xml:77
#, xml-text
msgid ""
"<xref linkend=\"pytest\"/> (required to run the test suite), <xref "
"linkend=\"pygobject3\"/> (required to run the test suite), <xref "
"linkend=\"bluez\"/> (optional for the test suite), and <xref "
"linkend=\"upower\"/> (optional for the test suite; if not installed one test"
" will fail)"
msgstr ""
"<xref linkend=\"pytest\"/> (exigido para executar a suíte de teste), <xref "
"linkend=\"pygobject3\"/> (exigido para executar a suíte de teste), <xref "
"linkend=\"bluez\"/> (opcional para a suíte de teste) e <xref "
"linkend=\"upower\"/> (opcional para a suíte de teste; se não instalado, um "
"teste falhará)"

#. type: Content of: <sect2><sect3><title>
#: blfs-en/general/prog/python-modules/python-dbusmock.xml:87
#, xml-text
msgid "Installation of dbusmock"
msgstr "Instalação do dbusmock"

#. type: Content of: <sect2><sect3><para>
#: blfs-en/general/prog/python-modules/python-dbusmock.xml:90
#, xml-text
msgid "Build the package with:"
msgstr "Construa o pacote com:"

#. type: Content of: <sect2><sect3><para>
#: blfs-en/general/prog/python-modules/python-dbusmock.xml:96
#, xml-text
msgid "To install the package run the following as the &root; user:"
msgstr ""
"Para instalar o pacote execute o seguinte como o(a) usuário(a) &root;:"

#. type: Content of: <sect2><sect3><screen>
#: blfs-en/general/prog/python-modules/python-dbusmock.xml:99
#, no-wrap, xml-text
msgid "<userinput>&install-wheel; python-dbusmock</userinput>"
msgstr "<userinput>&install-wheel; python-dbusmock</userinput>"

#. type: Content of: <sect2><sect3><para>
#: blfs-en/general/prog/python-modules/python-dbusmock.xml:102
#, xml-text
msgid "To test the results, issue: <command>LC_ALL=C pytest</command>"
msgstr "Para testar os resultados, emita: <command>LC_ALL=C pytest</command>"

