#. type: Content of: <sect2><sect3><title>
#: blfs-en/general/prog/python-modules/pygments.xml:86
#, xml-text
msgid "Installation of Pygments"
msgstr "Instalação do Pygments"

#. type: Content of: <sect2><sect3><para>
#: blfs-en/general/prog/python-modules/pygments.xml:89
#, xml-text
msgid "Build the <application>Python 3</application> module:"
msgstr "Construa o módulo &quot;<application>Python 3</application>&quot;:"

#. type: Content of: <sect2><sect3><para>
#: blfs-en/general/prog/python-modules/pygments.xml:95
#, xml-text
msgid "To install the package run the following as the &root; user:"
msgstr ""
"Para instalar o pacote execute o seguinte como o usuário &quot;&root;&quot;:"

#. type: Content of: <sect2><sect3><screen>
#: blfs-en/general/prog/python-modules/pygments.xml:98
#, no-wrap, xml-text
msgid "<userinput>&install-wheel; Pygments</userinput>"
msgstr "<userinput>&install-wheel; Pygments</userinput>"

#. type: Content of: <sect2><sect3><para>
#: blfs-en/general/prog/python-modules/pygments.xml:101
#, xml-text
msgid ""
"To test the installation, make sure <xref linkend='pytest'/> is installed "
"and run:"
msgstr ""
"Para testar a instalação, certifique-se de que <xref linkend='pytest'/> "
"esteja instalado e execute:"

#. type: Content of: <sect2><sect3><screen>
#: blfs-en/general/prog/python-modules/pygments.xml:105
#, no-wrap, xml-text
msgid ""
"<userinput>python3 -m venv --system-site-packages testenv &amp;&amp;\n"
"testenv/bin/pip3 install wcag-contrast-ratio   &amp;&amp;\n"
"testenv/bin/python -m pytest</userinput>"
msgstr ""
"<userinput>python3 -m venv --system-site-packages testenv &amp;&amp;\n"
"testenv/bin/pip3 install wcag-contrast-ratio   &amp;&amp;\n"
"testenv/bin/python -m pytest</userinput>"

