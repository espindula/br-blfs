#. type: Content of: <sect2><sect3><title>
#: blfs-en/general/prog/python-modules/markupsafe.xml:25
msgid "Introduction to MarkupSafe Module"
msgstr "Introdução ao Módulo <quote>MarkupSafe</quote>"

#. type: Content of: <sect2><sect3><para>
#: blfs-en/general/prog/python-modules/markupsafe.xml:28
msgid ""
"<application>MarkupSafe</application> is a <application>Python</application>"
" module that implements a XML/HTML/XHTML Markup safe string."
msgstr ""
"&quot;<application>MarkupSafe</application>&quot; é um módulo "
"&quot;<application>Python</application>&quot; que implementa uma sequência "
"segura de caracteres de marcação &quot;XML/HTML/XHTML&quot;."

#. type: Content of: <sect2><sect3><note><para>
#: blfs-en/general/prog/python-modules/markupsafe.xml:34
msgid ""
"<application>MarkupSafe</application> was installed in LFS.  The instruction"
" is only kept here for SysV revision."
msgstr ""
"&quot;<application>MarkupSafe</application>&quot; foi instalado no LFS. As "
"instruções são mantidas aqui somente para a revisão &quot;SysV&quot;."

