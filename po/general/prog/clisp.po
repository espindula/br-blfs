msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/prog/clisp.xml:169
#, fuzzy, xml-text
#| msgid ""
#| "<parameter>--docdir=/usr/share/doc/clisp-&clisp-version;</parameter>: this "
#| "switch forces the HTML documentation to be installed into a versioned "
#| "directory, rather than into <filename "
#| "class=\"directory\">/usr/share/html/</filename>."
msgid ""
"<parameter>--docdir=/usr/share/doc/clisp-&clisp-version;</parameter>: this "
"switch forces the HTML documentation to be installed into a versioned "
"directory."
msgstr ""
"<parameter>--docdir=/usr/share/doc/clisp-&clisp-version;</parameter>: essa "
"chave força a documentação HTML ser instalada em um diretório versionado em "
"vez de no <filename class=\"directory\">/usr/share/html/</filename>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/prog/clisp.xml:175
#, fuzzy, xml-text
#| msgid ""
#| "<option>--with-libffcall-prefix=/usr</option>: use this to tell "
#| "<command>configure</command> that you have installed the optional "
#| "<package>libffcall</package> package in /usr, otherwise like "
#| "<package>libsigsegv</package> it will not be found."
msgid ""
"<option>--with-libffcall-prefix=/usr</option>: use this to tell "
"<command>configure</command> that you have installed the optional "
"<package>libffcall</package> package."
msgstr ""
"<option>--with-libffcall-prefix=/usr</option>: use isso para informar ao "
"<command>configure</command> que você instalou o pacote opcional "
"<package>libffcall</package> em /usr, caso contrário, como "
"<package>libsigsegv</package>, ele não será encontrado."

