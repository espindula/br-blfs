#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/prog/clisp.xml:104
#, xml-text
msgid "Installation of Clisp"
msgstr "Instalação do \"Clisp\""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/prog/clisp.xml:142
#, xml-text
msgid ""
"Install <application>Clisp</application> by running the following commands:"
msgstr ""
"Instale <application>Clisp</application> executando os seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/prog/clisp.xml:146
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"../configure --srcdir=../  \\\n"
"             --prefix=/usr \\\n"
"             --docdir=/usr/share/doc/clisp-&clisp-version; &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"../configure --srcdir=../  \\\n"
"             --prefix=/usr \\\n"
"             --docdir=/usr/share/doc/clisp-&clisp-version; &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/prog/clisp.xml:155
#, xml-text
msgid "To test the results, issue: <command>make check</command>."
msgstr "Para testar os resultados, emita: <command>make check</command>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/prog/clisp.xml:159
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/prog/clisp.xml:162
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

