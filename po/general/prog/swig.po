#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/prog/swig.xml:142
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. This switch is used for <application>
#. JavaScript</application>
#.       because the SWIG implementation is incomplete and a lot of tests fail
#.       due to API changes in WebKitGTK.
#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/prog/swig.xml:145
#, xml-text
msgid ""
"<option>--without-&lt;language&gt;</option>: allows disabling the building "
"of tests and examples for &lt;language&gt;, but all the languages "
"capabilities of <application>SWIG</application> are always built."
msgstr ""
"<option>--without-&lt;linguagem&gt;</option>: permite desabilitar a "
"construção de testes e exemplos para &lt;linguagem&gt;, mas todas as "
"capacidades de linguagens do <application>SWIG</application> são sempre "
"construídas."

