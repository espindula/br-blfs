#: blfs-en/general/prog/rust.xml:199
#, xml-text
msgid "Installation of Rust"
msgstr "Instalação do Rust"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/prog/rust.xml:202
#, xml-text
msgid ""
"To install into the <filename class=\"directory\">/opt</filename> directory,"
" remove any existing <filename>/opt/rustc</filename> symlink and create a "
"new directory (i.e. with a different name if trying a modified build of the "
"same version).  As the <systemitem class=\"username\">root</systemitem> "
"user:"
msgstr ""
"Para instalar no diretório &quot;<filename "
"class=\"directory\">/opt</filename>&quot;, remova qualquer link simbólico "
"&quot;<filename>/opt/rustc</filename>&quot; existente e crie um novo "
"diretório (ou seja, com um nome diferente se tentar uma construção "
"modificada da mesma versão). Como o(a) usuário(a) &quot;<systemitem "
"class=\"username\">root</systemitem>&quot;:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/prog/rust.xml:211
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir -pv /opt/rustc-&rust-version;      &amp;&amp;\n"
"ln -svfn rustc-&rust-version; /opt/rustc</userinput>"
msgstr ""
"<userinput>mkdir -pv /opt/rustc-&rust-version;     &amp;&amp;\n"
"ln -svfn rustc-&rust-version; /opt/rustc</userinput>"

#. type: Content of: <sect1><sect2><note><para>
#: blfs-en/general/prog/rust.xml:216
#, xml-text
msgid ""
"If multiple versions of <application>Rust</application> are installed in "
"<filename class=\"directory\">/opt</filename>, changing to another version "
"only requires changing the <filename> /opt/rustc</filename> symbolic link "
"and then running <command>ldconfig</command>."
msgstr ""
"Se múltiplas versões do &quot;<application>Rust</application>&quot; "
"estiverem instaladas em &quot;<filename "
"class=\"directory\">/opt</filename>&quot;, [então] a mudança para outra "
"versão exige somente mudar o link simbólico "
"&quot;<filename>/opt/rustc</filename>&quot; e então executar "
"&quot;<command>ldconfig</command>&quot;."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/prog/rust.xml:224
#, xml-text
msgid ""
"Create a suitable <filename>bootstrap.toml</filename> file which will "
"configure the build."
msgstr ""
"Crie um arquivo <filename>bootstrap.toml</filename> adequado que configurará"
" a construção."

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/prog/rust.xml:228
#, no-wrap, xml-text
msgid ""
"<userinput>cat &lt;&lt; EOF &gt; bootstrap.toml\n"
"<literal># See bootstrap.toml.example for more possible options,\n"
"# and see src/bootstrap/defaults/bootstrap.dist.toml for a few options\n"
"# automatically set when building from a release tarball\n"
"# (unfortunately, we have to override many of them).\n"
"\n"
"# Tell x.py that the editors have reviewed the content of this file\n"
"# and updated it to follow the major changes of the building system,\n"
"# so x.py will not warn users to review that information.\n"
"change-id = 148795\n"
"\n"
"[llvm]\n"
"# When using the system installed copy of LLVM, prefer the shared libraries\n"
"link-shared = true\n"
"\n"
"# If building the shipped LLVM source, only enable the x86 target\n"
"# instead of all the targets supported by LLVM.\n"
"targets = \"X86\"\n"
"\n"
"[build]\n"
"description = \"for BLFS &version;\"\n"
"\n"
"# Omit the documentation to save time and space (the default is to build them).\n"
"docs = false\n"
"\n"
"# Do not look for new versions of the dependencies online.\n"
"locked-deps = true\n"
"\n"
"# Only install these extended tools. Cargo, clippy, rustdoc, and rustfmt\n"
"# are installed by a default rustup installation, and rust-src is needed\n"
"# to build the Rust code in Linux kernel (in case you need such a kernel\n"
"# feature).\n"
"tools = [\"cargo\", \"clippy\", \"rustdoc\", \"rustfmt\", \"src\"]\n"
"\n"
"[install]\n"
"prefix = \"/opt/rustc-&rust-version;\"\n"
"docdir = \"share/doc/rustc-&rust-version;\"\n"
"\n"
"[rust]\n"
"channel = \"stable\"\n"
"\n"
"# Enable the same optimizations as the official upstream build.\n"
"lto = \"thin\"\n"
"codegen-units = 1\n"
"\n"
"# Don't build llvm-bitcode-linker which is only useful for the NVPTX\n"
"# backend that we don't enable.\n"
"llvm-bitcode-linker = false\n"
"\n"
"[target.x86_64-unknown-linux-gnu]\n"
"llvm-config = \"/usr/bin/llvm-config\"\n"
"\n"
"[target.i686-unknown-linux-gnu]\n"
"llvm-config = \"/usr/bin/llvm-config\"</literal>\n"
"EOF</userinput>"
msgstr ""
"<userinput>cat &lt;&lt; EOF &gt; bootstrap.toml\n"
"<literal># See bootstrap.toml.example for more possible options,\n"
"# and see src/bootstrap/defaults/bootstrap.dist.toml for a few options\n"
"# automatically set when building from a release tarball\n"
"# (unfortunately, we have to override many of them).\n"
"\n"
"# Tell x.py that the editors have reviewed the content of this file\n"
"# and updated it to follow the major changes of the building system,\n"
"# so x.py will not warn users to review that information.\n"
"change-id = 148795\n"
"\n"
"[llvm]\n"
"# When using the system installed copy of LLVM, prefer the shared libraries\n"
"link-shared = true\n"
"\n"
"# If building the shipped LLVM source, only enable the x86 target\n"
"# instead of all the targets supported by LLVM.\n"
"targets = \"X86\"\n"
"\n"
"[build]\n"
"description = \"for BLFS &version;\"\n"
"\n"
"# Omit the documentation to save time and space (the default is to build them).\n"
"docs = false\n"
"\n"
"# Do not look for new versions of the dependencies online.\n"
"locked-deps = true\n"
"\n"
"# Only install these extended tools. Cargo, clippy, rustdoc, and rustfmt\n"
"# are installed by a default rustup installation, and rust-src is needed\n"
"# to build the Rust code in Linux kernel (in case you need such a kernel\n"
"# feature).\n"
"tools = [\"cargo\", \"clippy\", \"rustdoc\", \"rustfmt\", \"src\"]\n"
"\n"
"[install]\n"
"prefix = \"/opt/rustc-&rust-version;\"\n"
"docdir = \"share/doc/rustc-&rust-version;\"\n"
"\n"
"[rust]\n"
"channel = \"stable\"\n"
"\n"
"# Enable the same optimizations as the official upstream build.\n"
"lto = \"thin\"\n"
"codegen-units = 1\n"
"\n"
"# Don't build llvm-bitcode-linker which is only useful for the NVPTX\n"
"# backend that we don't enable.\n"
"llvm-bitcode-linker = false\n"
"\n"
"[target.x86_64-unknown-linux-gnu]\n"
"llvm-config = \"/usr/bin/llvm-config\"\n"
"\n"
"[target.i686-unknown-linux-gnu]\n"
"llvm-config = \"/usr/bin/llvm-config\"</literal>\n"
"EOF</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/prog/rust.xml:293
#, xml-text
msgid ""
"Compile <application>Rust</application> by running the following commands:"
msgstr ""
