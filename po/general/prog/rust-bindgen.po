#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/prog/rust-bindgen.xml:75
#, xml-text
msgid "Installation of rust-bindgen"
msgstr "Instalação do rust-bindgen"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/prog/rust-bindgen.xml:78
#, xml-text
msgid ""
"Install <application>rust-bindgen</application> by running the following "
"commands:"
msgstr ""
"Instale <application>rust-bindgen</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/prog/rust-bindgen.xml:82
#, no-wrap, xml-text
msgid "<userinput>cargo build --release</userinput>"
msgstr "<userinput>cargo build --release</userinput>"

#.  https://github.com/rust-lang/rust-bindgen/issues/3318 was reported
#.       by a user, but there is a commit that fixes it:
#.       https://github.com/rust-lang/rust-
#. bindgen/commit/9366e0af8da529c958b4cd4fcbe492d951c86f5c
#.       Given that we're only experiencing problems during the tests though,
#.       let's just document it for now.
#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/prog/rust-bindgen.xml:85
#, xml-text
msgid ""
"To test the results, issue: <command>cargo test --release</command>. Four "
"tests, <filename>header_issue_544_stylo_creduce_2_hpp</filename>, "
"<filename>header_constified_enum_module_overflow_hpp</filename>, "
"<filename>header_typedef_pointer_overlap_h</filename>, and "
"<filename>header_nsbasehashtable_hpp</filename>, are known to fail."
msgstr ""
"Para testar os resultados, emita: <command>cargo test --release</command>. "
"Quatro testes, <filename>header_issue_544_stylo_creduce_2_hpp</filename>, "
"<filename>header_constified_enum_module_overflow_hpp</filename>, "
"<filename>header_typedef_pointer_overlap_h</filename> e "
"<filename>header_nsbasehashtable_hpp</filename>, são conhecidos por "
"falharem."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/prog/rust-bindgen.xml:98
#, xml-text
msgid "Now, as the &root; user:"
msgstr "Agora, como o(a) usuário(a) &root;:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/prog/rust-bindgen.xml:101
#, no-wrap, xml-text
msgid ""
"<userinput>install -v -m755 target/release/bindgen /usr/bin</userinput>"
msgstr ""
"<userinput>install -v -m755 target/release/bindgen /usr/bin</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/prog/rust-bindgen.xml:104
#, xml-text
msgid ""
"Still as the &root; user, install the Bash and Zsh completion support files:"
msgstr ""
"Ainda como o(a) usuário(a) &root;, instale os arquivos de suporte à "
"completação do Bash e do Zsh:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/prog/rust-bindgen.xml:108
#, no-wrap, xml-text
msgid ""
"<userinput>bindgen --generate-shell-completions bash \\\n"
"    &gt; /usr/share/bash-completion/completions/bindgen\n"
"bindgen --generate-shell-completions zsh  \\\n"
"    &gt; /usr/share/zsh/site-functions/_bindgen</userinput>"
msgstr ""
"<userinput>bindgen --generate-shell-completions bash \\\n"
"    &gt; /usr/share/bash-completion/completions/bindgen\n"
"bindgen --generate-shell-completions zsh  \\\n"
"    &gt; /usr/share/zsh/site-functions/_bindgen</userinput>"

