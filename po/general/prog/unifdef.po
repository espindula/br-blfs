#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/prog/unifdef.xml:71
#, xml-text
msgid "Installation of unifdef"
msgstr "Instalação do unifdef"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/prog/unifdef.xml:74
#, xml-text
msgid "First, fix a problem when building with gcc-15:"
msgstr "Primeiro, corrija um problema ao construir com gcc-15:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/prog/unifdef.xml:77
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"pre\">sed -i 's/constexpr/unifdef_&amp;/g' "
"unifdef.c</userinput>"
msgstr ""
"<userinput remap=\"pre\">sed -i 's/constexpr/unifdef_&amp;/g' "
"unifdef.c</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/prog/unifdef.xml:80
#, xml-text
msgid "Now fix a problem if reinstalling the package:"
msgstr "Agora corrija um problema se reinstalar o pacote:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/prog/unifdef.xml:83
#, no-wrap, xml-text
msgid "<userinput remap=\"pre\">sed -i 's/ln -s/ln -sf/' Makefile</userinput>"
msgstr "<userinput remap=\"pre\">sed -i 's/ln -s/ln -sf/' Makefile</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/prog/unifdef.xml:86
#, xml-text
msgid ""
"Install <application>unifdef</application> by running the following "
"commands:"
msgstr ""
"Instale o <application>unifdef</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/prog/unifdef.xml:90
#, no-wrap, xml-text
msgid "<userinput>make</userinput>"
msgstr "<userinput>make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/prog/unifdef.xml:93
#, xml-text
msgid "To test the results, issue: <command>LC_ALL=C make test</command>."
msgstr ""
"Para testar os resultados, emita: <command>LC_ALL=C make test</command>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/prog/unifdef.xml:97
#, xml-text
msgid "Finally, finish the installation as the &root; user:"
msgstr "Finalmente, conclua a instalação como o(a) usante &root;:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/prog/unifdef.xml:100
#, no-wrap, xml-text
msgid "<userinput>make prefix=/usr install</userinput>"
msgstr "<userinput>make prefix=/usr install</userinput>"

