#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/prog/unifdef.xml:25
#, xml-text
msgid "Introduction to unifdef"
msgstr "Introdução ao unifdef"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/prog/unifdef.xml:28
#, xml-text
msgid ""
"The <application>unifdef</application> package contains a utility that is "
"useful for removing preprocessor conditionals from code."
msgstr ""
"O pacote <application>unifdef</application> contém um utilitário que é útil "
"para remover do código condicionais de pré processador."

