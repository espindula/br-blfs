#.       <ulink url="https://metacpan.org/pod/MIME::Base64">
#. MIME::Base64</ulink>
#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/prog/git.xml:117
#, xml-text
msgid ""
"<xref linkend=\"apache\"/> (for some tests), <xref role='runtime' "
"linkend='fcron'/> (runtime, for scheduling <command>git "
"maintenance</command> jobs), <xref role=\"runtime\" linkend=\"gnupg2\"/> "
"(runtime, may be used to sign <application>Git</application> commits or "
"tags, or verify the signatures of them), <xref role=\"runtime\" "
"linkend=\"openssh\"/> (runtime, needed to use <application>Git</application>"
" over ssh), <xref role=\"runtime\" linkend=\"subversion\"/> with Perl "
"bindings (runtime, for <command>git svn</command>), <xref role=\"runtime\" "
"linkend=\"tk\"/> (gitk, a simple <application>Git</application> repository "
"viewer, uses <application>Tk</application> at runtime), <xref "
"linkend=\"valgrind\"/>, <ulink "
"url=\"https://metacpan.org/pod/Authen::SASL\">Authen::SASL</ulink> (runtime,"
" for <command>git send-email</command>), <phrase revision='sysv'>and "
"</phrase><xref linkend='perl-io-socket-ssl'/> (runtime, for <command>git "
"send-email</command> to connect to a SMTP server with SSL encryption)<phrase"
" revision='systemd'>, and <xref role='runtime' linkend='systemd'/> (runtime,"
" rebuilt with <xref role='nodep' linkend='linux-pam'/>, for scheduling "
"<command>git maintenance</command> jobs)</phrase>"
msgstr ""
"<xref linkend=\"apache\"/> (para alguns testes), <xref role='runtime' "
"linkend='fcron'/> (tempo de execução, para agendamento de tarefas "
"<command>git maintenance</command>), <xref role=\"runtime\" "
"linkend=\"gnupg2\"/> (tempo de execução, possivelmente seja usado para "
"assinar submissões ou etiquetas do <application>Git</application>, ou "
"verificar as assinaturas delas), <xref role=\"runtime\" "
"linkend=\"openssh\"/> (tempo de execução, necessário para usar "
"<application>Git</application> sobre ssh), <xref role=\"runtime\" "
"linkend=\"subversion\"/> com ligações Perl (tempo de execução, para "
"<command>git svn</command>), <xref role=\"runtime\" linkend=\"tk\"/> (gitk, "
"um visualizador simples de repositórios do <application>Git</application>, "
"usa <application>Tk</application> em tempo de execução), <xref "
"linkend=\"valgrind\"/>, <ulink "
"url=\"https://metacpan.org/pod/Authen::SASL\">Authen::SASL</ulink> (tempo de"
" execução, para <command>git send-email</command>), <phrase "
"revision='sysv'>e </phrase><xref linkend='perl-io-socket-ssl'/> (tempo de "
"execução, para <command>git send-email</command> se conectar a um servidor "
"SMTP com encriptação SSL)<phrase revision='systemd'>, e <xref role='runtime'"
" linkend='systemd'/> (tempo de execução, reconstruído com <xref role='nodep'"
" linkend='linux-pam'/>, para agendamento de tarefas do <command>git "
"maintenance</command>)</phrase>"

