#. type: Content of: <sect1><sect2><variablelist><bridgehead>
#: blfs-en/general/prog/python3.xml:372
#, xml-text
msgid "Short Descriptions"
msgstr "Descrições Curtas"

#.       <varlistentry id="2to3">
#.         <term><command>2to3</command></term>
#.         <listitem>
#.           <para>
#.             is designed to assist in the transition between python2 and
#. python3
#.             by automatically converting code to be Python3 compatible.
#.           </para>
#.           <indexterm zone="python3 2to3">
#.             <primary sortas="b-2to3">2to3</primary>
#.           </indexterm>
#.         </listitem>
