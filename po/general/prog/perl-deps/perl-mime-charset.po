#, xml-text
msgid "Introduction to MIME::Charset"
msgstr "Introdução ao MIME::Charset"

#. type: Content of: <sect2><sect3><para>
#: blfs-en/general/prog/perl-deps/perl-mime-charset.xml:25
#, xml-text
msgid ""
"MIME::Charset provides information about character sets used for MIME "
"messages on the internet, such as their encodings."
msgstr ""
"MIME::Charset fornece informações relativas a conjuntos de caracteres usados"
" para mensagens MIME na Internet, como as codificações deles."

