#. type: Content of: <sect2><sect3><para><screen>
#: blfs-en/general/prog/perl-deps/perl-xml-sax.xml:68
#, no-wrap, xml-text
msgid ""
"<userinput>yes | perl Makefile.PL &amp;&amp;\n"
"make             &amp;&amp;\n"
"make test</userinput>"
msgstr ""
"<userinput>yes | perl Makefile.PL &amp;&amp;\n"
"make            &amp;&amp;\n"
"make test</userinput>"

