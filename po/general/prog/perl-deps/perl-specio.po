#. type: Content of: <sect2><sect3><bridgehead>
#: blfs-en/general/prog/perl-deps/perl-specio.xml:45
#, xml-text
msgid "Specio Dependencies"
msgstr "Dependências do Specio"

#. type: Content of: <sect2><sect3><bridgehead>
#: blfs-en/general/prog/perl-deps/perl-specio.xml:47
#, xml-text
msgid "Required"
msgstr "Exigidas"

#. type: Content of: <sect2><sect3><para>
#: blfs-en/general/prog/perl-deps/perl-specio.xml:49
#, xml-text
msgid ""
"<xref linkend=\"perl-devel-stacktrace\"/>, <xref linkend=\"perl-eval-"
"closure\"/>, <xref linkend=\"perl-module-runtime\"/>, <xref linkend=\"perl-"
"role-tiny\"/>, <xref linkend=\"perl-sub-quote\"/>, and <xref linkend=\"perl-"
"try-tiny\"/>"
msgstr ""
"<xref linkend=\"perl-devel-stacktrace\"/>, <xref linkend=\"perl-eval-"
"closure\"/>, <xref linkend=\"perl-module-runtime\"/>, <xref linkend=\"perl-"
"role-tiny\"/>, <xref linkend=\"perl-sub-quote\"/> e <xref linkend=\"perl-"
"try-tiny\"/>"

#. type: Content of: <sect2><sect3><bridgehead>
#: blfs-en/general/prog/perl-deps/perl-specio.xml:57
#, xml-text
msgid "Recommended (required for the test suite)"
msgstr "Recomendadas (exigidas para a suíte de teste)"

#.  This claims to need XString, and will use it for memory
#.          efficiency if present, but runs fine without it. It also
#.          shows Ref-Util in 'Runtime Recommends' but the only reference
#.          to that seems to be in the prereqs.
#. type: Content of: <sect2><sect3><para>
#: blfs-en/general/prog/perl-deps/perl-specio.xml:63
#, xml-text
msgid ""
"<xref linkend=\"perl-mro-compat\"/>, <xref linkend=\"perl-test-fatal\"/>, "
"and <xref linkend=\"perl-test-needs\"/>"
msgstr ""
"<xref linkend=\"perl-mro-compat\"/>, <xref linkend=\"perl-test-fatal\"/> e "
"<xref linkend=\"perl-test-needs\"/>"

#. type: Content of: <sect2><sect3><bridgehead>
#: blfs-en/general/prog/perl-deps/perl-specio.xml:68
#, xml-text
msgid "Optional"
msgstr "Opcionais"

#.  this adds little, but it gets pulled in anyway for DateTime,
#.              of which Specio is a dependency
#. type: Content of: <sect2><sect3><para>
#: blfs-en/general/prog/perl-deps/perl-specio.xml:72
#, xml-text
msgid "<xref linkend=\"perl-namespace-autoclean\"/> (for the test suite)"
msgstr "<xref linkend=\"perl-namespace-autoclean\"/> (para a suíte de teste)"

