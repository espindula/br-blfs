#. type: Content of: <sect2><sect3><bridgehead>
#: blfs-en/general/prog/perl-modules/perl-lwp-protocol-https.xml:60
#, xml-text
msgid "Required"
msgstr "Exigidas"

#.  perl-io-socket-ssl pulls in perl-net-ssleay
#.  perl-libwww-perl pulls in perl-net-https
#. type: Content of: <sect2><sect3><para>
#: blfs-en/general/prog/perl-modules/perl-lwp-protocol-https.xml:62
#, xml-text
msgid ""
"<xref linkend=\"perl-io-socket-ssl\"/>, <xref linkend=\"perl-libwww-"
"perl\"/>, and <xref linkend=\"make-ca\"/> with "
"<literal>/etc/pki/tls/certs/ca-bundle.crt</literal>."
msgstr ""
"<xref linkend=\"perl-io-socket-ssl\"/>, <xref linkend=\"perl-libwww-perl\"/>"
" e <xref linkend=\"make-ca\"/> com <literal>/etc/pki/tls/certs/ca-"
"bundle.crt</literal>."

