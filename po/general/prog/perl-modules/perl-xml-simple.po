#. type: Content of: <sect2><sect3><bridgehead>
#: blfs-en/general/prog/perl-modules/perl-xml-simple.xml:50
#, xml-text
msgid "Optional"
msgstr "Opcionais"

#.  perl-xml-sax pulls in perl-xml-namespacesupport and
#.              perl-xml-sax-base
#. type: Content of: <sect2><sect3><para>
#: blfs-en/general/prog/perl-modules/perl-xml-simple.xml:52
#, xml-text
msgid ""
"<xref linkend=\"perl-xml-sax\"/> (for an alternative parser which will be "
"used if available, otherwise <application>XML::Parser</application> (which "
"was installed in LFS) will be used)"
msgstr ""
"<xref linkend=\"perl-xml-sax\"/> (para um analisador alternativo, que será "
"usado se disponível; caso contrário, <application>XML::Parser</application> "
"(que foi instalado no LFS) será usado"

