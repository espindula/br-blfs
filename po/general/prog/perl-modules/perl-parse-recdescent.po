#: blfs-en/general/prog/perl-modules/perl-parse-recdescent.xml:25
#, xml-text
msgid ""
"Parse::RecDescent incrementally generates top-down recursive-descent text "
"parsers from simple yacc-like grammar specifications."
msgstr ""
"\"Parse::RecDescent\" gera incrementalmente analisadores de texto "
"descendentes recursivos de cima para baixo a partir de especificações "
"gramaticais simples do tipo \"yacc\"."

