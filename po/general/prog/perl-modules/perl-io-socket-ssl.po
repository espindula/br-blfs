#, xml-text
msgid "Installation of IO::Socket::SSL"
msgstr "Instalação do \"IO::Socket::SSL\""

#. type: Content of: <sect2><sect3><para>
#: blfs-en/general/prog/perl-modules/perl-io-socket-ssl.xml:68
#, xml-text
msgid ""
"This module uses a variant of the standard build and installation "
"instructions:"
msgstr ""
"Esse módulo usa uma variante das instruções padrão de construção e "
"instalação:"

#. type: Content of: <sect2><sect3><screen>
#: blfs-en/general/prog/perl-modules/perl-io-socket-ssl.xml:72
#, no-wrap, xml-text
msgid ""
"<userinput>yes | perl Makefile.PL &amp;&amp;\n"
"make                   &amp;&amp;\n"
"make test</userinput>"
msgstr ""
"<userinput>yes | perl Makefile.PL &amp;&amp;\n"
"make                   &amp;&amp;\n"
"make test</userinput>"

#. type: Content of: <sect2><sect3><para>
#: blfs-en/general/prog/perl-modules/perl-io-socket-ssl.xml:84
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect2><sect3><screen>
#: blfs-en/general/prog/perl-modules/perl-io-socket-ssl.xml:87
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

#. type: Content of: <sect2><sect3><title>
#: blfs-en/general/prog/perl-modules/perl-io-socket-ssl.xml:92
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect2><sect3><para>
#: blfs-en/general/prog/perl-modules/perl-io-socket-ssl.xml:95
#, xml-text
msgid ""
"<command>yes</command>: Perl will ask if you wish to run external tests, "
"which will 'fail soft' if there are network problems. The default is 'y', "
"which will allow you to script the build."
msgstr ""
"<command>yes</command>: \"Perl\" perguntará se você deseja executar testes "
"externos, que \"falharão suavemente\" se existirem problemas de rede de "
"comunicação. O padrão é \"y\", que permitirá que você automatize o processo "
"de construção."

