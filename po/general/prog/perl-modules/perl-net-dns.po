msgid "Introduction to Net::DNS"
msgstr "Introdução ao \"Net::DNS\""

#. type: Content of: <sect2><sect3><para>
#: blfs-en/general/prog/perl-modules/perl-net-dns.xml:24
#, xml-text
msgid ""
"Net::DNS is a DNS resolver implemented in <application>Perl</application>.  "
"It can be used to perform nearly any type of DNS query from a "
"<application>Perl</application> script."
msgstr ""
"\"Net::DNS\" é um resolvedor de \"DNS\" implementado em "
"<application>Perl</application>. Ele pode ser usado para realizar "
"praticamente qualquer tipo de consulta \"DNS\" a partir de um script "
"<application>Perl</application>."

