#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/prog/mercurial.xml:76
#, xml-text
msgid "<xref linkend=\"setuptools_scm\"/>"
msgstr "<xref linkend=\"setuptools_scm\"/>"

