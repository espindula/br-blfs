#~ msgid "Configuring PCI Utils"
#~ msgstr "Configurando o \"PCI Utils\""

#, xml-text
#~ msgid ""
#~ "The <filename>pci.ids</filename> data file is constantly being updated. To "
#~ "get a current version of this file, run <command>update-pciids</command> as "
#~ "the <systemitem class=\"username\">root</systemitem> user. This program "
#~ "requires the <xref linkend=\"which\"/> script or program to find <xref "
#~ "linkend=\"curl\"/>, <xref linkend=\"lynx\"/>, or <xref linkend=\"wget\"/> "
#~ "which are used to download the most current file, and then replace the "
#~ "existing file in <filename class=\"directory\">/usr/share/hwdata</filename>."
#~ msgstr ""
#~ "O arquivo de dados <filename>pci.ids</filename> está sendo constantemente "
#~ "atualizado. Para obter uma versão atual desse arquivo, execute "
#~ "<command>update-pciids</command> como o(a) usuário(a) <systemitem "
#~ "class=\"username\">root</systemitem>. Esse aplicativo exige o script ou "
#~ "aplicativo <xref linkend=\"which\"/> para encontrar o <xref "
#~ "linkend=\"curl\"/>, <xref linkend=\"lynx\"/> ou o <xref linkend=\"wget\"/> "
#~ "que são usados para baixar o arquivo mais atual e, em seguida, substituir o "
#~ "arquivo existente em <filename "
#~ "class=\"directory\">/usr/share/hwdata</filename>."

#, xml-text
#~ msgid ""
#~ "You should update the <filename>/usr/share/hwdata/pci.ids</filename> file "
#~ "periodically. <phrase revision=\"sysv\">If you've installed <xref "
#~ "linkend=\"fcron\"/> and completed the section on periodic jobs, "
#~ "execute</phrase><phrase revision=\"systemd\">Execute</phrase> the following "
#~ "commands, as the <systemitem class=\"username\">root</systemitem> user, to "
#~ "create a <phrase revision=\"sysv\">weekly cron job:</phrase> <phrase "
#~ "revision=\"systemd\">systemd timer to update it weekly on Sundays at 2:30 "
#~ "A.M. (local time):</phrase>"
#~ msgstr ""
#~ "Você deveria atualizar o arquivo "
#~ "<filename>/usr/share/hwdata/pci.ids</filename> periodicamente. <phrase "
#~ "revision=\"sysv\">Se você tiver instalado o <xref linkend=\"fcron\"/> e "
#~ "completou a seção relativa a tarefas periódicas, [então] "
#~ "execute</phrase><phrase revision=\"systemd\">Execute</phrase> os seguintes "
#~ "comandos, como o(a) usuário(a) <systemitem "
#~ "class=\"username\">root</systemitem>, para criar <phrase "
#~ "revision=\"sysv\">uma tarefa semanal do \"cron\":</phrase> <phrase "
#~ "revision=\"systemd\">um cronômetro do \"systemd\" para atualizá-lo "
#~ "semanalmente aos domingos às 2h30 (hora local):</phrase>"

#, no-wrap, xml-text
#~ msgid ""
#~ "<userinput>cat &gt; /etc/cron.weekly/update-pciids.sh &lt;&lt; \"EOF\" &amp;&amp;\n"
#~ "<literal>#!/bin/bash\n"
#~ "/usr/sbin/update-pciids</literal>\n"
#~ "EOF\n"
#~ "chmod 754 /etc/cron.weekly/update-pciids.sh</userinput>"
#~ msgstr ""
#~ "<userinput>cat &gt; /etc/cron.weekly/update-pciids.sh &lt;&lt; \"EOF\" &amp;&amp;\n"
#~ "<literal>#!/bin/bash\n"
#~ "/usr/sbin/update-pciids</literal>\n"
#~ "EOF\n"
#~ "chmod 754 /etc/cron.weekly/update-pciids.sh</userinput>"

#, no-wrap, xml-text
#~ msgid ""
#~ "<userinput>cat &gt; /usr/lib/systemd/system/update-pciids.service &lt;&lt; \"EOF\" &amp;&amp;\n"
#~ "<literal>[Unit]\n"
#~ "Description=Update pci.ids file\n"
#~ "Documentation=man:update-pciids(8)\n"
#~ "DefaultDependencies=no\n"
#~ "After=local-fs.target network-online.target\n"
#~ "Before=shutdown.target\n"
#~ "\n"
#~ "[Service]\n"
#~ "Type=oneshot\n"
#~ "RemainAfterExit=yes\n"
#~ "ExecStart=/usr/sbin/update-pciids</literal>\n"
#~ "EOF\n"
#~ "cat &gt; /usr/lib/systemd/system/update-pciids.timer &lt;&lt; \"EOF\" &amp;&amp;\n"
#~ "<literal>[Unit]\n"
#~ "Description=Update pci.ids file weekly\n"
#~ "\n"
#~ "[Timer]\n"
#~ "OnCalendar=Sun 02:30:00\n"
#~ "Persistent=true\n"
#~ "\n"
#~ "[Install]\n"
#~ "WantedBy=timers.target</literal>\n"
#~ "EOF\n"
#~ "systemctl enable update-pciids.timer</userinput>"
#~ msgstr ""
#~ "<userinput>cat &gt; /usr/lib/systemd/system/update-pciids.service &lt;&lt; \"EOF\" &amp;&amp;\n"
#~ "<literal>[Unit]\n"
#~ "Description=Atualiza o arquivo \"pci.ids\"\n"
#~ "Documentation=man:update-pciids(8)\n"
#~ "DefaultDependencies=no\n"
#~ "After=local-fs.target network-online.target\n"
#~ "Before=shutdown.target\n"
#~ "\n"
#~ "[Service]\n"
#~ "Type=oneshot\n"
#~ "RemainAfterExit=yes\n"
#~ "ExecStart=/usr/sbin/update-pciids</literal>\n"
#~ "EOF\n"
#~ "cat &gt; /usr/lib/systemd/system/update-pciids.timer &lt;&lt; \"EOF\" &amp;&amp;\n"
#~ "<literal>[Unit]\n"
#~ "Description=Atualiza o arquivo \"pci.ids\" semanalmente\n"
#~ "\n"
#~ "[Timer]\n"
#~ "OnCalendar=Sun 02:30:00\n"
#~ "Persistent=true\n"
#~ "\n"
#~ "[Install]\n"
#~ "WantedBy=timers.target</literal>\n"
#~ "EOF\n"
#~ "systemctl enable update-pciids.timer</userinput>"

