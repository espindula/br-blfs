#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/sysutils/redland.xml:89
#, xml-text
msgid "Installation of Redland"
msgstr "Instalação do \"Redland\""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/sysutils/redland.xml:92
#, xml-text
msgid ""
"Install <application>Redland</application> by running the following "
"commands:"
msgstr ""
"Instale <application>Redland</application> executando os seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/sysutils/redland.xml:96
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr --disable-static &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>./configure --prefix=/usr --disable-static &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/sysutils/redland.xml:100
#, xml-text
msgid "To test the results, issue <command>make check</command>."
msgstr "Para testar os resultados, emita <command>make check</command>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/sysutils/redland.xml:104
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr "Agora, como o(a) usante <systemitem class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/sysutils/redland.xml:107
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

