#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/sysutils/redland.xml:26
#, xml-text
msgid "Introduction to Redland"
msgstr "Introdução ao \"Redland\""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/sysutils/redland.xml:29
#, xml-text
msgid ""
"<application>Redland</application> is a set of free software C libraries "
"that provide support for the Resource Description Framework (RDF)."
msgstr ""
"<application>Redland</application> é um conjunto de bibliotecas C de "
"software livre que fornece suporte para o \"Resource Description Framework\""
" (\"RDF\")."

