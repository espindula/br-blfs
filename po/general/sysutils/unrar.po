#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/sysutils/unrar.xml:26
#, xml-text
msgid "Introduction to UnRar"
msgstr "Introdução ao \"UnRar\""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/sysutils/unrar.xml:29
#, xml-text
msgid ""
"The <application>UnRar</application> package contains a "
"<filename>RAR</filename> extraction utility used for extracting files from "
"<filename>RAR</filename> archives.  <filename>RAR</filename> archives are "
"usually created with <application>WinRAR</application>, primarily in a "
"Windows environment."
msgstr ""
"O pacote <application>UnRar</application> contém um utilitário de extração "
"<filename>RAR</filename> usado para extrair arquivos a partir de "
"arquivamentos <filename>RAR</filename>. Arquivamentos "
"<filename>RAR</filename> geralmente são criados com "
"<application>WinRAR</application>, principalmente em um ambiente "
"\"Windows\"."

