#: blfs-en/general/sysutils/sysmon3.xml:91
#, xml-text
msgid ""
"Install <application>sysmon3</application> by running the following "
"commands:"
msgstr ""
"Instale <application>sysmon3</application> executando os seguintes comandos:"

