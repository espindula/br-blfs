#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/sysutils/raptor.xml:98
#, xml-text
msgid "Installation of Raptor"
msgstr "Instalação do \"Raptor\""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/sysutils/raptor.xml:101
#, xml-text
msgid "First, fix an incompatibility with libxml2-2.11.x:"
msgstr "Primeiro, corrija uma incompatibilidade com libxml2-2.11.x:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/sysutils/raptor.xml:104
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"pre\">sed -i 's/20627/20627 \\&amp;\\&amp; LIBXML_VERSION"
" &lt; 21100/' src/raptor_libxml.c</userinput>"
msgstr ""
"<userinput remap=\"pre\">sed -i 's/20627/20627 \\&amp;\\&amp; LIBXML_VERSION"
" &lt; 21100/' src/raptor_libxml.c</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/sysutils/raptor.xml:107
#, xml-text
msgid ""
"Install <application>Raptor</application> by running the following commands:"
msgstr ""
"Instale <application>Raptor</application> executando os seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/sysutils/raptor.xml:111
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr --disable-static &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>./configure --prefix=/usr --disable-static &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/sysutils/raptor.xml:115
#, xml-text
msgid ""
"To test the results, issue: <command>make check</command>.  Several of the "
"XML tests may fail."
msgstr ""
"Para testar os resultados, emita: <command>make check</command>. Vários dos "
"testes de \"XML\" possivelmente falhem."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/sysutils/raptor.xml:120
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr "Agora, como o(a) usante <systemitem class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/sysutils/raptor.xml:123
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/sysutils/raptor.xml:128
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/sysutils/raptor.xml:134
#, xml-text
msgid ""
"<option>--with-icu-config=/usr/bin/icu-config</option>: Use this switch if "
"you have installed <xref linkend=\"icu\"/> and wish to build "
"<application>Raptor</application> with its support."
msgstr ""
"<option>--with-icu-config=/usr/bin/icu-config</option>: Use essa chave se "
"você tiver instalado o <xref linkend=\"icu\"/> e desejar construir o "
"<application>Raptor</application> com suporte a ele."

