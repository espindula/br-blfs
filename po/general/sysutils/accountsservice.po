#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/sysutils/accountsservice.xml:114
#, xml-text
msgid ""
"Install <application>AccountsService</application> by running the following "
"commands:"
msgstr ""
"Instale <application>AccountsService</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/sysutils/accountsservice.xml:118
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup ..             \\\n"
"      --prefix=/usr        \\\n"
"      --buildtype=release  \\\n"
"      -D admin_group=adm   \\\n"
"      -D elogind=true      \\\n"
"      -D systemdsystemunitdir=no</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup ..             \\\n"
"      --prefix=/usr        \\\n"
"      --buildtype=release  \\\n"
"      -D admin_group=adm   \\\n"
"      -D elogind=true      \\\n"
"      -D systemdsystemunitdir=no</userinput>"

