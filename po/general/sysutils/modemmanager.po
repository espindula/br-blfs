#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/sysutils/modemmanager.xml:99
#, xml-text
msgid "Installation of ModemManager"
msgstr "Instalação do \"ModemManager\""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/sysutils/modemmanager.xml:102
#, xml-text
msgid ""
"Install <application>ModemManager</application> by running the following "
"commands:"
msgstr ""
"Instale <application>ModemManager</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/sysutils/modemmanager.xml:106
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup ..                 \\\n"
"      --prefix=/usr            \\\n"
"      --buildtype=release      \\\n"
"      -D bash_completion=false \\\n"
"      -D qrtr=false            \\\n"
"      -D systemdsystemunitdir=no &amp;&amp;\n"
"ninja</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup ..                 \\\n"
"      --prefix=/usr            \\\n"
"      --buildtype=release      \\\n"
"      -D bash_completion=false \\\n"
"      -D qrtr=false            \\\n"
"      -D systemdsystemunitdir=no &amp;&amp;\n"
"ninja</userinput>"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/sysutils/modemmanager.xml:117
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup ..                 \\\n"
"      --prefix=/usr            \\\n"
"      --buildtype=release      \\\n"
"      -D bash_completion=false \\\n"
"      -D qrtr=false            &amp;&amp;\n"
"ninja</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup ..                 \\\n"
"      --prefix=/usr            \\\n"
"      --buildtype=release      \\\n"
"      -D bash_completion=false \\\n"
"      -D qrtr=false            &amp;&amp;\n"
"ninja</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/sysutils/modemmanager.xml:128
#, xml-text
msgid "To test the results, issue: <command>ninja test</command>."
msgstr "Para testar os resultados, emita: <command>ninja test</command>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/sysutils/modemmanager.xml:132
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/sysutils/modemmanager.xml:135
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr "<userinput>ninja install</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/sysutils/modemmanager.xml:141
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/sysutils/modemmanager.xml:147
#, xml-text
msgid ""
"<parameter>-D bash_completion=false</parameter>: Use this option if the "
"external <ulink url=\"https://github.com/scop/bash-completion\">bash-"
"completion</ulink> package is not installed."
msgstr ""
"<parameter>-D bash_completion=false</parameter>: Use essa opção se o pacote "
"externo <ulink url=\"https://github.com/scop/bash-completion\">bash-"
"completion</ulink> não estiver instalado."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/sysutils/modemmanager.xml:154
#, xml-text
msgid ""
"<parameter>-D qrtr=false</parameter>: This switch disables support for the "
"QRTR protocol which needs the external <ulink "
"url=\"https://gitlab.freedesktop.org/mobile-broadband/libqrtr-"
"glib\">libqrtr-glib</ulink> package."
msgstr ""
"<parameter>-D qrtr=false</parameter>: Essa chave desabilita suporte para o "
"protocolo QRTR, que precisa do pacote externo <ulink "
"url=\"https://gitlab.freedesktop.org/mobile-broadband/libqrtr-"
"glib\">libqrtr-glib</ulink>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/sysutils/modemmanager.xml:160
#, xml-text
msgid ""
"<parameter>-D systemdsystemunitdir=no</parameter>: This switch prevents "
"<application>meson</application> from looking for the systemd units "
"directory and failing since it is not available on SysV systems."
msgstr ""
"<parameter>-D systemdsystemunitdir=no</parameter>: Essa chave evita que "
"<application>meson</application> procure o diretório de unidades do systemd "
"e falhe, pois ele não está disponível em sistemas SysV."

#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/sysutils/modemmanager.xml:168
#, xml-text
msgid "Configuring ModemManager"
msgstr "Configurando o \"ModemManager\""

#. type: Content of: <sect1><sect2><sect3><title>
#: blfs-en/general/sysutils/modemmanager.xml:171
#, xml-text
msgid "Systemd Units"
msgstr "Unidades do systemd"

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/general/sysutils/modemmanager.xml:174
#, xml-text
msgid ""
"To start the <command>ModemManager</command> daemon at boot, enable the "
"previously installed systemd unit by running the following command as the "
"<systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Para iniciar o processo de segundo plano <command>ModemManager</command> na "
"inicialização, habilite a unidade do systemd instalada anteriormente "
"executando o seguinte comando como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><sect3><screen>
#: blfs-en/general/sysutils/modemmanager.xml:183
#, no-wrap, xml-text
msgid "<userinput>systemctl enable ModemManager</userinput>"
msgstr "<userinput>systemctl enable ModemManager</userinput>"

