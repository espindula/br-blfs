#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/sysutils/modemmanager.xml:98
#, xml-text
msgid "Installation of ModemManager"
msgstr "Instalação do \"ModemManager\""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/sysutils/modemmanager.xml:101
#, xml-text
msgid ""
"Install <application>ModemManager</application> by running the following "
"commands:"
msgstr ""
"Instale <application>ModemManager</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/sysutils/modemmanager.xml:105
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr                 \\\n"
"            --sysconfdir=/etc             \\\n"
"            --localstatedir=/var          \\\n"
"            --disable-static              \\\n"
"            --disable-maintainer-mode     \\\n"
"            --with-systemd-journal=no     \\\n"
"            --with-systemd-suspend-resume &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>./configure --prefix=/usr                \\\n"
"            --sysconfdir=/etc             \\\n"
"            --localstatedir=/var          \\\n"
"            --disable-static              \\\n"
"            --disable-maintainer-mode     \\\n"
"            --with-systemd-journal=no     \\\n"
"            --with-systemd-suspend-resume &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/sysutils/modemmanager.xml:114
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr                 \\\n"
"            --sysconfdir=/etc             \\\n"
"            --localstatedir=/var          \\\n"
"            --disable-static              \\\n"
"            --disable-maintainer-mode     \\\n"
"            --with-systemd-journal        \\\n"
"            --with-systemd-suspend-resume &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>./configure --prefix=/usr                \\\n"
"            --sysconfdir=/etc             \\\n"
"            --localstatedir=/var          \\\n"
"            --disable-static              \\\n"
"            --disable-maintainer-mode     \\\n"
"            --with-systemd-journal        \\\n"
"            --with-systemd-suspend-resume &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/sysutils/modemmanager.xml:124
#, xml-text
msgid "To test the results, issue: <command>make check</command>."
msgstr "Para testar os resultados, emita: <command>make check</command>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/sysutils/modemmanager.xml:128
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/sysutils/modemmanager.xml:131
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/sysutils/modemmanager.xml:137
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/sysutils/modemmanager.xml:140
#, xml-text
msgid ""
"<parameter>--with-systemd-suspend-resume</parameter>: This switch forces "
"<application>ModemManager</application> to use the <phrase "
"revision=\"sysv\"><application>elogind</application></phrase> <phrase "
"revision=\"systemd\"><application>systemd</application></phrase> power "
"management facilities."
msgstr ""
"<parameter>--with-systemd-suspend-resume</parameter>: Essa chave força o "
"<application>ModemManager</application> a usar os recursos de gerenciamento "
"de energia do <phrase "
"revision=\"sysv\"><application>elogind</application></phrase> <phrase "
"revision=\"systemd\"><application>systemd</application></phrase>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/sysutils/modemmanager.xml:148
#, xml-text
msgid ""
"<phrase revision=\"systemd\"><parameter>--with-systemd-"
"journal</parameter></phrase> <phrase revision=\"sysv\"><parameter>--with-"
"systemd-journal=no</parameter></phrase> : This switch forces "
"<application>ModemManager</application> <phrase "
"revision=\"sysv\">not</phrase> to use the systemd journal for logging."
msgstr ""
"<phrase revision=\"systemd\"><parameter>--with-systemd-"
"journal</parameter></phrase> <phrase revision=\"sysv\"><parameter>--with-"
"systemd-journal=no</parameter></phrase> : Essa chave força o "
"<application>ModemManager</application> a <phrase "
"revision=\"sysv\">não</phrase> usar o diário do \"systemd\" para registro."

#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/sysutils/modemmanager.xml:163
#, xml-text
msgid "Configuring ModemManager"
msgstr "Configurando o \"ModemManager\""

#. type: Content of: <sect1><sect2><sect3><title>
#: blfs-en/general/sysutils/modemmanager.xml:166
#, xml-text
msgid "Systemd Units"
msgstr "Unidades do systemd"

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/general/sysutils/modemmanager.xml:169
#, xml-text
msgid ""
"To start the <command>ModemManager</command> daemon at boot, enable the "
"previously installed systemd unit by running the following command as the "
"<systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Para iniciar o processo de segundo plano <command>ModemManager</command> na "
"inicialização, habilite a unidade do systemd instalada anteriormente "
"executando o seguinte comando como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><sect3><screen>
#: blfs-en/general/sysutils/modemmanager.xml:178
#, no-wrap, xml-text
msgid "<userinput>systemctl enable ModemManager</userinput>"
msgstr "<userinput>systemctl enable ModemManager</userinput>"

