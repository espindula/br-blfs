#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/sysutils/xdotool.xml:89
#, xml-text
msgid "Installation of xdotool"
msgstr "Instalação do xdotool"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/sysutils/xdotool.xml:100
#, xml-text
msgid ""
"Install <application>xdotool</application> by running the following "
"commands:"
msgstr ""
"Instale <application>xdotool</application> executando os seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/sysutils/xdotool.xml:104
#, no-wrap, xml-text
msgid "<userinput>make WITHOUT_RPATH_FIX=1</userinput>"
msgstr "<userinput>make WITHOUT_RPATH_FIX=1</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/sysutils/xdotool.xml:107
#, xml-text
msgid "To run the tests, do:"
msgstr "Para executar os testes, faça:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/sysutils/xdotool.xml:110
#, no-wrap, xml-text
msgid ""
"<userinput>cd t\n"
"make all-headless\n"
"cd ..</userinput>"
msgstr ""
"<userinput>cd t\n"
"make all-headless\n"
"cd ..</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/sysutils/xdotool.xml:115
#, xml-text
msgid "Now, as the &root; user:"
msgstr "Agora, como o(a) usante &root;:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/sysutils/xdotool.xml:118
#, no-wrap, xml-text
msgid ""
"<userinput>make PREFIX=/usr INSTALLMAN=/usr/share/man install</userinput>"
msgstr ""
"<userinput>make PREFIX=/usr INSTALLMAN=/usr/share/man install</userinput>"

