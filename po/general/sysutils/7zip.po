#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/sysutils/7zip.xml:83
#, xml-text
msgid "Installation of 7zip"
msgstr "Instalao do 7zip"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/sysutils/7zip.xml:86
#, xml-text
msgid ""
"Install <application>7zip</application> by running the following commands:"
msgstr ""
"Instale <application>7zip</application> executando os seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/sysutils/7zip.xml:90
#, no-wrap, xml-text
msgid ""
"<userinput>for i in Bundles/{Alone,Alone7z,Format7zF,SFXCon} UI/Console; do\n"
"    make -C CPP/7zip/$i -f ../../cmpl_gcc.mak\n"
"done</userinput>"
msgstr ""
"<userinput>for i in Bundles/{Alone,Alone7z,Format7zF,SFXCon} UI/Console; do\n"
"    make -C CPP/7zip/$i -f ../../cmpl_gcc.mak\n"
"done</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/sysutils/7zip.xml:95
#, xml-text
msgid "This package does not have a test suite."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/sysutils/7zip.xml:99
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usurio(a) <systemitem class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/sysutils/7zip.xml:102
#, no-wrap, xml-text
msgid ""
"<userinput>install -vDm755 CPP/7zip/Bundles/Alone{/b/g/7za,7z/b/g/7zr} \\\n"
"                CPP/7zip/Bundles/Format7zF/b/g/7z.so        \\\n"
"                CPP/7zip/UI/Console/b/g/7z                  \\\n"
"                -t /usr/lib/7zip/                              &amp;&amp;\n"
"\n"
"install -vm755 CPP/7zip/Bundles/SFXCon/b/g/7zCon \\\n"
"               /usr/lib/7zip/7zCon.sfx           &amp;&amp;\n"
"\n"
"(for i in 7z 7za 7zr; do\n"
"    cat &gt; /usr/bin/$i &lt;&lt; EOF || exit\n"
"<literal>#!/bin/sh\n"
"exec /usr/lib/7zip/$i \"\\$@\"</literal>\n"
"EOF\n"
"    chmod 755 /usr/bin/$i || exit\n"
"done) &amp;&amp;\n"
"\n"
"cp -rv DOC -T /usr/share/doc/7zip-&seven-zip-version;</userinput>"
msgstr ""
"<userinput>install -vDm755 CPP/7zip/Bundles/Alone{/b/g/7za,7z/b/g/7zr} \\\n"
"                CPP/7zip/Bundles/Format7zF/b/g/7z.so        \\\n"
"                CPP/7zip/UI/Console/b/g/7z                  \\\n"
"                -t /usr/lib/7zip/                              &amp;&amp;\n"
"\n"
"install -vm755 CPP/7zip/Bundles/SFXCon/b/g/7zCon \\\n"
"               /usr/lib/7zip/7zCon.sfx           &amp;&amp;\n"
"\n"
"(for i in 7z 7za 7zr; do\n"
"    cat &gt; /usr/bin/$i &lt;&lt; EOF || exit\n"
"<literal>#!/bin/sh\n"
"exec /usr/lib/7zip/$i \"\\$@\"</literal>\n"
"EOF\n"
"    chmod 755 /usr/bin/$i || exit\n"
"done) &amp;&amp;\n"
"\n"
"cp -rv DOC -T /usr/share/doc/7zip-&seven-zip-version;</userinput>"

