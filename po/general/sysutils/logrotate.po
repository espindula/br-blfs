#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/sysutils/logrotate.xml:113
#, xml-text
msgid "Configuring Logrotate"
msgstr "Configurando o \"Logrotate\""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/sysutils/logrotate.xml:116
#, xml-text
msgid ""
"<application>Logrotate</application> needs a configuration file, which must "
"be passed as an argument to the command when executed.  Create the file as "
"the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"<application>Logrotate</application> precisa de um arquivo de configuração, "
"o qual precisa ser passado como um argumento para o comando quando "
"executado. Crie o arquivo como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/sysutils/logrotate.xml:121
#, no-wrap, xml-text
msgid ""
"<userinput>cat &gt; /etc/logrotate.conf &lt;&lt; EOF\n"
"<literal># Begin /etc/logrotate.conf\n"
"\n"
"# Rotate log files weekly\n"
"weekly\n"
"\n"
"# Don't mail logs to anybody\n"
"nomail\n"
"\n"
"# If the log file is empty, it will not be rotated\n"
"notifempty\n"
"\n"
"# Number of backups that will be kept\n"
"# This will keep the 2 newest backups only\n"
"rotate 2\n"
"\n"
"# Create new empty files after rotating old ones\n"
"# This will create empty log files, with owner\n"
"# set to root, group set to sys, and permissions 664\n"
"create 0664 root sys\n"
"\n"
"# Compress the backups with gzip\n"
"compress\n"
"\n"
"# No packages own lastlog or wtmp -- rotate them here\n"
"/var/log/wtmp {\n"
"    monthly\n"
"    create 0664 root utmp\n"
"    rotate 1\n"
"}\n"
"\n"
"/var/log/lastlog {\n"
"    monthly\n"
"    rotate 1\n"
"}\n"
"\n"
"# Some packages drop log rotation info in this directory\n"
"# so we include any file in it.\n"
"include /etc/logrotate.d\n"
"\n"
"# End /etc/logrotate.conf</literal>\n"
"EOF\n"
"\n"
"chmod -v 0644 /etc/logrotate.conf</userinput>"
msgstr ""
"<userinput>cat &gt; /etc/logrotate.conf &lt;&lt; EOF\n"
"<literal># Começo /etc/logrotate.conf\n"
"\n"
"# Rotacione os arquivos de registro semanalmente\n"
"weekly\n"
"\n"
"# Não envie registros para ninguém\n"
"nomail\n"
"\n"
"# Se o arquivo de registro estiver vazio, [então] ele não será rotacionado\n"
"notifempty\n"
"\n"
"# Número de cópias de segurança que serão mantidas\n"
"# Isto manterá somente as duas cópias de segurança mais recentes\n"
"rotate 2\n"
"\n"
"# Crie novos arquivos vazios depois de rotacionar os antigos\n"
"# Isto criará arquivos de registro vazios, com o(a) proprietário(a)\n"
"# configurado como \"root\", grupo configurado como \"sys\" e permissões 664\n"
"create 0664 root sys\n"
"\n"
"# Comprime as cópias de segurança com o \"gzip\"\n"
"compress\n"
"\n"
"# Nenhum pacote possui \"lastlog\" ou \"wtmp\" - rotacione-os aqui\n"
"/var/log/wtmp {\n"
"    monthly\n"
"    create 0664 root utmp\n"
"    rotate 1\n"
"}\n"
"\n"
"/var/log/lastlog {\n"
"    monthly\n"
"    rotate 1\n"
"}\n"
"\n"
"# Alguns pacotes colocam informações de rotação de registro neste diretório\n"
"# de forma que incluímos qualquer arquivo nele.\n"
"include /etc/logrotate.d\n"
"\n"
"# Fim /etc/logrotate.conf</literal>\n"
"EOF\n"
"\n"
"chmod -v 0644 /etc/logrotate.conf</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/sysutils/logrotate.xml:167
#, xml-text
msgid ""
"Now create the <filename class='directory'>/etc/logrotate.d</filename> "
"directory as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora crie o diretório <filename "
"class='directory'>/etc/logrotate.d</filename> como o(a) usuário(a) "
"<systemitem class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/sysutils/logrotate.xml:171
#, no-wrap, xml-text
msgid "<userinput>mkdir -p /etc/logrotate.d</userinput>"
msgstr "<userinput>mkdir -p /etc/logrotate.d</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/sysutils/logrotate.xml:174
#, xml-text
msgid ""
"At this point additional log rotation commands can be entered, typically in "
"the <filename class='directory'>/etc/logrotate.d</filename> directory.  For "
"example:"
msgstr ""
"Neste ponto, comandos adicionais de rotação de registro conseguem ser "
"inseridos, normalmente no diretório <filename "
"class='directory'>/etc/logrotate.d</filename>. Por exemplo:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/sysutils/logrotate.xml:179
#, no-wrap, xml-text
msgid ""
"<userinput>cat &gt; /etc/logrotate.d/sys.log &lt;&lt; EOF\n"
"<literal>/var/log/sys.log {\n"
"   # If the log file is larger than 100kb, rotate it\n"
"   size   100k\n"
"   rotate 5\n"
"   weekly\n"
"   postrotate\n"
"      /bin/killall -HUP syslogd\n"
"   endscript\n"
"}</literal>\n"
"EOF\n"
"\n"
"chmod -v 0644 /etc/logrotate.d/sys.log</userinput>"
msgstr ""
"<userinput>cat &gt; /etc/logrotate.d/sys.log &lt;&lt; EOF\n"
"<literal>/var/log/sys.log {\n"
"   # Se o arquivo de registro for maior que 100 KB, [então] rotacione-o\n"
"   size   100k\n"
"   rotate 5\n"
"   weekly\n"
"   postrotate\n"
"      /bin/killall -HUP syslogd\n"
"   endscript\n"
"}</literal>\n"
"EOF\n"
"\n"
"chmod -v 0644 /etc/logrotate.d/sys.log</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/sysutils/logrotate.xml:194
#, xml-text
msgid "You can designate multiple files in one entry:"
msgstr "Você consegue designar vários arquivos em uma entrada:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/sysutils/logrotate.xml:197
#, no-wrap, xml-text
msgid ""
"<userinput>cat &gt; /etc/logrotate.d/example.log &lt;&lt; EOF\n"
"<literal>file1\n"
"file2\n"
"file3 {\n"
"   ...\n"
"   postrotate\n"
"    ...\n"
"   endscript\n"
"}</literal>\n"
"EOF\n"
"\n"
"chmod -v 0644 /etc/logrotate.d/example.log</userinput>"
msgstr ""
"<userinput>cat &gt; /etc/logrotate.d/example.log &lt;&lt; EOF\n"
"<literal>file1\n"
"file2\n"
"file3 {\n"
"   ...\n"
"  postrotate\n"
"    ...\n"
"   endscript\n"
"}</literal>\n"
"EOF\n"
"\n"
"chmod -v 0644 /etc/logrotate.d/example.log</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/sysutils/logrotate.xml:211
#, xml-text
msgid ""
"You can use in the same line the list of files: file1 file2 file3.  See the "
"logrotate man page or <ulink "
"url='https://www.techrepublic.com/article/manage-linux-log-files-with-"
"logrotate/'/> for more examples."
msgstr ""
"Você consegue usar na mesma linha a lista de arquivos: arquivo1 arquivo2 "
"arquivo3. Veja-se a página de manual do \"logrotate\" ou <ulink "
"url='https://www.techrepublic.com/article/manage-linux-log-files-with-"
"logrotate/'/> para mais exemplos."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/sysutils/logrotate.xml:218
#, xml-text
msgid ""
"The command <command>logrotate /etc/logrotate.conf</command> can be run "
"manually, however, the command should be run daily.  Other useful commands "
"are <command>logrotate -d /etc/logrotate.conf</command> for debugging "
"purposes and <command>logrotate -f /etc/logrotate.conf</command> forcing the"
" logrotate commands to be run immediately. Combining the previous options "
"<option>-df</option>, you can debug the effect of the force command.  When "
"debugging, the commands are only simulated and are not actually run.  As a "
"result, errors about files not existing will eventually appear because the "
"files are not actually created."
msgstr ""
"O comando <command>logrotate /etc/logrotate.conf</command> pode ser "
"executado manualmente, porém o comando deveria ser executado diariamente. "
"Outros comandos úteis são <command>logrotate -d "
"/etc/logrotate.conf</command> para fins de depuração e <command>logrotate -f"
" /etc/logrotate.conf</command> forçando os comandos do \"logrotate\" a serem"
" executados imediatamente. Combinando as opções anteriores "
"<option>-df</option>, você consegue depurar o efeito do comando \"force\". "
"Durante a depuração, os comandos são somente simulados e não são realmente "
"executados. Como resultado, erros a respeito de arquivos inexistentes "
"aparecerão eventualmente porque os arquivos não foram realmente criados."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/sysutils/logrotate.xml:231
#, xml-text
msgid ""
"To run the <command>logrotate</command> command daily, <phrase "
"revision=\"sysv\">if you've installed <xref linkend=\"fcron\"/> and "
"completed the section on periodic jobs, execute</phrase><phrase "
"revision=\"systemd\">execute</phrase> the following commands, as the "
"<systemitem class=\"username\">root</systemitem> user, to create a <phrase "
"revision=\"sysv\">daily cron job:</phrase> <phrase "
"revision=\"systemd\">systemd timer to run daily at 3:00 A.M.  (local "
"time):</phrase>"
msgstr ""
"Para executar o comando <command>logrotate</command> diariamente, <phrase "
"revision=\"sysv\">se você instalou <xref linkend=\"fcron\"/> e completou a "
"seção a respeito de tarefas periódicas, execute</phrase><phrase "
"revision=\"systemd\">execute</phrase> os seguintes comandos, como o(a) "
"usuário(a) <systemitem class=\"username\">root</systemitem>, para criar "
"<phrase revision=\"sysv\">uma tarefa diária do \"cron\":</phrase><phrase "
"revision=\"systemd\">um cronômetro do \"systemd\" para executar diariamente "
"às 3h (hora local):</phrase>"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/sysutils/logrotate.xml:241
#, no-wrap, xml-text
msgid ""
"<userinput>cat &gt; /etc/cron.daily/logrotate.sh &lt;&lt; \"EOF\" &amp;&amp;\n"
"<literal>#!/bin/bash\n"
"/usr/sbin/logrotate /etc/logrotate.conf</literal>\n"
"EOF\n"
"chmod 754 /etc/cron.daily/logrotate.sh</userinput>"
msgstr ""
"<userinput>cat &gt; /etc/cron.daily/logrotate.sh &lt;&lt; \"EOF\" &amp;&amp;\n"
"<literal>#!/bin/bash\n"
"/usr/sbin/logrotate /etc/logrotate.conf</literal>\n"
"EOF\n"
"chmod 754 /etc/cron.daily/logrotate.sh</userinput>"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/sysutils/logrotate.xml:247
#, no-wrap, xml-text
msgid ""
"<userinput>cat &gt; /usr/lib/systemd/system/logrotate.service &lt;&lt; \"EOF\" &amp;&amp;\n"
"<literal>[Unit]\n"
"Description=Runs the logrotate command\n"
"Documentation=man:logrotate(8)\n"
"DefaultDependencies=no\n"
"After=local-fs.target\n"
"Before=shutdown.target\n"
"\n"
"[Service]\n"
"Type=oneshot\n"
"RemainAfterExit=yes\n"
"ExecStart=/usr/sbin/logrotate /etc/logrotate.conf</literal>\n"
"EOF\n"
"cat &gt; /usr/lib/systemd/system/logrotate.timer &lt;&lt; \"EOF\" &amp;&amp;\n"
"<literal>[Unit]\n"
"Description=Runs the logrotate command daily at 3:00 AM\n"
"\n"
"[Timer]\n"
"OnCalendar=*-*-* 3:00:00\n"
"Persistent=true\n"
"\n"
"[Install]\n"
"WantedBy=timers.target</literal>\n"
"EOF\n"
"systemctl enable logrotate.timer</userinput>"
msgstr ""
"<userinput>cat &gt; /usr/lib/systemd/system/logrotate.service &lt;&lt; \"EOF\" &amp;&amp;\n"
"<literal>[Unit]\n"
"Description=Executa o comando \"logrotate\"\n"
"Documentation=man:logrotate(8)\n"
"DefaultDependencies=no\n"
"After=local-fs.target\n"
"Before=shutdown.target\n"
"\n"
"[Service]\n"
"Type=oneshot\n"
"RemainAfterExit=yes\n"
"ExecStart=/usr/sbin/logrotate /etc/logrotate.conf</literal>\n"
"EOF\n"
"cat &gt; /usr/lib/systemd/system/logrotate.timer &lt;&lt; \"EOF\" &amp;&amp;\n"
"<literal>[Unit]\n"
"Description=Executa o comando \"logrotate\" diariamente as 3:00 AM\n"
"\n"
"[Timer]\n"
"OnCalendar=*-*-* 3:00:00\n"
"Persistent=true\n"
"\n"
"[Install]\n"
"WantedBy=timers.target</literal>\n"
"EOF\n"
"systemctl enable logrotate.timer</userinput>"

