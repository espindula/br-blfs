#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/sysutils/p7zip.xml:93
#, xml-text
msgid "Installation of p7zip"
msgstr "Instalação do \"p7zip\""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/sysutils/p7zip.xml:96
#, xml-text
msgid "First, fix several security vulnerabilities:"
msgstr "Primeiro, corrija várias vulnerabilidades de segurança:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/sysutils/p7zip.xml:99
#, no-wrap, xml-text
msgid ""
"<userinput>patch -Np1 -i ../p7zip-&p7zip-"
"version;-consolidated_fixes-1.patch</userinput>"
msgstr ""
"<userinput>patch -Np1 -i ../p7zip-&p7zip-"
"version;-consolidated_fixes-1.patch</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/sysutils/p7zip.xml:102
#, xml-text
msgid ""
"Next, prevent <application>p7zip</application> from installing compressed "
"manual pages:"
msgstr ""
"A seguir, evite que o <application>p7zip</application> instale páginas de "
"manual comprimidas:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/sysutils/p7zip.xml:106
#, no-wrap, xml-text
msgid "<userinput remap=\"pre\">sed '/^gzip/d' -i install.sh</userinput>"
msgstr "<userinput remap=\"pre\">sed '/^gzip/d' -i install.sh</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/sysutils/p7zip.xml:109
#, xml-text
msgid ""
"Install <application>p7zip</application> by running the following commands:"
msgstr ""
"Instale <application>p7zip</application> executando os seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/sysutils/p7zip.xml:113
#, no-wrap, xml-text
msgid "<userinput>make all3</userinput>"
msgstr "<userinput>make all3</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/sysutils/p7zip.xml:116
#, xml-text
msgid "To test the results, issue: <command>make test</command>."
msgstr "Para testar os resultados, emita: <command>make test</command>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/sysutils/p7zip.xml:120
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr "Agora, como o(a) usante <systemitem class=\"username\">root</systemitem>:"

#.  dev note: make DEST_DIR=<DESTDIR>
#.  install
#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/sysutils/p7zip.xml:125
#, no-wrap, xml-text
msgid ""
"<userinput>make DEST_HOME=/usr \\\n"
"     DEST_MAN=/usr/share/man \\\n"
"     DEST_SHARE_DOC=/usr/share/doc/p7zip-&p7zip-version; install</userinput>"
msgstr ""
"<userinput>make DEST_HOME=/usr \\\n"
"    DEST_MAN=/usr/share/man \\\n"
"    DEST_SHARE_DOC=/usr/share/doc/p7zip-&p7zip-version; install</userinput>"

#. type: Content of: <sect1><sect2><note><para>
#: blfs-en/general/sysutils/p7zip.xml:131
#, xml-text
msgid "If using DESTDIR techniques, use DEST_DIR instead."
msgstr "Se usar técnicas \"DESTDIR\", [então] use \"DEST_DIR\" invés."

