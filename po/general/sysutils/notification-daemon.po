#, xml-text
msgid "Introduction to Notification Daemon"
msgstr "Introdução ao \"Notification Daemon\""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/sysutils/notification-daemon.xml:30
#, xml-text
msgid ""
"The <application>Notification Daemon</application> package contains a daemon"
" that displays passive pop-up notifications."
msgstr ""
"O pacote <application>Notification Daemon</application> contém um processo "
"de segundo plano que exibe notificações \"pop-up\" passivas."

