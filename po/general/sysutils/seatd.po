#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/sysutils/seatd.xml:82
#, xml-text
msgid "Installation of seatd"
msgstr "Instalação do seatd"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/sysutils/seatd.xml:84
#, xml-text
msgid "Install seatd by running the following commands:"
msgstr "Instale seatd executando os seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/sysutils/seatd.xml:87
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr             \\\n"
"            --buildtype=release       \\\n"
"            -D server=disabled        \\\n"
"            -D libseat-seatd=disabled \\\n"
"            .. &amp;&amp;\n"
"\n"
"ninja</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr             \\\n"
"            --buildtype=release       \\\n"
"            -D server=disabled        \\\n"
"            -D libseat-seatd=disabled \\\n"
"            .. &amp;&amp;\n"
"\n"
"ninja</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/sysutils/seatd.xml:99
#, xml-text
msgid "To run the test suite, issue: <command>ninja test</command>."
msgstr "Para executar a suíte de teste, emita: <command>ninja test</command>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/sysutils/seatd.xml:103
#, xml-text
msgid "Now, as the &root; user:"
msgstr "Agora, como o(a) usuário(a) &root;:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/sysutils/seatd.xml:106
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr "<userinput>ninja install</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/sysutils/seatd.xml:111
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/sysutils/seatd.xml:114
#, xml-text
msgid ""
"<parameter>-D server=disabled</parameter>: Disables building the seatd "
"daemon."
msgstr ""
"<parameter>-D server=disabled</parameter>: Desabilita construir o processo "
"de segundo plano seatd."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/sysutils/seatd.xml:119
#, xml-text
msgid ""
"<parameter>-D libseat-seatd=disabled</parameter>: This parameter disables "
"building support for the seatd management daemon for <filename "
"class=\"libraryfile\">libseat.so</filename> and instead relies on the "
"system-installed <phrase revision=\"sysv\">e</phrase>logind instead."
msgstr ""
"<parameter>-D libseat-seatd=disabled</parameter>: Esse parâmetro desabilita "
"construir suporte para o processo de segundo plano de gerenciamento seatd "
"para <filename class=\"libraryfile\">libseat.so</filename> e, em vez disso, "
"confia no <phrase revision=\"sysv\">e</phrase>logind instalado no sistema."

