#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/sysutils/hwdata.xml:72
#, xml-text
msgid "Installation of hwdata"
msgstr "Instalação do hwdata"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/sysutils/hwdata.xml:75
#, xml-text
msgid ""
"Install <application>hwdata</application> by running the following commands:"
msgstr ""
"Instale <application>hwdata</application> executando os seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/sysutils/hwdata.xml:79
#, no-wrap, xml-text
msgid "<userinput>./configure --prefix=/usr --disable-blacklist</userinput>"
msgstr "<userinput>./configure --prefix=/usr --disable-blacklist</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/sysutils/hwdata.xml:82
#, xml-text
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/sysutils/hwdata.xml:86
#, xml-text
msgid "Now, as the &root; user:"
msgstr "Agora, como o(a) usuário(a) &root;:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/sysutils/hwdata.xml:89
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

