#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/sysutils/hwdata.xml:29
#, xml-text
msgid ""
"The <application>hwdata</application> package contains current PCI and "
"vendor id data."
msgstr ""
"O pacote <application>hwdata</application> contém dados atuais de PCI e ID "
"do fornecedor."

