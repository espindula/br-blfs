#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/sysutils/blocaled.xml:27
#, xml-text
msgid "Introduction to blocaled"
msgstr "Introdução ao \"blocaled\""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/sysutils/blocaled.xml:30
#, xml-text
msgid ""
"<application>blocaled</application> is an implementation of the "
"<emphasis>org.freedesktop.locale1</emphasis> D-Bus protocol, which normally "
"comes with <application>systemd</application>. It is needed by the "
"<application>GNOME</application> desktop."
msgstr ""
"<application>blocaled</application> é uma implementação do protocolo "
"<emphasis>org.freedesktop.locale1</emphasis> do \"D-Bus\", que normalmente "
"vem com o <application>systemd</application>. Ele é necessário para a área "
"de trabalho <application>GNOME</application>."

