#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/sysutils/sysmon-qt.xml:85
#, xml-text
msgid "Installation of sysmon-qt"
msgstr "Instalação do sysmon-qt"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/sysutils/sysmon-qt.xml:88
#, xml-text
msgid ""
"Install <application>sysmon-qt</application> by running the following "
"commands:"
msgstr ""
"Instale <application>sysmon-qt</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/sysutils/sysmon-qt.xml:92
#, no-wrap, xml-text
msgid ""
"<userinput>qmake6 sysmon-qt.pro &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>qmake6 sysmon-qt.pro &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/sysutils/sysmon-qt.xml:96
#, xml-text
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/sysutils/sysmon-qt.xml:100
#, xml-text
msgid "Now, as the &root; user:"
msgstr "Agora, como o(a) usuário(a) &root;:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/sysutils/sysmon-qt.xml:103
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

