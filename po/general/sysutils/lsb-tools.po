#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/sysutils/lsb-tools.xml:74
#, xml-text
msgid "Installation of LSB-Tools"
msgstr "Instalação do \"LSB-Tools\""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/sysutils/lsb-tools.xml:77
#, xml-text
msgid ""
"Install <application>LSB-Tools</application> by running the following "
"commands:"
msgstr ""
"Instale <application>LSB-Tools</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/sysutils/lsb-tools.xml:81
#, no-wrap, xml-text
msgid "<userinput>make</userinput>"
msgstr "<userinput>make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/sysutils/lsb-tools.xml:84
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr "Agora, como o(a) usante <systemitem class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/sysutils/lsb-tools.xml:87
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/sysutils/lsb-tools.xml:91
#, xml-text
msgid "Remove a file that should not be installed as the &root; user:"
msgstr ""
"Remova um arquivo que deveria não ser instalado, como o(a) usante &root;:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/sysutils/lsb-tools.xml:94
#, no-wrap, xml-text
msgid "<userinput>rm /usr/sbin/lsbinstall</userinput>"
msgstr "<userinput>rm /usr/sbin/lsbinstall</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/sysutils/lsb-tools.xml:97
#, xml-text
msgid "Remove two scripts that serve no purpose on a systemd system:"
msgstr ""
"Remova dois conjuntos de comandos sequenciais que não servem para nada em um"
" sistema systemd:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/sysutils/lsb-tools.xml:100
#, no-wrap, xml-text
msgid "<userinput>rm /usr/sbin/{install,remove}_initd</userinput>"
msgstr "<userinput>rm /usr/sbin/{install,remove}_initd</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/sysutils/lsb-tools.xml:105
#, xml-text
msgid "Configuration Information"
msgstr "Informação de Configuração"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/sysutils/lsb-tools.xml:108
#, xml-text
msgid ""
"The configuration for this package was done in <ulink url='&lfs-"
"root;/chapter11/theend.html'>LFS</ulink>.  The file <filename>/etc/lsb-"
"release</filename> should already exist.  Be sure that the DISTRIB_CODENAME "
"entry has been set properly."
msgstr ""
"A configuração para esse pacote foi feita no <ulink url='&lfs-"
"root;/chapter11/theend.html'>LFS</ulink>. O arquivo <filename>/etc/lsb-"
"release</filename> já deveria existir. Certifique-se de que a entrada "
"DISTRIB_CODENAME tenha sido configurada corretamente."

