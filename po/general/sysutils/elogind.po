#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/sysutils/elogind.xml:133
#, xml-text
msgid "Installation of elogind"
msgstr "Instalação do elogind"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/sysutils/elogind.xml:136
#, xml-text
msgid ""
"Install <application>elogind</application> by running the following "
"commands:"
msgstr ""
"Instale o <application>elogind</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/sysutils/elogind.xml:140
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup ..                               \\\n"
"      --prefix=/usr                          \\\n"
"      --buildtype=release                    \\\n"
"      -D man=auto                            \\\n"
"      -D docdir=/usr/share/doc/elogind-&elogind-version; \\\n"
"      -D cgroup-controller=elogind           \\\n"
"      -D dev-kvm-mode=0660                   \\\n"
"      -D dbuspolicydir=/etc/dbus-1/system.d &amp;&amp;\n"
"ninja</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup ..                               \\\n"
"      --prefix=/usr                          \\\n"
"      --buildtype=release                    \\\n"
"      -D man=auto                            \\\n"
"      -D docdir=/usr/share/doc/elogind-&elogind-version; \\\n"
"      -D cgroup-controller=elogind           \\\n"
"      -D dev-kvm-mode=0660                   \\\n"
"      -D dbuspolicydir=/etc/dbus-1/system.d &amp;&amp;\n"
"ninja</userinput>"

#.       <filename>
#. test-id128</filename> require the
#.       <filename>/etc/machine-id</filename> symlink, so they will fail if
#.       this symlink is not created following the instruction in
#.       <xref linkend='dbus'/> yet.
#.       I did have the symlink and test-fs-util still failed (the only
#.       one).  The error was
#.          Assertion 'chase_symlinks(q, NULL, CHASE_SAFE, NULL, NULL) >= 0'
#.          failed at src/test/test-fs-util.c:303, function
#.          test_chase_symlinks(). Aborting.
#.       Looking at the code, I don't think that is related to the
#.       /etc/machine-id symlink. - bdubbs, version 252.23
#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/sysutils/elogind.xml:154
#, xml-text
msgid ""
"To test the results, issue: <command>ninja test</command>. A few tests are "
"skipped if not run with &root; privileges.  Three tests, <filename>test-"
"login</filename>, <filename>dbus-docs-fresh</filename>, and <filename>check-"
"version-history</filename>, are known to fail."
msgstr ""
"Para testar os resultados, emita: <command>ninja test</command>. Uns poucos "
"testes são ignorados se não executados com privilégios de &root;. Três "
"testes, <filename>test-login</filename>, <filename>dbus-docs-"
"fresh</filename> e <filename>check-version-history</filename>, são "
"conhecidos por falharem."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/sysutils/elogind.xml:175
#, xml-text
msgid "Now, as the &root; user:"
msgstr "Agora, como o(a) usuário(a) &root;:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/sysutils/elogind.xml:178
#, no-wrap, xml-text
msgid ""
"<userinput>ninja install                                           &amp;&amp;\n"
"ln -sfv  libelogind.pc /usr/lib/pkgconfig/libsystemd.pc &amp;&amp;\n"
"ln -sfvn elogind /usr/include/systemd</userinput>"
msgstr ""
"<userinput>ninja install                                          &amp;&amp;\n"
"ln -sfv  libelogind.pc /usr/lib/pkgconfig/libsystemd.pc &amp;&amp;\n"
"ln -sfvn elogind /usr/include/systemd</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/sysutils/elogind.xml:185
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/sysutils/elogind.xml:201
#, xml-text
msgid ""
"<parameter>-D docdir=/usr/share/doc/elogind-&elogind-version;</parameter>: "
"This is needed to install documentation in a versioned directory."
msgstr ""
"<parameter>-D docdir=/usr/share/doc/elogind-&elogind-version;</parameter>: "
"Isso é necessário para instalar a documentação em um diretório versionado."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/sysutils/elogind.xml:206
#, xml-text
msgid ""
"<parameter>-D cgroup-controller=elogind</parameter>: This switch is "
"necessary to build this package when the kernel is not built with "
"<option>CONFIG_CGROUPS</option> enabled.  Note that "
"<application>elogind</application> strictly needs a kernel with "
"<option>CONFIG_CGROUPS</option> enabled at runtime, but this switch will "
"allow building the package first."
msgstr ""
"<parameter>-D cgroup-controller=elogind</parameter>: Essa chave é necessária"
" para construir esse pacote quando o núcleo não for compilado com "
"<option>CONFIG_CGROUPS</option> habilitada. Observe que "
"<application>elogind</application> precisa estritamente de um núcleo com "
"<option>CONFIG_CGROUPS</option> habilitada em tempo de execução, mas essa "
"chave permitirá construir o pacote primeiro."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/sysutils/elogind.xml:215
#, xml-text
msgid ""
"<parameter>-D dbuspolicydir=/etc/dbus-1/system.d</parameter>: This switch "
"sets the location of the <application>D-Bus</application> policy directory."
msgstr ""
"<parameter>-D dbuspolicydir=/etc/dbus-1/system.d</parameter>: Essa chave "
"configura o local do diretório de políticas do "
"<application>D-Bus</application>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/sysutils/elogind.xml:221
#, xml-text
msgid ""
"<parameter>-D dev-kvm-mode=0660</parameter>: The LFS udev rule sets the mode"
" of <filename class='devicefile'>/dev/kvm</filename> to 0660.  This option "
"ensures the elogind udev rules consistent with the LFS configuration."
msgstr ""
"<parameter>-D dev-kvm-mode=0660</parameter>: A regra udev do LFS configura o"
" modo de <filename class='devicefile'>/dev/kvm</filename> como 0660. Essa "
"opção garante que as regras udev do elogind sejam consistentes com a "
"configuração do LFS."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/sysutils/elogind.xml:228
#, xml-text
msgid ""
"<parameter>-D man=auto</parameter>: The default value of this switch is "
"<emphasis>false</emphasis>. Setting it to <emphasis>auto</emphasis> allows "
"building and installing the man pages if the recommended dependencies are "
"installed."
msgstr ""
"<parameter>-D man=auto</parameter>: O valor padrão dessa chave é "
"<emphasis>false</emphasis>. Configurá-lo como <emphasis>auto</emphasis> "
"permite construir e instalar as páginas de manual se as dependências "
"recomendadas estiverem instaladas."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/sysutils/elogind.xml:235
#, xml-text
msgid ""
"<option>-D html=auto</option>: The default value of this switch is "
"<emphasis>false</emphasis>. Setting it to <emphasis>auto</emphasis> allows "
"building and installing the html documentation if the recommended "
"dependencies are installed."
msgstr ""
"<option>-D html=auto</option>: O valor padrão dessa chave é "
"<emphasis>false</emphasis>. Configurá-la como <emphasis>auto</emphasis> "
"permite construir e instalar a documentação HTML se as dependências "
"recomendadas estiverem instaladas."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/sysutils/elogind.xml:242
#, xml-text
msgid ""
"<option>-D default-kill-user-processes=false</option>: Determines whether "
"the processes of a user should be killed when the user logs out. The default"
" is <emphasis>true</emphasis>, but this defeats the traditional use of "
"<command>screen</command> or <command>tmux</command>. This can also be "
"changed in the configuration file (see below)."
msgstr ""
"<option>-D default-kill-user-processes=false</option>: Determina se os "
"processos de um(a) usuário(a) deveriam ser eliminados quando o(a) usuário(a)"
" sai. O padrão é <emphasis>true</emphasis>, mas isso anula o uso tradicional"
" de <command>screen</command> ou <command>tmux</command>. Isso também pode "
"ser mudado no arquivo de configuração (veja-se abaixo)."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/sysutils/elogind.xml:250
#, xml-text
msgid ""
"<command>ln -s ...</command>: These commands install symlinks so that "
"software packages can find the systemd-compatible library and headers."
msgstr ""
"<command>ln -s ...</command>: Esses comandos instalam links simbólicos, de "
"modo que aqueles pacotes de software consigam encontrar a biblioteca e os "
"cabeçalhos compatíveis com o \"systemd\"."

#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/sysutils/elogind.xml:257
#, xml-text
msgid "Configuring elogind"
msgstr "Configurando o elogind"

#. type: Content of: <sect1><sect2><sect3><title>
#: blfs-en/general/sysutils/elogind.xml:260
#, xml-text
msgid "Config File"
msgstr "Arquivo de Configuração"

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/general/sysutils/elogind.xml:262
#, xml-text
msgid "<filename>/etc/elogind/logind.conf</filename>"
msgstr "<filename>/etc/elogind/logind.conf</filename>"

#. type: Content of: <sect1><sect2><sect3><indexterm><primary>
#: blfs-en/general/sysutils/elogind.xml:267
#, xml-text
msgid "/etc/elogind/logind.conf"
msgstr "/etc/elogind/logind.conf"

#. type: Content of: <sect1><sect2><sect3><title>
#: blfs-en/general/sysutils/elogind.xml:271
#, xml-text
msgid "Configuration Information"
msgstr "Informação de Configuração"

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/general/sysutils/elogind.xml:274
#, xml-text
msgid ""
"The installed file <filename>/etc/elogind/logind.conf</filename> contains "
"all the possible options with their defaults, commented out. You may wish to"
" disable automatically killing user processes when the user logs out, by "
"running, as the &root; user:"
msgstr ""
"O arquivo instalado <filename>/etc/elogind/logind.conf</filename> contém "
"todas as opções possíveis com os padrões delas comentados. Você "
"possivelmente deseje desabilitar a eliminação automática de processos de "
"usante quando o(a) usante desloga, executando como o(a) usante &root;:"

#. type: Content of: <sect1><sect2><sect3><screen>
#: blfs-en/general/sysutils/elogind.xml:280
#, no-wrap, xml-text
msgid ""
"<userinput>sed -e '/\\[Login\\]/a KillUserProcesses=no' \\\n"
"    -i /etc/elogind/logind.conf</userinput>"
msgstr ""
"<userinput>sed -e '/\\[Login\\]/a KillUserProcesses=no' \\\n"
"   -i /etc/elogind/logind.conf</userinput>"

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/general/sysutils/elogind.xml:284
#, xml-text
msgid ""
"Each user will need to register a user session using <application>Linux-"
"PAM</application> at login. The <filename>/etc/pam.d/system-"
"session</filename> file needs to be modified and a new file must be created "
"in order for <command>elogind</command> to work correctly. Run the following"
" commands as the &root; user:"
msgstr ""
"Cada usante precisará registrar uma sessão de usante usando "
"<application>Linux-PAM</application> no login. O arquivo "
"<filename>/etc/pam.d/system-session</filename> precisa ser modificado e um "
"novo arquivo precisa ser criado para a finalidade de que o "
"<command>elogind</command> funcione corretamente. Execute os seguintes "
"comandos como o(a) usante &root;:"

#. type: Content of: <sect1><sect2><sect3><screen>
#: blfs-en/general/sysutils/elogind.xml:292
#, no-wrap, xml-text
msgid ""
"<userinput>cat &gt;&gt; /etc/pam.d/system-session &lt;&lt; \"EOF\" &amp;&amp;\n"
"<literal># Begin elogind addition\n"
"\n"
"session  required    pam_loginuid.so\n"
"session  optional    pam_elogind.so\n"
"\n"
"# End elogind addition</literal>\n"
"EOF\n"
"cat &gt; /etc/pam.d/elogind-user &lt;&lt; \"EOF\"\n"
"<literal># Begin /etc/pam.d/elogind-user\n"
"\n"
"account  required    pam_access.so\n"
"account  include     system-account\n"
"\n"
"session  required    pam_env.so\n"
"session  required    pam_limits.so\n"
"session  required    pam_unix.so\n"
"session  required    pam_loginuid.so\n"
"session  optional    pam_keyinit.so force revoke\n"
"session  optional    pam_elogind.so\n"
"\n"
"auth     required    pam_deny.so\n"
"password required    pam_deny.so\n"
"\n"
"# End /etc/pam.d/elogind-user</literal>\n"
"EOF</userinput>"
msgstr ""
"<userinput>cat &gt;&gt; /etc/pam.d/system-session &lt;&lt; \"EOF\" &amp;&amp;\n"
"<literal># Começo da adição de \"elogind\"\n"
"\n"
"session  required    pam_loginuid.so\n"
"session  optional    pam_elogind.so\n"
"\n"
"# Fim da adição de \"elogind\"</literal>\n"
"EOF\n"
"cat &gt; /etc/pam.d/elogind-user &lt;&lt; \"EOF\"\n"
"<literal># Começo /etc/pam.d/elogind-user\n"
"\n"
"account  required    pam_access.so\n"
"account  include     system-account\n"
"\n"
"session  required    pam_env.so\n"
"session  required    pam_limits.so\n"
"session  required    pam_unix.so\n"
"session  required    pam_loginuid.so\n"
"session  optional    pam_keyinit.so force revoke\n"
"session  optional    pam_elogind.so\n"
"\n"
