#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/graphlib/libjxl.xml:95
#, xml-text
msgid "Installation of libjxl"
msgstr "Instalação do libjxl"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/libjxl.xml:98
#, xml-text
msgid ""
"Install <application>libjxl</application> by running the following commands:"
msgstr ""
"Instale <application>libjxl</application> executando os seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/graphlib/libjxl.xml:102
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr             \\\n"
"      -D CMAKE_BUILD_TYPE=Release              \\\n"
"      -D BUILD_TESTING=OFF                     \\\n"
"      -D BUILD_SHARED_LIBS=ON                  \\\n"
"      -D JPEGXL_ENABLE_SKCMS=OFF               \\\n"
"      -D JPEGXL_ENABLE_SJPEG=OFF               \\\n"
"      -D JPEGXL_ENABLE_PLUGINS=OFF             \\\n"
"      -D JPEGXL_INSTALL_JARDIR=/usr/share/java \\\n"
"      -G Ninja ..                              &amp;&amp;\n"
"ninja</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr             \\\n"
"      -D CMAKE_BUILD_TYPE=Release              \\\n"
"      -D BUILD_TESTING=OFF                     \\\n"
"      -D BUILD_SHARED_LIBS=ON                  \\\n"
"      -D JPEGXL_ENABLE_SKCMS=OFF               \\\n"
"      -D JPEGXL_ENABLE_SJPEG=OFF               \\\n"
"      -D JPEGXL_ENABLE_PLUGINS=OFF             \\\n"
"      -D JPEGXL_INSTALL_JARDIR=/usr/share/java \\\n"
"      -G Ninja ..                              &amp;&amp;\n"
"ninja</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/libjxl.xml:117
#, xml-text
msgid ""
"This package does come with a test suite, but it requires <ulink "
"url=\"https://github.com/google/googletest\">gtest</ulink>, which is not in "
"BLFS."
msgstr ""
"Esse pacote vem com uma suíte de teste, porém ela exige <ulink "
"url=\"https://github.com/google/googletest\">gtest</ulink>, que não está no "
"BLFS."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/libjxl.xml:123
#, xml-text
msgid "Now, as the &root; user:"
msgstr "Agora, como o(a) usuário(a) &root;:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/graphlib/libjxl.xml:126
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr "<userinput>ninja install</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/graphlib/libjxl.xml:131
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/libjxl.xml:142
#, xml-text
msgid ""
"<parameter>-D BUILD_TESTING=OFF</parameter>: This parameter disables the "
"tests because they require <ulink "
"url=\"https://github.com/google/googletest\">gtest</ulink>, which is not in "
"BLFS. If you wish to run the tests and have <ulink "
"url=\"https://github.com/google/googletest\">gtest</ulink> installed, remove"
" this parameter."
msgstr ""
"<parameter>-D BUILD_TESTING=OFF</parameter>: Esse parâmetro desabilita os "
"testes porque eles exigem <ulink "
"url=\"https://github.com/google/googletest\">gtest</ulink>, que não está no "
"BLFS. Se você deseja executar os testes e ter o <ulink "
"url=\"https://github.com/google/googletest\">gtest</ulink> instalado, remova"
" esse parâmetro."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/libjxl.xml:151
#, xml-text
msgid ""
"<parameter>-D BUILD_SHARED_LIBS=ON</parameter>: This parameter enables "
"building shared versions of the libraries instead of static ones."
msgstr ""
"<parameter>-D BUILD_SHARED_LIBS=ON</parameter>: Esse parâmetro habilita "
"construir versões compartilhadas das bibliotecas em vez das estáticas."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/libjxl.xml:156
#, xml-text
msgid ""
"<parameter>-D JPEGXL_ENABLE_SKCMS=OFF</parameter>: This parameter disables "
"building support for Skia's <application>skcms</application> since it is not"
" necessary for BLFS purposes and requires <ulink "
"url=\"https://skia.googlesource.com/skcms/\">skcms</ulink>."
msgstr ""
"<parameter>-D JPEGXL_ENABLE_SKCMS=OFF</parameter>: Esse parâmetro desabilita"
" construir suporte para <application>skcms</application> do Skia, pois não é"
" necessário para fins de BLFS e exige <ulink "
"url=\"https://skia.googlesource.com/skcms/\">skcms</ulink>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/libjxl.xml:163
#, xml-text
msgid ""
"<parameter>-D JPEGXL_ENABLE_SJPEG=OFF</parameter>: This parameter disables "
"support for SimpleJPEG since it is not necessary for BLFS purposes and "
"requires <ulink url=\"https://github.com/webmproject/sjpeg\">sjpeg</ulink>."
msgstr ""
"<parameter>-D JPEGXL_ENABLE_SJPEG=OFF</parameter>: Esse parâmetro desabilita"
" o suporte para SimpleJPEG, pois não é necessário para fins de BLFS e exige "
"<ulink url=\"https://github.com/webmproject/sjpeg\">sjpeg</ulink>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/libjxl.xml:169
#, xml-text
msgid ""
"<parameter>-D JPEGXL_ENABLE_PLUGINS=OFF</parameter>: This parameter disables"
" building the JPEG XL loader plugins for GIMP and gdk-pixbuf.  The GIMP "
"plugin isn't compatible with the GIMP version in the book, and the gdk-"
"pixbuf plugin is useless when gdk-pixbuf is built with its recommended "
"dependency glycin."
msgstr ""
"<parameter>-D JPEGXL_ENABLE_PLUGINS=OFF</parameter>: Esse parâmetro "
"desabilita construir os plugins do carregador XL do JPEG para GIMP e gdk-"
"pixbuf. O plugin do GIMP não é compatível com a versão do GIMP no livro, e o"
" plugin do gdk-pixbuf é inútil quando o gdk-pixbuf é construído com a "
"dependência recomendada dele, glycin."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/libjxl.xml:177
#, xml-text
msgid ""
"<parameter>-D JPEGXL_INSTALL_JARDIR=/usr/share/java</parameter>: This "
"parameter places the JAR file for JPEG XL support in the correct directory "
"if <xref linkend=\"java\"/> is installed."
msgstr ""
"<parameter>-D JPEGXL_INSTALL_JARDIR=/usr/share/java</parameter>: Esse "
"parâmetro coloca o arquivo JAR para suporte JPEG XL no diretório correto se "
"<xref linkend=\"java\"/> estiver instalado."

