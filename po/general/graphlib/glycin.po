#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/graphlib/glycin.xml:99
#, xml-text
msgid "Installation of glycin"
msgstr "Instalação do glycin"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/glycin.xml:102
#, xml-text
msgid ""
"Install <application>glycin</application> by running the following commands:"
msgstr ""
"Instale <application>glycin</application> executando os seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/graphlib/glycin.xml:106
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr           \\\n"
"            --buildtype=release     \\\n"
"            -D libglycin-gtk4=false &amp;&amp;\n"
"ninja</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr           \\\n"
"            --buildtype=release     \\\n"
"            -D libglycin-gtk4=false &amp;&amp;\n"
"ninja</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/glycin.xml:115
#, xml-text
msgid ""
"If you have installed <xref linkend=\"gi-docgen\"/>, you can build the "
"documentation by issuing:"
msgstr ""
"Se tiver instalado o <xref linkend=\"gi-docgen\"/>, você consegue construir "
"a documentação emitindo:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/graphlib/glycin.xml:119
#, no-wrap, xml-text
msgid ""
"<userinput>sed \"/install_dir:.*doc/s|,$| / 'glycin-' + meson.project_version()&amp;|\" \\\n"
"    -i ../libglycin/meson.build &amp;&amp;\n"
"\n"
"meson configure -D capi_docs=true &amp;&amp;\n"
"ninja</userinput>"
msgstr ""
"<userinput>sed \"/install_dir:.*doc/s|,$| / 'glycin-' + meson.project_version()&amp;|\" \\\n"
"    -i ../libglycin/meson.build &amp;&amp;\n"
"\n"
"meson configure -D capi_docs=true &amp;&amp;\n"
"ninja</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/glycin.xml:126
#, xml-text
msgid "To test the results, issue: <command>ninja test</command>."
msgstr "Para testar os resultados, emita: <command>ninja test</command>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/glycin.xml:130
#, xml-text
msgid "Now as the &root; user:"
msgstr "Agora como o(a) usuário(a) &root;:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/graphlib/glycin.xml:133
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr "<userinput>ninja install</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/graphlib/glycin.xml:138
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/glycin.xml:141
#, xml-text
msgid ""
"<parameter>-D glycin_gtk4=false</parameter>: This parameter disables the "
"build of <systemitem class='library'>libglycin-gtk4</systemitem> (which is "
"not used by any BLFS packages yet) so this package can be built without "
"<xref linkend='gtk4'/> installed."
msgstr ""
"<parameter>-D glycin_gtk4=false</parameter>: Esse parâmetro desabilita a "
"construção da <systemitem class='library'>libglycin-gtk4</systemitem> (que "
"ainda não é usada por nenhum pacote do BLFS), de forma que esse pacote "
"consiga ser construído sem <xref linkend='gtk4'/> instalado."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/glycin.xml:148
#, xml-text
msgid ""
"<option>-D glycin-loaders=...</option>: Use this option to specify the image"
" loaders to be built.  The default is <literal>glycin-heif,glycin-image-"
"rs,glycin-jxl,glycin-svg</literal>, covering the support for all commonly "
"used image formats.  You may remove the <literal>glycin-heif</literal>, "
"<literal>glycin-jxl</literal>, or <literal>glycin-svg</literal> loader if "
"the corresponding recommended dependency is not installed, but doing so will"
" cause test failures and hamper the functionality of this package.  There "
"are also loaders for the JPEG 2000 and RAW formats but they are not enabled "
"by default."
msgstr ""
"<option>-D glycin-loaders=...</option>: Use essa opção para especificar os "
"carregadores de imagem a serem construídos. O padrão é <literal>glycin-"
"heif,glycin-image-rs,glycin-jxl,glycin-svg</literal>, abrangendo o suporte "
"para todos os formatos de imagem comumente usados. Você pode remover o "
"carregador <literal>glycin-heif</literal>, <literal>glycin-jxl</literal> ou "
"<literal>glycin-svg</literal> se a dependência recomendada correspondente "
"não estiver instalada, mas fazer isso causará falhas nos testes e "
"prejudicará a funcionalidade desse pacote. Também existem carregadores para "
"os formatos JPEG 2000 e RAW, mas eles não estão habilitados por padrão."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/glycin.xml:161
#, xml-text
msgid ""
"<option>-D vapi=false</option>: This option allows building this package "
"without <xref linkend='vala'/> installed."
msgstr ""
"<option>-D vapi=false</option>: Essa opção permite construir esse pacote sem"
" <xref linkend='vala'/> instalado."

