#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/webp-pixbuf-loader.xml:28
#, xml-text
msgid ""
"The <application>webp-pixbuf-loader</application> package contains a library"
" that allows gdk-pixbuf to load and process webp images."
msgstr ""
"O pacote <application>webp-pixbuf-loader</application> contém uma biblioteca"
" que permite ao gdk-pixbuf carregar e processar imagens webp."

