#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/graphlib/webp-pixbuf-loader.xml:79
#, xml-text
msgid "Installation of webp-pixbuf-loader"
msgstr "Instalação do webp-pixbuf-loader"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/webp-pixbuf-loader.xml:82
#, xml-text
msgid ""
"Install <application>webp-pixbuf-loader</application> by running the "
"following commands:"
msgstr ""
"Instale o <application>webp-pixbuf-loader</application> executando os "
"seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/graphlib/webp-pixbuf-loader.xml:86
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr --buildtype=release .. &amp;&amp;\n"
"ninja</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr --buildtype=release .. &amp;&amp;\n"
"ninja</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/webp-pixbuf-loader.xml:93
#, xml-text
msgid "To test the results, issue: <command>ninja test</command>."
msgstr "Para testar os resultados, emita: <command>ninja test</command>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/webp-pixbuf-loader.xml:97
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr "Agora, como o(a) usante <systemitem class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/graphlib/webp-pixbuf-loader.xml:100
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr "<userinput>ninja install</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/webp-pixbuf-loader.xml:103
#, xml-text
msgid "The webp format needs to be added to the loaders cache:"
msgstr "O formato webp precisa ser adicionado ao cache dos carregadores:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/graphlib/webp-pixbuf-loader.xml:106
#, no-wrap, xml-text
msgid "<userinput>gdk-pixbuf-query-loaders --update-cache</userinput>"
msgstr "<userinput>gdk-pixbuf-query-loaders --update-cache</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/graphlib/webp-pixbuf-loader.xml:111
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/webp-pixbuf-loader.xml:117
#, xml-text
msgid ""
"<command>gdk-pixbuf-query-loaders --update-cache</command>: This command "
"updates the gdk-pixbuf loader cache so that it knows the webp loader has "
"been installed."
msgstr ""
"<command>gdk-pixbuf-query-loaders --update-cache</command>: Esse comando "
"atualiza o cache do carregador gdk-pixbuf, de forma que ele saiba que o "
"carregador webp foi instalado."

