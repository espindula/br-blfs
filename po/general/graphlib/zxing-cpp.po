#: blfs-en/general/graphlib/zxing-cpp.xml:84
#, xml-text
msgid "Installation of zxing-cpp"
msgstr "Instalação do zxing-cpp"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/zxing-cpp.xml:88
#, xml-text
msgid ""
"Install <application>zxing-cpp</application> by running the following "
"commands:"
msgstr ""
"Instale <application>zxing-cpp</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/graphlib/zxing-cpp.xml:92
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr \\\n"
"      -D CMAKE_BUILD_TYPE=Release  \\\n"
"      -D ZXING_EXAMPLES=OFF        \\\n"
"      -W no-dev ..                 &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr \\\n"
"      -D CMAKE_BUILD_TYPE=Release  \\\n"
"      -D ZXING_EXAMPLES=OFF        \\\n"
"      -W no-dev ..                 &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/zxing-cpp.xml:102
#, xml-text
msgid "Tests require an external package."
msgstr "Testes exigem um pacote externo."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/zxing-cpp.xml:106
#, xml-text
msgid "Now, as the &root; user:"
msgstr "Agora, como o(a) usuário(a) &root;:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/graphlib/zxing-cpp.xml:109
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

