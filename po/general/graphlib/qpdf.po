#, xml-text
msgid "Introduction to Qpdf"
msgstr "Introdução ao Qpdf"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/qpdf.xml:29
#, xml-text
msgid ""
"The <application>Qpdf</application> package contains command-line programs "
"and a library that does structural, content-preserving transformations on "
"PDF files."
msgstr ""
"O pacote <application>Qpdf</application> contém aplicativos de linha de "
"comando e uma biblioteca que faz transformações estruturais, preservando "
"conteúdo, sobre arquivos \"PDF\"."

