#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/graphlib/qpdf.xml:89
#, xml-text
msgid "Installation of Qpdf"
msgstr "Instalação do Qpdf"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/qpdf.xml:92
#, xml-text
msgid ""
"Install <application>Qpdf</application> by running the following commands:"
msgstr ""
"Instale <application>Qpdf</application> executando os seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/graphlib/qpdf.xml:96
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr \\\n"
"      -D CMAKE_BUILD_TYPE=Release  \\\n"
"      -D BUILD_STATIC_LIBS=OFF     \\\n"
"      -D CMAKE_INSTALL_DOCDIR=/usr/share/doc/qpdf-&qpdf-version; \\\n"
"      .. &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr \\\n"
"      -D CMAKE_BUILD_TYPE=Release  \\\n"
"      -D BUILD_STATIC_LIBS=OFF     \\\n"
"      -D CMAKE_INSTALL_DOCDIR=/usr/share/doc/qpdf-&qpdf-version; \\\n"
"      .. &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/qpdf.xml:107
#, xml-text
msgid "To test the results, issue: <command>ctest</command>."
msgstr "Para testar os resultados, emita: <command>ctest</command>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/qpdf.xml:111
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/graphlib/qpdf.xml:114
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

