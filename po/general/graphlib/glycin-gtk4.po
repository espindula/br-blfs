#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/graphlib/glycin-gtk4.xml:83
#, xml-text
msgid "Installation of libglycin-gtk4"
msgstr "Instalação do libglycin-gtk4"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/glycin-gtk4.xml:86
#, xml-text
msgid ""
"Install <systemitem class='library'>libglycin-gtk4</systemitem> by running "
"the following commands:"
msgstr ""
"Instale <systemitem class='library'>libglycin-gtk4</systemitem> executando "
"os seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/graphlib/glycin-gtk4.xml:90
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr               \\\n"
"            --buildtype=release         \\\n"
"            -D libglycin=false          \\\n"
"            -D libglycin-gtk4=true      \\\n"
"            -D glycin-loaders=false     \\\n"
"            -D glycin-thumbnailer=false &amp;&amp;\n"
"ninja</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr               \\\n"
"            --buildtype=release         \\\n"
"            -D libglycin=false          \\\n"
"            -D libglycin-gtk4=true      \\\n"
"            -D glycin-loaders=false     \\\n"
"            -D glycin-thumbnailer=false &amp;&amp;\n"
"ninja</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/glycin-gtk4.xml:102
#, xml-text
msgid ""
"If you have installed <xref linkend=\"gi-docgen\"/>, you can build the "
"documentation by issuing:"
msgstr ""
"Se tiver instalado o <xref linkend=\"gi-docgen\"/>, você consegue construir "
"a documentação emitindo:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/graphlib/glycin-gtk4.xml:106
#, no-wrap, xml-text
msgid ""
"<userinput>sed \"/install_dir:.*doc/s|,$| / 'glycin-' + meson.project_version()&amp;|\" \\\n"
"    -i ../libglycin/meson.build &amp;&amp;\n"
"\n"
"meson configure -D capi_docs=true &amp;&amp;\n"
"ninja</userinput>"
msgstr ""
"<userinput>sed \"/install_dir:.*doc/s|,$| / 'glycin-' + meson.project_version()&amp;|\" \\\n"
"    -i ../libglycin/meson.build &amp;&amp;\n"
"\n"
"meson configure -D capi_docs=true &amp;&amp;\n"
"ninja</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/glycin-gtk4.xml:113
#, xml-text
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/glycin-gtk4.xml:117
#, xml-text
msgid "Now as the &root; user:"
msgstr "Agora como o(a) usante &root;:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/graphlib/glycin-gtk4.xml:120
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr "<userinput>ninja install</userinput>"

