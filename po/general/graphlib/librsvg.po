#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/graphlib/librsvg.xml:98
#, xml-text
msgid "Installation of librsvg"
msgstr "Instalação do librsvg"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/librsvg.xml:101
#, xml-text
msgid "First, fix the installation path of the API documentation:"
msgstr "Primeiro, corrija o caminho de instalação da documentação da API:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/graphlib/librsvg.xml:104
#, no-wrap, xml-text
msgid ""
"<userinput>sed -e \"/OUTDIR/s|,| / 'librsvg-&librsvg-version;', '--no-namespace-dir',|\" \\\n"
"    -e '/output/s|Rsvg-2.0|librsvg-&librsvg-version;|'                      \\\n"
"    -i doc/meson.build</userinput>"
msgstr ""
"<userinput>sed -e \"/OUTDIR/s|,| / 'librsvg-&librsvg-version;', '--no-namespace-dir',|\" \\\n"
"    -e '/output/s|Rsvg-2.0|librsvg-&librsvg-version;|'                      \\\n"
"    -i doc/meson.build</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/librsvg.xml:109
#, xml-text
msgid ""
"Install <application>librsvg</application> by running the following "
"commands:"
msgstr ""
"Instale <application>librsvg</application> executando os seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/graphlib/librsvg.xml:113
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr --buildtype=release .. &amp;&amp;\n"
"ninja</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr --buildtype=release .. &amp;&amp;\n"
"ninja</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/librsvg.xml:127
#, xml-text
msgid "To test the results, issue:"
msgstr "Para testar os resultados, emita:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/graphlib/librsvg.xml:130
#, no-wrap, xml-text
msgid "<userinput>ninja test</userinput>"
msgstr "<userinput>ninja test</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/librsvg.xml:133
#, xml-text
msgid "One test, Rust tests (rsvg), is known to fail."
msgstr "Um teste, Rust tests (rsvg), é conhecido por falhar."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/librsvg.xml:137
#, xml-text
msgid "Now, as the &root; user:"
msgstr "Agora, como o(a) usuário(a) &root;:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/graphlib/librsvg.xml:140
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr "<userinput>ninja install</userinput>"

