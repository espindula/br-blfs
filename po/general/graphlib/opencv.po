#, xml-text
msgid "Installation of opencv"
msgstr "Instalação do opencv"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/opencv.xml:150
#, xml-text
msgid "If you downloaded the optional modules, unpack them now:"
msgstr "Se você baixou os módulos opcionais, [então] desempacote-os agora:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/graphlib/opencv.xml:153
#, no-wrap, xml-text
msgid ""
"<userinput>tar -xf ../opencv_contrib-&opencv-contrib-"
"version;.tar.gz</userinput>"
msgstr ""
"<userinput>tar -xf ../opencv_contrib-&opencv-contrib-"
"version;.tar.gz</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/opencv.xml:161
#, xml-text
msgid "Fix a build problem that occurs with CMake 4.0:"
msgstr "Corrija um problema de construção que ocorre com CMake 4.0:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/graphlib/opencv.xml:164
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"pre\">sed -i 's/VERSION 2.8.12.2/VERSION 4.0.0/' "
"cmake/OpenCVGenPkgconfig.cmake</userinput>"
msgstr ""
"<userinput remap=\"pre\">sed -i 's/VERSION 2.8.12.2/VERSION 4.0.0/' "
"cmake/OpenCVGenPkgconfig.cmake</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/opencv.xml:167
#, xml-text
msgid ""
"Install <application>opencv</application> by running the following commands:"
msgstr ""
"Instale <application>opencv</application> executando os seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/graphlib/opencv.xml:171
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr        \\\n"
"      -D CMAKE_BUILD_TYPE=Release         \\\n"
"      -D ENABLE_CXX11=ON                  \\\n"
"      -D BUILD_PERF_TESTS=OFF             \\\n"
"      -D WITH_XINE=ON                     \\\n"
"      -D BUILD_TESTS=OFF                  \\\n"
"      -D ENABLE_PRECOMPILED_HEADERS=OFF   \\\n"
"      -D CMAKE_SKIP_INSTALL_RPATH=ON      \\\n"
"      -D BUILD_WITH_DEBUG_INFO=OFF        \\\n"
"      -D OPENCV_GENERATE_PKGCONFIG=ON     \\\n"
"      -D CMAKE_POLICY_VERSION_MINIMUM=3.5 \\\n"
"      -W no-dev  ..                       &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr        \\\n"
"      -D CMAKE_BUILD_TYPE=Release         \\\n"
"      -D ENABLE_CXX11=ON                  \\\n"
"      -D BUILD_PERF_TESTS=OFF             \\\n"
"      -D WITH_XINE=ON                     \\\n"
"      -D BUILD_TESTS=OFF                  \\\n"
"      -D ENABLE_PRECOMPILED_HEADERS=OFF   \\\n"
"      -D CMAKE_SKIP_INSTALL_RPATH=ON      \\\n"
"      -D BUILD_WITH_DEBUG_INFO=OFF        \\\n"
"      -D OPENCV_GENERATE_PKGCONFIG=ON     \\\n"
"      -D CMAKE_POLICY_VERSION_MINIMUM=3.5 \\\n"
"      -W no-dev  ..                       &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/opencv.xml:189
#, xml-text
msgid "The package does not come with a test suite."
msgstr "O pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/opencv.xml:193
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/graphlib/opencv.xml:196
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/graphlib/opencv.xml:201
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/opencv.xml:210
#, xml-text
msgid ""
"<parameter>-D WITH_XINE=ON</parameter>: This switch instructs the make "
"procedure to use <xref linkend=\"xine-lib\"/>."
msgstr ""
"<parameter>-D WITH_XINE=ON</parameter>: Essa chave instrui o procedimento "
"make a usar <xref linkend=\"xine-lib\"/>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/opencv.xml:215
#, xml-text
msgid ""
"<parameter>-D ENABLE_PRECOMPILED_HEADERS=OFF</parameter>: This switch is "
"needed for compatibility with gcc-6.1 and later."
msgstr ""
"<parameter>-D ENABLE_PRECOMPILED_HEADERS=OFF</parameter>: Essa chave é "
"necessária para compatibilidade com gcc-6.1 e posteriores."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/opencv.xml:220
#, xml-text
msgid ""
"<parameter>-D OPENCV_GENERATE_PKGCONFIG=ON</parameter>: This switch tells "
"the build system to generate a pkg-config file for other packages to detect "
"and link to the libraries installed by this package."
msgstr ""
"<parameter>-D OPENCV_GENERATE_PKGCONFIG=ON</parameter>: Essa chave informa "
"ao sistema de construção para gerar um arquivo pkg-config para outros "
"pacotes detectarem e se vincularem às bibliotecas instaladas por este "
"pacote."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/opencv.xml:226
#, xml-text
msgid ""
"<option>-D OPENCV_EXTRA_MODULES_PATH=../opencv_contrib-&opencv-"
"version;/modules</option>: instructs the build system to build additional "
"modules. Some packages in BLFS (such as <xref linkend=\"gst10-plugins-bad\" "
"role=\"nodep\"/>) need these modules to build components that use OpenCV."
msgstr ""
"<option>-D OPENCV_EXTRA_MODULES_PATH=../opencv_contrib-&opencv-"
"version;/modules</option>: instrui o sistema de construção a construir "
"módulos adicionais. Alguns pacotes no BLFS (como <xref "
"linkend=\"gst10-plugins-bad\" role=\"nodep\"/>) precisam desses módulos para"
" construir componentes que usam OpenCV."

