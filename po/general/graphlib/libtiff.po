#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/graphlib/libtiff.xml:104
#, xml-text
msgid "Installation of libtiff"
msgstr "Instalação do libtiff"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/libtiff.xml:115
#, xml-text
msgid ""
"Install <application>libtiff</application> by running the following "
"commands:"
msgstr ""
"Instale <application>libtiff</application> executando os seguintes comandos:"

#.  "build" exists in the source tree
#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/graphlib/libtiff.xml:120
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir -p libtiff-build &amp;&amp;\n"
"cd       libtiff-build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_DOCDIR=/usr/share/doc/libtiff-&libtiff-version; \\\n"
"      -D CMAKE_INSTALL_PREFIX=/usr -G Ninja .. &amp;&amp;\n"
"ninja</userinput>"
msgstr ""
"<userinput>mkdir -p libtiff-build &amp;&amp;\n"
"cd       libtiff-build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_DOCDIR=/usr/share/doc/libtiff-&libtiff-version; \\\n"
"      -D CMAKE_INSTALL_PREFIX=/usr -G Ninja .. &amp;&amp;\n"
"ninja</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/libtiff.xml:128
#, xml-text
msgid "To test the results, issue: <command>ninja test</command>."
msgstr "Para testar os resultados, emita: <command>ninja test</command>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/libtiff.xml:132
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/graphlib/libtiff.xml:136
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr "<userinput>ninja install</userinput>"

