#, xml-text
msgid ""
"decompresses image files from JPEG/JFIF format to either PPM (PBMPLUS color "
"format), PGM (PBMPLUS gray-scale format), BMP, or Targa format"
msgstr ""
"descomprime arquivos de imagem do formato \"JPEG/JFIF\" para ou \"PPM\" "
"(formato de cores \"PBMPLUS\"), \"PGM\" (formato de escala de cinza "
"\"PBMPLUS\"), \"BMP\" ou formato \"Targa\""

