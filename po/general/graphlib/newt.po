#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/graphlib/newt.xml:118
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/newt.xml:121
#, xml-text
msgid ""
"<command>sed -e ... -i Makefile.in</command>: Disables installation of a "
"static library."
msgstr ""
"<command>sed -e ... -i Makefile.in</command>: Desabilita a instalação de uma"
" biblioteca estática."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/newt.xml:126
#, xml-text
msgid ""
"<parameter>--with-gpm-support</parameter>: This switch enables mouse support"
" for newt applications through GPM."
msgstr ""
"<parameter>--with-gpm-support</parameter>: Essa chave habilita o suporte de "
"mouse para aplicativos \"newt\" por meio do \"GPM\"."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/newt.xml:131
#, xml-text
msgid ""
"<parameter>--with-python=python&python3-majorver;</parameter>: By giving "
"explicitly the name of the directory where python modules reside, this "
"switch prevents building the python2 module."
msgstr ""
"<parameter>--with-python=python&python3-majorver;</parameter>: Ao fornecer "
"explicitamente o nome do diretório onde residem os módulos Python, essa "
"chave impede a construção do módulo \"python2\"."

