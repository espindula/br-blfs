#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/graphlib/newt.xml:88
#, xml-text
msgid "Installation of newt"
msgstr "Instalação do newt"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/newt.xml:91
#, xml-text
msgid ""
"Install <application>newt</application> by running the following command:"
msgstr ""
"Instale <application>newt</application> executando o seguinte comando:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/graphlib/newt.xml:95
#, no-wrap, xml-text
msgid ""
"<userinput>sed -e '/install -m 644 $(LIBNEWT)/ s/^/#/' \\\n"
"    -e '/$(LIBNEWT):/,/rv/ s/^/#/'          \\\n"
"    -e 's/$(LIBNEWT)/$(LIBNEWTSH)/g'        \\\n"
"    -i Makefile.in                          &amp;&amp;\n"
"\n"
"./configure --prefix=/usr           \\\n"
"            --with-gpm-support      \\\n"
"            --with-python=python&python3-majorver; &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>sed -e '/install -m 644 $(LIBNEWT)/ s/^/#/' \\\n"
"    -e '/$(LIBNEWT):/,/rv/ s/^/#/'         \\\n"
"    -e 's/$(LIBNEWT)/$(LIBNEWTSH)/g'        \\\n"
"    -i Makefile.in                          &amp;&amp;\n"
"\n"
"./configure --prefix=/usr           \\\n"
"            --with-gpm-support      \\\n"
"            --with-python=python&python3-majorver; &amp;&amp;\n"
"make</userinput>"

