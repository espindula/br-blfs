#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/graphite2.xml:125
#, xml-text
msgid ""
"Some tests fail if <ulink "
"url=\"https://pypi.python.org/pypi/FontTools\">FontTools</ulink> (Python 3 "
"module) is not installed. These tests can be removed with:"
msgstr ""
"Alguns testes falham se o <ulink "
"url=\"https://pypi.python.org/pypi/FontTools\">FontTools</ulink> (módulo "
"Python 3) não estiver instalado. Esses testes podem ser removidos com:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/graphlib/graphite2.xml:130
#, no-wrap, xml-text
msgid "<userinput>sed -i '/cmptest/d' tests/CMakeLists.txt</userinput>"
msgstr "<userinput>sed -i '/cmptest/d' tests/CMakeLists.txt</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/graphite2.xml:136
#, fuzzy, xml-text
#| msgid ""
#| "Fix building this package with CMake 4.0 by updating it's syntax to conform "
#| "to newer versions of CMake:"
msgid ""
"Fix building this package with CMake 4.0 by updating its syntax to conform "
"to newer versions of CMake:"
msgstr ""
"Corrija construir esse pacote com CMake 4.0 atualizando a sintaxe dele para "
"se conformar com versões mais recentes do CMake:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/graphlib/graphite2.xml:140
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"pre\">sed -i '/cmake_policy(SET CMP0012 NEW)/d' CMakeLists.txt &amp;&amp;\n"
"sed -i 's/PythonInterp/Python3/' CMakeLists.txt          &amp;&amp;\n"
"find . -name CMakeLists.txt | xargs sed -i 's/VERSION 2.8.0 FATAL_ERROR/VERSION 4.0.0/'</userinput>"
msgstr ""
"<userinput remap=\"pre\">sed -i '/cmake_policy(SET CMP0012 NEW)/d' CMakeLists.txt &amp;&amp;\n"
"sed -i 's/PythonInterp/Python3/' CMakeLists.txt          &amp;&amp;\n"
"find . -name CMakeLists.txt | xargs sed -i 's/VERSION 2.8.0 FATAL_ERROR/VERSION 4.0.0/'</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/graphite2.xml:145
#, xml-text
msgid "Now fix a problem when building with gcc-15:"
msgstr "Agora corrija um problema ao construir com gcc-15:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/graphlib/graphite2.xml:148
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"pre\">sed -i '/Font.h/i #include &lt;cstdint&gt;' "
"tests/featuremap/featuremaptest.cpp</userinput>"
msgstr ""
"<userinput remap=\"pre\">sed -i '/Font.h/i #include &lt;cstdint&gt;' "
"tests/featuremap/featuremaptest.cpp</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/graphite2.xml:151
#, xml-text
msgid ""
"Install <application>Graphite2</application> by running the following "
"commands:"
msgstr ""
"Instale <application>Graphite2</application> executando os seguintes "
"comandos:"

