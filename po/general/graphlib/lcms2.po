#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/graphlib/lcms2.xml:82
#, xml-text
msgid "Installation of Little CMS2"
msgstr "Instalação do Little CMS2"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/lcms2.xml:85
#, xml-text
msgid ""
"Install <application>Little CMS2</application> by running the following "
"commands:"
msgstr ""
"Instale <application>Little CMS2</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/graphlib/lcms2.xml:89
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr --disable-static &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>./configure --prefix=/usr --disable-static &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/lcms2.xml:93
#, xml-text
msgid "To test the results, issue: <command>make check</command>."
msgstr "Para testar os resultados, emita: <command>make check</command>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/lcms2.xml:97
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/graphlib/lcms2.xml:100
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

