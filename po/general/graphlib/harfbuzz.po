#. <sect1><sect2><variablelist><varlistentry><listitem><para>
#: blfs-en/general/graphlib/harfbuzz.xml:226
#, xml-text
msgid "is used for the conversion of text strings into positioned glyphs"
msgstr ""
"é usado para a conversão de sequências de caracteres de texto em glifos "
