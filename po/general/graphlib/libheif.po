#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/graphlib/libheif.xml:115
#, xml-text
msgid "Installation of libheif"
msgstr "Instalação do libheif"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/libheif.xml:118
#, xml-text
msgid ""
"First, fix building libheif if you are going to enable the SVT-AV1 encoder:"
msgstr ""
"Primeiro, corrija construir libheif se você for habilitar o codificador SVT-"
"AV1:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/graphlib/libheif.xml:122
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"pre\">patch -Np1 -i ../libheif-&libheif-"
"version;-svt_av1_build_fix-1.patch</userinput>"
msgstr ""
"<userinput remap=\"pre\">patch -Np1 -i ../libheif-&libheif-"
"version;-svt_av1_build_fix-1.patch</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/libheif.xml:125
#, xml-text
msgid ""
"Install <application>libheif</application> by running the following "
"commands:"
msgstr ""
"Instale <application>libheif</application> executando os seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/graphlib/libheif.xml:129
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr \\\n"
"      -D CMAKE_BUILD_TYPE=Release  \\\n"
"      -D WITH_GDK_PIXBUF=OFF       \\\n"
"      -D WITH_OpenH264_DECODER=OFF \\\n"
"      -G Ninja ..                  &amp;&amp;\n"
"ninja</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr \\\n"
"      -D CMAKE_BUILD_TYPE=Release  \\\n"
"      -D WITH_GDK_PIXBUF=OFF       \\\n"
"      -D WITH_OpenH264_DECODER=OFF \\\n"
"      -G Ninja ..                  &amp;&amp;\n"
"ninja</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/libheif.xml:140
#, xml-text
msgid "To test the results, issue: <command>ninja test</command>."
msgstr "Para testar os resultados, emita: <command>ninja test</command>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/libheif.xml:144
#, xml-text
msgid "Now, as the &root; user:"
msgstr "Agora, como o(a) usuário(a) &root;:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/graphlib/libheif.xml:147
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr "<userinput>ninja install</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/graphlib/libheif.xml:151
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/libheif.xml:154
#, xml-text
msgid ""
"<parameter>-D WITH_GDK_PIXBUF=OFF</parameter>: This option disables building"
" the gdk-pixbuf loader, as <xref linkend='gdk-pixbuf'/> is supposed to use "
"this package via <xref linkend='glycin'/> instead of the loader."
msgstr ""
"<parameter>-D WITH_GDK_PIXBUF=OFF</parameter>: Essa opção desabilita "
"construir o carregador gdk-pixbuf, pois é presumido que o <xref "
"linkend='gdk-pixbuf'/> use esse pacote via <xref linkend='glycin'/> em vez "
"de via carregador."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/libheif.xml:165
#, xml-text
msgid ""
"<option>-D WITH_DAV1D=ON</option>: This option allows using <xref "
"linkend='dav1d'/> to decode AV1 data in AVIF files."
msgstr ""
"<option>-D WITH_DAV1D=ON</option>: Essa opção permite usar <xref "
"linkend='dav1d'/> para decodificar dados AV1 em arquivos AVIF."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/libheif.xml:170
#, xml-text
msgid ""
"<option>-D WITH_FFMPEG_DECODER=ON</option>: This option allows using <xref "
"linkend='ffmpeg'/> to decode H.265 data in HEIC files."
msgstr ""
"<option>-D WITH_FFMPEG_DECODER=ON</option>: Essa opção permite usar o <xref "
"linkend='ffmpeg'/> para decodificar dados H.265 em arquivos HEIC."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/libheif.xml:175
#, xml-text
msgid ""
"<option>-D WITH_JPEG_ENCODER=ON -D WITH_JPEG_DECODER=ON</option>: These "
"options allow using <xref linkend='libjpeg'/> to encode and decode HEIF "
"files with JPEG data."
msgstr ""
"<option>-D WITH_JPEG_ENCODER=ON -D WITH_JPEG_DECODER=ON</option>: Essas "
"opções permitem usar a <xref linkend='libjpeg'/> para codificar e "
"decodificar arquivos HEIF com dados JPEG."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/libheif.xml:181
#, xml-text
msgid ""
"<option>-D WITH_OpenJPEG_ENCODER=ON -D WITH_OpenJPEG_DECODER=ON</option>: "
"These options allow using <xref linkend='openjpeg2'/> to encode and decode "
"HEIF files with JPEG 2000 data."
msgstr ""
"<option>-D WITH_OpenJPEG_ENCODER=ON -D WITH_OpenJPEG_DECODER=ON</option>: "
"Essas opções permitem usar o <xref linkend='openjpeg2'/> para codificar e "
"decodificar arquivos HEIF com dados JPEG 2000."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/libheif.xml:187
#, xml-text
msgid ""
"<option>-D WITH_SvtEnc=ON</option>: This option allows using <xref "
"linkend='svt-av1'/> to encode AV1 data for AVIF files."
msgstr ""
"<option>-D WITH_SvtEnc=ON</option>: Essa opção permite usar <xref "
"linkend='svt-av1'/> para codificar dados AV1 para arquivos AVIF."

