#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/graphlib/pdfio.xml:78
#, xml-text
msgid "Installation of pdfio"
msgstr "Instalação do pdfio"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/pdfio.xml:81
#, xml-text
msgid ""
"Install <application>pdfio</application> by running the following commands:"
msgstr ""
"Instale <application>pdfio</application> executando os seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/graphlib/pdfio.xml:85
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr    \\\n"
"            --disable-static \\\n"
"            --enable-shared  &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>./configure --prefix=/usr    \\\n"
"            --disable-static \\\n"
"            --enable-shared  &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/pdfio.xml:91
#, xml-text
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/pdfio.xml:95
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr "Agora, como o(a) usante <systemitem class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/graphlib/pdfio.xml:98
#, no-wrap, xml-text
msgid ""
"<userinput>make install &amp;&amp;\n"
"mv -v /usr/share/doc/pdfio{,-&pdfio-version;}\n"
"</userinput>"
msgstr ""
"<userinput>make install &amp;&amp;\n"
"mv -v /usr/share/doc/pdfio{,-&pdfio-version;}\n"
"</userinput>"

