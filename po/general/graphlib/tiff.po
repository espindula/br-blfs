#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/graphlib/tiff.xml:103
#, xml-text
msgid "Installation of tiff"
msgstr "Instalação do tiff"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/tiff.xml:114
#, xml-text
msgid ""
"Install <application>tiff</application> by running the following commands:"
msgstr ""
"Instale <application>tiff</application> executando os seguintes comandos:"

#.  "build" exists in the source tree
#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/graphlib/tiff.xml:119
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir -p tiff-build &amp;&amp;\n"
"cd       tiff-build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr \\\n"
"      -D CMAKE_BUILD_TYPE=Release  \\\n"
"      -W no-author -G Ninja ..\n"
"ninja</userinput>"
msgstr ""
"<userinput>mkdir -p tiff-build &amp;&amp;\n"
"cd       tiff-build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr \\\n"
"      -D CMAKE_BUILD_TYPE=Release  \\\n"
"      -W no-author -G Ninja ..\n"
"ninja</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/tiff.xml:128
#, xml-text
msgid "To test the results, issue: <command>ninja test</command>."
msgstr "Para testar os resultados, emita: <command>ninja test</command>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/tiff.xml:132
#, xml-text
msgid "Now, as the &root; user:"
msgstr "Agora, como o(a) usuário(a) &root;:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/graphlib/tiff.xml:135
#, no-wrap, xml-text
msgid ""
"<userinput>ninja install &amp;&amp;\n"
"mv -v /usr/share/doc/tiff{,-&tiff-version;}</userinput>"
msgstr ""
"<userinput>ninja install &amp;&amp;\n"
"mv -v /usr/share/doc/tiff{,-&tiff-version;}</userinput>"

