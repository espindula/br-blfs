#: blfs-en/general/graphlib/poppler.xml:125
#, xml-text
msgid ""
"<xref linkend=\"cmake\"/>, <xref linkend=\"fontconfig\"/>, and &gobject-"
"introspection;"
msgstr ""
"<xref linkend=\"cmake\"/>, <xref linkend=\"fontconfig\"/> e &gobject-"
"introspection;"

