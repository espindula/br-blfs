msgstr ""
"<xref linkend=\"boost\"/>, <xref linkend=\"cairo\"/>, <xref "
"linkend=\"gpgme\"/>, <xref linkend=\"lcms2\"/>, <xref linkend=\"libjpeg\"/>,"
" <xref linkend=\"libpng\"/>, <xref linkend=\"libtiff\"/>, <xref "
"linkend=\"nss\"/>, <xref linkend=\"openjpeg2\"/> e <xref linkend=\"qt6\"/> "
"(exigido para suporte PDF no <xref role=\"nodep\" linkend=\"okular\"/>)"

