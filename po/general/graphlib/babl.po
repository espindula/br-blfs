#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/graphlib/babl.xml:85
#, xml-text
msgid "Installation of Babl"
msgstr "Instalação do Babl"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/babl.xml:96
#, xml-text
msgid ""
"Install <application>Babl</application> by running the following commands:"
msgstr ""
"Instale <application>Babl</application> executando os seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/graphlib/babl.xml:99
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir bld &amp;&amp;\n"
"cd    bld &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr --buildtype=release .. &amp;&amp;\n"
"ninja</userinput>"
msgstr ""
"<userinput>mkdir bld &amp;&amp;\n"
"cd    bld &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr --buildtype=release .. &amp;&amp;\n"
"ninja</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/babl.xml:106
#, xml-text
msgid "To test the results, issue: <command>ninja test</command>."
msgstr "Para testar os resultados, emita: <command>ninja test</command>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/babl.xml:110
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/graphlib/babl.xml:113
#, no-wrap, xml-text
msgid ""
"<userinput>ninja install &amp;&amp;\n"
"\n"
"install -v -m755 -d                         /usr/share/gtk-doc/html/babl/graphics &amp;&amp;\n"
"install -v -m644 docs/*.{css,html}          /usr/share/gtk-doc/html/babl          &amp;&amp;\n"
"install -v -m644 docs/graphics/*.{html,svg} /usr/share/gtk-doc/html/babl/graphics</userinput>"
msgstr ""
"<userinput>ninja install &amp;&amp;\n"
"\n"
"install -v -m755 -d                        /usr/share/gtk-doc/html/babl/graphics &amp;&amp;\n"
"install -v -m644 docs/*.{css,html}          /usr/share/gtk-doc/html/babl          &amp;&amp;\n"
"install -v -m644 docs/graphics/*.{html,svg} /usr/share/gtk-doc/html/babl/graphics</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/graphlib/babl.xml:121
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/babl.xml:124
#, xml-text
msgid ""
"<command>install -v -m755 -d /usr/share/gtk-"
"doc/html/babl/graphics</command>: This and the subsequent commands install "
"the library html documentation under <filename "
"class=\"directory\">/usr/share/gtk-doc/html</filename> where other gtk "
"packages put the programmer-oriented documentation."
msgstr ""
"<command>install -v -m755 -d /usr/share/gtk-"
"doc/html/babl/graphics</command>: Esse e os comandos subsequentes instalam a"
" documentação html da biblioteca sob <filename class=\"directory\">/usr "
"/share/gtk-doc/html</filename> onde outros pacotes gtk colocam a "
"documentação orientada para o(a) programador(a)."

