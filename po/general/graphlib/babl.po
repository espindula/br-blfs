#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/babl.xml:29
#, xml-text
msgid ""
"The <application>Babl</application> package is a dynamic, any to any, pixel "
"format translation library."
msgstr ""
"O pacote <application>Babl</application> é uma biblioteca dinâmica de "
"tradução em formato de pixel, de qualquer para qualquer."

