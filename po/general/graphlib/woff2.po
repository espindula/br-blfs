msgstr "Instalação do WOFF2"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/woff2.xml:99
#, xml-text
msgid ""
"Install <application>WOFF2</application> by running the following commands:"
msgstr ""
"Instale <application>WOFF2</application> executando os seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/graphlib/woff2.xml:103
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir out                                 &amp;&amp;\n"
"cd    out                                 &amp;&amp;\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr        \\\n"
"      -D CMAKE_BUILD_TYPE=Release         \\\n"
"      -D CMAKE_POLICY_VERSION_MINIMUM=3.5 \\\n"
"      -D CMAKE_SKIP_INSTALL_RPATH=ON ..   &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>mkdir out                                 &amp;&amp;\n"
"cd    out                                 &amp;&amp;\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr        \\\n"
"      -D CMAKE_BUILD_TYPE=Release         \\\n"
"      -D CMAKE_POLICY_VERSION_MINIMUM=3.5 \\\n"
"      -D CMAKE_SKIP_INSTALL_RPATH=ON ..   &amp;&amp;\n"
"make</userinput>"

