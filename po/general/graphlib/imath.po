msgid "Introduction to Imath"
msgstr "Introdução ao Imath"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/imath.xml:28
#, xml-text
msgid ""
"<application>Imath</application> is a C++ and python library of 2D and 3D "
"vector, matrix, and math operations for computer graphics."
msgstr ""
"<application>Imath</application> é uma biblioteca em C++ e Python de "
"operações vetoriais, matriciais e matemáticas em 2D e 3D para computação "
"gráfica."

