#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/graphlib/imath.xml:84
#, xml-text
msgid "Installation of Imath"
msgstr "Instalação do Imath"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/imath.xml:87
#, xml-text
msgid ""
"Install <application>Imath</application> by running the following commands:"
msgstr ""
"Instale <application>Imath</application> executando os seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/graphlib/imath.xml:91
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr \\\n"
"      -D CMAKE_BUILD_TYPE=Release  \\\n"
"      -D PYTHON=ON                 \\\n"
"      ..  &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr \\\n"
"      -D CMAKE_BUILD_TYPE=Release  \\\n"
"      -D PYTHON=ON                 \\\n"
"      ..  &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/imath.xml:101
#, xml-text
msgid "To test the results, issue: <command>make test</command>."
msgstr "Para testar os resultados, emita: <command>make test</command>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/imath.xml:105
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr "Agora, como o(a) usante <systemitem class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/general/graphlib/imath.xml:108
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/general/graphlib/imath.xml:113
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/general/graphlib/imath.xml:116
#, xml-text
msgid ""
"<parameter>-D PYTHON=ON</parameter>: This option enables building the Python"
" modules.  It can be disabled if <xref linkend=\"numpy\"/> is not installed."
msgstr ""
"<parameter>-D PYTHON=ON</parameter>: Essa opção habilita construir os "
"módulos Python. Ela pode ser desabilitada se <xref linkend=\"numpy\"/> não "
"estiver instalado."

