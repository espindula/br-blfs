#. type: Content of: <sect1><sect2><title>
#: blfs-en/xfce/apps/xfce4-terminal.xml:88
#, xml-text
msgid "Installation of Xfce4 Terminal"
msgstr "Instalação do Terminal do Xfce4"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/xfce/apps/xfce4-terminal.xml:91
#, xml-text
msgid "First, prevent trying to use some commands from a package not in BLFS:"
msgstr ""
"Primeiro, evite tentar usar alguns comandos provenientes de um pacote não no"
" BLFS:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/xfce/apps/xfce4-terminal.xml:95
#, no-wrap, xml-text
msgid ""
"<userinput>sed -e '570i #ifdef HAVE_GTK_LAYER_SHELL' \\\n"
"    -e '574a #endif'                      \\\n"
"    -i  terminal/terminal-window-dropdown.c</userinput>"
msgstr ""
"<userinput>sed -e '570i #ifdef HAVE_GTK_LAYER_SHELL' \\\n"
"    -e '574a #endif'                      \\\n"
"    -i  terminal/terminal-window-dropdown.c</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/xfce/apps/xfce4-terminal.xml:100
#, xml-text
msgid ""
"Install <application>Xfce4 Terminal</application> by running the following "
"commands:"
msgstr ""
"Instale o <application>Terminal do Xfce4</application> executando os "
"seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/xfce/apps/xfce4-terminal.xml:104
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup ..      \\\n"
"      --prefix=/usr \\\n"
"      --buildtype=release &amp;&amp;\n"
"ninja</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup ..      \\\n"
"      --prefix=/usr \\\n"
"      --buildtype=release &amp;&amp;\n"
"ninja</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/xfce/apps/xfce4-terminal.xml:113
#, xml-text
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/xfce/apps/xfce4-terminal.xml:117
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/xfce/apps/xfce4-terminal.xml:120
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr "<userinput>ninja install</userinput>"

