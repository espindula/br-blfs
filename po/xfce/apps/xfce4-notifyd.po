#. type: Content of: <sect1><sect2><title>
#: blfs-en/xfce/apps/xfce4-notifyd.xml:90
#, xml-text
msgid "Installation of the Xfce4 Notification Daemon"
msgstr "Instalação do Processo de Segundo Plano de Notificação do Xfce4"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/xfce/apps/xfce4-notifyd.xml:93
#, xml-text
msgid ""
"Install the <application>Xfce4 Notification Daemon</application> by running "
"the following commands:"
msgstr ""
"Instale o <application>Processo de Segundo Plano de Notificação do "
"Xfce4</application> executando os seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/xfce/apps/xfce4-notifyd.xml:97
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr --sysconfdir=/etc &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>./configure --prefix=/usr --sysconfdir=/etc &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/xfce/apps/xfce4-notifyd.xml:100
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr     \\\n"
"            --sysconfdir=/etc \\\n"
"            --disable-systemd &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>./configure --prefix=/usr     \\\n"
"            --sysconfdir=/etc \\\n"
"            --disable-systemd &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/xfce/apps/xfce4-notifyd.xml:106
#, xml-text
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/xfce/apps/xfce4-notifyd.xml:110
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/xfce/apps/xfce4-notifyd.xml:113
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/xfce/apps/xfce4-notifyd.xml:116
#, xml-text
msgid ""
"You can test the notification daemon with the command <command>notify-"
"send</command>, to be run in a graphical environment:"
msgstr ""
"Você pode testar o processo de segundo plano de notificação com o comando "
"<command>notify-send</command>, para ser executado em um ambiente gráfico:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/xfce/apps/xfce4-notifyd.xml:121
#, no-wrap, xml-text
msgid ""
"<userinput>notify-send -i info Information \"Hi ${USER}, This is a "
"Test\"</userinput>"
msgstr ""
"<userinput>notify-send -i info Information \"Olá ${USER}; Isto é um "
"Teste\"</userinput>"

