#. type: Content of: <sect1><sect2><title>
#: blfs-en/xfce/core/libxfce4windowing.xml:88
#, xml-text
msgid "Installation of libxfce4windowing"
msgstr "Instalação do libxfce4windowing"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/xfce/core/libxfce4windowing.xml:91
#, xml-text
msgid ""
"Install <application>libxfce4windowing</application> by running the "
"following commands:"
msgstr ""
"Instale <application>libxfce4windowing</application> executando os seguintes"
" comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/xfce/core/libxfce4windowing.xml:95
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr     \\\n"
"            --sysconfdir=/etc \\\n"
"            --enable-x11      \\\n"
"            --disable-debug   &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>./configure --prefix=/usr     \\\n"
"            --sysconfdir=/etc \\\n"
"            --enable-x11      \\\n"
"            --disable-debug   &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/xfce/core/libxfce4windowing.xml:102
#, xml-text
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/xfce/core/libxfce4windowing.xml:106
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr "Agora, como o(a) usante <systemitem class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/xfce/core/libxfce4windowing.xml:109
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

