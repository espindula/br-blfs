#, xml-text
msgid "Introduction to libxfce4windowing"
msgstr "Introdução ao libxfce4windowing"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/xfce/core/libxfce4windowing.xml:30
#, xml-text
msgid ""
"The <application>libxfce4windowing</application> package contains a "
"windowing concept abstraction library for X11 and Wayland."
msgstr ""
"O pacote <application>libxfce4windowing</application> contém uma biblioteca "
"de abstração de conceito de janelas para X11 e Wayland."

