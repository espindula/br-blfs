msgstr "Xfconf"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/xfce/core/xfconf.xml:27
#, xml-text
msgid "Introduction to Xfconf"
msgstr "Introdução ao Xfconf"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/xfce/core/xfconf.xml:30
#, xml-text
msgid ""
"<application>Xfconf</application> is the configuration storage system for "
"<application>Xfce</application>."
msgstr ""
"<application>Xfconf</application> é o sistema de armazenamento de "
"configuração para o <application>Xfce</application>."

#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/xfce/core/xfconf.xml:36
#, xml-text
msgid "Package Information"
msgstr "Informação do Pacote"

#. type: Content of: <sect1><sect2><itemizedlist><listitem><para>
#: blfs-en/xfce/core/xfconf.xml:40
#, xml-text
msgid "Download (HTTP): <ulink url=\"&xfconf-download-http;\"/>"
msgstr "Transferência (HTTP): <ulink url=\"&xfconf-download-http;\"/>"

#. type: Content of: <sect1><sect2><itemizedlist><listitem><para>
#: blfs-en/xfce/core/xfconf.xml:45
#, xml-text
msgid "Download (FTP): <ulink url=\"&xfconf-download-ftp;\"/>"
msgstr "Transferência (FTP): <ulink url=\"&xfconf-download-ftp;\"/>"

#. type: Content of: <sect1><sect2><itemizedlist><listitem><para>
#: blfs-en/xfce/core/xfconf.xml:50
#, xml-text
msgid "Download MD5 sum: &xfconf-md5sum;"
msgstr "Soma de verificação MD5 da transferência: &xfconf-md5sum;"

#. type: Content of: <sect1><sect2><itemizedlist><listitem><para>
#: blfs-en/xfce/core/xfconf.xml:55
#, xml-text
msgid "Download size: &xfconf-size;"
msgstr "Tamanho da transferência: &xfconf-size;"

#. type: Content of: <sect1><sect2><itemizedlist><listitem><para>
#: blfs-en/xfce/core/xfconf.xml:60
#, xml-text
msgid "Estimated disk space required: &xfconf-buildsize;"
msgstr "Espaço em disco estimado exigido: &xfconf-buildsize;"

#. type: Content of: <sect1><sect2><itemizedlist><listitem><para>
#: blfs-en/xfce/core/xfconf.xml:65
#, xml-text
msgid "Estimated build time: &xfconf-time;"
msgstr "Tempo de construção estimado: &xfconf-time;"

#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/xfce/core/xfconf.xml:70
#, xml-text
msgid "Xfconf Dependencies"
msgstr "Dependências do Xfconf"

#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/xfce/core/xfconf.xml:72
#, xml-text
msgid "Required"
msgstr "Exigidas"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/xfce/core/xfconf.xml:74
#, xml-text
msgid "<xref linkend=\"libxfce4util\"/>"
msgstr "<xref linkend=\"libxfce4util\"/>"

#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/xfce/core/xfconf.xml:77
#, xml-text
msgid "Optional"
msgstr "Opcionais"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/xfce/core/xfconf.xml:79
#, xml-text
msgid "<xref linkend=\"gtk-doc\"/> and <xref linkend=\"vala\"/>"
msgstr "<xref linkend=\"gtk-doc\"/> e <xref linkend=\"vala\"/>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/xfce/core/xfconf.xml:86
#, xml-text
msgid "Installation of Xfconf"
msgstr "Instalação do Xfconf"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/xfce/core/xfconf.xml:89
#, xml-text
msgid ""
"Install <application>Xfconf</application> by running the following commands:"
msgstr ""
"Instale o <application>Xfconf</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/xfce/core/xfconf.xml:93
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>./configure --prefix=/usr &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/xfce/core/xfconf.xml:97
#, xml-text
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/xfce/core/xfconf.xml:101
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr "Agora, como o(a) usante <systemitem class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/xfce/core/xfconf.xml:104
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

