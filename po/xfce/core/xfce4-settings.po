#. type: Content of: <sect1><sect2><title>
#: blfs-en/xfce/core/xfce4-settings.xml:101
#, xml-text
msgid "Installation of Xfce4 Settings"
msgstr "Instalação do Xfce4 Settings"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/xfce/core/xfce4-settings.xml:104
#, xml-text
msgid ""
"Install <application>Xfce4 Settings</application> by running the following "
"commands:"
msgstr ""
"Instale o <application>Xfce4 Settings</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/xfce/core/xfce4-settings.xml:108
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr --sysconfdir=/etc &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>./configure --prefix=/usr --sysconfdir=/etc &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/xfce/core/xfce4-settings.xml:112
#, xml-text
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/xfce/core/xfce4-settings.xml:116
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/xfce/core/xfce4-settings.xml:119
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/xfce/core/xfce4-settings.xml:124
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/xfce/core/xfce4-settings.xml:127
#, xml-text
msgid ""
"<option>--enable-sound-settings</option>: Use this switch to enable sound "
"settings in GUI."
msgstr ""
"<option>--enable-sound-settings</option>: Use essa chave para habilitar as "
"configurações de som na GUI."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/xfce/core/xfce4-settings.xml:132
#, xml-text
msgid ""
"<option>--enable-pluggable-dialogs</option>: Use this switch to enable "
"support for embedded settings dialogs."
msgstr ""
"<option>--enable-pluggable-dialogs</option>: Use essa chave para habilitar o"
" suporte para caixas de diálogo de configurações incorporadas."

