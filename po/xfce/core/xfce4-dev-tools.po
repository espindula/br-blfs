#. type: Content of: <sect1><sect2><title>
#: blfs-en/xfce/core/xfce4-dev-tools.xml:80
#, xml-text
msgid "Installation of the Xfce4 Development Tools"
msgstr "Instalação do the Xfce4 Development Tools"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/xfce/core/xfce4-dev-tools.xml:83
#, xml-text
msgid ""
"Install the <application>Xfce4 Development Tools</application> by running "
"the following commands:"
msgstr ""
"Instale as <application>Ferramentas de Desenvolvimento do "
"Xfce4</application> executando os seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/xfce/core/xfce4-dev-tools.xml:87
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>./configure --prefix=/usr &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/xfce/core/xfce4-dev-tools.xml:91
#, xml-text
msgid "To test the results, issue: <command>make check</command>."
msgstr "Para testar os resultados, emita: <command>make check</command>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/xfce/core/xfce4-dev-tools.xml:95
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr "Agora, como o(a) usante <systemitem class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/xfce/core/xfce4-dev-tools.xml:98
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

