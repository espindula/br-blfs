#. type: Content of: <sect1><sect2><title>
#: blfs-en/xfce/core/xfce4-dev-tools.xml:27
#, xml-text
msgid "Introduction to the Xfce4 Development Tools"
msgstr "Introdução ao the Xfce4 Development Tools"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/xfce/core/xfce4-dev-tools.xml:30
#, xml-text
msgid ""
"The <application>Xfce4 Development Tools</application> are a collection of "
"tools and macros for building some Xfce applications."
msgstr ""
"As <application>Ferramentas de Desenvolvimento do Xfce4</application> são "
"uma coleção de ferramentas e macros para construir algumas aplicações do "
"Xfce."

