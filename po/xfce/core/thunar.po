#. type: Content of: <sect1><sect2><title>
#: blfs-en/xfce/core/thunar.xml:27
#, xml-text
msgid "Introduction to thunar"
msgstr "Introdução ao thunar"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/xfce/core/thunar.xml:30
#, xml-text
msgid ""
"<application>Thunar</application> is the <application>Xfce</application> "
"file manager, a <application>GTK+ 3</application> GUI to organise the files "
"on your computer."
msgstr ""
"<application>Thunar</application> é o gerenciador de arquivos do "
"<application>Xfce</application>, uma GUI do <application>GTK+ "
"3</application> para organizar os arquivos em teu computador."

