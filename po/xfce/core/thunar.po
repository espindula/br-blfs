#. type: Content of:
#. <sect1><sect2><variablelist><varlistentry><listitem><para>
#: blfs-en/xfce/core/thunar.xml:195
#, xml-text
msgid ""
"is a shell script that launches a dialog box to allow you to alter the "
"behavior of <application>Thunar</application>"
msgstr ""
"é um conjunto de comandos sequenciais de shell que abre uma caixa de diálogo"
" para permitir que você altere o comportamento do "
"<application>Thunar</application>"

#. type: Content of:
#. <sect1><sect2><variablelist><varlistentry><listitem><indexterm><primary>
#: blfs-en/xfce/core/thunar.xml:199
