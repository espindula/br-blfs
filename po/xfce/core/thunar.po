#, xml-text
msgid ""
"contains the <application>Thunar</application> extension library which "
"permits adding new features to the <application>Thunar</application> file "
"manager"
msgstr ""
"contém a biblioteca de extensão do <application>Thunar</application> que "
"permite adicionar novos recursos ao gerenciador de arquivos "
"<application>Thunar</application>"

