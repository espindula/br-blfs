#. type: Content of:
#. <sect1><sect2><variablelist><varlistentry><listitem><indexterm><primary>
#: blfs-en/xfce/core/thunar.xml:151 blfs-en/xfce/core/thunar.xml:213
#, xml-text
msgid "libthunarx-3.so"
msgstr "libthunarx-3.so"

#.  installed earlier (by xfconf presumably) /usr/lib/xfce4,
#. ,
#. installed by libxfce4util          /usr/share/xfce4
#. type: Content of: <sect1><sect2><segmentedlist><seglistitem><seg>
#: blfs-en/xfce/core/thunar.xml:161
#, xml-text
msgid ""
"/etc/xdg/Thunar, /usr/include/thunarx-3, /usr/lib/Thunar, "
"/usr/lib/thunarx-3, /usr/share/Thunar, /usr/share/doc/thunar-&thunar-"
"version;, and /usr/share/gtk-doc/html/thunarx"
msgstr ""
"/etc/xdg/Thunar, /usr/include/thunarx-3, /usr/lib/Thunar, "
"/usr/lib/thunarx-3, /usr/share/Thunar, /usr/share/doc/thunar-&thunar-"
"version; e /usr/share/gtk-doc/html/thunarx"

