#. type: Content of: <sect1><sect2><title>
#: blfs-en/xfce/core/garcon.xml:27
#, xml-text
msgid "Introduction to Garcon"
msgstr "Introdução ao Garcon"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/xfce/core/garcon.xml:30
#, xml-text
msgid ""
"The <application>Garcon</application> package contains a freedesktop.org "
"compliant menu implementation based on <application>GLib</application> and "
"<application>GIO</application>."
msgstr ""
"O pacote <application>Garcon</application> contém uma implementação de menu "
"compatível com freedesktop.org baseada em <application>GLib</application> e "
"<application>GIO</application>."

