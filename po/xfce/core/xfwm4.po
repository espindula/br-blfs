#. type: Content of: <sect1><sect2><title>
#: blfs-en/xfce/core/xfwm4.xml:88
#, xml-text
msgid "Installation of Xfwm4"
msgstr "Instalação do Xfwm4"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/xfce/core/xfwm4.xml:91
#, xml-text
msgid ""
"Install <application>Xfwm4</application> by running the following commands:"
msgstr ""
"Instale o <application>Xfwm4</application> executando os seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/xfce/core/xfwm4.xml:95
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>./configure --prefix=/usr &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/xfce/core/xfwm4.xml:99
#, xml-text
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/xfce/core/xfwm4.xml:103
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/xfce/core/xfwm4.xml:106
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

