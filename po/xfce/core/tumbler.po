#. type: Content of: <sect1><sect2><title>
#: blfs-en/xfce/core/tumbler.xml:27
#, xml-text
msgid "Introduction to tumbler"
msgstr "Introdução ao tumbler"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/xfce/core/tumbler.xml:30
#, xml-text
msgid ""
"The <application>Tumbler</application> package contains a "
"<application>D-Bus</application> thumbnailing service based on the thumbnail"
" management <application>D-Bus</application> specification.  This is useful "
"for generating thumbnail images of files."
msgstr ""
"O pacote <application>Tumbler</application> contém um serviço de miniaturas "
"do <application>D-Bus</application> baseado na especificação de "
"gerenciamento de miniaturas do <application>D-Bus</application>. Isso é útil"
" para gerar imagens em miniatura de arquivos."

