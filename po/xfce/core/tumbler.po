#. type: Content of: <sect1><sect2><title>
#: blfs-en/xfce/core/tumbler.xml:98
#, xml-text
msgid "Installation of Tumbler"
msgstr "Instalação do Tumbler"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/xfce/core/tumbler.xml:101
#, xml-text
msgid ""
"Install <application>Tumbler</application> by running the following "
"commands:"
msgstr ""
"Instale o <application>Tumbler</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/xfce/core/tumbler.xml:105
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr --sysconfdir=/etc &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>./configure --prefix=/usr --sysconfdir=/etc &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/xfce/core/tumbler.xml:109
#, xml-text
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/xfce/core/tumbler.xml:113
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/xfce/core/tumbler.xml:116
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/xfce/core/tumbler.xml:119
#, xml-text
msgid "Finally, remove a systemd unit which is useless on a SysV system:"
msgstr ""
"Finalmente, remova uma unidade do systemd que é inútil em um sistema SysV:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/xfce/core/tumbler.xml:122
#, no-wrap, xml-text
msgid "<userinput>rm -fv /usr/lib/systemd/user/tumblerd.service</userinput>"
msgstr "<userinput>rm -fv /usr/lib/systemd/user/tumblerd.service</userinput>"

