#. type: Content of: <sect1><sect2><title>
#: blfs-en/xfce/core/xfce4-appfinder.xml:27
#, xml-text
msgid "Introduction to Xfce4 Appfinder"
msgstr "Introdução ao Xfce4 Appfinder"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/xfce/core/xfce4-appfinder.xml:30
#, xml-text
msgid ""
"<application>Xfce4 Appfinder</application> is a tool to find and launch "
"installed applications by searching the .desktop files installed on your "
"system."
msgstr ""
"<application>Xfce4 Appfinder</application> é uma ferramenta para encontrar e"
" iniciar aplicativos instalados pesquisando os arquivos .desktop instalados "
"em teu sistema."

