msgstr "Instalação do Xfdesktop"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/xfce/core/xfdesktop.xml:95
#, xml-text
msgid ""
"Install <application>Xfdesktop</application> by running the following "
"commands:"
msgstr ""
"Instale o <application>Xfdesktop</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/xfce/core/xfdesktop.xml:99
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>./configure --prefix=/usr &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/xfce/core/xfdesktop.xml:103
