#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/xsoft/other/transmission.xml:119
#, xml-text
msgid "Installation of Transmission"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/xsoft/other/transmission.xml:122
#, xml-text
msgid ""
"First, fix a build failure due to incorrect statements in CMakeLists.txt:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/xsoft/other/transmission.xml:125
#, no-wrap, xml-text
msgid ""
"<userinput>patch -Np1 -i ../transmission-&transmission-"
"version;-build_fix-1.patch</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/xsoft/other/transmission.xml:128
#, xml-text
msgid "Next, adapt two of the third-party modules to changes in CMake 4.0:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/xsoft/other/transmission.xml:131
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"pre\">sed -e 's/2.8/4.0/' -i third-party/dht/CMakeLists.txt \\\n"
"                       third-party/libnatpmp/CMakeLists.txt</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/xsoft/other/transmission.xml:134
#, xml-text
msgid ""
"Install <application>Transmission</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/xsoft/other/transmission.xml:138
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr \\\n"
"      -D CMAKE_BUILD_TYPE=Release  \\\n"
"      -D CMAKE_INSTALL_DOCDIR=/usr/share/doc/transmission-&transmission-version; \\\n"
"      .. &amp;&amp;\n"
"\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/xsoft/other/transmission.xml:150
#, xml-text
msgid "Now, as the &root; user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/xsoft/other/transmission.xml:153
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/xsoft/other/transmission.xml:156
#, xml-text
msgid ""
"Next, if the <xref linkend=\"gtkmm4\"/> dependency was installed, create "
"transmission.png from the SVG file. As the &root; user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/xsoft/other/transmission.xml:160
#, no-wrap, xml-text
msgid ""
"<userinput>rsvg-convert                                               \\\n"
"   /usr/share/icons/hicolor/scalable/apps/transmission.svg \\\n"
"   -o /usr/share/pixmaps/transmission.png</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/xsoft/other/transmission.xml:167
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/xsoft/other/transmission.xml:170
#, xml-text
msgid ""
"<option>-D ENABLE_QT=OFF</option>: This switch disables building the "
"<application>Qt</application> interface. The default is to build it if <xref"
" linkend=\"qt6\"/> is installed."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/xsoft/other/transmission.xml:176
#, xml-text
msgid ""
"<option>-D ENABLE_GTK=OFF</option>: This switch disables building the GTK-4 "
"interface. The default is to build it if <xref linkend=\"gtkmm4\"/> is "
"installed."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/xsoft/other/transmission.xml:182
#, xml-text
msgid ""
"<option>-D ENABLE_WEB=OFF</option>: This switch disables building the web "
"client. The default is to build it if <xref linkend=\"nodejs\"/> is "
"installed."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/xsoft/other/transmission.xml:188
#, xml-text
msgid ""
"<option>-D REBUILD_WEB=ON</option>: This switch forces rebuilding the web "
"client. This option needs <xref linkend=\"nodejs\"/> to be installed as well"
" as an internet connection. The default is to not rebuild the client."
msgstr ""

