#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/xsoft/other/xarchiver.xml:107
#, xml-text
msgid "Installation of xarchiver"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/xsoft/other/xarchiver.xml:110
#, xml-text
msgid ""
"BLFS provides <command>unzip</command> as a symlink to "
"<command>bsdunzip</command> from <xref linkend='libarchive'/>, but it "
"doesn't work for xarchiver.  Adapt xarchiver to use <xref linkend='seven-"
"zip'/> for handling <filename class='extension'>.zip</filename> files by "
"default instead:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/xsoft/other/xarchiver.xml:117
#, no-wrap, xml-text
msgid ""
"<userinput>sed '/TOGGLE.*prefer_unzip/s/TRUE/FALSE/' -i "
"src/pref_dialog.c</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><note><para>
#: blfs-en/blfs-git/xsoft/other/xarchiver.xml:121
#, xml-text
msgid ""
"If you've already installed and run this package before (maybe in another "
"distro if your <filename class='directory'>/home</filename> is a partition "
"shared with that distro), it's likely already configured to prefer "
"<command>unzip</command>.  Unset the <quote>Prefer unzip for zip "
"files</quote> checkbox in the <quote>Action => Preferences</quote> dialog to"
" change the configuration."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/xsoft/other/xarchiver.xml:133
#, xml-text
msgid ""
"Install <application>xarchiver</application> by running the following "
"commands:"
msgstr ""

#.  Previously there was a command here to run ./autogen.sh.
#.      With 0.5.4.15, the download that I had included the
#.      configure script and the rest of the build machinery with it.
#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/xsoft/other/xarchiver.xml:140
#, no-wrap, xml-text
msgid ""
"<userinput>./configure  --prefix=/usr               \\\n"
"             --libexecdir=/usr/lib/xfce4 \\\n"
"             --docdir=/usr/share/doc/xarchiver-&xarchiver-version; &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/xsoft/other/xarchiver.xml:146
#, xml-text
msgid "This package does not come with a test suite."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/xsoft/other/xarchiver.xml:150
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/xsoft/other/xarchiver.xml:153
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/xsoft/other/xarchiver.xml:161
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/xsoft/other/xarchiver.xml:164
#, xml-text
msgid ""
"<parameter>--libexecdir=/usr/lib/xfce4</parameter>: This switch fixes the "
"location for the thunar-archive-plugin, so it will work if <xref "
"linkend=\"thunar\"/> is installed."
msgstr ""

