#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/xsoft/other/feh.xml:133
#, xml-text
msgid "Installation of feh"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/xsoft/other/feh.xml:147
#, xml-text
msgid ""
"Install <application>feh</application> by running the following commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/xsoft/other/feh.xml:150
#, no-wrap, xml-text
msgid ""
"<userinput>sed -i \"s:doc/feh:&amp;-&feh-version;:\" config.mk &amp;&amp;\n"
"make PREFIX=/usr</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/xsoft/other/feh.xml:154
#, xml-text
msgid "To test the results, issue: <command>make test</command>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/xsoft/other/feh.xml:158
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/xsoft/other/feh.xml:161
#, no-wrap, xml-text
msgid "<userinput>make PREFIX=/usr install</userinput>"
msgstr ""

