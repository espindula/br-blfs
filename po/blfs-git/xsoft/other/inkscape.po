#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/blfs-git/xsoft/other/inkscape.xml:92
#, xml-text
msgid "Inkscape Dependencies"
msgstr ""

#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/blfs-git/xsoft/other/inkscape.xml:94
#, xml-text
msgid "Required"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/xsoft/other/inkscape.xml:96
#, xml-text
msgid ""
"<xref linkend=\"boost\"/>, <xref linkend=\"double-conversion\"/>, <xref "
"linkend=\"gc\"/>, <xref linkend=\"gsl\"/>, <xref linkend=\"gtkmm3\"/>, <xref"
" linkend=\"libxslt\"/>, <xref linkend=\"poppler\"/>, and <xref "
"linkend=\"popt\"/>"
msgstr ""

#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/blfs-git/xsoft/other/inkscape.xml:106
#, xml-text
msgid "Recommended"
msgstr ""

#.  Imagemagick is used for two different purposes:
#.            For raster extensions and image import resolution, Imagemagick
#.            libraries are needed but this requires Imagemagick 6:
#.            https://gitlab.com/inkscape/inkscape/-/issues/1294
#.            TODO: add Imagemagick 6 back or add GraphicsMagick, or port
#.                  inkscape to Imagemagick 7 API.
#.            For WebSlicer export to JPG or GIF, Imagemagick program
#.            "convert" is needed and this is only a runtime dependency.
#.  there might be others, or other needed dependencies:
#.        needs someone who knows how to use *all" the core extensions
#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/xsoft/other/inkscape.xml:116
#, xml-text
msgid ""
"<xref role=\"runtime\" linkend=\"imagemagick\"/> (runtime), <xref "
"linkend=\"lcms2\"/>, <xref linkend=\"libcanberra\"/> (to eliminate plugin "
"warnings), <xref linkend=\"potrace\"/> (for the bucket-fill tool), also "
"various Python modules at runtime for the core extensions: <xref "
"role=\"runtime\" linkend=\"cachecontrol\"/>, <xref role=\"runtime\" "
"linkend=\"cssselect\"/>, <xref role=\"runtime\" linkend=\"lxml\"/>, <xref "
"role=\"runtime\" linkend=\"numpy\"/>, <xref role=\"runtime\" "
"linkend=\"pyserial\"/>, and <xref role=\"runtime\" linkend=\"scour\"/>"
msgstr ""

#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/blfs-git/xsoft/other/inkscape.xml:131
#, xml-text
msgid "Optional"
msgstr ""

#.  these document foundation links work from firefox's address bar, or
#.       from google (pages telling you how to get it from git), but when I
#. link
#.       them here I get "There is currently no text in this page...". Ken or
#.       developer: wiki.documentfoundation.org pages don't like trailing /
#. <ulink url="https://wiki.documentfoundation.org/DLP/Libraries/libcdr">
#. libcdr</ulink>,
#.       <ulink
#. url="https://wiki.documentfoundation.org/DLP/Libraries/libvisio">libvisio</ulink>,
#. <ulink url="https://gtkspell.sourceforge.net">
#. gtkspell</ulink>,
#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/xsoft/other/inkscape.xml:133
#, xml-text
msgid ""
"<xref linkend=\"aspell\"/>, <xref linkend=\"dbus\"/> (to run inkscape from "
"scripts), <xref linkend=\"doxygen\"/>, <xref linkend=\"gspell\"/>, <ulink "
"url=\"https://sourceforge.net/projects/graphicsmagick\">GraphicsMagick</ulink>,"
" <ulink url=\"https://github.com/LibreOffice/libcdr\">libcdr</ulink>, <ulink"
" url=\"https://github.com/LibreOffice/libvisio\">libvisio</ulink>, <ulink "
"url=\"https://libwpg.sourceforge.net/\">libwpg</ulink> (or <ulink "
"url=\"https://libwpd.sourceforge.net/\">libwpd</ulink>)"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/xsoft/other/inkscape.xml:155
#, xml-text
msgid "Installation of Inkscape"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/xsoft/other/inkscape.xml:164
#, xml-text
msgid ""
"Install <application>Inkscape</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/xsoft/other/inkscape.xml:168
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build                       &amp;&amp;\n"
"cd    build                       &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr        \\\n"
"      -D CMAKE_BUILD_TYPE=Release         \\\n"
"      -W no-dev                           \\\n"
"      ..                                  &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/xsoft/other/inkscape.xml:191
#, xml-text
msgid "This package does not come with a working test suite."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/xsoft/other/inkscape.xml:195
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/xsoft/other/inkscape.xml:198
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/xsoft/other/inkscape.xml:206
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/xsoft/other/inkscape.xml:209
#, xml-text
msgid ""
"<parameter>-D CMAKE_BUILD_TYPE=Release</parameter>: This switch is used to "
"build the release library without any debug `assert` in the code."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/xsoft/other/inkscape.xml:214
#, xml-text
msgid ""
"<parameter>-W no-dev</parameter>: This parameter silences several warnings "
"only intended for project developers."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/xsoft/other/inkscape.xml:219
#, xml-text
msgid ""
"<option>-D WITH_DBUS=ON</option>: use this if you wish to use "
"<command>inkscape</command> in interactive scripts which manipulate images."
msgstr ""

