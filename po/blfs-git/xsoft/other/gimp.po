#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/xsoft/other/gimp.xml:180
#, xml-text
msgid "Installation of Gimp"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/xsoft/other/gimp.xml:183
#, xml-text
msgid ""
"If upgrading from a previous Gimp-3 installation, as the &root; user, remove"
" some files and directories from the old installation or the build system "
"may mistakenly pick them up, causing a build failure:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/xsoft/other/gimp.xml:188
#, no-wrap, xml-text
msgid ""
"<userinput>rm -rf /usr/{lib,share}/gimp/3.0 &amp;&amp;\n"
"rm -f  /usr/share/gir-1.0/Gimp-3.0.gir &amp;&amp;\n"
"rm -f  /usr/lib/girepository-1.0/Gimp-3.0.typelib &amp;&amp;\n"
"rm -f  /usr/lib/libgimp*-3.0.so*</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/xsoft/other/gimp.xml:194
#, xml-text
msgid ""
"Install <application>Gimp</application> by running the following commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/xsoft/other/gimp.xml:198
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir gimp-build &amp;&amp;\n"
"cd    gimp-build &amp;&amp;\n"
"\n"
"meson setup ..            \\\n"
"      --prefix=/usr       \\\n"
"      --buildtype=release \\\n"
"      -D headless-tests=disabled &amp;&amp;\n"
"ninja</userinput>"
msgstr ""

#. https://gitlab.gnome.org/GNOME/gimp/-/issues/14822
#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/xsoft/other/gimp.xml:210
#, xml-text
msgid ""
"To test the results (requires a terminal in a graphical environment)  issue:"
" <command>ninja test</command>. Three tests, <filename>gimp:app / save-and-"
"export</filename>, <filename>gimp:app / single-window-mode</filename>, and "
"<filename>gimp:app / ui</filename>, are known to fail."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/xsoft/other/gimp.xml:219
#, xml-text
msgid "Now, as the &root; user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/xsoft/other/gimp.xml:222
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/xsoft/other/gimp.xml:230
#, xml-text
msgid "Installation of Gimp-Help"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/xsoft/other/gimp.xml:233
#, xml-text
msgid ""
"The <filename>gimp-help</filename> tarball contains images and English text "
"help for help files, together with translations.  If you wish to install "
"local copies of the help files to read offline, unpack the gimp-help tarball"
" and change into the root of the newly created source tree."
msgstr ""

#. ca cs da de en en_GB es fa fr hr ko lt nl nn pt pt_BR ro sl sv uk zh_CN
#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/xsoft/other/gimp.xml:240
#, no-wrap, xml-text
msgid ""
"<userinput>tar -xf ../../gimp-help-&gimp-help-version;.tar.bz2 &amp;&amp;\n"
"cd gimp-help-&gimp-help-version;\n"
"\n"
"sed -i 's/import libxml2//' configure &amp;&amp;\n"
"\n"
"ALL_LINGUAS=&quot;en&quot; \\\n"
"./configure --prefix=/usr</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/xsoft/other/gimp.xml:256
#, xml-text
msgid ""
"Building non-English languages is only possible with the libxml2 Python 3 "
"module, which is deprecated and no longer enabled in the BLFS libxml2 build."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/xsoft/other/gimp.xml:262
#, xml-text
msgid "Now build the help files:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/xsoft/other/gimp.xml:265
#, no-wrap, xml-text
msgid "<userinput>make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/xsoft/other/gimp.xml:268
#, xml-text
msgid ""
"Issue the following commands as the &root; user to install the help files:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/xsoft/other/gimp.xml:271
#, no-wrap, xml-text
msgid ""
"<userinput>make install &amp;&amp;\n"
"chown -R root:root /usr/share/gimp/3.0/help</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/xsoft/other/gimp.xml:277
#, xml-text
msgid "Command Explanations"
msgstr ""

#.  xvfb-run is referred by the mutter package
#.       for testing.  But why the GIMP test doesn't like it on the local
#.       machine?  The upstream CI uses it anyway.  I really don't
#.       know :(.
#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/xsoft/other/gimp.xml:280
#, xml-text
msgid ""
"<parameter>-D headless-tests=disabled</parameter>: This switch disables "
"using <command>xvfb-run</command> for running the tests.  Without this "
"switch, many tests fail if <command>xvfb-run</command> has been installed."
msgstr ""

