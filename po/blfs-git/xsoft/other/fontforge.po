#, xml-text
msgid ""
"<xref linkend=\"gtkmm3\"/>, <xref linkend=\"libspiro\"/>, and <xref "
"linkend=\"libxml2\"/>"
msgstr ""

#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/blfs-git/xsoft/other/fontforge.xml:93
#, xml-text
msgid "Optional"
msgstr ""

#.  the following references in the source appear not to be used:
#.       curl is mentioned in appveyor.yml for msys2 (integration tests, I
#. think)
#.       wget is referenced in Unicode/charset/generate.sh which will fail if
#.       wget is not on the PATH, and in Unicode/dump.c - with wget moved off
#. the
#.       PATH, no problems, i.e. they are never run and never built.
#.       Some of the others are at a minimum pulled in for recommended deps -
#.        libpng from freetype from fontconfig from xorg libs.
#.        harfbuzz is the same
#.       Also, adding or removing optional deps other than Sphinx doesn't seem
#.       to materially alter the build time or size.
#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/xsoft/other/fontforge.xml:108
#, xml-text
msgid ""
"<xref linkend=\"giflib\"/>, <xref linkend=\"git\"/>, <xref "
"linkend=\"libjpeg\"/>, <xref linkend=\"libtiff\"/>, <xref "
"linkend=\"sphinx\"/> (to build html documentation), and <xref "
"linkend=\"woff2\"/>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/xsoft/other/fontforge.xml:119
#, xml-text
msgid "Installation of FontForge"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/xsoft/other/fontforge.xml:122
#, xml-text
msgid ""
"Install <application>FontForge</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/xsoft/other/fontforge.xml:126
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr \\\n"
"      -D CMAKE_BUILD_TYPE=Release  \\\n"
"      -W no-dev .. &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/xsoft/other/fontforge.xml:135
#, xml-text
msgid "To test the results, issue: <command>make check</command>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/xsoft/other/fontforge.xml:139
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/xsoft/other/fontforge.xml:142
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/xsoft/other/fontforge.xml:145
#, xml-text
msgid ""
"If you have installed <command>sphinx-build</command>, HTML documentation "
"was built and installed in <filename "
"class=\"directory\">/usr/share/doc/fontforge</filename>.  To be able to "
"access it as a versioned directory, create a symlink as the <systemitem "
"class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/xsoft/other/fontforge.xml:154
#, no-wrap, xml-text
msgid ""
"<userinput>ln -sv fontforge /usr/share/doc/fontforge-&fontforge-"
"version;</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/xsoft/other/fontforge.xml:159
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/xsoft/other/fontforge.xml:162
#, xml-text
msgid ""
"<parameter>-D CMAKE_BUILD_TYPE=Release</parameter>: This switch is used to "
"create an optimized release without debug information."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/xsoft/other/fontforge.xml:167
#, xml-text
msgid ""
"<parameter>-W no-dev</parameter>: This switch is used to suppress warnings "
"intended for the package's developers."
msgstr ""

