#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/xsoft/other/balsa.xml:120
#, xml-text
msgid "Installation of Balsa"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/xsoft/other/balsa.xml:132
#, xml-text
msgid ""
"Install <application>Balsa</application> by running the following commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/xsoft/other/balsa.xml:136
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup .. --prefix=/usr       \\\n"
"               --buildtype=release \\\n"
"               -D html-widget=no   &amp;&amp;\n"
"ninja</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/xsoft/other/balsa.xml:145
#, xml-text
msgid "This package does not come with a test suite."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/xsoft/other/balsa.xml:149
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/xsoft/other/balsa.xml:152
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/xsoft/other/balsa.xml:157
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/xsoft/other/balsa.xml:160
#, xml-text
msgid ""
"<parameter>-D html-widget=no</parameter>: This option disables building the "
"HTML renderer. If you want the HTML renderer to be built, verify that you "
"have <xref linkend=\"webkitgtk\"/> installed, and then remove this option."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/xsoft/other/balsa.xml:167
#, xml-text
msgid ""
"<option>-D canberra=true</option>: This switch enables support for event "
"sounds via <xref linkend=\"libcanberra\" role=\"nodep\"/>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/xsoft/other/balsa.xml:172
#, xml-text
msgid ""
"<option>-D compface=true</option>: This switch enables support for using "
"<xref linkend=\"compface\" role=\"nodep\"/> to compress thumbnails for "
"contacts."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/xsoft/other/balsa.xml:177
#, xml-text
msgid ""
"<option>-D gcr=true</option>: This switch enables support for using libgcr "
"for handling TLS certificates. This requires that the <xref linkend=\"gcr\" "
"role=\"nodep\"/> package is installed, which is part of a runtime dependency"
" for libsecret."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/xsoft/other/balsa.xml:184
#, xml-text
msgid ""
"<option>-D gss=true</option>: This switch enables support for Kerberos "
"authentication. This requires that the <xref linkend=\"mitkrb\" "
"role=\"nodep\"/> package is installed."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/xsoft/other/balsa.xml:190
#, xml-text
msgid ""
"<option>-D ldap=true</option>: This switch enables LDAP address book "
"support. This requires that the <xref linkend=\"openldap\" role=\"nodep\"/> "
"package is installed."
msgstr ""

