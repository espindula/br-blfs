#, xml-text
msgid "Installation of Gnumeric"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/xsoft/office/gnumeric.xml:117
#, xml-text
msgid ""
"Install <application>Gnumeric</application> by running the following "
"commands:"
