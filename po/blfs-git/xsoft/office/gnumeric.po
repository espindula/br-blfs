#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/xsoft/office/gnumeric.xml:121
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr  &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/xsoft/office/gnumeric.xml:125
#, xml-text
msgid "This package must be installed before the test suite is run."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/xsoft/office/gnumeric.xml:129
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
