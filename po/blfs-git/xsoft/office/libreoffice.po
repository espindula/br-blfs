#: blfs-en/blfs-git/xsoft/office/libreoffice.xml:520
#, no-wrap, xml-text
msgid "<userinput>update-desktop-database</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/xsoft/office/libreoffice.xml:523
#, xml-text
msgid ""
"The suite and main modules can be started from the menu. From a terminal, "
"the suite can be started with the <command>libreoffice</command> command and"
" the modules with the <command>libreoffice "
"--<replaceable>&lt;module&gt;</replaceable></command> command, respectively,"
" where <replaceable>&lt;module&gt;</replaceable> is one of base, calc, draw,"
" impress, math, web, or writer. Modules cannot be started using their shell "
"starting script names (see \"Installed Programs\", below), if LO_PREFIX is "
"other than <filename class='directory'>/usr</filename>, unless the <filename"
" class='directory'>$LO_PREFIX/bin</filename> directory is appended to the "
"PATH."
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/xsoft/office/libreoffice.xml:538
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/xsoft/office/libreoffice.xml:541
#, xml-text
msgid ""
"<parameter>--with-vendor=BLFS</parameter>: This switch sets BLFS as the "
"vendor which is mentioned when you click \"About\" from the Help menu on the"
" toolbar."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/xsoft/office/libreoffice.xml:547
#, xml-text
msgid ""
"<parameter>--with-lang='fr en-GB'</parameter>: This switch sets what "
"languages to support. To list several languages, separate them with a space."
" For all languages, use <option>--with-lang=ALL</option>. Note that the "
"translations file is not needed and won't be downloaded if using only en-US "
"as a language."
msgstr ""

#. type: Content of: <sect1><sect2><note><para>
#: blfs-en/blfs-git/xsoft/office/libreoffice.xml:556
#, xml-text
msgid ""
"For a list of the available languages, look in "
"<filename>solenv/inc/langlist.mk</filename>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/xsoft/office/libreoffice.xml:562
#, xml-text
msgid ""
"<parameter>--with-help=html</parameter>: Without this switch, the help files"
" are not built."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/xsoft/office/libreoffice.xml:567
#, xml-text
msgid ""
"<parameter>--with-jdk-home=/opt/jdk</parameter>: This parameter will silence"
" a warning that the configure script attempted to find JAVA_HOME "
"automatically (even though that is passed in the environment). Omit this if "
"you disabled java."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/xsoft/office/libreoffice.xml:574
#, xml-text
msgid ""
"<parameter>--with-myspell-dicts</parameter>: This switch adds myspell "
"dictionaries to the <application>LibreOffice</application> installation set."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/xsoft/office/libreoffice.xml:580
#, xml-text
msgid ""
"<parameter>--with-system-boost</parameter>: This switch enables using system"
" boost. From time to time, recent versions of boost break the build of "
"libreoffice. In this case, it is possible to use the bundled copy of boost "
"by removing this flag."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/xsoft/office/libreoffice.xml:587
#, xml-text
msgid ""
"<parameter>--disable-dconf</parameter>: This switch disables compiling "
"<application>LibreOffice</application> with the <application>GNOME "
"DConf</application> configuration system support."
msgstr ""

#.  If you wish
#.       to build this driver replace this switch with the set of switches
#.       described below after '- -without-java'.
#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/xsoft/office/libreoffice.xml:593
#, xml-text
msgid ""
"<parameter>--without-junit</parameter>: This switch disables the tests for "
"the deprecated HSQLDB driver which is written in Java."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/xsoft/office/libreoffice.xml:601
#, xml-text
msgid ""
"<parameter>--without-system-dicts</parameter>: This switch disables the use "
"of dictionaries from system paths so that the ones installed by this package"
" are used."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/xsoft/office/libreoffice.xml:607
#, xml-text
msgid ""
"<parameter>--disable-odk</parameter>: This switch disables installing the "
"office development kit. Remove if you want to develop a "
"<application>LibreOffice</application> based application."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/xsoft/office/libreoffice.xml:613
#, xml-text
msgid ""
"<parameter>--disable-mariadb-sdbc</parameter>: This switch disables the "
"MariaDB SDBC connector for Libreoffice Base. Leaving it enabled results in a"
" build failure because of a problem linking to <xref linkend=\"mitkrb\"/>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/xsoft/office/libreoffice.xml:620
#, xml-text
msgid ""
"<parameter>--enable-release-build=yes</parameter>: This switch enables a "
"Release Build.  <application>LibreOffice</application> can be built as a "
"Release Build or as a Developer Build, because their default installation "
"paths and user profile paths are different. Developer Build displays the "
"words \"Dev\" and \"Beta\" in several places (e.g, menu and splash screen)."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/xsoft/office/libreoffice.xml:628
#, xml-text
msgid ""
"<parameter>--enable-python=system</parameter>: This switch tells "
"<application>LibreOffice</application> to use the system installed "
"<application>Python 3</application> instead of the bundled one."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/xsoft/office/libreoffice.xml:635
#, xml-text
msgid ""
"<parameter>--with-system-icu</parameter>: This switch tells the build system"
" to use the system installed version of ICU."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/xsoft/office/libreoffice.xml:640
#, xml-text
msgid ""
"<parameter>--with-system-*</parameter>: These switches prevent "
"<application>LibreOffice</application> from trying to compile its own "
"versions of these dependencies. If you've not installed some of the "
"dependencies, remove the corresponding switches."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/xsoft/office/libreoffice.xml:647
#, xml-text
msgid ""
"<command>make distro-pack-install</command>: This does a normal install, but"
" if you add a DESTDIR environment variable it will also install a lot of "
"(text) gid_Module_* files in the DESTDIR, to help distributions which want "
"to break the package into parts."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/xsoft/office/libreoffice.xml:654
#, xml-text
msgid ""
"<option>--with-parallelism=&lt;count&gt;</option>: This switch tells "
"<application>LibreOffice</application> to use &lt;count&gt; CPU cores to "
"compile in parallel.  (Do not include literal angle brackets.)  The default "
"is to use all available cores on the system."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/xsoft/office/libreoffice.xml:661
#, xml-text
msgid ""
"<option>--disable-cups</option>: Use this switch if you don't need printing "
"support."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/xsoft/office/libreoffice.xml:666
#, xml-text
msgid ""
"<option>--disable-dbus</option>: Use this switch if you've not installed "
"D-Bus-1.8.0 or later. It also disables Bluetooth support and font install "
"via PackageKit."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/xsoft/office/libreoffice.xml:672
#, xml-text
msgid ""
"<option>--disable-firebird-sdbc</option>: By default, the ability to connect"
" to a <application>firebird</application> database is enabled.  Add this "
"switch if you do not need that feature."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/xsoft/office/libreoffice.xml:678
#, xml-text
msgid ""
"<option>--disable-gstreamer-1-0</option>: Use this switch if you have not "
"installed <xref linkend=\"gst10-plugins-base\"/>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/xsoft/office/libreoffice.xml:683
#, xml-text
msgid ""
"<option>--disable-postgresql-sdbc</option>: This switch disables compiling "
"<application>LibreOffice</application> with the ability to connect to a "
"<application>PostgreSQL</application> database. Use it if you have not "
"installed <application>PostgreSQL</application> and you do not want "
"<application>LibreOffice</application> to compile its bundled copy."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/xsoft/office/libreoffice.xml:691
#, xml-text
msgid ""
"<option>--disable-skia</option>: Use <xref linkend=\"cairo\"/> for rendering"
" instead of skia."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/xsoft/office/libreoffice.xml:696
#, xml-text
msgid ""
"<option>--enable-lto</option>: This switch will enable Link Time "
"Optimization, which results in slightly smaller libraries (about 40 MB).  "
"This is said to make <application>LibreOffice</application> programs load "
"faster (and possibly run faster, e.g. when recalculating a spreadsheet). On "
"an 8-core machine with 16 GB of memory, the difference in compile times was "
"minimal, but an extra 2 GB was used for the work files. On machines with "
"fewer processors or a lack of memory, the compile might be much slower."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/xsoft/office/libreoffice.xml:707
#, xml-text
msgid ""
"<option>--without-java</option>: This switch disables "
"<application>Java</application> support in "
"<application>LibreOffice</application>. Java is needed for the deprecated "
"HSQLDB driver, which allows reading databases created by other programs or "
"in earlier versions of libreoffice <application>base</application>. It is "
"also needed for some optional user interface components."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/xsoft/office/libreoffice.xml:717
#, xml-text
msgid ""
"<option>--without-fonts</option>: <application>LibreOffice</application> "
"includes a number of third-party TrueType fonts. If you have already "
"installed some or all of the same fonts, you may prefer to use the system "
"versions."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/xsoft/office/libreoffice.xml:724
#, xml-text
msgid ""
"<option>--enable-evolution2</option>: Enables support for Evolution address "
"books through Evolution Data Server. Note that Evolution Data Server must be"
" installed for this feature to function."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/xsoft/office/libreoffice.xml:730
#, xml-text
msgid ""
"<option>--enable-qt6</option>: This switch enables support for integration "
"with Qt6 and the Qt6 theming engine. If <xref linkend=\"qt6\"/> is not "
"installed in <filename class=\"directory\">/usr</filename>, the include and "
"library directories must be specified in the <envar>QT6INC</envar> and "
"<envar>QT6LIB</envar> environment variables."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/xsoft/office/libreoffice.xml:738
#, xml-text
msgid ""
"<option>--enable-kf6</option>: This switch enables KDE/Plasma integration. "
"If <xref linkend=\"qt6\"/> and/or <xref linkend=\"kf6-frameworks\"/> are not"
" installed in <filename class=\"directory\">/usr</filename>, the include and"
" library directories must be specified in <envar>QT6INC</envar>, "
"<envar>QT6LIB</envar>, <envar>KF6INC</envar>, and <envar>KF6LIB</envar>, "
"respectively. This includes a style plugin and KIO integration."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/xsoft/office/libreoffice.xml:748
#, xml-text
msgid ""
"<option>--with-system-abseil</option>: This switch enables using a system "
"version of the Abseil C++ libraries instead of the bundled copy. Add this "
"switch if <xref linkend=\"abseil-cpp\"/> is installed and you want to use it"
" instead of the bundled copy."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/xsoft/office/libreoffice.xml:755
#, xml-text
msgid ""
"<option>--with-system-zxing</option>: This switch enables using a system "
"version of zxing-cpp instead of the bundled copy. Add this switch if <xref "
"linkend=\"zxing-cpp\"/> is installed and you want to use it instead of the "
"bundled copy."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/xsoft/office/libreoffice.xml:762
#, xml-text
msgid ""
"<option>--enable-gtk4</option>: This switch enables integration with GTK-4, "
"including the usage of a GTK-4 file browsing dialog and themes."
msgstr ""

