#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/xsoft/graphweb/falkon.xml:113
#, xml-text
msgid "Installation of falkon"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/xsoft/graphweb/falkon.xml:116
#, xml-text
msgid ""
"Install <application>falkon</application> by running the following commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/xsoft/graphweb/falkon.xml:120
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr \\\n"
"      -D CMAKE_BUILD_TYPE=Release  \\\n"
"      .. &amp;&amp;\n"
"\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/xsoft/graphweb/falkon.xml:130
#, xml-text
msgid "Tests should be run after installation."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/xsoft/graphweb/falkon.xml:134
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/xsoft/graphweb/falkon.xml:137
#, no-wrap, xml-text
msgid ""
"<userinput>make install &amp;&amp;\n"
"ldconfig</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/xsoft/graphweb/falkon.xml:141
#, xml-text
msgid ""
"To test the results, issue: <command>make test</command>. All tests should "
"pass. If any fail, the full results will be in "
"<filename>Testing/Temporary/LastTest.log</filename>."
msgstr ""

#. type: Content of: <sect1><sect2><note><para>
#: blfs-en/blfs-git/xsoft/graphweb/falkon.xml:148
#, xml-text
msgid ""
"When upgrading this package, it is possible that the contents of the "
"application will remain empty even though everything else appears to be "
"working properly.  In this case try removing "
"<filename>~/.cache/falkon</filename> and restarting the program."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/xsoft/graphweb/falkon.xml:156
#, xml-text
msgid ""
"If you have installed <application>Pyside2</application> you will want to "
"examine <command>hellopython.py</command> which is in the <filename "
"class=\"directory\">scripts/</filename> directory, and perhaps copy it to "
"your home directory."
msgstr ""

#. type: Content of: <sect1><sect2><note><para>
#: blfs-en/blfs-git/xsoft/graphweb/falkon.xml:164
#, xml-text
msgid ""
"If you are on a non-x86_64 architecture and run into problems with missing "
"text, you may wish to export <envar>QTWEBENGINE_CHROMIUM_FLAGS=\"--no-"
"sandbox\"</envar> prior to running Falkon."
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/xsoft/graphweb/falkon.xml:174
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/xsoft/graphweb/falkon.xml:177
#, xml-text
msgid ""
"<option>-D BUILD_TESTING=OFF</option>: This will save a little time and "
"space by not building the test programs, use this if you do not wish to run "
"the test."
msgstr ""

