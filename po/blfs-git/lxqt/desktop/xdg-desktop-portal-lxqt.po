#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/lxqt/desktop/xdg-desktop-portal-lxqt.xml:84
#, xml-text
msgid ""
"Install <application>xdg-desktop-portal-lxqt</application> by running the "
"following commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/lxqt/desktop/xdg-desktop-portal-lxqt.xml:88
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr \\\n"
"      -D CMAKE_BUILD_TYPE=Release  \\\n"
"      ..                           &amp;&amp;\n"
"make</userinput>"
msgstr ""

