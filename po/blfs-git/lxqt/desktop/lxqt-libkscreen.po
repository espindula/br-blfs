#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/lxqt/desktop/lxqt-libkscreen.xml:90
#, xml-text
msgid "Installation of libkscreen"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/lxqt/desktop/lxqt-libkscreen.xml:93
#, xml-text
msgid ""
"Install <application>libkscreen</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/lxqt/desktop/lxqt-libkscreen.xml:97
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr        \\\n"
"      -D CMAKE_BUILD_TYPE=Release         \\\n"
"      -D CMAKE_INSTALL_LIBEXECDIR=libexec \\\n"
"      -D KDE_INSTALL_USE_QT_SYS_PATHS=ON  \\\n"
"      -D BUILD_TESTING=OFF                \\\n"
"      -W no-dev ..                        &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/lxqt/desktop/lxqt-libkscreen.xml:109
#, xml-text
msgid "This package does not come with a test suite."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/lxqt/desktop/lxqt-libkscreen.xml:113
#, xml-text
msgid "Now, as the &root; user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/lxqt/desktop/lxqt-libkscreen.xml:116
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/lxqt/desktop/lxqt-libkscreen.xml:119
#, xml-text
msgid ""
"Next, remove a systemd unit which serves no purpose on a SysV system as the "
"&root; user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/lxqt/desktop/lxqt-libkscreen.xml:123
#, no-wrap, xml-text
msgid ""
"<userinput>rm -v /usr/lib/systemd/user/plasma-kscreen.service</userinput>"
msgstr ""

