msgid "Installation of lxqt-build-tools"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/lxqt/desktop/lxqt-build-tools.xml:89
#, xml-text
msgid ""
"Install <application>lxqt-build-tools</application> by running the following"
" commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/lxqt/desktop/lxqt-build-tools.xml:93
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr \\\n"
"      -D CMAKE_BUILD_TYPE=Release  \\\n"
"      .. &amp;&amp;\n"
"\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/lxqt/desktop/lxqt-build-tools.xml:103
#, xml-text
msgid "This package does not come with a test suite."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/lxqt/desktop/lxqt-build-tools.xml:107
#, xml-text
msgid "Now, as the &root; user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/lxqt/desktop/lxqt-build-tools.xml:110
#, no-wrap, xml-text
msgid ""
"<userinput>make install &amp;&amp;\n"
"rm -f /usr/share/cmake/lxqt2-build-tools/find-modules/FindXCB.cmake</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/lxqt/desktop/lxqt-build-tools.xml:116
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/lxqt/desktop/lxqt-build-tools.xml:119
#, xml-text
msgid ""
"<command>rm -f /usr/share/cmake/lxqt2-build-tools/find-"
"modules/FindXCB.cmake</command>: Remove an old cmake file from a previous "
"version of this package that is no longer used. Without this command, other "
"packages in this chapter will fail to build."
msgstr ""

