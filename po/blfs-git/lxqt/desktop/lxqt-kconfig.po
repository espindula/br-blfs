#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/lxqt/desktop/lxqt-kconfig.xml:92
#, xml-text
msgid ""
"Install <application>kconfig</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/lxqt/desktop/lxqt-kconfig.xml:96
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr        \\\n"
"      -D CMAKE_BUILD_TYPE=Release         \\\n"
"      -D CMAKE_INSTALL_LIBEXECDIR=libexec \\\n"
"      -D KDE_INSTALL_USE_QT_SYS_PATHS=ON  \\\n"
"      -D BUILD_TESTING=OFF                \\\n"
"      -W no-dev ..                        &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/lxqt/desktop/lxqt-kconfig.xml:108
#, xml-text
msgid "This package does not come with a test suite."
