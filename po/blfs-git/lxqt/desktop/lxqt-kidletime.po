#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/lxqt/desktop/lxqt-kidletime.xml:92
#, xml-text
msgid "Installation of kidletime"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/lxqt/desktop/lxqt-kidletime.xml:95
#, xml-text
msgid ""
"Install <application>kidletime</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/lxqt/desktop/lxqt-kidletime.xml:99
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr        \\\n"
"      -D CMAKE_BUILD_TYPE=Release         \\\n"
"      -D CMAKE_INSTALL_LIBEXECDIR=libexec \\\n"
"      -D KDE_INSTALL_USE_QT_SYS_PATHS=ON  \\\n"
"      -D BUILD_TESTING=OFF                \\\n"
"      -W no-dev ..                        &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/lxqt/desktop/lxqt-kidletime.xml:111
#, xml-text
msgid "This package does not come with a test suite."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/lxqt/desktop/lxqt-kidletime.xml:115
#, xml-text
msgid "Now, as the &root; user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/lxqt/desktop/lxqt-kidletime.xml:118
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
