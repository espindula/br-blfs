#. type: Content of: <sect1><sect2><sect3><screen>
#: blfs-en/blfs-git/server/other/openldap.xml:503
#, no-wrap, xml-text
msgid ""
"<userinput>ldapsearch -x -b '' -s base '(objectclass=*)' "
"namingContexts</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/blfs-git/server/other/openldap.xml:506
#, xml-text
msgid "The expected result is:"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><screen>
#: blfs-en/blfs-git/server/other/openldap.xml:509
#, no-wrap, xml-text
msgid ""
"<computeroutput># extended LDIF\n"
"#\n"
"# LDAPv3\n"
"# base &lt;&gt; with scope baseObject\n"
"# filter: (objectclass=*)\n"
"# requesting: namingContexts\n"
"#\n"
"\n"
"#\n"
"dn:\n"
"namingContexts: dc=my-domain,dc=com\n"
"\n"
"# search result\n"
"search: 2\n"
"result: 0 Success\n"
"\n"
"# numResponses: 2\n"
"# numEntries: 1</computeroutput>"
msgstr ""

