#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/server/other/unbound.xml:97
#, xml-text
msgid "Installation of Unbound"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/server/other/unbound.xml:100
#, xml-text
msgid ""
"There should be a dedicated user and group to take control of the "
"<command>unbound</command> daemon after it is started. Issue the following "
"commands as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/server/other/unbound.xml:105
#, no-wrap, xml-text
msgid ""
"<userinput>groupadd -g 88 unbound &amp;&amp;\n"
"useradd -c \"Unbound DNS Resolver\" -d /var/lib/unbound -u 88 \\\n"
"        -g unbound -s /bin/false unbound</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/server/other/unbound.xml:110
#, xml-text
msgid ""
"Install <application>Unbound</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/server/other/unbound.xml:114
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr     \\\n"
"            --sysconfdir=/etc \\\n"
"            --disable-static  \\\n"
"            --with-pidfile=/run/unbound.pid &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/server/other/unbound.xml:121
#, xml-text
msgid ""
"If you have <xref linkend=\"doxygen\"/> package installed and want to build "
"html documentation, run the following command:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/server/other/unbound.xml:125
#, no-wrap, xml-text
msgid "<userinput>make doc</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/server/other/unbound.xml:128
#, xml-text
msgid "To test the results, issue <command>make check</command>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/server/other/unbound.xml:132
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/server/other/unbound.xml:135
#, no-wrap, xml-text
msgid ""
"<userinput>make install &amp;&amp;\n"
"mv -v /usr/sbin/unbound-host /usr/bin/</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/server/other/unbound.xml:139
#, xml-text
msgid ""
"If you built the documentation, install it by running the following commands"
" as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/server/other/unbound.xml:144
#, no-wrap, xml-text
msgid ""
"<userinput>install -v -m755 -d /usr/share/doc/unbound-&unbound-version; &amp;&amp;\n"
"install -v -m644 doc/html/* /usr/share/doc/unbound-&unbound-version;</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/server/other/unbound.xml:150
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/server/other/unbound.xml:156
#, xml-text
msgid ""
"<option>--with-libevent</option>: This option enables libevent support, "
"which allows for the use of large outgoing port ranges."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/server/other/unbound.xml:161
#, xml-text
msgid ""
"<option>--with-pyunbound</option>: This option enables building the Python "
"bindings. If you want to build the bindings, you also need to pass the "
"<envar>PYTHON_VERSION=&python3-majorver;</envar> environment variable to "
"configure."
msgstr ""

