#. type: Content of: <sect1><sect2><warning><para>
#: blfs-en/blfs-git/server/databases/mariadb.xml:135
#, xml-text
msgid ""
"MariaDB and MySQL cannot be installed on the same system without extensive "
"changes to the build configuration of one of the two applications."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/server/databases/mariadb.xml:141
#, xml-text
msgid ""
"For security reasons, running the server as an unprivileged user and group "
"is strongly encouraged. Issue the following (as <systemitem "
"class=\"username\">root</systemitem>) to create the user and group:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/server/databases/mariadb.xml:147
#, no-wrap, xml-text
msgid ""
"<userinput>groupadd -g 40 mariadb &amp;&amp;\n"
"useradd -c \"MariaDB Server\" -d /srv/mariadb -g mariadb -s /bin/false -u 40 mariadb</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/server/databases/mariadb.xml:151
#, xml-text
msgid "Fix an issue with detecting Boost-1.89.0 and later:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/server/databases/mariadb.xml:154
#, no-wrap, xml-text
msgid ""
"<userinput>sed -i 's/regex system/regex/' \\\n"
"       storage/columnstore/columnstore/cmake/boost.cmake</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/server/databases/mariadb.xml:158
#, xml-text
msgid ""
"Install <application>MariaDB</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/server/databases/mariadb.xml:162
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_BUILD_TYPE=Release                       \\\n"
"      -D CMAKE_INSTALL_PREFIX=/usr                      \\\n"
"      -D GRN_LOG_PATH=/var/log/groonga.log              \\\n"
"      -D INSTALL_DOCDIR=share/doc/mariadb-&mariadb-version;        \\\n"
"      -D INSTALL_DOCREADMEDIR=share/doc/mariadb-&mariadb-version;  \\\n"
"      -D INSTALL_MANDIR=share/man                       \\\n"
"      -D INSTALL_MYSQLSHAREDIR=share/mariadb            \\\n"
"      -D INSTALL_MYSQLTESTDIR=share/mariadb/test        \\\n"
"      -D INSTALL_PAMDIR=lib/security                    \\\n"
"      -D INSTALL_PAMDATADIR=/etc/security               \\\n"
"      -D INSTALL_PLUGINDIR=lib/mariadb/plugin           \\\n"
"      -D INSTALL_SBINDIR=sbin                           \\\n"
"      -D INSTALL_SCRIPTDIR=bin                          \\\n"
"      -D INSTALL_SQLBENCHDIR=share/mariadb/bench        \\\n"
"      -D INSTALL_SUPPORTFILESDIR=share/mariadb          \\\n"
"      -D MYSQL_DATADIR=/srv/mariadb                     \\\n"
"      -D MYSQL_UNIX_ADDR=/run/mariadb/mariadb.sock      \\\n"
"      -D WITH_EXTRA_CHARSETS=complex                    \\\n"
"      -D WITH_EMBEDDED_SERVER=ON                        \\\n"
"      -D SKIP_TESTS=ON                                  \\\n"
"      -D TOKUDB_OK=0                                    \\\n"
"      -W no-dev                                         \\\n"
"      .. &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/server/databases/mariadb.xml:191
#, xml-text
msgid ""
"To test the results, issue: <command>make test</command>.  Two tests, "
"my_tzinfo and test-connect, are known to fail."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/server/databases/mariadb.xml:220
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/server/databases/mariadb.xml:223
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/server/databases/mariadb.xml:237
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/server/databases/mariadb.xml:240
#, xml-text
msgid ""
"<parameter>-D WITH_EMBEDDED_SERVER=ON</parameter>: This switch enables "
"compiling the embedded server library needed by certain applications, such "
"as <application>Amarok</application>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/server/databases/mariadb.xml:246
#, xml-text
msgid ""
"<parameter>-D WITH_EXTRA_CHARSETS=complex</parameter>: This switch enables "
"support for the complex character sets."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/server/databases/mariadb.xml:251
#, xml-text
msgid ""
"<parameter>-D SKIP_TESTS=ON</parameter>: This switch disables tests for "
"MariaDB Connector/C which are not supported without additional setup."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/server/databases/mariadb.xml:257
#, xml-text
msgid ""
"<option>-D WITHOUT_SERVER=ON</option>: Use this switch if you don't want the"
" server and would like to build the client only."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/server/databases/mariadb.xml:263
#, xml-text
msgid ""
"<parameter>-W no-dev</parameter>: This switch turns off some warnings that "
"are only useful for developers."
msgstr ""

#. type: Content of: <sect1><sect2><note><para>
#: blfs-en/blfs-git/server/databases/mariadb.xml:268
#, xml-text
msgid ""
"There are numerous options available to <command>cmake</command>. Check the "
"output of the <command>cmake . -LH</command> for additional customization "
"options."
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/server/databases/mariadb.xml:276
#, xml-text
msgid "Configuring MariaDB"
msgstr ""

