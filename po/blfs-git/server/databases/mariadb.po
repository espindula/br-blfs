#, xml-text
msgid ""
"<filename>/etc/mariadb/my.cnf</filename> and <filename>~/.my.cnf</filename>"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><indexterm><primary>
#: blfs-en/blfs-git/server/databases/mariadb.xml:287
#, xml-text
msgid "~/.my.cnf"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><indexterm><primary>
#: blfs-en/blfs-git/server/databases/mariadb.xml:291
#, xml-text
msgid "/etc/mariadb/my.cnf"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><title>
#: blfs-en/blfs-git/server/databases/mariadb.xml:297
#, xml-text
msgid "Configuration Information"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/blfs-git/server/databases/mariadb.xml:300
#, xml-text
msgid ""
"Create a basic <filename>/etc/mariadb/my.cnf</filename> file using the "
"following command as the <systemitem class=\"username\">root</systemitem> "
"user:"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><screen>
#: blfs-en/blfs-git/server/databases/mariadb.xml:305
#, no-wrap, xml-text
msgid ""
"<userinput>install -v -dm 755 /etc/mariadb &amp;&amp;\n"
"cat &gt; /etc/mariadb/my.cnf &lt;&lt; \"EOF\"\n"
"<literal># Begin /etc/mariadb/my.cnf\n"
"\n"
"# The following options will be passed to all MySQL clients\n"
"[client]\n"
"#password       = your_password\n"
"port            = 3306\n"
"socket          = /run/mariadb/mariadb.sock\n"
"\n"
"# The MySQL server\n"
"[mariadb]\n"
"port            = 3306\n"
"socket          = /run/mariadb/mariadb.sock\n"
"datadir         = /srv/mariadb\n"
"skip-external-locking\n"
"key_buffer_size = 16M\n"
"max_allowed_packet = 1M\n"
"sort_buffer_size = 512K\n"
"net_buffer_length = 16K\n"
"myisam_sort_buffer_size = 8M\n"
"\n"
"# Don't listen on a TCP/IP port at all.\n"
"skip-networking\n"
"\n"
"# required unique id between 1 and 2^32 - 1\n"
"server-id       = 1\n"
"\n"
"# Uncomment the following if you are using BDB tables\n"
"#bdb_cache_size = 4M\n"
"#bdb_max_lock = 10000\n"
"\n"
"# InnoDB tables are now used by default\n"
"innodb_data_home_dir = /srv/mariadb\n"
"innodb_log_group_home_dir = /srv/mariadb\n"
"# All the innodb_xxx values below are the default ones:\n"
"innodb_data_file_path = ibdata1:12M:autoextend\n"
"# You can set .._buffer_pool_size up to 50 - 80 %\n"
"# of RAM but beware of setting memory usage too high\n"
"innodb_buffer_pool_size = 128M\n"
"innodb_log_file_size = 48M\n"
"innodb_log_buffer_size = 16M\n"
"innodb_flush_log_at_trx_commit = 1\n"
"innodb_lock_wait_timeout = 50\n"
"\n"
"[mariadbdump]\n"
"quick\n"
"max_allowed_packet = 16M\n"
"\n"
"[mariadb]\n"
"no-auto-rehash\n"
"# Remove the next comment character if you are not familiar with SQL\n"
"#safe-updates\n"
"\n"
"[isamchk]\n"
"key_buffer = 20M\n"
"sort_buffer_size = 20M\n"
"read_buffer = 2M\n"
"write_buffer = 2M\n"
"\n"
"[myisamchk]\n"
"key_buffer_size = 20M\n"
"sort_buffer_size = 20M\n"
"read_buffer = 2M\n"
"write_buffer = 2M\n"
"\n"
"[mariadbhotcopy]\n"
"interactive-timeout\n"
"\n"
"# End /etc/mariadb/my.cnf</literal>\n"
"EOF</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/blfs-git/server/databases/mariadb.xml:378
#, xml-text
msgid ""
"You can now install a database and change the ownership to the unprivileged "
"user and group (perform as the <systemitem "
"class=\"username\">root</systemitem> user):"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><screen>
#: blfs-en/blfs-git/server/databases/mariadb.xml:383
#, no-wrap, xml-text
msgid ""
"<userinput>mariadb-install-db --basedir=/usr --datadir=/srv/mariadb --user=mariadb &amp;&amp;\n"
"chown -R mariadb:mariadb /srv/mariadb</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/blfs-git/server/databases/mariadb.xml:387
#, xml-text
msgid ""
"Further configuration requires that the <application>MariaDB</application> "
"server is running. Start the server using the following commands as the "
"<systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><screen>
#: blfs-en/blfs-git/server/databases/mariadb.xml:393
#, no-wrap, xml-text
msgid ""
"<userinput>install -v -m755 -o mariadb -g mariadb -d /run/mariadb &amp;&amp;\n"
"mariadbd-safe --user=mariadb 2&gt;&amp;1 &gt;/dev/null &amp;</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/blfs-git/server/databases/mariadb.xml:397
#, xml-text
msgid ""
"A default installation does not set up a password for the administrator, so "
"use the following command as the <systemitem "
"class=\"username\">root</systemitem> user to set one."
msgstr ""

#. type: Content of: <sect1><sect2><sect3><screen>
#: blfs-en/blfs-git/server/databases/mariadb.xml:402
#, no-wrap, xml-text
msgid "<userinput>mariadb-admin -u root password</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/blfs-git/server/databases/mariadb.xml:405
#, xml-text
msgid ""
"Configuration of the server is now finished. Shut the server down using the "
"following command as the <systemitem class=\"username\">root</systemitem> "
"user:"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><screen>
#: blfs-en/blfs-git/server/databases/mariadb.xml:410
#, no-wrap, xml-text
msgid "<userinput>mariadb-admin -p shutdown</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><title>
#: blfs-en/blfs-git/server/databases/mariadb.xml:415
#, xml-text
msgid ""
"<phrase revision=\"sysv\">Boot Script</phrase> <phrase "
"revision=\"systemd\">Systemd Unit</phrase>"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/blfs-git/server/databases/mariadb.xml:419
#, xml-text
msgid ""
"Install the <phrase "
"revision=\"sysv\"><filename>/etc/rc.d/init.d/mariadb</filename> init "
"script</phrase> <phrase "
"revision=\"systemd\"><filename>mariadb.service</filename> unit</phrase> "
"included in the <xref linkend=\"bootscripts\" revision=\"sysv\"/> <xref "
"linkend=\"systemd-units\" revision=\"systemd\"/> package as the <systemitem "
"class=\"username\">root</systemitem> user to start the "
"<application>MariaDB</application> server during system boot-up."
