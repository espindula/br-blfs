#. type: Content of: <sect1><sect2><warning><para>
#: blfs-en/blfs-git/server/mail/dovecot.xml:124
#, xml-text
msgid ""
"There are significant changes in the configuration of this package that are "
"required when updating to Dovecot 2.4.0. Please review the documentation at "
"<ulink "
"url=\"https://doc.dovecot.org/2.4.0/installation/upgrade/2.3-to-2.4.html\">Dovecot"
" Upgrade Guide</ulink> before continuing if you are upgrading this package "
"from a previous version."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/server/mail/dovecot.xml:134
#, xml-text
msgid ""
"There should be dedicated users and groups for unprivileged Dovecot "
"processes and for processing users' logins. Issue the following commands as "
"the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/server/mail/dovecot.xml:139
#, no-wrap, xml-text
msgid ""
"<userinput>groupadd -g 42 dovecot &amp;&amp;\n"
"useradd -c \"Dovecot unprivileged user\" -d /dev/null -u 42 \\\n"
"        -g dovecot -s /bin/false dovecot &amp;&amp;\n"
"groupadd -g 43 dovenull &amp;&amp;\n"
"useradd -c \"Dovecot login user\" -d /dev/null -u 43 \\\n"
"        -g dovenull -s /bin/false dovenull</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/server/mail/dovecot.xml:147
#, xml-text
msgid ""
"Install <application>Dovecot</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/server/mail/dovecot.xml:151
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr                          \\\n"
"            --sysconfdir=/etc                      \\\n"
"            --localstatedir=/var                   \\\n"
"            --with-systemd=no                      \\\n"
"            --docdir=/usr/share/doc/dovecot-&dovecot-version;  \\\n"
"            --disable-static &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/server/mail/dovecot.xml:159
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr                          \\\n"
"            --sysconfdir=/etc                      \\\n"
"            --localstatedir=/var                   \\\n"
"            --docdir=/usr/share/doc/dovecot-&dovecot-version;  \\\n"
"            --disable-static                       &amp;&amp;\n"
"make</userinput>"
msgstr ""

