msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/server/mail/postfix.xml:118
#, xml-text
msgid "Installation of Postfix"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><title>
#: blfs-en/blfs-git/server/mail/postfix.xml:121
#, xml-text
msgid "Adding Users and Groups"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/blfs-git/server/mail/postfix.xml:124
#, xml-text
msgid ""
"Before you compile the program, you need to create users and groups that "
"will be expected to be in place during the installation. Add the users and "
"groups with the following commands issued by the <systemitem "
"class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><screen>
#: blfs-en/blfs-git/server/mail/postfix.xml:130
#, no-wrap, xml-text
msgid ""
"<userinput>groupadd -g 32 postfix &amp;&amp;\n"
"groupadd -g 33 postdrop &amp;&amp;\n"
"useradd -c \"Postfix Daemon User\" -d /var/spool/postfix -g postfix \\\n"
"        -s /bin/false -u 32 postfix &amp;&amp;\n"
"chown -v postfix:postfix /var/mail</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><title>
#: blfs-en/blfs-git/server/mail/postfix.xml:138
#, xml-text
msgid "Configuring the Build"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/blfs-git/server/mail/postfix.xml:141
#, xml-text
msgid ""
"The README files are formatted to be read with a pager like "
"<application>less</application> or <application>more</application>.  If you "
"want to use a text editor, make them legible with the following sed:"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><screen>
#: blfs-en/blfs-git/server/mail/postfix.xml:147
#, no-wrap, xml-text
msgid "<userinput>sed -i 's/.\\x08//g' README_FILES/*</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/blfs-git/server/mail/postfix.xml:150
#, xml-text
msgid ""
"The <application>Postfix</application> source tree does not contain a "
"<filename>configure</filename> script, rather the makefile in the top-level "
"directory contains a <option>makefiles</option> target that regenerates all "
"the other makefiles in the build tree. If you wish to use additional "
"software such as a database back-end for virtual users, or TLS/SSL "
"authentication, you will need to regenerate the makefiles using one or more "
"of the appropriate <envar>CCARGS</envar> and <envar>AUXLIBS</envar> settings"
" listed below."
msgstr ""

#. type: Content of: <sect1><sect2><sect3><note><para>
#: blfs-en/blfs-git/server/mail/postfix.xml:162
#, xml-text
msgid ""
"For all variants of the CCARGS you should ensure that '-DNO_NIS' is "
"specified so that the build does not attempt to access an rpcsvc header "
"which do not exist in BLFS.  If &berkeley-db; is not installed, '-DNO_DB' "
"needs to be specified as well."
msgstr ""

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/blfs-git/server/mail/postfix.xml:170
#, xml-text
msgid "For more details read the readme files."
msgstr ""

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/blfs-git/server/mail/postfix.xml:174
#, xml-text
msgid ""
"Initialize the <envar>CCARGS</envar> and <envar>AUXLIBS</envar> according to"
" the note above:"
msgstr ""

#.  This package does not accept a space between -D and the argument.
#. type: Content of: <sect1><sect2><sect3><screen>
#: blfs-en/blfs-git/server/mail/postfix.xml:180
#, no-wrap, xml-text
msgid ""
"<userinput>CCARGS=\"-DNO_NIS -DNO_DB\"\n"
"AUXLIBS=\"\"</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/blfs-git/server/mail/postfix.xml:184
#, xml-text
msgid ""
"Next, the <envar>CCARGS</envar> and the <envar>AUXLIBS</envar> variables are"
" filled with settings depending on the actual system configuration. If an "
"optional package is installed but should <emphasis>not</emphasis> be "
"included in the <application>Postfix</application> build, simply skip the "
"corresponding <code>if [ ... ]; then</code> scriptlets."
msgstr ""

#. type: Content of: <sect1><sect2><sect3><sect4><title>
#: blfs-en/blfs-git/server/mail/postfix.xml:193
#, xml-text
msgid "Cyrus-SASL"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><sect4><para>
#: blfs-en/blfs-git/server/mail/postfix.xml:196
#, xml-text
msgid ""
"To use <application>Cyrus-SASL</application> with "
"<application>Postfix</application>, use the following arguments:"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><sect4><screen>
#: blfs-en/blfs-git/server/mail/postfix.xml:200
#, no-wrap, xml-text
msgid ""
"<userinput>if [ -r /usr/lib/libsasl2.so ]; then\n"
"  CCARGS=\"$CCARGS -DUSE_SASL_AUTH -DUSE_CYRUS_SASL -I/usr/include/sasl\"\n"
"  AUXLIBS=\"$AUXLIBS -lsasl2\"\n"
"fi</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><sect4><title>
#: blfs-en/blfs-git/server/mail/postfix.xml:207
#, xml-text
msgid "LMDB"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><sect4><para>
#: blfs-en/blfs-git/server/mail/postfix.xml:209
#, xml-text
msgid ""
"To use <application>LMDB</application> with "
"<application>Postfix</application>, use the following arguments:"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><sect4><screen>
#: blfs-en/blfs-git/server/mail/postfix.xml:213
#, no-wrap, xml-text
msgid ""
"<userinput>if [ -r /usr/lib/liblmdb.so ]; then\n"
"  CCARGS=\"$CCARGS -DHAS_LMDB\"\n"
"  AUXLIBS=\"$AUXLIBS -llmdb\"\n"
"fi</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><sect4><title>
#: blfs-en/blfs-git/server/mail/postfix.xml:220
#, xml-text
msgid "OpenLDAP"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><sect4><para>
#: blfs-en/blfs-git/server/mail/postfix.xml:223
#, xml-text
msgid ""
"To use <application>OpenLDAP</application> with "
"<application>Postfix</application>, use the following arguments:"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><sect4><screen>
#: blfs-en/blfs-git/server/mail/postfix.xml:227
#, no-wrap, xml-text
msgid ""
"<userinput>if [ -r /usr/lib/libldap.so -a -r /usr/lib/liblber.so ]; then\n"
"  CCARGS=\"$CCARGS -DHAS_LDAP\"\n"
"  AUXLIBS=\"$AUXLIBS -lldap -llber\"\n"
"fi</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><sect4><title>
#: blfs-en/blfs-git/server/mail/postfix.xml:235
#, xml-text
msgid "Sqlite"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><sect4><para>
#: blfs-en/blfs-git/server/mail/postfix.xml:238
#, xml-text
msgid ""
"To use <application>Sqlite</application> with "
"<application>Postfix</application>, use the following arguments:"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><sect4><screen>
#: blfs-en/blfs-git/server/mail/postfix.xml:242
#, no-wrap, xml-text
msgid ""
"<userinput>if [ -r /usr/lib/libsqlite3.so ]; then\n"
"  CCARGS=\"$CCARGS -DHAS_SQLITE\"\n"
"  AUXLIBS=\"$AUXLIBS -lsqlite3 -lpthread\"\n"
"fi</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><sect4><title>
#: blfs-en/blfs-git/server/mail/postfix.xml:250
#, xml-text
msgid "MySQL"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><sect4><para>
#: blfs-en/blfs-git/server/mail/postfix.xml:253
#, xml-text
msgid ""
"To use <application>MySQL</application> with "
"<application>Postfix</application>, use the following arguments:"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><sect4><screen>
#: blfs-en/blfs-git/server/mail/postfix.xml:257
#, no-wrap, xml-text
msgid ""
"<userinput>if [ -r /usr/lib/libmysqlclient.so ]; then\n"
"  CCARGS=\"$CCARGS -DHAS_MYSQL -I/usr/include/mysql\"\n"
"  AUXLIBS=\"$AUXLIBS -lmysqlclient -lz -lm\"\n"
"fi</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><sect4><title>
#: blfs-en/blfs-git/server/mail/postfix.xml:265
#, xml-text
msgid "PostgreSQL"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><sect4><para>
#: blfs-en/blfs-git/server/mail/postfix.xml:268
#, xml-text
msgid ""
"To use <application>PostgreSQL</application> with "
"<application>Postfix</application>, use the following arguments:"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><sect4><screen>
#: blfs-en/blfs-git/server/mail/postfix.xml:272
#, no-wrap, xml-text
msgid ""
"<userinput>if [ -r /usr/lib/libpq.so ]; then\n"
"  CCARGS=\"$CCARGS -DHAS_PGSQL -I/usr/include/postgresql\"\n"
"  AUXLIBS=\"$AUXLIBS -lpq -lz -lm\"\n"
"fi</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><sect4><title>
#: blfs-en/blfs-git/server/mail/postfix.xml:280
#, xml-text
msgid "CDB/TinyCDB"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><sect4><para>
#: blfs-en/blfs-git/server/mail/postfix.xml:283
#, xml-text
msgid ""
"To use <application>CDB</application> or <application>TinyCDB</application> "
"with <application>Postfix</application>, use the following arguments:"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><sect4><screen>
#: blfs-en/blfs-git/server/mail/postfix.xml:288
#, no-wrap, xml-text
msgid ""
"<literal>if [ -r <replaceable>&lt;/path/to/CDB&gt;</replaceable>/libcdb.a ]; then\n"
"  CCARGS=\"$CCARGS -DHAS_CDB\"\n"
"  AUXLIBS=\"$AUXLIBS <replaceable>&lt;/path/to/CDB&gt;</replaceable>/libcdb.a\"\n"
"fi</literal>"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><sect4><title>
#: blfs-en/blfs-git/server/mail/postfix.xml:296
#, xml-text
msgid "StartTLS Authentication"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><sect4><para>
#: blfs-en/blfs-git/server/mail/postfix.xml:299
#, xml-text
msgid ""
"To use <application>OpenSSL</application> with "
"<application>Postfix</application>, use the following arguments:"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><sect4><screen>
#: blfs-en/blfs-git/server/mail/postfix.xml:303
#, no-wrap, xml-text
msgid ""
"<userinput>if [ -r /usr/lib/libssl.so -a -r /usr/lib/libcrypto.so ]; then\n"
"  CCARGS=\"$CCARGS -DUSE_TLS -I/usr/include/openssl/\"\n"
"  AUXLIBS=\"$AUXLIBS -lssl -lcrypto\"\n"
"fi</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><sect4><para>
#: blfs-en/blfs-git/server/mail/postfix.xml:308
#, xml-text
msgid ""
"<application>OpenSSL</application> is installed by LFS so it should be "
"always there. The <code>if ... then</code> is here just for consistency."
msgstr ""

#. type: Content of: <sect1><sect2><sect3><title>
#: blfs-en/blfs-git/server/mail/postfix.xml:317
#, xml-text
msgid "Installing Postfix"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/blfs-git/server/mail/postfix.xml:320
#, xml-text
msgid ""
"There might be duplicate settings in <envar>AUXLIBS</envar> like "
"<code>-lm</code> when both, <application>MariaDB</application> and "
"<application>PostgreSQL</application> are used. They do not harm. Install "
"<application>Postfix</application> by running the following commands:"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><screen>
#: blfs-en/blfs-git/server/mail/postfix.xml:327
#, no-wrap, xml-text
msgid ""
"<userinput>make CC=\"gcc -std=gnu17\" CCARGS=\"$CCARGS\" AUXLIBS=\"$AUXLIBS\" makefiles &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/blfs-git/server/mail/postfix.xml:334
#, xml-text
msgid "This package does not come with a useful test suite."
msgstr ""

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/blfs-git/server/mail/postfix.xml:338
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#.  dev note: sh postfix-install -non-interactive install_root=<DESTDIR>
#.  ...
#. type: Content of: <sect1><sect2><sect3><screen>
#: blfs-en/blfs-git/server/mail/postfix.xml:343
#, no-wrap, xml-text
msgid ""
"<userinput>sh postfix-install -non-interactive  \\\n"
"   daemon_directory=/usr/lib/postfix \\\n"
"   manpage_directory=/usr/share/man  \\\n"
"   html_directory=/usr/share/doc/postfix-&postfix-version;/html \\\n"
"   readme_directory=/usr/share/doc/postfix-&postfix-version;/readme</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/server/mail/postfix.xml:354
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/server/mail/postfix.xml:357
#, xml-text
msgid ""
"<command>make makefiles</command>: This command rebuilds the makefiles "
"throughout the source tree to use the options contained in the "
"<envar>CCARGS</envar> and <envar>AUXLIBS</envar> variables."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/server/mail/postfix.xml:363
#, xml-text
msgid ""
"<command>sh postfix-install -non-interactive</command>: This keeps the "
"install script from asking any questions, thereby accepting default "
"destination directories in all but the few cases. If the "
"<option>html_directory</option> and <option>readme_directory</option> "
"options are not set then the documentation will not be installed."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/server/mail/postfix.xml:375
#, xml-text
msgid ""
"<option>CC=\"gcc -std=gnu17\"</option>: this is used to overcome an issue "
"with gcc-15. This version of gcc uses <literal>-std=gnu23</literal> by "
"default which exposes several issues in the source code."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/server/mail/postfix.xml:381
#, xml-text
msgid ""
"<option>CCARGS=\"-DNO_EAI ...\"</option>: this will turn off SMTPUTF8 "
"support, for example if the rest of your email address infrastructure cannot"
" handle UTF-8 email addresses and message header values."
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/server/mail/postfix.xml:389
#, xml-text
msgid "Configuring Postfix"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><title>
#: blfs-en/blfs-git/server/mail/postfix.xml:392
#, xml-text
msgid "Config Files"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/blfs-git/server/mail/postfix.xml:395
#, xml-text
msgid ""
"<filename>/etc/aliases</filename>, "
"<filename>/etc/postfix/main.cf</filename>, and "
"<filename>/etc/postfix/master.cf</filename>"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><indexterm><primary>
#: blfs-en/blfs-git/server/mail/postfix.xml:401
#, xml-text
msgid "/etc/aliases"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><indexterm><primary>
#: blfs-en/blfs-git/server/mail/postfix.xml:405
#, xml-text
msgid "/etc/postfix/*"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><title>
#: blfs-en/blfs-git/server/mail/postfix.xml:411
#, xml-text
msgid "Configuration Information"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/blfs-git/server/mail/postfix.xml:414
#, xml-text
msgid ""
"Create (or append to an existing) <filename>/etc/aliases</filename> with the"
" following command. Change <replaceable>&lt;LOGIN&gt;</replaceable> to your "
"non-root login identity so mail addressed to <systemitem "
"class=\"username\">root</systemitem> can be forwarded to you.  As the "
"<systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><screen>
#: blfs-en/blfs-git/server/mail/postfix.xml:422
#, no-wrap, xml-text
msgid ""
"<userinput>cat &gt;&gt; /etc/aliases &lt;&lt; \"EOF\"\n"
"<literal># Begin /etc/aliases\n"
"\n"
"MAILER-DAEMON:    postmaster\n"
"postmaster:       root\n"
"\n"
"root:             <replaceable>&lt;LOGIN&gt;</replaceable>\n"
"# End /etc/aliases</literal>\n"
"EOF</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/blfs-git/server/mail/postfix.xml:433
#, xml-text
msgid ""
"To protect an existing <filename>/etc/aliases</filename> file, the above "
"command appends these aliases to it if it exists. This file should be "
"checked and duplicate aliases removed, if present."
msgstr ""

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/blfs-git/server/mail/postfix.xml:439
#, xml-text
msgid ""
"The BLFS editors recommend to use LMDB instead of Berkeley DB for Postfix "
"tables.  Add three lines into <filename>/etc/postfix/main.cf</filename> to "
"make <command>postmap</command> encode the lookup tables in the LMDB format "
"by default and to change the default hash setting of the alias tables:"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><screen>
#: blfs-en/blfs-git/server/mail/postfix.xml:447
#, no-wrap, xml-text
msgid ""
"<userinput>echo 'default_database_type = lmdb'       &gt;&gt; /etc/postfix/main.cf &amp;&amp;\n"
"echo 'alias_database = lmdb:/etc/aliases' &gt;&gt; /etc/postfix/main.cf &amp;&amp;\n"
"echo 'alias_maps = lmdb:/etc/aliases'     &gt;&gt; /etc/postfix/main.cf</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/blfs-git/server/mail/postfix.xml:452
#, xml-text
msgid ""
"To protect your server against the recent SMTP smuggling attacks, additional"
" steps are required. Add two lines into "
"<filename>/etc/postfix/main.cf</filename> to disconnect remote SMTP clients "
"that send bare newlines in the DATA section, while also allowing clients on "
"your network with non-standard SMTP implementations to still send mail:"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><screen>
#: blfs-en/blfs-git/server/mail/postfix.xml:460
#, no-wrap, xml-text
msgid ""
"<userinput>echo 'smtpd_forbid_bare_newline = normalize' &gt;&gt; /etc/postfix/main.cf &amp;&amp;\n"
"echo 'smtpd_forbid_bare_newline_exclusions = $mynetworks' &gt;&gt; /etc/postfix/main.cf</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/blfs-git/server/mail/postfix.xml:464
#, xml-text
msgid ""
"Note that if you are following an online tutorial to configure Postfix, the "
"tutorial may refer to a lookup table with "
"<literal>hash:/path/to/lookup_table</literal>.  You should replace "
"<literal>hash</literal> with <literal>lmdb</literal> in order to use a "
"lookup table encoded in the LMDB format."
msgstr ""

#. type: Content of: <sect1><sect2><sect3><note><para>
#: blfs-en/blfs-git/server/mail/postfix.xml:473
#, xml-text
msgid ""
"The <filename>/etc/postfix/main.cf</filename> and "
"<filename>/etc/postfix/master.cf</filename> files must be personalized for "
"your system. The <filename>main.cf</filename> file needs your fully "
"qualified hostname. You will find that <filename>main.cf</filename> is self "
"documenting, so load it into your editor to make the changes you need for "
"your situation."
msgstr ""

#. type: Content of: <sect1><sect2><sect3><note><para>
#: blfs-en/blfs-git/server/mail/postfix.xml:484
#, xml-text
msgid ""
"<application>Postfix</application> can also be set up to run in a chroot "
"jail. See the file in the source <filename>examples/chroot-"
"setup/LINUX2</filename> for details."
msgstr ""

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/blfs-git/server/mail/postfix.xml:491
#, xml-text
msgid ""
"To ensure that all permissions are set properly, "
"<application>postfix</application> provides a tool which is to be run as the"
" <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><screen>
#: blfs-en/blfs-git/server/mail/postfix.xml:496
#, no-wrap, xml-text
msgid ""
"<userinput>/usr/sbin/postfix -c /etc/postfix set-permissions</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/blfs-git/server/mail/postfix.xml:499
#, xml-text
msgid ""
"If you have an existing configuration, you can run the "
"<command>postfix</command> utility to add any necessary definitions to your "
"existing files. As the <systemitem class=\"username\">root</systemitem> "
"user:"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><screen>
#: blfs-en/blfs-git/server/mail/postfix.xml:505
#, no-wrap, xml-text
msgid "<userinput>/usr/sbin/postfix upgrade-configuration</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/blfs-git/server/mail/postfix.xml:508
#, xml-text
msgid ""
"Before starting <application>Postfix</application>, you should check that "
"your configuration and file permissions will work properly. Run the "
"following commands as the <systemitem class=\"username\">root</systemitem> "
"user to check and start your <application>Postfix</application> server:"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><screen>
#: blfs-en/blfs-git/server/mail/postfix.xml:514
#, no-wrap, xml-text
msgid ""
"<userinput>/usr/sbin/postfix check &amp;&amp;\n"
"/usr/sbin/postfix start</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><title>
#: blfs-en/blfs-git/server/mail/postfix.xml:520
#, xml-text
msgid ""
"<phrase revision=\"sysv\">Boot Script</phrase> <phrase "
"revision=\"systemd\">Systemd Unit</phrase>"
