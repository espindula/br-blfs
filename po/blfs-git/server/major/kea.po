#. type: Content of: <sect1><sect2><indexterm><primary>
#: blfs-en/blfs-git/server/major/kea.xml:120
#, xml-text
msgid "Kea"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/server/major/kea.xml:126
#, xml-text
msgid "Installation of ISC Kea DHCP Server"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/server/major/kea.xml:129
#, xml-text
msgid "First, apply a few fixes required for boost-&boost-version;:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/server/major/kea.xml:132
#, no-wrap, xml-text
msgid ""
"<userinput>sed -e \"/asio_wrapper/a#include &lt;boost/asio/deadline_timer.hpp&gt;\" \\\n"
"    -i src/lib/asiolink/interval_timer.cc                        \\\n"
"       src/lib/asiodns/io_fetch.cc                               \\\n"
"       src/lib/asiodns/tests/io_fetch_unittest.cc                &amp;&amp;\n"
"sed -e \"/lexical_cast.hpp/a #include &lt;boost/static_assert.hpp&gt;\"  \\\n"
"    -i src/lib/log/logger_level_impl.cc</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/server/major/kea.xml:140
#, xml-text
msgid ""
"Now, install <application>ISC Kea DHCP Server</application> by running the "
"following commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/server/major/kea.xml:144
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup ..             \\\n"
"      --prefix=/usr        \\\n"
"      --sysconfdir=/etc    \\\n"
"      --localstatedir=/var \\\n"
"      --buildtype=release  \\\n"
"      -D crypto=openssl    \\\n"
"      -D runstatedir=/run  &amp;&amp;\n"
"\n"
"ninja</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/server/major/kea.xml:158
#, xml-text
msgid ""
"If tests were enabled, run <command>ninja test</command> to test the "
"results. There are tests which require a live database when any of the "
"database hooks are built. Some tests may fail if IPv6 support is not "
"functional."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/server/major/kea.xml:165
#, xml-text
msgid ""
"To install the <application>ISC Kea DHCP Server</application> suite, issue "
"the following commands as the <systemitem "
"class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/server/major/kea.xml:170
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/server/major/kea.xml:173
#, xml-text
msgid ""
"Fix some hard coded paths in the <command>keactrl</command> script and in "
"it's configuration file:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/server/major/kea.xml:177
#, no-wrap, xml-text
msgid ""
"<userinput>sed -e \"s:\\${prefix}/::\" -i /usr/sbin/keactrl             &amp;&amp;\n"
"sed -e \"s:\\${prefix}//etc:/etc:\" -i /etc/kea/keactrl.conf</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/server/major/kea.xml:181
#, xml-text
msgid ""
"Create some directories and fix their permission settings as the <systemitem"
" class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/server/major/kea.xml:185
#, no-wrap, xml-text
msgid ""
"<userinput>install -dm0750 /var/lib/kea\n"
"install -dm0750 /var/log/kea</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/server/major/kea.xml:191
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/server/major/kea.xml:194
#, xml-text
msgid ""
"<option>-D crypto=openssl</option>: Allows using OpenSSL for communicating "
"with the control-agent and for DNS updates. Use <option>-D "
"crypto=botan</option> if you want to use botan.  The default provider is "
"openssl."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/server/major/kea.xml:201
#, xml-text
msgid ""
"<option>-D postgresql=enabled</option> or <option>-D mysql=enabled</option>:"
" <application>ISC Kea</application> can store the leases on a database. This"
" might be useful in large environments running a cluster of DHCP servers. "
"Using the <emphasis>memfile</emphasis> backend (which is a CSV file stored "
"locally) is possible anyhow."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/server/major/kea.xml:209
#, xml-text
msgid ""
"<option>-D tests=enabled</option>: This option is required to build the test"
" suite. Using this option causes the build size to increase significantly, "
"so it should only be enabled if you are going to run the test suite."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/server/major/kea.xml:216
#, xml-text
msgid ""
"<option>-D krb5=enabled</option>: This switch enables integration with "
"Kerberos for authenticating client computers in an enterprise environment."
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/server/major/kea.xml:223
#, xml-text
msgid "Configuring ISC Kea DHCP Server"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/server/major/kea.xml:226
#, xml-text
msgid ""
"The support of IPv4, IPv6 and DDNS has been split into separate servers "
"which run independently from each other. Each of them has its own "
"configuration file.<phrase revision=\"sysv\"> Additional configuration files"
" come from the keactrl agent which is used to control the servers in an "
"easier way.</phrase>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/server/major/kea.xml:233
#, xml-text
msgid ""
"Note that the Kea Control Agent is deprecated since version 3.0.0. Do not "
"confuse <application>kea-ctrl-agent</application> with "
"<application>keactrl</application>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/server/major/kea.xml:239
#, xml-text
msgid ""
"Consult the <ulink url=\"https://kea.readthedocs.io/en/kea-&kea-arm-"
"vers;/\"> Kea Administrator Reference Manual</ulink> for detailed "
"information about the configuration of <application>ISC Kea</application> as"
" it is a quite capable system.  The configuration shown below is a bare "
"minimum to get a DHCP server running but it already includes configuration "
"for DDNS (Dynamic DNS).  That setup is best for small networks with a few "
"clients and low amounts of network traffic. For larger installations with "
"thousands of clients, <application>ISC Kea</application> can be configured "
"to use databases such as (mariadb or postgresql) to store the leases and "
"build a cluster with multiple nodes. It can be integrated with <ulink "
"url=\"https://www.isc.org/categories/stork/\">ISC Stork</ulink>, which is a "
"management dashboard to <application>ISC Kea</application>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/server/major/kea.xml:256
#, xml-text
msgid ""
"If you want to start the DHCP Server at boot, install the <phrase "
"revision=\"sysv\"><filename>/etc/rc.d/init.d/kea-dhcpd</filename> init "
"script</phrase> <phrase revision=\"systemd\"><filename>kea-"
"dhcpd.service</filename> unit</phrase> included in the <xref "
"linkend=\"bootscripts\" revision=\"sysv\"/> <xref linkend=\"systemd-units\" "
"revision=\"systemd\"/> package:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/server/major/kea.xml:266
#, no-wrap, xml-text
msgid "<userinput>make install-kea-dhcpd</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><title>
#: blfs-en/blfs-git/server/major/kea.xml:269
#, xml-text
msgid "Config Files"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/blfs-git/server/major/kea.xml:272
#, xml-text
msgid ""
"<phrase revision=\"sysv\"> <filename>/etc/kea/keactrl.conf</filename>, "
"</phrase> <filename>/etc/kea/kea-ctrl-agent.conf</filename>, "
"<filename>/etc/kea/kea-dhcp4.conf</filename>, <filename>/etc/kea/kea-"
"dhcp6.conf</filename>, and <filename>/etc/kea/kea-dhcp-ddns.conf</filename>"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><indexterm><primary>
#: blfs-en/blfs-git/server/major/kea.xml:282
#, xml-text
msgid "/etc/kea/keactrl.conf"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><indexterm><primary>
#: blfs-en/blfs-git/server/major/kea.xml:286
#, xml-text
msgid "/etc/kea/kea-ctrl-agent.conf"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><indexterm><primary>
#: blfs-en/blfs-git/server/major/kea.xml:290
#, xml-text
msgid "/etc/kea/kea-dhcp4.conf"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><indexterm><primary>
#: blfs-en/blfs-git/server/major/kea.xml:294
#, xml-text
msgid "/etc/kea/kea-dhcp6.conf"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><indexterm><primary>
#: blfs-en/blfs-git/server/major/kea.xml:298
#, xml-text
msgid "/etc/kea/kea-dhcp-ddns.conf"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><title>
#: blfs-en/blfs-git/server/major/kea.xml:303
#, xml-text
msgid "Kea Control Configuration"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/blfs-git/server/major/kea.xml:305
#, xml-text
msgid ""
"<command>keactrl</command> is used to control the independent servers (IPv4,"
" IPv6, DDNS). Its configuration file, "
"<filename>/etc/kea/keactrl.conf</filename>, is installed by default and "
"includes many path settings which are defined from the "
"<command>configure</command> at build time. It also includes settings to "
"specify which of the servers should be started."
msgstr ""

#. type: Content of: <sect1><sect2><sect3><itemizedlist><listitem><para>
#: blfs-en/blfs-git/server/major/kea.xml:315
#: blfs-en/blfs-git/server/major/kea.xml:380
#, xml-text
msgid "Control Agent"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><itemizedlist><listitem><para>
#: blfs-en/blfs-git/server/major/kea.xml:316
#, xml-text
msgid ""
"The Control Agent is a daemon which allows the (re)configuration of the Kea "
"DHCP service via REST API.  Set <literal>ctrl_agent=yes</literal> to start "
"the control agent (service providing a REST API), set "
"<literal>ctrl_agent=no</literal> in case the control agent is not needed."
msgstr ""

#. type: Content of: <sect1><sect2><sect3><itemizedlist><listitem><para>
#: blfs-en/blfs-git/server/major/kea.xml:324
#: blfs-en/blfs-git/server/major/kea.xml:389
#, xml-text
msgid "IPv4 DHCP server"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><itemizedlist><listitem><para>
#: blfs-en/blfs-git/server/major/kea.xml:325
#, xml-text
msgid ""
"This daemon handles requests for IPv4 addresses.  Set "
"<literal>dhcp4=yes</literal> to start it, set <literal>dhcp4=no</literal> in"
" case the IPv4 service is not needed."
msgstr ""

#. type: Content of: <sect1><sect2><sect3><itemizedlist><listitem><para>
#: blfs-en/blfs-git/server/major/kea.xml:331
#: blfs-en/blfs-git/server/major/kea.xml:397
#, xml-text
msgid "IPv6 DHCP server"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><itemizedlist><listitem><para>
#: blfs-en/blfs-git/server/major/kea.xml:332
#, xml-text
msgid ""
"This daemon handles requests for IPv6 addresses.  Set "
"<literal>dhcp6=yes</literal> to start it, set <literal>dhcp6=no</literal> in"
" case the IPv6 service is not needed."
msgstr ""

#. type: Content of: <sect1><sect2><sect3><itemizedlist><listitem><para>
#: blfs-en/blfs-git/server/major/kea.xml:338
#: blfs-en/blfs-git/server/major/kea.xml:405
#, xml-text
msgid "Dynamic DNS"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><itemizedlist><listitem><para>
#: blfs-en/blfs-git/server/major/kea.xml:339
#, xml-text
msgid ""
"This daemon is used to update a DNS server dynamically when Kea assigns an "
"IP address to a device.  Set <literal>dhcp_ddns=yes</literal> to enable it, "
"set <literal>dhcp_ddns=no</literal> if dynamic DNS updates are not needed."
msgstr ""

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/blfs-git/server/major/kea.xml:348
#: blfs-en/blfs-git/server/major/kea.xml:416
#, xml-text
msgid ""
"The Netconf service is not installed because the required dependencies are "
"not installed by BLFS, and configuring it correctly is complicated."
msgstr ""

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/blfs-git/server/major/kea.xml:353
#, xml-text
msgid ""
"With the following command, Kea will be configured to start the DHCP service"
" for IPv4 and the dynamic DNS update, while the control agent and the DHCP "
"service for IPv6 remain down. Tweak the command to match your needs on "
"started services and execute as the &root; user:"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><screen>
#: blfs-en/blfs-git/server/major/kea.xml:361
#, no-wrap, xml-text
msgid ""
"<userinput>sed -e \"s/^dhcp4=.*/dhcp4=yes/\" \\\n"
"    -e \"s/^dhcp6=.*/dhcp6=no/\" \\\n"
"    -e \"s/^dhcp_ddns=.*/dhcp_ddns=yes/\" \\\n"
"    -e \"s/^ctrl_agent=.*/ctrl_agent=no/\" \\\n"
"    -i /etc/kea/keactrl.conf\n"
"</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><title>
#: blfs-en/blfs-git/server/major/kea.xml:371
#, xml-text
msgid "Kea Configuration Using Systemd Units"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/blfs-git/server/major/kea.xml:374
#, xml-text
msgid "Four service units are used to start various daemons provided by Kea:"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><itemizedlist><listitem><para>
#: blfs-en/blfs-git/server/major/kea.xml:382
#, xml-text
msgid ""
"The Control Agent is a daemon which allows the (re)configuration of the Kea "
"DHCP service via REST API.  Run <command>systemctl enable kea-ctrl-"
"agent</command> if this daemon is needed."
msgstr ""

#. type: Content of: <sect1><sect2><sect3><itemizedlist><listitem><para>
#: blfs-en/blfs-git/server/major/kea.xml:391
#, xml-text
msgid ""
"This daemon handles requests for IPv4 addresses.  Run <command>systemctl "
"enable kea-dhcp4-server</command> to have it started by systemd."
msgstr ""

#. type: Content of: <sect1><sect2><sect3><itemizedlist><listitem><para>
#: blfs-en/blfs-git/server/major/kea.xml:399
#, xml-text
msgid ""
"This daemon handles requests for IPv6 addresses.  Run <command>systemctl "
"enable kea-dhcp6-server</command> to have it started by systemd."
msgstr ""

#. type: Content of: <sect1><sect2><sect3><itemizedlist><listitem><para>
#: blfs-en/blfs-git/server/major/kea.xml:407
#, xml-text
msgid ""
"This daemon is used to update a DNS server dynamically when Kea assigns an "
"IP address to a device.  Run <command>systemctl enable kea-ddns-"
"server</command> to have it started by systemd."
msgstr ""

#. type: Content of: <sect1><sect2><sect3><title>
#: blfs-en/blfs-git/server/major/kea.xml:423
#, xml-text
msgid "Control Agent Configuration"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/blfs-git/server/major/kea.xml:426
#, xml-text
msgid ""
"The provided configuration could be used without changes. However, in BLFS, "
"objects like sockets are stored in <filename "
"class=\"directory\">/run</filename> rather than in <filename "
"class=\"directory\">/tmp</filename>."
msgstr ""

#. type: Content of: <sect1><sect2><sect3><screen>
#: blfs-en/blfs-git/server/major/kea.xml:433
#, no-wrap, xml-text
msgid ""
"<userinput>cat &gt; /etc/kea/kea-ctrl-agent.conf &lt;&lt; \"EOF\"\n"
"<literal>// Begin /etc/kea/kea-ctrl-agent.conf\n"
"{\n"
"  // This is a basic configuration for the Kea Control Agent.\n"
"  // The RESTful interface will be available at http://127.0.0.1:8000/\n"
"  \"Control-agent\": {\n"
"    \"http-host\": \"127.0.0.1\",\n"
"    \"http-port\": 8000,\n"
"    \"control-sockets\": {\n"
"      \"dhcp4\": {\n"
"        \"socket-type\": \"unix\",\n"
"        \"socket-name\": \"/run/kea/kea4-ctrl-socket\"\n"
"      },\n"
"      \"dhcp6\": {\n"
"        \"socket-type\": \"unix\",\n"
"        \"socket-name\": \"/run/kea/kea6-ctrl-socket\"\n"
"      },\n"
"      \"d2\": {\n"
"        \"socket-type\": \"unix\",\n"
"        \"socket-name\": \"/run/kea/kea-ddns-ctrl-socket\"\n"
"      }\n"
"    },\n"
"\n"
"    \"loggers\": [\n"
"      {\n"
"        \"name\": \"kea-ctrl-agent\",\n"
"        \"output_options\": [\n"
"          {\n"
"            \"output\": \"/var/log/kea/kea-ctrl-agent.log\",\n"
"            \"pattern\": \"%D{%Y-%m-%d %H:%M:%S.%q} %-5p %m\\n\"\n"
"          }\n"
"        ],\n"
"        \"severity\": \"INFO\",\n"
"        \"debuglevel\": 0\n"
"      }\n"
"    ]\n"
"  }\n"
"}\n"
"// End /etc/kea/kea-ctrl-agent.conf</literal>\n"
"EOF</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><title>
#: blfs-en/blfs-git/server/major/kea.xml:477
#, xml-text
msgid "IPv4 DHCP Server Configuration"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/blfs-git/server/major/kea.xml:480
#, xml-text
msgid ""
"A sample configuration file is created in <filename>/etc/kea/kea-"
"dhcp4.conf</filename>.  Adjust the file to suit your needs or overwrite it "
"by running the following command as the &root; user (you'll need to edit "
"this file anyway: at least the <emphasis>interfaces</emphasis> field, the "
"<emphasis>ddns-qualifying-suffix</emphasis> field, and almost all the fields"
" in <emphasis>Subnet4</emphasis>):"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><screen>
#: blfs-en/blfs-git/server/major/kea.xml:488
#, no-wrap, xml-text
msgid ""
"<userinput>cat &gt; /etc/kea/kea-dhcp4.conf &lt;&lt; \"EOF\"\n"
"<literal>// Begin /etc/kea/kea-dhcp4.conf\n"
"{\n"
"  \"Dhcp4\": {\n"
"    // Add names of your network interfaces to listen on.\n"
"    \"interfaces-config\": {\n"
"      \"interfaces\": [ \"eth0\", \"eth2\" ]\n"
"    },\n"
"\n"
"    \"control-socket\": {\n"
"      \"socket-type\": \"unix\",\n"
"      \"socket-name\": \"/run/kea/kea4-ctrl-socket\"\n"
"    },\n"
"\n"
"    \"lease-database\": {\n"
"      \"type\": \"memfile\",\n"
"      \"lfc-interval\": 3600,\n"
"      \"name\": \"/var/lib/kea/kea-leases4.csv\"\n"
"    },\n"
"\n"
"    \"expired-leases-processing\": {\n"
"      \"reclaim-timer-wait-time\": 10,\n"
"      \"flush-reclaimed-timer-wait-time\": 25,\n"
"      \"hold-reclaimed-time\": 3600,\n"
"      \"max-reclaim-leases\": 100,\n"
"      \"max-reclaim-time\": 250,\n"
"      \"unwarned-reclaim-cycles\": 5\n"
"    },\n"
"\n"
"    \"renew-timer\": 900,\n"
"    \"rebind-timer\": 1800,\n"
"    \"valid-lifetime\": 3600,\n"
"\n"
"    // Enable DDNS - Kea will dynamically update the BIND DNS server\n"
"    \"ddns-send-updates\" : true,\n"
"    \"ddns-qualifying-suffix\": \"your.domain.tld\",\n"
"    \"dhcp-ddns\" : {\n"
"      \"enable-updates\": true\n"
"    },\n"
"\n"
"    \"subnet4\": [\n"
"      {\n"
"        \"id\": 1001,   // Each subnet requires a unique numeric id\n"
"        \"subnet\": \"192.168.56.0/24\",\n"
"        \"pools\": [ { \"pool\": \"192.168.56.16 - 192.168.56.254\" } ],\n"
"        \"option-data\": [\n"
"          {\n"
"            \"name\": \"domain-name\",\n"
"            \"data\": \"your.domain.tld\"\n"
"          },\n"
"          {\n"
"            \"name\": \"domain-name-servers\",\n"
"            \"data\": \"192.168.56.2, 192.168.3.7\"\n"
"          },\n"
"          {\n"
"            \"name\": \"domain-search\",\n"
"            \"data\": \"your.domain.tld\"\n"
"          },\n"
"          {\n"
"            \"name\": \"routers\",\n"
"            \"data\": \"192.168.56.2\"\n"
"          }\n"
"        ]\n"
"      }\n"
"    ],\n"
"\n"
"    \"loggers\": [\n"
"      {\n"
"        \"name\": \"kea-dhcp4\",\n"
"        \"output_options\": [\n"
"          {\n"
"            \"output\": \"/var/log/kea/kea-dhcp4.log\",\n"
"            \"pattern\": \"%D{%Y-%m-%d %H:%M:%S.%q} %-5p %m\\n\"\n"
"          }\n"
"        ],\n"
"        \"severity\": \"INFO\",\n"
"        \"debuglevel\": 0\n"
"      }\n"
"    ]\n"
"  }\n"
"}\n"
"// End /etc/kea/kea-dhcp4.conf</literal>\n"
"EOF</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><title>
