msgstr ""

#. type: Content of: <sect1><sect2><sect3><indexterm><primary>
#: blfs-en/blfs-git/server/major/bind.xml:278
#, xml-text
msgid "/etc/named.conf"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><indexterm><primary>
#: blfs-en/blfs-git/server/major/bind.xml:282
#, xml-text
msgid "/etc/rndc.conf"
