#. type: Content of: <sect3><title>
#: blfs-en/blfs-git/xincludes/pip3-cmd-explain.xml:9
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect3><para>
#: blfs-en/blfs-git/xincludes/pip3-cmd-explain.xml:12
#, xml-text
msgid ""
"<parameter>-w dist</parameter>: builds the appropriate \"wheel\" for this "
"module in the directory <filename class=\"directory\">dist</filename>."
msgstr ""

#. type: Content of: <sect3><para>
#: blfs-en/blfs-git/xincludes/pip3-cmd-explain.xml:18
#, xml-text
msgid ""
"<parameter>--no-build-isolation</parameter>: tells pip3 to run the build in "
"the system environment instead of creating a temporary build environment."
msgstr ""

#. type: Content of: <sect3><para>
#: blfs-en/blfs-git/xincludes/pip3-cmd-explain.xml:24
#, xml-text
msgid ""
"<parameter>--no-deps</parameter>: prevents pip3 from building wheels for the"
" project's dependencies."
msgstr ""

#. type: Content of: <sect3><para>
#: blfs-en/blfs-git/xincludes/pip3-cmd-explain.xml:29
#, xml-text
msgid ""
"<parameter>--no-index</parameter>: ignores the package index (only looking "
"at --find-links URLs instead)."
msgstr ""

#. type: Content of: <sect3><para>
#: blfs-en/blfs-git/xincludes/pip3-cmd-explain.xml:34
#, xml-text
msgid ""
"<parameter>--find-links dist</parameter>: looks for links to archives such "
"as wheel (.whl) files in the directory <filename "
"class=\"directory\">dist</filename>."
msgstr ""

#. type: Content of: <sect3><para>
#: blfs-en/blfs-git/xincludes/pip3-cmd-explain.xml:40
#, xml-text
msgid ""
"<parameter>--no-cache-dir</parameter>: Disables the cache to prevent a "
"warning when installing as the &root; user."
msgstr ""

#. type: Content of: <sect3><para>
#: blfs-en/blfs-git/xincludes/pip3-cmd-explain.xml:45
#, xml-text
msgid ""
"<parameter>--no-user</parameter>: Prevent mistakenly running the install "
"command as a non-root user."
msgstr ""

#. type: Content of: <sect3><para>
#: blfs-en/blfs-git/xincludes/pip3-cmd-explain.xml:50
#, xml-text
msgid ""
"<option>--upgrade</option>: Upgrade the package to the newest available "
"version.  This option is used with the install command if a version of the "
"package is already installed."
msgstr ""

#. type: Content of: <sect3><para>
#: blfs-en/blfs-git/xincludes/pip3-cmd-explain.xml:56
#, xml-text
msgid ""
"<option>--force-reinstall</option>: Reinstall the package even if it is up-"
"to-date. This option is used with the install command if reinstalling the "
"package or reverting to an earlier version of the package."
msgstr ""

#. type: Content of: <sect3><para>
#: blfs-en/blfs-git/xincludes/pip3-cmd-explain.xml:63
#, xml-text
msgid ""
"<option>--no-deps</option>: Do not install package dependencies.  This "
"option may be needed with the --upgrade or --force-reinstall options."
msgstr ""
