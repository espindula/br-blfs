#. type: Content of: <sect1><title>
#: blfs-en/blfs-git/book/organization.xml:8
#: blfs-en/blfs-git/book/organization.xml:12
#, xml-text
msgid "Organization"
msgstr ""

#. type: Content of: <sect1><para>
#: blfs-en/blfs-git/book/organization.xml:15
#, xml-text
msgid "This book is divided into the following fourteen parts."
msgstr ""

#. type: Content of: <sect1><bridgehead>
#: blfs-en/blfs-git/book/organization.xml:18
#, xml-text
msgid "Part I - Introduction"
msgstr ""

#. type: Content of: <sect1><para>
#: blfs-en/blfs-git/book/organization.xml:21
#, xml-text
msgid ""
"This part contains essential information which is needed to understand the "
"rest of the book."
msgstr ""

#. type: Content of: <sect1><bridgehead>
#: blfs-en/blfs-git/book/organization.xml:25
#, xml-text
msgid "Part II - Post LFS Configuration and Extra Software"
msgstr ""

#. type: Content of: <sect1><para>
#: blfs-en/blfs-git/book/organization.xml:29
#, xml-text
msgid ""
"Here we introduce basic configuration and security issues.  We also discuss "
"a range of text editors, file systems, and shells which aren't covered in "
"the main LFS book."
msgstr ""

#. type: Content of: <sect1><bridgehead>
#: blfs-en/blfs-git/book/organization.xml:34
#, xml-text
msgid "Part III - General Libraries and Utilities"
msgstr ""

#. type: Content of: <sect1><para>
#: blfs-en/blfs-git/book/organization.xml:37
#, xml-text
msgid ""
"In this section we cover libraries which are often needed throughout the "
"book, as well as system utilities.  Information on programming (including "
"recompiling <application>GCC</application> to support its full range of "
"languages) concludes this part."
msgstr ""

#. type: Content of: <sect1><bridgehead>
#: blfs-en/blfs-git/book/organization.xml:43
#, xml-text
msgid "Part IV - Basic Networking"
msgstr ""

#. type: Content of: <sect1><para>
#: blfs-en/blfs-git/book/organization.xml:46
#, xml-text
msgid ""
"Here we explain how to connect to a network when you aren't using the simple"
" static IP setup presented in the main LFS book. Networking libraries and "
"command-line networking tools are also covered here."
msgstr ""

#. type: Content of: <sect1><bridgehead>
#: blfs-en/blfs-git/book/organization.xml:51
#, xml-text
msgid "Part V - Servers"
msgstr ""

#. type: Content of: <sect1><para>
#: blfs-en/blfs-git/book/organization.xml:54
#, xml-text
msgid ""
"Here we show you how to set up mail and other servers (such as "
"<application>FTP</application>, <application>Apache</application>, etc.)."
msgstr ""

#. type: Content of: <sect1><bridgehead>
#: blfs-en/blfs-git/book/organization.xml:58
#, xml-text
msgid "Part VI - X + Window Managers"
msgstr ""

#. type: Content of: <sect1><para>
#: blfs-en/blfs-git/book/organization.xml:61
#, xml-text
msgid ""
"This part explains how to set up a basic <application>X Window "
"System</application>, along with some generic <application>X</application> "
"libraries and Window managers."
msgstr ""

#. type: Content of: <sect1><bridgehead>
#: blfs-en/blfs-git/book/organization.xml:66
#, xml-text
msgid "Part VII - KDE"
msgstr ""

#. type: Content of: <sect1><para>
#: blfs-en/blfs-git/book/organization.xml:69
#, xml-text
msgid ""
"This part is for those who want to use the <application>K Desktop "
"Environment</application>, or parts of it."
msgstr ""

#. type: Content of: <sect1><bridgehead>
#: blfs-en/blfs-git/book/organization.xml:73
#, xml-text
msgid "Part VIII - GNOME"
msgstr ""

#. type: Content of: <sect1><para>
#: blfs-en/blfs-git/book/organization.xml:76
#, xml-text
msgid ""
"<application>GNOME</application> is the main alternative to "
"<application>KDE</application> in the Desktop Environment arena."
msgstr ""

#. type: Content of: <sect1><bridgehead>
#: blfs-en/blfs-git/book/organization.xml:80
#, xml-text
msgid "Part IX - Xfce"
msgstr ""

#. type: Content of: <sect1><para>
#: blfs-en/blfs-git/book/organization.xml:83
#, xml-text
msgid ""
"<application>Xfce</application> is a lightweight alternative to "
"<application>GNOME</application> and <application>KDE</application>."
msgstr ""

#. type: Content of: <sect1><bridgehead>
#: blfs-en/blfs-git/book/organization.xml:87
#, xml-text
msgid "Part X - LXQt"
msgstr ""

#. type: Content of: <sect1><para>
#: blfs-en/blfs-git/book/organization.xml:90
#, xml-text
msgid ""
"<application>LXDE</application> is another lightweight alternative to "
"<application>GNOME</application> and <application>KDE</application>."
msgstr ""

#. type: Content of: <sect1><bridgehead>
#: blfs-en/blfs-git/book/organization.xml:94
#, xml-text
msgid "Part XI - More X Software"
msgstr ""

#. type: Content of: <sect1><para>
#: blfs-en/blfs-git/book/organization.xml:97
#, xml-text
msgid ""
"Office programs and graphical web browsers are important to most people.  "
"They, and some generic <application>X</application> software, can be found "
"in this part of the book."
msgstr ""

#. type: Content of: <sect1><bridgehead>
#: blfs-en/blfs-git/book/organization.xml:102
#, xml-text
msgid "Part XII - Multimedia"
msgstr ""

#. type: Content of: <sect1><para>
#: blfs-en/blfs-git/book/organization.xml:105
#, xml-text
msgid ""
"Here we cover multimedia libraries and drivers, along with some audio, "
"video, and CD-writing programs."
msgstr ""

#. type: Content of: <sect1><bridgehead>
#: blfs-en/blfs-git/book/organization.xml:109
#, xml-text
msgid "Part XIII - Printing, Scanning and Typesetting (PST)"
msgstr ""

#. type: Content of: <sect1><para>
#: blfs-en/blfs-git/book/organization.xml:113
#, xml-text
msgid ""
"This part covers document handling, from applications like "
"<application>Ghostscript</application>, <application>CUPS</application>, and"
" <application>DocBook</application>, all the way to "
"<application>texlive</application>."
msgstr ""

#. type: Content of: <sect1><bridgehead>
#: blfs-en/blfs-git/book/organization.xml:119
#, xml-text
msgid "Appendices"
msgstr ""

#. type: Content of: <sect1><para>
#: blfs-en/blfs-git/book/organization.xml:122
#, xml-text
msgid ""
"The Appendices present information which doesn't belong in the body of book;"
" they are included as reference material. The glossary of acronyms is a "
"handy feature."
msgstr ""
