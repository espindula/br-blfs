#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/x/icons/adwaita-icon-theme.xml:88
#, xml-text
msgid "Installation of Adwaita Icon Theme"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/icons/adwaita-icon-theme.xml:91
#, xml-text
msgid ""
"Install <application>Adwaita Icon Theme</application> by running the "
"following commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/x/icons/adwaita-icon-theme.xml:95
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr .. &amp;&amp;\n"
"ninja</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/icons/adwaita-icon-theme.xml:102
#, xml-text
msgid "This package does not come with a test suite."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/icons/adwaita-icon-theme.xml:106
#, xml-text
msgid "Remove any old icons and install the new ones. As the &root; user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/x/icons/adwaita-icon-theme.xml:109
#, no-wrap, xml-text
msgid ""
"<userinput>rm -rf /usr/share/icons/Adwaita/ &amp;&amp;\n"
"ninja install</userinput>"
msgstr ""

