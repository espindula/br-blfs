#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/x/icons/breeze-icons.xml:88
#, xml-text
msgid "Installation of Breeze Icons"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/icons/breeze-icons.xml:91
#, xml-text
msgid ""
"Install <application>Breeze Icons</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/x/icons/breeze-icons.xml:95
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr \\\n"
"      -D BUILD_TESTING=OFF         \\\n"
"      -W no-dev ..                 &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/icons/breeze-icons.xml:104
#, xml-text
msgid "This package does not come with a test suite."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/icons/breeze-icons.xml:108
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/x/icons/breeze-icons.xml:111
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/x/icons/breeze-icons.xml:116
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/icons/breeze-icons.xml:119
#, xml-text
msgid ""
"<parameter>-D BUILD_TESTING=OFF</parameter>: This parameter disables "
"building the testing framework, which requires some modules from <xref "
"linkend=\"kf6-frameworks\"/>."
msgstr ""

