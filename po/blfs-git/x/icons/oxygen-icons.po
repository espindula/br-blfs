#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/x/icons/oxygen-icons.xml:94
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr -W no-dev ..</userinput>"
msgstr ""

