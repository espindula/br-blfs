#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/x/dm/lightdm.xml:154
#, xml-text
msgid "Installation of Lightdm"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/dm/lightdm.xml:157
#, xml-text
msgid ""
"First, create a dedicated user and group to take control of the "
"<command>lightdm</command> daemon after it is started. Issue the following "
"commands as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/x/dm/lightdm.xml:163
#, no-wrap, xml-text
msgid ""
"<userinput>groupadd -g 65 lightdm       &amp;&amp;\n"
"useradd  -c \"Lightdm Daemon\" \\\n"
"         -d /var/lib/lightdm \\\n"
"         -u 65 -g lightdm    \\\n"
"         -s /bin/false lightdm</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/dm/lightdm.xml:170
#, xml-text
msgid ""
"Then change the <application>Linux-PAM</application> configuration files so "
"that <application>elogind</application> is used:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/x/dm/lightdm.xml:174
#, no-wrap, xml-text
msgid "<userinput>sed -i s/systemd/elogind/ data/pam/*</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/dm/lightdm.xml:177
#, xml-text
msgid ""
"Install <application>lightdm</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/x/dm/lightdm.xml:181
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr                 \\\n"
"            --libexecdir=/usr/lib/lightdm \\\n"
"            --localstatedir=/var          \\\n"
"            --sbindir=/usr/bin            \\\n"
"            --sysconfdir=/etc             \\\n"
"            --disable-static              \\\n"
"            --disable-tests               \\\n"
"            --with-greeter-user=lightdm   \\\n"
"            --with-greeter-session=lightdm-gtk-greeter \\\n"
"            --docdir=/usr/share/doc/lightdm-&lightdm-version; &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/dm/lightdm.xml:194
#, xml-text
msgid "This package does not come with a test suite."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/dm/lightdm.xml:198 blfs-en/blfs-git/x/dm/lightdm.xml:231
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/x/dm/lightdm.xml:201
#, no-wrap, xml-text
msgid ""
"<userinput>make install                                                  &amp;&amp;\n"
"cp tests/src/lightdm-session /usr/bin                         &amp;&amp;\n"
"sed -i '1 s/sh/bash --login/' /usr/bin/lightdm-session        &amp;&amp;\n"
"rm -rf /etc/init                                              &amp;&amp;\n"
"install -v -dm755 -o lightdm -g lightdm /var/lib/lightdm      &amp;&amp;\n"
"install -v -dm755 -o lightdm -g lightdm /var/lib/lightdm-data &amp;&amp;\n"
"install -v -dm755 -o lightdm -g lightdm /var/cache/lightdm    &amp;&amp;\n"
"install -v -dm770 -o lightdm -g lightdm /var/log/lightdm</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/dm/lightdm.xml:211
#, xml-text
msgid "Now build the greeter:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/x/dm/lightdm.xml:214
#, no-wrap, xml-text
msgid ""
"<userinput>tar -xf ../lightdm-gtk-greeter-&lightdm-gtk-greeter-version;.tar.gz &amp;&amp;\n"
"cd lightdm-gtk-greeter-&lightdm-gtk-greeter-version; &amp;&amp;\n"
"\n"
"./configure --prefix=/usr                 \\\n"
"            --libexecdir=/usr/lib/lightdm \\\n"
"            --sbindir=/usr/bin            \\\n"
"            --sysconfdir=/etc             \\\n"
"            --with-libxklavier            \\\n"
"            --enable-kill-on-sigterm      \\\n"
"            --disable-libido              \\\n"
"            --disable-libindicator        \\\n"
"            --disable-static              \\\n"
"            --disable-maintainer-mode     \\\n"
"            --docdir=/usr/share/doc/lightdm-gtk-greeter-&lightdm-gtk-greeter-version; &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/x/dm/lightdm.xml:234
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><note><para>
#: blfs-en/blfs-git/x/dm/lightdm.xml:238
#, xml-text
msgid ""
"If you installed Xorg in /opt, you will need to create a symbolic link so "
"lightdm can find the Xorg server.  As the <systemitem "
"class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><note><screen>
#: blfs-en/blfs-git/x/dm/lightdm.xml:243
#, no-wrap, xml-text
msgid "<userinput>ln -sf /opt/xorg/bin/Xorg /usr/bin/X</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/x/dm/lightdm.xml:250
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/dm/lightdm.xml:253
#, xml-text
msgid ""
"<command>sed ... /usr/bin/lightdm-session</command>: This command ensures "
"that the initial login via the greeter sources /etc/profile and "
"~/.bash_profile.  Without this, commands that depend on different "
"environment variables may not work as expected."
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/x/dm/lightdm.xml:276
#, xml-text
msgid "Configuring lightdm"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><title>
#: blfs-en/blfs-git/x/dm/lightdm.xml:279
#, xml-text
msgid "Config Files"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/blfs-git/x/dm/lightdm.xml:282
#, xml-text
msgid "/etc/lightdm/{lightdm,users,keys,lightdm-gtk-greeter}.conf"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/blfs-git/x/dm/lightdm.xml:286
#, xml-text
msgid ""
"The configuration files offer many options. If, for instance, you have a "
"multiple monitor setup but prefer the login window to be displayed on only "
"one monitor, set 'active-monitor=&lt;monitor-name&gt;' in <filename>lightdm-"
"gtk-greeter.conf</filename>. For example you could use <option>active-"
"monitor=HDMI-1</option>.  You can determine the monitor-names with "
"<command>xrandr --listmonitors</command>. Note that the monitor names may "
"change if you change the graphics driver and you may have to adjust the "
"configuration accordingly."
msgstr ""

#. type: Content of: <sect1><sect2><sect3><indexterm><primary>
#: blfs-en/blfs-git/x/dm/lightdm.xml:297
#, xml-text
