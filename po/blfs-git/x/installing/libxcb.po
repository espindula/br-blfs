#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/x/installing/libxcb.xml:94
#, xml-text
msgid "Installation of libxcb"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/installing/libxcb.xml:97
#, xml-text
msgid ""
"Install <application>libxcb</application> by running the following commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/x/installing/libxcb.xml:101
#, no-wrap, xml-text
msgid ""
"<userinput>./configure $XORG_CONFIG      \\\n"
"            --without-doxygen \\\n"
"            --docdir='${datadir}'/doc/libxcb-&libxcb-version; &amp;&amp;\n"
"LC_ALL=en_US.UTF-8 make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/installing/libxcb.xml:107
#, xml-text
msgid "To test the results, issue: <command>make check</command>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/installing/libxcb.xml:111
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/x/installing/libxcb.xml:114
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/installing/libxcb.xml:117
#, xml-text
msgid ""
"If the package was built as a non-&root; user, the installed documentation "
"is now owned by this user.  As the &root; user, fix the ownership:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/x/installing/libxcb.xml:122
#, no-wrap, xml-text
msgid ""
"<userinput>chown -Rv root:root $XORG_PREFIX/share/doc/libxcb-&libxcb-"
"version;</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/x/installing/libxcb.xml:127
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/installing/libxcb.xml:131
#, xml-text
msgid ""
"<envar>LC_ALL=en_US.UTF-8</envar>: Some Python 3 script in the building "
"system of this package may fail with certain system locale settings.  This "
"environment variable forces a locale setting known to work."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/installing/libxcb.xml:138
#, xml-text
msgid ""
"<parameter>--without-doxygen</parameter>: Do not use doxygen to generate API"
" documentation (default: auto). Without it, if <xref linkend=\"doxygen\"/> "
"is installed, the API documentation will be generated and installed."
msgstr ""

