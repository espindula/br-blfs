#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/blfs-git/x/installing/xwayland.xml:73
#, xml-text
msgid "Required"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/installing/xwayland.xml:75
#, xml-text
msgid ""
"<xref linkend=\"libxcvt\"/>, <xref linkend=\"pixman\"/>, <xref "
"linkend=\"wayland-protocols\"/>, <xref role='runtime' "
"linkend=\"xorg7-app\"/> (runtime), and <xref linkend=\"xorg7-font\"/> (only "
"font-util)"
msgstr ""

#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/blfs-git/x/installing/xwayland.xml:82
#, xml-text
msgid "Recommended"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/installing/xwayland.xml:84
#, xml-text
msgid ""
"<xref linkend=\"libepoxy\"/>, <xref linkend=\"libtirpc\"/>, and <xref "
"linkend=\"mesa\"/>"
msgstr ""

#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/blfs-git/x/installing/xwayland.xml:89
#, xml-text
msgid "Optional"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/installing/xwayland.xml:91
#, xml-text
msgid ""
"<xref linkend=\"git\"/> (to download packages needed for the tests), <xref "
"linkend=\"libei\"/>, <xref linkend=\"libgcrypt\"/>, <xref "
"linkend=\"nettle\"/>, <xref linkend=\"xmlto\"/>, <xref "
"linkend=\"xorg7-legacy\"/> (only bdftopcf, for building fonts required for "
"the tests), <ulink "
"url=\"https://gitlab.freedesktop.org/xorg/test/rendercheck\">rendercheck</ulink>"
" (for tests), and <ulink "
"url=\"https://wayland.pages.freedesktop.org/weston/\">weston</ulink> (for "
"tests)"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/x/installing/xwayland.xml:105
#, xml-text
msgid "Installation of Xwayland"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/installing/xwayland.xml:108
#, xml-text
msgid ""
"Install <application>xwayland</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/x/installing/xwayland.xml:112
#, no-wrap, xml-text
msgid ""
"<userinput>sed -i '/install_man/,$d' meson.build &amp;&amp;\n"
"\n"
"mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup ..              \\\n"
"      --prefix=$XORG_PREFIX \\\n"
"      --buildtype=release   \\\n"
"      -D xkb_output_dir=/var/lib/xkb &amp;&amp;\n"
"ninja</userinput>"
msgstr ""

#.  keep 22.1 above: they used to build it in gitlab-ci because debian
#.      had an obsolete version of weston, but now they take weston from
#.      debian so the command to build it has been removed.
#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/installing/xwayland.xml:124
#, xml-text
msgid ""
"Building the test framework needs some work. First, <ulink "
"url=\"https://wayland.pages.freedesktop.org/weston/\">weston</ulink> brings "
"in several dependencies, but the number can be reduced by disabling unneeded"
" features. The <command>meson</command> command for a stripped down build of"
" <application>weston</application> is shown in <ulink "
"url=\"https://gitlab.freedesktop.org/xorg/xserver/-/blob/xwayland-22.1/.gitlab-"
"ci/debian-install.sh\"> Upstream continuous integration build</ulink>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/installing/xwayland.xml:138
#, xml-text
msgid ""
"Running the tests involves downloading two other frameworks, in addition to "
"the mentioned optional dependencies:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/x/installing/xwayland.xml:142
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir tools &amp;&amp;\n"
"pushd tools &amp;&amp;\n"
"\n"
"git clone https://gitlab.freedesktop.org/mesa/piglit.git --depth 1 &amp;&amp;\n"
"cat &gt; piglit/piglit.conf &lt;&lt; EOF                                    &amp;&amp;\n"
"<literal>[xts]\n"
"path=$(pwd)/xts\n"
"EOF</literal>\n"
"\n"
"git clone https://gitlab.freedesktop.org/xorg/test/xts --depth 1   &amp;&amp;\n"
"\n"
"export DISPLAY=:22           &amp;&amp;\n"
"../hw/vfb/Xvfb $DISPLAY &amp;\n"
"VFB_PID=$!                   &amp;&amp;\n"
"cd xts                       &amp;&amp;\n"
"CFLAGS=-fcommon ./autogen.sh &amp;&amp;\n"
"make                         &amp;&amp;\n"
"kill $VFB_PID                &amp;&amp;\n"
"unset DISPLAY VFB_PID        &amp;&amp;\n"
"popd</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/installing/xwayland.xml:164
#, xml-text
msgid "Then the tests can be run with:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/x/installing/xwayland.xml:167
#, no-wrap, xml-text
msgid ""
"<userinput>XTEST_DIR=$(pwd)/tools/xts PIGLIT_DIR=$(pwd)/tools/piglit ninja "
"test</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/installing/xwayland.xml:171
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/x/installing/xwayland.xml:174
#, no-wrap, xml-text
msgid ""
"<userinput>ninja install &amp;&amp;\n"
"cat &gt;&gt; /etc/sysconfig/createfiles &lt;&lt; \"EOF\"\n"
"<literal>/tmp/.X11-unix dir 1777 root root</literal>\n"
"EOF</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/x/installing/xwayland.xml:179
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/installing/xwayland.xml:182
#, xml-text
msgid ""
"If <xref role='nodep' linkend='xorg-server'/> is not installed and you do "
"not plan to install it later, you can install <command>Xvfb</command> from "
"this package. As the &root; user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/x/installing/xwayland.xml:187
#, no-wrap, xml-text
msgid "<userinput>install -vm755 hw/vfb/Xvfb /usr/bin</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/x/installing/xwayland.xml:192
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/installing/xwayland.xml:195
#, xml-text
msgid ""
"<command>sed -i '/install_man/,$d' meson.build</command>: Prevents "
"installing a manual page for <command>Xserver</command>, which is also "
"provided by <xref linkend='xorg-server'/>.  Remove this command if <xref "
"linkend='xorg-server'/> is not installed and you don't plan to install it "
"later."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/installing/xwayland.xml:206
#, xml-text
msgid ""
"<option>-D secure-rpc=false</option>: This option disables building RPC "
"support if <xref linkend=\"libtirpc\"/> is not installed."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/installing/xwayland.xml:211
#, xml-text
msgid ""
"<command>cat &gt;&gt; /etc/sysconfig/createfiles...</command>: This command "
"creates the <filename class=\"directory\">/tmp/.X11-unix</filename> "
"directory at startup, and ensures that the permissions and ownership are "
"correct as required by applications using Xwayland."
msgstr ""

