#. type: Content of: <sect2><sect3><screen>
#: blfs-en/blfs-git/x/installing/x7driver-wacom.xml:118
#, no-wrap, xml-text
msgid ""
"<userinput>./configure $XORG_CONFIG --with-systemd-unit-dir=no &amp;&amp;\n"
"make</userinput>"
