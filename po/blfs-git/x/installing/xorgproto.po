#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/x/installing/xorgproto.xml:100
#, xml-text
msgid "Installation of xorgproto"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/installing/xorgproto.xml:103
#, xml-text
msgid ""
"Install <application>xorgproto</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/x/installing/xorgproto.xml:107
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=$XORG_PREFIX .. &amp;&amp;\n"
"ninja</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/installing/xorgproto.xml:114
#, xml-text
msgid "This package does not come with a test suite."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/installing/xorgproto.xml:118
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/x/installing/xorgproto.xml:121
#, no-wrap, xml-text
msgid ""
"<userinput>ninja install &amp;&amp;\n"
"mv -v $XORG_PREFIX/share/doc/xorgproto{,-&xorgproto-version;}</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/x/installing/xorgproto.xml:130
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/installing/xorgproto.xml:133
#, xml-text
msgid ""
"<option>-D legacy=true</option>: Installs legacy headers needed by old "
"programs (such as <ulink "
"url=\"https://lesstif.sourceforge.net/\">LessTif</ulink>)."
msgstr ""

