#. type: Content of: <sect2><sect3><title>
#: blfs-en/blfs-git/x/installing/libevdev.xml:116
#, xml-text
msgid "Installation of libevdev"
msgstr ""

#. type: Content of: <sect2><sect3><para>
#: blfs-en/blfs-git/x/installing/libevdev.xml:119
#, xml-text
msgid ""
"Install <application>libevdev</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect2><sect3><screen>
#: blfs-en/blfs-git/x/installing/libevdev.xml:123
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup ..                  \\\n"
"      --prefix=$XORG_PREFIX     \\\n"
"      --buildtype=release       \\\n"
"      -D documentation=disabled \\\n"
"      -D tests=disabled         &amp;&amp;\n"
"ninja</userinput>"
msgstr ""

#. type: Content of: <sect2><sect3><para>
#: blfs-en/blfs-git/x/installing/libevdev.xml:147
#, xml-text
msgid ""
"The test suite requires <application>Check</application> that we've removed "
"from LFS."
msgstr ""

#. type: Content of: <sect2><sect3><para>
#: blfs-en/blfs-git/x/installing/libevdev.xml:152
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect2><sect3><screen>
#: blfs-en/blfs-git/x/installing/libevdev.xml:155
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr ""

#. type: Content of: <sect2><sect3><title>
#: blfs-en/blfs-git/x/installing/libevdev.xml:159
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect2><sect3><para>
#: blfs-en/blfs-git/x/installing/libevdev.xml:162
#, xml-text
msgid ""
"<parameter>-D tests=disabled</parameter>: This allows the package to compile"
" if <application>Check</application> is not installed.  We've removed "
"<application>Check</application> from LFS."
msgstr ""

