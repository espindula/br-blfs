#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/installing/xcb-proto.xml:90
#, xml-text
msgid ""
"Install <application>xcb-proto</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/x/installing/xcb-proto.xml:94
#, no-wrap, xml-text
msgid "<userinput>PYTHON=python3 ./configure $XORG_CONFIG</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/installing/xcb-proto.xml:97
#, xml-text
msgid "To test the results, issue: <command>make check</command>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/installing/xcb-proto.xml:101
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/x/installing/xcb-proto.xml:104
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/installing/xcb-proto.xml:107
#, xml-text
msgid ""
"If you are upgrading from version 1.15.1 or lower, the old pkgconfig file "
"needs to be removed. Issue, as the <systemitem "
"class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/x/installing/xcb-proto.xml:112
#, no-wrap, xml-text
msgid "<userinput>rm -f $XORG_PREFIX/lib/pkgconfig/xcb-proto.pc</userinput>"
msgstr ""

