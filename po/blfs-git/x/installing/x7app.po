"the undocumented <command>xkeyhost</command> script)."
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/x/installing/x7app.xml:187
#, xml-text
msgid "Downloading Xorg Applications"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/installing/x7app.xml:190
#, xml-text
msgid ""
"First, create a list of files to be downloaded. This file will also be used "
"to verify the integrity of the downloads when complete:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/x/installing/x7app.xml:194
#, no-wrap, xml-text
msgid ""
"<userinput>cat &gt; app-&xorg-version;.md5 &lt;&lt; \"EOF\"\n"
"<literal>&iceauth-md5sum;  iceauth-&iceauth-version;.tar.xz\n"
"&mkfontscale-md5sum;  mkfontscale-&mkfontscale-version;.tar.xz\n"
"&sessreg-md5sum;  sessreg-&sessreg-version;.tar.xz\n"
"&setxkbmap-md5sum;  setxkbmap-&setxkbmap-version;.tar.xz\n"
"&smproxy-md5sum;  smproxy-&smproxy-version;.tar.xz\n"
"&xauth-md5sum;  xauth-&xauth-version;.tar.xz\n"
"&xcmsdb-md5sum;  xcmsdb-&xcmsdb-version;.tar.xz\n"
"&xcursorgen-md5sum;  xcursorgen-&xcursorgen-version;.tar.xz\n"
"&xdpyinfo-md5sum;  xdpyinfo-&xdpyinfo-version;.tar.xz\n"
"&xdriinfo-md5sum;  xdriinfo-&xdriinfo-version;.tar.xz\n"
"&xev-md5sum;  xev-&xev-version;.tar.xz\n"
"&xgamma-md5sum;  xgamma-&xgamma-version;.tar.xz\n"
"&xhost-md5sum;  xhost-&xhost-version;.tar.xz\n"
"&xinput-md5sum;  xinput-&xinput-version;.tar.xz\n"
"&xkbcomp-md5sum;  xkbcomp-&xkbcomp-version;.tar.xz\n"
"&xkbevd-md5sum;  xkbevd-&xkbevd-version;.tar.xz\n"
"&xkbutils-md5sum;  xkbutils-&xkbutils-version;.tar.xz\n"
"&xkill-md5sum;  xkill-&xkill-version;.tar.xz\n"
"&xlsatoms-md5sum;  xlsatoms-&xlsatoms-version;.tar.xz\n"
"&xlsclients-md5sum;  xlsclients-&xlsclients-version;.tar.xz\n"
"&xmessage-md5sum;  xmessage-&xmessage-version;.tar.xz\n"
"&xmodmap-md5sum;  xmodmap-&xmodmap-version;.tar.xz\n"
"&xpr-md5sum;  xpr-&xpr-version;.tar.xz\n"
"&xprop-md5sum;  xprop-&xprop-version;.tar.xz\n"
"&xrandr-md5sum;  xrandr-&xrandr-version;.tar.xz\n"
"&xrdb-md5sum;  xrdb-&xrdb-version;.tar.xz\n"
"&xrefresh-md5sum;  xrefresh-&xrefresh-version;.tar.xz\n"
"&xset-md5sum;  xset-&xset-version;.tar.xz\n"
"&xsetroot-md5sum;  xsetroot-&xsetroot-version;.tar.xz\n"
"&xvinfo-md5sum;  xvinfo-&xvinfo-version;.tar.xz\n"
"&xwd-md5sum;  xwd-&xwd-version;.tar.xz\n"
"&xwininfo-md5sum;  xwininfo-&xwininfo-version;.tar.xz\n"
"&xwud-md5sum;  xwud-&xwud-version;.tar.xz</literal>\n"
"EOF</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/installing/x7app.xml:235
#, xml-text
msgid ""
"To download the needed files using <xref linkend='wget'/>, use the following"
" commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/x/installing/x7app.xml:239
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir app &amp;&amp;\n"
"cd app &amp;&amp;\n"
"grep -v '^#' ../app-&xorg-version;.md5 | awk '{print $2}' | wget -i- -c \\\n"
"    -B &xorg-download-http;/app/ &amp;&amp;\n"
"md5sum -c ../app-&xorg-version;.md5</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/x/installing/x7app.xml:248
#, xml-text
msgid "Installation of Xorg Applications"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/installing/x7app.xml:253
#, xml-text
msgid "First, start a subshell that will exit on error:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/x/installing/x7app.xml:256
#, no-wrap, xml-text
msgid "<userinput>bash -e</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/installing/x7app.xml:259
#, xml-text
msgid "Install all of the packages by running the following commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/x/installing/x7app.xml:262
#, no-wrap, xml-text
msgid ""
"<userinput>for package in $(grep -v '^#' ../app-&xorg-version;.md5 | awk '{print $2}')\n"
"do\n"
"  packagedir=${package%.tar.?z*}\n"
"  tar -xf $package\n"
"  pushd $packagedir\n"
"     ./configure $XORG_CONFIG\n"
"     make\n"
"     as_root make install\n"
"  popd\n"
"  rm -rf $packagedir\n"
"done</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/installing/x7app.xml:275
#, xml-text
msgid "Finally, exit the shell that was started earlier:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/x/installing/x7app.xml:278
#, no-wrap, xml-text
msgid "<userinput>exit</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/installing/x7app.xml:281
#, xml-text
msgid ""
"Unless you installed the optional dependencies, remove an undocumented "
"script which is reported to be broken (<command>xkeystone</command> provided"
" by the <application>xrandr</application> package)."
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/x/installing/x7app.xml:286
#, no-wrap, xml-text
msgid "<userinput>as_root rm -f $XORG_PREFIX/bin/xkeystone</userinput>"
msgstr ""

