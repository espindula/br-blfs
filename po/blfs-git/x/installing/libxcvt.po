#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/installing/libxcvt.xml:85
#, xml-text
msgid ""
"Install <application>libxcvt</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/x/installing/libxcvt.xml:89
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=$XORG_PREFIX --buildtype=release .. &amp;&amp;\n"
"ninja</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/installing/libxcvt.xml:96
#, xml-text
