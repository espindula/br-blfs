#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/x/installing/xkeyboard-config.xml:89
#, xml-text
msgid "Installation of XKeyboardConfig"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/installing/xkeyboard-config.xml:92
#, xml-text
msgid ""
"Install <application>XKeyboardConfig</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/x/installing/xkeyboard-config.xml:96
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=$XORG_PREFIX --buildtype=release .. &amp;&amp;\n"
"ninja</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/installing/xkeyboard-config.xml:103
#, xml-text
msgid ""
"To test the results, issue: <command>ninja test</command>.  Two tests. "
"test_compat_layout[mapping39-base] and test_compat_layout[mapping39-evdev], "
"are known to fail."
msgstr ""

#. type: Content of: <sect1><sect2><important><para>
#: blfs-en/blfs-git/x/installing/xkeyboard-config.xml:110
#, xml-text
msgid ""
"If upgrading from version 2.44 or earlier, the installation will fail if "
"some files are not symbolic links.  To fix this, run as the &root; user:"
msgstr ""

#. type: Content of: <sect1><sect2><important><screen>
#: blfs-en/blfs-git/x/installing/xkeyboard-config.xml:115
#, no-wrap, xml-text
msgid ""
"<userinput>if [ -d $XORG_PREFIX/share/X11/xkb ]; then\n"
"  rm -rf $XORG_PREFIX/share/X11/xkb\n"
"  rm -f  $XORG_PREFIX/share/man/man7/xkeyboard-config.7\n"
"  rm -f  $XORG_PREFIX/share/pkgconfig/xkeyboard-config.pc\n"
"fi</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/installing/xkeyboard-config.xml:124
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/x/installing/xkeyboard-config.xml:127
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr ""

