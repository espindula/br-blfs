#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/x/installing/x7lib.xml:192
#, xml-text
msgid "Downloading Xorg Libraries"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/installing/x7lib.xml:195
#, xml-text
msgid ""
"First, create a list of files to be downloaded. This file will also be used "
"to verify the integrity of the downloads when complete:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/x/installing/x7lib.xml:199
#, no-wrap, xml-text
msgid ""
"<userinput>cat &gt; lib-&xorg-version;.md5 &lt;&lt; \"EOF\"\n"
"<literal>&xtrans-md5sum;  xtrans-&xtrans-version;.tar.xz\n"
"&libX11-md5sum;  libX11-&libX11-version;.tar.xz\n"
"&libXext-md5sum;  libXext-&libXext-version;.tar.xz\n"
"&libFS-md5sum;  libFS-&libFS-version;.tar.xz\n"
"&libICE-md5sum;  libICE-&libICE-version;.tar.xz\n"
"&libSM-md5sum;  libSM-&libSM-version;.tar.xz\n"
"&libXScrnSaver-md5sum;  libXScrnSaver-&libXScrnSaver-version;.tar.xz\n"
"&libXt-md5sum;  libXt-&libXt-version;.tar.xz\n"
"&libXmu-md5sum;  libXmu-&libXmu-version;.tar.xz\n"
"&libXpm-md5sum;  libXpm-&libXpm-version;.tar.xz\n"
"&libXaw-md5sum;  libXaw-&libXaw-version;.tar.xz\n"
"&libXfixes-md5sum;  libXfixes-&libXfixes-version;.tar.xz\n"
"&libXcomposite-md5sum;  libXcomposite-&libXcomposite-version;.tar.xz\n"
"&libXrender-md5sum;  libXrender-&libXrender-version;.tar.xz\n"
"&libXcursor-md5sum;  libXcursor-&libXcursor-version;.tar.xz\n"
"&libXdamage-md5sum;  libXdamage-&libXdamage-version;.tar.xz\n"
"&libfontenc-md5sum;  libfontenc-&libfontenc-version;.tar.xz\n"
"&libXfont2-md5sum;  libXfont2-&libXfont2-version;.tar.xz\n"
"&libXft-md5sum;  libXft-&libXft-version;.tar.xz\n"
"&libXi-md5sum;  libXi-&libXi-version;.tar.xz\n"
"&libXinerama-md5sum;  libXinerama-&libXinerama-version;.tar.xz\n"
"&libXrandr-md5sum;  libXrandr-&libXrandr-version;.tar.xz\n"
"&libXres-md5sum;  libXres-&libXres-version;.tar.xz\n"
"&libXtst-md5sum;  libXtst-&libXtst-version;.tar.xz\n"
"&libXv-md5sum;  libXv-&libXv-version;.tar.xz\n"
"&libXvMC-md5sum;  libXvMC-&libXvMC-version;.tar.xz\n"
"&libXxf86dga-md5sum;  libXxf86dga-&libXxf86dga-version;.tar.xz\n"
"&libXxf86vm-md5sum;  libXxf86vm-&libXxf86vm-version;.tar.xz\n"
"&libpciaccess-md5sum;  libpciaccess-&libpciaccess-version;.tar.xz\n"
"&libxkbfile-md5sum;  libxkbfile-&libxkbfile-version;.tar.xz\n"
"&libxshmfence-md5sum;  libxshmfence-&libxshmfence-version;.tar.xz\n"
"&libXpresent-md5sum;  libXpresent-&libXpresent-version;.tar.xz</literal>\n"
"EOF</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/installing/x7lib.xml:235
#, xml-text
msgid ""
"To download the needed files using <xref linkend='wget'/>, use the following"
" commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/x/installing/x7lib.xml:239
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir lib &amp;&amp;\n"
"cd lib &amp;&amp;\n"
"grep -v '^#' ../lib-&xorg-version;.md5 | awk '{print $2}' | wget -i- -c \\\n"
"    -B &xorg-download-http;/lib/ &amp;&amp;\n"
"md5sum -c ../lib-&xorg-version;.md5</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/x/installing/x7lib.xml:248
#, xml-text
msgid "Installation of Xorg Libraries"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/installing/x7lib.xml:253
#, xml-text
msgid ""
"Some libraries come with a test suite. If you wish to execute them, either "
"comment out the <command>rm -rf ...</command> below, so that, after all "
"libraries are installed, you can come back to the corresponding directory "
"and run <command>make check</command>, or do individual builds, running the "
"tests for each of those distributed with working test suites.  "
"Alternatively, you can uncomment the line #<command>make check "
"...</command>, and at the end, check the test results with:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/x/installing/x7lib.xml:262
#, no-wrap, xml-text
msgid "<userinput>grep -A9 summary *make_check.log</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/installing/x7lib.xml:265
#, xml-text
msgid ""
"BLFS developers have confirmed that <application>libX11</application>, "
"<application>libXt</application>, <application>libXmu</application>, "
"<application>libXpm</application>, and "
"<application>libxshmfence</application> are distributed with working test "
"suites."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/installing/x7lib.xml:273
#, xml-text
msgid "First, start a subshell that will exit on error:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/x/installing/x7lib.xml:276
#, no-wrap, xml-text
msgid "<userinput>bash -e</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/installing/x7lib.xml:279
#, xml-text
msgid "Install all of the packages by running the following commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/x/installing/x7lib.xml:282
#, no-wrap, xml-text
msgid ""
"<userinput>for package in $(grep -v '^#' ../lib-&xorg-version;.md5 | awk '{print $2}')\n"
"do\n"
"  packagedir=${package%.tar.?z*}\n"
"  echo \"Building $packagedir\"\n"
"\n"
"  tar -xf $package\n"
"  pushd $packagedir\n"
"  docdir=\"--docdir=$XORG_PREFIX/share/doc/$packagedir\"\n"
"  \n"
"  case $packagedir in\n"
"    libXfont2-[0-9]* )\n"
"      ./configure $XORG_CONFIG $docdir --disable-devel-docs\n"
"    ;;\n"
"\n"
"    libXt-[0-9]* )\n"
"      ./configure $XORG_CONFIG $docdir \\\n"
"                  --with-appdefaultdir=/etc/X11/app-defaults\n"
"    ;;\n"
"\n"
"    libXpm-[0-9]* )\n"
"      ./configure $XORG_CONFIG $docdir --disable-open-zfile\n"
"    ;;\n"
"  \n"
"    libpciaccess* )\n"
"      mkdir build\n"
"      cd    build\n"
"        meson setup --prefix=$XORG_PREFIX --buildtype=release ..\n"
"        ninja\n"
"        #ninja test\n"
"        as_root ninja install\n"
"      popd     # $packagedir\n"
"      continue # for loop\n"
"    ;;\n"
"\n"
"    * )\n"
"      ./configure $XORG_CONFIG $docdir\n"
"    ;;\n"
"  esac\n"
"\n"
"  make\n"
"  #make check 2>&amp;1 | tee ../$packagedir-make_check.log\n"
"  as_root make install\n"
"  popd\n"
"  rm -rf $packagedir\n"
"  as_root /sbin/ldconfig\n"
"done</userinput>"
msgstr ""

