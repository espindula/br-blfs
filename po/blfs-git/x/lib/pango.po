#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/x/lib/pango.xml:101
#, xml-text
msgid "Installation of Pango"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/lib/pango.xml:104
#, xml-text
msgid ""
"Install <application>Pango</application> by running the following commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/x/lib/pango.xml:108
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr            \\\n"
"            --buildtype=release      \\\n"
"            --wrap-mode=nofallback   \\\n"
"            -D introspection=enabled \\\n"
"            ..                       &amp;&amp;\n"
"ninja</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/lib/pango.xml:119
#, xml-text
msgid ""
"If you have <xref linkend='docutils'/> installed and wish to build the "
"manual pages for the installed programs, issue:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/x/lib/pango.xml:123
#, no-wrap, xml-text
msgid ""
"<userinput>meson configure -D man-pages=true &amp;&amp;\n"
"ninja</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/lib/pango.xml:127
#, xml-text
msgid ""
"If you have <xref linkend='gi-docgen'/> installed and wish to build the API "
"documentation for this package, issue:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/x/lib/pango.xml:131
#, no-wrap, xml-text
msgid ""
"<userinput>sed \"/docs_dir =/s@\\$@ / 'pango-&pango-version;'@\" -i ../docs/meson.build &amp;&amp;\n"
"meson configure -D documentation=true                            &amp;&amp;\n"
"ninja</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/lib/pango.xml:136
#, xml-text
msgid ""
"To test the results, issue: <command>ninja test</command>. Three tests, "
"test-font-data, test-font, and test-layout are known to fail due to missing "
"font data."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/lib/pango.xml:142
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/x/lib/pango.xml:145
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr ""

