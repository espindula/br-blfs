#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/x/lib/libei.xml:87
#, xml-text
msgid "Installation of libei"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/lib/libei.xml:90
#, xml-text
msgid ""
"Install <application>libei</application> by running the following commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/x/lib/libei.xml:94
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr --buildtype=release -D tests=disabled &amp;&amp;\n"
"ninja</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/lib/libei.xml:101
#, xml-text
msgid ""
"This package does come with a test suite, but it requires an external "
"dependency. If you have both <ulink "
"url=\"https://github.com/nemequ/munit\">munit</ulink> and <ulink "
"url=\"https://pypi.org/project/structlog/\">structlog</ulink> installed, and"
" you wish to run the test suite, run the following commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/x/lib/libei.xml:109
#, no-wrap, xml-text
msgid ""
"<userinput>meson configure -D tests=enabled &amp;&amp;\n"
"ninja test</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/lib/libei.xml:113
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/x/lib/libei.xml:116
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/x/lib/libei.xml:121
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/lib/libei.xml:127
#, xml-text
msgid ""
"<parameter>-D tests=disabled</parameter>: This switch avoids a dependency on"
" <ulink url=\"https://github.com/nemequ/munit\">munit</ulink>. Remove this "
"switch if you have <application>munit</application> installed and wish to "
"run the test suite."
msgstr ""

