#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/x/lib/vulkan-loader.xml:98
#, xml-text
msgid "Installation of Vulkan-Loader"
msgstr ""

#. type: Content of: <sect1><sect2><note><para>
#: blfs-en/blfs-git/x/lib/vulkan-loader.xml:102
#, xml-text
msgid ""
"If this package is being installed on a system where Mesa has already been "
"installed previously, please rebuild <xref linkend=\"mesa\"/> after this "
"package to install Vulkan graphics drivers."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/lib/vulkan-loader.xml:109
#, xml-text
msgid ""
"Install <application>Vulkan-Loader</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/x/lib/vulkan-loader.xml:113
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr   \\\n"
"      -D CMAKE_BUILD_TYPE=Release    \\\n"
"      -D CMAKE_SKIP_INSTALL_RPATH=ON \\\n"
"      -G Ninja .. &amp;&amp;\n"
"ninja</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/lib/vulkan-loader.xml:123
#, xml-text
msgid ""
"To run the test suite, issue (note that the command will use <xref "
"linkend='git'/> to download a copy of GoogleTest for building the test "
"suite):"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/x/lib/vulkan-loader.xml:128
#, no-wrap, xml-text
msgid ""
"<userinput>sed \"s/'git', 'clone'/&amp;, '--depth=1', '-b', self.commit/\" \\\n"
"    -i ../scripts/update_deps.py &amp;&amp;\n"
"cmake -D BUILD_TESTS=ON -D UPDATE_DEPS=ON .. &amp;&amp;\n"
"ninja &amp;&amp;\n"
"ninja test</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/lib/vulkan-loader.xml:135
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/x/lib/vulkan-loader.xml:138
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/x/lib/vulkan-loader.xml:143
#, xml-text
msgid "Command Explanations"
msgstr ""

