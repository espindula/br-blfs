#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/x/lib/qt6.xml:152
#, xml-text
msgid "Setting the installation prefix"
msgstr ""

#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/blfs-git/x/lib/qt6.xml:154
#, xml-text
msgid "Installing in /opt/qt6"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/lib/qt6.xml:157
#, xml-text
msgid ""
"The BLFS editors recommend installing <application>Qt6</application> in a "
"directory other than <filename class=\"directory\">/usr</filename>, i.e.  "
"<filename class=\"directory\">/opt/qt6</filename>. To do this, set the "
"following environment variable:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/x/lib/qt6.xml:163
#, no-wrap, xml-text
msgid "<userinput>export QT6PREFIX=/opt/qt6</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><tip><para>
#: blfs-en/blfs-git/x/lib/qt6.xml:167
#, xml-text
msgid ""
"Sometimes the installation paths are hardcoded into installed files.  This "
"is the reason why <filename class=\"directory\">/opt/qt6</filename> is used "
"as installation prefix instead of <filename "
"class=\"directory\">/opt/qt-&qt6-version;</filename>. To create a versioned "
"<application>Qt6</application> directory, you may rename the directory and "
"create a symlink:"
msgstr ""

#. type: Content of: <sect1><sect2><tip><screen>
#: blfs-en/blfs-git/x/lib/qt6.xml:175
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir -pv /opt/qt-&qt6-version;\n"
"ln -sfnv qt-&qt6-version; /opt/qt6</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><tip><para>
#: blfs-en/blfs-git/x/lib/qt6.xml:179
#, xml-text
msgid ""
"Later on, you may want to install other versions of "
"<application>Qt6</application>. To do that, just remove the symlink, create "
"the new versioned directory, and recreate the <filename "
"class=\"directory\">/opt/qt6</filename> symlink again before building the "
"new version.  Which version of <application>Qt6</application> you use "
"depends only on where the symlink points."
msgstr ""

#. type: Content of: <sect1><sect2><note><para>
#: blfs-en/blfs-git/x/lib/qt6.xml:191
#, xml-text
msgid ""
"If any of <xref linkend=\"libqtxdg\"/>, <xref linkend=\"qca\"/>, <xref "
"linkend=\"qcoro\"/>, or <xref linkend=\"sddm\"/> have been installed, then "
"those packages will need to be reinstalled after installing this package."
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/x/lib/qt6.xml:201
#, xml-text
msgid "Installation of Qt6"
msgstr ""

#. type: Content of: <sect1><sect2><warning><para>
#: blfs-en/blfs-git/x/lib/qt6.xml:205
#, xml-text
msgid ""
"If <application>Qt6</application> is being reinstalled into the same "
"directory as an existing instance, run the commands done by &root;, such as "
"<command>make install</command>, from a console or non-Qt6 based window "
"manager. It overwrites <application>Qt6</application> libraries that should "
"not be in use during the install process."
msgstr ""

#. type: Content of: <sect1><sect2><caution><para>
#: blfs-en/blfs-git/x/lib/qt6.xml:216
#, xml-text
msgid ""
"If you did not install some of the recommended dependencies, examine "
"<command>./configure --help</command> output to check how to disable them or"
" use internal versions bundled in the source tarball."
msgstr ""

#. type: Content of: <sect1><sect2><note><para>
#: blfs-en/blfs-git/x/lib/qt6.xml:224
#, xml-text
msgid ""
"The build time and space required for the full "
"<application>Qt6</application> is quite long. The instructions below do not "
"build the tutorials and examples. Removing the "
"<parameter>-nomake</parameter> line will create additional resources.."
msgstr ""

#. type: Content of: <sect1><sect2><note><para>
#: blfs-en/blfs-git/x/lib/qt6.xml:233
#, xml-text
msgid ""
"The BLFS editors do not recommend installing <application>Qt6</application> "
"into the /usr hierarchy because it becomes difficult to find components and "
"to update to a new version."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/lib/qt6.xml:240
#, xml-text
msgid ""
"Disable a conflicting declaration on i686 systems and fix a build error due "
"to SIMD intrinsics in QtMultimedia:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/x/lib/qt6.xml:244
#, no-wrap, xml-text
msgid ""
"<userinput>if [ \"$(uname -m)\" == \"i686\" ]; then\n"
"    sed -e \"/^#elif defined(Q_CC_GNU_ONLY)/s/.*/&amp; \\&amp;\\&amp; 0/\" \\\n"
"         -i qtbase/src/corelib/global/qtypes.h &amp;&amp;\n"
"    export CXXFLAGS+=\"-DDISABLE_SIMD -DPFFFT_SIMD_DISABLE\"\n"
"fi</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/lib/qt6.xml:252
#, xml-text
msgid ""
"Apply a patch from upstream that fixes various crashes from a qtdeclarative "
"bug:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/x/lib/qt6.xml:256
#, no-wrap, xml-text
msgid ""
"<userinput>patch -Np1 -i ../qt-everywhere-"
"src-&qt6-version;-upstream_fixes-1.patch</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/lib/qt6.xml:259
#, xml-text
msgid ""
"Install <application>Qt6</application> by running the following commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/x/lib/qt6.xml:262
#, no-wrap, xml-text
msgid ""
"<userinput>./configure -prefix $QT6PREFIX      \\\n"
"            -sysconfdir /etc/xdg    \\\n"
"            -dbus-linked            \\\n"
"            -openssl-linked         \\\n"
"            -system-sqlite          \\\n"
"            -nomake examples        \\\n"
"            -no-rpath               \\\n"
"            -no-sbom                \\\n"
"            -syslog                 \\\n"
"            -skip qt3d              \\\n"
"            -skip qtquick3dphysics  \\\n"
"            -skip qtwebengine       &amp;&amp;\n"
"ninja</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/x/lib/qt6.xml:276
#, no-wrap, xml-text
msgid ""
"<userinput>./configure -prefix $QT6PREFIX      \\\n"
"            -sysconfdir /etc/xdg    \\\n"
"            -dbus-linked            \\\n"
"            -openssl-linked         \\\n"
"            -system-sqlite          \\\n"
"            -nomake examples        \\\n"
"            -no-rpath               \\\n"
"            -no-sbom                \\\n"
"            -journald               \\\n"
"            -skip qt3d              \\\n"
"            -skip qtquick3dphysics  \\\n"
"            -skip qtwebengine       &amp;&amp;\n"
"ninja</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/lib/qt6.xml:291
#, xml-text
msgid "This package does not come with a test suite."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/lib/qt6.xml:295
#, xml-text
msgid "Now, as the &root; user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/x/lib/qt6.xml:298
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr ""

#. and profile include (pri)
#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/lib/qt6.xml:301
#, xml-text
msgid ""
"Remove references to the build directory from installed library dependency "
"(prl)  files by running the following command as the &root; user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/x/lib/qt6.xml:306
#, no-wrap, xml-text
msgid ""
"<userinput>find $QT6PREFIX/ -name \\*.prl \\\n"
"   -exec sed -i -e '/^QMAKE_PRL_BUILD_DIR/d' {} \\;</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/lib/qt6.xml:310
#, xml-text
msgid ""
"Install images and create the menu entries for installed applications.  "
"Again as the &root; user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/x/lib/qt6.xml:314
#, no-wrap, xml-text
msgid ""
"<userinput>pushd qttools/src &amp;&amp;\n"
"\n"
"install -v -Dm644 assistant/assistant/images/assistant-128.png       \\\n"
"                  /usr/share/pixmaps/assistant-qt6.png               &amp;&amp;\n"
"\n"
"install -v -Dm644 designer/src/designer/images/designer.png          \\\n"
"                  /usr/share/pixmaps/designer-qt6.png                &amp;&amp;\n"
"\n"
"install -v -Dm644 linguist/linguist/images/icons/linguist-128-32.png \\\n"
"                  /usr/share/pixmaps/linguist-qt6.png                &amp;&amp;\n"
"\n"
"install -v -Dm644 qdbus/qdbusviewer/images/qdbusviewer-128.png       \\\n"
"                  /usr/share/pixmaps/qdbusviewer-qt6.png             &amp;&amp;\n"
"popd &amp;&amp;\n"
"\n"
"\n"
"cat &gt; /usr/share/applications/assistant-qt6.desktop &lt;&lt; EOF\n"
"<literal>[Desktop Entry]\n"
"Name=Qt6 Assistant\n"
"Comment=Shows Qt6 documentation and examples\n"
"Exec=$QT6PREFIX/bin/assistant\n"
"Icon=assistant-qt6.png\n"
"Terminal=false\n"
"Encoding=UTF-8\n"
"Type=Application\n"
"Categories=Qt;Development;Documentation;</literal>\n"
"EOF\n"
"\n"
"cat &gt; /usr/share/applications/designer-qt6.desktop &lt;&lt; EOF\n"
"<literal>[Desktop Entry]\n"
"Name=Qt6 Designer\n"
"GenericName=Interface Designer\n"
"Comment=Design GUIs for Qt6 applications\n"
"Exec=$QT6PREFIX/bin/designer\n"
"Icon=designer-qt6.png\n"
"MimeType=application/x-designer;\n"
"Terminal=false\n"
"Encoding=UTF-8\n"
"Type=Application\n"
"Categories=Qt;Development;</literal>\n"
"EOF\n"
"\n"
"cat &gt; /usr/share/applications/linguist-qt6.desktop &lt;&lt; EOF\n"
"<literal>[Desktop Entry]\n"
"Name=Qt6 Linguist\n"
"Comment=Add translations to Qt6 applications\n"
"Exec=$QT6PREFIX/bin/linguist\n"
"Icon=linguist-qt6.png\n"
"MimeType=text/vnd.trolltech.linguist;application/x-linguist;\n"
"Terminal=false\n"
"Encoding=UTF-8\n"
"Type=Application\n"
"Categories=Qt;Development;</literal>\n"
"EOF\n"
"\n"
"cat &gt; /usr/share/applications/qdbusviewer-qt6.desktop &lt;&lt; EOF\n"
"<literal>[Desktop Entry]\n"
"Name=Qt6 QDbusViewer\n"
"GenericName=D-Bus Debugger\n"
"Comment=Debug D-Bus applications\n"
"Exec=$QT6PREFIX/bin/qdbusviewer\n"
"Icon=qdbusviewer-qt6.png\n"
"Terminal=false\n"
"Encoding=UTF-8\n"
"Type=Application\n"
"Categories=Qt;Development;Debugger;</literal>\n"
"EOF</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/x/lib/qt6.xml:385
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/lib/qt6.xml:387
#, xml-text
msgid ""
"<parameter>-nomake examples</parameter>: This switch disables building of "
"the example programs included in the source tarball. Remove it if you want "
"to build them."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/lib/qt6.xml:394
#, xml-text
msgid ""
"<parameter>-skip qt3d</parameter>: This switch disables building qt3d "
"support. There is a problem building these files without an external library"
" and no packages in BLFS use qt3d."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/lib/qt6.xml:401
#, xml-text
msgid ""
"<parameter>-system-sqlite</parameter>: This switch enables use of the system"
" version of <application>SQLite</application>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/lib/qt6.xml:406
#, xml-text
msgid ""
"<parameter>-dbus-linked</parameter> <parameter>-openssl-linked</parameter>: "
"These switches enable explicit linking of the "
"<application>D-Bus</application> and <application>OpenSSL</application> "
"libraries into <application>Qt6</application> libraries instead of "
"<command>dlopen()</command>-ing them."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/lib/qt6.xml:416
#, xml-text
msgid ""
"<parameter>-syslog</parameter>: This switch allows sending Qt messages to "
"the <command>syslog</command> logging system."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/lib/qt6.xml:421
#, xml-text
msgid ""
"<parameter>-journald</parameter>: This switch allows sending Qt messages to "
"the <command>journald</command> logging system."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/lib/qt6.xml:426
#, xml-text
msgid ""
"<parameter>-skip qtwebengine</parameter>: This switch disables building the "
"QtWebEngine. The BLFS editors have chosen to build <xref "
"linkend=\"qtwebengine\"/> separately."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/lib/qt6.xml:432
#, xml-text
msgid ""
"<parameter>-skip qtquick3dphysics</parameter>: This switch disables building"
" the Qt Quick 3D Physics submodule. On 32-bit systems, this will cause the "
"build process to fail with an inlining error in Qt6's bundled copy of the "
"PhysX SDK."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/lib/qt6.xml:439
#, xml-text
msgid ""
"<option>-libproxy</option>: This switch enables the usage of libproxy for "
"determining proxy server information."
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/x/lib/qt6.xml:446
#, xml-text
msgid "Configuring Qt6"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><title>
#: blfs-en/blfs-git/x/lib/qt6.xml:449
#, xml-text
msgid "Configuration Information"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/blfs-git/x/lib/qt6.xml:452
#, xml-text
msgid ""
"If <xref linkend=\"sudo\"/> is installed, QT6DIR should be available to the "
"super user as well. Execute the following commands as the &root; user:"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><screen>
#: blfs-en/blfs-git/x/lib/qt6.xml:457
#, no-wrap, xml-text
msgid ""
"<userinput>cat &gt; /etc/sudoers.d/qt &lt;&lt; \"EOF\"\n"
"<literal>Defaults env_keep += QT6DIR</literal>\n"
"EOF</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/blfs-git/x/lib/qt6.xml:462
#, xml-text
msgid ""
"You now need to update the following configuration files so that "
"<application>Qt6</application> is correctly found by other packages and "
"system processes."
msgstr ""

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/blfs-git/x/lib/qt6.xml:468
#, xml-text
msgid ""
"As the &root; user, update the <filename>/etc/ld.so.conf</filename> file and"
" the dynamic linker's run-time cache file:"
