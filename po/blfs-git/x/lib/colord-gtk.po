#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/x/lib/colord-gtk.xml:96
#, xml-text
msgid "Installation of Colord GTK"
msgstr ""

#. type: Content of: <sect1><sect2><warning><para>
#: blfs-en/blfs-git/x/lib/colord-gtk.xml:100
#, xml-text
msgid ""
"If building the documentation <command>ninja -j1</command> must be used."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/lib/colord-gtk.xml:105
#, xml-text
msgid ""
"Install <application>Colord GTK</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/x/lib/colord-gtk.xml:109
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr       \\\n"
"            --buildtype=release \\\n"
"            -D gtk4=true        \\\n"
"            -D vapi=true        \\\n"
"            -D docs=false       \\\n"
"            -D man=false        \\\n"
"            ..                  &amp;&amp;\n"
"ninja</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/lib/colord-gtk.xml:123
#, xml-text
msgid ""
"If <xref linkend='docbook5'/>, <xref linkend='docbook-xsl-ns'/>, and <xref "
"linkend='libxslt'/> are installed, build the man page:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/x/lib/colord-gtk.xml:127
#, no-wrap, xml-text
msgid ""
"<userinput>sed '/class=\"manual\"/i \\\n"
"     &lt;refmiscinfo class=\"source\"&gt;colord-gtk&lt;/refmiscinfo&gt;' \\\n"
"    -i ../man/*.xml &amp;&amp;\n"
"meson configure -D man=true &amp;&amp;\n"
"ninja</userinput>"
msgstr ""

#.  on an ASUS 32" IPS display, I have a color profile and it works
#.            properly. On the other hand, with a Dell SP2208WFP LCD,
#.            no color profile is available and the tests fail. It seems to
#.            depend on the system/display.
#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/lib/colord-gtk.xml:134
#, xml-text
msgid ""
"To test the results, issue: <command>ninja test</command>.  The tests need "
"to be run from an X session, and may require a color profile for your "
"primary display."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/lib/colord-gtk.xml:144
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/x/lib/colord-gtk.xml:147
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/x/lib/colord-gtk.xml:151
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/lib/colord-gtk.xml:157
#, xml-text
msgid ""
"<parameter>-D vapi=true</parameter>: This switch enables building of the "
"Vala bindings. Remove this switch if you don't have <xref linkend=\"vala\" "
"role=\"nodep\"/> installed."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/lib/colord-gtk.xml:163
#, xml-text
msgid ""
"<parameter>-D gtk4=true</parameter>: This switch enables building the GTK-4 "
"bindings for colord. Set this option to 'false' if you do not have <xref "
"linkend=\"gtk4\" role=\"nodep\"/> installed."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/lib/colord-gtk.xml:169
#, xml-text
msgid ""
"<parameter>-D docs=false</parameter>: This switch disables building gtk-doc "
"based documentation. Even if gtk-doc is installed, you will need the "
"namespaced versions of the Docbook XSL stylesheets."
msgstr ""

