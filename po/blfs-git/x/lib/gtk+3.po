#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/lib/gtk+3.xml:182
#, xml-text
msgid ""
"<parameter>-D man=true</parameter>: This switch allows generating manual "
"pages."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/lib/gtk+3.xml:187
#, xml-text
msgid ""
"<option>-D gtk_doc=true</option>: This switch enables building "
"documentation. It requires <xref linkend=\"gtk-doc\"/>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/lib/gtk+3.xml:192
#, xml-text
msgid ""
"<option>-D tracker3=true</option>: This switch enables the search function "
"based on TinySPARQL in the GTK3 file chooser dialog.  It requires <xref "
"linkend=\"tinysparql\"/>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/lib/gtk+3.xml:198
#, xml-text
msgid ""
"<option>-D cloudproviders=true</option>: Use this switch if you have <xref "
"linkend=\"libcloudproviders\" role=\"nodep\"/> installed and wish to enable "
"support for cloud providers in a file chooser window."
msgstr ""

