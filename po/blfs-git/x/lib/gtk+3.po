#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/x/lib/gtk+3.xml:133
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup ..            \\\n"
"      --prefix=/usr       \\\n"
"      --buildtype=release \\\n"
"      -D man=true         \\\n"
"      -D broadway_backend=true &amp;&amp;\n"
"ninja</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/lib/gtk+3.xml:144
#, xml-text
msgid ""
"To test the results you need a graphical session, then issue <command>dbus-"
"run-session ninja test</command>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/lib/gtk+3.xml:149
#, xml-text
msgid "Two tests, window and clipboard, are known to fail."
