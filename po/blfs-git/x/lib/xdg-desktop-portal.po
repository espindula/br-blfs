#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/blfs-git/x/lib/xdg-desktop-portal.xml:76
#, xml-text
msgid "xdg-desktop-portal Dependencies"
msgstr ""

#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/blfs-git/x/lib/xdg-desktop-portal.xml:78
#, xml-text
msgid "Required"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/lib/xdg-desktop-portal.xml:80
#, xml-text
msgid ""
"<xref linkend=\"fuse3\"/>, <xref linkend=\"gdk-pixbuf\"/>, <xref "
"linkend=\"json-glib\"/>, <xref linkend=\"pipewire\"/>, and <xref "
"role=\"runtime\" linkend=\"dbus\"/> (at runtime).  Furthermore, a backend is"
" needed at runtime for this package to be of any use, either <xref "
"role=\"runtime\" linkend=\"xdg-desktop-portal-gtk\"/> or <xref "
"role=\"nodep\" linkend=\"xdg-desktop-portal-gnome\"/> or <xref "
"role=\"nodep\" linkend=\"xdg-desktop-portal-lxqt\"/>"
msgstr ""

#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/blfs-git/x/lib/xdg-desktop-portal.xml:92
#, xml-text
msgid "Recommended"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/lib/xdg-desktop-portal.xml:94
#, xml-text
msgid ""
"<xref linkend=\"bubblewrap\"/> and <xref linkend=\"docutils\"/> (for "
"building the manual pages)"
msgstr ""

#. type: Content of: <sect1><sect2><note><para>
#: blfs-en/blfs-git/x/lib/xdg-desktop-portal.xml:100
#, xml-text
msgid ""
"Although there is an option to build the package without "
"<application>bubblewrap</application>, upstream developers and LFS editors "
"alike highly recommend to not use this possibility, as it will create a "
"large security issue."
msgstr ""

#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/blfs-git/x/lib/xdg-desktop-portal.xml:108
#, xml-text
msgid "Optional"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/lib/xdg-desktop-portal.xml:110
#, xml-text
msgid ""
"<xref linkend=\"geoclue2\"/> (for the <quote>location</quote> portal), and "
"<xref linkend=\"pytest\"/> with <xref linkend=\"libportal\"/>, <xref "
"linkend=\"python-dbusmock\"/>, and <xref linkend=\"umockdev\"/> (for running"
" tests)"
msgstr ""

#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/blfs-git/x/lib/xdg-desktop-portal.xml:117
#, xml-text
msgid "Optional (for building the documentation)"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/lib/xdg-desktop-portal.xml:120
#, xml-text
msgid ""
"<xref linkend=\"sphinx\"/> with <ulink "
"url=\"https://pypi.org/project/sphinxext-"
"opengraph/\">sphinxext.opengraph</ulink>, <ulink "
"url=\"https://pypi.org/project/sphinx-"
"copybutton/\">sphinx_copybutton</ulink>, <ulink "
"url=\"https://pypi.org/project/furo/\">furo</ulink>, and <ulink "
"url=\"https://github.com/flatpak/flatpak\">flatpak</ulink>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/x/lib/xdg-desktop-portal.xml:130
#, xml-text
msgid "Installation of xdg-desktop-portal"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/lib/xdg-desktop-portal.xml:133
#, xml-text
msgid ""
"Install <application>xdg-desktop-portal</application> by running the "
"following commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/x/lib/xdg-desktop-portal.xml:137
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr --buildtype=release -D tests=disabled .. &amp;&amp;\n"
"ninja</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/lib/xdg-desktop-portal.xml:144
#, xml-text
msgid ""
"If the optional dependencies are installed, you can test the results by "
"running:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/x/lib/xdg-desktop-portal.xml:148
#, no-wrap, xml-text
msgid ""
"<userinput>meson configure -D tests=enabled &amp;&amp;\n"
"ninja test</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/lib/xdg-desktop-portal.xml:152
#, xml-text
msgid ""
"Without the external dependencies one test, integration/dynamiclauncher is "
"known to fail."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/lib/xdg-desktop-portal.xml:157
#, xml-text
msgid "Now, as the &root; user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/x/lib/xdg-desktop-portal.xml:160
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/lib/xdg-desktop-portal.xml:163
#, xml-text
msgid "Remove systemd files that are useless (as the &root; user):"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/x/lib/xdg-desktop-portal.xml:166
#, no-wrap, xml-text
msgid "<userinput>rm -rvf /usr/lib/systemd</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/x/lib/xdg-desktop-portal.xml:171
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
