#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/x/lib/at-spi2-core.xml:93
#, xml-text
msgid "Installation of At-Spi2 Core"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/lib/at-spi2-core.xml:96
#, xml-text
msgid ""
"Install <application>At-Spi2 Core</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/x/lib/at-spi2-core.xml:100
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup ..                  \\\n"
"      --prefix=/usr             \\\n"
"      --buildtype=release       \\\n"
"      -D gtk2_atk_adaptor=false \\\n"
"      -D systemd_user_dir=/tmp  &amp;&amp;\n"
"ninja</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/x/lib/at-spi2-core.xml:110
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup ..                  \\\n"
"      --prefix=/usr             \\\n"
"      --buildtype=release       \\\n"
"      -D gtk2_atk_adaptor=false &amp;&amp;\n"
"ninja</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/lib/at-spi2-core.xml:120
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/x/lib/at-spi2-core.xml:123
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/x/lib/at-spi2-core.xml:124
#, no-wrap, xml-text
msgid ""
"<userinput>ninja install &amp;&amp;\n"
"rm /tmp/at-spi-dbus-bus.service</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/lib/at-spi2-core.xml:128
#, xml-text
msgid ""
"The test suite requires the glib schemas of the package to be installed "
"already. The tests also need to run in a graphical environment. Now that the"
" package is installed, test the results by issuing: <command>dbus-run-"
"session ninja test</command>."
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/x/lib/at-spi2-core.xml:137
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/lib/at-spi2-core.xml:143
#, xml-text
msgid ""
"<parameter>-D systemd_user_dir=/tmp</parameter>: This flag puts the systemd "
"unit file in /tmp where it will be removed. SysV is unable to use this file."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/lib/at-spi2-core.xml:149
#, xml-text
msgid ""
"<option>-D docs=true</option>: Use this switch if you want to build the "
"documentation. Note that you must have both <xref role=\"nodep\" "
"linkend=\"gi-docgen\"/> and <xref linkend='sphinx'/> installed on your "
"system."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/lib/at-spi2-core.xml:156
#, xml-text
msgid ""
"<parameter>-D gtk2_atk_adaptor=false</parameter>: This switch disables "
"building the GTK+-2 module for this package."
msgstr ""

