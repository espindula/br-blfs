#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/x/lib/glew.xml:79
#, xml-text
msgid "Installation of GLEW"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/lib/glew.xml:82
#, xml-text
msgid ""
"Install <application>GLEW</application> by running the following commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/x/lib/glew.xml:86
#, no-wrap, xml-text
msgid ""
"<userinput>sed -i 's%lib64%lib%g' config/Makefile.linux &amp;&amp;\n"
"sed -e '/glew.lib.static:/d' \\\n"
"    -e '/0644 .*STATIC/d'    \\\n"
"    -e 's/glew.lib.static//' \\\n"
"    -e 's|/local||'          \\\n"
"    -i Makefile              &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/lib/glew.xml:95
#, xml-text
msgid "This package does not come with a test suite."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/lib/glew.xml:99
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/x/lib/glew.xml:102
#, no-wrap, xml-text
msgid "<userinput>make install.all</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/x/lib/glew.xml:107
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/lib/glew.xml:110
#, xml-text
msgid ""
"<command>sed -i 's%lib64%lib%g' ...</command>: This ensures that the library"
" is installed in <filename class=\"directory\">/usr/lib</filename>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/lib/glew.xml:115
#, xml-text
msgid ""
"<command>sed -i -e '/glew.lib.static:/d' ...</command>: This suppresses the "
"static library."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/lib/glew.xml:120
#, xml-text
msgid ""
"<command>sed -i -e 's|/local||' ...</command>: This ensures the package is "
"installed in <filename class=\"directory\">/usr</filename>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/lib/glew.xml:125
#, xml-text
msgid ""
"<command>make install.all</command>: This installs the programs as well as "
"the library."
msgstr ""

