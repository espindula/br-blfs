#: blfs-en/blfs-git/x/lib/glu.xml:86
#, xml-text
msgid "Installation of GLU"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/lib/glu.xml:89
#, xml-text
msgid ""
"Install <application>GLU</application> by running the following commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/x/lib/glu.xml:93
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup ..              \\\n"
"      --prefix=$XORG_PREFIX \\\n"
"      -D gl_provider=gl     \\\n"
"      --buildtype=release   &amp;&amp;\n"
"ninja</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/lib/glu.xml:103
#, xml-text
msgid "This package does not come with a test suite."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/lib/glu.xml:107
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/x/lib/glu.xml:110
#, no-wrap, xml-text
msgid ""
"<userinput>ninja install &amp;&amp;\n"
"rm -vf /usr/lib/libGLU.a</userinput>"
msgstr ""

