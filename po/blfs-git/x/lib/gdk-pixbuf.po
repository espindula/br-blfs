#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/x/lib/gdk-pixbuf.xml:103
#, xml-text
msgid "Installation of Gdk Pixbuf"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/lib/gdk-pixbuf.xml:106
#, xml-text
msgid ""
"Install <application>Gdk Pixbuf</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/x/lib/gdk-pixbuf.xml:110
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup ..                \\\n"
"      --prefix=/usr           \\\n"
"      --buildtype=release     \\\n"
"      -D others=enabled       \\\n"
"      -D png=disabled         \\\n"
"      -D gif=disabled         \\\n"
"      -D jpeg=disabled        \\\n"
"      -D tiff=disabled        \\\n"
"      -D thumbnailer=disabled \\\n"
"      --wrap-mode=nofallback  \\\n"
"      $(pkgconf glycin-2 || echo -D glycin=disabled) &amp;&amp;\n"
"ninja</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/lib/gdk-pixbuf.xml:127
#, xml-text
msgid ""
"If you have <xref linkend='gi-docgen'/> installed and wish to build the API "
"documentation for this package, issue:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/x/lib/gdk-pixbuf.xml:131
#, no-wrap, xml-text
msgid ""
"<userinput>sed \"/docs_dir =/s@\\$@ / 'gdk-pixbuf-&gdk-pixbuf-version;'@\" -i ../docs/meson.build &amp;&amp;\n"
"meson configure -D gtk_doc=true                                        &amp;&amp;\n"
"ninja</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/lib/gdk-pixbuf.xml:139
#, xml-text
msgid "The test suite of this package does not provide meaningful results."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/lib/gdk-pixbuf.xml:143
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/x/lib/gdk-pixbuf.xml:146
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><note><para>
#: blfs-en/blfs-git/x/lib/gdk-pixbuf.xml:150
#, xml-text
msgid ""
"If you installed the package on to your system using a "
"<quote>DESTDIR</quote> method, an important file was not installed and "
"should be copied and/or generated. Generate it using the following command "
"as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><note><screen>
#: blfs-en/blfs-git/x/lib/gdk-pixbuf.xml:156
#, no-wrap, xml-text
msgid "<userinput>gdk-pixbuf-query-loaders --update-cache</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/x/lib/gdk-pixbuf.xml:161
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/lib/gdk-pixbuf.xml:173
#, xml-text
msgid ""
"<parameter>-D others=enabled</parameter>: Build the loaders for some formats"
" not supported by glycin yet, notably XBM and XPM."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/lib/gdk-pixbuf.xml:178
#, xml-text
msgid ""
"<parameter>-D *=disabled</parameter>: Don't build the components obsoleted "
"in favor of glycin.  Those components are automatically disabled when "
"building this package with glycin installed, but explicitly specify those "
"options to make the configuration of the first build (without glycin) "
"consistent."
msgstr ""

