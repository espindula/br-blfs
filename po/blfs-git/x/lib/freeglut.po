#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/x/lib/freeglut.xml:89
#, xml-text
msgid "Installation of Freeglut"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/lib/freeglut.xml:92
#, xml-text
msgid ""
"Install <application>Freeglut</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/x/lib/freeglut.xml:96
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr        \\\n"
"      -D CMAKE_BUILD_TYPE=Release         \\\n"
"      -D FREEGLUT_BUILD_DEMOS=OFF         \\\n"
"      -D FREEGLUT_BUILD_STATIC_LIBS=OFF   \\\n"
"      -W no-dev .. &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/lib/freeglut.xml:107
#, xml-text
msgid "This package does not come with a test suite."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/lib/freeglut.xml:111
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/x/lib/freeglut.xml:115
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/x/lib/freeglut.xml:120
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/lib/freeglut.xml:123
#, xml-text
msgid ""
"<parameter>-D FREEGLUT_BUILD_DEMOS=OFF</parameter>: Disable building "
"optional demo programs.  Note that if you choose to build them, their "
"installation must be done manually.  The demo programs are limited and "
"installation is not recommended."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/lib/freeglut.xml:130
#, xml-text
msgid ""
"<parameter>-D FREEGLUT_BUILD_STATIC_LIBS=OFF</parameter>: Do not build the "
"static library."
msgstr ""

