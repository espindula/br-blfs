#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/x/lib/libadwaita.xml:93
#, xml-text
msgid "Installation of libadwaita"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/lib/libadwaita.xml:96
#, xml-text
msgid ""
"Install <application>libadwaita</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/x/lib/libadwaita.xml:100
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr --buildtype=release .. &amp;&amp;\n"
"ninja</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/lib/libadwaita.xml:107
#, xml-text
msgid ""
"If you have <xref linkend='gi-docgen'/> installed and wish to build the API "
"documentation for this package, issue:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/x/lib/libadwaita.xml:111
#, no-wrap, xml-text
msgid ""
"<userinput>sed \"s/apiversion/'&libadwaita-version;'/\" -i ../doc/meson.build &amp;&amp;\n"
"meson configure -D documentation=true             &amp;&amp;\n"
"ninja</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/lib/libadwaita.xml:116
#, xml-text
msgid ""
"To test the results, issue: <command>ninja test</command>.  The tests must "
"be run from a graphical session. Two tests will fail if <xref linkend=\"xdg-"
"desktop-portal\"/> is not installed."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/lib/libadwaita.xml:122
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/x/lib/libadwaita.xml:125
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr ""

