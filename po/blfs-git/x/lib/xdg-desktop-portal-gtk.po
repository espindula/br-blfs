#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/x/lib/xdg-desktop-portal-gtk.xml:85
#, xml-text
msgid "Installation of xdg-desktop-portal-gtk"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/lib/xdg-desktop-portal-gtk.xml:88
#, xml-text
msgid ""
"Install <application>xdg-desktop-portal-gtk</application> by running the "
"following commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/x/lib/xdg-desktop-portal-gtk.xml:92
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr --buildtype=release .. &amp;&amp;\n"
"ninja</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/lib/xdg-desktop-portal-gtk.xml:99
#, xml-text
msgid "This package does not come with a test suite."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/lib/xdg-desktop-portal-gtk.xml:103
#, xml-text
msgid "Now, as the &root; user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/x/lib/xdg-desktop-portal-gtk.xml:106
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/lib/xdg-desktop-portal-gtk.xml:109
#, xml-text
msgid "Remove systemd files that are useless (as the &root; user):"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/x/lib/xdg-desktop-portal-gtk.xml:112
#, no-wrap, xml-text
msgid "<userinput>rm -rvf /usr/lib/systemd</userinput>"
msgstr ""

