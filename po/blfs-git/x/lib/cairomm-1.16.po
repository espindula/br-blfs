#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/x/lib/cairomm-1.16.xml:91
#, xml-text
msgid "Installation of libcairomm-1.16"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/lib/cairomm-1.16.xml:94
#, xml-text
msgid ""
"Install <application>Cairomm-1.16</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/x/lib/cairomm-1.16.xml:98
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir bld &amp;&amp;\n"
"cd    bld &amp;&amp;\n"
"\n"
"meson setup ..             \\\n"
"      --prefix=/usr        \\\n"
"      --buildtype=release  \\\n"
"      -D build-tests=true  \\\n"
"      -D boost-shared=true &amp;&amp;\n"
"ninja</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/lib/cairomm-1.16.xml:109
#, xml-text
msgid "To run the test suite, run: <command>ninja test</command>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/lib/cairomm-1.16.xml:113
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/x/lib/cairomm-1.16.xml:116
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/x/lib/cairomm-1.16.xml:121
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/lib/cairomm-1.16.xml:124
#, xml-text
msgid ""
"<parameter>-D build-tests=true</parameter>: This switch is for building the "
"unit tests. Remove if you have not installed <xref linkend=\"boost\"/>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/lib/cairomm-1.16.xml:129
#, xml-text
msgid ""
"<parameter>-D boost-shared=true</parameter>: This switch has the package use"
" the shared version of boost libraries. It is required if you have not "
"installed the boost static libraries, and you have passed <parameter>-D "
"build-tests=true</parameter>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/lib/cairomm-1.16.xml:136
#, xml-text
msgid ""
"<option>-D build-documentation=true</option>: This switch builds the html "
"documentation if doxygen is installed."
msgstr ""

