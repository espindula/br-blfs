#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/x/lib/kcolorpicker.xml:81
#, xml-text
msgid "Installation of kColorPicker"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/lib/kcolorpicker.xml:84
#, xml-text
msgid ""
"Install <application>kColorPicker</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/x/lib/kcolorpicker.xml:88
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr \\\n"
"      -D CMAKE_BUILD_TYPE=Release  \\\n"
"      -D BUILD_SHARED_LIBS=ON      \\\n"
"      -D BUILD_WITH_QT6=ON         \\\n"
"      .. &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/lib/kcolorpicker.xml:99
#, xml-text
msgid "This package does not come with a test suite."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/lib/kcolorpicker.xml:103
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/x/lib/kcolorpicker.xml:106
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
