#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/x/lib/gtksourceview.xml:98
#, xml-text
msgid "Installation of GtkSourceView"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/lib/gtksourceview.xml:101
#, xml-text
msgid "First, fix building this package with gcc-14 and later:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/x/lib/gtksourceview.xml:104
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"pre\">sed -i 's/g_object_ref (buffer)/g_object_ref "
"(GTK_SOURCE_BUFFER (buffer))/' gtksourceview/gtksourceview.c</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/lib/gtksourceview.xml:107
#, xml-text
msgid ""
"Install <application>GtkSourceView</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/x/lib/gtksourceview.xml:111
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/lib/gtksourceview.xml:116
#, xml-text
msgid ""
"To test the results, issue <command>make check</command>. The tests need to "
"be run in a graphical environment."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/lib/gtksourceview.xml:121
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/x/lib/gtksourceview.xml:124
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr ""

