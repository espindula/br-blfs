#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/x/lib/libhandy1.xml:90
#, xml-text
msgid "Installation of libhandy"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/lib/libhandy1.xml:93
#, xml-text
msgid ""
"Install <application>libhandy</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/x/lib/libhandy1.xml:97
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr --buildtype=release .. &amp;&amp;\n"
"ninja</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/lib/libhandy1.xml:104
#, xml-text
msgid ""
"To test the results, issue: <command>ninja test</command>.  The tests must "
"be run from a graphical session."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/lib/libhandy1.xml:109
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/x/lib/libhandy1.xml:112
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/x/lib/libhandy1.xml:116
#, xml-text
msgid "Command Explanations"
