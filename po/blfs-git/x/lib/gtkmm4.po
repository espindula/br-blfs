#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/x/lib/gtkmm4.xml:86
#, xml-text
msgid "Installation of Gtkmm"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/lib/gtkmm4.xml:89
#, xml-text
msgid ""
"Install <application>Gtkmm</application> by running the following commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/x/lib/gtkmm4.xml:93
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr --buildtype=release .. &amp;&amp;\n"
"ninja</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/lib/gtkmm4.xml:100
#, xml-text
msgid ""
"To test the results, issue: <command>ninja test</command>. Note that you "
"must be in a graphical environment, as the tests try to open some windows."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/lib/gtkmm4.xml:106
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/x/lib/gtkmm4.xml:109
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/lib/gtkmm4.xml:112
#, xml-text
msgid ""
"If you have built the documentation (see Command Explanations below) it was "
"installed to <filename "
"class=\"directory\">/usr/share/doc/gtkmm-4.0</filename>. For consistency, "
"move it to a versioned directory as the <systemitem "
"class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/x/lib/gtkmm4.xml:119
#, no-wrap, xml-text
msgid ""
"<userinput>mv -v /usr/share/doc/gtkmm-4.0 "
"/usr/share/doc/gtkmm-&gtkmm4-version;</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/x/lib/gtkmm4.xml:124
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/lib/gtkmm4.xml:127
#, xml-text
msgid ""
"<option>-D build-documentation=true</option>: If you have installed <xref "
"linkend=\"doxygen\"/> this define will build and install the documentation."
msgstr ""

