"      -D ENABLE_JOURNALD_LOG=OFF      \\\n"
"      -D ENABLE_BUBBLEWRAP_SANDBOX=ON \\\n"
"      -D USE_SYSPROF_CAPTURE=NO       \\\n"
"      -D ENABLE_SPEECH_SYNTHESIS=OFF  \\\n"
"      -W no-dev -G Ninja ..           &amp;&amp;\n"
