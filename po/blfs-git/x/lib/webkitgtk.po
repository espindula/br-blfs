#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/x/lib/webkitgtk.xml:314
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/lib/webkitgtk.xml:320
#, xml-text
msgid ""
"<parameter>-D USE_LIBBACKTRACE=OFF</parameter>: This switch disables the use"
" of libbacktrace for dumping a stack trace when a crash happens.  You need "
"to install &libbacktrace; if you wish to enable it (replacing OFF with ON or"
" just removing the switch)."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/lib/webkitgtk.xml:327
#, xml-text
msgid ""
"<parameter>-D USE_LIBHYPHEN=OFF</parameter>: This switch disables the "
"default automatic hyphenation implementation. You need to install <ulink "
"url=\"https://sourceforge.net/projects/hunspell/files/Hyphen/\">Hyphen</ulink>"
" if you wish to enable it (replacing OFF with ON or just removing the "
"switch)."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/lib/webkitgtk.xml:336
#, xml-text
msgid ""
"<parameter>-D ENABLE_DOCUMENTATION=OFF</parameter>: This switch disables "
"regenerating the documentation. Remove this switch if you have <xref "
"linkend=\"gi-docgen\"/> installed and wish to regenerate the documentation."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/lib/webkitgtk.xml:343
#, xml-text
msgid ""
"<parameter>-D ENABLE_GAMEPAD=OFF</parameter>: This switch disables gamepad "
"support. Remove this switch if you have <ulink "
"url=\"https://gnome.pages.gitlab.gnome.org/libmanette/\">libmanette</ulink> "
"installed and wish to enable it."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/lib/webkitgtk.xml:350
#, xml-text
msgid ""
"<parameter>-D ENABLE_MINIBROWSER=ON</parameter>: This switch enables "
"compiling and installing the MiniBrowser."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/lib/webkitgtk.xml:355
#, xml-text
msgid ""
"<parameter>-D ENABLE_WEBDRIVER=OFF</parameter>: This switch disables "
"compiling and installing <command>WebKitWebDriver</command>.  We use it for "
"the GTK-3 build because the <command>WebKitWebDriver</command> from the "
"GTK-3 build will be overwritten by the GTK-4 build anyway.  Remove this "
"option if you don't plan to build this package with GTK-4."
msgstr ""

#.  Note: This works well on both i686 and x86_64. -renodr
#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/lib/webkitgtk.xml:364
#, xml-text
msgid ""
"<parameter>-D ENABLE_BUBBLEWRAP_SANDBOX=ON</parameter>: This switch enables "
"the Bubblewrap sandbox, which helps mitigate the impact of most security "
"vulnerabilities in this package. Change this switch to OFF if you do not "
"want to install <xref linkend=\"bubblewrap\" role=\"nodep\"/>, <xref "
"linkend='libseccomp' role=\"nodep\"/>, or <xref linkend=\"xdg-dbus-proxy\" "
"role=\"nodep\"/>, but note that this may put you at risk."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/lib/webkitgtk.xml:375
#, xml-text
msgid ""
"<parameter>-D ENABLE_JOURNALD_LOG=OFF</parameter>: This switch disables "
"using the systemd journal for logging errors and debugging information since"
" it is not available on SysV systems."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/lib/webkitgtk.xml:381
#, xml-text
msgid ""
"<parameter>-D USE_SYSPROF_CAPTURE=NO</parameter>: This switch disables a "
"hard dependency on <ulink url=\"&sysprof-url;\">sysprof</ulink>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/lib/webkitgtk.xml:386
#, xml-text
msgid ""
"<parameter>-D ENABLE_SPEECH_SYNTHESIS=OFF</parameter>: This switch disables "
"building speech synthesis support into WebKitGTK because it requires "
"additional external dependencies. You will need both <ulink "
"url=\"http://www.festvox.org/flite/\">flite</ulink> and <ulink "
"url=\"https://github.com/project-spiel/libspiel\">libspiel</ulink> if you "
"wish to enable this."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/lib/webkitgtk.xml:395
#, xml-text
msgid ""
"<option>-D USE_SYSTEM_MALLOC=ON</option>: This switch enables building "
"against the system installed <application>malloc</application>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/lib/webkitgtk.xml:400
#, xml-text
msgid ""
"<option>-D ENABLE_GEOLOCATION=OFF</option>: Use this switch if you don't "
"want to install <xref linkend=\"geoclue2\"/>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/lib/webkitgtk.xml:405
#, xml-text
msgid ""
"<option>-D USE_AVIF=OFF</option>: Use this switch if you don't want to "
"install <xref linkend=\"libavif\"/>. Note that you will not have support for"
" AVIF images if you do this."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/lib/webkitgtk.xml:411
#, xml-text
msgid ""
"<option>-D USE_WOFF2=ON</option>: Use this switch if the optional package "
"<xref linkend=\"woff2\"/> is installed. This adds additional support for "
"fonts."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/lib/webkitgtk.xml:417
#, xml-text
msgid ""
"<option>-D USE_JPEGXL=OFF</option>: Use this switch if the recommended "
"package <xref linkend=\"libjxl\"/> is not installed. Note that you will not "
"have support for JPEG XL images if this option is passed."
msgstr ""

