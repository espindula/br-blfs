#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/x/lib/libdrm.xml:97
#, xml-text
msgid "Installation of Libdrm"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/lib/libdrm.xml:108
#, xml-text
msgid ""
"Install <application>libdrm</application> by running the following commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/x/lib/libdrm.xml:112
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=$XORG_PREFIX \\\n"
"            --buildtype=release   \\\n"
"            -D udev=true          \\\n"
"            -D valgrind=disabled  \\\n"
"            ..                    &amp;&amp;\n"
"ninja</userinput>"
msgstr ""

#. One test,
#.       'threaded' in the nouveau subdirectory, is known to fail with a
#.       30 second timeout.
#.  Regarding the 'threaded' test, it's now skipped by default (2.4.102)
#.            -renodr
#.  Tests may hang
#.       for unknown reasons.
#.  If nouveau threaded test hangs, you can disable it
#.       with
#.       <command>
#. sed -i 's/^TESTS/#&amp;/' tests/nouveau/Makefile.in</command>.
#.       Now that tests are run with ninja, the test merely times out after 30
#. seconds.
#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/lib/libdrm.xml:123
#, xml-text
msgid "To check the results, issue <command>ninja test</command>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/lib/libdrm.xml:139
#, xml-text
msgid "Now, as the &root; user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/x/lib/libdrm.xml:142
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/x/lib/libdrm.xml:147
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/lib/libdrm.xml:153
#, xml-text
msgid ""
"<parameter>-D udev=true</parameter>: This parameter enables support for "
"using <application>Udev</application> instead of <command>mknod</command>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/lib/libdrm.xml:158
#, xml-text
msgid ""
"<parameter>-D valgrind=disabled</parameter>: This parameter disables "
"building libdrm with valgrind support. This fixes building some packages "
"that use libdrm. Change this parameter to \"enabled\" (or remove it) if you "
"need support for valgrind."
msgstr ""

