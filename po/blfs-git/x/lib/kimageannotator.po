#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/lib/kimageannotator.xml:81
#, xml-text
msgid ""
"Install <application>kImageAnnotator</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/x/lib/kimageannotator.xml:85
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr \\\n"
"      -D CMAKE_BUILD_TYPE=Release  \\\n"
"      -D BUILD_SHARED_LIBS=ON      \\\n"
"      -D BUILD_WITH_QT6=ON         \\\n"
"      .. &amp;&amp;\n"
"make</userinput>"
msgstr ""

