#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/x/lib/qtwebengine.xml:184
#, xml-text
msgid "Installation of qtwebengine"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/lib/qtwebengine.xml:195
#, xml-text
msgid ""
"Install <application>qtwebengine</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/x/lib/qtwebengine.xml:199
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_MESSAGE_LOG_LEVEL=STATUS             \\\n"
"      -D QT_FEATURE_webengine_system_ffmpeg=ON      \\\n"
"      -D QT_FEATURE_webengine_system_icu=ON         \\\n"
"      -D QT_FEATURE_webengine_system_libevent=ON    \\\n"
"      -D QT_FEATURE_webengine_proprietary_codecs=ON \\\n"
"      -D QT_FEATURE_webengine_webrtc_pipewire=ON    \\\n"
"      -D QT_BUILD_EXAMPLES_BY_DEFAULT=OFF           \\\n"
"      -D QT_GENERATE_SBOM=OFF                       \\\n"
"      -G Ninja ..                                   &amp;&amp;\n"
"ninja</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/lib/qtwebengine.xml:214
#, xml-text
msgid "This package does not come with a test suite."
