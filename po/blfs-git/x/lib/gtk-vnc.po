#, xml-text
msgid "Installation of Gtk VNC"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/lib/gtk-vnc.xml:98
#, xml-text
msgid ""
"Install <application>Gtk VNC</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/x/lib/gtk-vnc.xml:102
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr --buildtype=release .. &amp;&amp;\n"
"ninja</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/lib/gtk-vnc.xml:109
#, xml-text
msgid "To test the results, issue: <command>ninja test</command>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/lib/gtk-vnc.xml:113
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/x/lib/gtk-vnc.xml:116
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr ""

