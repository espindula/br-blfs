#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/x/wm/fluxbox.xml:93
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"pre\">sed -i '/text_prop.value &gt; 0/s/&gt;/!=/' "
"util/fluxbox-remote.cc</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/wm/fluxbox.xml:96
#, xml-text
msgid ""
"Install <application>Fluxbox</application> by running the following "
"commands:"
