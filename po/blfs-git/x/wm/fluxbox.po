#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/x/wm/fluxbox.xml:100
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/wm/fluxbox.xml:104
#, xml-text
msgid "This package does not have a working test suite."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/wm/fluxbox.xml:108
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/x/wm/fluxbox.xml:111
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr ""

