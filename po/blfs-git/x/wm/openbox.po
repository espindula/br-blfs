#. type: Content of: <sect1><sect2><note><para>
#: blfs-en/blfs-git/x/wm/openbox.xml:102
#, xml-text
msgid ""
"If XORG_PREFIX is not <filename class='directory'>/usr</filename>, tell "
"<command>gcc</command> about it:"
msgstr ""

#. type: Content of: <sect1><sect2><note><screen>
#: blfs-en/blfs-git/x/wm/openbox.xml:106
#, no-wrap, xml-text
msgid "<userinput>export LIBRARY_PATH=$XORG_PREFIX/lib</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/wm/openbox.xml:111
#, xml-text
msgid "Update the package scripts to enable Python 3:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/x/wm/openbox.xml:114
#, no-wrap, xml-text
msgid ""
"<userinput>patch -Np1 -i ../openbox-&openbox-"
"version;-py3-1.patch</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/wm/openbox.xml:117
#, xml-text
msgid ""
"Install <application>Openbox</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/x/wm/openbox.xml:121
#, no-wrap, xml-text
msgid ""
"<userinput>autoreconf -fi &amp;&amp;\n"
"./configure --prefix=/usr     \\\n"
"            --sysconfdir=/etc \\\n"
"            --disable-static  \\\n"
"            --docdir=/usr/share/doc/openbox-&openbox-version; &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/wm/openbox.xml:129
#, xml-text
msgid "This package does not come with a test suite."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/wm/openbox.xml:133
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/x/wm/openbox.xml:136
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/x/wm/openbox.xml:139
#, xml-text
msgid ""
"This package creates three <filename>.desktop</filename> files in the "
"<filename class=\"directory\">/usr/share/xsessions/</filename> directory.  "
"Two of these are not appropriate in a BLFS system, so prevent the extra "
"files showing up as options in a display manager.  As the &root; user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/x/wm/openbox.xml:145
#, no-wrap, xml-text
msgid ""
"<userinput>rm -v "
"/usr/share/xsessions/openbox-{gnome,kde}.desktop</userinput>"
msgstr ""

