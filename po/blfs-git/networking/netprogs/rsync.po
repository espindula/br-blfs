#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/networking/netprogs/rsync.xml:97
#, xml-text
msgid "Installation of rsync"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netprogs/rsync.xml:100
#, xml-text
msgid ""
"For security reasons, running the <application>rsync</application> server as"
" an unprivileged user and group is encouraged. If you intend to run "
"<command>rsync</command> as a daemon, create the <systemitem "
"class=\"username\">rsyncd</systemitem> user and group with the following "
"commands issued by the <systemitem class=\"username\">root</systemitem> "
"user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/networking/netprogs/rsync.xml:108
#, no-wrap, xml-text
msgid ""
"<userinput>groupadd -g 48 rsyncd &amp;&amp;\n"
"useradd -c \"rsyncd Daemon\" -m -d /home/rsync -g rsyncd \\\n"
"    -s /bin/false -u 48 rsyncd</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netprogs/rsync.xml:113
#, xml-text
msgid "First, fix a security vulnerability:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/networking/netprogs/rsync.xml:116
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"pre\">patch -Np1 -i ../rsync-&rsync-"
"version;-security_fix-1.patch</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netprogs/rsync.xml:119
#, xml-text
msgid ""
"Install <application>rsync</application> by running the following commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/networking/netprogs/rsync.xml:123
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr    \\\n"
"            --disable-xxhash \\\n"
"            --without-included-zlib &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netprogs/rsync.xml:129
#, xml-text
msgid ""
"If you have <xref linkend=\"doxygen\"/> installed and wish to build HTML API"
" documentation, issue:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/networking/netprogs/rsync.xml:133
#, no-wrap, xml-text
msgid "<userinput>doxygen</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netprogs/rsync.xml:136
#, xml-text
msgid "To run the tests, fix one test and then run the test suite:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/networking/netprogs/rsync.xml:139
#, no-wrap, xml-text
msgid ""
"<userinput>sed -i '/typedef/d' wildtest.c &amp;&amp;\n"
"make check</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netprogs/rsync.xml:143
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/networking/netprogs/rsync.xml:146
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netprogs/rsync.xml:149
#, xml-text
msgid ""
"If you built the documentation, install it using the following commands as "
"the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/networking/netprogs/rsync.xml:154
#, no-wrap, xml-text
msgid ""
"<userinput>install -v -m755 -d          /usr/share/doc/rsync-&rsync-version;/api &amp;&amp;\n"
"install -v -m644 dox/html/*  /usr/share/doc/rsync-&rsync-version;/api</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/networking/netprogs/rsync.xml:160
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netprogs/rsync.xml:163
#, xml-text
msgid ""
"<parameter>--disable-xxhash</parameter>: This switch disables advanced "
"xxhash checksum support. Remove this switch if you have installed <ulink "
"url=\"https://cyan4973.github.io/xxHash/\">xxhash</ulink>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netprogs/rsync.xml:169
#, xml-text
msgid ""
"<parameter>--without-included-zlib</parameter>: This switch enables "
"compilation with the system-installed zlib library."
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/networking/netprogs/rsync.xml:176
#, xml-text
msgid "Configuring rsync"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><title>
#: blfs-en/blfs-git/networking/netprogs/rsync.xml:179
#, xml-text
msgid "Config Files"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/blfs-git/networking/netprogs/rsync.xml:182
#, xml-text
msgid "<filename>/etc/rsyncd.conf</filename>"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><indexterm><primary>
#: blfs-en/blfs-git/networking/netprogs/rsync.xml:186
#, xml-text
msgid "/etc/rsyncd.conf"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><title>
#: blfs-en/blfs-git/networking/netprogs/rsync.xml:192
#, xml-text
msgid "Configuration Information"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/blfs-git/networking/netprogs/rsync.xml:195
#, xml-text
msgid ""
"For client access to remote files, you may need to install the <xref "
"linkend=\"openssh\"/> package to connect to the remote server."
msgstr ""

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/blfs-git/networking/netprogs/rsync.xml:200
#, xml-text
msgid ""
"This is a simple download-only configuration to set up running "
"<command>rsync</command> as a server. See the <ulink role='man' "
"url='&man;rsyncd.conf.5'>rsyncd.conf(5)</ulink> man-page for additional "
"options (i.e., user authentication)."
msgstr ""

#. type: Content of: <sect1><sect2><sect3><screen>
#: blfs-en/blfs-git/networking/netprogs/rsync.xml:206
#, no-wrap, xml-text
msgid ""
"<userinput>cat &gt; /etc/rsyncd.conf &lt;&lt; \"EOF\"\n"
"<literal># This is a basic rsync configuration file\n"
"# It exports a single module without user authentication.\n"
"\n"
"motd file = /home/rsync/welcome.msg\n"
"use chroot = yes\n"
"\n"
"[localhost]\n"
"    path = /home/rsync\n"
"    comment = Default rsync module\n"
"    read only = yes\n"
"    list = yes\n"
"    uid = rsyncd\n"
"    gid = rsyncd\n"
"</literal>\n"
"EOF</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/blfs-git/networking/netprogs/rsync.xml:224
#, xml-text
msgid ""
"You can find additional configuration information and general documentation "
"about <command>rsync</command> at <ulink "
"url=\"https://rsync.samba.org/documentation.html\"/>."
msgstr ""

#. type: Content of: <sect1><sect2><sect3><title>
#: blfs-en/blfs-git/networking/netprogs/rsync.xml:232
#, xml-text
msgid ""
"<phrase revision=\"sysv\">Boot Script</phrase> <phrase "
"revision=\"systemd\">Systemd Unit</phrase>"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/blfs-git/networking/netprogs/rsync.xml:236
#, xml-text
msgid ""
"Note that you only need to start the <application>rsync</application> server"
" if you want to provide an <application>rsync</application> archive on your "
"local machine.  You don't need this <phrase "
"revision=\"sysv\">script</phrase> <phrase revision=\"systemd\">unit</phrase>"
" to run the <application>rsync</application> client."
msgstr ""

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/blfs-git/networking/netprogs/rsync.xml:245
#, xml-text
msgid ""
"Install the <phrase "
"revision=\"sysv\"><filename>/etc/rc.d/init.d/rsyncd</filename> init "
"script</phrase> <phrase "
"revision=\"systemd\"><filename>rsyncd.service</filename> unit</phrase> "
"included in the <xref linkend=\"bootscripts\" revision=\"sysv\"/> <xref "
"linkend=\"systemd-units\" revision=\"systemd\"/> package."
msgstr ""

#. type: Content of: <sect1><sect2><sect3><screen>
#: blfs-en/blfs-git/networking/netprogs/rsync.xml:254
#, no-wrap, xml-text
msgid "<userinput>make install-rsyncd</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><note><para>
#: blfs-en/blfs-git/networking/netprogs/rsync.xml:258
#, xml-text
msgid ""
"This package comes with two types of units: A service file and a socket "
"file. The service file will start rsync daemon once at boot and it will keep"
" running until the system shuts down. The socket file will make systemd "
"listen on rsync port (Default 873, needs to be edited for anything else) and"
" will start rsync daemon when something tries to connect to that port and "
"stop the daemon when the connection is terminated. This is called socket "
"activation and is analogous to using <application>{,x}inetd</application> on"
" a SysVinit based system."
msgstr ""

#. type: Content of: <sect1><sect2><sect3><note><para>
#: blfs-en/blfs-git/networking/netprogs/rsync.xml:270
#, xml-text
msgid ""
"By default, the first method is used - rsync daemon is started at boot and "
"stopped at shutdown. If the socket method is desired, you need to run as the"
" <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><note><screen>
#: blfs-en/blfs-git/networking/netprogs/rsync.xml:276
#, no-wrap, xml-text
msgid ""
"<userinput>systemctl stop rsyncd &amp;&amp;\n"
"systemctl disable rsyncd &amp;&amp;\n"
"systemctl enable rsyncd.socket &amp;&amp;\n"
"systemctl start rsyncd.socket</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><note><para>
#: blfs-en/blfs-git/networking/netprogs/rsync.xml:282
#, xml-text
msgid ""
"Note that socket method is only useful for remote backups. For local backups"
" you'll need the service method."
msgstr ""

