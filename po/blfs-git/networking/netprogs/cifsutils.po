#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netprogs/cifsutils.xml:122
#, xml-text
msgid "First, make the build system compatible with GCC-15:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/networking/netprogs/cifsutils.xml:125
#, no-wrap, xml-text
msgid "<userinput remap=\"pre\">autoreconf -fiv</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netprogs/cifsutils.xml:128
#, xml-text
msgid ""
"Install <application>cifs-utils</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/networking/netprogs/cifsutils.xml:132
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr \\\n"
"            --disable-pam \\\n"
"            --disable-systemd &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/networking/netprogs/cifsutils.xml:137
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr \\\n"
"            --disable-pam &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netprogs/cifsutils.xml:142
#, xml-text
msgid "This package does not come with a test suite."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netprogs/cifsutils.xml:146
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#.  Note to editors: You need to define ROOTSBINDIR and man8dir, like this:
#.      ROOTSBINDIR=<DESTDIR>
#. /sbin man8dir=<DESTDIR>/usr/share/man/man8
#.      This is due to a bug in the makefile for cifs-utils-6.10, since it
#. tries
#.      to install symlinks for mount.smb3 without thinking about DESTDIR
#.      installations.
#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/networking/netprogs/cifsutils.xml:155
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/networking/netprogs/cifsutils.xml:160
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netprogs/cifsutils.xml:163
#, xml-text
msgid ""
"<parameter>--disable-pam</parameter>: Do not build PAM support.  Remove it "
"and use <option>--with-pamdir</option> (see below), if <xref "
"linkend=\"linux-pam\"/> is installed and you wish PAM support."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netprogs/cifsutils.xml:170
#, xml-text
msgid ""
"<parameter>--disable-systemd</parameter>: Disable systemd specific behavior "
"for <command>mount.cifs</command>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netprogs/cifsutils.xml:175
#, xml-text
msgid ""
"<option>--with-pamdir=/usr/lib/security</option>: Install the PAM module in "
"<filename class=\"directory\">/usr/lib/security</filename>."
msgstr ""

