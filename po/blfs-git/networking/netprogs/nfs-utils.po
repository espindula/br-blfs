#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/networking/netprogs/nfs-utils.xml:117
#, xml-text
msgid "Kernel Configuration"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netprogs/nfs-utils.xml:120
#, xml-text
msgid ""
"Enable the following options in the kernel configuration (choose client "
"and/or server support as appropriate) and recompile the kernel if necessary:"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netprogs/nfs-utils.xml:129
#, xml-text
msgid ""
"Select the appropriate sub-options that appear when the above options are "
"selected."
msgstr ""

#. type: Content of: <sect1><sect2><note><para>
#: blfs-en/blfs-git/networking/netprogs/nfs-utils.xml:135
#, xml-text
msgid ""
"In BLFS we assume that nfs v3 will be used. If the "
"<emphasis>server</emphasis> offers nfs v4 (for linux, CONFIG_NFSD_V4)  then "
"auto-negotiation for v3 will fail and you will need to add "
"<literal>nfsver=3</literal> to the mount options. This also applies if that "
"option is enabled in the <emphasis>client's</emphasis> kernel, for example "
"in a distro trying to mount from a BLFS v3 server."
msgstr ""

#. type: Content of: <sect1><sect2><note><para>
#: blfs-en/blfs-git/networking/netprogs/nfs-utils.xml:143
#, xml-text
msgid ""
"Even if neither end of the connection supports nfs v4, adding "
"<literal>nfsver=3</literal> is still beneficial because it prevents an error"
" message \"NFS: bad mount option value specified: minorversion=1\" being "
"logged on every mount."
msgstr ""

#. type: Attribute 'xreflabel' of: <sect1><sect2>
#: blfs-en/blfs-git/networking/netprogs/nfs-utils.xml:157
#, xml-text
msgid "NFS Utilities Installation"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/networking/netprogs/nfs-utils.xml:158
#, xml-text
msgid "Installation of NFS Utilities"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netprogs/nfs-utils.xml:189
#, xml-text
msgid ""
"Install <application>NFS Utilities</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/networking/netprogs/nfs-utils.xml:193
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr       \\\n"
"            --sysconfdir=/etc   \\\n"
"            --sbindir=/usr/sbin \\\n"
"            --disable-nfsv4     \\\n"
"            --disable-gss       \\\n"
"            LIBS=\"-lsqlite3 -levent_core\" &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netprogs/nfs-utils.xml:209
#, xml-text
msgid "Now, as the &root; user:"
msgstr ""

#.  dev note: make statduser=$(whoami) DESTDIR=<DESTDIR>
#.  install
#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/networking/netprogs/nfs-utils.xml:214
#, no-wrap, xml-text
msgid ""
"<userinput>make install                       &amp;&amp;\n"
"chmod u+w,go+r /usr/sbin/mount.nfs &amp;&amp;\n"
"chown nobody:nogroup /var/lib/nfs</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netprogs/nfs-utils.xml:219
#, xml-text
msgid ""
"The tests for this package require that the package be installed.  In "
"addition, the rpc.statd daemon must not be running and the tests need to be "
"run as the &root; user."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netprogs/nfs-utils.xml:225
#, xml-text
msgid "To test the results, issue, as &root;:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/networking/netprogs/nfs-utils.xml:228
#, no-wrap, xml-text
msgid "<userinput>make check</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/networking/netprogs/nfs-utils.xml:233
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netprogs/nfs-utils.xml:247
#, xml-text
msgid ""
"<parameter>--disable-gss</parameter>: Disables GSSAPI support in this "
"package. If you need to use it, make sure that <xref linkend=\"mitkrb\"/> is"
" installed, and that you have GSSAPI support enabled in <xref "
"linkend=\"libtirpc\"/> as well."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netprogs/nfs-utils.xml:254
#, xml-text
msgid ""
"<parameter>LIBS=\"-lsqlite3 -levent_core\"</parameter>: is required for the "
"fsidd program."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netprogs/nfs-utils.xml:259
#, xml-text
msgid ""
"<command>chown nobody:nogroup /var/lib/nfs</command>: The rpc.statd program "
"uses the ownership of this directory to set it's UID and GID.  This command "
"sets those to unprivileged entries."
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/networking/netprogs/nfs-utils.xml:267
#, xml-text
msgid "Configuring NFS Utilities"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><title>
#: blfs-en/blfs-git/networking/netprogs/nfs-utils.xml:270
#, xml-text
msgid "Server Configuration"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/blfs-git/networking/netprogs/nfs-utils.xml:273
#, xml-text
msgid ""
"<filename>/etc/exports</filename> contains the exported directories on NFS "
"servers. Refer to the <filename>exports.5</filename> manual page for the "
"syntax of this file. Also refer to the \"NFS HowTo\" available at <ulink "
"url=\"https://nfs.sourceforge.net/nfs-howto/\"/> for information on how to "
"configure the servers and clients in a secure manner. For example, for "
"sharing the <filename class=\"directory\">/home</filename> directory over "
"the local network, the following line may be added:"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><screen>
#: blfs-en/blfs-git/networking/netprogs/nfs-utils.xml:282
#, no-wrap, xml-text
msgid ""
"<userinput>cat &gt;&gt; /etc/exports &lt;&lt; EOF\n"
"<replaceable>/home 192.168.0.0/24</replaceable>(rw,subtree_check,anonuid=99,anongid=99)\n"
"EOF</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><note><para>
#: blfs-en/blfs-git/networking/netprogs/nfs-utils.xml:288
#, xml-text
msgid ""
"Be sure to replace the directory, network address. and prefix above to match"
" your network.  The only space in the line above should be between the "
"directory and the network address."
msgstr ""

#. type: Content of: <sect1><sect2><sect3><indexterm><primary>
#: blfs-en/blfs-git/networking/netprogs/nfs-utils.xml:295
#, xml-text
msgid "/etc/exportfs"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><sect4><title>
#: blfs-en/blfs-git/networking/netprogs/nfs-utils.xml:299
#: blfs-en/blfs-git/networking/netprogs/nfs-utils.xml:410
#, xml-text
msgid ""
"<phrase revision=\"sysv\">Boot Script</phrase> <phrase "
"revision=\"systemd\">Systemd Units</phrase>"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><sect4><para>
#: blfs-en/blfs-git/networking/netprogs/nfs-utils.xml:303
#, xml-text
msgid ""
"Install the <phrase revision=\"sysv\"> <filename>/etc/rc.d/init.d/nfs-"
"server</filename> init script </phrase> <phrase revision=\"systemd\">NFSv4 "
"server units</phrase> included in the <xref linkend=\"bootscripts\" "
"revision=\"sysv\"/> <xref linkend=\"systemd-units\" revision=\"systemd\"/> "
"package to start the server at boot."
msgstr ""

#. type: Content of: <sect1><sect2><sect3><sect4><screen>
#: blfs-en/blfs-git/networking/netprogs/nfs-utils.xml:314
#, no-wrap, xml-text
msgid "<userinput>make install-nfsv4-server</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><sect4><para>
#: blfs-en/blfs-git/networking/netprogs/nfs-utils.xml:317
#, xml-text
msgid ""
"If you have disabled NFSv4 support, run the following command as the "
"<systemitem class=\"username\">root</systemitem> user to omit the NFSv4 "
"specific systemd units:"
msgstr ""

#.  both
#. type: Content of: <sect1><sect2><sect3><sect4><screen>
#: blfs-en/blfs-git/networking/netprogs/nfs-utils.xml:323
#, no-wrap, xml-text
msgid "<userinput>make install-nfs-server</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><sect4><indexterm><primary>
#: blfs-en/blfs-git/networking/netprogs/nfs-utils.xml:326
#, xml-text
msgid "nfs-server"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><sect4><para>
#: blfs-en/blfs-git/networking/netprogs/nfs-utils.xml:330
#, xml-text
msgid ""
"Now create the <filename>/etc/sysconfig/nfs-server</filename> configuration "
"file:"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><sect4><screen>
#: blfs-en/blfs-git/networking/netprogs/nfs-utils.xml:334
#, no-wrap, xml-text
msgid ""
"<userinput>cat &gt; /etc/sysconfig/nfs-server &lt;&lt; \"EOF\"\n"
"<literal>PORT=\"2049\"\n"
"PROCESSES=\"8\"\n"
"KILLDELAY=\"10\"</literal>\n"
"EOF</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><sect4><note><para>
#: blfs-en/blfs-git/networking/netprogs/nfs-utils.xml:342
#, xml-text
msgid ""
"The above parameters may be optionally placed in "
"<filename>/etc/sysconfig/rc.site</filename>."
msgstr ""

#. type: Content of: <sect1><sect2><sect3><sect4><indexterm><primary>
#: blfs-en/blfs-git/networking/netprogs/nfs-utils.xml:349
#, xml-text
msgid "/etc/sysconfig/nfs-server"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><sect4><para>
#: blfs-en/blfs-git/networking/netprogs/nfs-utils.xml:353
#, xml-text
msgid ""
"You can edit the <filename>/etc/default/nfs-utils</filename> file to change "
"the startup options for NFS daemons. Defaults should be fine for most use "
"cases."
msgstr ""

#. type: Content of: <sect1><sect2><sect3><sect4><indexterm><primary>
#: blfs-en/blfs-git/networking/netprogs/nfs-utils.xml:359
#, xml-text
msgid "/etc/default/nfs-utils"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><title>
#: blfs-en/blfs-git/networking/netprogs/nfs-utils.xml:367
#, xml-text
msgid "Client Configuration"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/blfs-git/networking/netprogs/nfs-utils.xml:370
#, xml-text
msgid ""
"<filename>/etc/fstab</filename> contains the directories that are to be "
"mounted on the client. Alternately the partitions can be mounted by using "
"the <command>mount</command> command with the proper options. To mount the "
"<filename class=\"directory\">/home</filename> and <filename "
"class=\"directory\">/usr</filename> partitions, add the following to the "
"<filename>/etc/fstab</filename>:"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><screen>
#: blfs-en/blfs-git/networking/netprogs/nfs-utils.xml:378
#, no-wrap, xml-text
msgid ""
"<userinput><replaceable>&lt;server-name&gt;</replaceable>:/home  /home nfs   rw,_netdev 0 0\n"
"<replaceable>&lt;server-name&gt;</replaceable>:/usr   /usr  nfs   ro,_netdev 0 0</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/blfs-git/networking/netprogs/nfs-utils.xml:382
#, xml-text
msgid ""
"The options which can be used are specified in <command>man 5 nfs "
"</command>. If both the client and server are running recent versions of "
"linux, most of the options will be negotiated (but see the Note above on "
"nfsver=3). You can specify either <literal>rw</literal> or "
"<literal>ro</literal>, <literal>_netdev</literal> if the filesystem is to be"
" automatically mounted at boot, or <literal>noauto</literal> (and perhaps "
"<literal>user</literal>) for other filesystems."
msgstr ""

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/blfs-git/networking/netprogs/nfs-utils.xml:392
#, xml-text
msgid ""
"If the fileserver is not running a recent version of linux, you may need to "
"specify other options."
msgstr ""

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/blfs-git/networking/netprogs/nfs-utils.xml:397
#, xml-text
msgid ""
"You may need to enable autofs v4 in your kernel, and add the option "
"<literal>comment=systemd.automount</literal>. Some machines may need this "
"because systemd tries to mount the external filesystems before the network "
"is up. An alternative is to run <command>mount -a</command> as the "
"<systemitem class=\"username\">root</systemitem> user after the system has "
"started."
msgstr ""

#. type: Content of: <sect1><sect2><sect3><indexterm><primary>
#: blfs-en/blfs-git/networking/netprogs/nfs-utils.xml:406
#, xml-text
msgid "/etc/fstab"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><sect4><note><para>
#: blfs-en/blfs-git/networking/netprogs/nfs-utils.xml:415
#, xml-text
msgid ""
"The following <phrase revision=\"sysv\">boot script is</phrase> <phrase "
"revision=\"systemd\">systemd units are</phrase> not required if the nfs-"
"server <phrase revision=\"sysv\">script is</phrase> <phrase "
"revision=\"systemd\">units are</phrase> installed."
msgstr ""

#. type: Content of: <sect1><sect2><sect3><sect4><para>
#: blfs-en/blfs-git/networking/netprogs/nfs-utils.xml:423
#, xml-text
msgid ""
"Install the <phrase revision=\"sysv\"> <filename>/etc/rc.d/init.d/nfs-"
"client</filename> init script </phrase> <phrase "
"revision=\"systemd\">units</phrase> included in the <xref "
"linkend=\"bootscripts\" revision=\"sysv\"/> <xref linkend=\"systemd-units\" "
"revision=\"systemd\"/> package to start the client services at boot."
msgstr ""

#. type: Content of: <sect1><sect2><sect3><sect4><screen>
#: blfs-en/blfs-git/networking/netprogs/nfs-utils.xml:433
#, no-wrap, xml-text
msgid "<userinput>make install-nfs-client</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><sect4><indexterm><primary>
#: blfs-en/blfs-git/networking/netprogs/nfs-utils.xml:436
#, xml-text
msgid "nfs-client"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><sect4><para>
#: blfs-en/blfs-git/networking/netprogs/nfs-utils.xml:440
#, xml-text
msgid ""
"To automatically mount <systemitem class=\"filesystem\">nfs </systemitem> "
"filesystems, clients will also need to install the "
"<filename>netfs</filename> bootscript as described in <xref "
"linkend=\"postlfs-config-netfs\"/>."
msgstr ""

#. type: Content of: <sect1><sect2><sect3><sect4><indexterm><primary>
#: blfs-en/blfs-git/networking/netprogs/nfs-utils.xml:447
#, xml-text
msgid "netfs"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/networking/netprogs/nfs-utils.xml:457
#, xml-text
msgid "Contents"
msgstr ""

#. type: Content of: <sect1><sect2><segmentedlist><segtitle>
#: blfs-en/blfs-git/networking/netprogs/nfs-utils.xml:459
#, xml-text
msgid "Installed Programs"
msgstr ""

#. type: Content of: <sect1><sect2><segmentedlist><segtitle>
#: blfs-en/blfs-git/networking/netprogs/nfs-utils.xml:460
#, xml-text
msgid "Installed Libraries"
msgstr ""

#. type: Content of: <sect1><sect2><segmentedlist><segtitle>
#: blfs-en/blfs-git/networking/netprogs/nfs-utils.xml:461
#, xml-text
msgid "Installed Directories"
msgstr ""

#. type: Content of: <sect1><sect2><segmentedlist><seglistitem><seg>
#: blfs-en/blfs-git/networking/netprogs/nfs-utils.xml:464
#, xml-text
msgid ""
"exportfs, fsidd, mountstats, mount.nfs, mount.nfs4 (link to mount.nfs), "
"nfsconf, nfsdclnts, nfsiostat, nfsstat, rpc.mountd, rpc.nfsd, rpc.statd, "
"rpcdebug, showmount, sm-notify, start-statd, umount.nfs (link to mount.nfs),"
" and umount.nfs4 (link to mount.nfs)"
msgstr ""

#. type: Content of: <sect1><sect2><segmentedlist><seglistitem><seg>
#: blfs-en/blfs-git/networking/netprogs/nfs-utils.xml:468
#, xml-text
msgid "None"
