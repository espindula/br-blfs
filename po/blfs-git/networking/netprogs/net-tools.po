#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/networking/netprogs/net-tools.xml:84
#, xml-text
msgid "Installation of Net-tools"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netprogs/net-tools.xml:87
#, xml-text
msgid ""
"The instructions below automate the configuration process by piping "
"<command>yes</command> to the <command>make</command> command.  If you wish "
"to run the interactive configuration process (by changing the instruction to"
" just <command>make</command>), but you are not sure how to answer all the "
"questions, then just accept the defaults.  This will be just fine in the "
"majority of cases. What you're asked here is a bunch of questions about "
"which network protocols you've enabled in your kernel. The default answers "
"will enable the tools from this package to work with the most common "
"protocols: TCP, PPP, and several others. You still need to actually enable "
"these protocols in the kernel&mdash;what you do here is merely tell the "
"package to include support for those protocols in its programs, but it's up "
"to the kernel to make the protocols available."
msgstr ""

#. type: Content of: <sect1><sect2><note><para>
#: blfs-en/blfs-git/networking/netprogs/net-tools.xml:104
#, xml-text
msgid ""
"This package has several unneeded protocols and hardware device specific "
"functions that are obsolete. To only build the minimum needed for your "
"system, skip the <command>yes</command> command and answer each question "
"interactively.  The minimum needed options are 'UNIX protocol family' and "
"'INET (TCP/IP) protocol family'."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netprogs/net-tools.xml:113
#, xml-text
msgid ""
"For this package, we use the DESTDIR method of installation in order to "
"easily remove files from the build that overwrite those that we want to keep"
" or are not appropriate for our system."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netprogs/net-tools.xml:122
#, xml-text
msgid ""
"Install <application>Net-tools</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/networking/netprogs/net-tools.xml:126
#, no-wrap, xml-text
msgid ""
"<userinput>export BINDIR='/usr/bin' SBINDIR='/usr/bin' &amp;&amp;\n"
"yes \"\" | make -j1                           &amp;&amp;\n"
"make DESTDIR=$PWD/install -j1 install       &amp;&amp;\n"
"rm    install/usr/bin/{nis,yp}domainname    &amp;&amp;\n"
"rm    install/usr/bin/{hostname,dnsdomainname,domainname,ifconfig} &amp;&amp;\n"
"rm -r install/usr/share/man/man1            &amp;&amp;\n"
"rm    install/usr/share/man/man8/ifconfig.8 &amp;&amp;\n"
"unset BINDIR SBINDIR</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netprogs/net-tools.xml:136
#, xml-text
msgid "This package does not come with a test suite."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netprogs/net-tools.xml:140
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/networking/netprogs/net-tools.xml:143
#, no-wrap, xml-text
msgid ""
"<userinput>chown -R root:root install &amp;&amp;\n"
"cp -a install/* /</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/networking/netprogs/net-tools.xml:149
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netprogs/net-tools.xml:152
#, xml-text
msgid ""
"<command>export BINDIR='/usr/bin' SBINDIR='/usr/bin'</command>: Ensure the "
"executables are installed in the correct location."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netprogs/net-tools.xml:157
#, xml-text
msgid ""
"<command>yes \"\" | make </command>: Piping <command>yes</command> to "
"<command>make config</command> skips the interactive configuration and "
"accepts the defaults."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netprogs/net-tools.xml:163
#, xml-text
msgid "<command>rm ...</command>: Remove unneeded programs and man pages."
msgstr ""

