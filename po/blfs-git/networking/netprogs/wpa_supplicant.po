#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/networking/netprogs/wpa_supplicant.xml:123
#, xml-text
msgid "Installation of WPA Supplicant"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netprogs/wpa_supplicant.xml:126
#, xml-text
msgid ""
"First you will need to create an initial configuration file for the build "
"process. You can read <filename>wpa_supplicant/README</filename> and "
"<filename>wpa_supplicant/defconfig</filename> for the explanation of the "
"following options as well as other options that can be used.  Create a build"
" configuration file that should work for standard WiFi setups by running the"
" following command:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/networking/netprogs/wpa_supplicant.xml:134
#, no-wrap, xml-text
msgid ""
"<userinput>cat &gt; wpa_supplicant/.config &lt;&lt; \"EOF\"\n"
"<literal>CONFIG_BACKEND=file\n"
"CONFIG_CTRL_IFACE=y\n"
"CONFIG_DEBUG_FILE=y\n"
"CONFIG_DEBUG_SYSLOG=y\n"
"CONFIG_DEBUG_SYSLOG_FACILITY=LOG_DAEMON\n"
"CONFIG_DRIVER_NL80211=y\n"
"CONFIG_DRIVER_WEXT=y\n"
"CONFIG_DRIVER_WIRED=y\n"
"CONFIG_EAP_GTC=y\n"
"CONFIG_EAP_LEAP=y\n"
"CONFIG_EAP_MD5=y\n"
"CONFIG_EAP_MSCHAPV2=y\n"
"CONFIG_EAP_OTP=y\n"
"CONFIG_EAP_PEAP=y\n"
"CONFIG_EAP_TLS=y\n"
"CONFIG_EAP_TTLS=y\n"
"CONFIG_IEEE8021X_EAPOL=y\n"
"CONFIG_IPV6=y\n"
"CONFIG_LIBNL32=y\n"
"CONFIG_PEERKEY=y\n"
"CONFIG_PKCS12=y\n"
"CONFIG_READLINE=y\n"
"CONFIG_SMARTCARD=y\n"
"CONFIG_WPS=y\n"
"CFLAGS += -I/usr/include/libnl3</literal>\n"
"EOF</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netprogs/wpa_supplicant.xml:163
#, xml-text
msgid ""
"If you wish to use <application>WPA Supplicant</application> with <xref "
"linkend=\"NetworkManager\"/>, <phrase revision='sysv'>make sure that you "
"have installed <xref linkend=\"dbus\"/>, then</phrase> add the following "
"options to the <application>WPA Supplicant</application> build configuration"
" file by running the following command:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/networking/netprogs/wpa_supplicant.xml:170
#, no-wrap, xml-text
msgid ""
"<userinput>cat &gt;&gt; wpa_supplicant/.config &lt;&lt; \"EOF\"\n"
"<literal>CONFIG_CTRL_IFACE_DBUS=y\n"
"CONFIG_CTRL_IFACE_DBUS_NEW=y\n"
"CONFIG_CTRL_IFACE_DBUS_INTRO=y</literal>\n"
"EOF</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netprogs/wpa_supplicant.xml:186
#, xml-text
msgid ""
"Install <application>WPA Supplicant</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/networking/netprogs/wpa_supplicant.xml:190
#, no-wrap, xml-text
msgid ""
"<userinput>cd wpa_supplicant &amp;&amp;\n"
"make BINDIR=/usr/sbin LIBDIR=/usr/lib</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netprogs/wpa_supplicant.xml:194
#, xml-text
msgid "This package does not come with a test suite."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netprogs/wpa_supplicant.xml:198
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/networking/netprogs/wpa_supplicant.xml:201
#, no-wrap, xml-text
msgid ""
"<userinput>install -v -m755 wpa_{cli,passphrase,supplicant} /usr/sbin/ &amp;&amp;\n"
"install -v -m644 doc/docbook/wpa_supplicant.conf.5 /usr/share/man/man5/ &amp;&amp;\n"
"install -v -m644 doc/docbook/wpa_{cli,passphrase,supplicant}.8 /usr/share/man/man8/</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netprogs/wpa_supplicant.xml:206
#, xml-text
msgid ""
"Install the <application>systemd</application> support files by running the "
"following command as the <systemitem class=\"username\">root</systemitem> "
"user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/networking/netprogs/wpa_supplicant.xml:211
#, no-wrap, xml-text
msgid ""
"<userinput>install -v -m644 systemd/*.service "
"/usr/lib/systemd/system/</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netprogs/wpa_supplicant.xml:214
#, xml-text
msgid ""
"If you have built <application>WPA Supplicant</application> with "
"<application>D-Bus</application> support, you will need to install "
"<application>D-Bus</application> configuration files. Install them by "
"running the following commands as the <systemitem "
"class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/networking/netprogs/wpa_supplicant.xml:221
#, no-wrap, xml-text
msgid ""
"<userinput>install -v -m644 dbus/fi.w1.wpa_supplicant1.service \\\n"
"                 /usr/share/dbus-1/system-services/ &amp;&amp;\n"
"install -v -d -m755 /etc/dbus-1/system.d &amp;&amp;\n"
"install -v -m644 dbus/dbus-wpa_supplicant.conf \\\n"
"                 /etc/dbus-1/system.d/wpa_supplicant.conf</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><note><para>
#: blfs-en/blfs-git/networking/netprogs/wpa_supplicant.xml:229
#, xml-text
msgid ""
"You will need to restart the system <application>D-Bus</application> daemon "
"before you can use the <application>WPA Supplicant</application> "
"<application>D-Bus</application> interface."
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/networking/netprogs/wpa_supplicant.xml:241
#, xml-text
msgid "Configuring wpa_supplicant"
msgstr ""

#. type: Content of: <sect1><sect2><important><para>
#: blfs-en/blfs-git/networking/netprogs/wpa_supplicant.xml:245
#, xml-text
msgid ""
"If you are using WPA Supplicant with <xref linkend='NetworkManager'/> (or "
"anything communicating with WPA Supplicant via D-Bus), this section should "
"be skipped.  Running a D-Bus connected WPA Supplicant instance and another "
"WPA supplicant instance configured following this section simultaneously can"
" cause subtle issues."
msgstr ""

#. type: Content of: <sect1><sect2><sect3><title>
#: blfs-en/blfs-git/networking/netprogs/wpa_supplicant.xml:255
#, xml-text
msgid "Config File"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/blfs-git/networking/netprogs/wpa_supplicant.xml:258
#, xml-text
msgid "<filename>/etc/sysconfig/wpa_supplicant-*.conf</filename>"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/blfs-git/networking/netprogs/wpa_supplicant.xml:262
#, xml-text
msgid "<filename>/etc/wpa_supplicant/wpa_supplicant-*.conf</filename>"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><indexterm><primary>
#: blfs-en/blfs-git/networking/netprogs/wpa_supplicant.xml:267
#, xml-text
msgid "/etc/sysconfig/wpa_supplicant-*.conf"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><indexterm><primary>
#: blfs-en/blfs-git/networking/netprogs/wpa_supplicant.xml:272
#, xml-text
msgid "/etc/wpa_supplicant/wpa_supplicant-*.conf"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><title>
#: blfs-en/blfs-git/networking/netprogs/wpa_supplicant.xml:278
#, xml-text
msgid "Configuration Information"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/blfs-git/networking/netprogs/wpa_supplicant.xml:281
#, xml-text
msgid ""
"To connect to an access point that uses a password, you need to put the pre-"
"shared key in <phrase revision=\"sysv\"> <filename> "
"/etc/sysconfig/wpa_supplicant-<replaceable>wifi0</replaceable>.conf</filename>."
"  </phrase> <phrase revision=\"systemd\"> <filename> "
"/etc/wpa_supplicant/wpa_supplicant-<replaceable>wifi0</replaceable>.conf</filename>."
"  </phrase> SSID is the string that the access point/router transmits to "
"identify itself. Run the following command as the <systemitem "
"class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><screen>
#: blfs-en/blfs-git/networking/netprogs/wpa_supplicant.xml:296
#, no-wrap, xml-text
msgid ""
"<userinput>wpa_passphrase <replaceable>SSID</replaceable> | sed '/^\\t#/d' "
"&gt; "
"/etc/sysconfig/wpa_supplicant-<replaceable>wifi0</replaceable>.conf</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><screen>
#: blfs-en/blfs-git/networking/netprogs/wpa_supplicant.xml:298
#, no-wrap, xml-text
msgid ""
"<userinput>install -v -dm755 /etc/wpa_supplicant &amp;&amp;\n"
"wpa_passphrase <replaceable>SSID</replaceable> | sed '/^\\t#/d' &gt; /etc/wpa_supplicant/wpa_supplicant-<replaceable>wifi0</replaceable>.conf</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/blfs-git/networking/netprogs/wpa_supplicant.xml:302
#, xml-text
msgid ""
"The <command>wpa_supplicant</command> command will ask you to input the "
"password of the access point."
msgstr ""

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/blfs-git/networking/netprogs/wpa_supplicant.xml:307
#, xml-text
msgid ""
"<phrase revision=\"sysv\"> <filename> "
"/etc/sysconfig/wpa_supplicant-<replaceable>wifi0</replaceable>.conf "
"</filename> </phrase> <phrase revision=\"systemd\"> <filename> "
"/etc/wpa_supplicant/wpa_supplicant-<replaceable>wifi0</replaceable>.conf "
"</filename> </phrase> can hold the details of several access points. When "
"<command>wpa_supplicant</command> is started, it will scan for the SSIDs it "
"can see and choose the appropriate password to connect."
msgstr ""

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/blfs-git/networking/netprogs/wpa_supplicant.xml:323
#, xml-text
msgid ""
"If you want to connect to an access point that isn't password protected, put"
" an entry like this in <phrase revision=\"sysv\"> <filename> "
"/etc/sysconfig/wpa_supplicant-<replaceable>wifi0</replaceable>.conf</filename>."
"  </phrase> <phrase revision=\"systemd\"> <filename> "
"/etc/wpa_supplicant/wpa_supplicant-<replaceable>wifi0</replaceable>.conf</filename>."
"  </phrase> Replace \"Some-SSID\" with the SSID of the access point/router."
msgstr ""

#. type: Content of: <sect1><sect2><sect3><screen>
#: blfs-en/blfs-git/networking/netprogs/wpa_supplicant.xml:336
#, no-wrap, xml-text
msgid ""
"network={\n"
"  ssid=\"<replaceable>Some-SSID</replaceable>\"\n"
"  key_mgmt=NONE\n"
"}"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/blfs-git/networking/netprogs/wpa_supplicant.xml:342
#, xml-text
msgid ""
"Connecting to a new access point that is not in the configuration file can "
"be accomplished manually via the command line, but it must be done via a "
"privileged user. To do that, add the following to the configuration file:"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><screen>
#: blfs-en/blfs-git/networking/netprogs/wpa_supplicant.xml:348
#, no-wrap, xml-text
msgid ""
"ctrl_interface=DIR=/run/wpa_supplicant GROUP=&lt;privileged group&gt;\n"
"update_config=1"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/blfs-git/networking/netprogs/wpa_supplicant.xml:352
#, xml-text
msgid ""
"Replace the &lt;privileged group&gt; above with a system group where members"
" have the ability to connect to a wireless access point."
msgstr ""

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/blfs-git/networking/netprogs/wpa_supplicant.xml:357
#, xml-text
msgid ""
"There are many options that you could use to tweak how you connect to each "
"access point. They are described in some detail in the "
"<filename>wpa_supplicant/wpa_supplicant.conf</filename> file in the source "
"tree."
msgstr ""

#. type: Content of: <sect1><sect2><sect3><title>
#: blfs-en/blfs-git/networking/netprogs/wpa_supplicant.xml:366
#, xml-text
msgid "Connecting to an Access Point"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/blfs-git/networking/netprogs/wpa_supplicant.xml:369
#, xml-text
msgid ""
"If you want to configure network interfaces at boot using "
"<command>wpa_supplicant</command>, you need to install the "
"<filename>/lib/services/wpa</filename> script included in <xref "
"linkend=\"bootscripts\"/> package:"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><screen>
#: blfs-en/blfs-git/networking/netprogs/wpa_supplicant.xml:375
#, no-wrap, xml-text
msgid "<userinput>make install-service-wpa</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><indexterm><primary>
#: blfs-en/blfs-git/networking/netprogs/wpa_supplicant.xml:378
#, xml-text
msgid "wpa"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/blfs-git/networking/netprogs/wpa_supplicant.xml:382
#, xml-text
msgid ""
"If your router/access point uses DHCP to allocate IP addresses, you can "
"install <xref linkend=\"dhcpcd\" role=\"nodep\"/> and use it to "
"automatically obtain network addresses. Create the "
"<filename>/etc/sysconfig/ifconfig-<replaceable>wifi0</replaceable> "
"</filename> by running the following command as the <systemitem "
"class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><screen>
#: blfs-en/blfs-git/networking/netprogs/wpa_supplicant.xml:390
#, no-wrap, xml-text
msgid ""
"<userinput>cat &gt; /etc/sysconfig/ifconfig.<replaceable>wifi0</replaceable> &lt;&lt; \"EOF\"\n"
"<literal>ONBOOT=\"yes\"\n"
"IFACE=\"<replaceable>wlan0</replaceable>\"\n"
"SERVICE=\"wpa\"\n"
"\n"
"# Additional arguments to wpa_supplicant\n"
"WPA_ARGS=\"\"\n"
"\n"
"WPA_SERVICE=\"dhcpcd\"\n"
"DHCP_START=\"-b -q <replaceable>&lt;insert appropriate start options here&gt;</replaceable>\"\n"
"DHCP_STOP=\"-k <replaceable>&lt;insert additional stop options here&gt;</replaceable>\"</literal>\n"
"EOF</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/blfs-git/networking/netprogs/wpa_supplicant.xml:404
#, xml-text
msgid ""
"Alternatively, if you use static addresses on your local network, then "
"create the "
"<filename>/etc/sysconfig/ifconfig-<replaceable>wifi0</replaceable> "
"</filename> by running the following command as the <systemitem "
"class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><screen>
#: blfs-en/blfs-git/networking/netprogs/wpa_supplicant.xml:411
#, no-wrap, xml-text
msgid ""
"<userinput>cat &gt; /etc/sysconfig/ifconfig.<replaceable>wifi0</replaceable> &lt;&lt; \"EOF\"\n"
"<literal>ONBOOT=\"yes\"\n"
"IFACE=\"<replaceable>wlan0</replaceable>\"\n"
"SERVICE=\"wpa\"\n"
"\n"
"# Additional arguments to wpa_supplicant\n"
"WPA_ARGS=\"\"\n"
"\n"
"WPA_SERVICE=\"ipv4-static\"\n"
"IP=\"192.168.1.1\"\n"
"GATEWAY=\"192.168.1.2\"\n"
"PREFIX=\"24\"\n"
"BROADCAST=\"192.168.1.255\"</literal>\n"
"EOF</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/blfs-git/networking/netprogs/wpa_supplicant.xml:427
#, xml-text
msgid ""
"There are 3 types of <application>systemd</application> units that were "
"installed:"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><itemizedlist><listitem><para>
#: blfs-en/blfs-git/networking/netprogs/wpa_supplicant.xml:434
#, xml-text
msgid "wpa_supplicant@.service"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><itemizedlist><listitem><para>
#: blfs-en/blfs-git/networking/netprogs/wpa_supplicant.xml:439
#, xml-text
msgid "wpa_supplicant-nl80211@.service"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><itemizedlist><listitem><para>
#: blfs-en/blfs-git/networking/netprogs/wpa_supplicant.xml:444
#, xml-text
msgid "wpa_supplicant-wired@.service"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/blfs-git/networking/netprogs/wpa_supplicant.xml:450
#, xml-text
msgid ""
"The only difference between 3 of them is what driver is used for connecting "
"(-D option). The first one uses the default driver, the second one uses the "
"nl80211 driver and the third one uses the wired driver."
msgstr ""

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/blfs-git/networking/netprogs/wpa_supplicant.xml:457
#, xml-text
msgid ""
"You can connect to the wireless access point by running the following "
"command as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><screen>
#: blfs-en/blfs-git/networking/netprogs/wpa_supplicant.xml:462
#, no-wrap, xml-text
msgid "<userinput>ifup <replaceable>wifi0</replaceable></userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/blfs-git/networking/netprogs/wpa_supplicant.xml:465
#, xml-text
msgid ""
"Replace <replaceable>wlan0</replaceable> with the correct wireless interface"
" and <replaceable>wifi0</replaceable> with desired name for the "
"configuration file. Please note that "
"<filename>wpa_supplicant-*.conf</filename> and "
"<filename>ifconfig.*</filename> configuration files need to have identical "
"names, ie both contain <replaceable>wifi0</replaceable> in their name."
msgstr ""

#. type: Content of: <sect1><sect2><sect3><screen>
#: blfs-en/blfs-git/networking/netprogs/wpa_supplicant.xml:474
#, no-wrap, xml-text
msgid ""
"<userinput>systemctl start "
"wpa_supplicant@<replaceable>wlan0</replaceable></userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/blfs-git/networking/netprogs/wpa_supplicant.xml:477
#, xml-text
msgid ""
"To connect to the wireless access point at boot, simply enable the "
"appropriate <command>wpa_supplicant</command> service by running the "
"following command as the <systemitem class=\"username\">root</systemitem> "
"user:"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><screen>
#: blfs-en/blfs-git/networking/netprogs/wpa_supplicant.xml:484
#, no-wrap, xml-text
msgid ""
"<userinput>systemctl enable "
"wpa_supplicant@<replaceable>wlan0</replaceable></userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/blfs-git/networking/netprogs/wpa_supplicant.xml:487
#, xml-text
msgid ""
"Depending on your setup, you can replace the "
"<filename>wpa_supplicant@.service</filename> with any other listed above."
msgstr ""

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/blfs-git/networking/netprogs/wpa_supplicant.xml:493
#, xml-text
msgid ""
"To assign a network address to your wireless interface, consult the <ulink "
"url=\"&lfs-root;/chapter09/network.html\">General Network "
"Configuration</ulink> page in LFS."
msgstr ""

