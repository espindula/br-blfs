#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/networking/netprogs/ncftp.xml:91
#, xml-text
msgid "Installation of NcFTP"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netprogs/ncftp.xml:116
#, xml-text
msgid ""
"To install <application>NcFTP</application>, run the following commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/networking/netprogs/ncftp.xml:119
#, no-wrap, xml-text
msgid ""
"<userinput>CC=/usr/bin/gcc \\\n"
"./configure --prefix=/usr --sysconfdir=/etc &amp;&amp;\n"
"make -C libncftp shared &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netprogs/ncftp.xml:125
#, xml-text
msgid "This package does not come with a test suite."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netprogs/ncftp.xml:129
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/networking/netprogs/ncftp.xml:132
#, no-wrap, xml-text
msgid ""
"<userinput>make -C libncftp soinstall &amp;&amp;\n"
"make install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/networking/netprogs/ncftp.xml:157
#, xml-text
msgid "Command Explanations"
msgstr ""

#. The build procedure is broken if <command>
#. gcc</command>
#.       is not used.
#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netprogs/ncftp.xml:160
#, xml-text
msgid ""
"<envar>CC=/usr/bin/gcc</envar>. This environment variable ensures that "
"<command>gcc</command> is used if <xref linkend=\"llvm\"/> is installed."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netprogs/ncftp.xml:167
#, xml-text
msgid ""
"<command>make -C ... &amp;&amp; make ...</command>: These commands make and "
"install the dynamic library <filename "
"class=\"libraryfile\">libncftp</filename> which is then used to link against"
" when compiling the main program."
msgstr ""

