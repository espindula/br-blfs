#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/networking/netprogs/wget.xml:95
#, xml-text
msgid "Installation of Wget"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netprogs/wget.xml:98
#, xml-text
msgid ""
"Install <application>Wget</application> by running the following commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/networking/netprogs/wget.xml:101
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr      \\\n"
"            --sysconfdir=/etc  \\\n"
"            --with-ssl=openssl &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netprogs/wget.xml:107
#, xml-text
msgid "To test the results, issue: <command>make check</command>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netprogs/wget.xml:120
#, xml-text
msgid "Some tests may fail when Valgrind tests are enabled."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netprogs/wget.xml:124
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/networking/netprogs/wget.xml:127
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/networking/netprogs/wget.xml:131
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netprogs/wget.xml:134
#, xml-text
msgid ""
"<parameter>--sysconfdir=/etc</parameter>: This relocates the configuration "
"file from <filename class=\"directory\">/usr/etc</filename> to <filename "
"class=\"directory\">/etc</filename>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netprogs/wget.xml:140
#, xml-text
msgid ""
"<parameter>--with-ssl=openssl</parameter>: This allows the program to use "
"openssl instead of <xref linkend=\"gnutls\"/>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netprogs/wget.xml:145
#, xml-text
msgid ""
"<option>--enable-libproxy</option>: This switch allows wget to use libproxy "
"for proxy configuration. Use it if you have the <xref linkend=\"libproxy\" "
"role=\"nodep\"/> package installed and wish to use a proxy server."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netprogs/wget.xml:152
#, xml-text
msgid ""
"<option>--enable-valgrind-tests</option>: This allows the tests to be run "
"under valgrind."
msgstr ""

