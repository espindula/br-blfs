#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/networking/netutils/bind-utils.xml:94
#, xml-text
msgid "Installation of BIND Utilities"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netutils/bind-utils.xml:97
#, xml-text
msgid ""
"Install <application>BIND Utilities</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/networking/netutils/bind-utils.xml:100
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr &amp;&amp;\n"
"make -C lib/isc      &amp;&amp;\n"
"make -C lib/dns      &amp;&amp;\n"
"make -C lib/ns       &amp;&amp;\n"
"make -C lib/isccfg   &amp;&amp;\n"
"make -C lib/isccc    &amp;&amp;\n"
"make -C bin/dig      &amp;&amp;\n"
"make -C bin/nsupdate &amp;&amp;\n"
"make -C bin/rndc     &amp;&amp;\n"
"make -C doc</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netutils/bind-utils.xml:112
#, xml-text
msgid "This portion of the package does not come with a test suite."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netutils/bind-utils.xml:115
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/networking/netutils/bind-utils.xml:117
#, no-wrap, xml-text
msgid ""
"<userinput>make -C lib/isc      install &amp;&amp;\n"
"make -C lib/dns      install &amp;&amp;\n"
"make -C lib/ns       install &amp;&amp;\n"
"make -C lib/isccfg   install &amp;&amp;\n"
"make -C lib/isccc    install &amp;&amp;\n"
"make -C bin/dig      install &amp;&amp;\n"
"make -C bin/nsupdate install &amp;&amp;\n"
"make -C bin/rndc     install &amp;&amp;\n"
"cp -v doc/man/{dig.1,host.1,nslookup.1,nsupdate.1} /usr/share/man/man1 &amp;&amp;\n"
"cp -v doc/man/rndc.8 /usr/share/man/man8</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/networking/netutils/bind-utils.xml:131
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netutils/bind-utils.xml:134
#, xml-text
msgid ""
"<option>--disable-doh</option>: Use this option if you have not installed "
"<xref linkend=\"nghttp2\" role=\"nodep\"/> and you don't need DNS over HTTPS"
" support."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netutils/bind-utils.xml:140
#, xml-text
msgid ""
"<command>make -C lib/...</command>: These commands build the libraries that "
"are needed for the client programs."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netutils/bind-utils.xml:145
#, xml-text
msgid ""
"<command>make -C bin/...</command>: This command builds the client programs."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netutils/bind-utils.xml:150
#, xml-text
msgid ""
"<command>make -C doc</command>: This command builds the manual pages if the "
"optional Python module <xref linkend=\"sphinx\"/> is installed."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netutils/bind-utils.xml:156
#, xml-text
msgid ""
"Use <command>cp -v doc/man/... /usr/share/man/man...</command> to install "
"the manual pages if they have been built."
msgstr ""

