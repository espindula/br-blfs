#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netutils/networkmanager.xml:164
#, xml-text
msgid ""
"Fix the python scripts so that they use <application>Python 3</application>:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/networking/netutils/networkmanager.xml:168
#, no-wrap, xml-text
msgid ""
"<userinput>grep -rl '^#!.*python$' | xargs sed -i "
"'1s/python/&amp;3/'</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netutils/networkmanager.xml:171
#, xml-text
msgid ""
"Install <application>NetworkManager</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/networking/netutils/networkmanager.xml:175
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup ..                    \\\n"
"      --prefix=/usr               \\\n"
"      --buildtype=release         \\\n"
"      -D libaudit=no              \\\n"
"      -D nmtui=true               \\\n"
"      -D ovs=false                \\\n"
"      -D ppp=false                \\\n"
"      -D nbft=false               \\\n"
"      -D selinux=false            \\\n"
"      -D session_tracking=elogind \\\n"
"      -D modem_manager=false      \\\n"
"      -D systemdsystemunitdir=no  \\\n"
"      -D systemd_journal=false    \\\n"
"      -D nm_cloud_setup=false     \\\n"
"      -D qt=false                 &amp;&amp;\n"
"ninja</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/networking/netutils/networkmanager.xml:195
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup ..                    \\\n"
"      --prefix=/usr               \\\n"
"      --buildtype=release         \\\n"
"      -D libaudit=no              \\\n"
"      -D nmtui=true               \\\n"
"      -D ovs=false                \\\n"
"      -D ppp=false                \\\n"
"      -D nbft=false               \\\n"
"      -D selinux=false            \\\n"
"      -D qt=false                 \\\n"
"      -D session_tracking=systemd \\\n"
"      -D nm_cloud_setup=false     \\\n"
"      -D modem_manager=false      &amp;&amp;\n"
"ninja</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netutils/networkmanager.xml:214
#, xml-text
msgid ""
"An already active graphical session with a bus address is necessary to run "
"the tests. To test the results, issue <command>ninja test</command>."
msgstr ""

#.   The following failed for me on a sysV system with static ip over
#. wlp0s20f3
#.             bdubbs 2025-11-19 NetworkManager-1.54.2.
#.             16/60 platform/test-address-linux
#.             17/60 platform/test-cleanup-linux
#.             18/60 platform/test-link-linux
#.             19/60 platform/test-route-linux
#.             20/60 platform/test-tc-linux
#.             21/60 test-l3cfg
#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netutils/networkmanager.xml:220
#, xml-text
msgid "A few tests may fail, depending on enabled kernel options."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netutils/networkmanager.xml:234
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/networking/netutils/networkmanager.xml:237
#, no-wrap, xml-text
msgid ""
"<userinput>ninja install &amp;&amp;\n"
"rm -rf /usr/share/doc/NetworkManager-&NetworkManager-version; &amp;&amp;\n"
"mv -v /usr/share/doc/NetworkManager{,-&NetworkManager-version;}</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netutils/networkmanager.xml:242
#, xml-text
msgid ""
"If you have not passed the <option>-D docs=true</option> option to "
"<command>meson</command>, you can install the pregenerated manual pages with"
" (as the &root; user):"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/networking/netutils/networkmanager.xml:247
#, no-wrap, xml-text
msgid ""
"<userinput>for file in $(echo ../man/*.[1578]); do\n"
"    section=${file##*.} &amp;&amp;\n"
"    install -vdm 755 /usr/share/man/man$section\n"
"    install -vm 644 $file /usr/share/man/man$section/\n"
"done</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netutils/networkmanager.xml:254
#, xml-text
msgid ""
"If you have not used <option>-D docs=true</option>, the pregenerated HTML "
"documentation can also be installed with (as the &root; user):"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/networking/netutils/networkmanager.xml:260
#, no-wrap, xml-text
msgid ""
"<userinput>cp -Rv ../docs/{api,libnm} "
"/usr/share/doc/NetworkManager-&NetworkManager-version;</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/networking/netutils/networkmanager.xml:265
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netutils/networkmanager.xml:272
#, xml-text
msgid ""
"<option>-D docs=true</option>: Use this switch to enable building man pages "
"and documentation if <xref linkend=\"gtk-doc\"/> is installed."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netutils/networkmanager.xml:277
#, xml-text
msgid ""
"<parameter>-D nmtui=true</parameter>: This switch enables building "
"<command>nmtui</command>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netutils/networkmanager.xml:282
#, xml-text
msgid ""
"<parameter>-D systemdsystemunitdir=no</parameter> and <parameter>-D "
"systemd_journal=false</parameter>: systemd is not used for sysv init "
"systems, so prevent installing units and using the systemd journal."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netutils/networkmanager.xml:289
#, xml-text
msgid ""
"<parameter>-D ovs=false</parameter>: This switch disable the Open vSwitch "
"integration because it needs <xref linkend='jansson'/>.  Remove it if you "
"have <xref linkend='jansson'/> installed on your system."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netutils/networkmanager.xml:296
#, xml-text
msgid ""
"<parameter>-D modem_manager=false</parameter>: This switch is required if "
"<application>ModemManager</application> is not installed. Omit this switch "
"if you have built <application>ModemManager</application> and "
"<application>mobile-broadband-provider-info</application>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netutils/networkmanager.xml:303
#, xml-text
msgid ""
"<parameter>-D nbft=false</parameter>: This switch is required if <xref "
"linkend=\"libnvme\"/> is not installed, and disabled NBFT support in the "
"initrd generator. Note that BLFS does not use the initrd generator provided "
"from NetworkManager by default."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netutils/networkmanager.xml:310
#, xml-text
msgid ""
"<parameter>-D session_tracking=elogind</parameter>: This switch is used to "
"set <command>elogind</command> as the default program for session tracking."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netutils/networkmanager.xml:316
#, xml-text
msgid ""
"<parameter>-D session_tracking=systemd</parameter>: This switch is used to "
"set <command>systemd-logind</command> as the default program for session "
"tracking."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netutils/networkmanager.xml:322
#, xml-text
msgid ""
"<parameter>-D ppp=false</parameter>: This switch disables "
"<application>PPP</application> support in "
"<application>NetworkManager</application> since the programs necessary for "
"it are not installed. Remove this switch if you need PPP support and have "
"<application>PPP</application> installed."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netutils/networkmanager.xml:330
#, xml-text
msgid ""
"<parameter>-D libaudit=no</parameter> and <parameter>-D "
"selinux=false</parameter>: This switch disables support for libaudit and "
"SELinux since they are not used in BLFS."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netutils/networkmanager.xml:336
#, xml-text
msgid ""
"<parameter>-D qt=false</parameter>: This switch disables the <application>Qt"
" 5</application> examples."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netutils/networkmanager.xml:341
#, xml-text
msgid ""
"<parameter>-D nm_cloud_setup=false</parameter>: Use this switch if you have "
"not installed <xref linkend='jansson'/>. This disables nm-cloud-setup which "
"is used to automatically configure the network in a public cloud environment"
" within a VM."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netutils/networkmanager.xml:348
#, xml-text
msgid ""
"<option>-D crypto=gnutls</option>: Use this switch if you have GnuTLS "
"installed and want to use it for certificate and key operations in "
"NetworkManager, instead of using NSS (the default)."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netutils/networkmanager.xml:354
#, xml-text
msgid ""
"<option>-D crypto=null</option>: Use this switch if neither NSS nor GnuTLS "
"is installed but you want to build NetworkManager anyway.  This switch will "
"make NetworkManager lack some features (for example 802.1X)."
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/networking/netutils/networkmanager.xml:375
#, xml-text
msgid "Configuring NetworkManager"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><title>
#: blfs-en/blfs-git/networking/netutils/networkmanager.xml:378
#, xml-text
msgid "Config Files"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/blfs-git/networking/netutils/networkmanager.xml:380
#, xml-text
msgid "<filename>/etc/NetworkManager/NetworkManager.conf</filename>"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><indexterm><primary>
#: blfs-en/blfs-git/networking/netutils/networkmanager.xml:386
#, xml-text
msgid "/etc/NetworkManager/NetworkManager.conf"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><title>
#: blfs-en/blfs-git/networking/netutils/networkmanager.xml:391
#, xml-text
msgid "Configuration Information"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/blfs-git/networking/netutils/networkmanager.xml:394
#, xml-text
msgid ""
"For <application>NetworkManager</application> to work, at least a minimal "
"configuration file must be present. Such a file is not installed with "
"<command>make install</command>. Issue the following command as the "
"<systemitem class=\"username\">root</systemitem> user to create a minimal "
"<filename>NetworkManager.conf</filename> file:"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><screen>
#: blfs-en/blfs-git/networking/netutils/networkmanager.xml:401
#, no-wrap, xml-text
msgid ""
"<userinput>cat &gt;&gt; /etc/NetworkManager/NetworkManager.conf &lt;&lt; \"EOF\"\n"
"<literal>[main]\n"
"plugins=keyfile</literal>\n"
"EOF</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/blfs-git/networking/netutils/networkmanager.xml:407
#, xml-text
msgid ""
"This file should not be modified directly by users of the system.  Instead, "
"system specific changes should be made using configuration files in the "
"<filename class=\"directory\">/etc/NetworkManager/conf.d</filename> "
"directory."
msgstr ""

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/blfs-git/networking/netutils/networkmanager.xml:415
#, xml-text
msgid ""
"To allow polkit to manage authorizations, add the following configuration "
"file:"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><screen>
#: blfs-en/blfs-git/networking/netutils/networkmanager.xml:419
#, no-wrap, xml-text
msgid ""
"<userinput>cat &gt; /etc/NetworkManager/conf.d/polkit.conf &lt;&lt; \"EOF\"\n"
"<literal>[main]\n"
"auth-polkit=true</literal>\n"
"EOF</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/blfs-git/networking/netutils/networkmanager.xml:425
#, xml-text
msgid ""
"To use something other than the built-in dhcp client (recommended if using "
"only <command>nmcli</command>), use the following configuration (valid "
"values include either dhcpcd or internal):"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><screen>
#: blfs-en/blfs-git/networking/netutils/networkmanager.xml:430
#, no-wrap, xml-text
msgid ""
"<userinput>cat &gt; /etc/NetworkManager/conf.d/dhcp.conf &lt;&lt; \"EOF\"\n"
"<literal>[main]\n"
"dhcp=</literal><replaceable>dhcpcd</replaceable>\n"
"EOF</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/blfs-git/networking/netutils/networkmanager.xml:436
#, xml-text
msgid ""
"To prevent <application>NetworkManager</application> from updating the "
"<filename>/etc/resolv.conf</filename> file, add the following configuration "
"file:"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><screen>
#: blfs-en/blfs-git/networking/netutils/networkmanager.xml:441
#, no-wrap, xml-text
msgid ""
"<userinput>cat &gt; /etc/NetworkManager/conf.d/no-dns-update.conf &lt;&lt; \"EOF\"\n"
"<literal>[main]\n"
"dns=none</literal>\n"
"EOF</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/blfs-git/networking/netutils/networkmanager.xml:447
#, xml-text
msgid ""
"For additional configuration options, see <command>man 5 "
"NetworkManager.conf</command>."
msgstr ""

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/blfs-git/networking/netutils/networkmanager.xml:452
#, xml-text
msgid ""
"To allow regular users to configure network connections, you should add them"
" to the <systemitem class=\"groupname\">netdev</systemitem> group, and "
"create a <application>polkit</application> rule that grants access. Run the "
"following commands as the <systemitem class=\"username\">root</systemitem> "
"user:"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><screen>
#: blfs-en/blfs-git/networking/netutils/networkmanager.xml:460
#, no-wrap, xml-text
msgid ""
"<userinput>groupadd -fg 86 netdev &amp;&amp;\n"
"/usr/sbin/usermod -a -G netdev <replaceable>&lt;username&gt;</replaceable>\n"
"\n"
"cat &gt; /usr/share/polkit-1/rules.d/org.freedesktop.NetworkManager.rules &lt;&lt; \"EOF\"\n"
"<literal>polkit.addRule(function(action, subject) {\n"
"    if (action.id.indexOf(\"org.freedesktop.NetworkManager.\") == 0 &amp;&amp; subject.isInGroup(\"netdev\")) {\n"
"        return polkit.Result.YES;\n"
"    }\n"
"});</literal>\n"
"EOF</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><title>
#: blfs-en/blfs-git/networking/netutils/networkmanager.xml:474
#, xml-text
msgid ""
"<phrase revision=\"sysv\">Boot Script</phrase> <phrase "
"revision=\"systemd\">Systemd Unit</phrase>"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/blfs-git/networking/netutils/networkmanager.xml:478
#, xml-text
msgid ""
"To automatically start the <command>NetworkManager</command> daemon when the"
" system is rebooted, install the "
"<filename>/etc/rc.d/init.d/networkmanager</filename>bootscript from the "
"<xref linkend=\"bootscripts\"/> package."
msgstr ""

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/blfs-git/networking/netutils/networkmanager.xml:485
#, xml-text
msgid ""
"To start the <command>NetworkManager</command> daemon at boot, enable the "
"previously installed systemd unit by running the following command as the "
"<systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><note><para>
#: blfs-en/blfs-git/networking/netutils/networkmanager.xml:492
#, xml-text
msgid ""
"If using <application>Network Manager</application> to manage an interface, "
"any previous configuration for that interface should be removed, and the "
"interface brought down prior to starting <application>Network "
"Manager</application>."
msgstr ""

#. type: Content of: <sect1><sect2><sect3><note><para>
#: blfs-en/blfs-git/networking/netutils/networkmanager.xml:499
#, xml-text
msgid ""
"The easiest way to do this is to remove S20network from "
"<filename>/etc/rc.d/rc3.d/</filename> and "
"<filename>/etc/rc.d/rc5.d/</filename>."
msgstr ""

#. type: Content of: <sect1><sect2><sect3><note><para>
#: blfs-en/blfs-git/networking/netutils/networkmanager.xml:504
#, xml-text
msgid ""
"Also, if using <xref linkend=\"dhcpcd\"/>, be careful about timing issues if"
" setting up network applications such as ntpd, nfs, or sshd. It takes "
"several seconds for dhcpcd to initialize the network interface and if these "
"applications start before the network interface is completely initialized, "
"these applications may have to be started manually."
msgstr ""

#. type: Content of: <sect1><sect2><sect3><screen>
#: blfs-en/blfs-git/networking/netutils/networkmanager.xml:517
#, no-wrap, xml-text
msgid "<userinput>make install-networkmanager</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><screen>
#: blfs-en/blfs-git/networking/netutils/networkmanager.xml:519
#, no-wrap, xml-text
msgid "<userinput>systemctl enable NetworkManager</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/blfs-git/networking/netutils/networkmanager.xml:522
#, xml-text
msgid ""
"Starting in version 1.11.2 of <application>NetworkManager</application>, a "
"systemd unit named <filename>NetworkManager-wait-online.service</filename> "
"is enabled, which is used to prevent services that require network "
"connectivity from starting until <application>NetworkManager</application> "
"establishes a connection. To disable this behavior, run the following "
"command as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><screen>
#: blfs-en/blfs-git/networking/netutils/networkmanager.xml:530
#, no-wrap, xml-text
msgid "<userinput>systemctl disable NetworkManager-wait-online</userinput>"
msgstr ""

