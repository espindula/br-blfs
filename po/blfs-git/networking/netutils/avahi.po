#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/networking/netutils/avahi.xml:105
#, xml-text
msgid "Installation of Avahi"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netutils/avahi.xml:108
#, xml-text
msgid ""
"There should be a dedicated user and group to take control of the "
"<command>avahi-daemon</command> daemon after it is started. Issue the "
"following commands as the <systemitem class=\"username\">root</systemitem> "
"user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/networking/netutils/avahi.xml:114
#, no-wrap, xml-text
msgid ""
"<userinput>groupadd -fg 84 avahi &amp;&amp;\n"
"useradd -c \"Avahi Daemon Owner\" -d /run/avahi-daemon -u 84 \\\n"
"        -g avahi -s /bin/false avahi</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netutils/avahi.xml:119
#, xml-text
msgid ""
"There should also be a dedicated privileged access group for "
"<application>Avahi</application> clients. Issue the following command as the"
" <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/networking/netutils/avahi.xml:124
#, no-wrap, xml-text
msgid "<userinput>groupadd -fg 86 netdev</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netutils/avahi.xml:127
#, xml-text
msgid ""
"Fix a regression that results in a race condition when IPv6 is in use and "
"multiple network adapters are present on the system:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/networking/netutils/avahi.xml:131
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"pre\">patch -Np1 -i ../avahi-&avahi-"
"version;-ipv6_race_condition_fix-1.patch</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netutils/avahi.xml:134
#, xml-text
msgid "Fix a security vulnerability in <command>avahi-daemon</command>:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/networking/netutils/avahi.xml:137
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"pre\">sed -i '426a if (events &amp; AVAHI_WATCH_HUP) { \\\n"
"client_free(c); \\\n"
"return; \\\n"
"}' avahi-daemon/simple-protocol.c</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netutils/avahi.xml:143
#, xml-text
msgid ""
"Install <application>Avahi</application> by running the following commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/networking/netutils/avahi.xml:147
#, no-wrap, xml-text
msgid ""
"<userinput>./configure \\\n"
"    --prefix=/usr                  \\\n"
"    --sysconfdir=/etc              \\\n"
"    --localstatedir=/var           \\\n"
"    --disable-static               \\\n"
"    --disable-libevent             \\\n"
"    --disable-mono                 \\\n"
"    --disable-monodoc              \\\n"
"    --disable-python               \\\n"
"    --disable-qt3                  \\\n"
"    --disable-qt4                  \\\n"
"    --disable-qt5                  \\\n"
"    --enable-core-docs             \\\n"
"    --with-distro=none             \\\n"
"    --with-systemdsystemunitdir=no \\\n"
"    --with-dbus-system-address='unix:path=/run/dbus/system_bus_socket' &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/networking/netutils/avahi.xml:165
#, no-wrap, xml-text
msgid ""
"<userinput>./configure \\\n"
"    --prefix=/usr        \\\n"
"    --sysconfdir=/etc    \\\n"
"    --localstatedir=/var \\\n"
"    --disable-static     \\\n"
"    --disable-libevent   \\\n"
"    --disable-mono       \\\n"
"    --disable-monodoc    \\\n"
"    --disable-python     \\\n"
"    --disable-qt3        \\\n"
"    --disable-qt4        \\\n"
"    --disable-qt5        \\\n"
"    --enable-core-docs   \\\n"
"    --with-distro=none   \\\n"
"    --with-dbus-system-address='unix:path=/run/dbus/system_bus_socket' &amp;&amp;\n"
"make</userinput>"
msgstr ""

