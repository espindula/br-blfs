#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/blfs-git/networking/netutils/nmap.xml:88
#, xml-text
msgid "Recommended"
msgstr ""

#. type: Content of: <sect1><sect2><note><para>
#: blfs-en/blfs-git/networking/netutils/nmap.xml:91
#, xml-text
msgid ""
"If the <application>PyGObject3</application> module is not installed, you'd "
"have to skip the command making the build system use the LFS "
"<application>Setuptools</application> installation and then an Internet "
"connection would be needed.  The other packages are recommended because if "
"they're not installed, the build process will compile and link against its "
"own (often older)  version."
msgstr ""

#.   libdnet is not recommended, see:
#.       http://nmap.org/svn/libdnet-stripped/NMAP_MODIFICATIONS
#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netutils/nmap.xml:102
#, xml-text
msgid ""
"<xref linkend=\"liblinear\"/>, <xref linkend=\"libpcap\"/>, <xref "
"linkend=\"libssh2\"/>, <xref linkend=\"lua\"/>, and <xref "
"linkend=\"pygobject3\"/>"
msgstr ""

#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/blfs-git/networking/netutils/nmap.xml:112
#, xml-text
msgid "Optional"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netutils/nmap.xml:114
#, xml-text
msgid ""
"<ulink url=\"http://code.google.com/p/libdnet/\">libdnet</ulink> and <ulink "
"url=\"https://pypi.org/project/setuptools-gettext/\">setuptools-"
"gettext</ulink> (currently <ulink "
"url='https://github.com/pypa/build/issues/729'>useless</ulink>)"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/networking/netutils/nmap.xml:122
#, xml-text
msgid "Installation of Nmap"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netutils/nmap.xml:125
#, xml-text
msgid ""
"Make the build system use the <application>Setuptools</application> Python "
"module from LFS instead of downloading a copy from the Internet, and install"
" the Python wheels already created when running the <command>make</command> "
"instead of rebuilding them again on <command>make install</command>:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/networking/netutils/nmap.xml:132
#, no-wrap, xml-text
msgid ""
"<userinput>sed -ri Makefile.in \\\n"
"    -e 's#-m build#&amp; --no-isolation#'  \\\n"
"    -e '/pip install/s#(ZENMAP|NDIFF)DIR\\)/#&amp;dist/*.whl#'</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netutils/nmap.xml:137
#, xml-text
msgid "Remove a useless dependency on setuptools-gettext:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/networking/netutils/nmap.xml:140
#, no-wrap, xml-text
msgid ""
"<userinput>sed 's/, \"setuptools-gettext\"//' -i "
"zenmap/pyproject.toml</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netutils/nmap.xml:143
#, xml-text
msgid ""
"Install <application>Nmap</application> by running the following commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/networking/netutils/nmap.xml:147
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netutils/nmap.xml:151
#, xml-text
msgid "If you wish to run the test suite, run the following command:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/networking/netutils/nmap.xml:154
#, no-wrap, xml-text
msgid ""
"<userinput>sed -e '/import imp/d'                \\\n"
"    -e 's/^ndiff = .*$/import ndiff/' \\\n"
"    -i ndiff/ndifftest.py</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netutils/nmap.xml:159
#, xml-text
msgid ""
"Tests need a graphical session and to be run as the &root; user.  To test "
"the results, issue:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/networking/netutils/nmap.xml:163
#, no-wrap, xml-text
msgid "<userinput>make check</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netutils/nmap.xml:166
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/networking/netutils/nmap.xml:169
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr ""

