#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/networking/netutils/network-manager-applet.xml:108
#, xml-text
msgid "Installation of NetworkManager Applet"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netutils/network-manager-applet.xml:111
#, xml-text
msgid ""
"Install <application>NetworkManager Applet</application> by running the "
"following commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/networking/netutils/network-manager-applet.xml:115
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup ..            \\\n"
"      --prefix=/usr       \\\n"
"      --buildtype=release \\\n"
"      -D appindicator=no  \\\n"
"      -D selinux=false    \\\n"
"      -D team=false       &amp;&amp;\n"
"ninja</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netutils/network-manager-applet.xml:127
#, xml-text
msgid "To test the results, issue: <command>ninja test</command>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netutils/network-manager-applet.xml:131
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/networking/netutils/network-manager-applet.xml:134
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/networking/netutils/network-manager-applet.xml:139
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netutils/network-manager-applet.xml:142
#, xml-text
msgid ""
"<parameter>-D appindicator=no</parameter>: This switch disables AppIndicator"
" support in network-manager-applet because it requires libindicator, which "
"is not in BLFS. The build will fail without this option."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netutils/network-manager-applet.xml:149
#, xml-text
msgid ""
"<parameter>-D selinux=false</parameter>: This switch forcibly disables "
"<application>SELinux</application> support since it is not currently in BLFS"
" and the build will fail without it."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netutils/network-manager-applet.xml:155
#, xml-text
msgid ""
"<parameter>-D team=false</parameter>: This switch disables the team "
"configuration editor since it requires <xref linkend=\"jansson\"/>. If you "
"have Jansson installed, remove this option or set it to "
"<literal>true</literal>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netutils/network-manager-applet.xml:175
#, xml-text
msgid ""
"<option>-D wwan=false</option>: This switch disables WWAN support.  Use this"
" if you do not have <xref linkend=\"ModemManager\"/> installed."
msgstr ""

