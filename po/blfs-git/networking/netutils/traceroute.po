#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/networking/netutils/traceroute.xml:83
#, xml-text
msgid "Installation of Traceroute"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netutils/traceroute.xml:86
#, xml-text
msgid ""
"Install <application>Traceroute</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/networking/netutils/traceroute.xml:90
#, no-wrap, xml-text
msgid "<userinput>make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netutils/traceroute.xml:93
#, xml-text
msgid "This package does not come with a test suite."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netutils/traceroute.xml:97
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/networking/netutils/traceroute.xml:100
#, no-wrap, xml-text
msgid ""
"<userinput>make prefix=/usr install                                 &amp;&amp;\n"
"ln -sv -f traceroute /usr/bin/traceroute6                &amp;&amp;\n"
"ln -sv -f traceroute.8 /usr/share/man/man8/traceroute6.8 &amp;&amp;\n"
"rm -fv /usr/share/man/man1/traceroute.1</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netutils/traceroute.xml:106
#, xml-text
msgid ""
"The traceroute.1 file that was installed in LFS by inetutils is no longer "
"relevant.  This package overwrites that version of traceroute and installs "
"the man page in man chapter 8."
msgstr ""

