msgstr ""

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/blfs-git/networking/connect/advanced-network.xml:21
#, xml-text
msgid ""
"Enable the following options in the kernel configuration and recompile the "
"kernel if necessary:"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><screen>
#: blfs-en/blfs-git/networking/connect/advanced-network.xml:25
#, no-wrap, xml-text
msgid ""
"<literal>Networking support: Y\n"
"  Networking options:\n"
"    802.1d Ethernet Bridging: M or Y</literal>"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><indexterm><primary>
#: blfs-en/blfs-git/networking/connect/advanced-network.xml:30
#, xml-text
msgid "Advanced Network Bridge"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><title>
#: blfs-en/blfs-git/networking/connect/advanced-network.xml:36
#, xml-text
msgid "Setting up a Network Bridge"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/blfs-git/networking/connect/advanced-network.xml:39
#, xml-text
msgid ""
"In this section we are going to discuss how to set up a network bridge using"
" <command>systemd-networkd</command>. In the examples below, "
"<replaceable>eth0</replaceable> represents the external interface that is "
"being bridged, while <replaceable>br0</replaceable> represents the bridge "
"interface."
msgstr ""

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/blfs-git/networking/connect/advanced-network.xml:47
#, xml-text
msgid ""
"To create a bridge interface, create the following configuration file by "
"running the following command as the <systemitem "
"class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><screen>
#: blfs-en/blfs-git/networking/connect/advanced-network.xml:52
#, no-wrap, xml-text
msgid ""
"<userinput>cat &gt; /etc/systemd/network/50-br0.netdev &lt;&lt; EOF\n"
"<literal>[NetDev]\n"
"Name=<replaceable>br0</replaceable>\n"
"Kind=bridge</literal>\n"
"EOF</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/blfs-git/networking/connect/advanced-network.xml:59
#, xml-text
msgid ""
"To assign a network interface to a bridge, create the following "
"configuration file by running the following command as the <systemitem "
"class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><screen>
#: blfs-en/blfs-git/networking/connect/advanced-network.xml:64
#, no-wrap, xml-text
msgid ""
"<userinput>cat &gt; /etc/systemd/network/51-eth0.network &lt;&lt; EOF\n"
"<literal>[Match]\n"
"Name=<replaceable>eth0</replaceable>\n"
"\n"
"[Network]\n"
"Bridge=<replaceable>br0</replaceable></literal>\n"
"EOF</userinput>"
msgstr ""

#. or <xref linkend="wicd"/>
#. i,
#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/blfs-git/networking/connect/advanced-network.xml:73
#, xml-text
msgid ""
"Repeat the process for any other interfaces that need to be bridged.  Note "
"that it is important that nothing assigns any addresses to the bridged "
"interfaces. If you are using <xref linkend=\"NetworkManager\"/>, make sure "
"you configure them to ignore the bridged interfaces, as well as the bridge "
"interface itself."
msgstr ""

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/blfs-git/networking/connect/advanced-network.xml:81
#, xml-text
msgid ""
"If you are on a network which uses DHCP for assigning ip addresses, create "
"the following configuration file by running the following command as the "
"<systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><screen>
#: blfs-en/blfs-git/networking/connect/advanced-network.xml:86
#, no-wrap, xml-text
msgid ""
"<userinput>cat &gt; /etc/systemd/network/60-br0.network &lt;&lt; EOF\n"
"<literal>[Match]\n"
"Name=<replaceable>br0</replaceable>\n"
"\n"
"[Network]\n"
"DHCP=yes</literal>\n"
"EOF</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/blfs-git/networking/connect/advanced-network.xml:95
#, xml-text
msgid ""
"Alternatively, if using a static ip setup, create the following "
"configuration file by running the following command as the <systemitem "
"class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><screen>
#: blfs-en/blfs-git/networking/connect/advanced-network.xml:100
#, no-wrap, xml-text
msgid ""
"<userinput>cat &gt; /etc/systemd/network/60-br0.network &lt;&lt; EOF\n"
"<literal>[Match]\n"
"Name=<replaceable>br0</replaceable>\n"
"\n"
"[Network]\n"
"Address=192.168.0.2/24\n"
"Gateway=192.168.0.1\n"
"DNS=192.168.0.1</literal>\n"
"EOF</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/blfs-git/networking/connect/advanced-network.xml:111
#, xml-text
msgid ""
"To bring up the bridge interface, simply restart the <command>systemd-"
"networkd</command> daemon by running the following command as the "
"<systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><screen>
#: blfs-en/blfs-git/networking/connect/advanced-network.xml:116
#, no-wrap, xml-text
msgid "<userinput>systemctl restart systemd-networkd</userinput>"
msgstr ""
