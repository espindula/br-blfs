msgstr ""

#. type: Content of:
#. <sect1><sect2><variablelist><varlistentry><listitem><para>
#: blfs-en/blfs-git/networking/connect/dhcpcd.xml:452
#, xml-text
msgid "is an implementation of the DHCP client specified in RFC2131"
msgstr ""

#. type: Content of: <sect1><sect2><variablelist><varlistentry><term>
#: blfs-en/blfs-git/networking/connect/dhcpcd.xml:461
#, xml-text
msgid "<filename class=\"libraryfile\">udev.so</filename>"
msgstr ""

#. type: Content of:
