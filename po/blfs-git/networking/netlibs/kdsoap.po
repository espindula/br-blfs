#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/networking/netlibs/kdsoap.xml:81
#, xml-text
msgid "Installation of kdsoap"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netlibs/kdsoap.xml:84
#, xml-text
msgid ""
"Install <application>kdsoap</application> by running the following commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/networking/netlibs/kdsoap.xml:88
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr \\\n"
"      -D CMAKE_BUILD_TYPE=Release  \\\n"
"      -D KDSoap_QT6=ON             \\\n"
"      -D CMAKE_INSTALL_DOCDIR=/usr/share/doc/kdsoap-&kdsoap-version; \\\n"
"      .. &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netlibs/kdsoap.xml:99
#, xml-text
msgid "The package does not come with a test suite."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netlibs/kdsoap.xml:103
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/networking/netlibs/kdsoap.xml:106
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr ""

