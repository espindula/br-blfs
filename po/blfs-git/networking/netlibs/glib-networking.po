#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/networking/netlibs/glib-networking.xml:104
#, xml-text
msgid "Installation of GLib Networking"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netlibs/glib-networking.xml:112
#, xml-text
msgid ""
"Install <application>GLib Networking</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/networking/netlibs/glib-networking.xml:116
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup             \\\n"
"   --prefix=/usr        \\\n"
"   --buildtype=release  \\\n"
"   -D libproxy=disabled \\\n"
"   .. &amp;&amp;\n"
"ninja</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netlibs/glib-networking.xml:127
#, xml-text
msgid "To test the results, issue: <command>ninja test</command>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netlibs/glib-networking.xml:131
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/networking/netlibs/glib-networking.xml:134
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/networking/netlibs/glib-networking.xml:139
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netlibs/glib-networking.xml:145
#, xml-text
msgid ""
"<parameter>-D libproxy=disabled</parameter>: This switch disables libproxy "
"support. If you wish to build with libproxy to allow this package to "
"retrieve proxy settings via it's API, remove this switch."
msgstr ""

