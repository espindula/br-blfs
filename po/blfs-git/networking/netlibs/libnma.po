#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/networking/netlibs/libnma.xml:93
#, xml-text
msgid "Installation of libnma"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netlibs/libnma.xml:96
#, xml-text
msgid ""
"Install <application>libnma</application> by running the following commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/networking/netlibs/libnma.xml:100
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup ..            \\\n"
"      --prefix=/usr       \\\n"
"      --buildtype=release \\\n"
"      -D gtk_doc=false    \\\n"
"      -D libnma_gtk4=true \\\n"
"      -D mobile_broadband_provider_info=false &amp;&amp;\n"
"ninja</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netlibs/libnma.xml:112
#, xml-text
msgid "To test the results, issue: <command>ninja test</command>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netlibs/libnma.xml:116
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/networking/netlibs/libnma.xml:119
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/networking/netlibs/libnma.xml:123
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netlibs/libnma.xml:129
#, xml-text
msgid ""
"<parameter>-D gtk_doc=false</parameter>: This parameter disables generating "
"API documentation using gtk-doc. If you have <xref role=\"nodep\" "
"linkend=\"gtk-doc\"/> installed and wish to generate the API documentation, "
"omit this switch."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netlibs/libnma.xml:136
#, xml-text
msgid ""
"<parameter>-D libnma_gtk4=true</parameter>: This parameter builds the GTK-4 "
"version of libnma. It is needed by <xref linkend=\"gnome-control-center\"/>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netlibs/libnma.xml:142
#, xml-text
msgid ""
"<parameter>-D mobile_broadband_provider_info=false</parameter>: This switch "
"disables WWAN support because mobile-broadband-provider-info is not in BLFS."
" Omit this switch if you have it installed and wish to enable WWAN support."
msgstr ""

