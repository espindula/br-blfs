#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/networking/netlibs/libsoup3.xml:117
#, xml-text
msgid "Installation of libsoup3"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netlibs/libsoup3.xml:120
#, xml-text
msgid ""
"First, fix several security vulnerabilities and a bug that can result in a "
"deadlock:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/networking/netlibs/libsoup3.xml:124
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"pre\">patch -Np1 -i "
"../libsoup-&libsoup3-version;-upstream_fixes-1.patch</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netlibs/libsoup3.xml:127
#, xml-text
msgid "Fix the installation path of API documentation:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/networking/netlibs/libsoup3.xml:130
#, no-wrap, xml-text
msgid ""
"<userinput>sed 's/apiversion/soup_version/' -i "
"docs/reference/meson.build</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netlibs/libsoup3.xml:133
#, xml-text
msgid ""
"Install <application>libsoup3</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/networking/netlibs/libsoup3.xml:137
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr          \\\n"
"            --buildtype=release    \\\n"
"            --wrap-mode=nofallback \\\n"
"            ..                     &amp;&amp;\n"
"ninja</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netlibs/libsoup3.xml:147
#, xml-text
msgid "To test the results, issue: <command>ninja test</command>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netlibs/libsoup3.xml:151
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/networking/netlibs/libsoup3.xml:154
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/networking/netlibs/libsoup3.xml:159
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netlibs/libsoup3.xml:168
#, xml-text
msgid ""
"<option>-D docs=enabled</option>: If <xref linkend='gi-docgen'/> is "
"installed, the API documentation will be built and installed no matter if "
"this option is used or not.  This option causes the <command>meson</command>"
" command to fail if <xref linkend='gi-docgen'/> is not installed."
msgstr ""

