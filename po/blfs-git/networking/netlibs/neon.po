#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/networking/netlibs/neon.xml:86
#, xml-text
msgid "Installation of neon"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netlibs/neon.xml:89
#, xml-text
msgid ""
"Install <application>neon</application> by running the following commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/networking/netlibs/neon.xml:93
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr    \\\n"
"            --with-ssl       \\\n"
"            --enable-shared  \\\n"
"            --disable-static &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netlibs/neon.xml:100
#, xml-text
msgid "To test the results, issue: <command>make check</command>."
msgstr ""

