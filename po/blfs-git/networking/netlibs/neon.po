#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/networking/netlibs/neon.xml:113
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/networking/netlibs/neon.xml:118
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netlibs/neon.xml:121
#, xml-text
msgid ""
"<parameter>--with-ssl</parameter>: This switch enables SSL support using "
"<application>OpenSSL</application>.  <application>GnuTLS</application> can "
"be used instead, by passing <option>--with-ssl=gnutls</option> and "
"<option>--with-ca-bundle=/etc/pki/tls/certs/ca-bundle.crt</option> to the "
"<command>configure</command> script."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netlibs/neon.xml:133
#, xml-text
msgid ""
"<option>--with-libproxy</option>: This switch enables support for using "
"libproxy to retrieve proxy server information. Use this switch if you have "
"<xref linkend=\"libproxy\" role=\"nodep\"/> installed and wish to use it."
msgstr ""

