#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/networking/netlibs/libnl.xml:111
#, xml-text
msgid "Installation of libnl"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netlibs/libnl.xml:121
#, xml-text
msgid ""
"Install <application>libnl</application> by running the following commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/networking/netlibs/libnl.xml:125
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr     \\\n"
"            --sysconfdir=/etc \\\n"
"            --disable-static  &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><note><para>
#: blfs-en/blfs-git/networking/netlibs/libnl.xml:136
#, xml-text
msgid ""
"If the <command>make</command> command was executed with multiple parallel "
"jobs enabled, it might disrupt the terminal mode and cause some "
"<quote>amusing</quote> visual effects.  In the worst case, this issue may "
"cause keyboard inputs not displayed on the screen at all (but you can still "
"run any command if you can type it correctly).  Run the "
"<command>reset</command> command to fix such an issue."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netlibs/libnl.xml:147
#, xml-text
msgid ""
"If you wish to run the tests, check that the following options are enabled "
"in the kernel configuration and recompile the kernel if necessary.  Some of "
"them may not be strictly needed, but they should support a complete test "
"coverage."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netlibs/libnl.xml:157
#, xml-text
msgid "To test the results, issue: <command>make check</command>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netlibs/libnl.xml:161
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/networking/netlibs/libnl.xml:164
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netlibs/libnl.xml:167
#, xml-text
msgid ""
"If you wish to install the API documentation, as the <systemitem "
"class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/networking/netlibs/libnl.xml:171
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir -vp /usr/share/doc/libnl-&libnl-version; &amp;&amp;\n"
"tar -xf ../libnl-doc-&libnl-version;.tar.gz --strip-components=1 --no-same-owner \\\n"
"    -C  /usr/share/doc/libnl-&libnl-version;</userinput>"
msgstr ""

