#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/networking/netlibs/geoclue2.xml:96
#, xml-text
msgid "Installation of GeoClue"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netlibs/geoclue2.xml:99
#, xml-text
msgid ""
"Install <application>GeoClue</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/networking/netlibs/geoclue2.xml:103
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr        \\\n"
"            --buildtype=release  \\\n"
"            -D gtk-doc=false     \\\n"
"            -D nmea-source=false \\\n"
"            ..                   &amp;&amp;\n"
"ninja</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netlibs/geoclue2.xml:114
#, xml-text
msgid "This package does not come with a test suite."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netlibs/geoclue2.xml:118
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/networking/netlibs/geoclue2.xml:121
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/networking/netlibs/geoclue2.xml:126
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netlibs/geoclue2.xml:132
#, xml-text
msgid ""
"<parameter>-D nmea-source=false</parameter>: This switch disables the NMEA "
"source. Remove it if you have installed the <application>Avahi</application>"
" package and your local network has a NMEA server."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netlibs/geoclue2.xml:139
#, xml-text
msgid ""
"<option>-D 3g-source=false</option>: This switch disables the 3G backend. "
"Use it if you have not installed the <application>ModemManager</application>"
" package."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netlibs/geoclue2.xml:145
#, xml-text
msgid ""
"<option>-D modem-gps-source=false</option>: This switch disables the modem "
"GPS backend. Use it if you have not installed the "
"<application>ModemManager</application> package."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netlibs/geoclue2.xml:151
#, xml-text
msgid ""
"<option>-D cdma-source=false</option>: This switch disables the CDMA source "
"backend. Use it if you have not installed the "
"<application>ModemManager</application> package."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netlibs/geoclue2.xml:157
#, xml-text
msgid ""
"<option>-D demo-agent=false</option>: This switch disables the demo. Use it "
"if you have not installed the <application>libnotify</application> package."
msgstr ""

