#: blfs-en/blfs-git/networking/netlibs/geoclue2.xml:170
#, xml-text
msgid "<filename>/etc/geoclue/conf.d/90-lfs-google.conf</filename>"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><indexterm><primary>
#: blfs-en/blfs-git/networking/netlibs/geoclue2.xml:174
#, xml-text
msgid "/etc/geoclue/conf.d/90-lfs-google.conf"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><title>
#: blfs-en/blfs-git/networking/netlibs/geoclue2.xml:178
#, xml-text
msgid "Configuration Information"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/blfs-git/networking/netlibs/geoclue2.xml:181
#, xml-text
msgid ""
"In March of 2024, Mozilla announced the shutdown of the Mozilla Location "
"Service. Geoclue uses this service for determining a user's location when "
"requested by other applications. The only supported alternative by upstream "
"is to use Google's Geolocation Service."
msgstr ""

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/blfs-git/networking/netlibs/geoclue2.xml:188
#, xml-text
msgid ""
"To use Google's Geolocation Service, an API key must be used, and a "
"configuration file must be created. <emphasis role=\"bold\">This API key is "
"only intended for use with LFS. Please do not use this API key if you are "
"building for another distro or distributing binary copies. If you need an "
"API key, you can request one at <ulink "
"url=\"https://www.chromium.org/developers/how-tos/api-keys\"/>.</emphasis>"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/blfs-git/networking/netlibs/geoclue2.xml:197
#, xml-text
msgid ""
"Create the configuration needed for using Google's Geolocation Service as "
"the &root; user:"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><screen>
#: blfs-en/blfs-git/networking/netlibs/geoclue2.xml:201
#, no-wrap, xml-text
msgid ""
"<userinput>cat &gt; /etc/geoclue/conf.d/90-lfs-google.conf &lt;&lt; \"EOF\"\n"
"<literal># Begin /etc/geoclue/conf.d/90-lfs-google.conf\n"
"\n"
"# This configuration applies for the WiFi source.\n"
"[wifi]\n"
"\n"
"# Set the URL to Google's Geolocation Service.\n"
"url=https://www.googleapis.com/geolocation/v1/geolocate?key=AIzaSyDxKL42zsPjbke5O8_rPVpVrLrJ8aeE9rQ\n"
"\n"
"# End /etc/geoclue/conf.d/90-lfs-google.conf</literal>\n"
"EOF</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/blfs-git/networking/netlibs/geoclue2.xml:214
#, xml-text
msgid ""
"If you do not wish to request your location from a Geolocation service, you "
"can hardcode your location in <filename>/etc/geolocation</filename> using "
"the format described in <ulink role='man' "
"url='&man;geoclue'>geoclue(5)</ulink>."
msgstr ""

