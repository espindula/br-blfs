#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/networking/netlibs/serf.xml:98
#, xml-text
msgid "Installation of Serf"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netlibs/serf.xml:108
#, xml-text
msgid ""
"Install <application>Serf</application> by running the following commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/networking/netlibs/serf.xml:112
#, no-wrap, xml-text
msgid ""
"<userinput>sed -i \"/Append/s:RPATH=libdir,::\"          SConstruct &amp;&amp;\n"
"sed -i \"/Default/s:lib_static,::\"           SConstruct &amp;&amp;\n"
"sed -i \"/Alias/s:install_static,::\"         SConstruct &amp;&amp;\n"
"\n"
"scons PREFIX=/usr</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netlibs/serf.xml:140
#, xml-text
msgid "This package does not come with a functional test suite."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netlibs/serf.xml:144
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/networking/netlibs/serf.xml:147
#, no-wrap, xml-text
msgid "<userinput>scons PREFIX=/usr install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/networking/netlibs/serf.xml:152
#, xml-text
msgid "Command Explanations"
msgstr ""

#. The fourth command corrects for
#.       changes in scons-3.x. The last command allows to use <application>
#.       Python 3</application>.
#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netlibs/serf.xml:155
#, xml-text
msgid ""
"<command>sed -i \"...\"</command>: The first command removes the runtime "
"path from a shared library and the next two commands disable building and "
"installing of the static library."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netlibs/serf.xml:163
#, xml-text
msgid ""
"<option>GSSAPI=/usr</option>: Use this switch if you have installed a GSSAPI"
" library and you want <application>serf</application> to use it."
msgstr ""

