msgstr ""

#. type: Content of: <sect1><sect2><note><para>
#: blfs-en/blfs-git/networking/netlibs/libtirpc.xml:95
#, xml-text
msgid ""
"If updating this package, you will also need to update any existing version "
"of <xref linkend='rpcbind'/>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netlibs/libtirpc.xml:107
#, xml-text
msgid ""
"Install <application>libtirpc</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/networking/netlibs/libtirpc.xml:111
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr     \\\n"
"            --sysconfdir=/etc \\\n"
"            --disable-static  \\\n"
"            --disable-gssapi  &amp;&amp;\n"
"\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netlibs/libtirpc.xml:119
#, xml-text
msgid "This package does not come with a test suite."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netlibs/libtirpc.xml:123
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/networking/netlibs/libtirpc.xml:126
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/networking/netlibs/libtirpc.xml:142
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netlibs/libtirpc.xml:148
#, xml-text
msgid ""
"<parameter>--disable-gssapi</parameter>: This switch is needed if no GSSAPI "
"providers are installed, such as <xref linkend=\"mitkrb\"/>.  Remove this "
"switch if you have installed <xref linkend=\"mitkrb\"/> and you need to use "
"the GSSAPI support."
msgstr ""

