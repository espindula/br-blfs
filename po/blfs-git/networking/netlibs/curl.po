#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/blfs-git/networking/netlibs/curl.xml:105
#, xml-text
msgid "Optional"
msgstr ""

#.  cURL implements the SMB client with own code.  Samba is only
#.            used for /usr/bin/ntlm_auth helper.  The path is correctly
#.            guessed even if Samba is not installed, so "runtime".
#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netlibs/curl.xml:107
#, xml-text
msgid ""
"<xref linkend=\"brotli\"/>, <xref linkend=\"c-ares\"/>, <xref "
"linkend=\"gnutls\"/>, <xref linkend=\"libidn2\"/>, <xref "
"linkend=\"libssh2\"/>, <xref linkend=\"mitkrb\"/>, <xref "
"linkend=\"nghttp2\"/>, <xref linkend=\"openldap\"/>, <xref role='runtime' "
"linkend=\"samba\"/> (runtime, for NTLM authentication), <ulink "
"url=\"https://www.gnu.org/software/gsasl/\">gsasl</ulink>, <ulink "
"url=\"https://www.secureauth.com/labs/open-source-"
"tools/impacket/\">impacket</ulink>, <ulink "
"url=\"https://launchpad.net/libmetalink/\">libmetalink</ulink>, <ulink "
"url=\"https://rtmpdump.mplayerhq.hu/\">librtmp</ulink>, <ulink "
"url=\"https://github.com/ngtcp2/ngtcp2/\">ngtcp2</ulink>, <ulink "
"url=\"https://github.com/cloudflare/quiche\">quiche</ulink>, and <ulink "
"url=\"https://spnego.sourceforge.net/\">SPNEGO</ulink>"
msgstr ""

#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/blfs-git/networking/netlibs/curl.xml:129
#, xml-text
msgid "Optional if Running the Test Suite"
msgstr ""

#.  stunnel is still listed in the docs as required, but 7.58.0
#.        tests completed happily without it, although the test for unit1323
#.        reported that the tool set in the test case does not exist - ken
#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netlibs/curl.xml:134
#, xml-text
msgid ""
"<xref linkend=\"apache\"/> and <xref linkend=\"stunnel\"/> (for the HTTPS "
"and FTPS tests), <xref linkend=\"openssh\"/>, and <xref "
"linkend=\"valgrind\"/> (this will slow the tests down and may cause "
"failures)"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/networking/netlibs/curl.xml:143
#, xml-text
msgid "Installation of cURL"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netlibs/curl.xml:147
#, xml-text
msgid "First, resolve a problem with a security fix:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/networking/netlibs/curl.xml:150
#, no-wrap, xml-text
msgid "<userinput>sed -i 's/2F 5C/%2F %5C/' scripts/wcurl</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netlibs/curl.xml:153
#, xml-text
msgid ""
"Install <application>cURL</application> by running the following commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/networking/netlibs/curl.xml:157
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr    \\\n"
"            --disable-static \\\n"
"            --with-openssl   \\\n"
"            --with-ca-path=/etc/ssl/certs &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. One test, <filename>
#. 1477</filename>, is known to fail due to
#.        a missing file in the curl tarball.
#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netlibs/curl.xml:192
#, xml-text
msgid ""
"To run the test suite, issue: <command>make test</command>.  Some tests are "
"flaky, so if some tests have failed it's possible to run a test again with: "
"<command>(cd tests; ./runtests.pl <replaceable>&lt;test "
"ID&gt;</replaceable>)</command> (the ID of failed tests are shown in the "
"<quote><computeroutput>These test cases failed:</computeroutput></quote> "
"message). If you run the tests after the package has been installed, some "
"tests may fail because the man pages were deleted by the 'find' command in "
"the installation instructions below."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netlibs/curl.xml:460
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/networking/netlibs/curl.xml:464
#, no-wrap, xml-text
msgid ""
"<userinput>make install &amp;&amp;\n"
"\n"
"rm -rf docs/examples/.deps &amp;&amp;\n"
"\n"
"find docs \\( -name Makefile\\* -o  \\\n"
"             -name \\*.1       -o  \\\n"
"             -name \\*.3       -o  \\\n"
"             -name CMakeLists.txt \\) -delete &amp;&amp;\n"
"\n"
"cp -v -R docs -T /usr/share/doc/curl-&curl-version;</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netlibs/curl.xml:476
#, xml-text
msgid ""
"To run some simple verification tests on the newly installed "
"<command>curl</command>, issue the following commands: <command>curl "
"--trace-ascii debugdump.txt https://www.example.com/</command> and "
"<command>curl --trace-ascii d.txt --trace-time "
"https://example.com/</command>.  Inspect the locally created trace files "
"<filename>debugdump.txt</filename> and <filename>d.txt</filename>, which "
"contains version information, downloaded files information, etc. One file "
"has the time for each action logged."
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/networking/netlibs/curl.xml:488
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netlibs/curl.xml:494
#, xml-text
msgid ""
"<parameter>--with-ca-path=/etc/ssl/certs</parameter>: This switch sets the "
"location of the BLFS Certificate Authority store."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netlibs/curl.xml:499
#, xml-text
msgid ""
"<parameter>--with-openssl</parameter>: This parameter chooses "
"<application>OpenSSL</application> as SSL/TLS implementation.  This option "
"is not needed if <option>--with-gnutls</option> is selected instead."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netlibs/curl.xml:506
#, xml-text
msgid ""
"<option>--with-gssapi</option>: This parameter adds <application>Kerberos "
"5</application> support to <filename "
"class=\"libraryfile\">libcurl</filename>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netlibs/curl.xml:512
#, xml-text
msgid ""
"<option>--with-gnutls</option>: Use this switch to build with "
"<application>GnuTLS</application> support instead of "
"<application>OpenSSL</application> for SSL/TLS."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netlibs/curl.xml:518
#, xml-text
msgid ""
"<option>--with-ca-bundle=/etc/pki/tls/certs/ca-bundle.crt</option>: Use this"
" switch instead of <parameter>--with-ca-path</parameter> if building with "
"<application>GnuTLS</application> support instead of "
"<application>OpenSSL</application> for SSL/TLS."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netlibs/curl.xml:525
#, xml-text
msgid ""
"<option>--with-libssh2</option>: This parameter adds "
"<application>SSH</application> support to cURL. This is disabled by default."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netlibs/curl.xml:531
#, xml-text
msgid ""
"<option>--enable-ares</option>: This parameter adds support for DNS "
"resolution through the c-ares library."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netlibs/curl.xml:536
#, xml-text
msgid ""
"<command>find docs ... -exec rm {} \\;</command>: This command removes "
"<filename>Makefiles</filename> and man files from the documentation "
"directory that would otherwise be installed by the commands that follow."
msgstr ""

