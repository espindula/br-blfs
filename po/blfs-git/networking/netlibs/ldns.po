#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/networking/netlibs/ldns.xml:84
#, xml-text
msgid "Installation of ldns"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netlibs/ldns.xml:87
#, xml-text
msgid ""
"Install <application>ldns</application> by running the following commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/networking/netlibs/ldns.xml:91
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr     \\\n"
"            --sysconfdir=/etc \\\n"
"            --disable-static  \\\n"
"            --with-drill      &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netlibs/ldns.xml:98
#, xml-text
msgid ""
"If you have <xref linkend=\"doxygen\"/> installed and want to build html "
"documentation, run the following command:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/networking/netlibs/ldns.xml:102
#, no-wrap, xml-text
msgid "<userinput>make doc</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netlibs/ldns.xml:105
#, xml-text
msgid "This package does not come with a working test suite."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netlibs/ldns.xml:109
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/networking/netlibs/ldns.xml:112
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netlibs/ldns.xml:115
#, xml-text
msgid ""
"If you built html documentation, install it by running the following "
"commands as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/networking/netlibs/ldns.xml:120
#, no-wrap, xml-text
msgid ""
"<userinput>install -v -m755 -d /usr/share/doc/ldns-&ldns-version; &amp;&amp;\n"
"install -v -m644 doc/html/* /usr/share/doc/ldns-&ldns-version;</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/networking/netlibs/ldns.xml:126
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netlibs/ldns.xml:132
#, xml-text
msgid ""
"<parameter>--with-drill</parameter>: This option enables building of the "
"<command>drill</command> tool (used for obtaining debug information from "
"DNS(SEC))"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netlibs/ldns.xml:147
#, xml-text
msgid ""
"<option>--with-examples</option>: This option enables building of the "
"example programs."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netlibs/ldns.xml:152
#, xml-text
msgid ""
"<option>--with-pyldns</option>: This option enables building of the Python "
"bindings. If you use this option, you will need to add "
"PYTHON=/usr/bin/python3 to the configure line as well."
msgstr ""

