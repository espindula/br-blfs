#, xml-text
msgid "Installation of libpcap"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netlibs/libpcap.xml:101
#, xml-text
msgid ""
"Install <application>libpcap</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/networking/netlibs/libpcap.xml:105
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netlibs/libpcap.xml:109
#, xml-text
msgid "This package does not come with a test suite."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netlibs/libpcap.xml:113
#, xml-text
msgid "If you want to disable installing the static library, use this sed:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/networking/netlibs/libpcap.xml:116
#, no-wrap, xml-text
msgid ""
"<userinput>sed -i '/INSTALL_DATA.*libpcap.a\\|RANLIB.*libpcap.a/ s/^/#/' "
"Makefile</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netlibs/libpcap.xml:119
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/networking/netlibs/libpcap.xml:122
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr ""

