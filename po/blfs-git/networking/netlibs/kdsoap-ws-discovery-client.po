#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/networking/netlibs/kdsoap-ws-discovery-client.xml:75
#, xml-text
msgid "Installation of kdsoap-ws-discovery-client"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netlibs/kdsoap-ws-discovery-client.xml:78
#, xml-text
msgid ""
"Install <application>kdsoap-ws-discovery-client</application> by running the"
" following commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/networking/netlibs/kdsoap-ws-discovery-client.xml:82
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr    \\\n"
"      -D CMAKE_BUILD_TYPE=Release     \\\n"
"      -D CMAKE_SKIP_INSTALL_RPATH=ON  \\\n"
"      -D QT_MAJOR_VERSION=6           \\\n"
"      -W no-dev .. &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netlibs/kdsoap-ws-discovery-client.xml:93
#, xml-text
msgid "To test the results, issue: <command>make test</command>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netlibs/kdsoap-ws-discovery-client.xml:97
#, xml-text
msgid "Now, as the &root; user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/networking/netlibs/kdsoap-ws-discovery-client.xml:100
#, no-wrap, xml-text
msgid ""
"<userinput>make install &amp;&amp;\n"
"mv -v /usr/share/doc/KDSoapWSDiscoveryClient{,-&kdsoap-ws-discovery-client-version;}</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/networking/netlibs/kdsoap-ws-discovery-client.xml:106
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netlibs/kdsoap-ws-discovery-client.xml:112
#, xml-text
msgid ""
"<command>mv -v /usr/share/doc/KDSoapWSDiscoveryClient[...]:</command>: This "
"command moves the documentation to a versioned directory."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netlibs/kdsoap-ws-discovery-client.xml:117
#, xml-text
msgid ""
"<parameter>-D QT_MAJOR_VERSION=6</parameter>: This parameter tells the build"
" system to build the Qt6 version of this package instead of the Qt5 version."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netlibs/kdsoap-ws-discovery-client.xml:123
#, xml-text
msgid ""
"<option>-D BUILD_QCH=ON</option>: This option tells the build system to "
"create documentation that can be used with QtCreator, QtAssistant, or "
"KDevelop."
msgstr ""

