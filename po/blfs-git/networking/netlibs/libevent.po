#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/networking/netlibs/libevent.xml:91
#, xml-text
msgid "Installation of libevent"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netlibs/libevent.xml:94
#, xml-text
msgid "First, fix an issue that prevents event_rpcgen.py from working:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/networking/netlibs/libevent.xml:97
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"pre\">sed -i 's/python/&amp;3/' "
"event_rpcgen.py</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netlibs/libevent.xml:100
#, xml-text
msgid ""
"Install <application>libevent</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/networking/netlibs/libevent.xml:104
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr --disable-static &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netlibs/libevent.xml:108
#, xml-text
msgid ""
"If you have <xref linkend=\"doxygen\"/> installed and wish to build API "
"documentation, issue :"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/networking/netlibs/libevent.xml:112
#, no-wrap, xml-text
msgid "<userinput>doxygen Doxyfile</userinput>"
msgstr ""

#.  https://github.com/libevent/libevent/issues/1271 and
#.       https://github.com/libevent/libevent/issues/1304. There are three
#. commits
#.       that we could apply, but since they just touch the tests it's
#. probably
#.       not necessary to fix it. The relevant PRs are #1305, #1045, and the
#. commit
#.       linked in #1271. This should be fixed in libevent-2.2.
#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netlibs/libevent.xml:115
#, xml-text
msgid ""
"To test the results, issue: <command>make verify</command>. Six tests in "
"every suite related to <filename>regress_ssl.c</filename> and "
"<filename>regress_http.c</filename> are known to fail due to "
"incompatibilities with OpenSSL-3. Some tests that are related to "
"<filename>regress_dns.c</filename> are also known to fail intermittently due"
" to insufficient test timeouts."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netlibs/libevent.xml:129
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/networking/netlibs/libevent.xml:132
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netlibs/libevent.xml:135
#, xml-text
msgid ""
"If you built the API documentation, install it by issuing the following "
"commands as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/networking/netlibs/libevent.xml:140
#, no-wrap, xml-text
msgid ""
"<userinput>install -v -m755 -d /usr/share/doc/libevent-&libevent-version;/api &amp;&amp;\n"
"cp      -v -R       doxygen/html/* \\\n"
"                    /usr/share/doc/libevent-&libevent-version;/api</userinput>"
msgstr ""

