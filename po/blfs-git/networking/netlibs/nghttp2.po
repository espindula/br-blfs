#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/networking/netlibs/nghttp2.xml:107
#, xml-text
msgid "Installation of nghttp2"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netlibs/nghttp2.xml:110
#, xml-text
msgid ""
"Install <application>nghttp2</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/networking/netlibs/nghttp2.xml:114
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr     \\\n"
"            --disable-static  \\\n"
"            --enable-lib-only \\\n"
"            --docdir=/usr/share/doc/nghttp2-&nghttp2-version; &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netlibs/nghttp2.xml:121
#, xml-text
msgid "To test the results, issue: <command>make check</command>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netlibs/nghttp2.xml:125
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/networking/netlibs/nghttp2.xml:128
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/networking/netlibs/nghttp2.xml:133
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/netlibs/nghttp2.xml:139
#, xml-text
msgid ""
"<parameter>--enable-lib-only</parameter>: only build libnghttp2. Omit this "
"switch if you'd like to build the example applications, Python bindings, or "
"the C++ asio library."
