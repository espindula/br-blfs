#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/networking/mailnews/fetchmail.xml:93
#, xml-text
msgid "Installation of Fetchmail"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/mailnews/fetchmail.xml:96
#, xml-text
msgid ""
"Create a dedicated user for the fetchmail program.  Issue the following "
"commands as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/networking/mailnews/fetchmail.xml:101
#, no-wrap, xml-text
msgid ""
"<userinput>useradd -c \"Fetchmail User\" -d /dev/null -g nogroup \\\n"
"        -s /bin/false -u 38 fetchmail</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/mailnews/fetchmail.xml:105
#, xml-text
msgid ""
"Install <application>Fetchmail</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/networking/mailnews/fetchmail.xml:109
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/mailnews/fetchmail.xml:113
#, xml-text
msgid "To test the results, issue: <command>make check</command>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/networking/mailnews/fetchmail.xml:117
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/networking/mailnews/fetchmail.xml:120
#, no-wrap, xml-text
msgid ""
"<userinput>make install &amp;&amp;\n"
"chown -v fetchmail:nogroup /usr/bin/fetchmail</userinput>"
msgstr ""

