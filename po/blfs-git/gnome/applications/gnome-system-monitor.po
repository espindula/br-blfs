#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/gnome/applications/gnome-system-monitor.xml:94
#, xml-text
msgid "Installation of GNOME System Monitor"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/applications/gnome-system-monitor.xml:97
#, xml-text
msgid ""
"First, remove a hard dependency on Catch2, which is only used if you are "
"running the unit tests:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/gnome/applications/gnome-system-monitor.xml:101
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"pre\">find . -name meson.build | xargs sed -i -e '/catch2/d' &amp;&amp;\n"
"sed -i '145,155d' src/meson.build</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/applications/gnome-system-monitor.xml:105
#, xml-text
msgid ""
"Install <application>GNOME System Monitor</application> by running the "
"following commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/gnome/applications/gnome-system-monitor.xml:109
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr       \\\n"
"            -D systemd=false    \\\n"
"            --buildtype=release \\\n"
"            ..                  &amp;&amp;\n"
"ninja</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/gnome/applications/gnome-system-monitor.xml:118
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr --buildtype=release .. &amp;&amp;\n"
"ninja</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/applications/gnome-system-monitor.xml:125
#, xml-text
msgid ""
"This package comes with a test suite, but it requires the external Catch2 "
"dependency. If you have Catch2 installed, you can omit the seds above and "
"then run the tests with <command>ninja test</command>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/applications/gnome-system-monitor.xml:131
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/gnome/applications/gnome-system-monitor.xml:134
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/gnome/applications/gnome-system-monitor.xml:139
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/applications/gnome-system-monitor.xml:142
#, xml-text
msgid ""
"<parameter>-D systemd=false</parameter>: This switch ensures that gnome-"
"system-monitor does NOT use the systemd process monitoring framework.  Use "
"this option if you are on a SysV system."
msgstr ""

