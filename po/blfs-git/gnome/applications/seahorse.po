#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/gnome/applications/seahorse.xml:118
#, xml-text
msgid "Installation of Seahorse"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/applications/seahorse.xml:130
#, xml-text
msgid "First, fix a build failure that occurs with gpgme-2.x:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/gnome/applications/seahorse.xml:133
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"pre\">sed -i \"/GPGME_EVENT_NEXT_TRUSTITEM/d\" "
"pgp/seahorse-gpgme.c</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/applications/seahorse.xml:136
#, xml-text
msgid ""
"Install <application>Seahorse</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/gnome/applications/seahorse.xml:140
#, no-wrap, xml-text
msgid ""
"<userinput>sed -i -r 's:\"(/apps):\"/org/gnome\\1:' data/*.xml &amp;&amp;\n"
"\n"
"mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr --buildtype=release .. &amp;&amp;\n"
"ninja</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/applications/seahorse.xml:149
#, xml-text
msgid "To test the results, issue: <command>ninja test</command>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/applications/seahorse.xml:153
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/gnome/applications/seahorse.xml:156
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
