#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/gnome/applications/evince.xml:114
#, xml-text
msgid "Installation of Evince"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/applications/evince.xml:129
#, xml-text
msgid ""
"Install <application>Evince</application> by running the following commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/gnome/applications/evince.xml:133
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"CPPFLAGS+=\" -I/opt/texlive/&texlive-year;/include -DNO_DEBUG\" \\\n"
"meson setup --prefix=/usr                \\\n"
"            --buildtype=release          \\\n"
"            -D gtk_doc=false             \\\n"
"            --wrap-mode=nodownload       \\\n"
"            -D systemduserunitdir=no ..  &amp;&amp;\n"
"ninja</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/gnome/applications/evince.xml:144
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"CPPFLAGS+=\" -I/opt/texlive/&texlive-year;/include -DNO_DEBUG\" \\\n"
"meson setup --prefix=/usr                \\\n"
"            --buildtype=release          \\\n"
"            -D gtk_doc=false             \\\n"
"            --wrap-mode=nodownload       \\\n"
"            ..                           &amp;&amp;\n"
"ninja</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/applications/evince.xml:156
#, xml-text
msgid ""
"If you have <xref linkend='gi-docgen'/> installed and wish to build the API "
"documentation for this package, issue:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/gnome/applications/evince.xml:160
#, no-wrap, xml-text
msgid ""
"<userinput>sed \"/docs_dir/s@\\$@ / 'evince-&evince-version;'@\" -i ../help/meson.build &amp;&amp;\n"
"meson configure -D gtk_doc=true                                 &amp;&amp;\n"
"ninja</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/applications/evince.xml:165
#, xml-text
msgid "This package does not have a working test suite."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/applications/evince.xml:169
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/gnome/applications/evince.xml:172
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/gnome/applications/evince.xml:180
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/applications/evince.xml:186
#, xml-text
msgid ""
"<parameter>CPPFLAGS+=\" -I/opt/texlive/&texlive-year;/include\"</parameter>:"
" Make sure that meson can find libkpathsea headers from TeXLive if it is "
"installed. This has no effect on systems without TeXLive installed."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/applications/evince.xml:192
#, xml-text
msgid ""
"<parameter>--wrap-mode=nodownload</parameter>: This switch disables fetching"
" any dependency: the build system tries to fetch gi-docgen even if "
"<parameter>-D gtk_doc=false</parameter> is passed."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/applications/evince.xml:198
#, xml-text
msgid "<parameter>-D gtk_doc=false</parameter>: &gi-doc-disable;"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/applications/evince.xml:202
#, xml-text
msgid ""
"<option>-D gspell=false</option>: This switch turns off support for the "
"spell checking plugin."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/applications/evince.xml:207
#, xml-text
msgid ""
"<option>-D introspection=false</option>: Use this option if you don't have "
"built <xref linkend='glib2'/> with GObject Introspection and don't wish to "
"have introspection support built into Evince."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/applications/evince.xml:213
#, xml-text
msgid ""
"<option>-D nautilus=false</option>: This switch disables building the "
"<application>Nautilus</application> Plugin. Use this switch if "
"<application>Nautilus</application> is not installed."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/applications/evince.xml:219
#, xml-text
msgid ""
"<option>-D keyring=false</option>: This switch disables the use of "
"<application>libsecret</application>. Use this switch if "
"<application>libsecret</application> is not installed."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/applications/evince.xml:225
#, xml-text
msgid ""
"<option>-D ps=enabled</option>: Use this switch if "
"<application>libspectre</application> is installed and you want to view "
"PostScript files with <application>Evince</application>."
msgstr ""

