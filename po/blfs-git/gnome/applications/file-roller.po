#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/gnome/applications/file-roller.xml:114
#, xml-text
msgid "Installation of File Roller"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/applications/file-roller.xml:117
#, xml-text
msgid ""
"Install <application>File Roller</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/gnome/applications/file-roller.xml:121
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr       \\\n"
"            --buildtype=release \\\n"
"            -D packagekit=false \\\n"
"            ..                  &amp;&amp;\n"
"ninja</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/applications/file-roller.xml:131
#, xml-text
msgid "This package does not come with a test suite."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/applications/file-roller.xml:135
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/gnome/applications/file-roller.xml:138
#, no-wrap, xml-text
msgid ""
"<userinput>ninja install &amp;&amp;\n"
"chmod -v 0755 /usr/libexec/file-roller/isoinfo.sh</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/gnome/applications/file-roller.xml:150
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/applications/file-roller.xml:156
#, xml-text
msgid ""
"<parameter>-D packagekit=false</parameter>: This switch disables the use of "
"PackageKit which isn't suitable for BLFS."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/applications/file-roller.xml:161
#, xml-text
msgid ""
"<option>-D api_docs=enabled</option>: Use this switch if you have <xref "
"linkend=\"gi-docgen\"/> installed and wish to generate the API "
"documentation."
msgstr ""

