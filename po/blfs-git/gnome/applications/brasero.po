#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/gnome/applications/brasero.xml:125
#, xml-text
msgid "Installation of Brasero"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/applications/brasero.xml:128
#, xml-text
msgid "First, fix a build issue that occurs with GCC-14:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/gnome/applications/brasero.xml:131
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"pre\">patch -Np1 -i ../brasero-&brasero-"
"version;-upstream_fixes-1.patch</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/applications/brasero.xml:134
#, xml-text
msgid ""
"Install <application>Brasero</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/gnome/applications/brasero.xml:138
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr                \\\n"
"            --enable-compile-warnings=no \\\n"
"            --enable-cxx-warnings=no     \\\n"
"            --disable-nautilus           &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/applications/brasero.xml:145
#, xml-text
msgid "This package does not come with a test suite."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/applications/brasero.xml:149
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/gnome/applications/brasero.xml:152
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/gnome/applications/brasero.xml:157
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/applications/brasero.xml:160
#, xml-text
msgid ""
"<parameter>--enable-*-warnings=no</parameter>: These switches fix build "
"problems under GCC-6.x compilers."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/applications/brasero.xml:165
#, xml-text
msgid ""
"<parameter>--disable-nautilus</parameter>: This switch disables building the"
" Nautilus extension since it is incompatible with the gtk4 version of "
"Nautilus."
msgstr ""

