#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/gnome/applications/gnome-nettool.xml:102
#, xml-text
msgid "Installation of GNOME Nettool"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/applications/gnome-nettool.xml:105
#, xml-text
msgid ""
"First, adapt <application>GNOME Nettool</application> to changes in the "
"<application>ping</application>, <application>ping6</application>, and "
"<application>netstat</application> utilities:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/gnome/applications/gnome-nettool.xml:110
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"pre\">patch -Np1 -i ../gnome-nettool-&gnome-nettool-"
"version;-ping_and_netstat_fixes-1.patch</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/applications/gnome-nettool.xml:113
#, xml-text
msgid "Then add a fix for newer versions of meson:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/gnome/applications/gnome-nettool.xml:116
#, no-wrap, xml-text
msgid "<userinput>sed -i '/merge_file/s/(.*/(/' data/meson.build</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/applications/gnome-nettool.xml:119
#, xml-text
msgid ""
"Install <application>GNOME Nettool</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/gnome/applications/gnome-nettool.xml:123
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr --buildtype=release &amp;&amp;\n"
"ninja</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/applications/gnome-nettool.xml:130
#, xml-text
msgid "This package does not come with a test suite."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/applications/gnome-nettool.xml:134
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/gnome/applications/gnome-nettool.xml:137
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr ""

