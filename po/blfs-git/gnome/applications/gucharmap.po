#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/gnome/applications/gucharmap.xml:118
#, xml-text
msgid "Installation of Gucharmap"
msgstr ""

#. type: Content of: <sect1><sect2><note><para>
#: blfs-en/blfs-git/gnome/applications/gucharmap.xml:122
#, xml-text
msgid ""
"This package uses two unversioned downloads. You may want to rename these to"
" a versioned name, e.g. <filename>UCD-16.zip</filename> to make upgrades "
"easier."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/applications/gucharmap.xml:129
#, xml-text
msgid ""
"Install <application>Gucharmap</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/gnome/applications/gucharmap.xml:133
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build                   &amp;&amp;\n"
"cd    build                   &amp;&amp;\n"
"mkdir ucd                     &amp;&amp;\n"
"pushd ucd                     &amp;&amp;\n"
"  unzip ../../../UCD.zip      &amp;&amp;\n"
"  cp -v ../../../Unihan.zip . &amp;&amp;\n"
"popd                          &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr       \\\n"
"            --strip             \\\n"
"            --buildtype=release \\\n"
"            -D ucd_path=./ucd   \\\n"
"            -D docs=false       \\\n"
"            ..                  &amp;&amp;\n"
"ninja</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/applications/gucharmap.xml:150
#, xml-text
msgid "This package does not have a test suite."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/applications/gucharmap.xml:154
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/gnome/applications/gucharmap.xml:157
#, no-wrap, xml-text
msgid ""
"<userinput>rm  -fv /usr/share/glib-2.0/schemas/org.gnome.Charmap.enums.xml &amp;&amp;\n"
"ninja install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/gnome/applications/gucharmap.xml:163
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/applications/gucharmap.xml:166
#, xml-text
msgid ""
"<parameter>--strip</parameter>: Although the package defaults to a release "
"build without debug information, without this switch there will be some "
"debug information in the binaries."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/applications/gucharmap.xml:172
#, xml-text
msgid ""
"<parameter>-D ucd_path=./ucd</parameter>: This points to where the extracted"
" main Unicode data files, and the zipped Unihan archive can be found."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/applications/gucharmap.xml:177
#, xml-text
msgid ""
"<command>rm -fv "
"/usr/share/glib-2.0/schemas/org.gnome.Charmap.enums.xml</command>: Old "
"versions of this package installed an obsolete file that prevents the "
"program from running, as if the main schema has not been installed.  "
"Forcibly removing works even if the old file is not present."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/applications/gucharmap.xml:184
#, xml-text
msgid ""
"<parameter>-D docs=false</parameter>: This allows the package to build even "
"if <application>gtk-doc</application> has not been installed. Remove this if"
" you have installed that and wish to build the documentation."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/applications/gucharmap.xml:190
#, xml-text
msgid ""
"<option>-D gir=false</option>: Use this if you have not installed &gobject-"
"introspection;."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/applications/gucharmap.xml:195
#, xml-text
msgid ""
"<option>-D vapi=false</option>: Use this if you have not installed <xref "
"linkend=\"vala\"/>."
msgstr ""

