#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/gnome/applications/gnome-terminal.xml:99
#, xml-text
msgid "Installation of GNOME Terminal"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/applications/gnome-terminal.xml:102
#, xml-text
msgid "First, fix some deprecated schema entries:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/gnome/applications/gnome-terminal.xml:105
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"pre\">sed -i -r 's:\"(/system):\"/org/gnome\\1:g' "
"src/external.gschema.xml</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/applications/gnome-terminal.xml:108
#, xml-text
msgid ""
"Install <application>GNOME Terminal</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/gnome/applications/gnome-terminal.xml:112
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr --buildtype=release .. &amp;&amp;\n"
"ninja</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/applications/gnome-terminal.xml:119
#, xml-text
msgid "To test the results, issue: <command>ninja test</command>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/applications/gnome-terminal.xml:123
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/gnome/applications/gnome-terminal.xml:126
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/gnome/applications/gnome-terminal.xml:128
#, no-wrap, xml-text
msgid ""
"<userinput>ninja install &amp;&amp;\n"
"rm -v /usr/lib/systemd/user/gnome-terminal-server.service</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><note><para>
#: blfs-en/blfs-git/gnome/applications/gnome-terminal.xml:133
#, xml-text
msgid ""
"To run <application>GNOME Terminal</application>, the environment variable "
"<envar>LANG</envar> must be set to a UTF-8 locale <emphasis>prior</emphasis>"
" to starting the graphical environment."
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/gnome/applications/gnome-terminal.xml:142
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/applications/gnome-terminal.xml:148
#, xml-text
msgid ""
"<option>-D search_provider=false</option>: This switch disables the "
"<quote>search <application>gnome-shell</application></quote> provider. Use "
"this option if you do not have gnome-shell installed."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/applications/gnome-terminal.xml:154
#, xml-text
msgid ""
"<option>-D nautilus_extension=false</option>: This switch disables a "
"dependency on the <application>nautilus</application> file manager. Use this"
" option if you do not have Nautilus installed."
msgstr ""

