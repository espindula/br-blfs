#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/gnome/applications/loupe.xml:89
#, xml-text
msgid "Installation of Loupe"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/applications/loupe.xml:92
#, xml-text
msgid ""
"Install <application>Loupe</application> by running the following commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/gnome/applications/loupe.xml:96
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr       \\\n"
"            --buildtype=release \\\n"
"            ..                  &amp;&amp;\n"
"ninja</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/applications/loupe.xml:105
#, xml-text
msgid ""
"Running the test suite will rebuild the entire package with a different "
"configuration, and the package will be built for three times if installing "
"it after running the test suite.  So it's better to run the test suite after"
" the installation."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/applications/loupe.xml:112
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/gnome/applications/loupe.xml:115
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/applications/loupe.xml:118
#, xml-text
msgid "To test the results, issue: <command>ninja test</command>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/applications/loupe.xml:122
#, xml-text
msgid ""
"If you've installed Eog (which is unmaintained and removed from BLFS)  "
"before and now you want the file managers (like Nautilus) to open image "
"files using Loupe instead of Eog, as the &root; user, remove the desktop "
"file of Eog:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/gnome/applications/loupe.xml:128
#, no-wrap, xml-text
msgid ""
"<userinput>rm -fv /usr/share/applications/org.gnome.eog.desktop</userinput>"
msgstr ""

