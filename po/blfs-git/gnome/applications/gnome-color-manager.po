#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/applications/gnome-color-manager.xml:97
#, xml-text
msgid ""
"If <xref linkend=\"docbook-utils\"/> is installed, disable installation of "
"the man pages to avoid a build failure:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/gnome/applications/gnome-color-manager.xml:101
#, no-wrap, xml-text
msgid "<userinput>sed /subdir\\(\\'man/d -i meson.build</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/applications/gnome-color-manager.xml:104
#, xml-text
msgid ""
"Install <application>GNOME Color Manager</application> by running the "
"following commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/gnome/applications/gnome-color-manager.xml:108
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr --buildtype=release .. &amp;&amp;\n"
"ninja</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/applications/gnome-color-manager.xml:115
#, xml-text
msgid ""
"To test the results, issue: <command>ninja test</command>. The tests must be"
" run from an X session."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/applications/gnome-color-manager.xml:120
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/gnome/applications/gnome-color-manager.xml:123
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr ""

