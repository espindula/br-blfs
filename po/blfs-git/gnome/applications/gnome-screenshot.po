msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/applications/gnome-screenshot.xml:86
#, xml-text
msgid ""
"First, fix building with newer versions of <application>meson</application>:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/gnome/applications/gnome-screenshot.xml:90
#, no-wrap, xml-text
msgid "<userinput>sed -i '/merge_file/{n;d}' data/meson.build</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/applications/gnome-screenshot.xml:93
#, xml-text
msgid ""
"Install <application>GNOME Screenshot</application> by running the following"
" commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/gnome/applications/gnome-screenshot.xml:97
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr --buildtype=release .. &amp;&amp;\n"
"ninja</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/applications/gnome-screenshot.xml:104
#, xml-text
msgid "This package does not come with a test suite."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/applications/gnome-screenshot.xml:108
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/gnome/applications/gnome-screenshot.xml:111
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr ""

