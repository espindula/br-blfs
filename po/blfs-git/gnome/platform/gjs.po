#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/gnome/platform/gjs.xml:109
#, xml-text
msgid "Installation of Gjs"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/platform/gjs.xml:120
#, xml-text
msgid ""
"Install <application>Gjs</application> by running the following commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/gnome/platform/gjs.xml:124
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir gjs-build &amp;&amp;\n"
"cd    gjs-build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr          \\\n"
"            --buildtype=release    \\\n"
"            --wrap-mode=nofallback \\\n"
"            ..                     &amp;&amp;\n"
"ninja</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/platform/gjs.xml:134
#, xml-text
msgid ""
"To test the results, ensure both <xref linkend='gtk3'/> and <xref "
"linkend='gtk4'/> are installed and issue: <command>ninja test</command> in a"
" graphical session."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/platform/gjs.xml:140
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/gnome/platform/gjs.xml:143
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/gnome/platform/gjs.xml:148
#, xml-text
msgid "Command Explanations"
msgstr ""

