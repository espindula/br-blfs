#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/gnome/platform/gvfs.xml:132
#, xml-text
msgid "Installation of Gvfs"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/platform/gvfs.xml:135
#, xml-text
msgid ""
"Install <application>Gvfs</application> by running the following commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/gnome/platform/gvfs.xml:139
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup               \\\n"
"      --prefix=/usr       \\\n"
"      --buildtype=release \\\n"
"      -D onedrive=false   \\\n"
"      -D fuse=false       \\\n"
"      -D gphoto2=false    \\\n"
"      -D afc=false        \\\n"
"      -D bluray=false     \\\n"
"      -D nfs=false        \\\n"
"      -D mtp=false        \\\n"
"      -D smb=false        \\\n"
"      -D tmpfilesdir=no   \\\n"
"      -D dnssd=false      \\\n"
"      -D goa=false        \\\n"
"      -D google=false     \\\n"
"      -D systemduserunitdir=no .. &amp;&amp;\n"
"ninja</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/gnome/platform/gvfs.xml:160
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup               \\\n"
"      --prefix=/usr       \\\n"
"      --buildtype=release \\\n"
"      -D onedrive=false   \\\n"
"      -D fuse=false       \\\n"
"      -D gphoto2=false    \\\n"
"      -D afc=false        \\\n"
"      -D bluray=false     \\\n"
"      -D nfs=false        \\\n"
"      -D mtp=false        \\\n"
"      -D smb=false        \\\n"
"      -D dnssd=false      \\\n"
"      -D goa=false        \\\n"
"      -D google=false     .. &amp;&amp;\n"
"ninja</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/platform/gvfs.xml:180
#, xml-text
msgid ""
"The test suite requires <application>gnome-desktop-testing</application>, "
"which is beyond the scope of BLFS."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/platform/gvfs.xml:185
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/gnome/platform/gvfs.xml:188
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/gnome/platform/gvfs.xml:195
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/platform/gvfs.xml:201
#, xml-text
msgid ""
"<parameter>-D &lt;option&gt;=false</parameter>: These switches are required "
"if the corresponding dependency is not installed.  Remove those where you "
"have installed the corresponding application and wish to use it with "
"<application>Gvfs</application>. The dnssd option requires avahi and both "
"goa and google require GNOME Online Accounts.  The google option also "
"requires the libgdata package, which has been removed from BLFS. The "
"onedrive support requires the libmsgraph package."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/platform/gvfs.xml:211
#, xml-text
msgid ""
"<parameter>-D tmpfilesdir=no</parameter> <parameter>-D "
"systemduserunitdir=no</parameter>: These switches provide systemd directory "
"locations. Setting them to <quote>no</quote> disables the dependency on "
"systemd and logind."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/platform/gvfs.xml:218
#, xml-text
msgid ""
"<option>-D cdda=false</option>: This switch is required if libcdio is not "
"installed. The cdda backend is useless on machines without a CDROM/DVD "
"drive."
msgstr ""

