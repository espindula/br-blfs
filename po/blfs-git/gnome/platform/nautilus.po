#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/gnome/platform/nautilus.xml:106
#, xml-text
msgid "Installation of Nautilus"
msgstr ""

#. type: Content of: <sect1><sect2><note><para>
#: blfs-en/blfs-git/gnome/platform/nautilus.xml:110
#, xml-text
msgid ""
"If you are upgrading from a previous version of this package, remove a "
"conflicting file by running the following command as the &root; user:"
msgstr ""

#. type: Content of: <sect1><sect2><note><screen>
#: blfs-en/blfs-git/gnome/platform/nautilus.xml:114
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"pre\">rm -fv /usr/lib/libnautilus-"
"extension.so.4</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/platform/nautilus.xml:118
#, xml-text
msgid ""
"Install <application>Nautilus</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/gnome/platform/nautilus.xml:122
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr       \\\n"
"            --buildtype=release \\\n"
"            ..                  &amp;&amp;\n"
"\n"
"ninja</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/platform/nautilus.xml:132
#, xml-text
msgid ""
"If you have <xref linkend='gi-docgen'/> installed and you wish to generate "
"and install the API documentation, issue the following commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/gnome/platform/nautilus.xml:137
#, no-wrap, xml-text
msgid ""
"<userinput>sed \"/docdir =/s@\\$@ / 'nautilus-&nautilus-version;'@\" -i ../meson.build &amp;&amp;\n"
"meson configure -D docs=true &amp;&amp;\n"
"ninja</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/platform/nautilus.xml:142
#, xml-text
msgid ""
"To test the results, issue: <command>ninja test</command>. The tests need to"
" be run in a graphical environment.  One test is known to fail if <xref "
"linkend=\"localsearch\"/> is not installed. One test is also known to "
"timeout if the user running the tests has a large home directory."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/platform/nautilus.xml:149
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/gnome/platform/nautilus.xml:152
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr ""

