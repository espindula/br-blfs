#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/gnome/platform/evolution-data-server.xml:115
#, xml-text
msgid "Installation of Evolution Data Server"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/platform/evolution-data-server.xml:118
#, xml-text
msgid ""
"Install <application>Evolution Data Server</application> by running the "
"following commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/gnome/platform/evolution-data-server.xml:122
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr  \\\n"
"      -D SYSCONF_INSTALL_DIR=/etc   \\\n"
"      -D ENABLE_VALA_BINDINGS=ON    \\\n"
"      -D ENABLE_INSTALLED_TESTS=ON  \\\n"
"      -D WITH_OPENLDAP=OFF          \\\n"
"      -D WITH_KRB5=OFF              \\\n"
"      -D ENABLE_INTROSPECTION=ON    \\\n"
"      -D ENABLE_GTK_DOC=OFF         \\\n"
"      -D WITH_LIBDB=OFF             \\\n"
"      -D WITH_SYSTEMDUSERUNITDIR=no \\\n"
"      -W no-dev -G Ninja ..         &amp;&amp;\n"
"ninja</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/gnome/platform/evolution-data-server.xml:138
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr \\\n"
"      -D SYSCONF_INSTALL_DIR=/etc  \\\n"
"      -D ENABLE_VALA_BINDINGS=ON   \\\n"
"      -D ENABLE_INSTALLED_TESTS=ON \\\n"
"      -D WITH_OPENLDAP=OFF         \\\n"
"      -D WITH_KRB5=OFF             \\\n"
"      -D ENABLE_INTROSPECTION=ON   \\\n"
"      -D ENABLE_GTK_DOC=OFF        \\\n"
"      -D WITH_LIBDB=OFF            \\\n"
"      -W no-dev -G Ninja ..        &amp;&amp;\n"
"ninja</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/platform/evolution-data-server.xml:154
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/gnome/platform/evolution-data-server.xml:157
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/platform/evolution-data-server.xml:160
#, xml-text
msgid "To test the results, issue: <command>ninja test</command>."
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/gnome/platform/evolution-data-server.xml:170
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/platform/evolution-data-server.xml:173
#, xml-text
msgid ""
"<parameter>-D ENABLE_VALA_BINDINGS=ON</parameter>: This switch enables "
"building the Vala bindings. Remove it if you don't have <xref "
"linkend=\"vala\"/> installed."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/platform/evolution-data-server.xml:179
#, xml-text
msgid ""
"<parameter>-D ENABLE_GTK_DOC=OFF</parameter>: This switch disables building "
"the API documentation. It is broken for this package due to the use of a "
"long deprecated gtk-doc program that is no longer available."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/platform/evolution-data-server.xml:186
#, xml-text
msgid ""
"<parameter>-D WITH_KRB5=OFF</parameter>: This switch allows building this "
"package without <xref linkend=\"mitkrb\"/>. If you need Kerberos support in "
"this package, for example to connect to a corporate network, change this "
"switch from OFF to ON."
msgstr ""

#. This package only uses
#.       &berkeley-db; to import data from very outdated releases.
#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/platform/evolution-data-server.xml:193
#, xml-text
msgid ""
"<parameter>-D WITH_LIBDB=OFF</parameter>: This switch allows building this "
"package without &berkeley-db;.  sqlite is used for normal operation."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/platform/evolution-data-server.xml:200
#, xml-text
msgid ""
"<option>-D ENABLE_OAUTH2_WEBKITGTK4=OFF</option>: Use this switch if you did"
" not build <xref linkend=\"webkitgtk\" role=\"nodep\"/> with GTK-4."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/platform/evolution-data-server.xml:205
#, xml-text
msgid ""
"<parameter>-D WITH_SYSTEMDUSERUNITDIR=no</parameter>: This switch disables "
"installing the systemd units, which are not used for a Sysv build."
msgstr ""

#. type: Content of: <sect1><sect2><note><para>
#: blfs-en/blfs-git/gnome/platform/evolution-data-server.xml:212
#, xml-text
msgid ""
"To enable many of the optional dependencies, review the information from "
"<command>cmake -L CMakeLists.txt</command> for the necessary parameters you "
"must pass to the <command>cmake</command> command."
msgstr ""

