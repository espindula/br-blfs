#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/gnome/platform/rest.xml:98
#, xml-text
msgid "Installation of rest"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/platform/rest.xml:101
#, xml-text
msgid ""
"Install <application>rest</application> by running the following commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/gnome/platform/rest.xml:105
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr       \\\n"
"            --buildtype=release \\\n"
"            -D examples=false   \\\n"
"            -D gtk_doc=false    \\\n"
"            ..                  &amp;&amp;\n"
"ninja</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/platform/rest.xml:116
#, xml-text
msgid ""
"If you have <xref linkend='gi-docgen'/> installed and wish to build the API "
"documentation for this package, issue:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/gnome/platform/rest.xml:120
#, no-wrap, xml-text
msgid ""
"<userinput>sed \"/output/s/librest-1.0/rest-&rest-version;/\" -i ../docs/meson.build &amp;&amp;\n"
"meson configure -D gtk_doc=true                                &amp;&amp;\n"
"ninja</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/platform/rest.xml:125
#, xml-text
msgid "To test the results, issue: <command>ninja test</command>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/platform/rest.xml:129
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/gnome/platform/rest.xml:132
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/gnome/platform/rest.xml:137
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/platform/rest.xml:143
#, xml-text
msgid "<parameter>-D gtk_doc=false</parameter>: &gi-doc-disable;"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/platform/rest.xml:147
#, xml-text
msgid ""
"<parameter>-D examples=false</parameter>: Remove this option if <xref "
"linkend=\"libadwaita1\"/> and <xref linkend=\"gtksourceview5\"/> are "
"installed and you wish to build the demonstration application provided by "
"this package."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/platform/rest.xml:154
#, xml-text
msgid ""
"<option>-D vapi=true</option>: Use this switch if <xref linkend=\"vala\"/> "
"is installed and you wish to build the Vala bindings provided by this "
"package."
msgstr ""

