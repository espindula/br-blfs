#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/gnome/platform/gnome-bluetooth.xml:111
#, xml-text
msgid "Installation of GNOME Bluetooth"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/platform/gnome-bluetooth.xml:114
#, xml-text
msgid ""
"First, fix a build failure that happens with pygobject-3.52.0 and later:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/gnome/platform/gnome-bluetooth.xml:117
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"pre\">patch -Np1 -i ../gnome-bluetooth-&gnome-bluetooth-"
"version;-build_fix-1.patch</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/platform/gnome-bluetooth.xml:120
#, xml-text
msgid ""
"Install <application>GNOME Bluetooth</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/gnome/platform/gnome-bluetooth.xml:124
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr --buildtype=release .. &amp;&amp;\n"
"ninja</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/platform/gnome-bluetooth.xml:131
#, xml-text
msgid "To test the results, issue: <command>ninja test</command>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/platform/gnome-bluetooth.xml:135
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/gnome/platform/gnome-bluetooth.xml:138
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr ""

