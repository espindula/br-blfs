#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/gnome/platform/gexiv2.xml:104
#, xml-text
msgid "Installation of gexiv2"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/platform/gexiv2.xml:123
#, xml-text
msgid ""
"Install <application>gexiv2</application> by running the following commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/gnome/platform/gexiv2.xml:127
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr --buildtype=release .. &amp;&amp;\n"
"ninja</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/platform/gexiv2.xml:134
#, xml-text
msgid "To test the results, run:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/gnome/platform/gexiv2.xml:137
#, no-wrap, xml-text
msgid ""
"<userinput>meson configure -D tests=true &amp;&amp;\n"
"ninja test</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/platform/gexiv2.xml:141
#, xml-text
msgid "As the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/gnome/platform/gexiv2.xml:144
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr ""

