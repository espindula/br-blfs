#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/platform/libsecret.xml:78
#, xml-text
msgid ""
"<xref linkend=\"libgcrypt\"/> (or <xref role=\"nodep\" linkend=\"gnutls\"/>,"
" for cryptography), and <xref linkend=\"vala\"/>"
msgstr ""

#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/blfs-git/gnome/platform/libsecret.xml:83
#, xml-text
msgid "Optional"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/platform/libsecret.xml:85
#, xml-text
msgid ""
"<xref linkend=\"gi-docgen\"/> and <xref linkend=\"DocBook\"/>, <xref "
"linkend=\"docbook-xsl\"/>, <xref linkend=\"libxslt\"/> (to build manual "
"pages), <xref linkend=\"valgrind\"/> (can be used in tests), and <ulink "
"url=\"https://github.com/tpm2-software/tpm2-tss\">tpm2-tss</ulink> (for TPM "
"support)"
msgstr ""

#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/blfs-git/gnome/platform/libsecret.xml:94
#, xml-text
msgid "Optional (Required for the test suite)"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/platform/libsecret.xml:96
#, xml-text
msgid ""
"<xref linkend=\"dbus-python\"/>, <xref linkend=\"gjs\"/>, and <xref "
"linkend=\"pygobject3\"/>"
msgstr ""

