#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/blfs-git/gnome/platform/libsecret.xml:71
#, xml-text
msgid "Required"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/platform/libsecret.xml:73
#, xml-text
msgid "<xref linkend=\"glib2\"/> (GObject Introspection recommended)"
msgstr ""

#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/blfs-git/gnome/platform/libsecret.xml:76
#, xml-text
msgid "Recommended"
