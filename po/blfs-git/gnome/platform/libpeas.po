#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/gnome/platform/libpeas.xml:98
#, xml-text
msgid "Installation of libpeas"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/platform/libpeas.xml:101
#, xml-text
msgid ""
"Install <application>libpeas</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/gnome/platform/libpeas.xml:105
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr          \\\n"
"            --buildtype=release    \\\n"
"            --wrap-mode=nofallback \\\n"
"            -D python3=false       \\\n"
"            ..                     &amp;&amp;\n"
"ninja</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/platform/libpeas.xml:116
#, xml-text
msgid ""
"If you have <xref linkend='gi-docgen'/> installed and wish to build the API "
"documentation for this package, issue:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/gnome/platform/libpeas.xml:120
#, no-wrap, xml-text
msgid ""
"<userinput>sed \"/docs_dir =/s@\\$@/ 'libpeas-&libpeas-version;'@\" \\\n"
"    -i ../docs/reference/meson.build       &amp;&amp;\n"
"meson configure -D gtk_doc=true            &amp;&amp;\n"
"ninja</userinput>"
msgstr ""

#.  https://gitlab.gnome.org/GNOME/libpeas/-/merge_requests/55
#. One test named <literal>
#. test-extension-py</literal> is known to
#.       fail with PyGObject-3.52 or newer.
#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/platform/libpeas.xml:126
#, xml-text
msgid ""
"To test the results, issue: <command>ninja test</command>.  An active "
"graphical session with bus address is necessary to run the tests."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/platform/libpeas.xml:135
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/gnome/platform/libpeas.xml:138
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/gnome/platform/libpeas.xml:143
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/platform/libpeas.xml:155
#, xml-text
msgid ""
"<parameter>-D python3=false</parameter>: This switch disables the Python "
"plugin loader because it is incompatible with pygobject-3.52.x, and it will "
"cause applications which load Python plugins to hang indefinitely."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/platform/libpeas.xml:161
#, xml-text
msgid ""
"<option>-D vapi=true</option>: Add this switch if you wish to generate vapi "
"(vala) data."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/platform/libpeas.xml:166
#, xml-text
msgid ""
"<option>-D demos=false</option>: Add this switch if you do not wish to build"
" the demo programs."
msgstr ""

