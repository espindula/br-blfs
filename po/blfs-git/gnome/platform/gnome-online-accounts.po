#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/gnome/platform/gnome-online-accounts.xml:97
#, xml-text
msgid "Installation of GNOME Online Accounts"
msgstr ""

#.  Taken from Arch Linux - an immensely helpful link - Thanks
#.  BLFS Devs, register an account at Google with your
#.         @linuxfromscratch.org email address, and I'll make you an
#. administrator
#.         for the 'Google APIs for LFS' project (where the API and OAuth keys
#.         were created for use in the book).
#. type: Content of: <sect1><sect2><note><para>
#: blfs-en/blfs-git/gnome/platform/gnome-online-accounts.xml:102
#, xml-text
msgid ""
"The Google API Key and OAuth tokens below are specific to LFS. If using "
"these instructions for another distro, or if you intend to distribute binary"
" copies of the software using these instructions, please obtain your own "
"keys following the instructions located at <ulink "
"url=\"https://www.chromium.org/developers/how-tos/api-keys\"/>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/platform/gnome-online-accounts.xml:115
#, xml-text
msgid ""
"Install <application>GNOME Online Accounts</application> by running the "
"following commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/gnome/platform/gnome-online-accounts.xml:119
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup                                            \\\n"
"      --prefix=/usr                                    \\\n"
"      --buildtype=release                              \\\n"
"      -D documentation=false                           \\\n"
"      -D kerberos=false                                \\\n"
"      -D google_client_secret=5ntt6GbbkjnTVXx-MSxbmx5e \\\n"
"      -D google_client_id=595013732528-llk8trb03f0ldpqq6nprjp1s79596646.apps.googleusercontent.com \\\n"
"      .. &amp;&amp;\n"
"ninja</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/platform/gnome-online-accounts.xml:133
#, xml-text
msgid ""
"If you've installed <xref linkend='gi-docgen'/> and you wish to build and "
"install the API documentation of this package, issue:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/gnome/platform/gnome-online-accounts.xml:137
#, no-wrap, xml-text
msgid ""
"<userinput>meson configure -D documentation=true &amp;&amp;\n"
"sed \"s/project_name()/&amp; + '-' + meson.project_version()/\" \\\n"
"    -i ../doc/meson.build &amp;&amp;\n"
"ninja</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/platform/gnome-online-accounts.xml:143
#, xml-text
msgid "This package does not come with a test suite."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/platform/gnome-online-accounts.xml:147
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/gnome/platform/gnome-online-accounts.xml:150
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr ""

