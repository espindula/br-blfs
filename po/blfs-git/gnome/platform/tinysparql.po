#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/gnome/platform/tinysparql.xml:103
#, xml-text
msgid "Installation of Tinysparql"
msgstr ""

#. type: Content of: <sect1><sect2><warning><para>
#: blfs-en/blfs-git/gnome/platform/tinysparql.xml:107
#, xml-text
msgid ""
"If you are upgrading this package from a version that was from when this "
"package was known as <application>Tracker</application>, remove a file that "
"will cause a conflict as the &root; user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/gnome/platform/tinysparql.xml:113
#, no-wrap, xml-text
msgid ""
"<userinput>rm -fv /usr/lib/systemd/user/tracker-xdg-"
"portal-3.service</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/platform/tinysparql.xml:116
#, xml-text
msgid "Fix the location to install the documentation into:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/gnome/platform/tinysparql.xml:119
#, no-wrap, xml-text
msgid ""
"<userinput>sed -e \"s/'generate'/&amp;, '--no-namespace-dir'/\"         \\\n"
"    -e \"/--output-dir/s/@OUTPUT@/&amp;\\/tinysparql-&tinysparql-version;/\" \\\n"
"    -i docs/reference/meson.build</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/platform/tinysparql.xml:124
#, xml-text
msgid ""
"Install <application>Tinysparql</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/gnome/platform/tinysparql.xml:128
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr       \\\n"
"            --buildtype=release \\\n"
"            -D man=false        \\\n"
"            ..                  &amp;&amp;\n"
"ninja</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/gnome/platform/tinysparql.xml:137
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr                  \\\n"
"            --buildtype=release            \\\n"
"            -D man=false                   \\\n"
"            -D systemd_user_services=false \\\n"
"            ..                            &amp;&amp;\n"
"ninja</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/platform/tinysparql.xml:148
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/gnome/platform/tinysparql.xml:151
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/platform/tinysparql.xml:154
#, xml-text
msgid ""
"To test the results, issue: <command>meson configure -D debug=true "
"&amp;&amp; LC_ALL=C.UTF-8 ninja test</command>.  The test suite should be "
"run from a graphical session. One test is known to fail due to the manual "
"pages not being generated, but will pass if \"-D man=false\" is omitted when"
" configuring the package."
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/gnome/platform/tinysparql.xml:164
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/platform/tinysparql.xml:170
#, xml-text
msgid ""
"<parameter>-D man=false</parameter>: This switch prevents the build process "
"from generating man pages. Omit this switch if you have <xref "
"linkend=\"asciidoc\" role=\"nodep\"/> installed and wish to generate and "
"install the man pages."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/platform/tinysparql.xml:177
#, xml-text
msgid ""
"<parameter>-D systemd_user_services=false</parameter>: This switch prevents "
"the build process from installing systemd user services since they are "
"useless on SysV systems."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/platform/tinysparql.xml:183
#, xml-text
msgid ""
"<command>meson configure -D debug=true</command>: This command enables some "
"debug checks necessary for the test suite.  We don't want to enable them for"
" the installed tinysparql libraries and programs, so we run the test suite "
"after installation."
msgstr ""

