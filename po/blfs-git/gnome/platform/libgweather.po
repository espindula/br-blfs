#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/gnome/platform/libgweather.xml:112
#, xml-text
msgid "Installation of libgweather"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/platform/libgweather.xml:115
#, xml-text
msgid "Fix an issue in the shipped geolocation data:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/gnome/platform/libgweather.xml:118
#, no-wrap, xml-text
msgid ""
"<userinput>patch -Np1 -i ../libgweather-&libgweather-"
"version;-upstream_fix-1.patch</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/platform/libgweather.xml:121
#, xml-text
msgid ""
"Install <application>libgweather</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/gnome/platform/libgweather.xml:125
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr       \\\n"
"            --buildtype=release \\\n"
"            -D gtk_doc=false    \\\n"
"            ..                  &amp;&amp;\n"
"ninja</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/platform/libgweather.xml:135
#, xml-text
msgid ""
"If you have <xref linkend='gi-docgen'/> installed and wish to build the API "
"documentation for this package, issue:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/gnome/platform/libgweather.xml:139
#, no-wrap, xml-text
msgid ""
"<userinput>sed \"s/libgweather_full_version/'libgweather-&libgweather-version;'/\" \\\n"
"    -i ../doc/meson.build                             &amp;&amp;\n"
"meson configure -D gtk_doc=true                       &amp;&amp;\n"
"ninja</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/platform/libgweather.xml:145
#, xml-text
msgid ""
"One test needs that the locale files be installed on the system, so it is "
"better to run the tests after installing the package."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/platform/libgweather.xml:150
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/gnome/platform/libgweather.xml:153
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/platform/libgweather.xml:156
#, xml-text
msgid "To test the results, issue: <command>LC_ALL=C ninja test</command>."
msgstr ""

