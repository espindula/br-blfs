#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/gnome/platform/gnome-keyring.xml:98
#, xml-text
msgid "Installation of GNOME Keyring"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/platform/gnome-keyring.xml:101
#, xml-text
msgid ""
"Install <application>GNOME Keyring</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/gnome/platform/gnome-keyring.xml:105
#, no-wrap, xml-text
msgid ""
"<userinput>sed -i 's:\"/desktop:\"/org:' schema/*.xml &amp;&amp;\n"
"\n"
"mkdir build-gkr &amp;&amp;\n"
"cd    build-gkr &amp;&amp;\n"
"\n"
"meson setup ..            \\\n"
"      --prefix=/usr       \\\n"
"      --buildtype=release \\\n"
"      -D systemd=disabled &amp;&amp;\n"
"ninja</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/gnome/platform/gnome-keyring.xml:116
#, no-wrap, xml-text
msgid ""
"<userinput>sed -i 's:\"/desktop:\"/org:' schema/*.xml &amp;&amp;\n"
"\n"
"mkdir build-gkr &amp;&amp;\n"
"cd    build-gkr &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr --buildtype=release .. &amp;&amp;\n"
"ninja</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/platform/gnome-keyring.xml:125
#, xml-text
msgid ""
"A session bus address is necessary to run the tests. To test the results, "
"issue: <command>ninja test</command>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/platform/gnome-keyring.xml:130
#, xml-text
