#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/gnome/platform/gsettings-desktop-schemas.xml:81
#, xml-text
msgid "Installation of GSettings Desktop Schemas"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/platform/gsettings-desktop-schemas.xml:84
#, xml-text
msgid ""
"Install <application>GSettings Desktop Schemas</application> by running the "
"following commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/gnome/platform/gsettings-desktop-schemas.xml:88
#, no-wrap, xml-text
msgid ""
"<userinput>sed -i -r 's:\"(/system):\"/org/gnome\\1:g' schemas/*.in &amp;&amp;\n"
"\n"
"mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr --buildtype=release .. &amp;&amp;\n"
"ninja</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/platform/gsettings-desktop-schemas.xml:97
#, xml-text
msgid "This package does not come with a test suite."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/platform/gsettings-desktop-schemas.xml:101
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/gnome/platform/gsettings-desktop-schemas.xml:104
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr ""

