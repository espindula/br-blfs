#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/gnome/platform/gnome-settings-daemon.xml:127
#, xml-text
msgid "Installation of GNOME Settings Daemon"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/platform/gnome-settings-daemon.xml:130
#, xml-text
msgid "Next, fix libelogind detection for tests:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/gnome/platform/gnome-settings-daemon.xml:133
#, no-wrap, xml-text
msgid ""
"<userinput>sed -e 's/libsystemd/libelogind/' \\\n"
"    -i plugins/power/test.py</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/platform/gnome-settings-daemon.xml:137
#, xml-text
msgid "Next, fix backlight functionality in gnome-control-center:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/gnome/platform/gnome-settings-daemon.xml:140
#, no-wrap, xml-text
msgid ""
"<userinput>sed -e 's/(backlight->logind_proxy)/(0)/' \\\n"
"    -i plugins/power/gsd-backlight.c</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/platform/gnome-settings-daemon.xml:144
#, xml-text
msgid ""
"Install <application>GNOME Settings Daemon</application> by running the "
"following commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/gnome/platform/gnome-settings-daemon.xml:148
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr       \\\n"
"            --buildtype=release \\\n"
"            -D systemd=false    \\\n"
"            ..                  &amp;&amp;\n"
"ninja</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/gnome/platform/gnome-settings-daemon.xml:157
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr --buildtype=release .. &amp;&amp;\n"
"ninja</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/platform/gnome-settings-daemon.xml:181
#, xml-text
msgid "This package does not come with a working test suite."
