#, xml-text
msgid "Installation of Totem PL Parser"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/platform/totem-pl-parser.xml:99
#, xml-text
msgid ""
"Install <application>Totem PL Parser</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/gnome/platform/totem-pl-parser.xml:103
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr --buildtype=release .. &amp;&amp;\n"
"ninja</userinput>"
msgstr ""

#.  It seems caused by geolocation-dependant resolving in
#.            iTunes.
#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/platform/totem-pl-parser.xml:110
#, xml-text
msgid ""
"To test the results, issue: <command>ninja test</command>.  The test named "
"<filename>parser</filename> is known to fail."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/platform/totem-pl-parser.xml:117
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/gnome/platform/totem-pl-parser.xml:120
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr ""

