#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/gnome/platform/gnome-session.xml:94
#, xml-text
msgid "Installation of GNOME Session"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/platform/gnome-session.xml:118
#, xml-text
msgid ""
"Install <application>GNOME Session</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/gnome/platform/gnome-session.xml:122
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr              \\\n"
"            --buildtype=release        \\\n"
"            -D man=false               \\\n"
"            -D docbook=false           \\\n"
"            -D systemduserunitdir=/tmp \\\n"
"            ..                         &amp;&amp;\n"
"ninja</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/gnome/platform/gnome-session.xml:133
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr              \\\n"
"            --buildtype=release        \\\n"
"            -D man=false               \\\n"
"            -D docbook=false           \\\n"
"            ..                         &amp;&amp;\n"
"ninja</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/platform/gnome-session.xml:144
#, xml-text
msgid "This package does not come with a test suite."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/platform/gnome-session.xml:148
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/gnome/platform/gnome-session.xml:151
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/platform/gnome-session.xml:154
#, xml-text
msgid "If you generated the documentation, move it to a versioned directory:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/gnome/platform/gnome-session.xml:157
#, no-wrap, xml-text
msgid ""
"<userinput>mv -v /usr/share/doc/gnome-session{,-&gnome-session-"
"version;}</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/platform/gnome-session.xml:164
#, xml-text
msgid ""
"This package creates two Xorg based <filename>.desktop</filename> files in "
"the <filename class=\"directory\">/usr/share/xsessions/</filename> "
"directory, and two Wayland based <filename>.desktop</filename> files in the "
"<filename class=\"directory\">/usr/share/wayland-sessions/</filename> "
"directory.  Only one is needed in each directory on a BLFS system, so "
"prevent the extra files showing up as options in a display manager.  As the "
"&root; user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/gnome/platform/gnome-session.xml:173
#, no-wrap, xml-text
msgid ""
"<userinput>rm -fv /usr/share/xsessions/gnome.desktop &amp;&amp;\n"
"rm -v /usr/share/wayland-sessions/gnome.desktop</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/platform/gnome-session.xml:177
#, xml-text
msgid ""
"Now, as the <systemitem class=\"username\">root</systemitem> user, remove "
"systemd units that are useless on SysV systems:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/gnome/platform/gnome-session.xml:181
#, no-wrap, xml-text
msgid "<userinput>rm -rv /tmp/{*.d,*.target,*.service}</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/platform/gnome-session.xml:186
#, xml-text
msgid ""
"The startup sequence of gnome-wayland needs to create a dbus session.  On "
"SysV, this has to be added to the shipped <filename>gnome-"
"wayland.desktop</filename> file, which is written for systemd. As the &root;"
" user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/gnome/platform/gnome-session.xml:192
#, no-wrap, xml-text
msgid ""
"<userinput>sed -e 's@^Exec=@&amp;/usr/bin/dbus-run-session @' \\\n"
"    -i /usr/share/wayland-sessions/gnome-wayland.desktop</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/gnome/platform/gnome-session.xml:198
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/platform/gnome-session.xml:204
#, xml-text
msgid ""
"<parameter>-D man=false -D docbook=false</parameter>: These parameters "
"disable building documentation. Omit them if you have built the optional "
"dependencies."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/platform/gnome-session.xml:218
#, xml-text
msgid ""
"<option>-D x11=true</option>: This option enables support for X11 sessions. "
"X11 support is deprecated and will be removed in GNOME 50."
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/gnome/platform/gnome-session.xml:225
#, xml-text
msgid "Starting GNOME"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/platform/gnome-session.xml:228
#, xml-text
msgid ""
"The easiest way to start GNOME is to use a display manager.  <xref "
"linkend=\"gdm\"/> is the recommended display manager."
msgstr ""

#.  Bruce discovered the above regarding gdm/gnome-session. The GDM page
#.       now covers using Wayland on systems with NVIDIA cards as well, so
#. I've
#.       commented the text below.
#. One reason to start from the command line is if you want Wayland
#.       support on a system that has the proprietary NVIDIA driver installed,
#.       since GDM will not show the Wayland session type on such a system.
#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/platform/gnome-session.xml:233
#, xml-text
msgid ""
"It is also possible to start <application>GNOME</application> from the "
"command line. However, you must still have <xref linkend=\"gdm\"/> installed"
" for the desktop to work. In previous releases of GNOME, gnome-shell would "
"start without it installed, but this changed in 48.0. GDM does not need to "
"be enabled to start gnome-shell from the command line."
msgstr ""

#. type: Content of: <sect1><sect2><warning><para>
#: blfs-en/blfs-git/gnome/platform/gnome-session.xml:248
#, xml-text
msgid ""
"X11 support is deprecated and will be removed in GNOME 50. Please use the "
"Wayland session wherever possible."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/platform/gnome-session.xml:254
#, xml-text
msgid ""
"To start <application>GNOME</application> using <xref role=\"nodep\" "
"linkend=\"xinit\"/>, run the following commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/gnome/platform/gnome-session.xml:258
#, no-wrap, xml-text
msgid ""
"<userinput>cat &gt; ~/.xinitrc &lt;&lt; \"EOF\"\n"
"<literal>dbus-run-session gnome-session</literal>\n"
"EOF\n"
"\n"
"startx</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/platform/gnome-session.xml:265
#, xml-text
msgid ""
"Alternatively, to start <application>GNOME</application> with Wayland "
"support, run the following command:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/gnome/platform/gnome-session.xml:269
#, no-wrap, xml-text
msgid ""
"<userinput>XDG_SESSION_TYPE=wayland dbus-run-session gnome-"
"session</userinput>"
msgstr ""

