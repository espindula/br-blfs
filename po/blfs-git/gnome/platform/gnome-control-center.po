#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/blfs-git/gnome/platform/gnome-control-center.xml:70
#, xml-text
msgid "GNOME Control Center Dependencies"
msgstr ""

#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/blfs-git/gnome/platform/gnome-control-center.xml:72
#, xml-text
msgid "Required"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/platform/gnome-control-center.xml:74
#, xml-text
msgid ""
"<xref linkend=\"accountsservice\"/>, <xref linkend=\"blueprint-compiler\"/>,"
" <xref linkend=\"colord-gtk\"/>, <xref linkend=\"cups\"/>, <xref "
"linkend=\"gnome-bluetooth\"/>, <xref linkend=\"gnome-online-accounts\"/>, "
"<xref linkend=\"gnome-settings-daemon\"/>, <xref linkend=\"gsound\"/>, <xref"
" linkend=\"libadwaita1\"/>, <xref linkend=\"libgtop\"/>, <xref "
"linkend=\"libnma\"/>, <xref linkend=\"libpwquality\"/>, <xref "
"linkend=\"mitkrb\"/>, <xref linkend=\"ModemManager\"/>, <xref "
"linkend=\"samba\"/>, <xref linkend=\"shared-mime-info\"/>, <xref "
"linkend=\"tecla\"/>, and <xref linkend=\"udisks2\"/>"
msgstr ""

#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/blfs-git/gnome/platform/gnome-control-center.xml:94
#, xml-text
msgid "Recommended"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/platform/gnome-control-center.xml:96
#, xml-text
msgid "<xref linkend=\"ibus\"/>"
msgstr ""

#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/blfs-git/gnome/platform/gnome-control-center.xml:99
#, xml-text
msgid "Optional"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/platform/gnome-control-center.xml:101
#, xml-text
msgid ""
"<command>Xvfb</command> (from <xref linkend='xorg-server'/> or <xref "
"role='nodep' linkend='xwayland'/>) and <xref linkend=\"python-dbusmock\"/> "
"(both for tests)"
msgstr ""

#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/blfs-git/gnome/platform/gnome-control-center.xml:108
#, xml-text
msgid "Recommended (Runtime)"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/platform/gnome-control-center.xml:110
#, xml-text
msgid "<xref linkend=\"blocaled\" role=\"runtime\"/>"
msgstr ""

#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/blfs-git/gnome/platform/gnome-control-center.xml:113
#, xml-text
msgid "Optional Runtime Dependencies"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/platform/gnome-control-center.xml:115
#, xml-text
msgid ""
"<xref role=\"runtime\" linkend=\"cups-pk-helper\"/> (Printers panel), <xref "
"role=\"runtime\" linkend=\"gnome-color-manager\"/> (Color panel), <xref "
"role=\"runtime\" linkend=\"gnome-shell\"/> (Applications panel), and <xref "
"role=\"runtime\" linkend=\"sound-theme-freedesktop\"/> (Additional Sound "
"Effects in Sound panel)"
msgstr ""

#. type: Content of: <sect1><sect2><note><para>
#: blfs-en/blfs-git/gnome/platform/gnome-control-center.xml:123
#, xml-text
msgid ""
"Recommended dependencies are not strictly required for this package to build"
" and function, but you may not get expected results at runtime if you don't "
"install them."
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/gnome/platform/gnome-control-center.xml:132
#, xml-text
msgid "Installation of GNOME Control Center"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/platform/gnome-control-center.xml:135
#, xml-text
msgid ""
"Install <application>GNOME Control Center</application> by running the "
"following commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/gnome/platform/gnome-control-center.xml:139
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr --buildtype=release .. &amp;&amp;\n"
"ninja</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/platform/gnome-control-center.xml:148
#, xml-text
msgid ""
"To test the results, issue: <command>GTK_A11Y=none ninja test</command>. "
"Note that you must have the <application>python-dbusmock</application> "
"module installed in order for the tests to complete successfully."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/platform/gnome-control-center.xml:155
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/gnome/platform/gnome-control-center.xml:158
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/gnome/platform/gnome-control-center.xml:163
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/platform/gnome-control-center.xml:169
#, xml-text
msgid ""
"<option>-D ibus=false</option>: Use this switch if you have not installed "
"the recommended <application>IBus</application> dependency."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/platform/gnome-control-center.xml:174
#, xml-text
msgid ""
"<option>-D x11=true</option>: Use this switch to enable support for X11.  "
"Note that this is deprecated by upstream and will be removed in GNOME 50."
msgstr ""

