#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/gnome/platform/gcr.xml:98
#, xml-text
msgid "Installation of Gcr"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/platform/gcr.xml:101
#, xml-text
msgid "First, apply a fix for building without OpenSSH installed:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/gnome/platform/gcr.xml:104
#, no-wrap, xml-text
msgid "<userinput>sed '/ssh.add/d; /ssh.agent/d' -i meson.build</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/platform/gcr.xml:107
#, xml-text
msgid ""
"Install <application>Gcr</application> by running the following commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/gnome/platform/gcr.xml:111
#, no-wrap, xml-text
msgid ""
"<userinput>sed -i 's:\"/desktop:\"/org:' schema/*.xml &amp;&amp;\n"
"\n"
"mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr       \\\n"
"            --buildtype=release \\\n"
"            -D gtk_doc=false    \\\n"
"            -D ssh_agent=false  \\\n"
"            ..                  &amp;&amp;\n"
"ninja</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/platform/gcr.xml:124
#, xml-text
msgid ""
"If you have <xref linkend='gi-docgen'/> installed and wish to build the API "
"documentation for this package, issue:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/gnome/platform/gcr.xml:128
#, no-wrap, xml-text
msgid ""
"<userinput>sed -e \"/install_dir/s@,\\$@ / 'gcr-&gcr-version;'&amp;@\" \\\n"
"    -i ../docs/*/meson.build                  &amp;&amp;\n"
"meson configure -D gtk_doc=true               &amp;&amp;\n"
"ninja</userinput>"
msgstr ""

#.  One test,
#.       "test-openssl 3", is known to fail.
#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/platform/gcr.xml:134
#, xml-text
msgid ""
"To test the results, issue: <command>ninja test</command>.  The tests must "
"be run from an X Terminal or similar."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/platform/gcr.xml:140
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/gnome/platform/gcr.xml:143
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/gnome/platform/gcr.xml:147
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/platform/gcr.xml:182
#, xml-text
msgid ""
"<parameter>-D ssh_agent=false</parameter>: Disable the ssh-agent "
"implementation from this package. This implementation is intended to replace"
" the ssh-agent implementation of <xref linkend='gnome-keyring'/>, but the "
"replacement still has several unresolved issues."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/platform/gcr.xml:190
#, xml-text
msgid ""
"<option>-D gtk=false</option>: Use this switch if you haven't installed "
"<xref linkend=\"gtk3\"/>. Note that <application>gcr-viewer</application> "
"will not be installed if this is option is used."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/platform/gcr.xml:197
#, xml-text
msgid "<option>-D gtk_doc=true</option>: &gi-doc-disable;"
msgstr ""

