#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/gnome/platform/geocode-glib.xml:93
#, xml-text
msgid "Installation of Geocode GLib"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/platform/geocode-glib.xml:96
#, xml-text
msgid ""
"Install <application>Geocode GLib</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/gnome/platform/geocode-glib.xml:100
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build                   &amp;&amp;\n"
"cd    build                   &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr           \\\n"
"            --buildtype=release     \\\n"
"            -D enable-gtk-doc=false \\\n"
"            -D soup2=false          \\\n"
"            ..                      &amp;&amp;\n"
"ninja</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/platform/geocode-glib.xml:112
#, xml-text
msgid ""
"To test the results, issue: <command>LANG=C ninja test</command>.  One test "
"fails because it needs the <literal>sv_SE.utf8</literal> locale, which is "
"not installed by default in LFS."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/platform/geocode-glib.xml:118
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/gnome/platform/geocode-glib.xml:121
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/gnome/platform/geocode-glib.xml:126
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/platform/geocode-glib.xml:132
#, xml-text
msgid ""
"<parameter>-D enable-gtk-doc=false</parameter>: Allow this package to be "
"built without <xref linkend=\"gtk-doc\" role=\"nodep\"/>. Remove this "
"parameter if <xref linkend=\"gtk-doc\" role=\"nodep\"/> is installed and you"
" wish to rebuild and install the API documentation."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/platform/geocode-glib.xml:139
#, xml-text
msgid ""
"<parameter>-D soup2=false</parameter>: This switch forces this package to "
"use libsoup-3 for HTTP requests instead of libsoup-2. The packages in BLFS "
"that use geocode-glib now expect libsoup-3 to be used."
msgstr ""

