msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/gnome/platform/vte.xml:103
#, xml-text
msgid "Installation of VTE"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/platform/vte.xml:106
#, xml-text
msgid ""
"Install <application>VTE</application> by running the following commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/gnome/platform/vte.xml:110
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr --buildtype=release .. &amp;&amp;\n"
"ninja</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/gnome/platform/vte.xml:116
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr       \\\n"
"            --buildtype=release \\\n"
"            -D _systemd=false   &amp;&amp;\n"
"ninja</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/platform/vte.xml:125
#, xml-text
msgid ""
"If you have <xref linkend='gi-docgen'/> installed and wish to build the API "
"documentation for this package, issue:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/gnome/platform/vte.xml:129
#, no-wrap, xml-text
msgid ""
"<userinput>sed -e \"/docdir =/s@\\$@/ 'vte-&vte-version;'@\" \\\n"
"    -i ../doc/reference/meson.build     &amp;&amp;\n"
"meson configure -D docs=true            &amp;&amp;\n"
"ninja</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/platform/vte.xml:135
#, xml-text
msgid "To test the results, issue <command>ninja test</command>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/platform/vte.xml:139
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/gnome/platform/vte.xml:142
#, no-wrap, xml-text
msgid ""
"<userinput>ninja install &amp;&amp;\n"
"rm -v /etc/profile.d/vte.*</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/gnome/platform/vte.xml:148
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/platform/vte.xml:154
#, xml-text
msgid ""
"<command>rm -v /etc/profile.d/vte.*</command>: This command removes two "
"files installed in /etc/profile.d that have no use on a LFS system."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/platform/vte.xml:159
#, xml-text
msgid ""
"<option>-D gnutls=false</option>: Add this switch if you do not want to "
"enable GnuTLS support."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/platform/vte.xml:164
#, xml-text
msgid ""
"<option>-D vapi=false</option>: Add this switch if you do not want to enable"
" vala bindings."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/gnome/platform/vte.xml:169
#, xml-text
msgid ""
"<option>-D gtk4=false</option>: Add this switch if you do not want to build "
"the GTK-4 version of VTE."
msgstr ""

