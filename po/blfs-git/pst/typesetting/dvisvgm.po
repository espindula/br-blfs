#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/pst/typesetting/dvisvgm.xml:107
#, xml-text
msgid "Installation of dvisvgm"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/pst/typesetting/dvisvgm.xml:120
#, xml-text
msgid ""
"The test suite assumes that a modern version of "
"<application>Python</application> has been installed as plain "
"<command>python</command>. Changing this to use <command>python3</command> "
"requires a sed to one <filename>Makefile.in</filename> file."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/pst/typesetting/dvisvgm.xml:127
#, xml-text
msgid ""
"Install <application>dvisvgm</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/pst/typesetting/dvisvgm.xml:131
#, no-wrap, xml-text
msgid ""
"<userinput>TEXARCH=$(uname -m | sed -e 's/i.86/i386/' -e 's/$/-linux/') &amp;&amp;\n"
"\n"
"sed -i 's/python/&amp;3/' tests/Makefile.in         &amp;&amp;\n"
"./configure                                     \\\n"
"    --bindir=$TEXLIVE_PREFIX/bin/${TEXARCH}     \\\n"
"    --mandir=$TEXLIVE_PREFIX/texmf-dist/doc/man \\\n"
"    --with-kpathsea=$TEXLIVE_PREFIX             &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/pst/typesetting/dvisvgm.xml:141
#, xml-text
msgid "To test the results, issue: <command>make check</command>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/pst/typesetting/dvisvgm.xml:145
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/pst/typesetting/dvisvgm.xml:148
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/pst/typesetting/dvisvgm.xml:153
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/pst/typesetting/dvisvgm.xml:177
#, xml-text
msgid ""
"<parameter>--with-kpathsea=$TEXLIVE_PREFIX</parameter>: This allows the "
"build system to find the headers for <filename "
"class=\"libraryfile\">kpathsea</filename>"
msgstr ""

