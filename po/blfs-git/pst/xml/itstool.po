#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/pst/xml/itstool.xml:92
#, xml-text
msgid "Installation of itstool"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/pst/xml/itstool.xml:95
#, xml-text
msgid ""
"First, apply a patch to use <xref linkend='lxml'/> for handling the XML "
"files instead of the deprecated (disabled by default) Python module from "
"<xref linkend='libxml2'/>:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/pst/xml/itstool.xml:100
#, no-wrap, xml-text
msgid ""
"<userinput>patch -Np1 -i ../itstool-&itstool-"
"version;-lxml-1.patch</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/pst/xml/itstool.xml:103
#, xml-text
msgid ""
"Install <application>itstool</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/pst/xml/itstool.xml:107
#, no-wrap, xml-text
msgid ""
"<userinput>PYTHON=/usr/bin/python3 ./autogen.sh --prefix=/usr &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/pst/xml/itstool.xml:111
#, xml-text
msgid ""
"To test the results, issue: <command>python3 tests/run_tests.py</command>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/pst/xml/itstool.xml:115
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/pst/xml/itstool.xml:118
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr ""

