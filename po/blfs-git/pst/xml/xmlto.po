#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/pst/xml/xmlto.xml:105
#, xml-text
msgid "Installation of xmlto"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/pst/xml/xmlto.xml:108
#, xml-text
msgid ""
"Install <application>xmlto</application> by running the following commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/pst/xml/xmlto.xml:112
#, no-wrap, xml-text
msgid ""
"<userinput>autoreconf -fiv                                  &amp;&amp;\n"
"LINKS=\"/usr/bin/links\" ./configure --prefix=/usr &amp;&amp;\n"
"\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/pst/xml/xmlto.xml:118
#, xml-text
msgid "To test the results, issue: <command>make check</command>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/pst/xml/xmlto.xml:122
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/pst/xml/xmlto.xml:125
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/pst/xml/xmlto.xml:130
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/pst/xml/xmlto.xml:133
#, xml-text
msgid ""
"<envar>LINKS=\"/usr/bin/links\"</envar>: This environment variable fixes a "
"bug causing <command>xmlto</command> to think that <command>links</command> "
"command is the same as <command>elinks</command>. Setting this variable does"
" not cause problems if <xref linkend=\"Links\"/> is not installed, unless "
"you have <ulink url=\"http://elinks.or.cz/\">ELinks</ulink> installed, and "
"you wish to use it for text backend post-processing. If you do wish to "
"ELinks, you should remove this environment variable."
msgstr ""

