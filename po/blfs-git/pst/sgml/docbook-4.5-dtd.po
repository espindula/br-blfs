#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/pst/sgml/docbook-4.5-dtd.xml:85
#, xml-text
msgid "Installation of DocBook-4.5 SGML DTD"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/pst/sgml/docbook-4.5-dtd.xml:91
#, xml-text
msgid ""
"Install <application>DocBook-4.5 SGML DTD</application> by running the "
"following commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/pst/sgml/docbook-4.5-dtd.xml:95
#, no-wrap, xml-text
msgid ""
"<userinput>sed -i -e '/ISO 8879/d' \\\n"
"       -e '/gml/d' docbook.cat</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/pst/sgml/docbook-4.5-dtd.xml:99
#, xml-text
msgid "This package does not come with a test suite."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/pst/sgml/docbook-4.5-dtd.xml:103
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/pst/sgml/docbook-4.5-dtd.xml:106
#, no-wrap, xml-text
msgid ""
"<userinput>install -v -d /usr/share/sgml/docbook/sgml-dtd-&docbook-4.5-dtd-version; &amp;&amp;\n"
"chown -R root:root . &amp;&amp;\n"
"\n"
"install -v docbook.cat /usr/share/sgml/docbook/sgml-dtd-&docbook-4.5-dtd-version;/catalog &amp;&amp;\n"
"cp -v -af *.dtd *.mod *.dcl /usr/share/sgml/docbook/sgml-dtd-&docbook-4.5-dtd-version; &amp;&amp;\n"
"\n"
"install-catalog --add /etc/sgml/sgml-docbook-dtd-&docbook-4.5-dtd-version;.cat \\\n"
"    /usr/share/sgml/docbook/sgml-dtd-&docbook-4.5-dtd-version;/catalog &amp;&amp;\n"
"\n"
"install-catalog --add /etc/sgml/sgml-docbook-dtd-&docbook-4.5-dtd-version;.cat \\\n"
"    /etc/sgml/sgml-docbook.cat</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/pst/sgml/docbook-4.5-dtd.xml:121
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/pst/sgml/docbook-4.5-dtd.xml:124
#, xml-text
msgid ""
"<command>sed -i -e '/ISO 8879/d' -e '/gml/d' docbook.cat</command>: This "
"command removes the ENT definitions from the catalog file."
msgstr ""

