#: blfs-en/blfs-git/pst/sgml/docbook-3.1-dtd.xml:155
#, xml-text
msgid "Configuration Information"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/blfs-git/pst/sgml/docbook-3.1-dtd.xml:158
#, xml-text
msgid "The above installation script updates the catalog."
msgstr ""

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/blfs-git/pst/sgml/docbook-3.1-dtd.xml:162
#, xml-text
msgid ""
"Using only the most current 3.x version of <application>DocBook SGML "
"DTD</application> requires the following (perform as the <systemitem "
"class=\"username\">root</systemitem> user):"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><screen>
#: blfs-en/blfs-git/pst/sgml/docbook-3.1-dtd.xml:167
#, no-wrap, xml-text
msgid ""
"<userinput>cat &gt;&gt; /usr/share/sgml/docbook/sgml-dtd-&docbook-3.1-dtd-version;/catalog &lt;&lt; \"EOF\"\n"
"<literal>  -- Begin Single Major Version catalog changes --\n"
"\n"
"PUBLIC \"-//Davenport//DTD DocBook V3.0//EN\" \"docbook.dtd\"\n"
"\n"
"  -- End Single Major Version catalog changes --</literal>\n"
"EOF</userinput>"
msgstr ""

