#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/pst/sgml/docbook-3.1-dtd.xml:85
#, xml-text
msgid "Installation of DocBook-3.1 SGML DTD"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/pst/sgml/docbook-3.1-dtd.xml:91
#, xml-text
msgid ""
"Install <application>DocBook-3.1 SGML DTD</application> by running the "
"following commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/pst/sgml/docbook-3.1-dtd.xml:95
#, no-wrap, xml-text
msgid ""
"<userinput>sed -i -e '/ISO 8879/d' \\\n"
"       -e 's|DTDDECL \"-//OASIS//DTD DocBook V&docbook-3.1-dtd-version;//EN\"|SGMLDECL|g' \\\n"
"       docbook.cat</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/pst/sgml/docbook-3.1-dtd.xml:100
#, xml-text
msgid "This package does not come with a test suite."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/pst/sgml/docbook-3.1-dtd.xml:104
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/pst/sgml/docbook-3.1-dtd.xml:107
#, no-wrap, xml-text
msgid ""
"<userinput>install -v -d -m755 /usr/share/sgml/docbook/sgml-dtd-&docbook-3.1-dtd-version; &amp;&amp;\n"
"chown -R root:root . &amp;&amp;\n"
"install -v docbook.cat /usr/share/sgml/docbook/sgml-dtd-&docbook-3.1-dtd-version;/catalog &amp;&amp;\n"
"cp -v -af *.dtd *.mod *.dcl /usr/share/sgml/docbook/sgml-dtd-&docbook-3.1-dtd-version; &amp;&amp;\n"
"\n"
"install-catalog --add /etc/sgml/sgml-docbook-dtd-&docbook-3.1-dtd-version;.cat \\\n"
"    /usr/share/sgml/docbook/sgml-dtd-&docbook-3.1-dtd-version;/catalog &amp;&amp;\n"
"\n"
"install-catalog --add /etc/sgml/sgml-docbook-dtd-&docbook-3.1-dtd-version;.cat \\\n"
"    /etc/sgml/sgml-docbook.cat</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/pst/sgml/docbook-3.1-dtd.xml:121
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/pst/sgml/docbook-3.1-dtd.xml:124
#, xml-text
msgid ""
"<command>sed -i -e '/ISO 8879/d' docbook.cat</command>: This command removes"
" the ENT definitions from the catalog file."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/pst/sgml/docbook-3.1-dtd.xml:129
#, xml-text
msgid ""
"<command>sed -i -e 's|DTDDECL \"-//OASIS//DTD Docbook V&docbook-3.1-dtd-"
"version;//EN\"|SGMLDECL|g' docbook.cat</command>: This command replaces the "
"DTDDECL catalog entry, which is not supported by Linux SGML tools, with the "
"SGMLDECL catalog entry."
msgstr ""

