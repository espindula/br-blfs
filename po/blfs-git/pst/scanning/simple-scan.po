#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/pst/scanning/simple-scan.xml:84
#, xml-text
msgid "Installation of Simple-scan"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/pst/scanning/simple-scan.xml:87
#, xml-text
msgid ""
"Install <application>Simple-scan</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/pst/scanning/simple-scan.xml:91
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr --buildtype=release .. &amp;&amp;\n"
"ninja</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/pst/scanning/simple-scan.xml:98
#, xml-text
msgid "This package does not come with a test suite."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/pst/scanning/simple-scan.xml:102
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/pst/scanning/simple-scan.xml:105
#, no-wrap, xml-text
msgid ""
"<userinput>ninja install &amp;&amp;\n"
"gtk-update-icon-cache -qtf /usr/share/icons/hicolor</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/pst/scanning/simple-scan.xml:111
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/pst/scanning/simple-scan.xml:117
#, xml-text
msgid ""
"<command>gtk-update-icon-cache [...]</command>: This command updates the "
"system-wide GTK+ icon cache since Simple-scan's build system does not update"
" it to account for the icons that it installs."
msgstr ""

