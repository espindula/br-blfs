#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/pst/ps/paps.xml:88
#, xml-text
msgid "Installation of paps"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/pst/ps/paps.xml:92
#, xml-text
msgid "First fix a problem with glib-2.81.0 or later:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/pst/ps/paps.xml:95
#, no-wrap, xml-text
msgid ""
"<userinput>sed -i -r 's/g_utf8_(next|offset)/(char*) &amp;/' "
"src/paps.cc</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/pst/ps/paps.xml:98
#, xml-text
msgid ""
"Install <application>paps</application> by running the following commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/pst/ps/paps.xml:102
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr    \\\n"
"            --disable-Werror \\\n"
"            --mandir=/usr/share/man &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/pst/ps/paps.xml:108
#, xml-text
msgid "This package does not come with a test suite."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/pst/ps/paps.xml:112
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/pst/ps/paps.xml:115
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr ""

