#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/pst/ps/mupdf.xml:117
#, xml-text
msgid "Installation of MuPDF"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/pst/ps/mupdf.xml:120
#, xml-text
msgid ""
"Install <application>MuPDF</application> by running the following commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/pst/ps/mupdf.xml:124
#, no-wrap, xml-text
msgid ""
"<userinput>cat &gt; user.make &lt;&lt; EOF &amp;&amp;\n"
"USE_SYSTEM_FREETYPE := yes\n"
"USE_SYSTEM_HARFBUZZ := yes\n"
"USE_SYSTEM_JBIG2DEC := no\n"
"USE_SYSTEM_JPEGXR := no # not used without HAVE_JPEGXR\n"
"USE_SYSTEM_LCMS2 := no # lcms2mt is strongly preferred\n"
"USE_SYSTEM_LIBJPEG := yes\n"
"USE_SYSTEM_MUJS := no # build needs source anyway\n"
"USE_SYSTEM_OPENJPEG := yes\n"
"USE_SYSTEM_ZLIB := yes\n"
"USE_SYSTEM_GLUT := yes\n"
"USE_SYSTEM_CURL := yes\n"
"USE_SYSTEM_GUMBO := no\n"
"EOF\n"
"\n"
"export XCFLAGS=-fPIC                      &amp;&amp;\n"
"make build=release shared=yes verbose=yes &amp;&amp;\n"
"unset XCFLAGS</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/pst/ps/mupdf.xml:144
#, xml-text
msgid "This package does not come with a test suite."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/pst/ps/mupdf.xml:148
#, xml-text
msgid "Now, as the &root; user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/pst/ps/mupdf.xml:151
#, no-wrap, xml-text
msgid ""
"<userinput>make prefix=/usr                         \\\n"
"     shared=yes                          \\\n"
"     docdir=/usr/share/doc/mupdf-&mupdf-version; \\\n"
"     install                             &amp;&amp;\n"
"\n"
"ln -sfv libmupdf.so.&mupdf-lib-major; /usr/lib/libmupdf.so.&mupdf-lib-minor; &amp;&amp;\n"
"ln -sfv libmupdf.so.&mupdf-lib-minor;   /usr/lib/libmupdf.so     &amp;&amp;\n"
"chmod 755 /usr/lib/libmupdf.so.&mupdf-lib-major;              &amp;&amp;\n"
"\n"
"ln -sfv mupdf-x11 /usr/bin/mupdf</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/pst/ps/mupdf.xml:165
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/pst/ps/mupdf.xml:168
#, xml-text
msgid ""
"<command>ln -sfv mupdf-x11 /usr/bin/mupdf </command>: This symbolic link "
"chooses between <command>mupdf-gl</command> and <command>mupdf-x11</command>"
" when running <command>mupdf</command>."
