#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/blfs-git/pst/ps/epdfview.xml:74
#, xml-text
msgid "ePDFView Dependencies"
msgstr ""

#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/blfs-git/pst/ps/epdfview.xml:76
#, xml-text
msgid "Required"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/pst/ps/epdfview.xml:78
#, xml-text
msgid "<xref linkend=\"gtk3\"/> and <xref linkend=\"poppler\"/>"
msgstr ""

#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/blfs-git/pst/ps/epdfview.xml:82
#, xml-text
msgid "Recommended"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/pst/ps/epdfview.xml:84
#, xml-text
msgid ""
"<xref linkend=\"cups\"/> (to access print queues), <xref linkend=\"desktop-"
"file-utils\"/>, and <xref linkend=\"hicolor-icon-theme\"/> (both for the "
"icons this installs)"
msgstr ""

#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/blfs-git/pst/ps/epdfview.xml:89
#, xml-text
msgid "Optional"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/pst/ps/epdfview.xml:91
#, xml-text
msgid ""
"The home page of the project's repository mentions that there are optional "
"dependencies, which are enabled by switches. These are for building the "
"documentation and running the test suite, <xref linkend=\"doxygen\"/> and "
"<ulink url='https://freedesktop.org/wiki/Software/cppunit/'>Cppunit</ulink>."
"  Note that <application>doxygen</application> only installs a skeletal page"
" about itself, which contains no package documentation, and the test code "
"does not compile with recent versions of C++."
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/pst/ps/epdfview.xml:103
#, xml-text
msgid "Installation of ePDFView-gtk3"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/pst/ps/epdfview.xml:106
#, xml-text
msgid ""
"Install <application>ePDFView-gtk3</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/pst/ps/epdfview.xml:110
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr           \\\n"
"            --buildtype=release     \\\n"
"            -D enable-printing=true \\\n"
"            ..                      &amp;&amp;\n"
"ninja</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/pst/ps/epdfview.xml:120
#, xml-text
msgid "This package does not come with a buildable test suite."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/pst/ps/epdfview.xml:124
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/pst/ps/epdfview.xml:127
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/pst/ps/epdfview.xml:135
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/pst/ps/epdfview.xml:137
#, xml-text
msgid ""
"<command>-D enable-printing=true</command>: builds the code to link to the "
"<application>cups</application> print queue(s). Omit this if you have not "
"installed <application>cups</application>."
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/pst/ps/epdfview.xml:144
#, xml-text
msgid "Configuring ePDFView-gtk3"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/pst/ps/epdfview.xml:147
#, xml-text
msgid ""
"ePDFView-gtk3 has several keyboard hotkeys for optional features. Most of "
"them are 'off' by default, including the toolbar, and if it has been closed "
"with the menu disabled, the program can start with all options not being "
"visible until the relevant function keys are pressed."
msgstr ""

#. type: Content of: <sect1><sect2><para><itemizedlist><listitem><para>
#: blfs-en/blfs-git/pst/ps/epdfview.xml:153
#, xml-text
msgid "[F6] - toggle toolbar"
msgstr ""

#. type: Content of: <sect1><sect2><para><itemizedlist><listitem><para>
#: blfs-en/blfs-git/pst/ps/epdfview.xml:156
#, xml-text
msgid "[F7] - toggle menu"
msgstr ""

#. type: Content of: <sect1><sect2><para><itemizedlist><listitem><para>
#: blfs-en/blfs-git/pst/ps/epdfview.xml:159
#, xml-text
