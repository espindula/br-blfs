#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/pst/printing/libppd.xml:83
#, xml-text
msgid ""
"Install <application>libppd</application> by running the following commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/pst/printing/libppd.xml:87
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr                \\\n"
"            --disable-static             \\\n"
"            --with-cups-rundir=/run/cups \\\n"
"            --enable-ppdc-utils          \\\n"
"            --docdir=/usr/share/doc/libppd-&libppd-version; &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/pst/printing/libppd.xml:95
#, xml-text
msgid "To test the results, issue <command>make check</command>."
