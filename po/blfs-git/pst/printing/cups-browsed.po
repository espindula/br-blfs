#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/pst/printing/cups-browsed.xml:88
#, xml-text
msgid "Installation of cups-browsed"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/pst/printing/cups-browsed.xml:91
#, xml-text
msgid ""
"Install <application>cups-browsed</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/pst/printing/cups-browsed.xml:95
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr                \\\n"
"            --with-cups-rundir=/run/cups \\\n"
"            --without-rcdir              \\\n"
"            --disable-static             \\\n"
"            --docdir=/usr/share/doc/cups-browsed-&cups-browsed-version; &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/pst/printing/cups-browsed.xml:107
#, xml-text
msgid "This package does not come with a functional test suite."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/pst/printing/cups-browsed.xml:111
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/pst/printing/cups-browsed.xml:114
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/pst/printing/cups-browsed.xml:117
#, xml-text
msgid ""
"Install the systemd unit by running the following command as the <systemitem"
" class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/pst/printing/cups-browsed.xml:121
#, no-wrap, xml-text
msgid ""
"<userinput>install -v -m644 daemon/cups-browsed.service "
"/lib/systemd/system/cups-browsed.service</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/pst/printing/cups-browsed.xml:126
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/pst/printing/cups-browsed.xml:132
#, xml-text
msgid ""
"<parameter>--with-cups-rundir=/run/cups</parameter>: Defines the directory "
"containing transient printing data. The default <filename "
"class=\"directory\">/var/run/cups</filename> is obsolete."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/pst/printing/cups-browsed.xml:138
#, xml-text
msgid ""
"<parameter>--without-rcdir</parameter>: This switch disables installation of"
" the bundled bootscript which is not compatible with BLFS."
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/pst/printing/cups-browsed.xml:147
#, xml-text
msgid "Configuring cups-browsed"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><title>
#: blfs-en/blfs-git/pst/printing/cups-browsed.xml:150
#, xml-text
msgid "Systemd Unit"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/blfs-git/pst/printing/cups-browsed.xml:153
#, xml-text
msgid ""
"To start the <command>cups-browsed</command> daemon at boot, enable the "
"previously installed systemd unit by running the following command as the "
"<systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><screen>
#: blfs-en/blfs-git/pst/printing/cups-browsed.xml:162
#, no-wrap, xml-text
msgid "<userinput>systemctl enable cups-browsed</userinput>"
msgstr ""

