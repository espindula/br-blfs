#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/pst/printing/cups-filters.xml:98
#, xml-text
msgid "Installation of CUPS Filters"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/pst/printing/cups-filters.xml:101
#, xml-text
msgid "First, fix a problem when building with gcc-15:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/pst/printing/cups-filters.xml:104
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"pre\">sed -i '/proc_func)()/s/()/(FILE*, FILE*, void*)/' "
"filter/foomatic-rip/process.h</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/pst/printing/cups-filters.xml:107
#, xml-text
msgid "Next, fix a security vulnerability:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/pst/printing/cups-filters.xml:110
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"pre\">patch -Np1 -i ../cups-filters-&cups-filters-"
"version;-security_fix-1.patch</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/pst/printing/cups-filters.xml:113
#, xml-text
msgid ""
"Install <application>CUPS Filters</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/pst/printing/cups-filters.xml:117
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr    \\\n"
"            --disable-static \\\n"
"            --docdir=/usr/share/doc/cups-filters-&cups-filters-version; &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/pst/printing/cups-filters.xml:123
#, xml-text
msgid "This package does not come with a functional test suite."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/pst/printing/cups-filters.xml:127
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/pst/printing/cups-filters.xml:130
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr ""

