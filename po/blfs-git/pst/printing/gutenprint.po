#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/pst/printing/gutenprint.xml:140
#, xml-text
msgid "Installation of Gutenprint"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/pst/printing/gutenprint.xml:143
#, xml-text
msgid ""
"Install <application>Gutenprint</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/pst/printing/gutenprint.xml:147
#, no-wrap, xml-text
msgid ""
"<userinput>sed -i 's|$(PACKAGE)/doc|doc/$(PACKAGE)-$(VERSION)|' \\\n"
"       {,doc/,doc/developer/}Makefile.in &amp;&amp;\n"
"\n"
"./configure --prefix=/usr    \\\n"
"            --disable-static \\\n"
"            --without-gimp2  \\\n"
"            --without-gimp2-as-gutenprint &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. (one test, rastertogutenprint failed because the
#.       CUPS ppds are for a previous version. Maybe genppds should be run
#. before
#.       the tests).
#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/pst/printing/gutenprint.xml:160
#, xml-text
msgid ""
"To test the results, issue: <command>make check</command>.  The tests take a"
" very long time and use a lot of disk space.  When last tested (version "
"5.3.5 in March 2025) this needed 292 SBU and 3.8 GB to complete the tests. "
"Note that the tests used only one CPU."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/pst/printing/gutenprint.xml:170
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/pst/printing/gutenprint.xml:173
#, no-wrap, xml-text
msgid ""
"<userinput>make install &amp;&amp;\n"
"install -v -m755 -d /usr/share/doc/gutenprint-&gutenprint-version;/api/gutenprint{,ui2} &amp;&amp;\n"
"install -v -m644    doc/gutenprint/html/* \\\n"
"                    /usr/share/doc/gutenprint-&gutenprint-version;/api/gutenprint &amp;&amp;\n"
"install -v -m644    doc/gutenprintui2/html/* \\\n"
"                    /usr/share/doc/gutenprint-&gutenprint-version;/api/gutenprintui2</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/pst/printing/gutenprint.xml:183
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/pst/printing/gutenprint.xml:186
#, xml-text
msgid ""
"<command>sed -i '...' ...Makefile.in</command>: This command is used so that"
" the package documentation is installed in the conventional <filename "
"class='directory'>/usr/share/doc</filename> directory structure instead of "
"<filename class='directory'>/usr/share/gutenprint/doc</filename>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/pst/printing/gutenprint.xml:197
#, xml-text
msgid ""
"<parameter>--without-gimp2</parameter>: This switch disables support for "
"GIMP because it has not been updated to support GIMP3 yet."
msgstr ""

#. type: Content of: <sect1><sect2><title>
