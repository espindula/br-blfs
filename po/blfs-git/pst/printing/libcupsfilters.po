#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/pst/printing/libcupsfilters.xml:106
#, xml-text
msgid "Installation of libcupsfilters"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/pst/printing/libcupsfilters.xml:109
#, xml-text
msgid "First, fix 2 security vulnerabilities:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/pst/printing/libcupsfilters.xml:112
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"pre\">patch -Np1 -i ../libcupsfilters-&libcupsfilters-"
"version;-security_fixes-1.patch</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/pst/printing/libcupsfilters.xml:115
#, xml-text
msgid ""
"Install <application>libcupsfilters</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/pst/printing/libcupsfilters.xml:119
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr    \\\n"
"            --disable-static \\\n"
"            --docdir=/usr/share/doc/libcupsfilters-&libcupsfilters-version; &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/pst/printing/libcupsfilters.xml:125
#, xml-text
msgid ""
"To test the results, issue <command>make check</command>. DejaVu fonts are "
"needed for the tests."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/pst/printing/libcupsfilters.xml:130
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/pst/printing/libcupsfilters.xml:133
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/pst/printing/libcupsfilters.xml:138
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/pst/printing/libcupsfilters.xml:144
#, xml-text
msgid ""
"<option>--with-test-font-path=<replaceable>VALUE</replaceable></option>: If "
"you wish to run the tests, but you do not have the default "
"<filename>/usr/share/fonts/dejavu/DejaVuSans.ttf</filename> font installed, "
"use this switch to specify where <filename>DejaVuSans.ttf</filename> (or "
"perhaps some other text TTF font - though this is untested) is located."
msgstr ""

