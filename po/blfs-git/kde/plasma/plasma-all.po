#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/kde/plasma/plasma-all.xml:329
#, no-wrap, xml-text
msgid "<userinput>bash -e</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/kde/plasma/plasma-all.xml:332
#, xml-text
msgid "Install all of the packages by running the following commands:"
msgstr ""

#.  some packages end up with files owned by root in $packagedir,
#.      so use as_root for removing
#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/kde/plasma/plasma-all.xml:336
#, no-wrap, xml-text
msgid ""
"<userinput>while read -r line; do\n"
"\n"
"    # Get the file name, ignoring comments and blank lines\n"
"    if $(echo $line | grep -E -q '^ *$|^#' ); then continue; fi\n"
"    file=$(echo $line | cut -d\" \" -f2)\n"
"\n"
"    pkg=$(       echo $file|sed 's|^.*/||')    # Remove directory\n"
"    name=$(      echo $pkg |sed 's|-6.*$||')   # Isolate package name\n"
"    packagedir=$(echo $pkg |sed 's|\\.tar.*||') # Source directory\n"
"\n"
"    tar -xf $file\n"
"    pushd $packagedir\n"
"\n"
"       mkdir build\n"
"       cd    build\n"
"\n"
"       cmake -D CMAKE_INSTALL_PREFIX=$KF6_PREFIX \\\n"
"             -D CMAKE_INSTALL_LIBEXECDIR=libexec \\\n"
"             -D CMAKE_BUILD_TYPE=Release         \\\n"
"             -D BUILD_QT5=OFF                    \\\n"
"             -D BUILD_TESTING=OFF                \\\n"
"             -W no-dev ..  &amp;&amp;\n"
"\n"
"        make\n"
"        as_root make install\n"
"    popd\n"
"\n"
"\n"
"    as_root rm -rf $packagedir\n"
"    as_root /sbin/ldconfig\n"
"\n"
"done &lt; plasma-&plasma-version;.md5\n"
"\n"
"exit</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/kde/plasma/plasma-all.xml:373
#, xml-text
msgid ""
"If you did not set <envar>$KF6_PREFIX</envar> to <filename>/usr</filename>, "
"create symlinks to allow display managers to find "
"<application>Plasma</application>, and to allow the XDG Desktop Portal to be"
" detected. As the &root; user:"
msgstr ""

#.  work around a bug in xdg-desktop-portal
#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/kde/plasma/plasma-all.xml:379
#, no-wrap, xml-text
msgid ""
"<userinput># Setup xsessions (X11 sessions)\n"
"install -dvm 755 /usr/share/xsessions\n"
"cd /usr/share/xsessions\n"
"\n"
"[ -e plasma.desktop ] ||\n"
"ln -sfv $KF6_PREFIX/share/xsessions/plasmax11.desktop \n"
"\n"
"# Setup wayland-sessions \n"
"install -dvm 755 /usr/share/wayland-sessions\n"
"cd /usr/share/wayland-sessions\n"
"\n"
"[ -e plasmawayland.desktop ] ||\n"
"ln -sfv $KF6_PREFIX/share/wayland-sessions/plasma.desktop\n"
"\n"
"# Setup xdg-desktop-portal\n"
"install -dvm 755 /usr/share/xdg-desktop-portal\n"
"cd /usr/share/xdg-desktop-portal \n"
"\n"
"[ -e kde-portals.conf ] ||\n"
"ln -sfv $KF6_PREFIX/share/xdg-desktop-portal/kde-portals.conf\n"
"\n"
"# Setup kde portal\n"
"install -dvm 755 /usr/share/xdg-desktop-portal/portals\n"
"cd /usr/share/xdg-desktop-portal/portals\n"
"\n"
"[ -e kde.portal ] ||\n"
"ln -sfv $KF6_PREFIX/share/xdg-desktop-portal/portals/kde.portal</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/kde/plasma/plasma-all.xml:408
#, xml-text
msgid ""
"Useless systemd units have been installed in <filename "
"class=\"directory\">$KF6_PREFIX/lib</filename>. Remove them now (as "
"<systemitem class=\"username\">root</systemitem>):"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/kde/plasma/plasma-all.xml:414
#, no-wrap, xml-text
msgid "<userinput>rm -rf $KF6_PREFIX/lib/systemd</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/kde/plasma/plasma-all.xml:429
#, xml-text
msgid "Configuring Plasma"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><title>
#: blfs-en/blfs-git/kde/plasma/plasma-all.xml:432
#, xml-text
msgid "Linux PAM Configuration"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/blfs-git/kde/plasma/plasma-all.xml:435
#, xml-text
msgid ""
"If you built Plasma with the recommended <application>Linux "
"PAM</application> support, create necessary configuration files by running "
"the following commands as the <systemitem "
"class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><screen>
#: blfs-en/blfs-git/kde/plasma/plasma-all.xml:441
#, no-wrap, xml-text
msgid ""
"<userinput>cat &gt; /etc/pam.d/kde &lt;&lt; \"EOF\"\n"
"<literal># Begin /etc/pam.d/kde\n"
"\n"
"auth     requisite      pam_nologin.so\n"
"auth     required       pam_env.so\n"
"\n"
"auth     required       pam_succeed_if.so uid &gt;= 1000 quiet\n"
"auth     include        system-auth\n"
"\n"
"account  include        system-account\n"
"password include        system-password\n"
"session  include        system-session\n"
"\n"
"# End /etc/pam.d/kde</literal>\n"
"EOF\n"
"\n"
"cat &gt; /etc/pam.d/kde-np &lt;&lt; \"EOF\"\n"
"<literal># Begin /etc/pam.d/kde-np\n"
"\n"
"auth     requisite      pam_nologin.so\n"
"auth     required       pam_env.so\n"
"\n"
"auth     required       pam_succeed_if.so uid &gt;= 1000 quiet\n"
"auth     required       pam_permit.so\n"
"\n"
"account  include        system-account\n"
"password include        system-password\n"
"session  include        system-session\n"
"\n"
"# End /etc/pam.d/kde-np</literal>\n"
"EOF\n"
"\n"
"cat &gt; /etc/pam.d/kscreensaver &lt;&lt; \"EOF\"\n"
"<literal># Begin /etc/pam.d/kscreensaver\n"
"\n"
"auth    include system-auth\n"
"account include system-account\n"
"\n"
"# End /etc/pam.d/kscreensaver</literal>\n"
"EOF</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/kde/plasma/plasma-all.xml:485
#, xml-text
msgid "Starting Plasma"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/kde/plasma/plasma-all.xml:488
#, xml-text
msgid ""
"You can start <application>Plasma</application> from runlevel 3, using <xref"
" linkend=\"xinit\"/>, or from runlevel 5, using a Display Manager, such as "
"<xref linkend=\"lightdm\"/>."
msgstr ""

#. , or from a graphical display manager, such as
#.       <xref linkend="sddm"/>
#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/kde/plasma/plasma-all.xml:494
#, xml-text
msgid ""
"You can start <application>Plasma</application> from a TTY, using <xref "
"linkend=\"xinit\"/>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/kde/plasma/plasma-all.xml:500
#, xml-text
msgid ""
"To start <application>Plasma</application> using <xref linkend=\"xinit\"/>, "
"run the following commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/kde/plasma/plasma-all.xml:504
#, no-wrap, xml-text
msgid ""
"<userinput>cat &gt; ~/.xinitrc &lt;&lt; \"EOF\"\n"
"<literal>dbus-launch --exit-with-x11 $KF6_PREFIX/bin/startplasma-x11</literal>\n"
"EOF\n"
"\n"
"startx</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/kde/plasma/plasma-all.xml:511
#, xml-text
msgid ""
"The X session starts on the first unused virtual terminal, normally vt7.  "
"You can switch to another vt<emphasis>n</emphasis> simultaneously pressing "
"the keys Ctrl-Alt-F<emphasis>n</emphasis> (<emphasis>n</emphasis>=1, 2, "
"...).  To switch back to the X session, normally started at vt7, use Ctrl-"
"Alt-F7. The vt where the command <command>startx</command> was executed will"
" display many messages, including X starting messages, applications "
"automatically started with the session, and eventually, some warning and "
"error messages. You may prefer to redirect those messages to a log file, "
"which not only will keep the initial vt uncluttered, but can also be used "
"for debugging purposes. This can be done starting X with:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/kde/plasma/plasma-all.xml:524
#, no-wrap, xml-text
msgid "<userinput>startx &amp;&gt; ~/x-session-errors</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/kde/plasma/plasma-all.xml:527
#, xml-text
msgid ""
"When shutting down or rebooting, the shutdown messages appear on the vt "
"where X was running. If you wish to see those messages, simultaneously press"
" keys Alt-F7 (assuming that X was running on vt7)."
msgstr ""

