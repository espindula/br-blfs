#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/kde/plasma/plasma-all.xml:146
#, xml-text
msgid "Downloading KDE Plasma"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/kde/plasma/plasma-all.xml:149
#, xml-text
msgid ""
"The easiest way to get the KDE Plasma packages is to use a single "
"<command>wget</command> to fetch them all at once:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/kde/plasma/plasma-all.xml:153
#, no-wrap, xml-text
msgid ""
"<userinput>url=https://download.kde.org/stable/plasma/&plasma-version;/\n"
"wget -r -nH -nd -A '*.xz' -np $url</userinput>\n"
"<literal>\n"
"The options used here are:\n"
"  -r            recurse through child directories\n"
"  -nH           disable generation of host-prefixed directories\n"
"  -nd           do not create a hierarchy of directories\n"
"  -A '*.xz'     just get the *.xz files\n"
"  -np           don't get parent directories</literal>"
msgstr ""

