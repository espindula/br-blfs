#, xml-text
msgid "Installation of pulseaudio-qt"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/kde/plasma/pulseaudio-qt.xml:83
#, xml-text
msgid ""
"Install <application>pulseaudio-qt</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/kde/plasma/pulseaudio-qt.xml:87
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=$KF6_PREFIX \\\n"
"      -D CMAKE_PREFIX_PATH=$QT6DIR        \\\n"
"      -D CMAKE_SKIP_INSTALL_RPATH=ON      \\\n"
"      -D CMAKE_BUILD_TYPE=Release         \\\n"
"      -D BUILD_TESTING=OFF                \\\n"
"      .. &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/kde/plasma/pulseaudio-qt.xml:99
#, xml-text
msgid "Now as the &root; user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/kde/plasma/pulseaudio-qt.xml:102
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr ""

