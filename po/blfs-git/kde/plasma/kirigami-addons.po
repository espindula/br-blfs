msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/kde/plasma/kirigami-addons.xml:85
#, xml-text
msgid ""
"Install <application>kirigami-addons</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/kde/plasma/kirigami-addons.xml:89
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=$KF6_PREFIX \\\n"
"      -D CMAKE_BUILD_TYPE=Release         \\\n"
"      -D BUILD_TESTING=OFF                \\\n"
"       ..                                 &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/kde/plasma/kirigami-addons.xml:99
#, xml-text
msgid "This package does not come with a test suite."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/kde/plasma/kirigami-addons.xml:103
#, xml-text
msgid "Now, as the &root; user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/kde/plasma/kirigami-addons.xml:106
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr ""

