#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/kde/kf6/kf6-frameworks.xml:292
#, xml-text
msgid "Installation of KDE Frameworks"
msgstr ""

#. type: Content of: <sect1><sect2><caution><para>
#: blfs-en/blfs-git/kde/kf6/kf6-frameworks.xml:299
#, xml-text
msgid ""
"If installing in <filename class=\"directory\">/opt</filename> and there is "
"an existing /opt/kf6 either as a regular directory or a symbolic link, it "
"should be reinitialized (as <systemitem class=\"username\"> "
"root</systemitem>):"
msgstr ""

#. type: Content of: <sect1><sect2><caution><screen>
#: blfs-en/blfs-git/kde/kf6/kf6-frameworks.xml:305
#, no-wrap, xml-text
msgid ""
"<userinput>mv -v /opt/kf6 /opt/kf6.old                         &amp;&amp;\n"
"install -v -dm755           $KF6_PREFIX/{etc,share} &amp;&amp;\n"
"ln -sfv /etc/dbus-1         $KF6_PREFIX/etc         &amp;&amp;\n"
"ln -sfv /usr/share/dbus-1   $KF6_PREFIX/share       &amp;&amp;\n"
"ln -sfv /usr/share/polkit-1 $KF6_PREFIX/share</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><caution><screen>
#: blfs-en/blfs-git/kde/kf6/kf6-frameworks.xml:311
#, no-wrap, xml-text
msgid ""
"<userinput>mv -v /opt/kf6 /opt/kf6.old                         &amp;&amp;\n"
"install -v -dm755           $KF6_PREFIX/{etc,share} &amp;&amp;\n"
"ln -sfv /etc/dbus-1         $KF6_PREFIX/etc         &amp;&amp;\n"
"ln -sfv /usr/share/dbus-1   $KF6_PREFIX/share       &amp;&amp;\n"
"ln -sfv /usr/share/polkit-1 $KF6_PREFIX/share       &amp;&amp;\n"
"install -v -dm755           $KF6_PREFIX/lib         &amp;&amp;\n"
"ln -sfv /usr/lib/systemd    $KF6_PREFIX/lib</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
