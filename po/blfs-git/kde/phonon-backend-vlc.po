#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/kde/phonon-backend-vlc.xml:88
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr \\\n"
"      -D CMAKE_BUILD_TYPE=Release  \\\n"
"      -D PHONON_BUILD_QT5=OFF      \\\n"
"      .. &amp;&amp;\n"
"make</userinput>"
