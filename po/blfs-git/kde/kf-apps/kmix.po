#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/kde/kf-apps/kmix.xml:90
#, xml-text
msgid "Installation of KMix"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/kde/kf-apps/kmix.xml:93
#, xml-text
msgid ""
"Install <application>KMix</application> by running the following commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/kde/kf-apps/kmix.xml:97
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=$KF6_PREFIX \\\n"
"      -D CMAKE_BUILD_TYPE=Release         \\\n"
"      -D BUILD_TESTING=OFF                \\\n"
"      -W no-dev .. &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/kde/kf-apps/kmix.xml:107
#, xml-text
msgid "This package does not come with a test suite."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/kde/kf-apps/kmix.xml:111
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/kde/kf-apps/kmix.xml:114
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr ""

