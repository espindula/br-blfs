#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/kde/kf-apps/gwenview.xml:93
#, xml-text
msgid "Installation of Gwenview"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/kde/kf-apps/gwenview.xml:96
#, xml-text
msgid ""
"Install <application>Gwenview</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/kde/kf-apps/gwenview.xml:100
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=$KF6_PREFIX \\\n"
"      -D CMAKE_BUILD_TYPE=Release         \\\n"
"      -D BUILD_TESTING=OFF                \\\n"
"      -W no-dev .. &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/kde/kf-apps/gwenview.xml:110
#, xml-text
msgid "This package does not come with a test suite."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/kde/kf-apps/gwenview.xml:114
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/kde/kf-apps/gwenview.xml:117
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr ""

