#. type: Content of: <sect1><title>
#: blfs-en/blfs-git/kde/kf-apps/add-pkgs.xml:8
#: blfs-en/blfs-git/kde/kf-apps/add-pkgs.xml:12
#, xml-text
msgid "Further KDE packages"
msgstr ""

#. type: Content of: <sect1><para>
#: blfs-en/blfs-git/kde/kf-apps/add-pkgs.xml:15
#, xml-text
msgid ""
"This chapter did not provide instructions for all of the available packages "
"in the KDE Software Compilation (KDE Gear). The included packages were "
"selected based on what most people would want to use on a standard desktop "
"computer."
msgstr ""

#. type: Content of: <sect1><para>
#: blfs-en/blfs-git/kde/kf-apps/add-pkgs.xml:21
#, xml-text
msgid ""
"For a full list of available packages, have a look on the KDE6 servers at "
"<ulink url=\"&kf6apps-download-http;\">&kf6apps-download-http;</ulink>."
msgstr ""

#. type: Content of: <sect1><para>
#: blfs-en/blfs-git/kde/kf-apps/add-pkgs.xml:26
#, xml-text
msgid "Editor Notes: <ulink url=\"&blfs-wiki;/Further_KDE_Packages\"/>"
msgstr ""

#. type: Content of: <sect1><para>
#: blfs-en/blfs-git/kde/kf-apps/add-pkgs.xml:30
#, xml-text
msgid "Some additional packages worth mentioning are:"
msgstr ""

#. type: Content of: <sect1><itemizedlist><listitem><para>
#: blfs-en/blfs-git/kde/kf-apps/add-pkgs.xml:35
#, xml-text
msgid "Juk: A lightweight music player."
msgstr ""

#. type: Content of: <sect1><itemizedlist><listitem><para>
#: blfs-en/blfs-git/kde/kf-apps/add-pkgs.xml:38
#, xml-text
msgid "Dragon: A video player."
msgstr ""

#. type: Content of: <sect1><itemizedlist><listitem><para>
#: blfs-en/blfs-git/kde/kf-apps/add-pkgs.xml:41
#, xml-text
msgid "Kcalc: A scientific calculator."
msgstr ""

#. type: Content of: <sect1><itemizedlist><listitem><para>
#: blfs-en/blfs-git/kde/kf-apps/add-pkgs.xml:44
#, xml-text
msgid "Kwalletmanager: A credentials management application."
msgstr ""

#. type: Content of: <sect1><itemizedlist><listitem><para>
#: blfs-en/blfs-git/kde/kf-apps/add-pkgs.xml:47
#, xml-text
msgid "Marble: A global map program."
msgstr ""

#. type: Content of: <sect1><itemizedlist><listitem><para>
#: blfs-en/blfs-git/kde/kf-apps/add-pkgs.xml:50
#, xml-text
msgid "Spectacle: a screenshot program."
msgstr ""

#. type: Content of: <sect1><itemizedlist><listitem><para>
#: blfs-en/blfs-git/kde/kf-apps/add-pkgs.xml:54
#, xml-text
msgid ""
"A variety (about 40) of KDE games including: kpat, kfourinline, and kmines."
msgstr ""

#. type: Content of: <sect1><note><para>
#: blfs-en/blfs-git/kde/kf-apps/add-pkgs.xml:62
#, xml-text
msgid ""
"Some packages will require additional dependencies.  To determine what "
"dependencies are needed, run from the top of the source tree:"
msgstr ""

#. type: Content of: <sect1><note><screen>
#: blfs-en/blfs-git/kde/kf-apps/add-pkgs.xml:66
#, no-wrap, xml-text
msgid "<userinput>cmake -W no-dev -LH .</userinput>"
msgstr ""

#. type: Content of: <sect1><note><para>
#: blfs-en/blfs-git/kde/kf-apps/add-pkgs.xml:69
#, xml-text
msgid ""
"Note that this creates some files in the top of the source directory, so "
"that it is better to reextract a clean source before proceeding to the "
"build."
msgstr ""

#. type: Content of: <sect1><para>
#: blfs-en/blfs-git/kde/kf-apps/add-pkgs.xml:76
#, xml-text
msgid ""
"Most of these packages can be built with the standard KDE6 instructions:"
msgstr ""

#. type: Content of: <sect1><screen>
#: blfs-en/blfs-git/kde/kf-apps/add-pkgs.xml:79
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=$KF6_PREFIX \\\n"
"      -D CMAKE_BUILD_TYPE=Release         \\\n"
"      -D BUILD_TESTING=OFF                \\\n"
"      -W no-dev .. &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><para>
#: blfs-en/blfs-git/kde/kf-apps/add-pkgs.xml:89
#, xml-text
msgid "And as the &root; user:"
msgstr ""

#. type: Content of: <sect1><screen>
#: blfs-en/blfs-git/kde/kf-apps/add-pkgs.xml:92
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr ""
