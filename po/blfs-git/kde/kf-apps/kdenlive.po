#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/kde/kf-apps/kdenlive.xml:97
#, xml-text
msgid "Installation of Kdenlive"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/kde/kf-apps/kdenlive.xml:100
#, xml-text
msgid ""
"Install <application>Kdenlive</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/kde/kf-apps/kdenlive.xml:104
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=$KF6_PREFIX \\\n"
"      -D CMAKE_BUILD_TYPE=Release         \\\n"
"      -D BUILD_TESTING=OFF                \\\n"
"      -W no-dev .. &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><note><para>
#: blfs-en/blfs-git/kde/kf-apps/kdenlive.xml:114
#, xml-text
msgid ""
"The build process will download a Git repository of "
"<application>OpenTimelineIO</application>, totaling around 100 MB. "
"Configuration will seem to hang right after <command>cmake</command> begins "
"running. This is normal, it is fetching that Git repository. If it hangs for"
" a while, it's most likely due to a poor download speed during the download "
"process."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/kde/kf-apps/kdenlive.xml:123
#, xml-text
msgid "This package does not come with a test suite."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/kde/kf-apps/kdenlive.xml:127
#, xml-text
msgid "Now, as the &root; user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/kde/kf-apps/kdenlive.xml:130
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr ""

