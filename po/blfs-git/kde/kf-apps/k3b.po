#, xml-text
msgid "K3b Dependencies"
msgstr ""

#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/blfs-git/kde/kf-apps/k3b.xml:89
#, xml-text
msgid "Required"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/kde/kf-apps/k3b.xml:91
#, xml-text
msgid ""
"<xref linkend=\"kf6-frameworks\"/>, <xref linkend=\"libkcddb\"/>, <xref "
"linkend=\"libsamplerate\"/>, and <xref linkend=\"shared-mime-info\"/>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/kde/kf-apps/k3b.xml:98
#, xml-text
msgid ""
"The CD/DVD drive is detected at run time using <xref linkend=\"udisks2\" "
"role=\"runtime\"/>, which must therefore be installed before running "
"<command>k3b</command>."
msgstr ""

#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/blfs-git/kde/kf-apps/k3b.xml:103
#, xml-text
msgid "Recommended"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/kde/kf-apps/k3b.xml:105
#, xml-text
msgid ""
"<xref linkend=\"libburn\"/>, <xref linkend=\"libdvdread\"/>, and <xref "
"linkend=\"taglib\"/>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/kde/kf-apps/k3b.xml:111
#, xml-text
msgid ""
"There are programs from three packages that <application>k3b</application> "
"will look for at runtime: <xref role=\"runtime\" linkend=\"cdrtools\"/> "
"(required to burn CD-ROM media), <xref role=\"runtime\" linkend=\"dvd-rw-"
"tools\"/> (required to burn or format DVD media), and <xref role=\"runtime\""
" linkend=\"cdrdao\"/> (required to burn CD-ROM media in DAO (Disk At Once) "
"mode). If you don't need the capability provided by any of the three "
"packages, you don't have to install it. However, a warning message will be "
"generated every time you run the <command>k3b</command> program if any are "
"not installed."
msgstr ""

#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/blfs-git/kde/kf-apps/k3b.xml:122
#, xml-text
msgid "Optional Runtime"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/kde/kf-apps/k3b.xml:124
#, xml-text
msgid "<xref linkend=\"ffmpeg\"/>"
msgstr ""

#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/blfs-git/kde/kf-apps/k3b.xml:127
#, xml-text
msgid "Optional"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/kde/kf-apps/k3b.xml:129
#, xml-text
msgid ""
"<xref linkend=\"flac\"/>, <xref linkend=\"lame\"/>, <xref "
"linkend=\"libmad\"/>, <xref linkend=\"libsndfile\"/>, <xref "
"linkend=\"libvorbis\"/>, and <ulink "
"url=\"https://www.musepack.net/\">Musepack (libmpcdec)</ulink>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/kde/kf-apps/k3b.xml:140
#, xml-text
msgid "Installation of K3b"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/kde/kf-apps/k3b.xml:143
#, xml-text
msgid ""
"Install <application>K3b</application> by running the following commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/kde/kf-apps/k3b.xml:147
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=$KF6_PREFIX \\\n"
"      -D CMAKE_BUILD_TYPE=Release         \\\n"
"      -D BUILD_TESTING=OFF                \\\n"
"      -W no-dev ..                        &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/kde/kf-apps/k3b.xml:157
#, xml-text
msgid "This package does not come with a test suite."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/kde/kf-apps/k3b.xml:161
#, xml-text
msgid "Now, as the &root; user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/kde/kf-apps/k3b.xml:164
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr ""

