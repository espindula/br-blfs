#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/kde/phonon.xml:95
#, xml-text
msgid "Installation of Phonon"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/kde/phonon.xml:97
#, xml-text
msgid ""
"Install <application>Phonon</application> by running the following commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/kde/phonon.xml:101
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr \\\n"
"      -D CMAKE_BUILD_TYPE=Release  \\\n"
"      -D PHONON_BUILD_QT5=OFF      \\\n"
"      -W no-dev .. &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/kde/phonon.xml:111
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/kde/phonon.xml:114
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/kde/phonon.xml:119
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/kde/phonon.xml:122
#, xml-text
msgid ""
"<parameter>-D CMAKE_BUILD_TYPE=Release</parameter>: This switch is used to "
"apply higher level of the compiler optimizations."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/kde/phonon.xml:127
#, xml-text
msgid ""
"<parameter>-D PHONON_BUILD_QT5=OFF</parameter>: This switch is needed to "
"prevent building the <application>Qt5</application> bindings, which fails if"
" <application>Qt5</application> is not installed."
msgstr ""

