#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/kde/extra-cmake-modules.xml:104
#, xml-text
msgid "Installation of Extra Cmake Modules"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/kde/extra-cmake-modules.xml:113
#, xml-text
msgid ""
"Install <application>Extra Cmake Modules</application> by running the "
"following commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/kde/extra-cmake-modules.xml:117
#, no-wrap, xml-text
msgid ""
"<userinput>sed -i '/\"lib64\"/s/64//' kde-modules/KDEInstallDirsCommon.cmake &amp;&amp;\n"
"\n"
"sed -e '/PACKAGE_INIT/i set(SAVE_PACKAGE_PREFIX_DIR \"${PACKAGE_PREFIX_DIR}\")' \\\n"
"    -e '/^include/a set(PACKAGE_PREFIX_DIR \"${SAVE_PACKAGE_PREFIX_DIR}\")' \\\n"
"    -i ECMConfig.cmake.in &amp;&amp;\n"
"\n"
"mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr \\\n"
"      -D BUILD_WITH_QT6=ON         \\\n"
"      -D DOC_INSTALL_DIR=/usr/share/doc/extra-cmake-modules-&kf6-version; \\\n"
"      .. &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/kde/extra-cmake-modules.xml:133
#, xml-text
msgid "This package does not come with a test suite."
msgstr ""

#. type: Content of: <sect1><sect2><note><para>
#: blfs-en/blfs-git/kde/extra-cmake-modules.xml:137
#, xml-text
msgid ""
"Unlike other KF6 packages, this module is installed in /usr because it can "
"be used by some non-KF6 packages."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/kde/extra-cmake-modules.xml:142
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/kde/extra-cmake-modules.xml:145
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/kde/extra-cmake-modules.xml:150
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/kde/extra-cmake-modules.xml:153
#, xml-text
msgid ""
"<command>sed ... Modules/KDEInstallDirs.cmake</command>: This command "
"disables applications using cmake from attempting to install files in a "
"<filename class=\"directory\">lib64</filename> sub-directory."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/kde/extra-cmake-modules.xml:160
#, xml-text
msgid ""
"<command>sed ... ECMConfig.cmake.in</command>: This command protects the "
"global <application>cmake</application> variable "
"<envar>PACKAGE_PREFIX_DIR</envar> from being changed when checking ECM "
"presence: since we install ECM into <filename "
"class=\"directory\">/usr</filename>, the check would set that variable to "
"<filename class=\"directory\">/usr</filename>, while most KDE packages "
"expect it to be set to <filename class=\"directory\">/opt/kf6</filename> and"
" would fail to build if it is set to something else."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/kde/extra-cmake-modules.xml:171
#, xml-text
msgid ""
"<parameter>-D DOC_INSTALL-DIR=/usr/share/doc/extra...</parameter>: This "
"switch allows installing the documentation (which is built if <xref "
"linkend=\"sphinx\"/> is installed) in a versioned directory."
msgstr ""

