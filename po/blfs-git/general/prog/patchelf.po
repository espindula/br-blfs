#, xml-text
msgid "Installation of Patchelf"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/prog/patchelf.xml:75
#, xml-text
msgid ""
"Install <application>patchelf</application> by running the following "
"commands:"
