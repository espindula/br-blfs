#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/prog/patchelf.xml:79
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr \\\n"
"            --docdir=/usr/share/doc/patchelf-&patchelf-version; &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/prog/patchelf.xml:84
#, xml-text
msgid "To test the results, issue: <command>make check</command>."
msgstr ""

