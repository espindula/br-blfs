#.  https://github.com/radiator-software/p5-net-ssleay/issues/511
#.  https://rt.cpan.org/Public/Bug/Display.html?id=12954
#. type: Content of: <sect2><sect3><note><para>
#: blfs-en/blfs-git/general/prog/perl-deps/perl-net-ssleay.xml:63
#, xml-text
msgid ""
