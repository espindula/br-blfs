#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/prog/gc.xml:96
#, xml-text
msgid "Installation of GC"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/prog/gc.xml:99
#, xml-text
msgid ""
"Apply a patch to fix crashes in applications using GC and another library "
"forking subprocesses (for example glycin) at the same time:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/prog/gc.xml:103
#, no-wrap, xml-text
msgid ""
"<userinput>patch -Np1 -i ../gc-&gc-"
"version;-fork_workaround-1.patch</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/prog/gc.xml:106
#, xml-text
msgid ""
"Install <application>GC</application> by running the following commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/prog/gc.xml:109
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr      \\\n"
"            --enable-cplusplus \\\n"
"            --disable-static   \\\n"
"            --docdir=/usr/share/doc/gc-&gc-version; &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/prog/gc.xml:116
#, xml-text
msgid "To test the results, issue: <command>make check</command>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/prog/gc.xml:120
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/prog/gc.xml:123
#, no-wrap, xml-text
msgid ""
"<userinput>make install &amp;&amp;\n"
"install -v -m644 doc/gc.man /usr/share/man/man3/gc_malloc.3</userinput>"
msgstr ""

