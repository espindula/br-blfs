#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/prog/dtc.xml:77
#, xml-text
msgid "Installation of Dtc"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/prog/dtc.xml:80
#, xml-text
msgid ""
"Install <application>dtc</application> by running the following commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/prog/dtc.xml:84
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup ..            \\\n"
"      --prefix=/usr       \\\n"
"      --buildtype=release \\\n"
"      -D python=disabled  &amp;&amp;\n"
"ninja</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/prog/dtc.xml:94
#, xml-text
msgid ""
"To test the results, issue: <command>CC='gcc -Wl,-z,noexecstack' meson test "
"-v</command>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/prog/dtc.xml:99
#, xml-text
msgid "Now, as the &root; user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/prog/dtc.xml:102
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/prog/dtc.xml:105
#, xml-text
msgid "Still as the &root; user, remove the useless static library:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/prog/dtc.xml:108
#, no-wrap, xml-text
msgid "<userinput>rm /usr/lib/libfdt.a</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/prog/dtc.xml:111
#, xml-text
msgid ""
"If you have <xref linkend='texlive'/> installed, you can build the PDF "
"format of the documentation by issuing the following command:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/prog/dtc.xml:115
#, no-wrap, xml-text
msgid ""
"<userinput>pushd ../Documentation\n"
"  latexmk -bibtex --pdf dtc-paper &amp;&amp;\n"
"  latexmk -bibtex --pdf dtc-paper -c\n"
"popd</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/prog/dtc.xml:121
#, xml-text
msgid ""
"To install the documentation, as the &root; user issue the following "
"command:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/prog/dtc.xml:125
#, no-wrap, xml-text
msgid ""
"<userinput>cp -R ../Documentation -T /usr/share/doc/dtc-&dtc-"
"version;</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/prog/dtc.xml:128
#, xml-text
msgid ""
"If you have installed <xref linkend='swig'/> and you wish to install the "
"Python 3 bindings of this package, build the Python 3 module:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/prog/dtc.xml:133
#, no-wrap, xml-text
msgid "<userinput>&build-wheel-cmd; ..</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/prog/dtc.xml:136
#, xml-text
msgid "As the &root; user, install the Python 3 module:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/prog/dtc.xml:139
#, no-wrap, xml-text
msgid "<userinput>&install-wheel; libfdt</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/prog/dtc.xml:143
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/prog/dtc.xml:149
#, xml-text
msgid ""
"<parameter>-D python=disabled</parameter>: This switch prevents building the"
" Python 3 binding with the deprecated method (running "
"<command>setup.py</command> directly).  We will build the Python 3 binding "
"with the <command>pip3 wheel</command> command separately if wanted."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/prog/dtc.xml:158
#, xml-text
msgid ""
"<envar>CC='gcc -Wl,-z,noexecstack'</envar>: This variable prevents marking "
"the shared libraries in the test suite as requiring executable stack.  Glibc"
" 2.41 or later has stopped allowing <function>dlopen</function>ing such a "
"shared library so the test suite would fail.  But those shared libraries "
"don't really need an executable stack, so we can use "
"<parameter>-Wl,-z,noexecstack</parameter> to fix up the test suite.  It's "
"needed in the <envar>CC</envar> environment for the <command>meson "
"test</command> because those shared libraries are built by a test script "
"instead of the <command>meson</command>/<command>ninja</command> building "
"system, and the test script does not recognize other <quote>common</quote> "
"environment variables like <envar>LDFLAGS</envar>."
msgstr ""

