#, xml-text
msgid "Installation of NASM"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/prog/nasm.xml:94
#, xml-text
msgid ""
"If you downloaded the optional documentation, put it into the source tree:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/prog/nasm.xml:98
#, no-wrap, xml-text
msgid ""
"<userinput>tar -xf ../nasm-&nasm-version;-xdoc.tar.xz --strip-"
"components=1</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/prog/nasm.xml:101
#, xml-text
msgid ""
"Install <application>NASM</application> by running the following commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/prog/nasm.xml:105
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/prog/nasm.xml:109
#, xml-text
msgid "This package does not come with a test suite."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/prog/nasm.xml:113
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/prog/nasm.xml:116
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/prog/nasm.xml:119
#, xml-text
msgid ""
"If you downloaded the optional documentation, install it with the following "
"instructions as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/prog/nasm.xml:124
#, no-wrap, xml-text
msgid ""
"<userinput>install -m755 -d         /usr/share/doc/nasm-&nasm-version;/html  &amp;&amp;\n"
"cp -v doc/html/*.html    /usr/share/doc/nasm-&nasm-version;/html  &amp;&amp;\n"
"cp -v doc/*.{txt,ps,pdf} /usr/share/doc/nasm-&nasm-version;</userinput>"
msgstr ""

