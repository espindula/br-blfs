#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/prog/doxygen.xml:123
#, xml-text
msgid "Installation of Doxygen"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/prog/doxygen.xml:134
#, xml-text
msgid "First, fix up some python scripts:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/prog/doxygen.xml:137
#, no-wrap, xml-text
msgid ""
"<userinput>grep -rl '^#!.*python$' | xargs sed -i "
"'1s/python/&amp;3/'</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/prog/doxygen.xml:140
#, xml-text
msgid ""
"Install <application>Doxygen</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/prog/doxygen.xml:144
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir -v build &amp;&amp;\n"
"cd       build &amp;&amp;\n"
"\n"
"cmake -G \"Unix Makefiles\"          \\\n"
"      -D CMAKE_BUILD_TYPE=Release  \\\n"
"      -D CMAKE_INSTALL_PREFIX=/usr \\\n"
"      -D build_wizard=ON           \\\n"
"      -D force_qt=Qt6              \\\n"
"      -W no-dev .. &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/prog/doxygen.xml:156
#, xml-text
msgid ""
"To test the results, issue: <command>make tests</command>.  One test, "
"012_cite.dox, is known to fail if <xref linkend=\"texlive\"/> or <xref "
"linkend=\"tl-installer\"/> is not installed."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/prog/doxygen.xml:162
#, xml-text
msgid ""
"If you wish to generate the package documentation, you must have "
"<application>Python</application>, <application>TeX Live</application> (for "
"HTML docs) and <application>Ghostscript</application> (for PDF docs)  "
"installed, then issue the following command:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/prog/doxygen.xml:168
#, no-wrap, xml-text
msgid ""
"<userinput>cmake  -D build_doc=ON \\\n"
"       -D DOC_INSTALL_DIR=share/doc/doxygen-&doxygen-version; \\\n"
"       .. &amp;&amp;\n"
"make docs</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/prog/doxygen.xml:174
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/prog/doxygen.xml:177
#, no-wrap, xml-text
msgid ""
"<userinput>make install &amp;&amp;\n"
"install -vm644 ../doc/*.1 /usr/share/man/man1</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/prog/doxygen.xml:181
#, xml-text
msgid ""
"If you have generated the package documentation, then the man pages are "
"automatically installed, and you do not need to run the last "
"<command>install ...</command> command."
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/prog/doxygen.xml:189
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/prog/doxygen.xml:192
#, xml-text
msgid ""
"<option>-D build_wizard=OFF</option>: Use this switch if "
"<application>Qt6</application> is not installed."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/prog/doxygen.xml:197
#, xml-text
msgid ""
"<option>-D build_search=ON</option>: Use this switch if "
"<application>xapian</application> is installed and you wish to build "
"external search tools (<command>doxysearch.cgi</command> and "
"<command>doxyindexer)</command>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/prog/doxygen.xml:204
#, xml-text
msgid ""
"<option>-D force_qt6=ON</option>: Use this switch to build "
"<command>doxywizard</command> with Qt6 even if Qt5 is installed."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/prog/doxygen.xml:209
#, xml-text
msgid ""
"<option>-D use_libclang=ON</option>: Use this switch if "
"<application>llvm</application> with <application>clang</application> are "
"installed, to add support for libclang parsing."
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/prog/doxygen.xml:217
#, xml-text
msgid "Configuring Doxygen"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/prog/doxygen.xml:220
#, xml-text
msgid ""
"There is no real configuration necessary for the "
"<application>Doxygen</application> package although three additional "
"packages are required if you wish to use extended capabilities.  If you "
"require formulas to create PDF documentation, then you must have <xref "
"linkend=\"texlive\"/> installed.  If you require formulas to convert "
"PostScript files to bitmaps, then you must have <xref linkend=\"gs\"/> "
"installed."
msgstr ""

