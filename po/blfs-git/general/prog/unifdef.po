#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/prog/unifdef.xml:71
#, xml-text
msgid "Installation of unifdef"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/prog/unifdef.xml:74
#, xml-text
msgid "First, fix a problem when building with gcc-15:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/prog/unifdef.xml:77
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"pre\">sed -i 's/constexpr/unifdef_&amp;/g' "
"unifdef.c</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/prog/unifdef.xml:80
#, xml-text
msgid "Now fix a problem if reinstalling the package:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/prog/unifdef.xml:83
#, no-wrap, xml-text
msgid "<userinput remap=\"pre\">sed -i 's/ln -s/ln -sf/' Makefile</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/prog/unifdef.xml:86
#, xml-text
msgid ""
"Install <application>unifdef</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/prog/unifdef.xml:90
#, no-wrap, xml-text
msgid "<userinput>make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/prog/unifdef.xml:93
#, xml-text
msgid "To test the results, issue: <command>make test</command>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/prog/unifdef.xml:97
#, xml-text
msgid "Finally, finish the installation as the &root; user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/prog/unifdef.xml:100
#, no-wrap, xml-text
msgid "<userinput>make prefix=/usr install</userinput>"
msgstr ""

