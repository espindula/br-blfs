#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/prog/guile.xml:87
#, xml-text
msgid "Installation of Guile"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/prog/guile.xml:90
#, xml-text
msgid ""
"Install <application>Guile</application> by running the following commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/prog/guile.xml:94
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr    \\\n"
"            --disable-static \\\n"
"            --docdir=/usr/share/doc/guile-&guile-version; &amp;&amp;\n"
"make      &amp;&amp;\n"
"make html &amp;&amp;\n"
"\n"
"makeinfo --plaintext -o doc/r5rs/r5rs.txt doc/r5rs/r5rs.texi &amp;&amp;\n"
"makeinfo --plaintext -o doc/ref/guile.txt doc/ref/guile.texi</userinput>"
msgstr ""

#. On an i686 system, as many as 10 tests will fail in the
#.       <filename>
#. numbers.test</filename> test suite due to minor floating-point
#.       rounding errors.
#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/prog/guile.xml:104
#, xml-text
msgid ""
"When running the test suite, first remove a failing test that halts the "
"tests: <command>rm test-suite/tests/srfi-207.test</command>.  Then to test "
"the results, issue: <command>./check-guile</command>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/prog/guile.xml:127
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/prog/guile.xml:130
#, no-wrap, xml-text
msgid ""
"<userinput>make install      &amp;&amp;\n"
"make install-html &amp;&amp;\n"
"\n"
"mkdir -p                       /usr/share/gdb/auto-load/usr/lib &amp;&amp;\n"
"mv /usr/lib/libguile-*-gdb.scm /usr/share/gdb/auto-load/usr/lib &amp;&amp;\n"
"mv /usr/share/doc/guile-&guile-version;/{guile.html,ref} &amp;&amp;\n"
"mv /usr/share/doc/guile-&guile-version;/r5rs{.html,}     &amp;&amp;\n"
"\n"
"find examples -name \"Makefile*\" -delete         &amp;&amp;\n"
"cp -vR examples   /usr/share/doc/guile-&guile-version;   &amp;&amp;\n"
"\n"
"for DIRNAME in r5rs ref; do\n"
"  install -v -m644  doc/${DIRNAME}/*.txt \\\n"
"                    /usr/share/doc/guile-&guile-version;/${DIRNAME}\n"
"done &amp;&amp;\n"
"unset DIRNAME</userinput>"
msgstr ""

