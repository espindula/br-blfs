#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/prog/luajit.xml:68
#, xml-text
msgid "Installation of luajit"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/prog/luajit.xml:71
#, xml-text
msgid ""
"Install <application>luajit</application> by running the following commands:"
msgstr ""

#.  We need to specify PREFIX=/usr here so it loads plugins from
#.      /usr/lib/luajit instead of /usr/local/lib/luajit.
#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/prog/luajit.xml:78
#, no-wrap, xml-text
msgid "<userinput>make PREFIX=/usr amalg</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/prog/luajit.xml:81
#, xml-text
msgid "This package does not come with a test suite."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/prog/luajit.xml:85
#, xml-text
msgid "Now, as the &root; user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/prog/luajit.xml:88
#, no-wrap, xml-text
msgid ""
"<userinput>make PREFIX=/usr install &amp;&amp;\n"
"rm -v /usr/lib/libluajit-5.1.a</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/prog/luajit.xml:94
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/prog/luajit.xml:97
#, xml-text
msgid ""
"<parameter>amalg</parameter>: This ensures an amalgamated build, i.e. the "
"LuaJIT core is compiled as one huge C file, allowing GCC to generate faster "
"and shorter code."
msgstr ""

