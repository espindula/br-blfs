msgstr ""

#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/blfs-git/general/prog/rust.xml:162
#, xml-text
msgid "Required"
msgstr ""

#.  Required for downloading stage 0 binaries.
#.            Otherwise it's recommended (if not installed, a vendored copy
#.            will be built).
#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/prog/rust.xml:164
#, xml-text
msgid "<xref linkend=\"cmake\"/> and <xref linkend=\"curl\"/>"
msgstr ""

#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/blfs-git/general/prog/rust.xml:173
#, xml-text
msgid "Recommended"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/prog/rust.xml:175
#, xml-text
msgid ""
"<xref linkend=\"libssh2\"/> and <xref linkend=\"llvm\"/> (built with -D "
"LLVM_LINK_LLVM_DYLIB=ON so that rust can link to system LLVM instead of "
"building its shipped version)"
msgstr ""

#. type: Content of: <sect1><sect2><note><para>
#: blfs-en/blfs-git/general/prog/rust.xml:183
#, xml-text
msgid ""
"If a recommended dependency is not installed, you'll need to modify the "
"instructions to build and use a shipped copy in the Rustc source tarball "
"instead.  See the Command Explanations section for details."
msgstr ""

#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/blfs-git/general/prog/rust.xml:190
#, xml-text
msgid "Optional"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/prog/rust.xml:192
#, xml-text
msgid ""
"<xref linkend=\"gdb\"/> (used by the test suite if it is present), <xref "
"linkend=\"git\"/> (required by the test suite), <ulink "
"url=\"https://github.com/bytecodealliance/wasmtime/tree/main/cranelift\">cranelift</ulink>,"
" <ulink url=\"https://jemalloc.net/\">jemalloc</ulink>, libgccjit (read "
"command explanation in <xref role=\"nodep\" linkend=\"gcc\"/>), and <ulink "
"url='https://libgit2.org/'>libgit2</ulink>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/prog/rust.xml:202
#, xml-text
msgid "Editor Notes: <ulink url=\"&blfs-wiki;/rust\"/>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/prog/rust.xml:207
#, xml-text
msgid "Installation of Rust"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/prog/rust.xml:210
#, xml-text
msgid ""
"To install into the <filename class=\"directory\">/opt</filename> directory,"
" remove any existing <filename>/opt/rustc</filename> symlink and create a "
"new directory (i.e. with a different name if trying a modified build of the "
"same version).  As the <systemitem class=\"username\">root</systemitem> "
"user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/prog/rust.xml:219
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir -pv /opt/rustc-&rust-version;      &amp;&amp;\n"
"ln -svfn rustc-&rust-version; /opt/rustc</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><note><para>
#: blfs-en/blfs-git/general/prog/rust.xml:224
#, xml-text
msgid ""
"If multiple versions of <application>Rust</application> are installed in "
"<filename class=\"directory\">/opt</filename>, changing to another version "
"only requires changing the <filename> /opt/rustc</filename> symbolic link "
"and then running <command>ldconfig</command>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/prog/rust.xml:232
#, xml-text
msgid ""
"Create a suitable <filename>bootstrap.toml</filename> file which will "
"configure the build."
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/prog/rust.xml:236
#, no-wrap, xml-text
msgid ""
"<userinput>cat &lt;&lt; EOF &gt; bootstrap.toml\n"
"<literal># See bootstrap.toml.example for more possible options,\n"
"# and see src/bootstrap/defaults/bootstrap.dist.toml for a few options\n"
"# automatically set when building from a release tarball\n"
"# (unfortunately, we have to override many of them).\n"
"\n"
"# Tell x.py the editors have reviewed the content of this file\n"
"# and updated it to follow the major changes of the building system,\n"
"# so x.py will not warn us to do such a review.\n"
"change-id = 147888\n"
"\n"
"[llvm]\n"
"# When using system llvm prefer shared libraries\n"
"link-shared = true\n"
"\n"
"# If building the shipped LLVM source, only enable the x86 target\n"
"# instead of all the targets supported by LLVM.\n"
"targets = \"X86\"\n"
"\n"
"[build]\n"
"description = \"for BLFS &version;\"\n"
"\n"
"# Omit docs to save time and space (default is to build them).\n"
"docs = false\n"
"\n"
"# Do not query new versions of dependencies online.\n"
"locked-deps = true\n"
"\n"
"# Only install these extended tools.  Cargo, clippy, rustdoc, and rustfmt\n"
"# are installed by a default rustup installation, and rust-src is needed\n"
"# to build the Rust code in Linux kernel (in case you need such a kernel\n"
"# feature).\n"
"tools = [\"cargo\", \"clippy\", \"rustdoc\", \"rustfmt\", \"src\"]\n"
"\n"
"[install]\n"
"prefix = \"/opt/rustc-&rust-version;\"\n"
"docdir = \"share/doc/rustc-&rust-version;\"\n"
"\n"
"[rust]\n"
"channel = \"stable\"\n"
"\n"
"# Enable the same optimizations as the official upstream build.\n"
"lto = \"thin\"\n"
"codegen-units = 1\n"
"\n"
"# Don't build llvm-bitcode-linker which is only useful for the NVPTX\n"
"# backend that we don't enable.\n"
"llvm-bitcode-linker = false\n"
"\n"
"[target.x86_64-unknown-linux-gnu]\n"
"llvm-config = \"/usr/bin/llvm-config\"\n"
"\n"
"[target.i686-unknown-linux-gnu]\n"
"llvm-config = \"/usr/bin/llvm-config\"</literal>\n"
"EOF</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/prog/rust.xml:316
#, xml-text
msgid ""
"Compile <application>Rust</application> by running the following commands:"
msgstr ""

#.  fixed in 1.58.0, retain as a reminder that fixed crates can be used
#. <screen>
#. <userinput>sed -i -e '/^curl /s/0.4.38/0.4.40/' \
#.        -e '/^curl-sys /s/0.4.48/0.4.50/' \
#.        src/tools/cargo/Cargo.toml &amp;&amp;
#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/prog/rust.xml:324
#, no-wrap, xml-text
msgid ""
"<userinput>export LIBSSH2_SYS_USE_PKG_CONFIG=1\n"
"export LIBSQLITE3_SYS_USE_PKG_CONFIG=1\n"
"./x.py build</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><note><para>
#: blfs-en/blfs-git/general/prog/rust.xml:330
#, xml-text
msgid ""
"The test suite will generate some messages in the <phrase "
"revision=\"sysv\">system log</phrase> <phrase revision=\"systemd\">systemd "
"journal</phrase> for traps on invalid opcodes, and for segmentation faults."
"  In themselves these are nothing to worry about, just a way for the test to"
" be terminated."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/prog/rust.xml:340
#, xml-text
msgid "To run the tests (again using all available CPUs) issue:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/prog/rust.xml:343
#, no-wrap, xml-text
msgid ""
"<userinput>./x.py test --verbose --no-fail-fast | tee rustc-"
"testlog</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/prog/rust.xml:346
#, xml-text
msgid ""
"The test named <filename>tests/run-make/rustdoc-target-modifiers</filename> "
"is known to fail because we've not enabled the AArch64 target in <xref "
"linkend='llvm'/>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/prog/rust.xml:360
#, xml-text
msgid ""
"As with all large test suites, some tests might fail on some machines - if "
"the number of additional failures is low, check the log for 'failures:' and "
"review lines above that, particularly the 'stderr:' lines. Any mention of "
"SIGSEGV or signal 11 in a failing test is a cause for concern."
msgstr ""

#. type: Content of: <sect1><sect2><note><para>
#: blfs-en/blfs-git/general/prog/rust.xml:369
#, xml-text
msgid ""
"If you've stripped <filename class='libraryfile'>/usr/lib/libc.a</filename> "
"with <command>strip --strip-unneeded</command>, all statically-linked Rust "
"programs will crash with SIGSEGV on start-up, causing several tests (for "
"example <filename>tests/ui/process/nofile-limit.rs</filename>) to fail with "
"SIGSEGV."
msgstr ""

#. type: Content of: <sect1><sect2><note><para>
#: blfs-en/blfs-git/general/prog/rust.xml:378
#, xml-text
msgid ""
"It's caused by a Glibc bug affecting Glibc-2.42 and several prior releases, "
"so for now we've replaced <parameter>--strip-unneeded</parameter> with "
"<parameter>--strip-debug</parameter> in both the LFS book and <xref "
"linkend='stripping'/> to work around the problem.  If you hit this issue, "
"rebuild Glibc and replace the <filename "
"class='libraryfile'>/usr/lib/libc.a</filename> file with the unstripped "
"<filename class='libraryfile'>libc.a</filename> from the fresh build."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/prog/rust.xml:391
#, xml-text
msgid ""
"If you get any <emphasis>other</emphasis> failing test which reports an "
"issue number then you should search for that issue.  For example, when rustc"
" &gt;= 1.41.1 was built with a version of sysllvm before 10.0 the test for "
"issue 69225 failed <ulink url=\"https://github.com/rust-"
"lang/rust/issues/69225\"/> and that should be regarded as a critical failure"
" (they released 1.41.1 because of it).  Most other failures will not be "
"critical."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/prog/rust.xml:401
#, xml-text
msgid ""
"Therefore, you should determine the number of failures.  The number of tests"
" which passed and failed can be found by running:"
msgstr ""

#.  split into two lines for narrower screen windows
#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/prog/rust.xml:406
#, no-wrap, xml-text
msgid ""
"<userinput>grep '^test result:' rustc-testlog |\n"
" awk '{sum1 += $4; sum2 += $6} END { print sum1 \" passed; \" sum2 \" failed\" }'</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/prog/rust.xml:410
#, xml-text
msgid ""
"The other available fields are $8 for those which were ignored (i.e. "
"skipped), $10 for 'measured' and $12 for 'filtered out' but both those last "
"two are probably zero."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/prog/rust.xml:416
#, xml-text
msgid "Now, as the &root; user, install the package:"
msgstr ""

#. type: Content of: <sect1><sect2><note><para>
#: blfs-en/blfs-git/general/prog/rust.xml:421
#, xml-text
msgid ""
"If <command>sudo</command> or <command>su</command> is invoked for switching"
" to the &root; user, ensure <envar>LIBSSH2_SYS_USE_PKG_CONFIG</envar> and "
"<envar>LIBSQLITE3_SYS_USE_PKG_CONFIG</envar> are correctly passed or the "
"following command may rebuild <command>cargo</command> with shipped copies "
"of libssh2 and sqlite.  For <command>sudo</command>, use the "
"<option>--preserve-env=LIB{SSH2,SQLITE3}_SYS_USE_PKG_CONFIG</option> option."
"  For <command>su</command>, do <emphasis>not</emphasis> use the "
"<option>-</option> or <option>--login</option> options."
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/prog/rust.xml:434
#, no-wrap, xml-text
msgid "<userinput>./x.py install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/prog/rust.xml:437
#, xml-text
msgid ""
"Still as the &root; user, fix the installation of documentation, symlink a "
"<application>Zsh</application> completion file into the correct location, "
"and move a <application>Bash</application> completion file into the location"
" recommended by the <application>Bash</application> completion maintainers:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/prog/rust.xml:445
#, no-wrap, xml-text
msgid ""
"<userinput>rm -fv /opt/rustc-&rust-version;/share/doc/rustc-&rust-version;/*.old   &amp;&amp;\n"
"install -vm644 README.md                                \\\n"
"               /opt/rustc-&rust-version;/share/doc/rustc-&rust-version; &amp;&amp;\n"
"\n"
"install -vdm755 /usr/share/zsh/site-functions      &amp;&amp;\n"
"ln -sfv /opt/rustc/share/zsh/site-functions/_cargo \\\n"
"        /usr/share/zsh/site-functions\n"
"\n"
"mv -v /etc/bash_completion.d/cargo /usr/share/bash-completion/completions</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/prog/rust.xml:456
#, xml-text
msgid "Finally, unset the exported environment variables:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/prog/rust.xml:459
#, no-wrap, xml-text
msgid "<userinput>unset LIB{SSH2,SQLITE3}_SYS_USE_PKG_CONFIG</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/prog/rust.xml:464
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/prog/rust.xml:467
#, xml-text
msgid ""
"<command>ln -svfn rustc-&rust-version; /opt/rustc</command>: if this is not "
"the first use of the <filename class=\"directory\">/opt/rustc</filename> "
"symlink, overwrite it by forcing, and use the '-n' flag to avoid getting "
"confusing results from e.g. <command>ls -l</command>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/prog/rust.xml:474
#, xml-text
msgid ""
"<literal>tools = [\"cargo\", \"clippy\", \"rustdoc\", "
"\"rustfmt\"]</literal>: only build the tools from the 'default' profile in "
"binary command <command>rustup</command> which are recommended for most "
"users.  The other tools are unlikely to be useful unless using (old) code "
"analyzers or editing the standard library."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/prog/rust.xml:482
#, xml-text
msgid ""
"<literal>channel = \"stable\"</literal>: this ensures only stable features "
"can be used, the default in <filename>bootstrap.toml</filename> is to use "
"development features, which is not appropriate for a released version."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/prog/rust.xml:489
#, xml-text
msgid ""
"<literal>[target.x86_64-unknown-linux-gnu]</literal>: the syntax of "
"<filename>bootstrap.toml</filename> requires an <literal>llvm-"
"config</literal> entry for each target for which system-llvm is to be used. "
"Change the target to <literal>[target.i686-unknown-linux-gnu]</literal> if "
"you are building on 32-bit x86. This whole section should be omitted if you "
"wish to build against the shipped llvm, but the resulting build will be "
"larger and take longer."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/prog/rust.xml:508
#, xml-text
msgid ""
"<command>export LIBSSH2_SYS_USE_PKG_CONFIG=1</command>: Allow "
"<command>cargo</command> to link to system libssh2.  Omit this command if "
"you've not installed <xref linkend='libssh2'/>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/prog/rust.xml:518
#, xml-text
msgid ""
"<command>export LIBSQLITE3_SYS_USE_PKG_CONFIG=1</command>: Allow "
"<command>cargo</command> to link to system sqlite."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/prog/rust.xml:532
#, xml-text
msgid ""
"<parameter>--verbose</parameter>: this switch can sometimes provide more "
"information about a test which fails."
