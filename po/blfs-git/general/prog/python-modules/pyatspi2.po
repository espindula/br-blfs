#. type: Content of: <sect2><sect3><para>
#: blfs-en/blfs-git/general/prog/python-modules/pyatspi2.xml:90
#, xml-text
msgid ""
"To build <application>PyAtSpi2</application>, run the following commands:"
msgstr ""

#. type: Content of: <sect2><sect3><screen>
#: blfs-en/blfs-git/general/prog/python-modules/pyatspi2.xml:94
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr --buildtype=release -D enable_tests=true .. &amp;&amp;\n"
"ninja</userinput>"
msgstr ""

#. type: Content of: <sect2><sect3><para>
#: blfs-en/blfs-git/general/prog/python-modules/pyatspi2.xml:102
#, xml-text
msgid ""
"To run the tests issue: <command>ninja test</command>. The tests need to be "
"run in a graphical environment."
msgstr ""

#. type: Content of: <sect2><sect3><para>
#: blfs-en/blfs-git/general/prog/python-modules/pyatspi2.xml:107
#, xml-text
msgid "To install the module, run the following command as the &root; user:"
msgstr ""

#. type: Content of: <sect2><sect3><screen>
#: blfs-en/blfs-git/general/prog/python-modules/pyatspi2.xml:110
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr ""

