#. type: Content of: <sect2><sect3><title>
#: blfs-en/blfs-git/general/prog/python-modules/pygobject3.xml:93
#, xml-text
msgid "Installation of PyGObject3"
msgstr ""

#. type: Content of: <sect2><sect3><para>
#: blfs-en/blfs-git/general/prog/python-modules/pygobject3.xml:96
#, xml-text
msgid ""
"First, if you do not have <xref linkend=\"gtk4\"/> installed, remove two "
"tests:"
msgstr ""

#. type: Content of: <sect2><sect3><screen>
#: blfs-en/blfs-git/general/prog/python-modules/pygobject3.xml:100
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"pre\">mv -v tests/test_gdbus.py{,.nouse}         &amp;&amp;\n"
"mv -v tests/test_overrides_gtk.py{,.nouse}</userinput>"
msgstr ""

#. type: Content of: <sect2><sect3><para>
#: blfs-en/blfs-git/general/prog/python-modules/pygobject3.xml:104
#, xml-text
msgid ""
"Install <application>pygobject3</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect2><sect3><screen>
#: blfs-en/blfs-git/general/prog/python-modules/pygobject3.xml:108
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr --buildtype=release .. &amp;&amp;\n"
"ninja</userinput>"
msgstr ""

#. type: Content of: <sect2><sect3><para>
#: blfs-en/blfs-git/general/prog/python-modules/pygobject3.xml:115
#, xml-text
msgid ""
"To test the results, issue: <command>ninja test</command>.  An already "
"active graphical session with a bus address is necessary to run the tests."
msgstr ""

#. type: Content of: <sect2><sect3><para>
#: blfs-en/blfs-git/general/prog/python-modules/pygobject3.xml:121
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect2><sect3><screen>
#: blfs-en/blfs-git/general/prog/python-modules/pygobject3.xml:124
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr ""

#. type: Content of: <sect2><sect3><title>
#: blfs-en/blfs-git/general/prog/python-modules/pygobject3.xml:129
#, xml-text
msgid "Command Explanations"
