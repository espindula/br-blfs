#. type: Content of: <sect2><sect3><title>
#: blfs-en/blfs-git/general/prog/python-modules/requests.xml:113
#, xml-text
msgid "Installation of Requests"
msgstr ""

#. type: Content of: <sect2><sect3><para>
#: blfs-en/blfs-git/general/prog/python-modules/requests.xml:116
#, xml-text
msgid ""
"First apply a patch so that the same environment variable already used to "
"point to system certificates in <application>Python3</application> following"
" the installation of <application>make-ca</application> can also be used by "
"this module:"
msgstr ""

#. type: Content of: <sect2><sect3><screen>
#: blfs-en/blfs-git/general/prog/python-modules/requests.xml:122
#, no-wrap, xml-text
msgid ""
"<userinput>patch -Np1 -i ../requests-use_system_certs-1.patch</userinput>"
msgstr ""

#. type: Content of: <sect2><sect3><para>
#: blfs-en/blfs-git/general/prog/python-modules/requests.xml:124
#, xml-text
msgid "Build the module:"
msgstr ""

#. type: Content of: <sect2><sect3><para>
#: blfs-en/blfs-git/general/prog/python-modules/requests.xml:129
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect2><sect3><screen>
#: blfs-en/blfs-git/general/prog/python-modules/requests.xml:132
#, no-wrap, xml-text
msgid "<userinput>&install-wheel; requests</userinput>"
msgstr ""

#. type: Content of: <sect2><sect3><para>
#: blfs-en/blfs-git/general/prog/python-modules/requests.xml:135
#, xml-text
msgid ""
"Assuming <xref linkend=\"pytest\"/> is installed, but the other optional "
"dependencies are not, the installation can be tested with the following "
"commands:"
msgstr ""

#. type: Content of: <sect2><sect3><note><para>
#: blfs-en/blfs-git/general/prog/python-modules/requests.xml:142
#, xml-text
msgid ""
"Some of the setup instructions below may indicate an error due to dependent "
"module versions, but these errors do not affect the test results."
msgstr ""

#. type: Content of: <sect2><sect3><screen>
#: blfs-en/blfs-git/general/prog/python-modules/requests.xml:148
#, no-wrap, xml-text
msgid ""
"<userinput>python3 -m venv --system-site-packages testenv &amp;&amp;\n"
"source testenv/bin/activate                    &amp;&amp;\n"
"pip3 install pytest-mock    \\\n"
"             pytest-httpbin \\\n"
"             pytest-cov     \\\n"
"             pytest-xdist   \\\n"
"             pysocks        \\\n"
"             trustme                           &amp;&amp;\n"
"python3 /usr/bin/pytest tests\n"
"deactivate</userinput>"
msgstr ""

#. type: Content of: <sect2><sect3><note><para>
#: blfs-en/blfs-git/general/prog/python-modules/requests.xml:161
#, xml-text
msgid ""
"See <xref linkend=\"make-ca\"/> for how to set the environment variable, and"
" for how local copies of the Certifi and Requests modules installed in a "
"virtual environment <emphasis>will</emphasis> override the system "
"certificates."
msgstr ""

