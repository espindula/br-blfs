#. type: Content of: <sect2><sect3><para>
#: blfs-en/blfs-git/general/prog/python-modules/sphinx_rtd_theme.xml:91
#, xml-text
msgid ""
"First, tell the package that newer <xref linkend=\"docutils\"/> and <xref "
"linkend=\"sphinx\"/> versions are safe to use:"
msgstr ""

#. type: Content of: <sect2><sect3><screen>
#: blfs-en/blfs-git/general/prog/python-modules/sphinx_rtd_theme.xml:95
#, no-wrap, xml-text
msgid ""
"<userinput>sed -e 's/0.22/0.23/'      \\\n"
"    -e '/sphinx >/s/9/10/' \\\n"
"    -i setup.cfg</userinput>"
msgstr ""

#. type: Content of: <sect2><sect3><para>
#: blfs-en/blfs-git/general/prog/python-modules/sphinx_rtd_theme.xml:100
#, xml-text
