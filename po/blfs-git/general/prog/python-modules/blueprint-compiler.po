#. type: Content of: <sect2><sect3><title>
#: blfs-en/blfs-git/general/prog/python-modules/blueprint-compiler.xml:90
#, xml-text
msgid "Installation of blueprint-compiler"
msgstr ""

#. type: Content of: <sect2><sect3><para>
#: blfs-en/blfs-git/general/prog/python-modules/blueprint-compiler.xml:93
#, xml-text
msgid ""
"Install <application>blueprint-compiler</application> by running the "
"following commands:"
msgstr ""

#. type: Content of: <sect2><sect3><screen>
#: blfs-en/blfs-git/general/prog/python-modules/blueprint-compiler.xml:97
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr --buildtype=release .. &amp;&amp;\n"
"ninja</userinput>"
msgstr ""

#. type: Content of: <sect2><sect3><para>
#: blfs-en/blfs-git/general/prog/python-modules/blueprint-compiler.xml:105
#, xml-text
msgid ""
"To run the tests issue: <command>ninja test</command>. The tests need to be "
"run in a graphical environment, and you must have <xref linkend=\"gtk4\"/> "
"installed."
msgstr ""

#. type: Content of: <sect2><sect3><para>
#: blfs-en/blfs-git/general/prog/python-modules/blueprint-compiler.xml:111
#, xml-text
msgid "Now, as the &root; user:"
msgstr ""

#. type: Content of: <sect2><sect3><screen>
#: blfs-en/blfs-git/general/prog/python-modules/blueprint-compiler.xml:114
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr ""

