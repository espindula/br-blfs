msgid ""
"<parameter>--with-system-zlib</parameter>: This switch forces "
"<application>GDB</application> to use the copy of "
"<application>Zlib</application> installed in LFS."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/prog/gdb.xml:261
#, xml-text
msgid ""
"<parameter>--with-python=/usr/bin/python3</parameter>: This switch forces "
"<application>GDB</application> to use Python 3."
msgstr ""

