#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/prog/vala.xml:105
#, xml-text
msgid "Installation of Vala"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/prog/vala.xml:109
#, xml-text
msgid ""
"First, fix an issue causing <command>valadoc</command> to crash when "
"compiled against graphviz-13 or later:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/prog/vala.xml:113
#, no-wrap, xml-text
msgid ""
"<userinput>patch -Np1 -i ../vala-&vala-"
"version;-graphviz_13_fix-1.patch</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/prog/vala.xml:116
#, xml-text
msgid ""
"Install <application>Vala</application> by running the following commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/prog/vala.xml:120
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr &amp;&amp;\n"
"make bootstrap</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/prog/vala.xml:124
#, xml-text
msgid "To test the results, issue: <command>make check</command>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/prog/vala.xml:128
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/prog/vala.xml:131
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/prog/vala.xml:136
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/prog/vala.xml:139
#, xml-text
msgid ""
"<parameter>bootstrap</parameter>: This <command>make</command> target forces"
" the building system to build the package twice and use the "
"<command>valac</command> executable produced in the first build to "
"regenerate the <filename class=\"extension\">.c</filename> files from the "
"<filename class=\"extension\">.vala</filename> files.  This is needed "
"because the patch changes one of the <filename "
"class=\"extension\">.vala</filename> files. But it is not needed if a "
"<command>valac</command> executable is already installed on the system. In "
"this case, just run <command>make</command>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/prog/vala.xml:151
#, xml-text
msgid ""
"<option>--disable-valadoc</option>: This option is required if <xref "
"linkend=\"graphviz\"/> is not installed."
msgstr ""

