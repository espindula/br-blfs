#, xml-text
msgid "Installation of Apache Ant"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/prog/apache-ant.xml:126
#, xml-text
msgid ""
"Build a limited bootstrap version of <application>Apache Ant</application> "
"using the following command:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/prog/apache-ant.xml:130
#, no-wrap, xml-text
msgid "<userinput>./bootstrap.sh</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/prog/apache-ant.xml:133
#, xml-text
msgid ""
"Download the runtime dependencies using the <filename>fetch.xml</filename> "
"ant build script:"
msgstr ""

#.  A spsce betweem -D and dest makes the build fail.
#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/prog/apache-ant.xml:139
#, no-wrap, xml-text
msgid "<userinput>bootstrap/bin/ant -f fetch.xml -Ddest=optional</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/prog/apache-ant.xml:142
#, xml-text
msgid ""
"Build <application>Apache Ant</application> by running the following "
"command:"
msgstr ""

#.  A spsce betweem -D and dest here passes, but leave it out for consistency.
#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/prog/apache-ant.xml:148
#, no-wrap, xml-text
msgid ""
"<userinput>./build.sh -Ddist.dir=$PWD/ant-&apache-ant-version; "
"dist</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/prog/apache-ant.xml:151
#, xml-text
msgid "Install, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/prog/apache-ant.xml:154
#, no-wrap, xml-text
msgid ""
"<userinput>cp -rv ant-&apache-ant-version; /opt/            &amp;&amp;\n"
"chown -R root:root /opt/ant-&apache-ant-version; &amp;&amp;\n"
"ln -sfv ant-&apache-ant-version; /opt/ant</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/prog/apache-ant.xml:161
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/prog/apache-ant.xml:164
#, xml-text
msgid ""
"<command>bootstrap/bin/ant -f fetch.xml -Ddest=optional</command>: Downloads"
" the missing dependencies to the user's home directory, and copies them into"
" the source tree (in the <filename>lib/optional</filename> directory, where "
"<command>ant</command> picks them up at build time)."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/prog/apache-ant.xml:171
#, xml-text
msgid ""
"<command>./build.sh -Ddist.dir=$PWD/ant-&apache-ant-version; dist</command>:"
" This command builds, tests, then installs the package into a temporary "
"directory."
msgstr ""

