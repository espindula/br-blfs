#, xml-text
msgid "Introduction to Apache Ant"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/prog/apache-ant.xml:29
#, xml-text
msgid ""
"The <application>Apache Ant</application> package is a "
"<application>Java</application>-based build tool. In theory, it is like the "
"<command>make</command> command, but without <command>make</command>'s "
"wrinkles. <application>Ant</application> is different. Instead of a model "
"that is extended with shell-based commands, <application>Ant</application> "
"is extended using <application>Java</application> classes. Instead of "
"writing shell commands, the configuration files are XML-based, calling out a"
" target tree that executes various tasks. Each task is run by an object that"
" implements a particular task interface."
msgstr ""

