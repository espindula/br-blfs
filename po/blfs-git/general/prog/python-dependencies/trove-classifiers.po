#. type: Content of: <sect2><sect3><para>
#: blfs-en/blfs-git/general/prog/python-dependencies/trove-classifiers.xml:82
#, xml-text
msgid ""
"First, hard code the package version into <filename>setup.py</filename> to "
"work around an issue causing the generated wheel to contain an incorrect "
"version string when the <application>calver</application> module is not "
"installed:"
msgstr ""

#. type: Content of: <sect2><sect3><screen>
#: blfs-en/blfs-git/general/prog/python-dependencies/trove-classifiers.xml:88
#, no-wrap, xml-text
msgid ""
"<userinput>sed -i '/calver/s/^/#/;$iversion=\"&trove-classifiers-version;\"'"
" setup.py</userinput>"
msgstr ""

