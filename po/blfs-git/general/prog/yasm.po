#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/prog/yasm.xml:83
#, xml-text
msgid "Installation of yasm"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/prog/yasm.xml:86
#, xml-text
msgid "First, fix a problem when building with gcc-15:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/prog/yasm.xml:89
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"pre\">sed -e 's/def __cplusplus/ defined(__cplusplus) || __STDC_VERSION__ >= 202311L/' \\\n"
"    -i libyasm/bitvect.h</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/prog/yasm.xml:93
#, xml-text
msgid ""
"Install <application>yasm</application> by running the following commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/prog/yasm.xml:97
#, no-wrap, xml-text
msgid ""
"<userinput>sed -i 's#) ytasm.*#)#' Makefile.in &amp;&amp;\n"
"\n"
"./configure --prefix=/usr &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/prog/yasm.xml:103
#, xml-text
msgid "To test the results, issue: <command>make -j1 check</command>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/prog/yasm.xml:111
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/prog/yasm.xml:114
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/prog/yasm.xml:119
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/prog/yasm.xml:122
#, xml-text
msgid ""
"<command>sed -i 's#) ytasm.*#)#' Makefile.in</command>: This sed prevents it"
" compiling 2 programs (vsyasm and ytasm) that are only of use on Microsoft "
"Windows."
msgstr ""

