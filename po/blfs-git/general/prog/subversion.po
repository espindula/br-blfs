#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/prog/subversion.xml:131
#, xml-text
msgid "Installation of Subversion"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/prog/subversion.xml:134
#, xml-text
msgid "First, fix several problems with Python 3.14 and SWIG-4.4:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/prog/subversion.xml:137
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"pre\">patch -Np1 -i ../subversion-&subversion-"
"version;-upstream_fixes-1.patch</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/prog/subversion.xml:140
#, xml-text
msgid ""
"Install <application>Subversion</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/prog/subversion.xml:144
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr            \\\n"
"            --disable-static         \\\n"
"            --with-apache-libexecdir \\\n"
"            --with-utf8proc=internal &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/prog/subversion.xml:151
#, xml-text
msgid ""
"If you have <xref linkend=\"doxygen\"/> installed and you wish to build the "
"API documentation, issue:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/prog/subversion.xml:155
#, no-wrap, xml-text
msgid "<userinput>doxygen doc/doxygen.conf</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/prog/subversion.xml:158
#, xml-text
msgid ""
"If you wish to build the Java bindings pass the <option>--enable-"
"javahl</option> parameter to the <command>configure</command> command. In "
"addition, if you want to run the Java test suite, you have to specify the "
"location of the <application>JUnit</application> file by adding "
"<option>--with-junit=&lt;path to junit jar&gt;</option> (for instance "
"<option>--with-junit=/usr/local/java/lib/junit-4.13.jar</option>)  to "
"<command>configure</command>. The JUnit jar file is no longer included in "
"<xref linkend=\"apache-ant\"/> and must be downloaded separately. To build "
"the Java bindings, issue the following command:"
msgstr ""

#. type: Content of: <sect1><sect2><para><screen>
#: blfs-en/blfs-git/general/prog/subversion.xml:170
#, no-wrap, xml-text
msgid "<command>make -j1 javahl</command>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/prog/subversion.xml:170
#: blfs-en/blfs-git/general/prog/subversion.xml:223
#: blfs-en/blfs-git/general/prog/subversion.xml:234
#, xml-text
msgid "<placeholder type=\"screen\" id=\"0\"/>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/prog/subversion.xml:174
#, xml-text
msgid ""
"If you are going to compile the <application>Ruby</application> bindings, "
"set the C standard to prevent the build from failing:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/prog/subversion.xml:178
#, no-wrap, xml-text
msgid ""
"<command>sed -i 's/Wno-int-to-pointer-cast/std=gnu17/' Makefile</command>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/prog/subversion.xml:181
#, xml-text
msgid ""
"If you want to compile <application>Perl</application>, "
"<application>Python</application>, or <application>Ruby</application> "
"bindings, issue any of the following command:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/prog/subversion.xml:186
#, no-wrap, xml-text
msgid ""
"<command>make swig-pl</command> # for <application>Perl</application>\n"
"<command>make swig-py \\\n"
"     swig_pydir=/usr/lib/python&python3-majorver;/site-packages/libsvn \\\n"
"     swig_pydir_extra=/usr/lib/python&python3-majorver;/site-packages/svn</command> # for <application>Python</application>\n"
"<command>make swig-rb</command> # for <application>Ruby</application>"
msgstr ""

#.  Four tests in
#.       the <filename>
#. commit_tests.py</filename>,
#.       <filename>prop_tests.py</filename>, and
#.       <filename>update_tests.py</filename> suites are known to fail. Due to
#.       changes in Python-3.12, you can expect to see around 200 Syntax
#. Warnings
#.       during the test suite due to invalid escape sequences.
#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/prog/subversion.xml:193
#, xml-text
msgid "To test the results, issue: <command>make check</command>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/prog/subversion.xml:202
#, xml-text
msgid ""
"To test the results of any of the <application>SWIG</application> bindings, "
"you can use any of the following commands: <command>make check-swig-"
"pl</command>, <command>make check-swig-py</command>, or <command>make check-"
"swig-rb</command>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/prog/subversion.xml:210
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/prog/subversion.xml:213
#, no-wrap, xml-text
msgid ""
"<userinput>make install &amp;&amp;\n"
"\n"
"install -v -m755 -d /usr/share/doc/subversion-&subversion-version; &amp;&amp;\n"
"cp      -v -R doc/* /usr/share/doc/subversion-&subversion-version;</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/prog/subversion.xml:219
#, xml-text
msgid ""
"If you built the Java bindings, issue the following command as the "
"<systemitem class=\"username\">root</systemitem> user to install them:"
msgstr ""

#. type: Content of: <sect1><sect2><para><screen>
#: blfs-en/blfs-git/general/prog/subversion.xml:223
#, no-wrap, xml-text
msgid "<command>make install-javahl</command>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/prog/subversion.xml:227
#, xml-text
msgid ""
"If you built the <application>Perl</application>, "
"<application>Python</application>, or <application>Ruby</application> "
"bindings, issue any of the following commands as the <systemitem "
"class=\"username\">root</systemitem> user to install them:"
msgstr ""

#. type: Content of: <sect1><sect2><para><screen>
#: blfs-en/blfs-git/general/prog/subversion.xml:234
#, no-wrap, xml-text
msgid ""
"<command>make install-swig-pl</command>\n"
"<command>make install-swig-py \\\n"
"      swig_pydir=/usr/lib/python&python3-majorver;/site-packages/libsvn \\\n"
"      swig_pydir_extra=/usr/lib/python&python3-majorver;/site-packages/svn</command>\n"
"<command>make install-swig-rb</command>"
msgstr ""

#.  ~~ This explanation is added to the configure above ~~
#.       The <application>
#. JUnit</application> testing framework must be installed,
#.       and the location of the JUnit jar has to be specified by passing the
#.       <option>- -with-junit=&lt;path to junit jar&gt;</option> parameter to
#.       <command>configure</command>. Note that
#. <application>JUnit</application>
#.       is included in <xref linkend="apache-ant"/>, and can be accessed by
#.       passing <option>- -with-junit=/opt/ant/lib/junit-4.12.jar</option>
#.       to <command>configure</command>.
#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/prog/subversion.xml:242
#, xml-text
msgid ""
"The java bindings need to be installed in order for the tests to run, since "
"the tests attempt to look for them in CLASSPATH. To test the results of the "
"Java bindings build, issue <command>LANG=C make check-javahl</command>."
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/prog/subversion.xml:259
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/prog/subversion.xml:265
#, xml-text
msgid ""
"<parameter>--with-apache-libexecdir</parameter>: If <xref "
"linkend=\"apache\"/> is installed, the shared "
"<application>Apache</application> modules are built. This switch allows to "
"have those modules installed to <application>Apache</application>'s "
"configured module dir instead of <filename "
"class=\"directory\">/usr/libexec</filename>. It has no effect if "
"<application>Apache</application> is not installed."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/prog/subversion.xml:275
#, xml-text
msgid ""
"<parameter>--with-utf8proc=internal</parameter>: Remove these switches if "
"you have installed the optional dependencies."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/prog/subversion.xml:280
#, xml-text
msgid ""
"<option>--enable-javahl</option>: enables compilation of Java high level "
"bindings. Running <command>make javahl</command> is necessary to do the "
"compilation."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/prog/subversion.xml:286
#, xml-text
msgid ""
"<option>--with-junit=&lt;location of the junit jar file&gt;</option>: gives "
"the location of the junit jar, otherwise the javahl tests cannot be run."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/prog/subversion.xml:292
#, xml-text
msgid ""
"<option>--disable-gmock</option>: Do not use the Googlemock testing "
"framework."
msgstr ""

