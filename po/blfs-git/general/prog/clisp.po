#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/prog/clisp.xml:104
#, xml-text
msgid "Installation of Clisp"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/prog/clisp.xml:142
#, xml-text
msgid ""
"Install <application>Clisp</application> by running the following commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/prog/clisp.xml:146
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"../configure --srcdir=../  \\\n"
"             --prefix=/usr \\\n"
"             --docdir=/usr/share/doc/clisp-&clisp-version; &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/prog/clisp.xml:155
#, xml-text
msgid "To test the results, issue: <command>make check</command>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/prog/clisp.xml:159
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/prog/clisp.xml:162
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr ""

