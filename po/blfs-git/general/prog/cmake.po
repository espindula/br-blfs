#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/prog/cmake.xml:112
#, xml-text
msgid "Installation of CMake"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/prog/cmake.xml:123
#, xml-text
msgid ""
"Install <application>CMake</application> by running the following commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/prog/cmake.xml:127
#, no-wrap, xml-text
msgid ""
"<userinput>sed -i '/\"lib64\"/s/64//' Modules/GNUInstallDirs.cmake &amp;&amp;\n"
"\n"
"./bootstrap --prefix=/usr        \\\n"
"            --system-libs        \\\n"
"            --mandir=/share/man  \\\n"
"            --no-system-jsoncpp  \\\n"
"            --no-system-cppdap   \\\n"
"            --no-system-librhash \\\n"
"            --docdir=/share/doc/cmake-&cmake-version; &amp;&amp;\n"
"make</userinput>"
msgstr ""

#.  Setting <envar>
#. LC_ALL</envar> is needed to
#.       prevent some test failures when some of the locale variables are
#.       set to non English locales. (I no longer see failures with
#. zh_CN.UTF-8
#.       locale with 3.30.x and 3.31.0.)
#.         One test, RunCMake.FindBoost, is known to fail.
#.         Now cmake-3.27.0.  All tests pass.
#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/prog/cmake.xml:139
#, xml-text
msgid ""
"To test the results, issue: <command>bin/ctest "
"-j<replaceable>$(nproc)</replaceable></command>.  Replace "
"<replaceable>$(nproc)</replaceable> with an integer between 1 and the number"
" of system logical cores if you don't want to use all."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/prog/cmake.xml:154
#, xml-text
msgid ""
"If you want to investigate a problem with a given \"problem1-test\", use "
"<command>bin/ctest -R \"problem1-test\"</command> and, to omit it, use "
"<command>bin/ctest -E \"problem1-test\"</command>. These options can be used"
" together: <command>bin/ctest -R \"problem1-test\" -E "
"\"problem2-test\"</command>.  Option <option>-N</option> can be used to "
"display all available tests, and you can run <command>bin/ctest</command> "
"for a sub-set of tests by using separated by spaces names or numbers as "
"options. Option <option>--help</option> can be used to show all options."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/prog/cmake.xml:166
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/prog/cmake.xml:169
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/prog/cmake.xml:174
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/prog/cmake.xml:177
#, xml-text
msgid ""
"<command>sed ... Modules/GNUInstallDirs.cmake</command>: This command "
"disables applications using cmake from attempting to install files in "
"/usr/lib64/."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/prog/cmake.xml:183
#, xml-text
msgid ""
"<parameter>--system-libs</parameter>: This switch forces the build system to"
" link against the system installed version for all needed libraries but "
"those explicitly specified via a <option>--no-system-*</option> option."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/prog/cmake.xml:190
#, xml-text
msgid ""
"<parameter>--no-system-jsoncpp</parameter> and <parameter>--no-system-"
"cppdap</parameter>: These switches remove the "
"<application>JSON-C++</application> library from the list of system "
"libraries. A bundled version of that library is used instead."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/prog/cmake.xml:197
#, xml-text
msgid ""
"<parameter>--no-system-librhash</parameter>: This switch removes the "
"<application>librhash</application> library from the list of system "
"libraries used. A bundled version of that library is used instead."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/prog/cmake.xml:203
#, xml-text
msgid ""
"<option>--no-system-{curl,libarchive,libuv,nghttp2}</option>: Use the "
"corresponding option in the list for the <command>bootstrap</command> if one"
" of the recommended dependencies is not installed. A bundled version of the "
"dependency will be used instead."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/prog/cmake.xml:210
#, xml-text
msgid ""
"<option>--qt-gui</option>: This switch enables building the "
"<application>Qt</application>-based GUI for "
"<application>CMake</application>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/prog/cmake.xml:216
#, xml-text
msgid ""
"<option>--parallel=</option>: This switch enables performing the "
"<application>CMake</application> bootstrap with multiple jobs at one time.  "
"It's not needed if the <envar>MAKEFLAGS</envar> variable has been already "
"set for using multiple processors following <xref linkend='parallel-"
"builds'/>."
msgstr ""

