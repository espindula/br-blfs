#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/prog/cargo-c.xml:104
#, xml-text
msgid "Installation of cargo-c"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/prog/cargo-c.xml:107
#, xml-text
msgid ""
"First, download a file to ensure that <command>cargo</command> uses the "
"dependency versions specified by the upstream developers when this cargo-c "
"version (&cargo-c-version;) was released.  Without this, the latest versions"
" of the dependencies would be used and they might cause breakages:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/prog/cargo-c.xml:114
#, no-wrap, xml-text
msgid ""
"<userinput>curl -fLO https://github.com/lu-"
"zero/cargo-c/releases/download/v&cargo-c-version;/Cargo.lock</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><note><para>
#: blfs-en/blfs-git/general/prog/cargo-c.xml:118
#, xml-text
msgid ""
"Normally we would put such a download into an <quote>Additional "
"Downloads</quote> section. But in this case we cannot tell the package name "
"and version from the file name <filename>Cargo.lock</filename>, so it's "
"better not to put the ambiguously-named file outside the <filename "
"class='directory'>cargo-c-&cargo-c-version;</filename> directory.  We use "
"<command>curl</command> here because the <xref linkend='curl'/> package "
"should have been installed as a required dependency of <xref "
"linkend='rust'/>."
msgstr ""

#. type: Content of: <sect1><sect2><note><para>
#: blfs-en/blfs-git/general/prog/cargo-c.xml:130
#, xml-text
msgid ""
"The md5sum of the file should be <literal>&cargoc-lock-md5sum;</literal>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/prog/cargo-c.xml:136
#, xml-text
msgid ""
"Install <application>cargo-c</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/prog/cargo-c.xml:140
#, no-wrap, xml-text
msgid ""
"<userinput>export LIBSSH2_SYS_USE_PKG_CONFIG=1    &amp;&amp;\n"
"export LIBSQLITE3_SYS_USE_PKG_CONFIG=1 &amp;&amp;\n"
"\n"
"cargo build --release</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/prog/cargo-c.xml:146
#, xml-text
msgid "To test the results, issue: <command>cargo test --release</command>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/prog/cargo-c.xml:150
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/prog/cargo-c.xml:153
#, no-wrap, xml-text
msgid ""
"<userinput>install -vm755 target/release/cargo-{capi,cbuild,cinstall,ctest} "
"/usr/bin/</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/prog/cargo-c.xml:156
#, xml-text
msgid "Finally, unset the exported environment variables:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/prog/cargo-c.xml:159
#, no-wrap, xml-text
msgid "<userinput>unset LIB{SSH2,SQLITE3}_SYS_USE_PKG_CONFIG</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/prog/cargo-c.xml:164
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/prog/cargo-c.xml:168
#, xml-text
msgid ""
"<command>export LIBSSH2_SYS_USE_PKG_CONFIG=1</command>: Allow "
"<command>cargo</command> to link to system libssh2.  Omit this command if "
"you've not installed <xref linkend='libssh2'/>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/prog/cargo-c.xml:178
#, xml-text
msgid ""
"<command>export LIBSQLITE3_SYS_USE_PKG_CONFIG=1</command>: Allow "
"<command>cargo</command> to link to system sqlite."
msgstr ""

