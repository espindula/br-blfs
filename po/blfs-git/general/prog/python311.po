#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/prog/python311.xml:88
#, xml-text
msgid "Installation of Python 3.11"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/prog/python311.xml:91
#, xml-text
msgid ""
"Install <application>Python 3.11</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/prog/python311.xml:95
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/opt/python3.11 \\\n"
"            --disable-shared         \\\n"
"            --with-system-expat      \\\n"
"            --without-static-libpython &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/prog/python311.xml:102
#, xml-text
msgid ""
"Since this package is only used in very limited situations, tests are not "
"recommended."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/prog/python311.xml:107
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/prog/python311.xml:110
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/prog/python311.xml:115
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/prog/python311.xml:118
#, xml-text
msgid ""
"<command> CXX=\"/usr/bin/g++\" ./configure ...</command>: Avoid an annoying "
"message during configuration."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/prog/python311.xml:123
#, xml-text
msgid ""
"<parameter>--prefix=/opt/python3.11</parameter>: This installs python 3.11 "
"into /opt in order to avoid conflicts with the system version of python, and"
" allows for easy removal/isolation once programs update to python3.12 or "
"later."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/prog/python311.xml:130
#, xml-text
msgid ""
"<parameter>--disable-shared</parameter>: This switch disables building "
"shared libraries. Since all the packages that need python-3.11 have built in"
" modules and don't directly link to python, it is safe to turn off shared "
"library support."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/prog/python311.xml:137
#, xml-text
msgid ""
"<parameter>--with-system-expat</parameter>: This switch enables linking "
"against the system version of <application>Expat</application>."
msgstr ""

