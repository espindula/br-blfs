#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/prog/rust-bindgen.xml:75
#, xml-text
msgid "Installation of rust-bindgen"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/prog/rust-bindgen.xml:78
#, xml-text
msgid ""
"Install <application>rust-bindgen</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/prog/rust-bindgen.xml:82
#, no-wrap, xml-text
msgid "<userinput>cargo build --release</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/prog/rust-bindgen.xml:85
#, xml-text
msgid "To test the results, issue: <command>cargo test --release</command>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/prog/rust-bindgen.xml:89
#, xml-text
msgid "Now, as the &root; user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/prog/rust-bindgen.xml:92
#, no-wrap, xml-text
msgid ""
"<userinput>install -v -m755 target/release/bindgen /usr/bin</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/prog/rust-bindgen.xml:95
#, xml-text
msgid ""
"Still as the &root; user, install the Bash and Zsh completion support files:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/prog/rust-bindgen.xml:99
#, no-wrap, xml-text
msgid ""
"<userinput>bindgen --generate-shell-completions bash \\\n"
"    &gt; /usr/share/bash-completion/completions/bindgen\n"
"bindgen --generate-shell-completions zsh  \\\n"
"    &gt; /usr/share/zsh/site-functions/_bindgen</userinput>"
msgstr ""

