#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/sysutils/lm_sensors.xml:117
#, xml-text
msgid "Installation of lm-sensors"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/sysutils/lm_sensors.xml:120
#, xml-text
msgid ""
"Install <application>lm-sensors</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/sysutils/lm_sensors.xml:124
#, no-wrap, xml-text
msgid ""
"<userinput>make PREFIX=/usr        \\\n"
"     BUILD_STATIC_LIB=0 \\\n"
"     MANDIR=/usr/share/man</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/sysutils/lm_sensors.xml:129
#, xml-text
msgid "This package does not come with a test suite."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/sysutils/lm_sensors.xml:133
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/sysutils/lm_sensors.xml:136
#, no-wrap, xml-text
msgid ""
"<userinput>make PREFIX=/usr        \\\n"
"     BUILD_STATIC_LIB=0 \\\n"
"     MANDIR=/usr/share/man install &amp;&amp;\n"
"\n"
"install -v -m755 -d /usr/share/doc/lm-sensors-&lm-sensors-version; &amp;&amp;\n"
"cp -rv              README INSTALL doc/* \\\n"
"                    /usr/share/doc/lm-sensors-&lm-sensors-version;</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/sysutils/lm_sensors.xml:146
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/sysutils/lm_sensors.xml:149
#, xml-text
msgid ""
"<parameter>BUILD_STATIC_LIB=0</parameter>: This parameter disables compiling"
" and installing the static version of <filename "
"class=\"libraryfile\">libsensors</filename>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/sysutils/lm_sensors.xml:163
#, xml-text
msgid ""
"<option>PROG_EXTRA=sensord</option>: This parameter enables compiling "
"<command>sensord</command>, a daemon that can monitor your system at regular"
" intervals. Compiling <command>sensord</command> requires <ulink "
"url=\"https://oss.oetiker.ch/rrdtool/\">RRDtool</ulink>. Be sure to install "
"RRDtool in <filename class=\"directory\">/usr</filename> by running "
"<command>make prefix=/usr</command> when building it.  Otherwise, lm-sensors"
" will not find it easily."
msgstr ""

