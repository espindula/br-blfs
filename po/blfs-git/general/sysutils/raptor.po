#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/sysutils/raptor.xml:98
#, xml-text
msgid "Installation of Raptor"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/sysutils/raptor.xml:101
#, xml-text
msgid "First, fix an incompatibility with libxml2-2.11.x:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/sysutils/raptor.xml:104
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"pre\">sed -i 's/20627/20627 \\&amp;\\&amp; LIBXML_VERSION"
" &lt; 21100/' src/raptor_libxml.c</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/sysutils/raptor.xml:107
#, xml-text
msgid ""
"Install <application>Raptor</application> by running the following commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/sysutils/raptor.xml:111
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr --disable-static &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/sysutils/raptor.xml:115
#, xml-text
msgid ""
"To test the results, issue: <command>make check</command>.  Several of the "
"XML tests may fail."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/sysutils/raptor.xml:120
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/sysutils/raptor.xml:123
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/sysutils/raptor.xml:128
#, xml-text
msgid "Command Explanations"
msgstr ""

