#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/sysutils/sysstat.xml:83
#, xml-text
msgid "Installation of Sysstat"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/sysutils/sysstat.xml:86
#, xml-text
msgid ""
"Install <application>Sysstat</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/sysutils/sysstat.xml:90
#, no-wrap, xml-text
msgid ""
"<userinput>sa_lib_dir=/usr/lib/sa    \\\n"
"sa_dir=/var/log/sa        \\\n"
"conf_dir=/etc/sysstat     \\\n"
"./configure --prefix=/usr \\\n"
"            --disable-file-attr &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/sysutils/sysstat.xml:98
#, xml-text
msgid "This package does not come with a working test suite."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/sysutils/sysstat.xml:102
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/sysutils/sysstat.xml:105
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/sysutils/sysstat.xml:108
#, xml-text
msgid ""
"Install the systemd units and timers by running the following commands as "
"the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/sysutils/sysstat.xml:112
#, no-wrap, xml-text
msgid ""
"<userinput>install -v -m644 sysstat.service /usr/lib/systemd/system/sysstat.service                      &amp;&amp;\n"
"install -v -m644 cron/sysstat-collect.service /usr/lib/systemd/system/sysstat-collect.service &amp;&amp;\n"
"install -v -m644 cron/sysstat-collect.timer /usr/lib/systemd/system/sysstat-collect.timer     &amp;&amp;\n"
"install -v -m644 cron/sysstat-rotate.service /usr/lib/systemd/system/sysstat-rotate.service   &amp;&amp;\n"
"install -v -m644 cron/sysstat-rotate.timer /usr/lib/systemd/system/sysstat-rotate.timer       &amp;&amp;\n"
"install -v -m644 cron/sysstat-summary.service /usr/lib/systemd/system/sysstat-summary.service &amp;&amp;\n"
"install -v -m644 cron/sysstat-summary.timer /usr/lib/systemd/system/sysstat-summary.timer</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/sysutils/sysstat.xml:121
#, xml-text
msgid ""
"Fix one of the systemd units by running the following command as the "
"<systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/sysutils/sysstat.xml:125
#, no-wrap, xml-text
msgid ""
"<userinput>sed -i \"/^Also=/d\" "
"/usr/lib/systemd/system/sysstat.service</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/sysutils/sysstat.xml:130
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/sysutils/sysstat.xml:133
#, xml-text
msgid ""
"<envar>sa_lib_dir</envar>: This environment variable specifies the location "
"of the package-specific library directory."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/sysutils/sysstat.xml:138
#, xml-text
msgid ""
"<envar>sa_dir</envar>: This environment variable specifies the location of "
"the directory containing the data files."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/sysutils/sysstat.xml:143
#, xml-text
msgid ""
"<envar>conf_dir</envar>: This environment variable specifies the location of"
" the system configuration directory."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/sysutils/sysstat.xml:148
#, xml-text
msgid ""
"<parameter>--disable-file-attr</parameter>: Do not set attributes on files "
"being installed. This parameter causes the installation to ignore the man "
"group variable resulting in the man files having <systemitem "
"class=\"username\">root</systemitem>: <systemitem "
"class=\"groupname\">root</systemitem> ownership."
msgstr ""

#. type: Content of: <sect1><sect2><note><para>
#: blfs-en/blfs-git/general/sysutils/sysstat.xml:157
#, xml-text
msgid ""
"Run <command>./configure --help</command> to see other influential "
"environment variables you can pass to <command>configure</command>.  You may"
" want to use the <envar>history</envar> and <envar>compressafter</envar> "
"variables to customize the amount of data files kept on the system."
msgstr ""

