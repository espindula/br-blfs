#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/sysutils/bluez.xml:116
#, xml-text
msgid "Installation of BlueZ"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/sysutils/bluez.xml:134
#, xml-text
msgid ""
"Install <application>BlueZ</application> by running the following commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/sysutils/bluez.xml:138
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr         \\\n"
"            --sysconfdir=/etc     \\\n"
"            --localstatedir=/var  \\\n"
"            --enable-library      \\\n"
"            --disable-systemd     &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/sysutils/bluez.xml:145
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr         \\\n"
"            --sysconfdir=/etc     \\\n"
"            --localstatedir=/var  \\\n"
"            --enable-library      &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/sysutils/bluez.xml:152
#, xml-text
msgid "To test the results, issue: <userinput>make check</userinput>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/sysutils/bluez.xml:156
#, xml-text
msgid "Now, as the &root; user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/sysutils/bluez.xml:159
#, no-wrap, xml-text
msgid ""
"<userinput>make install &amp;&amp;\n"
"ln -svf ../libexec/bluetooth/bluetoothd /usr/sbin</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/sysutils/bluez.xml:163
#, xml-text
msgid "Install the main configuration file as the &root; user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/sysutils/bluez.xml:166
#, no-wrap, xml-text
msgid ""
"<userinput>install -v -dm755 /etc/bluetooth &amp;&amp;\n"
"install -v -m644 src/main.conf /etc/bluetooth/main.conf</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/sysutils/bluez.xml:170
#, xml-text
msgid "If desired, install the API documentation as the &root; user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/sysutils/bluez.xml:173
#, no-wrap, xml-text
msgid ""
"<userinput>install -v -dm755 /usr/share/doc/bluez-&bluez-version; &amp;&amp;\n"
"install -v -m644 doc/*.txt /usr/share/doc/bluez-&bluez-version;</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/sysutils/bluez.xml:177
#, xml-text
msgid "Install a missing D-Bus service as the &root; user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/sysutils/bluez.xml:180
#, no-wrap, xml-text
msgid ""
"<userinput>install -m644 ./obexd/src/org.bluez.obex.service "
"/usr/share/dbus-1/services</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/sysutils/bluez.xml:186
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/sysutils/bluez.xml:189
#, xml-text
msgid ""
"<parameter>--enable-library</parameter>: This switch enables building the "
"<application>BlueZ</application> 4 compatibility library which is required "
"by some applications."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/sysutils/bluez.xml:195
#, xml-text
msgid ""
"<parameter>--disable-systemd</parameter>: This switch is needed because "
"<application>systemd</application> is not part of LFS/BLFS. If you are using"
" systemd, remove this switch."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/sysutils/bluez.xml:201
#, xml-text
msgid ""
"<option>--disable-manpages</option>: This switch disables generating the "
"manual pages. Add this switch if you don't have <xref linkend=\"docutils\"/>"
" installed."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/sysutils/bluez.xml:207
#, xml-text
msgid ""
"<command>ln -svf ../libexec/bluetooth/bluetoothd /usr/sbin</command>: This "
"command makes access to the bluetooth daemon more convenient."
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/sysutils/bluez.xml:214
#, xml-text
msgid "Configuring BlueZ"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><title>
#: blfs-en/blfs-git/general/sysutils/bluez.xml:217
#, xml-text
msgid "Configuration Files"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/blfs-git/general/sysutils/bluez.xml:219
#, xml-text
msgid ""
"<filename>/etc/bluetooth/main.conf</filename> is installed automatically "
"during the install.  Additionally, there are three supplementary "
"configuration files.  /etc/sysconfig/bluetooth is installed as a part of the"
" boot script below.  In addition, you optionally can install the following, "
"as the &root; user:"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/blfs-git/general/sysutils/bluez.xml:227
#, xml-text
msgid ""
"<filename>/etc/bluetooth/main.conf</filename> is installed automatically "
"during the installation. Additionally, there are two supplementary "
"configuration files. You can optionally install the following files as the "
"&root; user:"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><screen>
#: blfs-en/blfs-git/general/sysutils/bluez.xml:233
#, no-wrap, xml-text
msgid ""
"<userinput>cat > /etc/bluetooth/rfcomm.conf &lt;&lt; \"EOF\"</userinput>\n"
"<literal># Start rfcomm.conf\n"
"# Set up the RFCOMM configuration of the Bluetooth subsystem in the Linux kernel.\n"
"# Use one line per command\n"
"# See the rfcomm man page for options\n"
"\n"
"\n"
"# End of rfcomm.conf</literal>\n"
"EOF"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><screen>
#: blfs-en/blfs-git/general/sysutils/bluez.xml:243
#, no-wrap, xml-text
msgid ""
"<userinput>cat > /etc/bluetooth/uart.conf &lt;&lt; \"EOF\"</userinput>\n"
"<literal># Start uart.conf\n"
"# Attach serial devices via UART HCI to BlueZ stack\n"
"# Use one line per device\n"
"# See the hciattach man page for options\n"
"\n"
"# End of uart.conf</literal>\n"
"EOF"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><indexterm><primary>
#: blfs-en/blfs-git/general/sysutils/bluez.xml:254
#, xml-text
msgid "/etc/bluetooth/main.conf"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><title>
#: blfs-en/blfs-git/general/sysutils/bluez.xml:260
#, xml-text
msgid ""
"<phrase revision=\"sysv\">Boot Script</phrase> <phrase "
"revision=\"systemd\">Systemd Bluez Services</phrase>"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/blfs-git/general/sysutils/bluez.xml:264
#, xml-text
msgid ""
"To automatically start the <command>bluetoothd</command> daemon when the "
"system is rebooted, install the "
"<filename>/etc/rc.d/init.d/bluetooth</filename> bootscript from the <xref "
"linkend=\"bootscripts\"/> package."
msgstr ""

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/blfs-git/general/sysutils/bluez.xml:271
#, xml-text
msgid ""
"To start the <command>bluetoothd</command> daemon at boot, enable the "
"previously installed systemd unit by running the following command as the "
"&root; user:"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><screen>
#: blfs-en/blfs-git/general/sysutils/bluez.xml:276
#, no-wrap, xml-text
msgid "<userinput>systemctl enable bluetooth</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/blfs-git/general/sysutils/bluez.xml:279
#, xml-text
msgid ""
"To start the <command>obexd</command> daemon for a user session (to support "
"some Bluetooth programs using it), enable the previously installed systemd "
"unit for all users by running the following command as the &root; user:"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><screen>
#: blfs-en/blfs-git/general/sysutils/bluez.xml:285
#, no-wrap, xml-text
msgid "<userinput>systemctl enable --global obex</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><indexterm><primary>
#: blfs-en/blfs-git/general/sysutils/bluez.xml:288
#, xml-text
msgid "bluetooth"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><screen>
#: blfs-en/blfs-git/general/sysutils/bluez.xml:291
#, no-wrap, xml-text
msgid "<userinput>make install-bluetooth</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><note><para>
#: blfs-en/blfs-git/general/sysutils/bluez.xml:296
#, xml-text
msgid ""
"<application>Systemd</application> will start the Bluetooth daemon only when"
" a bluetooth device is detected on the system."
msgstr ""

