#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/sysutils/udisks2.xml:117
#, xml-text
msgid "Installation of UDisks"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/sysutils/udisks2.xml:129
#, xml-text
msgid ""
"Install <application>UDisks</application> by running the following commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/sysutils/udisks2.xml:133
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr        \\\n"
"            --sysconfdir=/etc    \\\n"
"            --localstatedir=/var \\\n"
"            --disable-static     \\\n"
"            --enable-available-modules &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/sysutils/udisks2.xml:141
#, xml-text
msgid ""
"To test the results, issue: <command>make check</command>. A more thorough "
"test can be run with <command>make ci</command>. You must first create the "
"directories <filename class=\"directory\">/var/run/udisks2</filename> and "
"<filename class=\"directory\">/var/lib/udisks2</filename>, and the optional "
"python modules should be present."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/sysutils/udisks2.xml:150
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/sysutils/udisks2.xml:153
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/sysutils/udisks2.xml:157
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/sysutils/udisks2.xml:166
#, xml-text
msgid ""
"<parameter>--enable-available-modules</parameter>: This switch enables "
"additional <application>UDisks2</application> functionalities if <xref "
"linkend='libblockdev'/> has been built with optional dependencies."
msgstr ""

