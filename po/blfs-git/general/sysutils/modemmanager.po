#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/sysutils/modemmanager.xml:98
#, xml-text
msgid "Installation of ModemManager"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/sysutils/modemmanager.xml:101
#, xml-text
msgid ""
"Install <application>ModemManager</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/sysutils/modemmanager.xml:105
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup ..                 \\\n"
"      --prefix=/usr            \\\n"
"      --buildtype=release      \\\n"
"      -D bash_completion=false \\\n"
"      -D qrtr=false            \\\n"
"      -D systemdsystemunitdir=no &amp;&amp;\n"
"ninja</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/sysutils/modemmanager.xml:116
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup ..                 \\\n"
"      --prefix=/usr            \\\n"
"      --buildtype=release      \\\n"
"      -D bash_completion=false \\\n"
"      -D qrtr=false            &amp;&amp;\n"
"ninja</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/sysutils/modemmanager.xml:127
#, xml-text
msgid "To test the results, issue: <command>ninja test</command>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/sysutils/modemmanager.xml:131
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/sysutils/modemmanager.xml:134
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/sysutils/modemmanager.xml:140
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/sysutils/modemmanager.xml:146
#, xml-text
msgid ""
"<parameter>-D bash_completion=false</parameter>: Use this option if the "
"external <ulink url=\"https://github.com/scop/bash-completion\">bash-"
"completion</ulink> package is not installed."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/sysutils/modemmanager.xml:153
#, xml-text
msgid ""
"<parameter>-D qrtr=false</parameter>: This switch disables support for the "
"QRTR protocol which needs the external <ulink "
"url=\"https://gitlab.freedesktop.org/mobile-broadband/libqrtr-"
"glib\">libqrtr-glib</ulink> package."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/sysutils/modemmanager.xml:159
#, xml-text
msgid ""
"<parameter>-D systemdsystemunitdir=no</parameter>: This switch prevents "
"<application>meson</application> from looking for the systemd units "
"directory and failing since it is not available on SysV systems."
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/sysutils/modemmanager.xml:167
#, xml-text
msgid "Configuring ModemManager"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><title>
#: blfs-en/blfs-git/general/sysutils/modemmanager.xml:170
#, xml-text
msgid "Systemd Units"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/blfs-git/general/sysutils/modemmanager.xml:173
#, xml-text
msgid ""
"To start the <command>ModemManager</command> daemon at boot, enable the "
"previously installed systemd unit by running the following command as the "
"<systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><screen>
#: blfs-en/blfs-git/general/sysutils/modemmanager.xml:182
#, no-wrap, xml-text
msgid "<userinput>systemctl enable ModemManager</userinput>"
msgstr ""

