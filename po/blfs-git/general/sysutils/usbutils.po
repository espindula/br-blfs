#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/sysutils/usbutils.xml:85
#, xml-text
msgid "Installation of USB Utils"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/sysutils/usbutils.xml:88
#, xml-text
msgid ""
"Install <application>USB Utils</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/sysutils/usbutils.xml:92
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup ..            \\\n"
"      --prefix=/usr       \\\n"
"      --buildtype=release &amp;&amp;\n"
"\n"
"ninja</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/sysutils/usbutils.xml:102
#, xml-text
msgid "This package does not come with a test suite."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/sysutils/usbutils.xml:106
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/sysutils/usbutils.xml:109
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/sysutils/usbutils.xml:112
#, xml-text
msgid ""
"For the <filename>usb.ids</filename> data file, install the <xref "
"linkend='hwdata'/> package."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/sysutils/usbutils.xml:117
#, xml-text
msgid ""
"The script <command>lsusb.py</command> displays information in a more easily"
" readable form than <command>lsusb</command>. To find the options, use "
"<command>lsusb.py -h</command>. One form of use recommended by the developer"
" is <command>lsusb.py -ciu</command>."
msgstr ""

