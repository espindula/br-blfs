#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/sysutils/dbus.xml:130
#, xml-text
msgid "Installation of D-Bus"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/sysutils/dbus.xml:133
#, xml-text
msgid ""
"Install <application>D-Bus</application> by running the following commands "
"(you may wish to review the meson_options.txt file first and add any "
"additional desired options to the meson setup line below):"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/sysutils/dbus.xml:138
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr          \\\n"
"            --buildtype=release    \\\n"
"            --wrap-mode=nofallback \\</userinput><userinput revision='sysv'>\n"
"            -D systemd=disabled    \\</userinput><userinput>\n"
"            .. &amp;&amp;\n"
"ninja</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/sysutils/dbus.xml:149
#, xml-text
msgid "See below for test instructions."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/sysutils/dbus.xml:153
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/sysutils/dbus.xml:156
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/sysutils/dbus.xml:159
#, xml-text
msgid ""
"If you are using a DESTDIR install, <command>dbus-daemon-launch-"
"helper</command> needs to be fixed afterwards. Issue, as <systemitem "
"class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/sysutils/dbus.xml:165
#, no-wrap, xml-text
msgid ""
"<userinput>chown -v root:messagebus /usr/libexec/dbus-daemon-launch-helper &amp;&amp;\n"
"chmod -v      4750       /usr/libexec/dbus-daemon-launch-helper</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/sysutils/dbus.xml:169
#, xml-text
msgid ""
"If you are still building your system in chroot or you did not start the "
"daemon yet, but you want to compile some packages that require "
"<application>D-Bus</application>, generate the "
"<application>D-Bus</application> UUID to avoid warnings when compiling some "
"packages with the following command as the <systemitem "
"class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/sysutils/dbus.xml:177
#, no-wrap, xml-text
msgid "<userinput>dbus-uuidgen --ensure</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/sysutils/dbus.xml:180
#, xml-text
msgid ""
"If using <xref linkend=\"elogind\"/>, create a symlink to the "
"<filename>/var/lib/dbus/machine-id</filename> file:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/sysutils/dbus.xml:184
#, no-wrap, xml-text
msgid "<userinput>ln -sfv /var/lib/dbus/machine-id /etc</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/sysutils/dbus.xml:187
#, xml-text
msgid ""
"Finally, still as the &root; user, rename the documentation directory (it "
"only exists if the optional dependencies are satisfied for at least one "
"documentation format) to make it versioned:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/sysutils/dbus.xml:192
#, no-wrap, xml-text
msgid ""
"<userinput>if [ -e /usr/share/doc/dbus ]; then\n"
"  rm -rf /usr/share/doc/dbus-&dbus-version;    &amp;&amp;\n"
"  mv -v  /usr/share/doc/dbus{,-&dbus-version;}\n"
"fi</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/sysutils/dbus.xml:202
#, xml-text
msgid ""
"Many tests are disabled unless both <xref linkend=\"dbus-python\"/> and "
"<xref linkend=\"pygobject3\"/> have been installed.  They must be run as an "
"unprivileged user from a local session with bus address.  To run the "
"standard tests issue <command>ninja test</command>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/sysutils/dbus.xml:213
#, xml-text
msgid ""
"If you want to run the unit regression tests, meson requires additional "
"parameters which expose additional functionality in the binaries that are "
"not intended to be used in a production build of "
"<application>D-Bus</application>.  If you would like to run the tests, issue"
" the following commands (for the tests, you don't need to build the docs):"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/sysutils/dbus.xml:221
#, no-wrap, xml-text
msgid ""
"<userinput>meson configure -D asserts=true -D intrusive_tests=true &amp;&amp;\n"
"ninja test</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/sysutils/dbus.xml:236
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/sysutils/dbus.xml:242
#, xml-text
msgid ""
"<parameter>-D systemd=disabled</parameter>: Don't install systemd support "
"files even if <systemitem class='library'>libsystemd</systemitem> exists "
"(i.e.  the <xref linkend='elogind'/> package is installed)."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/sysutils/dbus.xml:249
#, xml-text
msgid ""
"<parameter>-D intrusive_tests=true</parameter>: Builds extra parts of the "
"code to support all tests. Do not use on a production build."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/sysutils/dbus.xml:254
#, xml-text
msgid ""
"<parameter>-D asserts=true</parameter>: Enables debugging code to run "
"assertions for statements normally assumed to be true. This prevents a "
"warning that '<parameter>-D asserts=true</parameter>' on its own is only "
"useful for profiling and might not give true results for all tests, but adds"
" its own NOTE that this should not be used in a production build."
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/sysutils/dbus.xml:264
#, xml-text
msgid "Configuring D-Bus"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><title>
#: blfs-en/blfs-git/general/sysutils/dbus.xml:267
#, xml-text
msgid "Config Files"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/blfs-git/general/sysutils/dbus.xml:270
#, xml-text
msgid ""
"<filename>/etc/dbus-1/session.conf</filename>, "
"<filename>/etc/dbus-1/system.conf</filename> and "
"<filename>/etc/dbus-1/system.d/*</filename>"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><indexterm><primary>
#: blfs-en/blfs-git/general/sysutils/dbus.xml:276
#, xml-text
msgid "/etc/dbus-1/session.conf"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><indexterm><primary>
#: blfs-en/blfs-git/general/sysutils/dbus.xml:280
#, xml-text
msgid "/etc/dbus-1/system.conf"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><indexterm><primary>
#: blfs-en/blfs-git/general/sysutils/dbus.xml:284
#, xml-text
msgid "/etc/dbus-1/system.d/*"
msgstr ""

#. type: Attribute 'xreflabel' of: <sect1><sect2><sect3>
#: blfs-en/blfs-git/general/sysutils/dbus.xml:289
#, xml-text
msgid "D-Bus custom services directory"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><title>
#: blfs-en/blfs-git/general/sysutils/dbus.xml:290
#, xml-text
msgid "Configuration Information"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/blfs-git/general/sysutils/dbus.xml:293
#, xml-text
msgid ""
"The configuration files listed above should probably not be modified. If "
"changes are required, you should create <filename>/etc/dbus-1/session-"
"local.conf</filename> and/or <filename>/etc/dbus-1/system-"
"local.conf</filename> and make any desired changes to these files."
msgstr ""

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/blfs-git/general/sysutils/dbus.xml:301
#, xml-text
msgid ""
"If any packages install a <application>D-Bus</application> "
"<filename>.service</filename> file outside of the standard <filename "
"class=\"directory\">/usr/share/dbus-1/services</filename> directory, that "
"directory should be added to the local session configuration.  For instance,"
" <filename class=\"directory\">/usr/local/share/dbus-1/services</filename> "
"can be added by performing the following commands as the <systemitem "
"class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><screen>
#: blfs-en/blfs-git/general/sysutils/dbus.xml:312
#, no-wrap, xml-text
msgid ""
"<userinput>cat &gt; /etc/dbus-1/session-local.conf &lt;&lt; \"EOF\"\n"
"<literal>&lt;!DOCTYPE busconfig PUBLIC\n"
" \"-//freedesktop//DTD D-BUS Bus Configuration 1.0//EN\"\n"
" \"http://www.freedesktop.org/standards/dbus/1.0/busconfig.dtd\"&gt;\n"
"&lt;busconfig&gt;\n"
"\n"
"  &lt;!-- Search for .service files in /usr/local --&gt;\n"
"  &lt;servicedir&gt;/usr/local/share/dbus-1/services&lt;/servicedir&gt;\n"
"\n"
"&lt;/busconfig&gt;</literal>\n"
"EOF</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><title>
#: blfs-en/blfs-git/general/sysutils/dbus.xml:327
#, xml-text
msgid "D-Bus Session Daemon"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/blfs-git/general/sysutils/dbus.xml:330
#, xml-text
msgid ""
"To automatically start <command>dbus-daemon</command> when the system is "
"rebooted, install the <filename>/etc/rc.d/init.d/dbus</filename> bootscript "
"from the <xref linkend=\"bootscripts\"/> package."
msgstr ""

#. type: Content of: <sect1><sect2><sect3><indexterm><primary>
#: blfs-en/blfs-git/general/sysutils/dbus.xml:337
#, xml-text
msgid "dbus"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><screen>
#: blfs-en/blfs-git/general/sysutils/dbus.xml:340
#, no-wrap, xml-text
msgid "<userinput>make install-dbus</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/blfs-git/general/sysutils/dbus.xml:343
#, xml-text
msgid ""
"If this is the first time to install <application>D-Bus</application> on the"
" system and you are not operating in a chroot environment, you can "
"immediately start <command>dbus-daemon</command> without rebooting the "
"system:"
msgstr ""

#.  nodump because maybe the user is building in chroot
#. type: Content of: <sect1><sect2><sect3><screen>
#: blfs-en/blfs-git/general/sysutils/dbus.xml:350
#, no-wrap, xml-text
msgid "<userinput>/etc/init.d/dbus start</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/blfs-git/general/sysutils/dbus.xml:353
#, xml-text
msgid ""
"Note that this boot script only starts the system-wide "
"<application>D-Bus</application> daemon. Each user requiring access to "
"<application>D-Bus</application> services will also need to run a session "
"daemon as well. There are many methods you can use to start a session daemon"
" using the <command>dbus-launch</command> command. Review the <command>dbus-"
"launch</command> man page for details about the available parameters and "
"options. Here are some suggestions and examples:"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/blfs-git/general/sysutils/dbus.xml:364
#, xml-text
msgid ""
"There are many methods you can use to start a session daemon using the "
"<command>dbus-launch</command> command. Review the <command>dbus-"
"launch</command> man page for details about the available parameters and "
"options. Here are some suggestions and examples:"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><itemizedlist><listitem><para>
#: blfs-en/blfs-git/general/sysutils/dbus.xml:375
#, xml-text
msgid ""
"Add <command>dbus-launch</command> to the line in the "
"<filename>~/.xinitrc</filename> file that starts your graphical desktop "
"environment."
msgstr ""

#. type: Content of: <sect1><sect2><sect3><itemizedlist><listitem><para>
#: blfs-en/blfs-git/general/sysutils/dbus.xml:382
#, xml-text
msgid ""
"If you use <command>gdm</command> or some other display manager that calls "
"the <filename>~/.xsession</filename> file, you can add <command>dbus-"
"launch</command> to the line in your <filename>~/.xsession</filename> file "
"that starts your graphical desktop environment. The syntax would be similar "
"to the example in the <filename>~/.xinitrc</filename> file."
msgstr ""

#. type: Content of: <sect1><sect2><sect3><itemizedlist><listitem><para>
#: blfs-en/blfs-git/general/sysutils/dbus.xml:392
#, xml-text
msgid ""
"The examples shown previously use <command>dbus-launch</command> to specify "
"a program to be run. This has the benefit (when also using the "
"<parameter>--exit-with-x11</parameter> parameter) of stopping the session "
"daemon when the specified program is stopped. You can also start the session"
" daemon in your system or personal startup scripts by adding the following "
"lines:"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><itemizedlist><listitem><screen>
#: blfs-en/blfs-git/general/sysutils/dbus.xml:401
#, no-wrap, xml-text
msgid ""
"<userinput><literal># Start the D-Bus session daemon\n"
"eval `dbus-launch`\n"
"export DBUS_SESSION_BUS_ADDRESS</literal></userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><itemizedlist><listitem><para>
#: blfs-en/blfs-git/general/sysutils/dbus.xml:406
#, xml-text
msgid ""
"This method will not stop the session daemon when you exit your shell, "
"therefore you should add the following line to your "
"<filename>~/.bash_logout</filename> file:"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><itemizedlist><listitem><screen>
#: blfs-en/blfs-git/general/sysutils/dbus.xml:411
#, no-wrap, xml-text
msgid ""
"<userinput><literal># Kill the D-Bus session daemon\n"
"kill $DBUS_SESSION_BUS_PID</literal></userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
