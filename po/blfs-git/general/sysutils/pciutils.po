#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/sysutils/pciutils.xml:80
#, xml-text
msgid "Installation of PCI Utils"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/sysutils/pciutils.xml:83
#, xml-text
msgid ""
"Prevent the installation of the <filename>pci.ids</filename> file to avoid a"
" conflict with the <xref linkend='hwdata'/> package:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/sysutils/pciutils.xml:87
#, no-wrap, xml-text
msgid ""
"<userinput>sed -r '/INSTALL/{/PCI_IDS|update-pciids /d; s/update-pciids.8//}' \\\n"
"    -i Makefile</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/sysutils/pciutils.xml:91
#, xml-text
msgid ""
"Install <application>PCI Utils</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/sysutils/pciutils.xml:95
#, no-wrap, xml-text
msgid ""
"<userinput>make PREFIX=/usr                \\\n"
"     SHAREDIR=/usr/share/hwdata \\\n"
"     SHARED=yes</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/sysutils/pciutils.xml:100
#, xml-text
msgid "This package does not come with a test suite."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/sysutils/pciutils.xml:104
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/sysutils/pciutils.xml:107
#, no-wrap, xml-text
msgid ""
"<userinput>make PREFIX=/usr                \\\n"
"     SHAREDIR=/usr/share/hwdata \\\n"
"     SHARED=yes                 \\\n"
"     install install-lib        &amp;&amp;\n"
"\n"
"chmod -v 755 /usr/lib/libpci.so</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/sysutils/pciutils.xml:115
#, xml-text
msgid ""
"Next, install the <xref linkend='hwdata'/> package for the "
"<filename>pci.ids</filename> file."
msgstr ""

