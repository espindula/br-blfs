#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/sysutils/cpio.xml:79
#, xml-text
msgid "Installation of cpio"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/sysutils/cpio.xml:82
#, xml-text
msgid "Add a workaround for an issue shown by gcc15:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/sysutils/cpio.xml:84
#, no-wrap, xml-text
msgid ""
"<userinput>sed -e \"/^extern int (\\*xstat)/s/()/(const char * restrict,  struct stat * restrict)/\" \\\n"
"    -i src/extern.h\n"
"sed -e \"/^int (\\*xstat)/s/()/(const char * restrict,  struct stat * restrict)/\" \\\n"
"    -i src/global.c</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/sysutils/cpio.xml:90
#, xml-text
msgid ""
"Install <application>cpio</application> by running the following commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/sysutils/cpio.xml:94
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr \\\n"
"            --enable-mt   \\\n"
"            --with-rmt=/usr/libexec/rmt &amp;&amp;\n"
"make &amp;&amp;\n"
"makeinfo --html            -o doc/html      doc/cpio.texi &amp;&amp;\n"
"makeinfo --html --no-split -o doc/cpio.html doc/cpio.texi &amp;&amp;\n"
"makeinfo --plaintext       -o doc/cpio.txt  doc/cpio.texi</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/sysutils/cpio.xml:103
#, xml-text
msgid ""
"If you have <xref linkend=\"texlive\"/> installed and wish to create PDF or "
"Postscript documentation, issue one or both of the following commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/sysutils/cpio.xml:107
#, no-wrap, xml-text
msgid ""
"<userinput>make -C doc pdf &amp;&amp;\n"
"make -C doc ps</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/sysutils/cpio.xml:111
#, xml-text
msgid "To test the results, issue: <command>make check</command>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/sysutils/cpio.xml:115
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/sysutils/cpio.xml:118
#, no-wrap, xml-text
msgid ""
"<userinput>make install &amp;&amp;\n"
"install -v -m755 -d /usr/share/doc/cpio-&cpio-version;/html &amp;&amp;\n"
"install -v -m644    doc/html/* \\\n"
"                    /usr/share/doc/cpio-&cpio-version;/html &amp;&amp;\n"
"install -v -m644    doc/cpio.{html,txt} \\\n"
"                    /usr/share/doc/cpio-&cpio-version;</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/sysutils/cpio.xml:126
#, xml-text
msgid ""
"If you built PDF or Postscript documentation, install it by issuing the "
"following commands as the <systemitem class=\"username\">root</systemitem> "
"user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/sysutils/cpio.xml:132
#, no-wrap, xml-text
msgid ""
"<userinput>install -v -m644 doc/cpio.{pdf,ps,dvi} \\\n"
"                 /usr/share/doc/cpio-&cpio-version;</userinput>"
msgstr ""

