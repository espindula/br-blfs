#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/sysutils/xdotool.xml:85
#, xml-text
msgid "Installation of xdotool"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/sysutils/xdotool.xml:88
#, xml-text
msgid "First, fix an invalid path in an installed pkg-config file:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/sysutils/xdotool.xml:91
#, no-wrap, xml-text
msgid "<userinput>sed -i 's#/local##' libxdo.pc</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/sysutils/xdotool.xml:94
#, xml-text
msgid ""
"Install <application>xdotool</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/sysutils/xdotool.xml:98
#, no-wrap, xml-text
msgid "<userinput>make WITHOUT_RPATH_FIX=1</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/sysutils/xdotool.xml:101
#, xml-text
msgid "To run the tests, do:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/sysutils/xdotool.xml:104
#, no-wrap, xml-text
msgid ""
"<userinput>cd t\n"
"make all-headless\n"
"cd ..</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/sysutils/xdotool.xml:109
#, xml-text
msgid "Now, as the &root; user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/sysutils/xdotool.xml:112
#, no-wrap, xml-text
msgid ""
"<userinput>make PREFIX=/usr INSTALLMAN=/usr/share/man install</userinput>"
msgstr ""

