#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/sysutils/accountsservice.xml:107
#, xml-text
msgid "Installation of AccountsService"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/sysutils/accountsservice.xml:110
#, xml-text
msgid ""
"First, rename a directory whose presence prevents the build system from "
"running if <xref linkend=\"python-dbusmock\"/> is not installed:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/sysutils/accountsservice.xml:114
#, no-wrap, xml-text
msgid "<userinput>mv tests/dbusmock{,-tests}</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/sysutils/accountsservice.xml:117
#, xml-text
msgid ""
"Then fix a test script so that the new directory is found, and adapt it for "
"Python 3.12.0 or later:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/sysutils/accountsservice.xml:121
#, no-wrap, xml-text
msgid ""
"<userinput>sed -e '/accounts_service\\.py/s/dbusmock/dbusmock-tests/' \\\n"
"    -e 's/assertEquals/assertEqual/'                      \\\n"
"    -i tests/test-libaccountsservice.py</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/sysutils/accountsservice.xml:126
#, xml-text
msgid ""
"Fix one test that fails if the <option>en_IE.UTF-8</option> locale is not "
"installed:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/sysutils/accountsservice.xml:130
#, no-wrap, xml-text
msgid ""
"<userinput>sed -i '/^SIMULATED_SYSTEM_LOCALE/s/en_IE.UTF-8/en_HK.iso88591/' "
"tests/test-daemon.py</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/sysutils/accountsservice.xml:133
#, xml-text
msgid ""
"Install <application>AccountsService</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/sysutils/accountsservice.xml:137
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup ..             \\\n"
"      --prefix=/usr        \\\n"
"      --buildtype=release  \\\n"
"      -D admin_group=adm   \\\n"
"      -D elogind=true      \\\n"
"      -D systemdsystemunitdir=no</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/sysutils/accountsservice.xml:147
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup ..            \\\n"
"      --prefix=/usr       \\\n"
"      --buildtype=release \\\n"
"      -D admin_group=adm</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/sysutils/accountsservice.xml:158
#, xml-text
msgid ""
"Now adapt the shipped mocklibc copy to allow building the test suite with "
"GCC 14 or later:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/sysutils/accountsservice.xml:162
#, no-wrap, xml-text
msgid ""
"<userinput>grep 'print_indent'     ../subprojects/mocklibc-1.0/src/netgroup.c \\\n"
"     | sed 's/ {/;/' >> ../subprojects/mocklibc-1.0/src/netgroup.h &amp;&amp;\n"
"sed -i '1i#include &lt;stdio.h&gt;'                                      \\\n"
"    ../subprojects/mocklibc-1.0/src/netgroup.h</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/sysutils/accountsservice.xml:168
#, xml-text
msgid "Build the package:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/sysutils/accountsservice.xml:171
#, no-wrap, xml-text
msgid "<userinput>ninja</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/sysutils/accountsservice.xml:174
#, xml-text
msgid "To test the package, issue <command>ninja test</command>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/sysutils/accountsservice.xml:178
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/sysutils/accountsservice.xml:181
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/sysutils/accountsservice.xml:186
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/sysutils/accountsservice.xml:192
#, xml-text
msgid ""
"<parameter>-D admin_group=adm</parameter>: This switch sets the group for "
"administrator accounts."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/sysutils/accountsservice.xml:197
#, xml-text
msgid ""
"<option>-D docbook=true</option>: This switch enables building the D-Bus "
"interface API documentation (needs <xref linkend=\"xmlto\"/>)."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/sysutils/accountsservice.xml:202
#, xml-text
msgid ""
"<option>-D gtk_doc=true</option>: This switch enables building the "
"libaccountsservice API documentation (needs <xref linkend=\"gtk-doc\"/>)."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/sysutils/accountsservice.xml:208
#, xml-text
msgid ""
"<option>-D vapi=false</option>: This switch disables building the vala "
"bindings. Use it if you have not installed <xref linkend=\"vala\"/>."
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/sysutils/accountsservice.xml:216
#, xml-text
msgid "Configuring AccountsService"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/sysutils/accountsservice.xml:219
#, xml-text
msgid ""
"To allow users in the adm group to be listed as Administrators, execute the "
"following commands as the <systemitem class=\"username\">root</systemitem> "
"user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/sysutils/accountsservice.xml:224
#, no-wrap, xml-text
msgid ""
"<userinput>cat &gt; /etc/polkit-1/rules.d/40-adm.rules &lt;&lt; \"EOF\"\n"
"<literal>polkit.addAdminRule(function(action, subject) {\n"
"   return [\"unix-group:adm\"];\n"
"   });</literal>\n"
"EOF</userinput>"
msgstr ""

