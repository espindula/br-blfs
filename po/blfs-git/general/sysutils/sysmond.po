#: blfs-en/blfs-git/general/sysutils/sysmond.xml:25
#, xml-text
msgid "Introduction to sysmond"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/sysutils/sysmond.xml:28
#, xml-text
msgid ""
"The <application>sysmond</application> package (pronounced sys-mon-d) is the"
" daemon portion of the sysmond/sysmon3 client/server application that "
"monitors system values including CPU usage, memory usage, and system "
"temperatures in a compact screen window."
msgstr ""

