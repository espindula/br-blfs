#: blfs-en/blfs-git/general/sysutils/autofs.xml:202
#, xml-text
msgid "Config Files"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/blfs-git/general/sysutils/autofs.xml:205
#, xml-text
msgid ""
"<filename>/etc/sysconfig/autofs.conf</filename>, "
"<filename>/etc/autofs/auto.master</filename>, "
"<filename>/etc/autofs/auto.misc</filename>, and "
"<filename>/etc/autofs/auto.net</filename>"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><indexterm><primary>
#: blfs-en/blfs-git/general/sysutils/autofs.xml:212
#, xml-text
msgid "/etc/sysconfig/autofs.conf"
