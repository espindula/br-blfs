#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/sysutils/colord.xml:118
#, xml-text
msgid "Installation of Colord"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/sysutils/colord.xml:129
#, xml-text
msgid ""
"There should be a dedicated user and group to take control of the colord "
"daemon after it has started. Issue the following commands as the <systemitem"
" class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/sysutils/colord.xml:134
#, no-wrap, xml-text
msgid ""
"<userinput>groupadd -g 71 colord &amp;&amp;\n"
"useradd -c \"Color Daemon Owner\" -d /var/lib/colord -u 71 \\\n"
"        -g colord -s /bin/false colord</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/sysutils/colord.xml:139
#, xml-text
msgid ""
"Install <application>Colord</application> by running the following commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/sysutils/colord.xml:143
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup ..                  \\\n"
"      --prefix=/usr             \\\n"
"      --buildtype=release       \\\n"
"      -D daemon_user=colord     \\\n"
"      -D vapi=true              \\\n"
"      -D systemd=false          \\\n"
"      -D libcolordcompat=true   \\\n"
"      -D argyllcms_sensor=false \\\n"
"      -D bash_completion=false  \\\n"
"      -D docs=false             \\\n"
"      -D man=false              &amp;&amp;\n"
"ninja</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/sysutils/colord.xml:159
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup ..                  \\\n"
"      --prefix=/usr             \\\n"
"      --buildtype=release       \\\n"
"      -D daemon_user=colord     \\\n"
"      -D vapi=true              \\\n"
"      -D systemd=true           \\\n"
"      -D libcolordcompat=true   \\\n"
"      -D argyllcms_sensor=false \\\n"
"      -D bash_completion=false  \\\n"
"      -D docs=false             \\\n"
"      -D man=false              &amp;&amp;\n"
"ninja</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/sysutils/colord.xml:177
#, xml-text
msgid ""
"If <xref linkend='docbook5'/>, <xref linkend='docbook-xsl-ns'/>, and <xref "
"linkend='libxslt'/> are installed, build the man pages:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/sysutils/colord.xml:181
#, no-wrap, xml-text
msgid ""
"<userinput>sed -e '/class=\"manual\"/i&lt;refmiscinfo class=\"source\"&gt;colord&lt;/refmiscinfo&gt;' \\\n"
"    -i ../man/*.xml &amp;&amp;\n"
"meson configure -D man=true &amp;&amp;\n"
"ninja</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/sysutils/colord.xml:187
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/sysutils/colord.xml:190
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/sysutils/colord.xml:193
#, xml-text
msgid ""
"To test the results, issue: <command>ninja test</command>.  One test, "
"<filename>colord-self-test-daemon</filename>, will fail if the package is "
"already installed. The test suite must be run with the system-wide D-Bus "
"Daemon running."
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/sysutils/colord.xml:202
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/sysutils/colord.xml:208
#, xml-text
msgid ""
"<parameter>-D daemon_user=colord</parameter>: This switch is used so the "
"colord daemon will run as an unprivileged user instead of the <systemitem "
"class=\"username\">root</systemitem> user."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/sysutils/colord.xml:214
#, xml-text
msgid ""
"<parameter>-D vapi=true</parameter>: This switch enables building the "
"<application>Vala</application> bindings. Remove if you don't have <xref "
"linkend=\"vala\"/> installed."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/sysutils/colord.xml:220
#, xml-text
msgid ""
"<parameter>-D systemd=false</parameter>: This switch disables support for "
"<application>systemd</application> login in Colord applications."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/sysutils/colord.xml:226
#, xml-text
msgid ""
"<parameter>-D systemd=true</parameter>: This switch enables installation of "
"the <application>systemd</application> service."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/sysutils/colord.xml:231
#, xml-text
msgid ""
"<parameter>-D libcolordcompat=true</parameter>: This switch enables building"
" a compatibility library for older packages that use "
"<application>Colord</application>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/sysutils/colord.xml:237
#, xml-text
msgid ""
"<parameter>-D argyllcms_sensor=false</parameter>: This switch disables the "
"ArgLLCMS sensor driver. Omit if you have <ulink "
"url=\"https://www.argyllcms.com/\">ArgyllCMS</ulink> installed and wish to "
"use it."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/sysutils/colord.xml:244
#, xml-text
msgid ""
"<parameter>-D bash_completion=false</parameter>: This switch disables Bash "
"Completion support for Colord applications."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/sysutils/colord.xml:249
#, xml-text
msgid ""
"<parameter>-D docs=false</parameter>: This switch disables building of "
"documentation. Omit if you have <xref linkend=\"gtk-doc\"/> available."
msgstr ""

