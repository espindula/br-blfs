#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/sysutils/bubblewrap.xml:85
#, xml-text
msgid "Kernel Configuration"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/sysutils/bubblewrap.xml:88
#, xml-text
msgid ""
"When this package began, upstream expected it could be installed suid-root. "
"That was a long time ago, suid-root is generally considered a bad idea. As "
"well as the default namespaces, this package requires the optional User "
"namespace to be enabled. If that has not yet been enabled, select the "
"following option in the kernel configuration and recompile the kernel:"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/sysutils/bubblewrap.xml:105
#, xml-text
msgid "Installation of Bubblewrap"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/sysutils/bubblewrap.xml:108
#, xml-text
msgid ""
"Install <application>Bubblewrap</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/sysutils/bubblewrap.xml:112
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr --buildtype=release .. &amp;&amp;\n"
"ninja</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/sysutils/bubblewrap.xml:119
#, xml-text
msgid ""
"Next, if you desire to run the test suite, fix an issue caused by the "
"merged-/usr configuration in LFS:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/sysutils/bubblewrap.xml:123
#, no-wrap, xml-text
msgid ""
"<userinput>sed 's@symlink usr/lib64@ro-bind-try /lib64@' -i "
"../tests/libtest.sh</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/sysutils/bubblewrap.xml:126
#, xml-text
msgid ""
"To test the results, issue (as a user other than the <systemitem "
"class=\"username\">root</systemitem> user): <command>ninja test</command>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/sysutils/bubblewrap.xml:132
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/sysutils/bubblewrap.xml:135
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr ""

