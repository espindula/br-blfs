#: blfs-en/blfs-git/general/sysutils/notification-daemon.xml:81
#, xml-text
msgid "Installation of Notification Daemon"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/sysutils/notification-daemon.xml:84
#, xml-text
msgid ""
"Install <application>Notification Daemon</application> by running the "
"following commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/sysutils/notification-daemon.xml:88
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr     \\\n"
"            --sysconfdir=/etc \\\n"
"            --disable-static  &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/sysutils/notification-daemon.xml:94
#, xml-text
msgid "This package does not come with a test suite."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/sysutils/notification-daemon.xml:98
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/sysutils/notification-daemon.xml:101
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/sysutils/notification-daemon.xml:104
#, xml-text
msgid ""
"You can test the notification daemon with the command <command>notify-"
"send</command>:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/sysutils/notification-daemon.xml:108
#, no-wrap, xml-text
msgid ""
"<userinput>pgrep -l notification-da &amp;&amp;\n"
"notify-send -i info Information \"Hi ${USER}, This is a Test\"</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/sysutils/notification-daemon.xml:111
#, xml-text
msgid ""
"The command <command>pgrep -l notification-da</command> is added to assure "
"that it is the daemon of this package that is running, not another one, e.g."
" the daemon from <xref linkend=\"xfce4-notifyd\"/>."
msgstr ""

