#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/sysutils/mc.xml:100
#, xml-text
msgid "Installation of MC"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/sysutils/mc.xml:103
#, xml-text
msgid ""
"Install <application>MC</application> by running the following commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/sysutils/mc.xml:107
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr     \\\n"
"            --sysconfdir=/etc \\\n"
"            --enable-charset  &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/sysutils/mc.xml:113
#, xml-text
msgid "To test the results, issue: <command>make check</command>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/sysutils/mc.xml:118
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/sysutils/mc.xml:121
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/sysutils/mc.xml:126
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/sysutils/mc.xml:129
#, xml-text
msgid ""
"<parameter>--sysconfdir=/etc</parameter>: This switch places the global "
"configuration directory in <filename class=\"directory\">/etc</filename>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/sysutils/mc.xml:135
#, xml-text
msgid ""
"<parameter>--enable-charset</parameter>: This switch adds support to "
"<command>mcedit</command> for editing files in encodings different from the "
"one implied by the current locale."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/sysutils/mc.xml:141
#, xml-text
msgid ""
"<parameter>--with-screen=ncurses</parameter>: Use this if you don't have "
"<xref linkend=\"slang\"/> installed."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/sysutils/mc.xml:146
#, xml-text
msgid ""
"<option>--with-search-engine=pcre2</option>: Use this switch if you would "
"prefer to use pcre from LFS instead of GLib for the built-in search engine."
msgstr ""

