#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/sysutils/upower.xml:129
#, xml-text
msgid "Installation of UPower"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/sysutils/upower.xml:132
#, xml-text
msgid ""
"Install <application>UPower</application> by running the following commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/sysutils/upower.xml:136
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup ..                   \\\n"
"      --prefix=/usr              \\\n"
"      --buildtype=release        \\\n"
"      -D gtk-doc=false           \\\n"
"      -D man=false               \\\n"
"      -D systemdsystemunitdir=no \\\n"
"      -D udevrulesdir=/usr/lib/udev/rules.d &amp;&amp;\n"
"ninja</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/sysutils/upower.xml:148
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build               &amp;&amp;\n"
"cd    build               &amp;&amp;\n"
"\n"
"meson setup ..            \\\n"
"      --prefix=/usr       \\\n"
"      --buildtype=release \\\n"
"      -D gtk-doc=false    \\\n"
"      -D man=false        &amp;&amp;\n"
"ninja</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/sysutils/upower.xml:182
#, xml-text
msgid ""
"To test the results, issue: <command>LC_ALL=C ninja test</command>. The test"
" suite should be run from a local GUI session started with dbus-launch. On "
"32-bit machines, one test will fail due to rounding errors: "
"<filename>Tests.test_battery_energy_charge_mixed</filename>. On some "
"systems, two tests relating to the headphone hotplug feature are known to "
"fail. Those can be safely ignored since the functionality still works."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/sysutils/upower.xml:192
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/sysutils/upower.xml:195
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/sysutils/upower.xml:200
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/sysutils/upower.xml:203
#, xml-text
msgid ""
"<parameter>-D gtk-doc=false</parameter>: Prevents building the "
"documentation. Remove this if you have <application>GTK-Doc</application> "
"installed and wish to build the documentation."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/sysutils/upower.xml:209
#, xml-text
msgid ""
"<parameter>-D man=false</parameter>: Prevents building the manual pages. "
"Remove this if you have <xref linkend='libxslt'/> and <xref "
"linkend='docbook-xsl'/> installed and wish to build the manual pages."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/sysutils/upower.xml:216
#, xml-text
msgid ""
"<parameter>-D systemdsystemunitdir=no</parameter>: Removes the dependency on"
" <application>systemd</application>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/sysutils/upower.xml:221
#, xml-text
msgid ""
"<parameter>-D udevrulesdir=/usr/lib/udev/rules.d</parameter>: Tells the "
"build system where to install <application>udev</application> rules because "
"the information is missing in "
"<filename>/usr/lib/pkgconfig/libudev.pc</filename>"
msgstr ""

