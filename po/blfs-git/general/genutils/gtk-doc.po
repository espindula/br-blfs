#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/genutils/gtk-doc.xml:127
#, xml-text
msgid "Installation of GTK-Doc"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genutils/gtk-doc.xml:130
#, xml-text
msgid ""
"Install <application>GTK-Doc</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genutils/gtk-doc.xml:134
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir -p build &amp;&amp;\n"
"cd       build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr --buildtype=release .. &amp;&amp;\n"
"ninja</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genutils/gtk-doc.xml:141
#, xml-text
msgid ""
"The test suite will hang if the package (or a previous version)  is not "
"already installed."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genutils/gtk-doc.xml:146
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genutils/gtk-doc.xml:149
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr ""

#.  https://gitlab.gnome.org/GNOME/gtk-doc/-/merge_requests/74
#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genutils/gtk-doc.xml:152
#, xml-text
msgid ""
"To test the results, issue: <command>ninja test</command>.  Some tests will "
"fail depending on optionally installed packages. One test, <filename>test-"
"gobject-mkhtml</filename>, is known to fail due to issues with newer "
"versions of libxml2."
msgstr ""

