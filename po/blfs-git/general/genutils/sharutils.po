#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genutils/sharutils.xml:94
#, no-wrap, xml-text
msgid ""
"<userinput>autoreconf -fiv                                         &amp;&amp;\n"
"./configure --prefix=/usr --disable-dependency-tracking &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genutils/sharutils.xml:99
#, xml-text
msgid "To test the results, issue <command>make check</command>."
