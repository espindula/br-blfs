#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/genutils/bogofilter.xml:97
#, xml-text
msgid "Installation of Bogofilter"
msgstr ""

#. type: Content of: <sect1><sect2><note><para>
#: blfs-en/blfs-git/general/genutils/bogofilter.xml:101
#, xml-text
msgid ""
"If you plan to change the version of your database library on an existing "
"installation, or to change to a different database, read the warning at the "
"top of the RELEASE.NOTES file."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genutils/bogofilter.xml:108
#, xml-text
msgid ""
"Install <application>Bogofilter</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genutils/bogofilter.xml:112
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr                \\\n"
"            --sysconfdir=/etc/bogofilter \\\n"
"            --with-database=sqlite3      &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genutils/bogofilter.xml:118
#, xml-text
msgid "To test the results, issue <command>make check</command>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genutils/bogofilter.xml:122
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genutils/bogofilter.xml:125
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/genutils/bogofilter.xml:130
#, xml-text
msgid "Command Explanations"
msgstr ""

#.  which is beyond the scope of BLFS (removed)
#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genutils/bogofilter.xml:133
#, xml-text
msgid ""
"<parameter>--with-database=sqlite3</parameter>: This switch makes Bogofilter"
" use sqlite as the database, instead of Berkeley DB."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genutils/bogofilter.xml:139
#, xml-text
msgid ""
"<option>--with-database={lmdb,qdbm,tokyocabinet}</option>: This switch also "
"allows to use lmdb, qdbm, or tokyocabinet as the database."
msgstr ""

