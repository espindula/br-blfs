#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/genutils/unixodbc.xml:86
#, xml-text
msgid "Installation of unixODBC"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genutils/unixodbc.xml:89
#, xml-text
msgid ""
"Install <application>unixODBC</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genutils/unixodbc.xml:93
#, no-wrap, xml-text
msgid ""
"<userinput>autoreconf -fiv &amp;&amp;\n"
"./configure --prefix=/usr --sysconfdir=/etc/unixODBC &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genutils/unixodbc.xml:98
#, xml-text
msgid "This package does not come with a test suite."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genutils/unixodbc.xml:102
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genutils/unixodbc.xml:105
#, no-wrap, xml-text
msgid ""
"<userinput>make install &amp;&amp;\n"
"\n"
"find doc -name \"Makefile*\" -delete                &amp;&amp;\n"
"chmod 644 doc/{lst,ProgrammerManual/Tutorial}/*   &amp;&amp;\n"
"\n"
"install -v -m755 -d /usr/share/doc/unixODBC-&unixodbc-version; &amp;&amp;\n"
"cp      -v -R doc/* /usr/share/doc/unixODBC-&unixodbc-version;</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/genutils/unixodbc.xml:116
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genutils/unixodbc.xml:119
#, xml-text
msgid ""
"<option>--enable-drivers</option>: This parameter enables building the "
"drivers that were installed by default in previous versions."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genutils/unixodbc.xml:124
#, xml-text
msgid ""
"<option>--enable-drivers-conf</option>: This parameter enables building the "
"driver configuration libraries that were installed by default in previous "
"versions."
msgstr ""

