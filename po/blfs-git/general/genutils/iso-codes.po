#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/genutils/iso-codes.xml:73
#, xml-text
msgid "Installation of ISO Codes"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genutils/iso-codes.xml:76
#, xml-text
msgid ""
"Install <application>ISO Codes</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genutils/iso-codes.xml:80
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genutils/iso-codes.xml:84
#, xml-text
msgid "To test the results, issue: <command>make check</command>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genutils/iso-codes.xml:88
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genutils/iso-codes.xml:91
#, no-wrap, xml-text
msgid "<userinput>make install LN_S='ln -sfn'</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/genutils/iso-codes.xml:96
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genutils/iso-codes.xml:99
#, xml-text
msgid ""
"<parameter>LN_S='ln -sfn'</parameter>: This override ensures the installed "
"symlinks correctly recreated in case we are upgrading or reinstalling the "
"package.  It's unneeded but harmless when installing the package onto the "
"system for the first time."
msgstr ""

