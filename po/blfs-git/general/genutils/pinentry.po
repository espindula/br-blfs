#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/genutils/pinentry.xml:99
#, xml-text
msgid "Installation of PIN-Entry"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genutils/pinentry.xml:102
#, xml-text
msgid "First, make <command>configure</command> consistent with fltk-1.4.1:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genutils/pinentry.xml:104
#, no-wrap, xml-text
msgid ""
"<userinput>sed -i \"/FLTK 1/s/3/4/\" configure   &amp;&amp;\n"
"sed -i '14456 s/1.3/1.4/' configure</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genutils/pinentry.xml:108
#, xml-text
msgid ""
"Install <application>PIN-Entry</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genutils/pinentry.xml:112
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr          \\\n"
"            --enable-pinentry-tty  &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genutils/pinentry.xml:117
#, xml-text
msgid "This package does not come with a test suite."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genutils/pinentry.xml:121
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genutils/pinentry.xml:124
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr ""

