#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/genutils/compface.xml:73
#, xml-text
msgid "Installation of Compface"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genutils/compface.xml:76
#, xml-text
msgid "First, fix the configure script so that it's C99 compatible:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genutils/compface.xml:79
#, no-wrap, xml-text
msgid "<userinput remap=\"pre\">autoreconf</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genutils/compface.xml:82
#, xml-text
msgid "Next, fix a build failure that occurs with GCC 14:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genutils/compface.xml:85
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"pre\">sed -e '/compface.h/a #include &lt;unistd.h&gt;' \\\n"
"    -i cmain.c                             \\\n"
"    -i uncmain.c</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genutils/compface.xml:90
#, xml-text
msgid ""
"Install <application>Compface</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genutils/compface.xml:94
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr --mandir=/usr/share/man &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genutils/compface.xml:98
#, xml-text
msgid "This package does not come with a test suite."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genutils/compface.xml:102
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genutils/compface.xml:105
#, no-wrap, xml-text
msgid ""
"<userinput>make install &amp;&amp;\n"
"install -m755 -v xbm2xface.pl /usr/bin</userinput>"
msgstr ""

