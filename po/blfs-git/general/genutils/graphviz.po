"<xref linkend=\"swig\"/> (<application>SWIG</application> must be installed "
"or no bindings will be built), <xref linkend=\"gcc\"/> (for the go "
"compiler), <xref linkend=\"guile\"/>, <xref linkend=\"openjdk\"/>, <xref "
"linkend=\"lua\"/>, <xref linkend=\"php\"/>, <xref linkend=\"ruby\"/>, <xref "
"linkend=\"tk\"/>, and <ulink url=\"https://www.r-project.org/\">R</ulink>"
msgstr ""

#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/blfs-git/general/genutils/graphviz.xml:173
