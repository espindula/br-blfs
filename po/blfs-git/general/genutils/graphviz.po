#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/genutils/graphviz.xml:188
#, xml-text
msgid "Installation of Graphviz"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genutils/graphviz.xml:191
#, xml-text
msgid "First, fix a file to allow finding php if installed:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genutils/graphviz.xml:194
#, no-wrap, xml-text
msgid ""
"<userinput>sed -i '/ldflags/ s/ $.*&amp;&amp;//' "
"cmake/FindPHP.cmake</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genutils/graphviz.xml:199
#, xml-text
msgid ""
"Now prevent hard coding library search paths (rpath) into the shared "
"libraries. The libraries do not need the rpath for an installation into the "
"standard location, and rpath may sometimes cause unwanted effects or even "
"security issues.  We cannot use <option>-D "
"CMAKE_SKIP_INSTALL_RPATH=ON</option> for this package because the rpath is "
"really needed for the programs installed by this package, so we need to edit"
" the build system:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genutils/graphviz.xml:208
#, no-wrap, xml-text
msgid "<userinput>sed '/ORIGIN/d' -i lib/CMakeLists.txt</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genutils/graphviz.xml:211
#, xml-text
msgid ""
"Install <application>Graphviz</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genutils/graphviz.xml:215
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr \\\n"
"      -D CMAKE_BUILD_TYPE=Release  \\\n"
"      ..                           &amp;&amp;\n"
"\n"
"sed -i '/GZIP/s/:.*$/=/' CMakeCache.txt &amp;&amp;\n"
"\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genutils/graphviz.xml:227
#, xml-text
msgid ""
"This package does not come with a test suite that provides meaningful "
"results."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genutils/graphviz.xml:232
#, xml-text
msgid "Now, as the &root; user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genutils/graphviz.xml:235
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/genutils/graphviz.xml:240
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genutils/graphviz.xml:243
#, xml-text
msgid ""
"<command>sed ... CMakeCache.txt</command>: This command is needed to prevent"
" compressing the packages's man pages."
msgstr ""

