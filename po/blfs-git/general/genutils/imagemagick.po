#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/genutils/imagemagick.xml:236
#, xml-text
msgid "Installation of ImageMagick"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genutils/imagemagick.xml:239
#, xml-text
msgid ""
"Install <application>ImageMagick</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genutils/imagemagick.xml:243
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr     \\\n"
"            --sysconfdir=/etc \\\n"
"            --enable-hdri     \\\n"
"            --with-modules    \\\n"
"            --with-perl       \\\n"
"            --disable-static  &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genutils/imagemagick.xml:252
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genutils/imagemagick.xml:255
#, no-wrap, xml-text
msgid ""
"<userinput>make DOCUMENTATION_PATH=/usr/share/doc/imagemagick-&imagemagick-"
"version; install</userinput>"
msgstr ""

#.  seems to have been dropped                         A more
#.       comprehensive test is the <application>
#. ImageMagick</application>
#.       validation suite. If <command>make check</command> has not been
#. executed,
#.       run <command>make tests/validate</command> to compile it.  Issue
#.       <command>tests/validate 2>&amp;1 | tee validate.log</command> to run
#. the
#.       validation suite.
#.  summary is last line of output
#.        The result summary may be obtained with <command>
#. grep
#.       "validation suite" validate.log</command>.
#.  I'm not convinced that Helvetica is required, I don't install the gs
#.       fonts. But lots of references to it. Surely fontconfig provides it?
#. ken
#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genutils/imagemagick.xml:258
#, xml-text
msgid ""
"To test the installation, issue: <command>make check</command>.  Note that "
"the EPS, PS, and PDF tests require a working "
"<application>Ghostscript</application>. One test in 'make check' needs "
"<quote>Helvetica</quote> from <quote>Ghostscript Standard Fonts,</quote> "
"which are optionally installed in <xref linkend=\"gs\"/> - that test, and "
"one other, might fail, but all the validation can still pass."
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/genutils/imagemagick.xml:280
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genutils/imagemagick.xml:283
#, xml-text
msgid ""
"<parameter>--enable-hdri</parameter>: Enables building of a high dynamic "
"range version of ImageMagick."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genutils/imagemagick.xml:288
#, xml-text
msgid ""
"<parameter>--with-modules</parameter>: Enables support for dynamically "
"loadable modules."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genutils/imagemagick.xml:293
#, xml-text
msgid ""
"<parameter>--with-perl</parameter>: Enables building and installing of "
"PerlMagick."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genutils/imagemagick.xml:301
#, xml-text
msgid ""
"<option>--with-fftw</option>: Enables support for the "
"<application>FFTW</application> shared library."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genutils/imagemagick.xml:306
#, xml-text
msgid ""
"<option>--with-rsvg</option>: Enables support for the "
"<application>librsvg</application> library."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genutils/imagemagick.xml:311
#, xml-text
msgid ""
"<option>--with-autotrace</option>: Enables support for the "
"<application>Autotrace</application> library."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genutils/imagemagick.xml:316
#, xml-text
msgid ""
"<option>--with-wmf</option>: Enables support for the "
"<application>libwmf</application> library."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genutils/imagemagick.xml:321
#, xml-text
msgid ""
"<option>--with-gvc</option>: Enables support for "
"<application>GraphViz</application>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genutils/imagemagick.xml:326
#, xml-text
msgid ""
"<option>--with-security-policy=open|limited|secure|websafe</option>: If you "
"wish to enforce a policy other than the default 'open' see "
"<filename>www/security-policy.html</filename> in the source for details."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genutils/imagemagick.xml:333
#, xml-text
msgid ""
"<option>--with-windows-font-dir= "
"<replaceable>&lt;Some/Directory&gt;</replaceable></option>: This option "
"specifies the directory where the Windows CoreFonts are installed."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genutils/imagemagick.xml:340
#, xml-text
msgid ""
"<option>--with-dejavu-font-dir= "
"<replaceable>&lt;Some/Directory&gt;</replaceable></option>: This option "
"specifies the directory where the DejaVu fonts are installed."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genutils/imagemagick.xml:347
#, xml-text
msgid ""
"The options and parameters listed above are the only ones you should have to"
" pass to the <command>configure</command> script to activate all the "
"delegate dependencies. All other dependencies will be automatically detected"
" and utilized in the build if they are installed."
msgstr ""

