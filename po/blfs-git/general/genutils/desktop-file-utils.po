msgid "Installation of Desktop File Utils"
msgstr ""

#. type: Content of: <sect1><sect2><warning><para>
#: blfs-en/blfs-git/general/genutils/desktop-file-utils.xml:94
#, xml-text
msgid ""
"If you are upgrading from a previous version of desktop-file-utils that used"
" the Autotools method of installing and configuring the package, you must "
"remove the desktop-file-edit symlink by using the following commands."
msgstr ""

#.  Works around a bug in meson's symlink creation exposed by this package
#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genutils/desktop-file-utils.xml:102
#, no-wrap, xml-text
msgid "<userinput>rm -fv /usr/bin/desktop-file-edit</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genutils/desktop-file-utils.xml:105
#, xml-text
msgid ""
"Install <application>Desktop File Utils</application> by running the "
"following commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genutils/desktop-file-utils.xml:109
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr --buildtype=release .. &amp;&amp;\n"
"ninja</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genutils/desktop-file-utils.xml:116
#, xml-text
msgid "This package does not come with a test suite."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genutils/desktop-file-utils.xml:120
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genutils/desktop-file-utils.xml:123
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr ""

