#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/genutils/shared-mime-info.xml:106
#, xml-text
msgid "Installation of Shared Mime Info"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genutils/shared-mime-info.xml:109
#, xml-text
msgid ""
"Install <application>Shared Mime Info</application> by running the following"
" commands:"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genutils/shared-mime-info.xml:114
#, xml-text
msgid ""
"If you wish to run the test suite, you must first extract the "
"<filename>xdgmime</filename> tarball into the current directory, and compile"
" it so that <command>meson</command> can find it:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genutils/shared-mime-info.xml:119
#, no-wrap, xml-text
msgid ""
"<userinput>tar -xf ../xdgmime.tar.xz &amp;&amp;\n"
"make -C xdgmime</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genutils/shared-mime-info.xml:123
#, xml-text
msgid "Now build the package:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genutils/shared-mime-info.xml:126
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr --buildtype=release -D update-mimedb=true .. &amp;&amp;\n"
"ninja</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genutils/shared-mime-info.xml:133
#, xml-text
msgid ""
"If you have followed the instructions above to build "
"<application>xdgmime</application>, to test the result issue <command>ninja "
"test</command>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genutils/shared-mime-info.xml:139
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genutils/shared-mime-info.xml:142
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/genutils/shared-mime-info.xml:147
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genutils/shared-mime-info.xml:153
#, xml-text
msgid ""
"<parameter>-D update-mimedb=true</parameter>: This parameter tells the build"
" system to run <command>update-mime-database</command> during installation. "
"Otherwise, this must be done manually in order to be able to use the MIME "
"database."
msgstr ""

