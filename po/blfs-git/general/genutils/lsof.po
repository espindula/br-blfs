#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/genutils/lsof.xml:104
#, xml-text
msgid "Installation of lsof"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genutils/lsof.xml:107
#, xml-text
msgid ""
"Install <application>lsof</application> by running the following commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genutils/lsof.xml:111
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr --disable-static &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genutils/lsof.xml:115
#, xml-text
msgid ""
"The tests should be run as the <systemitem "
"class=\"username\">root</systemitem> user. They require that the POSIX "
"message queues are enabled in the kernel, and that <xref linkend=\"nmap\"/> "
"be installed with a symbolic link <filename>/usr/bin/nc</filename> pointing "
"to <command>ncat</command>."
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genutils/lsof.xml:123
#, no-wrap, xml-text
msgid "<userinput>make check</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genutils/lsof.xml:133
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genutils/lsof.xml:136
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr ""

