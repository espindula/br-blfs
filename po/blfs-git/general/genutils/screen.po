#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/genutils/screen.xml:95
#, xml-text
msgid "Installation of Screen"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genutils/screen.xml:98
#, xml-text
msgid "Fix an issue causing the info page fail to build:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genutils/screen.xml:101
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"pre\">sed 's/\\([a-z]\\)@opensuse/\\1@@opensuse/' -i "
"doc/screen.texinfo</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genutils/screen.xml:104
#, xml-text
msgid ""
"Install <application>Screen</application> by running the following commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genutils/screen.xml:108
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr                   \\\n"
"            --infodir=/usr/share/info       \\\n"
"            --mandir=/usr/share/man         \\\n"
"            --disable-pam                   \\\n"
"            --enable-socket-dir=/run/screen \\\n"
"            --with-pty-group=5              \\\n"
"            --with-system_screenrc=/etc/screenrc &amp;&amp;\n"
"\n"
"sed -i -e \"s%/usr/local/etc/screenrc%/etc/screenrc%\" {etc,doc}/* &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genutils/screen.xml:120
#, xml-text
msgid "This package does not come with a test suite."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genutils/screen.xml:124
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genutils/screen.xml:127
#, no-wrap, xml-text
msgid ""
"<userinput>make install &amp;&amp;\n"
"install -m 644 etc/etcscreenrc /etc/screenrc</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/genutils/screen.xml:133
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genutils/screen.xml:136
#, xml-text
msgid ""
"<parameter>--disable-pam</parameter>: This option removes a build dependency"
" on Linux-PAM. Remove this option if you want PAM support."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genutils/screen.xml:141
#, xml-text
msgid ""
"<parameter>--enable-socket-dir=/run/screen</parameter>: This option places "
"the per-user sockets in a standard location."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genutils/screen.xml:146
#, xml-text
msgid ""
"<parameter>--with-system_screenrc=/etc/screenrc</parameter>: This option "
"places the global screenrc file in <filename "
"class='directory'>/etc</filename>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genutils/screen.xml:152
#, xml-text
msgid ""
"<parameter>--with-pty-group=5</parameter>: This option sets the gid to the "
"value used by LFS."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genutils/screen.xml:157
#, xml-text
msgid ""
"<command>sed -i -e \"s%/usr/local/etc/screenrc%/etc/screenrc%\" "
"{etc,doc}/*</command>: This command corrects the configuration and "
"documentation files to the location that is used here for the global "
"screenrc file."
msgstr ""

