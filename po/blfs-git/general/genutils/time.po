#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/genutils/time.xml:79
#, xml-text
msgid "Installation of Time"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genutils/time.xml:82
#, xml-text
msgid "First, fix compiling this package with GCC-15:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genutils/time.xml:85
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"pre\">sed -i 's/sighandler "
"interrupt_signal/__sighandler_t interrupt_signal/' src/time.c</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genutils/time.xml:88
#, xml-text
msgid ""
"Install <application>Time</application> by running the following commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genutils/time.xml:92
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genutils/time.xml:96
#, xml-text
msgid "To test the results, issue: <command>make check</command>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genutils/time.xml:100
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genutils/time.xml:103
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr ""

