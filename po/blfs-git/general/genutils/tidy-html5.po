#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/genutils/tidy-html5.xml:97
#, xml-text
msgid "Installation of Tidy HTML5"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genutils/tidy-html5.xml:101
#, xml-text
msgid "First, fix a build failure that occurs when using CMake 4.0 and later:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genutils/tidy-html5.xml:104
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"pre\">patch -Np1 -i ../tidy-html5-&tidy-"
"html5-version;-cmake4_fixes-1.patch</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genutils/tidy-html5.xml:107
#, xml-text
msgid ""
"Install <application>Tidy HTML5</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genutils/tidy-html5.xml:111
#, no-wrap, xml-text
msgid ""
"<userinput>cd build/cmake &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr \\\n"
"      -D CMAKE_BUILD_TYPE=Release  \\\n"
"      -D BUILD_TAB2SPACE=ON        \\\n"
"      ../..    &amp;&amp;\n"
"\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genutils/tidy-html5.xml:121
#, xml-text
msgid "This package does not come with a test suite."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genutils/tidy-html5.xml:125
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genutils/tidy-html5.xml:128
#, no-wrap, xml-text
msgid ""
"<userinput>make install &amp;&amp;\n"
"rm -fv /usr/lib/libtidy.a &amp;&amp;\n"
"install -v -m755 tab2space /usr/bin</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/genutils/tidy-html5.xml:135
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genutils/tidy-html5.xml:138
#, xml-text
msgid ""
"<parameter>-D CMAKE_BUILD_TYPE=Release</parameter>: This switch is used to "
"build the release library without any debug `assert` in the code."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genutils/tidy-html5.xml:143
#, xml-text
msgid ""
"<parameter>-D BUILD_TAB2SPACE=ON</parameter>: This switch is used to enable "
"building the <command>tab2space</command> utility."
msgstr ""

