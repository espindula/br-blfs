#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/graphlib/libheif.xml:104
#, xml-text
msgid "Installation of libheif"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/graphlib/libheif.xml:107
#, xml-text
msgid ""
"Install <application>libheif</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/graphlib/libheif.xml:111
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr \\\n"
"      -D CMAKE_BUILD_TYPE=Release  \\\n"
"      -G Ninja ..                  &amp;&amp;\n"
"ninja</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/graphlib/libheif.xml:120
#, xml-text
msgid "To test the results, issue: <command>ninja test</command>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/graphlib/libheif.xml:124
#, xml-text
msgid "Now, as the &root; user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/graphlib/libheif.xml:127
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/graphlib/libheif.xml:131
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/graphlib/libheif.xml:138
#, xml-text
msgid ""
"<option>-D DAV1D=ON</option>: This option allows using <xref "
"linkend='dav1d'/> to decode AV1 data in AVIF files."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/graphlib/libheif.xml:143
#, xml-text
msgid ""
"<option>-D FFMPEG_DECODER=ON</option>: This option allows using <xref "
"linkend='ffmpeg'/> to decode H.265 data in HEIC files."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/graphlib/libheif.xml:148
#, xml-text
msgid ""
"<option>-D JPEG_ENCODER=ON -D JPEG_DECODER=ON</option>: These options allow "
"using <xref linkend='libjpeg'/> to encode and decode HEIF files with JPEG "
"data."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/graphlib/libheif.xml:154
#, xml-text
msgid ""
"<option>-D OpenJPEG_ENCODER=ON -D OpenJPEG_DECODER=ON</option>: These "
"options allow using <xref linkend='openjpeg2'/> to encode and decode HEIF "
"files with JPEG 2000 data."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/graphlib/libheif.xml:160
#, xml-text
msgid ""
"<option>-D SvtEnc=ON</option>: This option allows using <xref linkend='svt-"
"av1'/> to encode AV1 data for AVIF files."
msgstr ""

