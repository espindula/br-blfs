#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/graphlib/libexif.xml:89
#, xml-text
msgid "Installation of libexif"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/graphlib/libexif.xml:101
#, xml-text
msgid ""
"Install <application>libexif</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/graphlib/libexif.xml:105
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr    \\\n"
"            --disable-static \\\n"
"            --with-doc-dir=/usr/share/doc/libexif-&libexif-version; &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/graphlib/libexif.xml:111
#, xml-text
msgid "To test the results, issue: <command>make check</command>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/graphlib/libexif.xml:115
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/graphlib/libexif.xml:118
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/graphlib/libexif.xml:121
#, xml-text
msgid ""
"Documentation was built and installed if you have the dependencies shown "
"above installed. If you don't have the dependencies installed, there is a "
"compressed tarball in the source tree <filename "
"class=\"directory\">doc</filename> directory that can be unpacked into "
"/usr/share/doc/libexif-&libexif-version;."
msgstr ""

