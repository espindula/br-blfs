#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/graphlib/openjpeg2.xml:89
#, xml-text
msgid "Installation of OpenJPEG"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/graphlib/openjpeg2.xml:92
#, xml-text
msgid ""
"Install <application>OpenJPEG</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/graphlib/openjpeg2.xml:96
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir -v build &amp;&amp;\n"
"cd       build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_BUILD_TYPE=Release  \\\n"
"      -D CMAKE_INSTALL_PREFIX=/usr \\\n"
"      -D BUILD_STATIC_LIBS=OFF ..  &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/graphlib/openjpeg2.xml:105
#, xml-text
msgid ""
"If you wish to run the tests, some additional files are required. Download "
"these files and run the tests using the following commands, but note that 8 "
"tests are known to fail:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/graphlib/openjpeg2.xml:110
#, no-wrap, xml-text
msgid ""
"<userinput>git clone https://github.com/uclouvain/openjpeg-data.git --depth 1 &amp;&amp;\n"
"OPJ_DATA_ROOT=$PWD/openjpeg-data cmake -D BUILD_TESTING=ON ..      &amp;&amp;\n"
"make                                                               &amp;&amp;\n"
"make test</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/graphlib/openjpeg2.xml:116
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/graphlib/openjpeg2.xml:119
#, no-wrap, xml-text
msgid ""
"<userinput>make install &amp;&amp;\n"
"cp -rv ../doc/man -T /usr/share/man</userinput>"
msgstr ""

