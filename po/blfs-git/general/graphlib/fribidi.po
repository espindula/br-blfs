msgid "Installation of FriBidi"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/graphlib/fribidi.xml:84
#, xml-text
msgid ""
"Install <application>FriBidi</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/graphlib/fribidi.xml:88
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr --buildtype=release .. &amp;&amp;\n"
"ninja</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/graphlib/fribidi.xml:95
#, xml-text
msgid "To test the results, issue: <command>ninja test</command>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/graphlib/fribidi.xml:99
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/graphlib/fribidi.xml:102
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr ""

