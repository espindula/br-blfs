#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/graphlib/librsvg.xml:98
#, xml-text
msgid "Installation of librsvg"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/graphlib/librsvg.xml:101
#, xml-text
msgid "First, fix the installation path of the API documentation:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/graphlib/librsvg.xml:104
#, no-wrap, xml-text
msgid ""
"<userinput>sed -e \"/OUTDIR/s|,| / 'librsvg-&librsvg-version;', '--no-namespace-dir',|\" \\\n"
"    -e '/output/s|Rsvg-2.0|librsvg-&librsvg-version;|'                      \\\n"
"    -i doc/meson.build</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/graphlib/librsvg.xml:109
#, xml-text
msgid ""
"Install <application>librsvg</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/graphlib/librsvg.xml:113
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr --buildtype=release .. &amp;&amp;\n"
"ninja</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/graphlib/librsvg.xml:130
#, xml-text
msgid "To test the results, issue:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/graphlib/librsvg.xml:133
#, no-wrap, xml-text
msgid "<userinput>meson test -v</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/graphlib/librsvg.xml:136
#, xml-text
msgid "Now, as the &root; user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/graphlib/librsvg.xml:139
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr ""

