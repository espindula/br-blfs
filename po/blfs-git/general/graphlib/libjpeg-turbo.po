#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/graphlib/libjpeg-turbo.xml:88
#, xml-text
msgid "Installation of libjpeg-turbo"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/graphlib/libjpeg-turbo.xml:91
#, xml-text
msgid ""
"Install <application>libjpeg-turbo</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/graphlib/libjpeg-turbo.xml:95
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr        \\\n"
"      -D CMAKE_BUILD_TYPE=RELEASE         \\\n"
"      -D ENABLE_STATIC=FALSE              \\\n"
"      -D CMAKE_INSTALL_DEFAULT_LIBDIR=lib \\\n"
"      -D CMAKE_POLICY_VERSION_MINIMUM=3.5 \\\n"
"      -D CMAKE_SKIP_INSTALL_RPATH=ON      \\\n"
"      -D CMAKE_INSTALL_DOCDIR=/usr/share/doc/libjpeg-turbo-&libjpeg-turbo-version; \\\n"
"      .. &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/graphlib/libjpeg-turbo.xml:109
#, xml-text
msgid "To test the results, issue: <command>make test</command>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/graphlib/libjpeg-turbo.xml:123
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/graphlib/libjpeg-turbo.xml:126
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr ""

