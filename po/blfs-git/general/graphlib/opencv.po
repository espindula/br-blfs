#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/graphlib/opencv.xml:153
#, xml-text
msgid "Installation of opencv"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/graphlib/opencv.xml:156
#, xml-text
msgid ""
"First, apply a patch to make the package compatible with "
"<application>ffmpeg-8</application>:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/graphlib/opencv.xml:160
#, no-wrap, xml-text
msgid ""
"<userinput>patch -Np1 -i ../opencv-&opencv-"
"version;-ffmpeg8-1.patch</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/graphlib/opencv.xml:163
#, xml-text
msgid "If you downloaded the optional modules, unpack them now:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/graphlib/opencv.xml:166
#, no-wrap, xml-text
msgid ""
"<userinput>tar -xf ../opencv_contrib-&opencv-contrib-"
"version;.tar.gz</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/graphlib/opencv.xml:169
#, xml-text
msgid ""
"Install <application>opencv</application> by running the following commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/graphlib/opencv.xml:173
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr        \\\n"
"      -D CMAKE_BUILD_TYPE=Release         \\\n"
"      -D ENABLE_CXX11=ON                  \\\n"
"      -D BUILD_PERF_TESTS=OFF             \\\n"
"      -D WITH_XINE=ON                     \\\n"
"      -D BUILD_TESTS=OFF                  \\\n"
"      -D ENABLE_PRECOMPILED_HEADERS=OFF   \\\n"
"      -D CMAKE_SKIP_INSTALL_RPATH=ON      \\\n"
"      -D BUILD_WITH_DEBUG_INFO=OFF        \\\n"
"      -D OPENCV_GENERATE_PKGCONFIG=ON     \\\n"
"      -D CMAKE_POLICY_VERSION_MINIMUM=3.5 \\\n"
"      -W no-dev  ..                       &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/graphlib/opencv.xml:191
#, xml-text
msgid "The package does not come with a test suite."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/graphlib/opencv.xml:195
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/graphlib/opencv.xml:198
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/graphlib/opencv.xml:203
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/graphlib/opencv.xml:212
#, xml-text
msgid ""
"<parameter>-D WITH_XINE=ON</parameter>: This switch instructs the make "
"procedure to use <xref linkend=\"xine-lib\"/>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/graphlib/opencv.xml:217
#, xml-text
msgid ""
"<parameter>-D ENABLE_PRECOMPILED_HEADERS=OFF</parameter>: This switch is "
"needed for compatibility with gcc-6.1 and later."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/graphlib/opencv.xml:222
#, xml-text
msgid ""
"<parameter>-D OPENCV_GENERATE_PKGCONFIG=ON</parameter>: This switch tells "
"the build system to generate a pkg-config file for other packages to detect "
"and link to the libraries installed by this package."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/graphlib/opencv.xml:228
#, xml-text
msgid ""
"<option>-D OPENCV_EXTRA_MODULES_PATH=../opencv_contrib-&opencv-"
"version;/modules</option>: instructs the build system to build additional "
"modules. Some packages in BLFS (such as <xref linkend=\"gst10-plugins-bad\" "
"role=\"nodep\"/>) need these modules to build components that use OpenCV."
msgstr ""

