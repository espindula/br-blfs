#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/graphlib/libraw.xml:91
#, xml-text
msgid ""
"Install <application>libraw</application> by running the following commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/graphlib/libraw.xml:95
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr    \\\n"
"            --enable-jpeg    \\\n"
"            --enable-jasper  \\\n"
"            --enable-lcms    \\\n"
"            --disable-static \\\n"
"            --docdir=/usr/share/doc/libraw-&libraw-version; &amp;&amp;\n"
"make</userinput>"
msgstr ""

