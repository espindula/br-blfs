#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/graphlib/gegl.xml:147
#, xml-text
msgid "Installation of gegl"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/graphlib/gegl.xml:150
#, xml-text
msgid ""
"If you are installing over a previous version of "
"<application>gegl</application>, one of the modules will need to be removed."
"  As the &root; user, run the following command to remove it:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/graphlib/gegl.xml:155
#, no-wrap, xml-text
msgid "<userinput>rm -f /usr/lib/gegl-0.4/vector-fill.so</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/graphlib/gegl.xml:166
#, xml-text
msgid ""
"Install <application>gegl</application> by running the following commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/graphlib/gegl.xml:170
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr --buildtype=release .. &amp;&amp;\n"
"ninja</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/graphlib/gegl.xml:177
#, xml-text
msgid ""
"To run the tests, issue: <command>ninja test</command>. Fourteen tests are "
"known to fail in the <filename>gegl:ff-load-save</filename> portion of the "
"test suite due to incompatibilities with recent versions of ffmpeg."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/graphlib/gegl.xml:183
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/graphlib/gegl.xml:186
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr ""

