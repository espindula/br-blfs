#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/graphlib/libqrencode.xml:87
#, xml-text
msgid "Installation of libqrencode"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/graphlib/libqrencode.xml:90
#, xml-text
msgid ""
"Install <application>libqrencode</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/graphlib/libqrencode.xml:94
#, no-wrap, xml-text
msgid ""
"<userinput>sh autogen.sh             &amp;&amp;\n"
"./configure --prefix=/usr &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/graphlib/libqrencode.xml:99
#, xml-text
msgid ""
"If you have installed <xref linkend=\"doxygen\"/>, you can build the "
"documentation by issuing:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/graphlib/libqrencode.xml:103
#, no-wrap, xml-text
msgid "<userinput>doxygen</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/graphlib/libqrencode.xml:106
#, xml-text
msgid "The tests must be run after installing the package."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/graphlib/libqrencode.xml:110
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/graphlib/libqrencode.xml:113
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/graphlib/libqrencode.xml:116
#, xml-text
msgid ""
"If you have built the optional documentation, install it as the <systemitem "
"class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/graphlib/libqrencode.xml:121
#, no-wrap, xml-text
msgid ""
"<userinput>install -vdm 755 /usr/share/doc/libqrencode-&qrencode-version; &amp;&amp;\n"
"mv html/*        /usr/share/doc/libqrencode-&qrencode-version;</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/graphlib/libqrencode.xml:125
#, xml-text
msgid ""
"To test the results, if you have passed the <option>--with-tests</option> "
"option to <command>configure</command>, issue: <command>make "
"check</command>."
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/graphlib/libqrencode.xml:132
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/graphlib/libqrencode.xml:135
#, xml-text
msgid ""
"<option>--with-tests</option>: This option allows building the test "
"programs. It requires <xref linkend=\"sdl2\"/>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/graphlib/libqrencode.xml:140
#, xml-text
msgid ""
"<option>--without-tools</option>: This option prevents building the "
"<command>qrencode</command> executable, removing the need for <xref "
"linkend=\"libpng\"/>."
msgstr ""

