#, xml-text
msgid "Installation of AAlib"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/graphlib/aalib.xml:85
#, xml-text
msgid "Fix a minor problem with the included m4 file:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/graphlib/aalib.xml:88
#, no-wrap, xml-text
msgid ""
"<userinput>sed -i -e '/AM_PATH_AALIB,/s/AM_PATH_AALIB/[&amp;]/' "
"aalib.m4</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/graphlib/aalib.xml:91
#, xml-text
msgid ""
"Change the default X11 font from <xref linkend='xorg7-legacy'/> to <xref "
"linkend='xorg7-font'/>:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/graphlib/aalib.xml:95
#, no-wrap, xml-text
msgid ""
"<userinput>sed -e 's/8x13bold/-*-luxi mono-bold-r-normal--13-120-*-*-m-*-*-*/' \\\n"
"    -i src/aax.c</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/graphlib/aalib.xml:99
#, xml-text
msgid ""
"Fix an overuse of some ncurses internal data structures to allow building "
"this package with ncurses-6.5 or later:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/graphlib/aalib.xml:103
#, no-wrap, xml-text
msgid ""
"<userinput>sed 's/stdscr->_max\\([xy]\\) + 1/getmax\\1(stdscr)/' \\\n"
"    -i src/aacurses.c</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/graphlib/aalib.xml:107
#, xml-text
msgid ""
"To allow building this package with GCC-14 or later, add some missing "
"<literal>#include</literal> directives and fix a bad "
"<literal>return</literal> statement to make the code C99-compatible.  Then "
"regenerate the <command>configure</command> script to ensure the C code for "
"probing system features is C99-compatible as well:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/graphlib/aalib.xml:114
#, no-wrap, xml-text
msgid ""
"<userinput>sed -i '1i#include &lt;stdlib.h&gt;'                            \\\n"
"    src/aa{fire,info,lib,linuxkbd,savefont,test,regist}.c &amp;&amp;\n"
"sed -i '1i#include &lt;string.h&gt;'                            \\\n"
"    src/aa{kbdreg,moureg,test,regist}.c                   &amp;&amp;\n"
"sed -i '/X11_KBDDRIVER/a#include &lt;X11/Xutil.h&gt;'           \\\n"
"    src/aaxkbd.c                                          &amp;&amp;\n"
"sed -i '/rawmode_init/,/^}/s/return;/return 0;/'          \\\n"
"    src/aalinuxkbd.c                                      &amp;&amp;\n"
"autoconf</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/graphlib/aalib.xml:125
#, xml-text
msgid ""
"Install <application>AAlib</application> by running the following commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/graphlib/aalib.xml:129
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr             \\\n"
"            --infodir=/usr/share/info \\\n"
"            --mandir=/usr/share/man   \\\n"
"            --with-ncurses=/usr       \\\n"
"            --disable-static          &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/graphlib/aalib.xml:137
#, xml-text
msgid "This package does not come with a test suite."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/graphlib/aalib.xml:141
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/graphlib/aalib.xml:144
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr ""

