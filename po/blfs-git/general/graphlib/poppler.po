#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/graphlib/poppler.xml:160
#, xml-text
msgid "Installation of Poppler"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/graphlib/poppler.xml:163
#, xml-text
msgid ""
"Now, install <application>Poppler</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/graphlib/poppler.xml:167
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build                         &amp;&amp;\n"
"cd    build                         &amp;&amp;\n"
"\n"
"cmake -D CMAKE_BUILD_TYPE=Release   \\\n"
"      -D CMAKE_INSTALL_PREFIX=/usr  \\\n"
"      -D TESTDATADIR=$PWD/testfiles \\\n"
"      -D ENABLE_QT5=OFF             \\\n"
"      -D ENABLE_UNSTABLE_API_ABI_HEADERS=ON \\\n"
"      -G Ninja ..                   &amp;&amp;\n"
"ninja</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/graphlib/poppler.xml:179
#, xml-text
msgid ""
"In order to run the test suite, some testcases are needed and can be "
"obtained only from a git repository. The command to download them is: "
"<command>git clone --depth 1 https://gitlab.freedesktop.org/poppler/test.git"
" testfiles</command>.  Then issue: <command>LC_ALL=en_US.UTF-8 ninja "
"test</command>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/graphlib/poppler.xml:187
#: blfs-en/blfs-git/general/graphlib/poppler.xml:212
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/graphlib/poppler.xml:190
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/graphlib/poppler.xml:193
#, xml-text
msgid ""
"To install the documentation, run the following commands as <systemitem "
"class=\"username\">root</systemitem>:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/graphlib/poppler.xml:197
#, no-wrap, xml-text
msgid ""
"<userinput>install -v -m755 -d           /usr/share/doc/poppler-&poppler-version; &amp;&amp;\n"
"cp -vr ../glib/reference/html /usr/share/doc/poppler-&poppler-version;</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/blfs-git/general/graphlib/poppler.xml:201
#, xml-text
msgid "Poppler Data"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/graphlib/poppler.xml:204
#, xml-text
msgid ""
"If you downloaded the additional encoding data package, install it by "
"issuing the following commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/graphlib/poppler.xml:208
#, no-wrap, xml-text
msgid ""
"<userinput>tar -xf ../../poppler-data-&poppler-data-version;.tar.gz &amp;&amp;\n"
"cd poppler-data-&poppler-data-version;</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/graphlib/poppler.xml:215
#, no-wrap, xml-text
msgid "<userinput>make prefix=/usr install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/graphlib/poppler.xml:220
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/graphlib/poppler.xml:223
#, xml-text
msgid ""
"<parameter>-D CMAKE_BUILD_TYPE=Release</parameter>: This switch is used to "
"apply a higher level of compiler optimizations."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/graphlib/poppler.xml:228
#, xml-text
msgid ""
"<parameter>-D TESTDATADIR=$PWD/testfiles</parameter>: Tells the test "
"programs where the auxiliary files are located."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/graphlib/poppler.xml:233
#, xml-text
msgid ""
"<parameter>-D ENABLE_QT5=OFF</parameter>: This switch is needed to prevent "
"an error when Qt5 is not installed."
msgstr ""

#. (e.g. <application>
#. Inkscape</application>).
#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/graphlib/poppler.xml:238
#, xml-text
msgid ""
"<parameter>-D ENABLE_UNSTABLE_API_ABI_HEADERS=ON</parameter>: Installs some "
"old <application>Xpdf</application> headers required by certain programs."
msgstr ""

#. and Pygments
#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/graphlib/poppler.xml:244
#, xml-text
msgid ""
"<option>-D ENABLE_GTK_DOC=ON</option>: Use this parameter if GTK-Doc is "
"installed and you wish to rebuild and install the API documentation."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/graphlib/poppler.xml:250
#, xml-text
msgid ""
"<option>-D ENABLE_QT6=OFF</option>: Use this parameter if <xref "
"linkend='qt6'/> is not installed."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/graphlib/poppler.xml:255
#, xml-text
msgid ""
"<option>-D ENABLE_BOOST=OFF</option>: Use this parameter if you have not "
"installed <application>boost</application> (the Splash backend for Qt6 "
"recommends boost)."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/graphlib/poppler.xml:261
#, xml-text
msgid ""
"<option>-D ENABLE_NSS3=OFF</option>: Use this parameter if you have not "
"installed <application>nss</application>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/graphlib/poppler.xml:266
#, xml-text
msgid ""
"<option>-D ENABLE_GPGME=OFF</option>: Use this parameter if you have not "
"installed <application>gpgme</application>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/graphlib/poppler.xml:271
#, xml-text
msgid ""
"<option>-D ENABLE_LIBTIFF=OFF</option>: Use this parameter if you have not "
"installed <application>libtiff</application>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/graphlib/poppler.xml:276
#, xml-text
msgid ""
"<command>LC_ALL=en_US.UTF-8 ninja test</command>: Runs the test suite.  The "
"environment variable LC_ALL=en_US.UTF-8 is only needed if the default locale"
" does not include UTF-8."
msgstr ""

