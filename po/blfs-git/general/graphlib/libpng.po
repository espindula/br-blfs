#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/graphlib/libpng.xml:99
#, xml-text
msgid "Installation of libpng"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/graphlib/libpng.xml:102
#, xml-text
msgid "If you want to patch libpng to support apng files, apply it here:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/graphlib/libpng.xml:105
#, no-wrap, xml-text
msgid ""
"<userinput>gzip -cd ../libpng-&apng-version;-apng.patch.gz | patch "
"-p1</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/graphlib/libpng.xml:108
#, xml-text
msgid ""
"Install <application>libpng</application> by running the following commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/graphlib/libpng.xml:112
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr --disable-static &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/graphlib/libpng.xml:116
#, xml-text
msgid "To test the results, issue: <command>make check</command>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/graphlib/libpng.xml:120
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/graphlib/libpng.xml:123
#, no-wrap, xml-text
msgid ""
"<userinput>make install &amp;&amp;\n"
"mkdir -v /usr/share/doc/libpng-&libpng-version; &amp;&amp;\n"
"cp -v README libpng-manual.txt /usr/share/doc/libpng-&libpng-version;</userinput>"
msgstr ""

