#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/blfs-git/general/graphlib/harfbuzz.xml:70
#, xml-text
msgid "HarfBuzz Dependencies"
msgstr ""

#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/blfs-git/general/graphlib/harfbuzz.xml:72
#, xml-text
msgid "Recommended"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/graphlib/harfbuzz.xml:74
#, xml-text
msgid ""
"<xref linkend=\"glib2\"/> (required for Pango; GObject Introspection "
"required for building GNOME), <xref role=\"first\" linkend=\"graphite2\"/> "
"(required for building <xref role=\"nodep\" linkend=\"texlive\"/> or <xref "
"role=\"nodep\" linkend=\"libreoffice\"/> with system harfbuzz), <xref "
"linkend=\"icu\"/>, and <xref linkend=\"freetype2\"/>"
msgstr ""

#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/blfs-git/general/graphlib/harfbuzz.xml:83
#, xml-text
msgid "Optional"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/graphlib/harfbuzz.xml:85
#, xml-text
msgid ""
"<xref linkend=\"cairo\"/> (circular: build cairo and all its recommended "
"dependencies, including harfbuzz, first, then rebuild harfbuzz if the cairo "
"backend is needed), <xref linkend=\"git\"/>, <xref linkend=\"gtk-doc\"/>, "
"<ulink url=\"https://pypi.org/project/FontTools/\">FontTools</ulink> (Python"
" 3 module, for the test suite), <ulink url=\"https://www.colm.net/open-"
"source/ragel/\">ragel</ulink>, and <ulink "
"url=\"https://github.com/bytecodealliance/wasm-micro-runtime\">wasm-micro-"
"runtime</ulink>"
msgstr ""

#. type: Content of: <sect1><sect2><warning><para>
#: blfs-en/blfs-git/general/graphlib/harfbuzz.xml:98
#, xml-text
msgid ""
"Recommended dependencies are not strictly required to build the package. "
"However, you might not get expected results at runtime if you don't install "
"them. Please do not report bugs with this package if you <emphasis>have "
"not</emphasis> installed the recommended dependencies."
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/graphlib/harfbuzz.xml:109
#, xml-text
msgid "Installation of HarfBuzz"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/graphlib/harfbuzz.xml:112
#, xml-text
msgid ""
"Install <application>HarfBuzz</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/graphlib/harfbuzz.xml:116
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup ..             \\\n"
"      --prefix=/usr        \\\n"
"      --buildtype=release  \\\n"
"      -D graphite2=enabled &amp;&amp;\n"
"ninja</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/graphlib/harfbuzz.xml:126
#, xml-text
msgid "To test the results, issue: <command>ninja test</command>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/graphlib/harfbuzz.xml:130
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/graphlib/harfbuzz.xml:133
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/graphlib/harfbuzz.xml:137
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/graphlib/harfbuzz.xml:143
#, xml-text
msgid ""
"<parameter>-D graphite2=enabled</parameter>: This switch enables "
"<application>Graphite2</application> support, which is required for building"
" <xref linkend=\"texlive\"/> or <xref linkend=\"libreoffice\"/> with system "
"harfbuzz."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/graphlib/harfbuzz.xml:150
#, xml-text
msgid ""
"<option>-D docs=disabled</option>: If <xref linkend=\"gtk-doc\"/> is "
"installed, the documentation is built and installed. This switch prevents "
"that."
msgstr ""

