#, xml-text
msgid "Installation of libtiff"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/graphlib/libtiff.xml:114
#, xml-text
msgid ""
"Install <application>libtiff</application> by running the following "
"commands:"
msgstr ""

#.  "build" exists in the source tree
#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/graphlib/libtiff.xml:119
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir -p libtiff-build &amp;&amp;\n"
"cd       libtiff-build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr \\\n"
"      -D CMAKE_BUILD_TYPE=Release  \\\n"
"      -W no-dev -G Ninja ..\n"
"ninja</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/graphlib/libtiff.xml:128
#, xml-text
msgid "To test the results, issue: <command>ninja test</command>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/graphlib/libtiff.xml:132
#, xml-text
msgid "Now, as the &root; user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/graphlib/libtiff.xml:135
#, no-wrap, xml-text
msgid ""
"<userinput>ninja install &amp;&amp;\n"
"mv -v /usr/share/doc/{tiff,libtiff-&libtiff-version;}</userinput>"
msgstr ""

