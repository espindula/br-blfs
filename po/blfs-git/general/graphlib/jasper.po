#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/graphlib/jasper.xml:92
#, xml-text
msgid "Installation of jasper"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/graphlib/jasper.xml:102
#, xml-text
msgid ""
"Install <application>jasper</application> by running the following commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/graphlib/jasper.xml:106
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir BUILD &amp;&amp;\n"
"cd    BUILD &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr    \\\n"
"      -D CMAKE_BUILD_TYPE=Release     \\\n"
"      -D CMAKE_SKIP_INSTALL_RPATH=ON  \\\n"
"      -D JAS_ENABLE_DOC=NO            \\\n"
"      -D ALLOW_IN_SOURCE_BUILD=YES    \\\n"
"      -D CMAKE_INSTALL_DOCDIR=/usr/share/doc/jasper-&jasper-version; \\\n"
"      ..  &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/graphlib/jasper.xml:119
#, xml-text
msgid "To test the results, issue: <command>make test</command>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/graphlib/jasper.xml:123
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/graphlib/jasper.xml:126
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/graphlib/jasper.xml:131
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/graphlib/jasper.xml:137
#, xml-text
msgid ""
"<parameter>-D JAS_ENABLE_DOC=NO</parameter>: This option disables rebuilding"
" the pdf documentation if <xref linkend=\"texlive\"/> is installed."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/graphlib/jasper.xml:143
#, xml-text
msgid ""
"<parameter>-D ALLOW_IN_SOURCE_BUILD=YES</parameter>: This switch allows "
"building from within the source tree. In our case, this is needed to allow "
"us to build inside of the BUILD directory instead of needing to create "
"another directory outside of the source tree."
msgstr ""

