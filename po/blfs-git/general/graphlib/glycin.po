#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/graphlib/glycin.xml:114
#, xml-text
msgid "Installation of glycin"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/graphlib/glycin.xml:117
#, xml-text
msgid ""
"If installing Xorg into <filename class='directory'>/opt</filename>, "
"download the needed Rust crates now and apply a patch to allow accessing "
"<filename class='directory'>$XORG_PREFIX/lib</filename> from the sandbox "
"(note that the patch requires <envar>XORG_PREFIX</envar> set properly for "
"the current user and &root; following <xref linkend='xorg-env'/> before "
"building glycin):"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/graphlib/glycin.xml:125
#, no-wrap, xml-text
msgid ""
"<userinput>cargo vendor &amp;&amp;\n"
"patch -Np1 -i ../glycin-&glycin-version;-xorg_prefix-1.patch</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/graphlib/glycin.xml:129
#, xml-text
msgid ""
"Install <application>glycin</application> by running the following commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/graphlib/glycin.xml:133
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr           \\\n"
"            --buildtype=release     \\\n"
"            -D libglycin-gtk4=false \\\n"
"            -D tests=false ..       &amp;&amp;\n"
"ninja</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/graphlib/glycin.xml:143
#, xml-text
msgid ""
"If you have installed <xref linkend=\"gi-docgen\"/>, you can build the "
"documentation by issuing:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/graphlib/glycin.xml:147
#, no-wrap, xml-text
msgid ""
"<userinput>sed \"/install_dir:.*doc/s|,$| / 'glycin-' + meson.project_version()&amp;|\" \\\n"
"    -i ../libglycin/meson.build &amp;&amp;\n"
"\n"
"meson configure -D capi_docs=true &amp;&amp;\n"
"ninja</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/graphlib/glycin.xml:154
#, xml-text
msgid ""
"To test the results, ensure <xref linkend='gtk4'/> is installed, then issue:"
" <command>meson configure -D tests=true &amp;&amp; ninja test</command>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/graphlib/glycin.xml:160
#, xml-text
msgid "Now as the &root; user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/graphlib/glycin.xml:163
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/graphlib/glycin.xml:168
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/graphlib/glycin.xml:171
#, xml-text
msgid ""
"<parameter>-D glycin_gtk4=false</parameter>: This parameter disables the "
"build of <systemitem class='library'>libglycin-gtk4</systemitem> (which is "
"not used by any BLFS packages yet) so this package can be built without "
"<xref linkend='gtk4'/> installed."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/graphlib/glycin.xml:178
#, xml-text
msgid ""
"<option>-D glycin-loaders=...</option>: Use this option to specify the image"
" loaders to be built.  The default is <literal>glycin-heif,glycin-image-"
"rs,glycin-jxl,glycin-svg</literal>, covering the support for all commonly "
"used image formats.  You may remove the <literal>glycin-heif</literal>, "
"<literal>glycin-jxl</literal>, or <literal>glycin-svg</literal> loader if "
"the corresponding recommended dependency is not installed, but doing so will"
" cause test failures and hamper the functionality of this package.  There "
"are also loaders for the JPEG 2000 and RAW formats but they are not enabled "
"by default."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/graphlib/glycin.xml:191
#, xml-text
msgid ""
"<option>-D vapi=false</option>: This option allows building this package "
"without <xref linkend='vala'/> installed."
msgstr ""

