#: blfs-en/blfs-git/general/graphlib/sassc.xml:133
#: blfs-en/blfs-git/general/graphlib/sassc.xml:153
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/graphlib/sassc.xml:136
#: blfs-en/blfs-git/general/graphlib/sassc.xml:156
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/graphlib/sassc.xml:139
#, xml-text
msgid "Build the command line wrapper:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/graphlib/sassc.xml:142
#, no-wrap, xml-text
msgid ""
"<userinput>popd &amp;&amp;\n"
"autoreconf -fi &amp;&amp;\n"
"\n"
"./configure --prefix=/usr &amp;&amp;\n"
"make</userinput>"
msgstr ""

