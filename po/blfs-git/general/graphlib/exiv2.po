#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/graphlib/exiv2.xml:110
#, xml-text
msgid "Installation of Exiv2"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/graphlib/exiv2.xml:119
#, xml-text
msgid ""
"Install <application>Exiv2</application> by running the following commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/graphlib/exiv2.xml:123
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr   \\\n"
"      -D CMAKE_BUILD_TYPE=Release    \\\n"
"      -D EXIV2_ENABLE_VIDEO=yes      \\\n"
"      -D EXIV2_ENABLE_WEBREADY=yes   \\\n"
"      -D EXIV2_ENABLE_CURL=yes       \\\n"
"      -D EXIV2_BUILD_SAMPLES=no      \\\n"
"      -D CMAKE_SKIP_INSTALL_RPATH=ON \\\n"
"      -G Ninja ..                    &amp;&amp;\n"
"ninja</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/graphlib/exiv2.xml:137
#, xml-text
msgid "To test the results, issue: <command>ninja test</command>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/graphlib/exiv2.xml:141
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/graphlib/exiv2.xml:144
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/graphlib/exiv2.xml:149
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/graphlib/exiv2.xml:155
#, xml-text
msgid ""
"<parameter>-D EXIV2_ENABLE_VIDEO=yes</parameter>: This switch enables "
"managing video metadata."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/graphlib/exiv2.xml:160
#, xml-text
msgid ""
"<parameter>-D EXIV2_ENABLE_WEBREADY=yes</parameter>: This switch enables "
"managing web image metadata."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/graphlib/exiv2.xml:165
#, xml-text
msgid ""
"<parameter>-D EXIV2_BUILD_SAMPLES=no</parameter>: This switch is necessary "
"to suppress building and installing sample programs.  If the sample programs"
" are built, 34 additional programs are installed in /usr/bin."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/graphlib/exiv2.xml:172
#, xml-text
msgid ""
"<parameter>-D EXIV2_ENABLE_CURL=yes</parameter>: This switch is necessary to"
" enable network/http capabilities."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/graphlib/exiv2.xml:177
#, xml-text
msgid ""
"<option>-D EXIV2_ENABLE_INIH=no</option>: Use this switch if you have not "
"installed <xref linkend=\"inih\"/>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/graphlib/exiv2.xml:182
#, xml-text
msgid ""
"<option>-D EXIV2_ENABLE_BROTLI=no</option>: Use this switch if you have not "
"installed <xref linkend=\"brotli\"/>."
msgstr ""

