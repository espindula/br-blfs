#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/graphlib/woff2.xml:96
#, xml-text
msgid "Installation of WOFF2"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/graphlib/woff2.xml:99
#, xml-text
msgid "First, fix a problem when building with gcc-15:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/graphlib/woff2.xml:102
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"pre\">sed -i '/output.h/i #include &lt;cstdint&gt;' "
"src/woff2_out.cc</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/graphlib/woff2.xml:105
#, xml-text
msgid ""
"Install <application>WOFF2</application> by running the following commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/graphlib/woff2.xml:109
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir out                                 &amp;&amp;\n"
"cd    out                                 &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr        \\\n"
"      -D CMAKE_BUILD_TYPE=Release         \\\n"
"      -D CMAKE_POLICY_VERSION_MINIMUM=3.5 \\\n"
"      -D CMAKE_SKIP_INSTALL_RPATH=ON ..   &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/graphlib/woff2.xml:119
#, xml-text
msgid "This package does not come with a test suite."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/graphlib/woff2.xml:123
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/graphlib/woff2.xml:126
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr ""

