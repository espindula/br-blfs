#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/graphlib/giflib.xml:106
#, xml-text
msgid "Installation of giflib"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/graphlib/giflib.xml:109
#, xml-text
msgid ""
"First, prevent the build process from installing XML files instead of man "
"pages:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/graphlib/giflib.xml:113
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"pre\">patch -Np1 -i ../giflib-&giflib-"
"version;-upstream_fixes-1.patch</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/graphlib/giflib.xml:116
#, xml-text
msgid "Next, fix several security vulnerabilities in the 'gif2rgb' utility:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/graphlib/giflib.xml:119
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"pre\">patch -Np1 -i ../giflib-&giflib-"
"version;-security_fixes-1.patch</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/graphlib/giflib.xml:122
#, xml-text
msgid ""
"Next, remove an unnecessary dependency on <xref linkend=\"imagemagick\"/> by"
" moving a file into an expected location:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/graphlib/giflib.xml:126
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"pre\">cp pic/gifgrid.gif doc/giflib-logo.gif</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/graphlib/giflib.xml:129
#, xml-text
msgid ""
"Install <application>giflib</application> by running the following commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/graphlib/giflib.xml:133
#, no-wrap, xml-text
msgid "<userinput>make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/graphlib/giflib.xml:136
#, xml-text
msgid "To test the results, issue: <command>make check</command>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/graphlib/giflib.xml:140
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/graphlib/giflib.xml:143
#, no-wrap, xml-text
msgid ""
"<userinput>make PREFIX=/usr install &amp;&amp;\n"
"\n"
"rm -fv /usr/lib/libgif.a &amp;&amp;\n"
"\n"
"find doc \\( -name Makefile\\* -o -name \\*.1 \\\n"
"         -o -name \\*.xml \\) -exec rm -v {} \\; &amp;&amp;\n"
"\n"
"install -v -dm755 /usr/share/doc/giflib-&giflib-version; &amp;&amp;\n"
"cp -v -R doc/* /usr/share/doc/giflib-&giflib-version;</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/graphlib/giflib.xml:163
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/graphlib/giflib.xml:166
#, xml-text
msgid ""
"<command>rm -fv /usr/lib/libgif.a</command>: This command removes a static "
"library which is not used by any BLFS package."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/graphlib/giflib.xml:171
#, xml-text
msgid ""
"<command>find doc ... -exec rm -v {} \\;</command>: This command removes "
"<filename>Makefiles</filename>, man and xml files from the documentation "
"directory that would otherwise be installed by the commands that follow."
msgstr ""

