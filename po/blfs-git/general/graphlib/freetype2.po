#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/graphlib/freetype2.xml:119
#, xml-text
msgid "Installation of FreeType2"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/graphlib/freetype2.xml:122
#, xml-text
msgid ""
"If you downloaded the additional documentation, unpack it into the source "
"tree using the following command:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/graphlib/freetype2.xml:126
#, no-wrap, xml-text
msgid ""
"<userinput>tar -xf ../freetype-doc-&freetype2-doc-version;.tar.xz --strip-"
"components=2 -C docs</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/graphlib/freetype2.xml:129
#, xml-text
msgid ""
"Install <application>FreeType2</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/graphlib/freetype2.xml:133
#, no-wrap, xml-text
msgid ""
"<userinput>sed -ri \"s:.*(AUX_MODULES.*valid):\\1:\" modules.cfg &amp;&amp;\n"
"\n"
"sed -r \"s:.*(#.*SUBPIXEL_RENDERING) .*:\\1:\" \\\n"
"    -i include/freetype/config/ftoption.h  &amp;&amp;\n"
"\n"
"./configure --prefix=/usr            \\\n"
"            --disable-static         \\\n"
"            --enable-freetype-config \\\n"
"            --with-harfbuzz=dynamic &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/graphlib/freetype2.xml:145
#, xml-text
msgid "This package does not come with a test suite."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/graphlib/freetype2.xml:149
#, xml-text
msgid "Now, as the &root; user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/graphlib/freetype2.xml:152
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/graphlib/freetype2.xml:155
#, xml-text
msgid ""
"If you downloaded the optional documentation, install it as the <systemitem "
"class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/graphlib/freetype2.xml:159
#, no-wrap, xml-text
msgid ""
"<userinput>cp -v -R docs -T /usr/share/doc/freetype-&freetype2-version; &amp;&amp;\n"
"rm -v /usr/share/doc/freetype-&freetype2-version;/freetype-config.1</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/graphlib/freetype2.xml:165
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/graphlib/freetype2.xml:168
#, xml-text
msgid ""
"<command>sed -ri ...</command>: First command enables GX/AAT and OpenType "
"table validation and second command enables Subpixel Rendering. Note that "
"Subpixel Rendering may have patent issues.  Be sure to read the "
"<literal>'Other patent issues'</literal> part of <ulink "
"url=\"https://freetype.org/patents.html\"/> before enabling this option."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/graphlib/freetype2.xml:179
#, xml-text
msgid ""
"<parameter>--enable-freetype-config</parameter>: This switch ensures that "
"the man page for freetype-config is installed."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/graphlib/freetype2.xml:184
#, xml-text
msgid ""
"<parameter>--with-harfbuzz=dynamic</parameter>: This switch ensures that "
"HarfBuzz is loaded dynamically, skipping the requirement to rebuild this "
"package after HarfBuzz is installed."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/graphlib/freetype2.xml:193
#, xml-text
msgid ""
"<option>--without-harfbuzz</option>: If <application>harfbuzz</application> "
"is installed prior to <application>freetype</application> without "
"<application>freetype</application> support, use this switch to avoid a "
"build failure."
msgstr ""

