#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/graphlib/newt.xml:88
#, xml-text
msgid "Installation of newt"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/graphlib/newt.xml:91
#, xml-text
msgid ""
"Install <application>newt</application> by running the following command:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/graphlib/newt.xml:95
#, no-wrap, xml-text
msgid ""
"<userinput>sed -e '/install -m 644 $(LIBNEWT)/ s/^/#/' \\\n"
"    -e '/$(LIBNEWT):/,/rv/ s/^/#/'          \\\n"
"    -e 's/$(LIBNEWT)/$(LIBNEWTSH)/g'        \\\n"
"    -i Makefile.in                          &amp;&amp;\n"
"\n"
"./configure --prefix=/usr      \\\n"
"            --with-gpm-support &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/graphlib/newt.xml:105
#, xml-text
msgid "This package does not come with a test suite."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/graphlib/newt.xml:109
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/graphlib/newt.xml:112
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/graphlib/newt.xml:117
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/graphlib/newt.xml:120
#, xml-text
msgid ""
"<command>sed -e ... -i Makefile.in</command>: Disables installation of a "
"static library."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/graphlib/newt.xml:125
#, xml-text
msgid ""
"<parameter>--with-gpm-support</parameter>: This switch enables mouse support"
" for newt applications through GPM."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/graphlib/newt.xml:130
#, xml-text
msgid ""
"<parameter>--with-python=python&python3-majorver;</parameter>: By giving "
"explicitly the name of the directory where python modules reside, this "
"switch prevents building the python2 module."
msgstr ""

