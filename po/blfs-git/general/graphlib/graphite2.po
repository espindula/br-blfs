#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/graphlib/graphite2.xml:87
#, xml-text
msgid ""
"<xref linkend=\"freetype2\"/>, <ulink "
"url=\"https://sourceforge.net/projects/silgraphite/files/silgraphite/2.3.1/\">silgraphite</ulink>"
" to build the <command>comparerender</command> test and benchmarking tool, "
"and if that is present, and <xref linkend=\"harfbuzz\"/> to add more "
"functionality to it (this is a circular dependency, you would need to first "
"build <application>graphite2</application> without "
"<application>harfbuzz</application>)."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/graphlib/graphite2.xml:98
#, xml-text
msgid ""
"To build the documentation: <xref linkend=\"asciidoc\"/>, <xref "
"linkend=\"doxygen\"/>, <xref linkend=\"texlive\"/> (or <xref linkend=\"tl-"
"installer\"/>), and <ulink url=\"https://dblatex.sourceforge.net/\"> "
"dblatex</ulink> (for PDF docs)"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/graphlib/graphite2.xml:107
#, xml-text
msgid ""
"To execute the test suite you will need <ulink "
"url=\"https://pypi.python.org/pypi/FontTools\">FontTools</ulink> (Python 3 "
"module), otherwise, the \"cmp\" tests fail."
msgstr ""

#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/blfs-git/general/graphlib/graphite2.xml:112
#, xml-text
msgid "Optional (at runtime)"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/graphlib/graphite2.xml:114
#, xml-text
msgid ""
"You will need at least one suitable <ulink role=\"runtime\" "
"url=\"https://scripts.sil.org/cms/scripts/page.php?site_id=projects&amp;item_id=graphite_fonts\">graphite"
" font</ulink> for the package to be useful."
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/graphlib/graphite2.xml:122
#, xml-text
msgid "Installation of Graphite2"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/graphlib/graphite2.xml:125
#, xml-text
msgid ""
"Some tests fail if <ulink "
"url=\"https://pypi.python.org/pypi/FontTools\">FontTools</ulink> (Python 3 "
"module) is not installed. These tests can be removed with:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/graphlib/graphite2.xml:130
#, no-wrap, xml-text
msgid "<userinput>sed -i '/cmptest/d' tests/CMakeLists.txt</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/graphlib/graphite2.xml:136
#, xml-text
msgid ""
"Fix building this package with CMake 4.0 by updating its syntax to conform "
"to newer versions of CMake:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/graphlib/graphite2.xml:140
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"pre\">sed -i '/cmake_policy(SET CMP0012 NEW)/d' CMakeLists.txt &amp;&amp;\n"
"sed -i 's/PythonInterp/Python3/' CMakeLists.txt          &amp;&amp;\n"
"find . -name CMakeLists.txt | xargs sed -i 's/VERSION 2.8.0 FATAL_ERROR/VERSION 4.0.0/'</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/graphlib/graphite2.xml:145
#, xml-text
msgid "Now fix a problem when building with gcc-15:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/graphlib/graphite2.xml:148
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"pre\">sed -i '/Font.h/i #include &lt;cstdint&gt;' "
"tests/featuremap/featuremaptest.cpp</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/graphlib/graphite2.xml:151
#, xml-text
msgid ""
"Install <application>Graphite2</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/graphlib/graphite2.xml:155
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr .. &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/graphlib/graphite2.xml:162
#, xml-text
msgid "If you wish to build the documentation, issue:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/graphlib/graphite2.xml:165
#, no-wrap, xml-text
msgid "<userinput>make docs</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/graphlib/graphite2.xml:169
#, xml-text
msgid ""
"To test the results, issue: <command>make test</command>.  One test named "
"<filename>nametabletest</filename> is known to fail."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/graphlib/graphite2.xml:174
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/graphlib/graphite2.xml:177
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/graphlib/graphite2.xml:180
#, xml-text
msgid ""
"If you built the documentation, install, as the <systemitem "
"class=\"username\">root</systemitem> user:"
msgstr ""

#.  doc/doxygen seems to have gone, so I removed the api dir, but now both
#. html
#. and pdf for the GTF and the manual
#. cp      -v -r -f    doc/doxygen/{html,latex/refman.pdf} \
#.                     /usr/share/doc/graphite2-&graphite2-version;/api
#. &amp;&amp;
#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/graphlib/graphite2.xml:185
#, no-wrap, xml-text
msgid ""
"<userinput>install -v -d -m755 /usr/share/doc/graphite2-&graphite2-version; &amp;&amp;\n"
"\n"
"cp      -v -f    doc/{GTF,manual}.html \\\n"
"                    /usr/share/doc/graphite2-&graphite2-version; &amp;&amp;\n"
"cp      -v -f    doc/{GTF,manual}.pdf \\\n"
"                    /usr/share/doc/graphite2-&graphite2-version;</userinput>"
msgstr ""

