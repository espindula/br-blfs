#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/genlib/libaio.xml:77
#, xml-text
msgid "Installation of libaio"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/libaio.xml:80
#, xml-text
msgid "First, disable the installation of the static library:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genlib/libaio.xml:83
#, no-wrap, xml-text
msgid "<userinput>sed -i '/install.*libaio.a/s/^/#/' src/Makefile</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/libaio.xml:85
#, xml-text
msgid "Next, fix an issue in the test suite:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genlib/libaio.xml:87
#, no-wrap, xml-text
msgid ""
"<userinput>case \"$(uname -m)\" in\n"
"  i?86) sed -e \"s/off_t/off64_t/\" -i harness/cases/23.t ;;\n"
"esac</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/libaio.xml:92
#, xml-text
msgid ""
"Build <application>libaio</application> by running the following command:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genlib/libaio.xml:96
#, no-wrap, xml-text
msgid "<userinput>make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/libaio.xml:99
#, xml-text
msgid "To test the results, issue: <command>make partcheck</command>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/libaio.xml:103
#, xml-text
msgid ""
"Now, install the package as the <systemitem "
"class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genlib/libaio.xml:107
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr ""

