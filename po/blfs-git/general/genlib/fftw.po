#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/genlib/fftw.xml:75
#, xml-text
msgid "Installation of fftw"
msgstr ""

#. type: Content of: <sect1><sect2><note><para>
#: blfs-en/blfs-git/general/genlib/fftw.xml:79
#, xml-text
msgid ""
"We build fftw three times for different libraries in different numerical "
"precisions: the default double precision floating point, the older 32-bit "
"(single precision) version named float which sacrifices precision for speed,"
" and the long double which offers increased precision at the cost of slower "
"execution."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/fftw.xml:88
#, xml-text
msgid ""
"The first build is for double precision arithmetic.  Install "
"<application>fftw</application> by running the following commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genlib/fftw.xml:92
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr    \\\n"
"            --enable-shared  \\\n"
"            --disable-static \\\n"
"            --enable-threads \\\n"
"            --enable-sse2    \\\n"
"            --enable-avx     \\\n"
"            --enable-avx2    &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/fftw.xml:102
#, xml-text
msgid ""
"To test the results, issue: <command>make check</command>.  On 32-bit "
"systems, the tests can take substantially longer than they would on 64-bit "
"machines."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/fftw.xml:108
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genlib/fftw.xml:111
#: blfs-en/blfs-git/general/genlib/fftw.xml:133
#: blfs-en/blfs-git/general/genlib/fftw.xml:152
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/fftw.xml:114
#, xml-text
msgid "Now build single precision:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genlib/fftw.xml:117
#, no-wrap, xml-text
msgid ""
"<userinput>make clean &amp;&amp;\n"
"\n"
"./configure --prefix=/usr    \\\n"
"            --enable-shared  \\\n"
"            --disable-static \\\n"
"            --enable-threads \\\n"
"            --enable-sse2    \\\n"
"            --enable-avx     \\\n"
"            --enable-avx2    \\\n"
"            --enable-float   &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/fftw.xml:130
#: blfs-en/blfs-git/general/genlib/fftw.xml:149
#, xml-text
msgid "As the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/fftw.xml:136
#, xml-text
msgid "Finally, build long double precision:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genlib/fftw.xml:139
#, no-wrap, xml-text
msgid ""
"<userinput>make clean &amp;&amp;\n"
"\n"
"./configure --prefix=/usr    \\\n"
"            --enable-shared  \\\n"
"            --disable-static \\\n"
"            --enable-threads \\\n"
"            --enable-long-double &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/genlib/fftw.xml:157
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/fftw.xml:160
#, xml-text
msgid ""
"<parameter>--enable-shared</parameter> <parameter>--disable-"
"static</parameter>: Use shared libs instead of static libs."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/fftw.xml:166
#, xml-text
msgid ""
"<parameter>--enable-threads</parameter>: This enables <filename "
"class=\"libraryfile\"> libfftw3_threads.so</filename> to be compiled.  It is"
" used by e.g. the <application>gimp</application> plugin from <ulink "
"url=\"https://gmic.eu/\">G'MIC</ulink>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/fftw.xml:173
#, xml-text
msgid ""
"<parameter>--enable-{sse2,avx,avx2}</parameter>: These enables building the "
"optimized routines using SSE2, AVX, and AVX2 instructions.  FFTW will check "
"if these routines can be really used on the current CPU when the FFTW "
"library is loaded, so a FFTW build with these routines enabled can still run"
" on a CPU without SSE2, AVX, or AVX2.  These options are not compatible with"
" <parameter>--enable-long-double</parameter>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/fftw.xml:182
#, xml-text
msgid ""
"<parameter>--enable-float</parameter>: This enables building the library "
"that uses single precision floating point arithmetic.  It is faster but less"
" precise than the default double precision library.  The library will be "
"called <filename class=\"libraryfile\">libfftw3f.so</filename> needed by "
"<xref linkend=\"pulseaudio\"/>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/fftw.xml:190
#, xml-text
msgid ""
"<parameter>--enable-long-double</parameter>: This enables building the "
"library that uses higher precision long-double floating point arithmetic.  "
"The library will be called <filename "
"class=\"libraryfile\">libfftw3l.so</filename>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/fftw.xml:197
#, xml-text
msgid ""
"<option>--enable-avx512</option>: This enables building the optimized "
"routines using AVX512F instructions.  FFTW will check if these routines can "
"be really used on the current CPU when the FFTW library is loaded, so a FFTW"
" build with these routines enabled can still run on a CPU without AVX512F.  "
"Use this option if the FFTW build will be used on a CPU with AVX512F.  This "
"option is not compatible with <parameter>--enable-long-double</parameter>."
msgstr ""

