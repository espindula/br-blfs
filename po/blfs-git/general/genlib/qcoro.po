#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/genlib/qcoro.xml:77
#, xml-text
msgid "Installation of qcoro"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/qcoro.xml:80
#, xml-text
msgid ""
"Install <application>qcoro</application> by running the following commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genlib/qcoro.xml:84
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=$QT6DIR \\\n"
"      -D CMAKE_BUILD_TYPE=Release     \\\n"
"      -D BUILD_TESTING=OFF            \\\n"
"      -D QCORO_BUILD_EXAMPLES=OFF     \\\n"
"      -D BUILD_SHARED_LIBS=ON         \\\n"
"       ..                             &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/qcoro.xml:96
#, xml-text
msgid ""
"To test this package, remove the 'BUILD_TESTING=OFF' parameter above and "
"run:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genlib/qcoro.xml:100
#, no-wrap, xml-text
msgid "<userinput>make test</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/qcoro.xml:103
#, xml-text
msgid "Now, as the &root; user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genlib/qcoro.xml:106
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr ""

