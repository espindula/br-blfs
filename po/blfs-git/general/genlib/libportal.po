#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/genlib/libportal.xml:116
#, xml-text
msgid "Installation of libportal"
msgstr ""

#. type: Content of: <sect1><sect2><warning><para>
#: blfs-en/blfs-git/general/genlib/libportal.xml:120
#, xml-text
msgid ""
"If a previous version of libportal is installed, move the headers out of the"
" way so that later packages do not encounter conflicts (as the <systemitem "
"role=\"username\">root</systemitem> user):"
msgstr ""

#. type: Content of: <sect1><sect2><warning><screen>
#: blfs-en/blfs-git/general/genlib/libportal.xml:125
#, no-wrap, xml-text
msgid ""
"<userinput>if [ -e /usr/include/libportal ]; then\n"
"    rm -rf /usr/include/libportal.old &amp;&amp;\n"
"    mv -vf /usr/include/libportal{,.old}\n"
"fi</userinput>"
msgstr ""

#.  BLFS Ticket #21429
#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/libportal.xml:132
#, xml-text
msgid "First, apply a patch to fix building against Qt 6.9 and later:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genlib/libportal.xml:136
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"pre\">patch -Np1 -i ../libportal-&libportal-"
"version;-qt6.9_fixes-1.patch</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/libportal.xml:139
#, xml-text
msgid ""
"Install <application>libportal</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genlib/libportal.xml:143
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr       \\\n"
"            --buildtype=release \\\n"
"            -D vapi=false       \\\n"
"            -D docs=false       \\\n"
"            .. &amp;&amp;\n"
"ninja</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/libportal.xml:154
#, xml-text
msgid ""
"If you have <xref linkend='gi-docgen'/> installed and wish to build the API "
"documentation for this package, issue:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genlib/libportal.xml:158
#, no-wrap, xml-text
msgid ""
"<userinput>sed -i \"/output/s/-1/-&libportal-version;/\" ../doc/meson.build &amp;&amp;\n"
"meson configure -D docs=true                     &amp;&amp;\n"
"ninja</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/libportal.xml:163
#, xml-text
msgid ""
"To test the results, issue: <command>ninja test</command>. Note that "
"additional <filename>dbus-daemon</filename> processes may need to be killed "
"after the tests are run."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/libportal.xml:169
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genlib/libportal.xml:172
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/genlib/libportal.xml:177
#, xml-text
msgid "Command Explanations"
msgstr ""

