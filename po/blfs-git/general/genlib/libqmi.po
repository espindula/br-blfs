#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/genlib/libqmi.xml:93
#, xml-text
msgid "Installation of libqmi"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/libqmi.xml:96
#, xml-text
msgid ""
"Install <application>libqmi</application> by running the following commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genlib/libqmi.xml:100
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup ..                 \\\n"
"      --prefix=/usr            \\\n"
"      --buildtype=release      \\\n"
"      -D bash_completion=false \\\n"
"      -D qrtr=false            \\\n"
"      -D man=false             &amp;&amp;\n"
"\n"
"ninja</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/libqmi.xml:113
#, xml-text
msgid "To test the results, issue: <command>ninja test</command>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/libqmi.xml:117
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genlib/libqmi.xml:120
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/genlib/libqmi.xml:126
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/libqmi.xml:132
#, xml-text
msgid ""
"<parameter>-D bash_completion=false</parameter>: Use this option if the "
"external <ulink url=\"https://github.com/scop/bash-completion\">bash-"
"completion</ulink> package is not installed."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/libqmi.xml:139
#, xml-text
msgid ""
"<parameter>-D man=false</parameter>: Use this option if the external <ulink "
"url=\"https://ftpmirror.gnu.org/gnu/help2man/\">help2man</ulink> package is "
"not installed."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/libqmi.xml:146
#, xml-text
msgid ""
"<parameter>-D qrtr=false</parameter>: This switch disables support for the "
"QRTR protocol which needs the external <ulink "
"url=\"https://gitlab.freedesktop.org/mobile-broadband/libqrtr-"
"glib\">libqrtr-glib</ulink> package."
msgstr ""

