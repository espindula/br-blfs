#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/genlib/qca.xml:107
#, xml-text
msgid "Installation of Qca"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/qca.xml:110
#, xml-text
msgid "Fix the location of the CA certificates:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genlib/qca.xml:113
#, no-wrap, xml-text
msgid ""
"<userinput>sed -i 's@cert.pem@certs/ca-bundle.crt@' "
"CMakeLists.txt</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/qca.xml:116
#, xml-text
msgid ""
"Install <application>Qca</application> by running the following commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genlib/qca.xml:120
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=$QT6DIR            \\\n"
"      -D CMAKE_BUILD_TYPE=Release                \\\n"
"      -D QT6=ON                                  \\\n"
"      -D QCA_INSTALL_IN_QT_PREFIX=ON             \\\n"
"      -D QCA_MAN_INSTALL_DIR:PATH=/usr/share/man \\\n"
"      .. &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/qca.xml:132
#, xml-text
msgid "To test the results, issue: <command>make test</command>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/qca.xml:136
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genlib/qca.xml:139
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/genlib/qca.xml:144
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/qca.xml:147
#, xml-text
msgid ""
"<parameter>-D CMAKE_BUILD_TYPE=Release</parameter>: This switch is used to "
"apply a higher level of compiler optimizations."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/qca.xml:152
#, xml-text
msgid ""
"<parameter>-D QT6=ON</parameter>: Ensure the packages is built with <xref "
"linkend=\"qt6\"/>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/qca.xml:157
#, xml-text
msgid ""
"<parameter>-D QCA_MAN_INSTALL_DIR:PATH=/usr/share/man</parameter>: Install "
"the qca man page in the normal location."
msgstr ""

