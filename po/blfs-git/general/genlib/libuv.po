#: blfs-en/blfs-git/general/genlib/libuv.xml:84
#, xml-text
msgid "Installation of libuv"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/libuv.xml:87
#, xml-text
msgid ""
"Install <application>libuv</application> by running the following commands:"
msgstr ""

#. type: Content of: <sect1><sect2><caution><para>
#: blfs-en/blfs-git/general/genlib/libuv.xml:93
#, xml-text
msgid ""
"The <command>sh autogen.sh</command> command below fails if the ACLOCAL "
"environment variable is set as specified in <xref linkend=\"xorg7\"/>.  If "
"it is used, ACLOCAL needs to be unset for this package and then reset for "
"other packages."
msgstr ""

#. Don't use cmake here to avoid circular dependency
#. <screen><userinput>sed -i "/TARGETS uv_a ARCHIVE/d" CMakeLists.txt
#. &amp;&amp;
#. mkdir build &amp;&amp;
#. cd    build &amp;&amp;
#. cmake -D CMAKE_INSTALL_PREFIX=/usr .. &amp;&amp;
#. make </userinput></screen>
#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genlib/libuv.xml:112
#, no-wrap, xml-text
msgid ""
"<userinput>sh autogen.sh                              &amp;&amp;\n"
"./configure --prefix=/usr --disable-static &amp;&amp;\n"
"make </userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/libuv.xml:117
#, xml-text
msgid ""
"If you installed the optional <xref linkend=\"sphinx\"/> python module, "
"create the man page:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genlib/libuv.xml:121
#, no-wrap, xml-text
msgid "<userinput>make man -C docs</userinput>"
msgstr ""

#.  the test suite refuses to run as root
#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/libuv.xml:124
#, xml-text
msgid ""
"If you want to run the tests, run: <command>make check</command> as a non-"
"root user."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/libuv.xml:129
#, xml-text
msgid "Now, as the &root; user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genlib/libuv.xml:132
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/libuv.xml:135
#, xml-text
msgid "If you built the man page, install it as the &root; user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genlib/libuv.xml:138
#, no-wrap, xml-text
msgid ""
"<userinput>install -Dm644 docs/build/man/libuv.1 "
"/usr/share/man/man1</userinput>"
msgstr ""

