#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/genlib/glibmm.xml:89
#, xml-text
msgid "Installation of GLibmm"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/glibmm.xml:92
#, xml-text
msgid ""
"Install <application>GLibmm</application> by running the following commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genlib/glibmm.xml:96
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir bld &amp;&amp;\n"
"cd    bld &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr --buildtype=release .. &amp;&amp;\n"
"ninja</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/glibmm.xml:103
#, xml-text
msgid "To test the results, issue: <command>ninja test</command>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/glibmm.xml:107
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genlib/glibmm.xml:110
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr ""

