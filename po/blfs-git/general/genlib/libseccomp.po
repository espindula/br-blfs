#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/genlib/libseccomp.xml:88
#, xml-text
msgid "Installation of libseccomp"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/libseccomp.xml:91
#, xml-text
msgid ""
"Install <application>libseccomp</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genlib/libseccomp.xml:95
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr --disable-static &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/libseccomp.xml:99
#, xml-text
msgid "To test the results, issue: <command>make check</command>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/libseccomp.xml:103
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genlib/libseccomp.xml:106
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/genlib/libseccomp.xml:110
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/libseccomp.xml:116
#, xml-text
msgid ""
"<option>--enable-python</option>: this switch is needed to build python "
"bindings if <xref linkend=\"cython\"/> is installed. The option "
"<option>--disable-static</option> must not be given if this option is used."
"  And you must run <command>sed 's/env python/&amp;3/' -i "
"tests/regression</command> if this option is used and you want to run the "
"test suite."
msgstr ""

