#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/genlib/exempi.xml:84
#, xml-text
msgid "Installation of Exempi"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/exempi.xml:87
#, xml-text
msgid ""
"If you intend to run the regression tests, first remove a test that depends "
"on a proprietary Adobe SDK:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genlib/exempi.xml:91
#, no-wrap, xml-text
msgid ""
"<userinput>sed -i -r '/^\\s?testadobesdk/d' exempi/Makefile.am &amp;&amp;\n"
"autoreconf -fiv</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/exempi.xml:96
#, xml-text
msgid ""
"Install <application>Exempi</application> by running the following commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genlib/exempi.xml:100
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr --disable-static &amp;&amp;\n"
"make</userinput>"
msgstr ""

#.       If valgrind is installed, mosts tests will indicate a failure, but
#.       that is a test problem and not a package problem.
#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/exempi.xml:104
#, xml-text
msgid "To test the results, issue: <command>make check</command>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/exempi.xml:110
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genlib/exempi.xml:113
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr ""

