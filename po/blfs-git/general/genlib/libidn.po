#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/genlib/libidn.xml:94
#, xml-text
msgid "Installation of libidn"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/libidn.xml:97
#, xml-text
msgid ""
"Install <application>libidn</application> by running the following commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genlib/libidn.xml:101
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr --disable-static &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/libidn.xml:105
#, xml-text
msgid "To test the results, run:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genlib/libidn.xml:108
#, no-wrap, xml-text
msgid ""
"<userinput>pushd tests  &amp;&amp;\n"
"  make check &amp;&amp;\n"
"popd </userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/libidn.xml:113
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genlib/libidn.xml:116
#, no-wrap, xml-text
msgid ""
"<userinput>make install &amp;&amp;\n"
"\n"
"find doc -name \"Makefile*\" -delete            &amp;&amp;\n"
"rm -rf -v doc/{gdoc,idn.1,stamp-vti,man,texi} &amp;&amp;\n"
"mkdir -v       /usr/share/doc/libidn-&libidn-version;     &amp;&amp;\n"
"cp -r -v doc/* /usr/share/doc/libidn-&libidn-version;</userinput>"
msgstr ""

