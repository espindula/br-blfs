#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/genlib/libblockdev.xml:107
#, xml-text
msgid "Installation of libblockdev"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/libblockdev.xml:116
#, xml-text
msgid ""
"Install <application>libblockdev</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genlib/libblockdev.xml:120
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr      \\\n"
"            --sysconfdir=/etc  \\\n"
"            --with-python3     \\\n"
"            --without-escrow   \\\n"
"            --without-gtk-doc  \\\n"
"            --without-lvm      \\\n"
"            --without-lvm_dbus \\\n"
"            --without-nvdimm   \\\n"
"            --without-tools    \\\n"
"            --without-smartmontools &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/libblockdev.xml:133
#, xml-text
msgid ""
"The test suite requires <application>targetcli</application>, which is not a"
" part of BLFS."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/libblockdev.xml:138
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genlib/libblockdev.xml:141
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/genlib/libblockdev.xml:146
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/libblockdev.xml:149
#, xml-text
msgid ""
"<parameter>--without-escrow</parameter>: This switch allows building "
"<application>libblockdev</application> without volume_key installed."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/libblockdev.xml:154
#, xml-text
msgid ""
"<parameter>--without-lvm</parameter> <parameter>--without-"
"lvm_dbus</parameter> <parameter>--without-tools</parameter>: The combination"
" of these switches allows building <application>libblockdev</application> "
"without <xref linkend=\"parted\"/> installed.  Remove it if you've installed"
" <xref linkend=\"parted\"/> and wish to build the <command>lvm-cache-"
"stats</command> or <command>vfat-resize</command> utilities, or wish "
"<application>libblockdev</application> to support logical volumes."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/libblockdev.xml:167
#, xml-text
msgid ""
"<parameter>--without-smartmontools</parameter>: This switch allows building "
"<application>libblockdev</application> without <xref linkend='json-glib'/> "
"or <xref linkend='smartmontools'/> installed.  Remove it if you have both "
"packages installed."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/libblockdev.xml:174
#, xml-text
msgid ""
"<option>--without-btrfs --without-mdraid --without-tools</option>: The "
"combination of these switches allows building "
"<application>libblockdev</application> without <xref "
"linkend=\"libbytesize\"/> installed.  The <option>--without-mdraid</option> "
"option will break <xref linkend=\"udisks2\"/>, so don't use it unless you "
"really know what you are doing."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/libblockdev.xml:184
#, xml-text
msgid ""
"<option>--without-crypto</option>: This switch allows building "
"<application>libblockdev</application> without <xref "
"linkend=\"cryptsetup\"/> or <xref linkend=\"keyutils\"/> installed.  This "
"switch will break <xref linkend=\"udisks2\"/>, so don't use it unless you "
"really know what you are doing."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/libblockdev.xml:192
#, xml-text
msgid ""
"<option>--without-dm --without-lvm --without-lvm_dbus --without-"
"mpath</option>: The combination of these switches allows building "
"<application>libblockdev</application> without <xref linkend=\"lvm2\"/> "
"installed.  The <option>--without-dm</option> and <option>--without-"
"mpath</option> options are not in the instructions provided by the book "
"because <xref linkend=\"lvm2\"/> is required for <xref "
"linkend=\"cryptsetup\"/> and <xref linkend=\"cryptsetup\"/> is a recommended"
" dependency of <application>libblockdev</application> anyway."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/libblockdev.xml:203
#, xml-text
msgid ""
"<option>--without-nvme</option>: This switch allows building "
"<application>libblockdev</application> without <xref linkend=\"libnvme\"/> "
"installed.  This switch will break <xref linkend=\"udisks2\"/>, so don't use"
" it unless you really know what you are doing."
msgstr ""

