#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/genlib/libxkbcommon.xml:100
#, xml-text
msgid "Installation of libxkbcommon"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/libxkbcommon.xml:103
#, xml-text
msgid ""
"Install <application>libxkbcommon</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genlib/libxkbcommon.xml:107
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup ..             \\\n"
"      --prefix=/usr        \\\n"
"      --buildtype=release  \\\n"
"      -D enable-docs=false &amp;&amp;\n"
"ninja</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/libxkbcommon.xml:117
#, xml-text
msgid ""
"To test the results, ensure <command>Xvfb</command> and <xref "
"linkend='xkeyboard-config'/> are available, then issue: <command>ninja "
"test</command>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/libxkbcommon.xml:123
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genlib/libxkbcommon.xml:126
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/genlib/libxkbcommon.xml:131
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/libxkbcommon.xml:137
#, xml-text
msgid ""
"<option>-D enable-docs=true</option>: This switch enables documentation "
"generation. <xref linkend=\"doxygen\"/> is required."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/libxkbcommon.xml:143
#, xml-text
msgid ""
"<command>mv -v /usr/share/doc/libxkbcommon{,-&libxkbcommon-"
"version;}</command>: If you built the documentation, use this command to "
"install it in a versioned directory."
msgstr ""

