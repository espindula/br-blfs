#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/genlib/libgusb.xml:96
#, xml-text
msgid "Installation of libgusb"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/libgusb.xml:99
#, xml-text
msgid ""
"Install <application>libgusb</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genlib/libgusb.xml:103
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup ..            \\\n"
"      --prefix=/usr       \\\n"
"      --buildtype=release \\\n"
"      -D docs=false       &amp;&amp;\n"
"ninja</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/libgusb.xml:113
#, xml-text
msgid ""
"If you have <xref linkend='gi-docgen'/> installed and wish to build the API "
"documentation for this package, issue:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genlib/libgusb.xml:117
#, no-wrap, xml-text
msgid ""
"<userinput>sed -E \"/output|install_dir/s/('libgusb)'/\\1-&libgusb-version;'/\" \\\n"
"    -i ../docs/meson.build                            &amp;&amp;\n"
"meson configure -D docs=true                          &amp;&amp;\n"
"ninja</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/libgusb.xml:123
#, xml-text
msgid ""
"To test the results, issue: <command>ninja test</command>. One of the tests "
"will output a warning about an API deprecation from Setuptools."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/libgusb.xml:128
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genlib/libgusb.xml:131
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr ""

