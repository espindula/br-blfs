#, xml-text
msgid "Installation of libatomic_ops"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/libatomic_ops.xml:79
#, xml-text
msgid ""
"Install <application>libatomic_ops</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genlib/libatomic_ops.xml:83
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr    \\\n"
"            --enable-shared  \\\n"
"            --disable-static \\\n"
"            --docdir=/usr/share/doc/libatomic_ops-&libatomic_ops-version; &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/libatomic_ops.xml:90
#, xml-text
msgid "To check the results, issue <command>make check</command>."
