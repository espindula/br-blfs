msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/liburcu.xml:78
#, xml-text
msgid ""
"Install <application>liburcu</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genlib/liburcu.xml:82
#, no-wrap, xml-text
