#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/genlib/duktape.xml:75
#, xml-text
msgid "Installation of duktape"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/duktape.xml:78
#, xml-text
msgid ""
"Install <application>duktape</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genlib/duktape.xml:82
#, no-wrap, xml-text
msgid ""
"<userinput>sed -i 's/-Os/-O2/' Makefile.sharedlibrary\n"
"make -f Makefile.sharedlibrary INSTALL_PREFIX=/usr</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/duktape.xml:86
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genlib/duktape.xml:89
#, no-wrap, xml-text
msgid ""
"<userinput>make -f Makefile.sharedlibrary INSTALL_PREFIX=/usr "
"install</userinput>"
msgstr ""

