#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/genlib/brotli.xml:90
#, xml-text
msgid "Installation of Brotli"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/brotli.xml:93
#, xml-text
msgid ""
"Install <application>brotli</application> by running the following commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genlib/brotli.xml:97
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr \\\n"
"      -D CMAKE_BUILD_TYPE=Release  \\\n"
"      -G Ninja .. &amp;&amp;\n"
"ninja</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/brotli.xml:106
#, xml-text
msgid "To test the results, issue: <command>ninja test</command>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/brotli.xml:110
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genlib/brotli.xml:113
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/brotli.xml:116
#, xml-text
msgid "If desired, build the <application>Python3</application> bindings:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genlib/brotli.xml:120
#, no-wrap, xml-text
msgid ""
"<userinput>cd .. &amp;&amp;\n"
"\n"
"sed -e '/libraries +=/s/=.*/= [required_system_library[3:]]/' \\\n"
"    -e '/package_configuration/d'                             \\\n"
"    -e '/pkgconfig/d'                                         \\\n"
"    -i setup.py                                               &amp;&amp;\n"
"\n"
"USE_SYSTEM_BROTLI=1 \\\n"
"&build-wheel-cmd; $PWD</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/brotli.xml:131
#, xml-text
msgid ""
"Install the <application>Python3</application> bindings as the &root; user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genlib/brotli.xml:135
#, no-wrap, xml-text
msgid "<userinput>&install-wheel; Brotli</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/brotli.xml:139
#, xml-text
msgid ""
"To test the <application>Python3</application> binding, issue: "
"<command>pytest</command>."
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/genlib/brotli.xml:145
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/brotli.xml:150
#, xml-text
msgid ""
"<command>sed ... -i setup.py</command>: Allow building the "
"<application>Python3</application> binding with "
"<envar>USE_SYSTEM_BROTLI=1</envar> but without the Python 3 pkgconfig module"
" (that BLFS does not provide) installed."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/brotli.xml:157
#, xml-text
msgid ""
"<envar>USE_SYSTEM_BROTLI=1</envar>: Stop <filename>setup.py</filename> from "
"rebuilding the entire package all over again, use the already installed "
"libraries for the <application>Python3</application> binding instead."
msgstr ""

