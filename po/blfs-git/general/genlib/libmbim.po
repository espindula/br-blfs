#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/genlib/libmbim.xml:87
#, xml-text
msgid "Installation of libmbim"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/libmbim.xml:90
#, xml-text
msgid ""
"Install <application>libmbim</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genlib/libmbim.xml:94
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup ..                 \\\n"
"      --prefix=/usr            \\\n"
"      --buildtype=release      \\\n"
"      -D bash_completion=false \\\n"
"      -D man=false             &amp;&amp;\n"
"\n"
"ninja</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/libmbim.xml:106
#, xml-text
msgid "To test the results, issue: <command>ninja test</command>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/libmbim.xml:110
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genlib/libmbim.xml:113
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr ""

