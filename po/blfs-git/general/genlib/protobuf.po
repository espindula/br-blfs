#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/protobuf.xml:81
#, xml-text
msgid ""
"Install <application>Protobuf</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genlib/protobuf.xml:85
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr      \\\n"
"      -D CMAKE_BUILD_TYPE=Release       \\\n"
"      -D CMAKE_SKIP_INSTALL_RPATH=ON    \\\n"
"      -D protobuf_BUILD_TESTS=OFF       \\\n"
"      -D protobuf_BUILD_SHARED_LIBS=ON  \\\n"
"      -G Ninja ..                       &amp;&amp;\n"
"ninja</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/protobuf.xml:97
#, xml-text
msgid ""
"This package does come with a test suite, but it requires <ulink "
"url=\"https://github.com/google/googletest\">gtest</ulink>, which is not "
"part of BLFS."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/protobuf.xml:103
#, xml-text
msgid "Now, as the &root; user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genlib/protobuf.xml:106
#, no-wrap, xml-text
