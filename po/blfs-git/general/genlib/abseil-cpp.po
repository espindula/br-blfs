#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/abseil-cpp.xml:75
#, xml-text
msgid ""
"Install <application>Abseil-cpp</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genlib/abseil-cpp.xml:79
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr   \\\n"
"      -D CMAKE_BUILD_TYPE=Release    \\\n"
"      -D CMAKE_SKIP_INSTALL_RPATH=ON \\\n"
"      -D ABSL_PROPAGATE_CXX_STD=ON   \\\n"
"      -D BUILD_SHARED_LIBS=ON        \\\n"
"      -G Ninja ..                    &amp;&amp;\n"
"ninja</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/abseil-cpp.xml:91
#, xml-text
msgid "This package does not come with a test suite."
