#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/genlib/gspell.xml:90
#, xml-text
msgid "Installation of gspell"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/gspell.xml:93
#, xml-text
msgid ""
"Install <application>gspell</application> by running the following commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genlib/gspell.xml:97
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir gspell-build &amp;&amp;\n"
"cd    gspell-build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr --buildtype=release -D gtk_doc=false .. &amp;&amp;\n"
"ninja</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/gspell.xml:104
#, xml-text
msgid ""
"To test the results, issue: <command>ninja test</command>.  The tests must "
"be run in an X session. One test, test-checker, is known to fail if the "
"external package <ulink url=\"https://hunspell.github.io/\">Hunspell</ulink>"
" is not installed."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/gspell.xml:112
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genlib/gspell.xml:115
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/genlib/gspell.xml:126
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/gspell.xml:129
#, xml-text
msgid ""
"<parameter>-D gtk_doc=false</parameter>: Prevents building the "
"documentation. Remove this if you have <application>GTK-Doc</application> "
"installed and wish to build the documentation."
msgstr ""

