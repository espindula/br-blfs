#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/genlib/clucene.xml:94
#, xml-text
msgid "Installation of CLucene"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/clucene.xml:97
#, xml-text
msgid ""
"Install <application>CLucene</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genlib/clucene.xml:101
#, no-wrap, xml-text
msgid ""
"<userinput>patch -Np1 -i ../clucene-&clucene-version;-contribs_lib-1.patch &amp;&amp;\n"
"\n"
"sed -i '/Misc.h/a #include &lt;ctime&gt;' src/core/CLucene/document/DateTools.cpp &amp;&amp;\n"
"\n"
"mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr        \\\n"
"      -D CMAKE_POLICY_VERSION_MINIMUM=3.5 \\\n"
"      -D BUILD_CONTRIBS_LIB=ON            \\\n"
"      -W no-dev ..                        &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/clucene.xml:115
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genlib/clucene.xml:118
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/genlib/clucene.xml:123
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/clucene.xml:129
#, xml-text
msgid ""
"<parameter>-D BUILD_CONTRIBS_LIB=ON</parameter>: This cmake variable enables"
" building the CLucene contribs library necessary for running applications "
"that use language specific text analyzers like LibreOffice for example."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/clucene.xml:136
#, xml-text
msgid ""
"<parameter>-W no-dev</parameter>: This parameter silences several warnings "
"only intended for project developers."
msgstr ""

