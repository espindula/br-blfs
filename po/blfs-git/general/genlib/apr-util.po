#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/genlib/apr-util.xml:97
#, xml-text
msgid "Installation of Apr Util"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/apr-util.xml:100
#, xml-text
msgid ""
"Install <application>Apr Util</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genlib/apr-util.xml:104
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr       \\\n"
"            --with-apr=/usr     \\\n"
"            --with-gdbm=/usr    \\\n"
"            --with-openssl=/usr \\\n"
"            --with-crypto &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/apr-util.xml:112
#, xml-text
msgid ""
"To test the results, issue: <command>make -j1 test</command>.  One test, "
"testdbm, is known to fail."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/apr-util.xml:117
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genlib/apr-util.xml:120
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/genlib/apr-util.xml:124
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/apr-util.xml:127
#, xml-text
msgid ""
"<parameter>--with-gdbm=/usr</parameter>: This switch enables the <filename "
"class=\"libraryfile\">apr_dbm_gdbm-1.so</filename> plugin."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/apr-util.xml:132
#, xml-text
msgid ""
"<parameter>--with-openssl=/usr</parameter> <parameter>--with-"
"crypto</parameter>: These switches enable the <filename "
"class=\"libraryfile\">apr_crypto_openssl-1.so</filename> plugin."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/apr-util.xml:140
#, xml-text
msgid ""
"<option>--with-berkeley-db=/usr</option>: If you have installed &berkeley-"
"db;, use this switch to compile the <filename "
"class=\"libraryfile\">apr_dbm_db-1.so</filename> plugin."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/apr-util.xml:146
#, xml-text
msgid ""
"<option>--with-ldap</option>: If you have installed <xref "
"linkend=\"openldap\"/>, use this switch to compile the <filename "
"class=\"libraryfile\">apr_ldap.so</filename> plugin."
msgstr ""

