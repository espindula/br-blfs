#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/libksba.xml:92
#, xml-text
msgid ""
"Install <application>Libksba</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genlib/libksba.xml:96
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/libksba.xml:111
#, xml-text
msgid "To test the results, issue: <command>make check</command>."
