msgid "Installation of libunwind"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/libunwind.xml:85
#, xml-text
msgid "First, fix a problem when building with gcc-15:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genlib/libunwind.xml:88
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"pre\">sed -i '/func.s/s/s//' tests/Gtest-"
"nomalloc.c</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/libunwind.xml:91
#, xml-text
msgid ""
"Install <application>libunwind</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genlib/libunwind.xml:95
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr --disable-static &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. Two
#.       tests, run-coredump-unwind and run-coredump-unwind-mdi are known
#.       to fail.
#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/libunwind.xml:99
#, xml-text
msgid "To test the results, issue: <command>make check</command>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/libunwind.xml:105
#, xml-text
