#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/genlib/libxslt.xml:112
#, xml-text
msgid "Installation of libxslt"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/libxslt.xml:115
#, xml-text
msgid ""
"Install <application>libxslt</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genlib/libxslt.xml:119
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr    \\\n"
"            --disable-static \\\n"
"            --docdir=/usr/share/doc/libxslt-&libxslt-version; &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/libxslt.xml:125
#, xml-text
msgid "To test the results, issue: <command>make check</command>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/libxslt.xml:129
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genlib/libxslt.xml:132
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/genlib/libxslt.xml:137
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/libxslt.xml:143
#, xml-text
msgid ""
"<option>--with-crypto</option>: Enable the non-standard and deprecated EXSLT"
" crypto extension feature.  It needs <xref linkend='libgcrypt'/> and the "
"upstream will remove it in the future."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/libxslt.xml:149
#, xml-text
msgid ""
"<option>--with-debug</option>: Enables thorough diagnostics with the "
"<option>-v, --verbose</option> of <command>xsltproc</command>.  Use it if "
"you plan to debug XSLT stylesheets."
msgstr ""

