#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/genlib/gsl.xml:80
#, xml-text
msgid "Installation of Gsl"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/gsl.xml:83
#, xml-text
msgid ""
"Install <application>Gsl</application> by running the following commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genlib/gsl.xml:86
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr --disable-static &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/gsl.xml:90
#, xml-text
msgid ""
"If you have <xref linkend=\"sphinx_rtd_theme\"/> installed, build the "
"documentation with:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genlib/gsl.xml:94
#, no-wrap, xml-text
msgid "<userinput>make html</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/gsl.xml:97
#, xml-text
msgid "To test the results, issue: <command>make check</command>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/gsl.xml:101
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genlib/gsl.xml:104
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/gsl.xml:107
#, xml-text
msgid ""
"If you built the documentation, install it (as <systemitem "
"class=\"username\">root</systemitem>) with:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genlib/gsl.xml:112
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir                   /usr/share/doc/gsl-&gsl-version; &amp;&amp;\n"
"cp -R doc/_build/html/* /usr/share/doc/gsl-&gsl-version;</userinput>"
msgstr ""

