#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/genlib/libproxy.xml:83
#, xml-text
msgid "Installation of libproxy"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/libproxy.xml:85
#, xml-text
msgid ""
"Install <application>libproxy</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genlib/libproxy.xml:88
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup ..        \\\n"
"      --prefix=/usr   \\\n"
"      -D release=true &amp;&amp;\n"
"\n"
"ninja</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/libproxy.xml:97
#, xml-text
msgid "To test the results, issue: <command>ninja test</command>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/libproxy.xml:99
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genlib/libproxy.xml:101
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/libproxy.xml:104
#, xml-text
msgid "Still as the &root; user, remove the useless static library:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genlib/libproxy.xml:107
#, no-wrap, xml-text
msgid "<userinput>rm /usr/lib/libproxy.a</userinput>"
msgstr ""

