#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/genlib/spirv-tools.xml:79
#, xml-text
msgid "Installation of SPIRV-Tools"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/spirv-tools.xml:82
#, xml-text
msgid ""
"Install <application>SPIRV-Tools</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genlib/spirv-tools.xml:86
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr     \\\n"
"      -D CMAKE_BUILD_TYPE=Release      \\\n"
"      -D SPIRV_WERROR=OFF              \\\n"
"      -D BUILD_SHARED_LIBS=ON          \\\n"
"      -D SPIRV_TOOLS_BUILD_STATIC=OFF  \\\n"
"      -D SPIRV-Headers_SOURCE_DIR=/usr \\\n"
"      -G Ninja .. &amp;&amp;\n"
"ninja</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/spirv-tools.xml:99
#, xml-text
msgid "To test the results, issue: <command>ninja test</command>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/spirv-tools.xml:103
#, xml-text
msgid "Now, as the &root; user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genlib/spirv-tools.xml:106
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/genlib/spirv-tools.xml:111
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/spirv-tools.xml:114
#, xml-text
msgid ""
"<parameter>-D SPIRV_WERROR=OFF</parameter>: This switch stops the build "
"system from treating warnings as errors."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/spirv-tools.xml:119
#, xml-text
msgid ""
"<parameter>-D BUILD_SHARED_LIBS=ON</parameter>: This switch forces the build"
" system to install shared libraries instead of static libraries."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/spirv-tools.xml:124
#, xml-text
msgid ""
"<parameter>-D SPIRV_TOOLS_BUILD_STATIC=OFF</parameter>: This switch disables"
" building static versions of the libraries."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/spirv-tools.xml:129
#, xml-text
msgid ""
"<parameter>-D SPIRV-Headers_SOURCE_DIR</parameter>: This switch tells the "
"build system that <xref linkend=\"spirv-headers\" role=\"nodep\"/> is "
"installed in /usr. This is needed since the build system tries to use a copy"
" at <filename class='directory'>external/spirv-headers</filename> in the "
"source directory by default and the copy is not shipped (i.e. you need to "
"manually extract <xref linkend=\"spirv-headers\" role=\"nodep\"/> there if "
"you want to build with the copy)."
msgstr ""

