#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/genlib/aspell.xml:98
#, xml-text
msgid "Installation of Aspell"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/aspell.xml:101
#, xml-text
msgid "First, fix a problem when building with gcc-15:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genlib/aspell.xml:104
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"pre\">sed -e 's/; i.*size)/, e = end(); i != e; ++i, ++size_)/' \\\n"
"    -i modules/speller/default/vector_hash-t.hpp</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/aspell.xml:108
#, xml-text
msgid ""
"Install <application>Aspell</application> by running the following commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genlib/aspell.xml:112
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/aspell.xml:116
#, xml-text
msgid "This package does not come with a test suite."
msgstr ""

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/blfs-git/general/genlib/aspell.xml:120
#: blfs-en/blfs-git/general/genlib/aspell.xml:178
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genlib/aspell.xml:123
#, no-wrap, xml-text
msgid ""
"<userinput>make install &amp;&amp;\n"
"ln -svfn aspell-0.60 /usr/lib/aspell &amp;&amp;\n"
"\n"
"install -v -m755 -d /usr/share/doc/aspell-&aspell-version;/aspell{,-dev}.html &amp;&amp;\n"
"\n"
"install -v -m644 manual/aspell.html/* \\\n"
"    /usr/share/doc/aspell-&aspell-version;/aspell.html &amp;&amp;\n"
"\n"
"install -v -m644 manual/aspell-dev.html/* \\\n"
"    /usr/share/doc/aspell-&aspell-version;/aspell-dev.html</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/aspell.xml:135
#, xml-text
msgid ""
"If you do not plan to install <application>Ispell</application>, then copy "
"the wrapper script <command>ispell</command>:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genlib/aspell.xml:139
#, no-wrap, xml-text
msgid "<userinput>install -v -m 755 scripts/ispell /usr/bin/</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/aspell.xml:142
#, xml-text
msgid ""
"If you do not plan to install <application>Spell</application>, then copy "
"the wrapper script <command>spell</command>:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genlib/aspell.xml:146
#, no-wrap, xml-text
msgid "<userinput>install -v -m 755 scripts/spell /usr/bin/</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/genlib/aspell.xml:150
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/aspell.xml:153
#, xml-text
msgid ""
"<command>ln -svfn aspell-0.60 /usr/lib/aspell</command>: This command is "
"useful for configuration of other applications, such as <xref "
"linkend=\"enchant\"/>."
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/genlib/aspell.xml:160
#, xml-text
msgid "Configuring Aspell"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><title>
#: blfs-en/blfs-git/general/genlib/aspell.xml:163
#, xml-text
msgid "Configuration Information"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/blfs-git/general/genlib/aspell.xml:166
#, xml-text
msgid ""
"After <application>Aspell</application> is installed, you must set up at "
"least one dictionary. Install the English dictionary by running the "
"following commands:"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><screen>
#: blfs-en/blfs-git/general/genlib/aspell.xml:171
#, no-wrap, xml-text
msgid ""
"<userinput>tar xf ../&aspell-en-dict;.tar.bz2 &amp;&amp;\n"
"cd &aspell-en-dict;                &amp;&amp;\n"
"\n"
"./configure &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><screen>
#: blfs-en/blfs-git/general/genlib/aspell.xml:181
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/blfs-git/general/genlib/aspell.xml:184
#, xml-text
msgid "Other dictionaries can be installed with the same instructions."
