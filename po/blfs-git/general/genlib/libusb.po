#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/genlib/libusb.xml:101
#, xml-text
msgid "Installation of libusb"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/libusb.xml:104
#, xml-text
msgid ""
"Install <application>libusb</application> by running the following commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genlib/libusb.xml:108
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr --disable-static &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/libusb.xml:112
#, xml-text
msgid ""
"If <application>Doxygen</application> is installed and you wish to build the"
" API documentation, issue the following commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genlib/libusb.xml:116
#, no-wrap, xml-text
msgid ""
"<userinput>pushd doc                &amp;&amp;\n"
"  doxygen -u doxygen.cfg &amp;&amp;\n"
"  make docs              &amp;&amp;\n"
"popd</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/libusb.xml:122
#, xml-text
msgid "This package does not come with a test suite."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/libusb.xml:126
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genlib/libusb.xml:129
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/libusb.xml:132
#, xml-text
msgid ""
"If you built the API documentation, install it using the following commands "
"as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genlib/libusb.xml:137
#, no-wrap, xml-text
msgid ""
"<userinput>install -v -d -m755 /usr/share/doc/libusb-&libusb-version;/apidocs &amp;&amp;\n"
"install -v -m644    doc/api-1.0/* \\\n"
"                    /usr/share/doc/libusb-&libusb-version;/apidocs</userinput>"
msgstr ""

