#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/genlib/libarchive.xml:91
#, xml-text
msgid "Installation of libarchive"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/libarchive.xml:94
#, xml-text
msgid ""
"Install <application>libarchive</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genlib/libarchive.xml:98
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr --disable-static &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/libarchive.xml:102
#, xml-text
msgid "To test the results, issue: <command>make check</command>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/libarchive.xml:106
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genlib/libarchive.xml:109
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/libarchive.xml:112
#, xml-text
msgid ""
"Still as the &root; user, create a symlink so we can use "
"<command>bsdunzip</command> as <command>unzip</command>, instead of relying "
"on the unmaintained Unzip package:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genlib/libarchive.xml:117
#, no-wrap, xml-text
msgid "<userinput>ln -sfv bsdunzip /usr/bin/unzip</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><note><para>
#: blfs-en/blfs-git/general/genlib/libarchive.xml:121
#, xml-text
msgid ""
"As discussed in <xref linkend='locale-wrong-filename-encoding'/>, if the Zip"
" archive to be extracted contains any file with a name containing any non-"
"Latin characters, you need to manually specify the encoding of those "
"characters or they will be turned into unreadable sequences in the extracted"
" file name.  For example, if a Zip archive created with WinZip, "
"<filename>archive.zip</filename>, contains a file named with Simplified "
"Chinese characters, the encoding should be CP936 and the <parameter>-I "
"cp936</parameter> option should be used.  I.e. the command to extract the "
"archive should be <command>unzip -I cp936 archive.zip</command>."
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/genlib/libarchive.xml:137
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/libarchive.xml:143
#, xml-text
msgid ""
"<option>--without-xml2</option>: This switch uses expat for xar archive "
"format support instead of libxml2 (which is preferred) if both packages are "
"installed."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/libarchive.xml:149
#, xml-text
msgid ""
"<option>--with-nettle</option>: This switch uses Nettle for crypto support "
"instead of OpenSSL."
msgstr ""

