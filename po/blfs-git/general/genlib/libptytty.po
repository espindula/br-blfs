#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/genlib/libptytty.xml:81
#, xml-text
msgid "Installation of libptytty"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/libptytty.xml:84
#, xml-text
msgid ""
"Install <application>libptytty</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genlib/libptytty.xml:88
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr     \\\n"
"      -D CMAKE_BUILD_TYPE=Release      \\\n"
"      -D PT_UTMP_FILE:STRING=/run/utmp \\\n"
"      .. &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/libptytty.xml:98
#, xml-text
msgid "This package does not come with a test suite."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/libptytty.xml:102
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genlib/libptytty.xml:105
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr ""

