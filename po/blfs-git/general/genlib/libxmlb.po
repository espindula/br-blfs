#: blfs-en/blfs-git/general/genlib/libxmlb.xml:89
#, xml-text
msgid "Installation of libxmlb"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/libxmlb.xml:92
#, xml-text
msgid ""
"Install <application>libxmlb</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genlib/libxmlb.xml:96
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr --buildtype=release -D gtkdoc=false .. &amp;&amp;\n"
"ninja</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/libxmlb.xml:103
#, xml-text
msgid "To test the results, issue: <command>ninja test</command>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/libxmlb.xml:107
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genlib/libxmlb.xml:110
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/genlib/libxmlb.xml:115
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/libxmlb.xml:124
#, xml-text
msgid ""
"<parameter>-D gtkdoc=false</parameter>: This switch disables building the "
"API documentation. Remove it if you have <xref linkend=\"gtk-doc\" "
"role=\"nodep\"/> installed and wish to build the API documentation."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/libxmlb.xml:131
#, xml-text
msgid ""
"<option>-D introspection=false</option>: Use this switch if you have not "
"built <xref linkend='glib2'/> with GObject Introspection."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/libxmlb.xml:136
#, xml-text
msgid ""
"<option>-D stemmer=true</option>: Use this switch if you have <ulink "
"url=\"https://github.com/zvelo/libstemmer\">libstemmer</ulink> installed and"
" wish to build stemmer support."
msgstr ""

