#. type: Content of: <sect1><sect2><note><para>
#: blfs-en/blfs-git/general/genlib/icu.xml:132
#, xml-text
msgid ""
"This package expands to the directory <filename "
"class='directory'>icu</filename>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/icu.xml:145
#, xml-text
msgid ""
"A part of a test cannot be run on <literal>i686</literal>. Avoid executing "
"it when building for that platform:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genlib/icu.xml:148
#, no-wrap, xml-text
msgid ""
"<userinput>case $(uname -m) in\n"
"  i?86) sed -e \"s/U_PLATFORM_IS_LINUX_BASED/__X86_64__ \\&amp;\\&amp; &amp;/\" \\\n"
"            -i source/test/intltest/ustrtest.cpp ;;\n"
"esac</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/icu.xml:154
#, xml-text
msgid ""
"Install <application>ICU</application> by running the following commands:"
msgstr ""

#.  Review comments at:
#. https://chromium.googlesource.com/chromium/src/+/e58fa0ba66272c5f28828b15d06c7e42a9882b3b
#. To see if the following prebuild command is appropriate for BLFS:
#. sed '/fdef U_CHARSET_I/i#define U_CHARSET_IS_UTF8 1' -i
#. common/unicode/platform.h
#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genlib/icu.xml:162
#, no-wrap, xml-text
msgid ""
"<userinput>cd source                 &amp;&amp;\n"
"./configure --prefix=/usr &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/icu.xml:167
#, xml-text
msgid ""
"To test the results, issue: <command>make check</command>. One test "
"(intltest) still fails for unknown reasons on <literal>i686</literal> "
"checking some thai conversions."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/icu.xml:173
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genlib/icu.xml:176
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr ""

