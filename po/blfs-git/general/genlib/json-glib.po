#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/genlib/json-glib.xml:87
#, xml-text
msgid "Installation of JSON GLib"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/json-glib.xml:90
#, xml-text
msgid ""
"Install <application>JSON GLib</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genlib/json-glib.xml:94
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr --buildtype=release .. &amp;&amp;\n"
"ninja</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/json-glib.xml:101
#, xml-text
msgid "If <xref linkend='docutils'/> is installed, build the man pages:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genlib/json-glib.xml:105
#, no-wrap, xml-text
msgid ""
"<userinput>meson configure -D man=true &amp;&amp;\n"
"ninja</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/json-glib.xml:110
#, xml-text
msgid ""
"If <xref linkend='gi-docgen'/> is installed, build the API documentation:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genlib/json-glib.xml:114
#, no-wrap, xml-text
msgid ""
"<userinput>sed \"/json_docdir =/s|$| / 'json-glib-&json-glib-version;'|\" -i ../doc/meson.build &amp;&amp;\n"
"meson configure -D documentation=enabled &amp;&amp;\n"
"ninja</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/json-glib.xml:119
#, xml-text
msgid ""
"To test the results, issue: <command>ninja test</command>.  One test, node, "
"is known to fail."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/json-glib.xml:124
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genlib/json-glib.xml:127
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/genlib/json-glib.xml:132
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/json-glib.xml:138
#, xml-text
msgid ""
"<option>-D gtk_doc=disabled</option>: Add this option if you have <xref "
"role=\"nodep\" linkend=\"gtk-doc\"/> installed and do not wish to generate "
"the API documentation."
msgstr ""

