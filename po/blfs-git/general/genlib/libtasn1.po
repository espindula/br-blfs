#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genlib/libtasn1.xml:93
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr --disable-static &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/libtasn1.xml:97
#, xml-text
msgid "To test the results, issue: <command>make check</command>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/libtasn1.xml:101
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genlib/libtasn1.xml:105
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/libtasn1.xml:108
#, xml-text
msgid ""
"If you did not pass the <option>--enable-gtk-doc</option> parameter to the "
"<command>configure</command> script, you can install the API documentation "
"using the following command as the <systemitem "
"class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genlib/libtasn1.xml:114
#, no-wrap, xml-text
msgid "<userinput>make -C doc/reference install-data-local</userinput>"
msgstr ""

