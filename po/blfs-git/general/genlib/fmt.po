#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/genlib/fmt.xml:86
#, xml-text
msgid "Installation of fmt"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/fmt.xml:89
#, xml-text
msgid ""
"Install <application>fmt</application> by running the following commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genlib/fmt.xml:93
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr     \\\n"
"      -D CMAKE_INSTALL_LIBDIR=/usr/lib \\\n"
"      -D BUILD_SHARED_LIBS=ON          \\\n"
"      -D FMT_TEST=OFF                  \\\n"
"      -G Ninja ..                      &amp;&amp;\n"
"ninja</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/fmt.xml:104
#, xml-text
msgid "To test the results, issue:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genlib/fmt.xml:107
#, no-wrap, xml-text
msgid ""
"<userinput remap='test'>cmake -D FMT_TEST=ON .. &amp;&amp;\n"
"ninja                   &amp;&amp;\n"
"ninja test</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/fmt.xml:112
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genlib/fmt.xml:115
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr ""

