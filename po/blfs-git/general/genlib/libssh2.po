"<userinput>./configure --prefix=/usr          \\\n"
"            --disable-docker-tests \\\n"
"            --disable-static       &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/libssh2.xml:125
#, xml-text
