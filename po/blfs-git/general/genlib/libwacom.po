#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/genlib/libwacom.xml:97
#, xml-text
msgid "Installation of libwacom"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/libwacom.xml:108
#, xml-text
msgid ""
"Install <application>libwacom</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genlib/libwacom.xml:112
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup ..            \\\n"
"      --prefix=/usr       \\\n"
"      --buildtype=release \\\n"
"      -D tests=disabled   &amp;&amp;\n"
"ninja</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/libwacom.xml:122
#, xml-text
msgid ""
"To test the results, issue: <command>ninja test</command>.  To run "
"additional tests, install <xref linkend=\"pytest\"/>, python-libevdev, and "
"pyudev, then remove the \"-D tests=disabled\" option from the meson line "
"above."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/libwacom.xml:131
#, xml-text
msgid ""
"If upgrading from a previous version of libwacom, remove the old device "
"database installation to prevent a potential duplicated match of devices in "
"case some old database files are not overwritten:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genlib/libwacom.xml:136
#, no-wrap, xml-text
msgid "<userinput>rm -rf /usr/share/libwacom</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/libwacom.xml:139
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genlib/libwacom.xml:142
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/genlib/libwacom.xml:147
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/libwacom.xml:153
