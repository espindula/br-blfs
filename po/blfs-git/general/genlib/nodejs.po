#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/nodejs.xml:113
#, xml-text
msgid "First, fix building this package with Python 3.14:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genlib/nodejs.xml:116
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"pre\">patch -Np1 -i ../node-v&nodejs-"
"version;-python_build_fix-1.patch</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/nodejs.xml:119
#, xml-text
msgid ""
"Build <application>Node.js</application> by running the following commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genlib/nodejs.xml:123
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr          \\\n"
"            --shared-brotli        \\\n"
"            --shared-cares         \\\n"
"            --shared-libuv         \\\n"
"            --shared-openssl       \\\n"
"            --shared-nghttp2       \\\n"
"            --shared-zlib          \\\n"
"            --with-intl=system-icu &amp;&amp;\n"
"make</userinput>"
msgstr ""

