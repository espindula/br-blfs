#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/genlib/nodejs.xml:180
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/nodejs.xml:183
#, xml-text
msgid ""
"<parameter>--with-intl=system-icu</parameter>: This parameter uses the "
"system version of <application>ICU</application>. Other values are "
"<option>full-icu</option> (to build a local, full "
"<application>icu</application> library) and <option>small-icu</option> (to "
"build a local, minimal <application>ICU</application> library)."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/nodejs.xml:191
#, xml-text
msgid ""
"<parameter>--shared-{brotli,cares,libuv,nghttp2,openssl,zlib}</parameter>: "
"This parameter uses the system installed libraries instead of local copies."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/nodejs.xml:197
#, xml-text
msgid ""
"<option>--without-npm</option>: This option tells the build system to not "
"build <application>npm</application> (use if you'd like to build a separate "
"<application>npm</application> later)."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/nodejs.xml:203
#, xml-text
msgid ""
"<option>--shared-http-parser</option>: This option uses the system installed"
" <application>http-parser</application> library instead of a local copy if "
"you have installed it."
msgstr ""

