#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/genlib/gmime3.xml:96
#, xml-text
msgid "Installation of GMime"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/gmime3.xml:99
#, xml-text
msgid ""
"Install <application>GMime</application> by running the following commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genlib/gmime3.xml:103
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr --disable-static &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/gmime3.xml:107
#, xml-text
msgid ""
"To test the results, issue: <command>make check</command>.  Two tests, test-"
"pgp and test-pgpmime, are known to fail."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/gmime3.xml:112
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genlib/gmime3.xml:115
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr ""

