#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/genlib/libdaemon.xml:81
#, xml-text
msgid "Installation of libdaemon"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/libdaemon.xml:84
#, xml-text
msgid ""
"Install <application>libdaemon</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genlib/libdaemon.xml:88
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr --disable-static &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/libdaemon.xml:92
#, xml-text
msgid ""
"If you have <application>Doxygen</application> installed and wish to build "
"the API documentation, issue the following command:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genlib/libdaemon.xml:96
#, no-wrap, xml-text
msgid "<userinput>make -C doc doxygen</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/libdaemon.xml:99
#, xml-text
msgid "This package does not come with a test suite."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/libdaemon.xml:103
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genlib/libdaemon.xml:106
#, no-wrap, xml-text
msgid ""
"<userinput>make docdir=/usr/share/doc/libdaemon-&libdaemon-version; "
"install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/libdaemon.xml:109
#, xml-text
msgid ""
"If you built the API documentation, install it using the following commands "
"as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#.  there is a link from README.html to reference/html, so install there
#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genlib/libdaemon.xml:115
#, no-wrap, xml-text
msgid ""
"<userinput>install -v -m755 -d /usr/share/doc/libdaemon-&libdaemon-version;/reference/html &amp;&amp;\n"
"install -v -m644 doc/reference/html/* /usr/share/doc/libdaemon-&libdaemon-version;/reference/html &amp;&amp;\n"
"install -v -m644 doc/reference/man/man3/* /usr/share/man/man3</userinput>"
msgstr ""

