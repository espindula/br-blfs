#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/genlib/popt.xml:80
#, xml-text
msgid "Installation of Popt"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/popt.xml:83
#, xml-text
msgid ""
"Install <application>popt</application> by running the following commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genlib/popt.xml:87
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr --disable-static &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/popt.xml:91
#, xml-text
msgid ""
"If you have <xref linkend=\"doxygen\"/> installed and wish to build the API "
"documentation, issue:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genlib/popt.xml:95
#, no-wrap, xml-text
msgid ""
"<userinput>sed -i 's@\\./@src/@' Doxyfile &amp;&amp;\n"
"doxygen</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/popt.xml:99
#, xml-text
msgid "To test the results, issue: <command>make check</command>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/popt.xml:103
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genlib/popt.xml:106
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/popt.xml:109
#, xml-text
msgid ""
"If you built the API documentation, install it using the following commands "
"issued by the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genlib/popt.xml:115
#, no-wrap, xml-text
msgid ""
"<userinput>install -v -m755 -d /usr/share/doc/popt-&popt-version; &amp;&amp;\n"
"install -v -m644 doxygen/html/* /usr/share/doc/popt-&popt-version;</userinput>"
msgstr ""

