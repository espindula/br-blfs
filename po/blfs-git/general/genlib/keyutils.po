#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/keyutils.xml:99
#, xml-text
msgid ""
"Install <application>keyutils</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genlib/keyutils.xml:103
#, no-wrap, xml-text
msgid "<userinput>make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/keyutils.xml:106
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genlib/keyutils.xml:109
#, no-wrap, xml-text
msgid ""
"<userinput>make NO_ARLIB=1 LIBDIR=/usr/lib BINDIR=/usr/bin SBINDIR=/usr/sbin"
" install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/keyutils.xml:112
#, xml-text
msgid ""
"The test suite can only run after installing this package.  To test the "
"results, issue, as the <systemitem class=\"username\">root</systemitem> "
"user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genlib/keyutils.xml:117
#, no-wrap, xml-text
msgid "<userinput>make -k test</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/keyutils.xml:120
#, xml-text
msgid ""
"If <xref linkend='lsb-tools'/> is not installed, the test suite will output "
"some lines complaining the <command>lsb_release</command> command not "
"available but it won't affect the test result."
msgstr ""

