#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/genlib/enchant.xml:103
#, xml-text
msgid "Installation of enchant"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/enchant.xml:106
#, xml-text
msgid ""
"Install <application>enchant</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genlib/enchant.xml:110
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr     \\\n"
"            --sysconfdir=/etc \\\n"
"            --disable-static  \\\n"
"            --docdir=/usr/share/doc/enchant-&enchant-version; &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/enchant.xml:117
#, xml-text
msgid ""
"To run tests, unittest-cpp must be installed and the <option>--enable-"
"relocatable</option> option passed to configure above.  If these conditions "
"are present, the tests may be run with <command>make check</command>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/enchant.xml:124
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genlib/enchant.xml:127
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
