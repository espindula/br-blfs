"<literal>Tel me more abot linux\n"
"Ther ar so many commads</literal>\n"
"EOF\n"
"\n"
"enchant-2 -d en_GB -l /tmp/test-enchant.txt &amp;&amp;\n"
"enchant-2 -d en_GB -a /tmp/test-enchant.txt</userinput>"
msgstr ""

