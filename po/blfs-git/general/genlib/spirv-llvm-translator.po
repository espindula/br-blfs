#: blfs-en/blfs-git/general/genlib/spirv-llvm-translator.xml:75
#, xml-text
msgid "Installation of SPIRV-LLVM-Translator"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/spirv-llvm-translator.xml:78
#, xml-text
msgid ""
"Install <application>SPIRV-LLVM-Translator</application> by running the "
"following commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genlib/spirv-llvm-translator.xml:82
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr                   \\\n"
"      -D CMAKE_BUILD_TYPE=Release                    \\\n"
"      -D BUILD_SHARED_LIBS=ON                        \\\n"
"      -D CMAKE_SKIP_INSTALL_RPATH=ON                 \\\n"
"      -D LLVM_EXTERNAL_SPIRV_HEADERS_SOURCE_DIR=/usr \\\n"
"      -G Ninja ..                                    &amp;&amp;\n"
"ninja</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/spirv-llvm-translator.xml:96
#, xml-text
msgid "This package does not come with a test suite."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/spirv-llvm-translator.xml:100
#, xml-text
msgid "Now, as the &root; user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genlib/spirv-llvm-translator.xml:103
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr ""

