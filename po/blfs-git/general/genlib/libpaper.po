#. type: Content of: <sect1><sect2><sect3><title>
#: blfs-en/blfs-git/general/genlib/libpaper.xml:121
#, xml-text
msgid "Configuration Information"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/blfs-git/general/genlib/libpaper.xml:124
#, xml-text
msgid ""
"The paper size is automatically determined from the system locale; see "
"<literal>LC_PAPER</literal> in <ulink role='man' "
"url='&man;locale.7'>locale(7)</ulink>.  If you want to override it, create a"
" <filename>papersize</filename> file in the user configuration directory.  "
"For example:"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><screen>
#: blfs-en/blfs-git/general/genlib/libpaper.xml:131
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir -pv ~/.config &amp;&amp;\n"
"echo \"a4\" &gt; ~/.config/papersize</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/blfs-git/general/genlib/libpaper.xml:135
#, xml-text
msgid ""
"If you want to override the paper size globally (for all users), set up the "
"<envar>PAPERSIZE</envar> environment variable.  For example:"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><screen>
#: blfs-en/blfs-git/general/genlib/libpaper.xml:140
#, no-wrap, xml-text
msgid ""
"<userinput>echo \"PAPERSIZE=a4\" &gt; /etc/profile.d/libpaper.sh</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/blfs-git/general/genlib/libpaper.xml:143
#, xml-text
msgid "You may use a different paper size, such as <literal>letter</literal>."
msgstr ""

