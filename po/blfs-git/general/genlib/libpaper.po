#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genlib/libpaper.xml:79
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr     \\\n"
"            --sysconfdir=/etc \\\n"
"            --disable-static  \\\n"
"            --docdir=/usr/share/doc/libpaper-&libpaper-version; &amp;&amp;\n"
"make</userinput>"
msgstr ""

