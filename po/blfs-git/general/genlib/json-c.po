#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/general/genlib/json-c.xml:87
#, xml-text
msgid "Installation of JSON-C"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/json-c.xml:99
#, xml-text
msgid "First, fix building this package with CMake-4.0:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genlib/json-c.xml:102
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"pre\">sed -i 's/VERSION 2.8/VERSION 4.0/' apps/CMakeLists.txt  &amp;&amp;\n"
"sed -i 's/VERSION 3.9/VERSION 4.0/' tests/CMakeLists.txt</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/json-c.xml:106
#, xml-text
msgid ""
"Install <application>JSON-C</application> by running the following commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genlib/json-c.xml:110
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr \\\n"
"      -D CMAKE_BUILD_TYPE=Release  \\\n"
"      -D BUILD_STATIC_LIBS=OFF     \\\n"
"      .. &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/json-c.xml:120
#, xml-text
msgid ""
"If you have installed <xref linkend=\"doxygen\" role=\"nodep\"/> and <xref "
"linkend=\"graphviz\" role=\"nodep\"/>, you can build the documentation by "
"running the following command:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genlib/json-c.xml:125
#, no-wrap, xml-text
msgid "<userinput>doxygen doc/Doxyfile</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/json-c.xml:128
#, xml-text
msgid "To test the results, issue: <command>make test</command>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/json-c.xml:132
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genlib/json-c.xml:135
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/general/genlib/json-c.xml:138
#, xml-text
msgid ""
"If you built the documentation, install it by running the following commands"
" as the &root; user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/general/genlib/json-c.xml:142
#, no-wrap, xml-text
msgid ""
"<userinput>install -d -vm755 /usr/share/doc/json-c-&json-c-version; &amp;&amp;\n"
"install -v -m644 doc/html/* /usr/share/doc/json-c-&json-c-version;</userinput>"
msgstr ""

