#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/postlfs/editors/emacs.xml:113
#, xml-text
msgid "Installation of Emacs"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/editors/emacs.xml:116
#, xml-text
msgid ""
"Install <application>Emacs</application> by running the following commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/postlfs/editors/emacs.xml:120
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/editors/emacs.xml:124
#, xml-text
msgid ""
"This package does not come with a test suite. If make succeeds, you can test"
" the result by running <command>src/emacs -Q</command>, which is the program"
" that will be installed, with its auxiliary files. This should start and "
"display the application opening screen."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/editors/emacs.xml:131
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/postlfs/editors/emacs.xml:134
#, no-wrap, xml-text
msgid ""
"<userinput>make install &amp;&amp;\n"
"chown -v -R root:root /usr/share/emacs/&emacs-version;</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/postlfs/editors/emacs.xml:137
#, no-wrap, xml-text
msgid ""
"<userinput>make install &amp;&amp;\n"
"chown -v -R root:root /usr/share/emacs/&emacs-version; &amp;&amp;\n"
"rm -vf /usr/lib/systemd/user/emacs.service</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/postlfs/editors/emacs.xml:147
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/editors/emacs.xml:158
#, xml-text
msgid ""
"<option>--with-imagemagick</option>: Use this if you have installed <xref "
"linkend=\"imagemagick\"/> and wish to link against it."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/editors/emacs.xml:163
#, xml-text
msgid ""
"<option>--with-gif=no</option>: Use this if you have not installed <xref "
"linkend=\"giflib\"/> or <ulink "
"url=\"https://directory.fsf.org/wiki/Libungif\">libungif</ulink>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/editors/emacs.xml:169
#, xml-text
msgid ""
"<option>--with-tiff=no</option>: Use this if you have not installed <xref "
"linkend=\"libtiff\"/>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/editors/emacs.xml:174
#, xml-text
msgid ""
"<option>--with-gnutls=no</option>: Use this if you have not installed <xref "
"linkend=\"gnutls\"/>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/editors/emacs.xml:179
#, xml-text
msgid ""
"<option>--without-harfbuzz</option>: Use this if you have not installed "
"<xref linkend=\"harfbuzz\"/>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/editors/emacs.xml:184
#, xml-text
msgid ""
"<option>--with-json=no</option>: Use this if you have not installed <xref "
"linkend=\"jansson\"/>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/editors/emacs.xml:189
#, xml-text
msgid ""
"<option>--with-kerberos5</option>: Use this option if you have installed "
"<xref linkend=\"mitkrb\"/> and need to use it for authentication in Emacs' "
"built-in email client."
msgstr ""

