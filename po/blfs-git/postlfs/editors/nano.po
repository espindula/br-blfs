#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/postlfs/editors/nano.xml:74
#, xml-text
msgid "Installation of Nano"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/editors/nano.xml:77
#, xml-text
msgid ""
"Install <application>Nano</application> by running the following commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/postlfs/editors/nano.xml:81
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr     \\\n"
"            --sysconfdir=/etc \\\n"
"            --enable-utf8     \\\n"
"            --docdir=/usr/share/doc/nano-&nano-version; &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/editors/nano.xml:88
#, xml-text
msgid "This package does not come with a test suite."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/editors/nano.xml:92
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/postlfs/editors/nano.xml:95
#, no-wrap, xml-text
msgid ""
"<userinput>make install &amp;&amp;\n"
"install -v -m644 doc/{nano.html,sample.nanorc} /usr/share/doc/nano-&nano-version;</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/postlfs/editors/nano.xml:101
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/editors/nano.xml:104
#, xml-text
msgid ""
"<parameter>--enable-utf8</parameter>: This switch enables unicode support in"
" <application>Nano</application>."
msgstr ""

