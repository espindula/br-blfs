#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/postlfs/editors/vim.xml:113
#, xml-text
msgid "Installation of Vim"
msgstr ""

#. type: Content of: <sect1><sect2><note><para>
#: blfs-en/blfs-git/postlfs/editors/vim.xml:117
#, xml-text
msgid ""
"If you recompile <application>Vim</application> to link against "
"<application>X</application> and your <application>X</application> libraries"
" are not on the root partition, you will no longer have vim for use in "
"emergencies. You may choose to install an additional editor, not link "
"<application>Vim</application> against <application>X</application>, or move"
" the current <command>vim</command> executable to the <filename "
"class=\"directory\">/bin</filename> directory under a different name such as"
" <filename>vi</filename>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/editors/vim.xml:129
#, xml-text
msgid ""
"Install <application>Vim</application> by running the following commands:"
msgstr ""

#. type: Content of: <sect1><sect2><note><para>
#: blfs-en/blfs-git/postlfs/editors/vim.xml:135
#, xml-text
msgid ""
"If you intend to run the tests and have not installed Xorg in /usr, append "
"LDFLAGS='-L$XORG_PREFIX/lib' to the configure line below."
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/postlfs/editors/vim.xml:140
#, no-wrap, xml-text
msgid ""
"<userinput>echo '#define SYS_VIMRC_FILE  \"/etc/vimrc\"' &gt;&gt;  src/feature.h &amp;&amp;\n"
"echo '#define SYS_GVIMRC_FILE \"/etc/gvimrc\"' &gt;&gt; src/feature.h &amp;&amp;\n"
"\n"
"./configure --prefix=/usr        \\\n"
"            --with-features=huge \\\n"
"            --enable-gui=gtk3    \\\n"
"            --with-tlib=ncursesw &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><note><para>
#: blfs-en/blfs-git/postlfs/editors/vim.xml:151
#, xml-text
msgid ""
"If the global configuration file <filename>/etc/vimrc</filename> references "
"the <envar>VIMRUNTIME</envar> environment variable, some tests may complain "
"about being unable to find the corresponding directory and wait for user "
"input. If this is the case, this file should be saved and removed before "
"running the tests.  Or if <xref linkend='bubblewrap'/> is installed, it's "
"also possible to create a lightweight container environment where this file "
"is hidden and run the tests in the container."
msgstr ""

#.  For vim-9.1.0927 the following flaky tests failed: test_remote.vim,
#.       test_startup.vim, test_termcodes.vim, test_xxd.vim
#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/editors/vim.xml:163
#, xml-text
msgid ""
"To test the results, issue: <command>make -j1 test</command>.  Test "
"failures, if any, will produce the file <filename>test.log</filename> in "
"<filename class=\"directory\">src/testdir</filename>. The remaining tests "
"will still be executed. If all goes well, the log will report <literal>ALL "
"DONE</literal>. Some tests labelled as <quote>flaky</quote> may fail "
"occasionally and can be ignored.  The tests are known to fail if the output "
"is redirected to a file, and also if they are run in a 'screen' session."
msgstr ""

#. type: Content of: <sect1><sect2><note><para>
#: blfs-en/blfs-git/postlfs/editors/vim.xml:178
#, xml-text
msgid ""
"If running the tests with <xref linkend='bubblewrap'/> and "
"<filename>/etc/vimrc</filename> hidden, use <command>bwrap --dev-bind / / "
"--dev-bind /dev/null /etc/vimrc make -j1 test</command>."
msgstr ""

#. type: Content of: <sect1><sect2><note><para>
#: blfs-en/blfs-git/postlfs/editors/vim.xml:186
#, xml-text
msgid ""
"Some color tests expect to be executed under the <command>xterm</command> "
"terminal emulator."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/editors/vim.xml:192
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/postlfs/editors/vim.xml:195
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/editors/vim.xml:198
#, xml-text
msgid ""
"By default, Vim's documentation is installed in <filename "
"class=\"directory\">/usr/share/vim</filename>. The following symlink allows "
"the documentation to be accessed via <filename "
"class=\"directory\">/usr/share/doc/vim-&vim-version;</filename>, making it "
"consistent with the location of documentation for other packages:"
msgstr ""

#.  When updating, be sure to change the vim-majmin entity for the
#.      proper 'vimxx' unpacked directory
#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/postlfs/editors/vim.xml:208
#, no-wrap, xml-text
msgid ""
"<userinput>ln -snfv ../vim/vim&vim-majmin;/doc /usr/share/doc/vim-&vim-"
"version;</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/editors/vim.xml:211
#, xml-text
msgid ""
"<emphasis role='bold'>If</emphasis> you wish to update the runtime files, "
"issue the following command (requires <xref linkend=\"rsync\"/>)  to "
"download it:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/postlfs/editors/vim.xml:216
#, no-wrap, xml-text
msgid ""
"<userinput>rsync -avzcP --exclude=\"/dos/\" --exclude=\"/spell/\" \\\n"
"    ftp.nluug.nl::Vim/runtime/ ./runtime/</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/editors/vim.xml:220
#, xml-text
msgid ""
"And then install the updated runtime files and regenerate the "
"<filename>tags</filename> file, as the <systemitem "
"class=\"username\">root</systemitem> user issue:"
msgstr ""

#.  already executed by "make install" if not updating the runtime
#.          files
#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/postlfs/editors/vim.xml:227
#, no-wrap, xml-text
msgid ""
"<userinput>make -C src installruntime &amp;&amp;\n"
"vim -c \":helptags /usr/share/doc/vim-&vim-version;\" -c \":q\"</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/postlfs/editors/vim.xml:233
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/editors/vim.xml:236
#, xml-text
msgid ""
"<parameter>--with-features=huge</parameter>: This switch enables all the "
"additional features available in <application>Vim</application>, including "
"support for multibyte characters."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/editors/vim.xml:242
#, xml-text
msgid ""
"<parameter>--with-tlib=ncursesw</parameter>: This switch forces Vim to link "
"against the <filename class=\"libraryfile\">libncursesw</filename> library."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/editors/vim.xml:248
#, xml-text
msgid ""
"<option>--enable-gui=no</option>: This will prevent compilation of the GUI. "
"<application>Vim</application> will still link against "
"<application>X</application>, so that some features such as the client-"
"server model or the x11-selection (clipboard) are still available."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/editors/vim.xml:255
#, xml-text
msgid ""
"<option>--without-x</option>: If you prefer not to link "
"<application>Vim</application> against <application>X</application>, use "
"this switch."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/editors/vim.xml:261
#, xml-text
msgid ""
"<option>--enable-luainterp</option>, <option>--enable-perlinterp</option>, "
"<option>--enable-python3interp=dynamic</option>, <option>--enable-tclinterp "
"--with-tclsh=tclsh</option>, <option>--enable-rubyinterp</option>: These "
"options include the Lua, Perl, Python3, Tcl, or Ruby interpreters that allow"
" using other application code in <application>vim</application> scripts. All"
" the <option>--enable-*</option> options can accept "
"<option>=dynamic</option> to dynamically load the interpreter when needed. "
"This is required for <application>Python 3</application> to prevent "
"segmentation faults. For <application>tcl</application>, it is necessary to "
"indicate the name of the <command>tclsh</command> executable, since "
"<command>configure</command> only searches versioned names with old "
"versions."
msgstr ""

