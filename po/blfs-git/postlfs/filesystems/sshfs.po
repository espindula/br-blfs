#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/postlfs/filesystems/sshfs.xml:90
#, xml-text
msgid "Installation of Sshfs"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/filesystems/sshfs.xml:93
#, xml-text
msgid ""
"Install <application>Sshfs</application> by running the following commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/postlfs/filesystems/sshfs.xml:97
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr --buildtype=release .. &amp;&amp;\n"
"ninja</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/filesystems/sshfs.xml:104
#, xml-text
msgid "This package does not come with a test suite."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/filesystems/sshfs.xml:108
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/postlfs/filesystems/sshfs.xml:111
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/postlfs/filesystems/sshfs.xml:115
#, xml-text
msgid "Using Sshfs"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/filesystems/sshfs.xml:118
#, xml-text
msgid ""
"To mount an ssh server you need to be able to log into the server. For "
"example, to mount your remote home folder to the local ~/examplepath (the "
"directory must exist and you must have permissions to write to it):"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/postlfs/filesystems/sshfs.xml:123
#, no-wrap, xml-text
msgid "<userinput>sshfs example.com:/home/userid ~/examplepath</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/filesystems/sshfs.xml:126
#, xml-text
msgid "When you've finished work and want to unmount it again:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/postlfs/filesystems/sshfs.xml:129
#, no-wrap, xml-text
msgid "<userinput>fusermount3 -u ~/example</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/filesystems/sshfs.xml:132
#, xml-text
msgid ""
"You can also mount an <application>sshfs</application> filesystem at boot by"
" adding an entry similar to the following in the "
"<filename>/etc/fstab</filename> file:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/postlfs/filesystems/sshfs.xml:137
#, no-wrap, xml-text
msgid ""
"<literal>userid@example.com:/path /media/path fuse.sshfs "
"_netdev,IdentityFile=/home/userid/.ssh/id_rsa 0 0</literal>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/filesystems/sshfs.xml:140
#, xml-text
msgid ""
"See <command>man 1 sshfs</command> and <command>man 8 mount.fuse3</command> "
"for all available mount options."
msgstr ""

