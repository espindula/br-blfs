#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/postlfs/filesystems/gptfdisk.xml:98
#, xml-text
msgid "Installation of gptfdisk"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/filesystems/gptfdisk.xml:101
#, xml-text
msgid ""
"The <application>gptfdisk</application> package comes with a rudimentary "
"<filename>Makefile</filename>.  First we update it to provide a simple build"
" and install interface and fix the location of a header file and fix some "
"minor location issues.  Install <application>gptfdisk</application> by "
"running the following commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/postlfs/filesystems/gptfdisk.xml:109
#, no-wrap, xml-text
msgid ""
"<userinput>patch -Np1 -i ../gptfdisk-&gptfdisk-version;-convenience-1.patch &amp;&amp;\n"
"sed -i 's|ncursesw/||' gptcurses.cc &amp;&amp;\n"
"sed -i 's|sbin|usr/sbin|' Makefile  &amp;&amp;\n"
"\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/filesystems/gptfdisk.xml:116
#, xml-text
msgid "To test the results, issue: <command>make test</command>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/filesystems/gptfdisk.xml:120
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/postlfs/filesystems/gptfdisk.xml:123
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr ""

