#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/postlfs/filesystems/lvm2.xml:100
#, xml-text
msgid "Kernel Configuration"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/filesystems/lvm2.xml:103
#, xml-text
msgid ""
"Enable the following options in the kernel configuration and recompile the "
"kernel:"
msgstr ""

#. type: Content of: <sect1><sect2><note><para>
#: blfs-en/blfs-git/postlfs/filesystems/lvm2.xml:109
#, xml-text
msgid ""
"There are several other Device Mapper options in the kernel beyond those "
"listed below.  In order to get reasonable results if running the regression "
"tests, all must be enabled either internally or as a module.  The tests will"
" all time out if Magic SysRq key is not enabled."
msgstr ""

#. type: Content of: <sect1><sect2><note><para>
#: blfs-en/blfs-git/postlfs/filesystems/lvm2.xml:116
#, xml-text
msgid ""
"In addition most of the optional packages for tests require kernel options "
"that are needed. If the optional packages or their kernel options are not "
"installed the tests will be flagged as either failed or skipped in an "
"inconsistent way."
msgstr ""

#. type: Content of: <sect1><sect2><indexterm><primary>
#: blfs-en/blfs-git/postlfs/filesystems/lvm2.xml:127
#, xml-text
msgid "lvm2"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/postlfs/filesystems/lvm2.xml:133
#, xml-text
msgid "Installation of LVM2"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/filesystems/lvm2.xml:136
#, xml-text
msgid ""
"Install <application>LVM2</application> by running the following commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/postlfs/filesystems/lvm2.xml:140
#, no-wrap, xml-text
msgid ""
"<userinput>PATH+=:/usr/sbin                \\\n"
"./configure --prefix=/usr       \\\n"
"            --enable-cmdlib     \\\n"
"            --enable-pkgconfig  \\\n"
"            --enable-udev_sync  &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/filesystems/lvm2.xml:148
#, xml-text
msgid ""
"The tests use <application>udev</application> for logical volume "
"synchronization, so the LVM udev rules and some utilities need to be "
"installed before running the tests. If you are installing "
"<application>LVM2</application> for the first time, and do not want to "
"install the full package before running the tests, the minimal set of "
"utilities can be installed by running the following instructions as the "
"<systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/postlfs/filesystems/lvm2.xml:158
#, no-wrap, xml-text
msgid ""
"<userinput>make -C tools install_tools_dynamic &amp;&amp;\n"
"make -C udev  install               &amp;&amp;\n"
"make -C libdm install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/filesystems/lvm2.xml:163
#, xml-text
msgid ""
"To test the results, issue, as the <systemitem "
"class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/postlfs/filesystems/lvm2.xml:168
#, no-wrap, xml-text
msgid "<userinput>LC_ALL=en_US.UTF-8 make check_local</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/filesystems/lvm2.xml:171
#, xml-text
msgid ""
"Some tests may hang. In this case they can be skipped by adding "
"<command>S=&lt;testname&gt;</command> to the <command>make</command> "
"command.  Other targets are available and can be listed with <command>make "
"-C test help</command>. The test timings are very dependent on the speed of "
"the disk(s), and on the number of enabled kernel options."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/filesystems/lvm2.xml:221
#, xml-text
msgid ""
"The tests do not implement the <quote>expected fail</quote> possibility and "
"some test failures are expected by upstream."
msgstr ""

#. type: Content of: <sect1><sect2><para><itemizedlist><listitem><para>
#: blfs-en/blfs-git/postlfs/filesystems/lvm2.xml:227
#, xml-text
msgid ""
"Most tests will fail if the kernel does not have all the device drivers "
"listed above."
msgstr ""

#. type: Content of: <sect1><sect2><para><itemizedlist><listitem><para>
#: blfs-en/blfs-git/postlfs/filesystems/lvm2.xml:233
#, xml-text
msgid ""
"More failures may happen because some kernel options are missing.  For "
"example, the lack of the <emphasis>dm-delay</emphasis> device mapper target "
"explains some failures."
msgstr ""

#. type: Content of: <sect1><sect2><para><itemizedlist><listitem><para>
#: blfs-en/blfs-git/postlfs/filesystems/lvm2.xml:240
#, xml-text
msgid ""
"Some tests may fail if there is insufficient free space available in the "
"partition with the /tmp directory.  At least one test fails if 16 TB is not "
"available."
msgstr ""

#. type: Content of: <sect1><sect2><para><itemizedlist><listitem><para>
#: blfs-en/blfs-git/postlfs/filesystems/lvm2.xml:247
#, xml-text
msgid ""
"Some tests are flagged <quote>warned</quote> if <ulink "
"url='https://github.com/jthornber/thin-provisioning-tools'> thin-"
"provisioning-tools</ulink> are not installed. A workaround is to add the "
"following flags to <command>configure</command>:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/postlfs/filesystems/lvm2.xml:256
#, no-wrap, xml-text
msgid ""
"<userinput>     --with-thin-check=    \\\n"
"     --with-thin-dump=     \\\n"
"     --with-thin-repair=   \\\n"
"     --with-thin-restore=  \\\n"
"     --with-cache-check=   \\\n"
"     --with-cache-dump=    \\\n"
"     --with-cache-repair=  \\\n"
"     --with-cache-restore= \\</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para><note>
#: blfs-en/blfs-git/postlfs/filesystems/lvm2.xml:266
#, xml-text
msgid ""
"Some tests may hang. They can be removed if necessary, for example: "
"<command>rm test/shell/lvconvert-raid-reshape.sh</command>. The tests "
"generate a lot of kernel messages, which may clutter your terminal. You can "
"disable them by issuing <command>dmesg -D</command> before running the tests"
" (do not forget to issue <command>dmesg -E</command> when tests are done).  "
"<note>"
msgstr ""

#. type: Content of: <sect1><sect2><para><note><simpara>
#: blfs-en/blfs-git/postlfs/filesystems/lvm2.xml:273
#, xml-text
msgid ""
"The checks create device nodes in the /tmp directory.  The tests will fail "
"if /tmp is mounted with the nodev option."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/filesystems/lvm2.xml:275
#, xml-text
msgid "</note>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/filesystems/lvm2.xml:279
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/postlfs/filesystems/lvm2.xml:282
#, no-wrap, xml-text
msgid ""
"<userinput>make install\n"
"rm -fv /usr/lib/udev/rules.d/69-dm-lvm.rules</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/postlfs/filesystems/lvm2.xml:285
#, no-wrap, xml-text
msgid ""
"<userinput>make install\n"
"make install_systemd_units</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/postlfs/filesystems/lvm2.xml:291
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/filesystems/lvm2.xml:294
#, xml-text
msgid ""
"<command>PATH+=:/usr/sbin</command>: The path must contain <filename "
"class='directory'>/usr/sbin</filename> for proper system tool detection by "
"the <command>configure</command> script. This instruction ensures that PATH "
"is properly set even if you build as an unprivileged user."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/filesystems/lvm2.xml:302
#, xml-text
msgid ""
"<parameter>--enable-cmdlib</parameter>: This switch enables building of the "
"shared command library. It is required when building the event daemon."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/filesystems/lvm2.xml:308
#, xml-text
msgid ""
"<parameter>--enable-pkgconfig</parameter>: This switch enables installation "
"of <command>pkg-config</command> support files."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/filesystems/lvm2.xml:313
#, xml-text
msgid ""
"<parameter>--enable-udev_sync</parameter>: This switch enables "
"synchronisation with <application>Udev</application> processing."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/filesystems/lvm2.xml:318
#, xml-text
msgid ""
"<option>--enable-dmeventd</option>: This switch enables building of the "
"<application>Device Mapper</application> event daemon."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/filesystems/lvm2.xml:324
#, xml-text
msgid ""
"<command>rm .../69-dm-lvm.rules</command>: Under certain circumstances, this"
" udev rule calls <command>systemd-run</command>, which is not available on "
"sysv. It performs actions that are done by another boot script anyway, so it"
" is not needed."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/filesystems/lvm2.xml:331
#, xml-text
msgid ""
"<command>make install_systemd_units</command>: This is needed to install a "
"unit that activates logical volumes at boot. It is not installed by default."
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/postlfs/filesystems/lvm2.xml:339
#, xml-text
msgid "Configuring LVM2"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><title>
#: blfs-en/blfs-git/postlfs/filesystems/lvm2.xml:342
#, xml-text
msgid "Config File"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/blfs-git/postlfs/filesystems/lvm2.xml:344
#, xml-text
msgid "<filename>/etc/lvm/lvm.conf</filename>"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><indexterm><primary>
#: blfs-en/blfs-git/postlfs/filesystems/lvm2.xml:349
#, xml-text
msgid "/etc/lvm/lvm.conf"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><title>
#: blfs-en/blfs-git/postlfs/filesystems/lvm2.xml:353
#, xml-text
msgid "Configuration Information"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/blfs-git/postlfs/filesystems/lvm2.xml:355
#, xml-text
msgid ""
"The default configuration still references the obsolete <filename "
"class=\"directory\">/var/lock</filename> directory. This creates a deadlock "
"at boot time. Change this (as the <systemitem "
"class=\"username\">root</systemitem> user):"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><screen>
#: blfs-en/blfs-git/postlfs/filesystems/lvm2.xml:361
#, no-wrap, xml-text
msgid ""
"<userinput>sed -e '/locking_dir =/{s/#//;s/var/run/}' \\\n"
"    -i /etc/lvm/lvm.conf</userinput>"
msgstr ""

