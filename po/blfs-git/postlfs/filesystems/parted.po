#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/postlfs/filesystems/parted.xml:112
#, xml-text
msgid "Installation of parted"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/filesystems/parted.xml:115
#, xml-text
msgid "First, make the package compatible with gcc-15:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/postlfs/filesystems/parted.xml:118
#, no-wrap, xml-text
msgid ""
"<userinput>sed -i 's/do_version ()/do_version (PedDevice** dev, PedDisk** "
"diskp)/' parted/parted.c</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/filesystems/parted.xml:121
#, xml-text
msgid ""
"Install <application>Parted</application> by running the following commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/postlfs/filesystems/parted.xml:125
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr --disable-static &amp;&amp;\n"
"make &amp;&amp;\n"
"\n"
"make -C doc html                                       &amp;&amp;\n"
"makeinfo --html      -o doc/html       doc/parted.texi &amp;&amp;\n"
"makeinfo --plaintext -o doc/parted.txt doc/parted.texi</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/filesystems/parted.xml:133
#, xml-text
msgid ""
"If you have <xref linkend=\"texlive\"/> installed and wish to create PDF and"
" Postscript documentation issue the following commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/postlfs/filesystems/parted.xml:137
#, no-wrap, xml-text
msgid ""
"<userinput>cp build-aux/texinfo.tex doc               &amp;&amp;\n"
"texi2pdf -o doc/parted.pdf doc/parted.texi &amp;&amp;\n"
"texi2dvi -o doc/parted.dvi doc/parted.texi &amp;&amp;\n"
"dvips    -o doc/parted.ps  doc/parted.dvi</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/filesystems/parted.xml:143
#, xml-text
msgid ""
"To test the results, issue, as the <systemitem "
"class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/postlfs/filesystems/parted.xml:148
#, no-wrap, xml-text
msgid "<userinput>make check</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><note><para>
#: blfs-en/blfs-git/postlfs/filesystems/parted.xml:162
#, xml-text
msgid ""
"Many tests are skipped if not run as the <systemitem "
"class=\"username\">root</systemitem> user."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/filesystems/parted.xml:168
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/postlfs/filesystems/parted.xml:171
#, no-wrap, xml-text
msgid ""
"<userinput>make install &amp;&amp;\n"
"install -v -m755 -d /usr/share/doc/parted-&parted-version;/html &amp;&amp;\n"
"install -v -m644    doc/html/* \\\n"
"                    /usr/share/doc/parted-&parted-version;/html &amp;&amp;\n"
"install -v -m644    doc/{FAT,API,parted.{txt,html}} \\\n"
"                    /usr/share/doc/parted-&parted-version;</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/filesystems/parted.xml:179
#, xml-text
msgid ""
"Install the optional PDF and Postscript documentation by issuing the "
"following command as the <systemitem class=\"username\">root</systemitem> "
"user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/postlfs/filesystems/parted.xml:185
#, no-wrap, xml-text
msgid ""
"<userinput>install -v -m644 doc/FAT doc/API doc/parted.{pdf,ps,dvi} \\\n"
"                    /usr/share/doc/parted-&parted-version;</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
