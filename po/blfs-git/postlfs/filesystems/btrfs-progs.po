#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/postlfs/filesystems/btrfs-progs.xml:117
#, xml-text
msgid "Installation of btrfs-progs"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/filesystems/btrfs-progs.xml:120
#, xml-text
msgid ""
"Install <application>btrfs-progs</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/postlfs/filesystems/btrfs-progs.xml:124
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr           \\\n"
"            --disable-static        \\\n"
"            --disable-documentation &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/filesystems/btrfs-progs.xml:130
#, xml-text
msgid "Before running tests, build a support program:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/postlfs/filesystems/btrfs-progs.xml:133
#, no-wrap, xml-text
msgid "<userinput>make fssum</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/filesystems/btrfs-progs.xml:136
#, xml-text
msgid "Now remove one test known to fail. As &root;:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/postlfs/filesystems/btrfs-progs.xml:139
#, no-wrap, xml-text
msgid "<userinput>rm -rf tests/fuzz-tests/010-simple-sb</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/filesystems/btrfs-progs.xml:142
#, xml-text
msgid "To test the results, issue (as the &root; user):"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/postlfs/filesystems/btrfs-progs.xml:145
#, no-wrap, xml-text
msgid ""
"<userinput>pushd tests\n"
"   ./fsck-tests.sh\n"
"   ./mkfs-tests.sh\n"
"   ./cli-tests.sh\n"
"   ./convert-tests.sh\n"
"   ./misc-tests.sh\n"
"   ./fuzz-tests.sh\n"
"popd</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><note><para>
#: blfs-en/blfs-git/postlfs/filesystems/btrfs-progs.xml:169
#, xml-text
msgid ""
"If the above mentioned kernel options are not enabled, some tests fail, and "
"prevent all the remaining tests from running because the test disk image is "
"not cleanly unmounted. Also make sure that the btrfs kernel module is "
"loaded."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/filesystems/btrfs-progs.xml:181
#, xml-text
msgid "Install the package as the &root; user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/postlfs/filesystems/btrfs-progs.xml:184
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/filesystems/btrfs-progs.xml:187
#, xml-text
msgid ""
"If you have passed <parameter>--disable-documentation</parameter> to "
"<command>configure</command> and you need the manual pages, install them by "
"running, as the &root; user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/postlfs/filesystems/btrfs-progs.xml:192
#, no-wrap, xml-text
msgid ""
"<userinput>for i in 5 8; do\n"
"   install Documentation/*.$i /usr/share/man/man$i\n"
"done</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/postlfs/filesystems/btrfs-progs.xml:199
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/filesystems/btrfs-progs.xml:205
#, xml-text
msgid ""
"<parameter>--disable-documentation</parameter>: This switch disables "
"rebuilding the manual pages, because it requires <xref linkend=\"sphinx\"/>."
msgstr ""

