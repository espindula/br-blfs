#, xml-text
msgid "Installation of dosfstools"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/filesystems/dosfstools.xml:106
#, xml-text
msgid ""
"Install <application>dosfstools</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/postlfs/filesystems/dosfstools.xml:110
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr            \\\n"
"            --enable-compat-symlinks \\\n"
"            --mandir=/usr/share/man  \\\n"
"            --docdir=/usr/share/doc/dosfstools-&dosfstools-version; &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/filesystems/dosfstools.xml:117
#, xml-text
msgid "To test the results, issue: <command>make check</command>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/filesystems/dosfstools.xml:121
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/postlfs/filesystems/dosfstools.xml:124
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr ""

