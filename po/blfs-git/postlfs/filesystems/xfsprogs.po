"     INSTALL_USER=root  \\\n"
"     INSTALL_GROUP=root \\\n"
"     LOCAL_CONFIGURE_OPTIONS=\"--localstatedir=/var\"</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/filesystems/xfsprogs.xml:114
