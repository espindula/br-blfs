#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/filesystems/xfsprogs.xml:132
#, xml-text
msgid ""
"<parameter>sed ... static long filesize...</parameter>: That sed fixes an "
"issue which appears when building on 32 bit systems, only. There is a "
"mismatch in prototype and function header which results in error on that "
"architecture."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/filesystems/xfsprogs.xml:139
#, xml-text
msgid "<parameter>DEBUG=-DNDEBUG</parameter>: Turns off debugging symbols."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/filesystems/xfsprogs.xml:144
#, xml-text
msgid ""
"<parameter>INSTALL_USER=root</parameter> "
"<parameter>INSTALL_GROUP=root</parameter>: This sets the owner and group of "
"the installed files."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/filesystems/xfsprogs.xml:150
#, xml-text
msgid ""
"<parameter>LOCAL_CONFIGURE_OPTIONS=\"--localstatedir=/var\"</parameter>: "
"This sets the state directory to /var, preventing /usr/var from being "
"created."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/filesystems/xfsprogs.xml:156
#, xml-text
msgid ""
"<option>OPTIMIZER=\"...\"</option>: Adding this parameter to the end of the "
"<command>make</command> command overrides the default optimization settings."
msgstr ""

