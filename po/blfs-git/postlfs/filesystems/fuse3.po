#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/postlfs/filesystems/fuse3.xml:108
#, xml-text
msgid "Installation of Fuse"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/filesystems/fuse3.xml:111
#, xml-text
msgid ""
"Install <application>Fuse</application> by running the following commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/postlfs/filesystems/fuse3.xml:115
#, no-wrap, xml-text
msgid ""
"<userinput>sed -i '/^udev/,$ s/^/#/' util/meson.build &amp;&amp;\n"
"\n"
"mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr --buildtype=release .. &amp;&amp;\n"
"ninja</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/filesystems/fuse3.xml:124
#, xml-text
msgid ""
"The API documentation is included in the package, but if you have <xref "
"linkend=\"doxygen\"/> installed and wish to rebuild it, issue:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/postlfs/filesystems/fuse3.xml:129
#, no-wrap, xml-text
msgid ""
"<userinput>pushd .. &amp;&amp;\n"
"  doxygen doc/Doxyfile &amp;&amp;\n"
"popd</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/filesystems/fuse3.xml:134
#, xml-text
msgid ""
"To test the results, issue the following commands (as the <systemitem "
"role=\"username\">root</systemitem> user):"
msgstr ""

#.  EDITORS NOTE:
#.          Don't use 'pytest' instead of 'python3 -m pytest'.  There is no
#.          testenv/bin/pytest (as at pytest-7.4.0) so 'pytest' resolves to
#.          /usr/bin/pytest, and the shebang of it is /usr/bin/python3.11.
#.          So it won't find the looseversion installed in testenv.
#.          To view the results of the tests, look for
#.          "short test summary info" at the end of your log. Below skipped
#. tests,
#.          you will see "X passed, X skipped, X failed (if any) in X seconds"
#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/postlfs/filesystems/fuse3.xml:149
#, no-wrap, xml-text
msgid ""
"<userinput>python3 -m venv --system-site-packages testenv &amp;&amp;\n"
"source testenv/bin/activate                    &amp;&amp;\n"
"pip3 install looseversion                      &amp;&amp;\n"
"python3 -m pytest\n"
"deactivate</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/filesystems/fuse3.xml:156
#, xml-text
msgid ""
"The <xref linkend=\"pytest\"/> Python module is required for the tests. One "
"test named <filename>test_cuse</filename> will fail if the "
"<parameter>CONFIG_CUSE</parameter> configuration item was not enabled when "
"the kernel was built. One test, <filename>test/util.py</filename>, will "
"output a warning due to the usage of an unknown mark in pytest."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/filesystems/fuse3.xml:166
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/postlfs/filesystems/fuse3.xml:169
#, no-wrap, xml-text
msgid ""
"<userinput>ninja install                  &amp;&amp;\n"
"chmod u+s /usr/bin/fusermount3 &amp;&amp;\n"
"\n"
"cd ..                          &amp;&amp;\n"
"cp -Rv doc/html -T /usr/share/doc/fuse-&fuse3-version; &amp;&amp;\n"
"install -v -m644   doc/{README.NFS,kernel.txt} \\\n"
"                   /usr/share/doc/fuse-&fuse3-version;</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/postlfs/filesystems/fuse3.xml:180
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/filesystems/fuse3.xml:183
#, xml-text
msgid ""
"<command>sed ... util/meson.build</command>: This command disables the "
"installation of a boot script and udev rule that are not needed."
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/postlfs/filesystems/fuse3.xml:196
#, xml-text
msgid "Configuring fuse"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><title>
#: blfs-en/blfs-git/postlfs/filesystems/fuse3.xml:199
#, xml-text
msgid "Config Files"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/blfs-git/postlfs/filesystems/fuse3.xml:202
#, xml-text
msgid ""
"Some options regarding mount policy can be set in the file "
"<filename>/etc/fuse.conf</filename>. To install the file run the following "
"command as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><screen>
#: blfs-en/blfs-git/postlfs/filesystems/fuse3.xml:208
#, no-wrap, xml-text
msgid ""
"<userinput>cat &gt; /etc/fuse.conf &lt;&lt; \"EOF\"\n"
"<literal># Set the maximum number of FUSE mounts allowed to non-root users.\n"
"# The default is 1000.\n"
"#\n"
"#mount_max = 1000\n"
"\n"
"# Allow non-root users to specify the 'allow_other' or 'allow_root'\n"
"# mount options.\n"
"#\n"
"#user_allow_other</literal>\n"
"EOF</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/blfs-git/postlfs/filesystems/fuse3.xml:221
#, xml-text
msgid ""
"Additional information about the meaning of the configuration options are "
"found in the man page."
msgstr ""

