#: blfs-en/blfs-git/postlfs/filesystems/ntfs-3g.xml:112
#, xml-text
msgid ""
"Enable the following options in the kernel configuration and recompile the "
"kernel if necessary:"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/filesystems/ntfs-3g.xml:120
#, xml-text
msgid ""
"Note that it is only needed for mounting NTFS partitions with ntfs-3g.  If "
"you will use the in-kernel NTFS3 driver for mounting NTFS partitions (as the"
" BLFS editors recommend) instead, you can skip this configuration item."
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/postlfs/filesystems/ntfs-3g.xml:132
#, xml-text
msgid "Installation of Ntfs-3g"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/filesystems/ntfs-3g.xml:135
#, xml-text
msgid ""
"Install <application>Ntfs-3g</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/postlfs/filesystems/ntfs-3g.xml:139
#, no-wrap, xml-text
msgid ""
"<userinput>./autogen.sh &amp;&amp;\n"
"\n"
"./configure --prefix=/usr        \\\n"
"            --disable-static     \\\n"
"            --with-fuse=internal \\\n"
"            --docdir=/usr/share/doc/ntfs-3g-&ntfs-3g-version; &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/filesystems/ntfs-3g.xml:148
#, xml-text
msgid "This package does not come with a test suite."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/filesystems/ntfs-3g.xml:152
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/postlfs/filesystems/ntfs-3g.xml:155
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/filesystems/ntfs-3g.xml:158
#, xml-text
msgid ""
"It's recommended to use the in-kernel NTFS3 driver for mounting NTFS "
"filesystems, instead of ntfs-3g (see the note at the start of this page).  "
"However, if you want to use ntfs-3g to mount the NTFS filesystems anyway, "
"create a symlink for the <command>mount</command> command:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/postlfs/filesystems/ntfs-3g.xml:165
#, no-wrap, xml-text
msgid ""
"<userinput>ln -svf ../bin/ntfs-3g /usr/sbin/mount.ntfs &amp;&amp;\n"
"ln -svf ntfs-3g.8 /usr/share/man/man8/mount.ntfs.8</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/postlfs/filesystems/ntfs-3g.xml:171
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/filesystems/ntfs-3g.xml:177
#, xml-text
msgid ""
"<parameter>--with-fuse=internal</parameter>: This switch dynamically forces "
"<application>ntfs-3g</application> to use an internal copy of the "
"<application>fuse-2.x</application> library. This is required if you wish to"
" allow users to mount NTFS partitions."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/filesystems/ntfs-3g.xml:184
#, xml-text
msgid ""
"<option>--disable-ntfsprogs</option>: Disables installation of various "
"utilities used to manipulate NTFS partitions."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/filesystems/ntfs-3g.xml:189
#, xml-text
msgid ""
"<command>chmod -v 4755 /usr/bin/ntfs-3g</command>: Making mount.ntfs setuid "
"root allows non root users to mount NTFS partitions."
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/postlfs/filesystems/ntfs-3g.xml:196
#, xml-text
msgid "Using Ntfs-3g"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/filesystems/ntfs-3g.xml:199
#, xml-text
msgid ""
"To mount a Windows partition at boot time, put a line like this in "
"/etc/fstab:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/postlfs/filesystems/ntfs-3g.xml:203
#, no-wrap, xml-text
msgid "/dev/sda1 /mnt/windows auto defaults 0 0"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/filesystems/ntfs-3g.xml:206
#, xml-text
msgid ""
"To allow users to mount a usb stick with an NTFS filesystem on it, put a "
"line similar to this (change sdc1 to whatever a usb stick would be on your "
"system) in /etc/fstab:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/postlfs/filesystems/ntfs-3g.xml:211
#, no-wrap, xml-text
msgid "/dev/sdc1 /mnt/usb auto user,noauto,umask=0,utf8 0 0"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/filesystems/ntfs-3g.xml:214
#, xml-text
msgid ""
"In order for a user to be able to mount the usb stick, they will need to be "
"able to write to <filename class=\"directory\">/mnt/usb</filename>, so as "
"the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/postlfs/filesystems/ntfs-3g.xml:219
#, no-wrap, xml-text
msgid "<userinput>chmod -v 777 /mnt/usb</userinput>"
msgstr ""

