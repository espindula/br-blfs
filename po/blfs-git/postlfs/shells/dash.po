#. type: Content of: <sect1><sect2><sect3><title>
#: blfs-en/blfs-git/postlfs/shells/dash.xml:162
#, xml-text
msgid "Configuration Information"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/blfs-git/postlfs/shells/dash.xml:165
#, xml-text
msgid ""
"Update <filename>/etc/shells</filename> to include the "
"<application>Dash</application> shell by issuing the following command as "
"the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><screen>
#: blfs-en/blfs-git/postlfs/shells/dash.xml:170
#, no-wrap, xml-text
msgid ""
"<userinput>cat &gt;&gt; /etc/shells &lt;&lt; \"EOF\"\n"
"<literal>/bin/dash</literal>\n"
"EOF</userinput>"
msgstr ""

