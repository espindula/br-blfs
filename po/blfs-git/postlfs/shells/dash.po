#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/postlfs/shells/dash.xml:86
#, xml-text
msgid "Installation of Dash"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/shells/dash.xml:89
#, xml-text
msgid ""
"Install <application>Dash</application> by running the following commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/postlfs/shells/dash.xml:93
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --bindir=/bin --mandir=/usr/share/man &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/shells/dash.xml:97
#, xml-text
msgid "This package does not come with a test suite."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/shells/dash.xml:101
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/postlfs/shells/dash.xml:104
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/shells/dash.xml:107
#, xml-text
msgid ""
"If you would like to make <command>dash</command> the default "
"<command>sh</command>, recreate the <filename>/bin/sh</filename> symlink as "
"the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><note><para>
#: blfs-en/blfs-git/postlfs/shells/dash.xml:114
#, xml-text
msgid ""
"If you create the symbolic link from <command>dash</command> to "
"<command>sh</command>, you will need to reset the link to "
"<command>bash</command> to build LFS."
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/postlfs/shells/dash.xml:120
#, no-wrap, xml-text
msgid "<userinput>ln -svf dash /bin/sh</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/postlfs/shells/dash.xml:125
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/shells/dash.xml:128
#, xml-text
msgid ""
"<parameter>--bindir=/bin</parameter>: This parameter places the "
"<command>dash</command> binary into the root filesystem."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/shells/dash.xml:133
#, xml-text
msgid ""
"<option>--with-libedit</option>: To compile <application>Dash</application> "
"with libedit support."
msgstr ""

