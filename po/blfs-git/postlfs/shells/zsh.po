#: blfs-en/blfs-git/postlfs/shells/zsh.xml:91
#, xml-text
msgid "Installation of zsh"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/shells/zsh.xml:94
#, xml-text
msgid "Adapt the documentation build system for texinfo-7.0 or later:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/postlfs/shells/zsh.xml:97
#, no-wrap, xml-text
msgid ""
"<userinput>sed -e 's/set_from_init_file/texinfo_&amp;/' \\\n"
"    -i Doc/Makefile.in</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/shells/zsh.xml:103
#, xml-text
msgid ""
"Some programs shipped in the building system for detecting system features "
"use pre-C99 syntax rejected by GCC-14.1 and later.  Fix them because Zsh "
"will be configured incorrectly and fail to build otherwise:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/postlfs/shells/zsh.xml:108
#, no-wrap, xml-text
msgid ""
"<userinput>sed -e 's/^main/int &amp;/'      \\\n"
"    -e 's/exit(/return(/'    \\\n"
"    -i aczsh.m4 configure.ac &amp;&amp;\n"
"\n"
"sed -e 's/test = /&amp;(char**)/' \\\n"
"    -i configure.ac           &amp;&amp;\n"
"\n"
"autoconf</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/shells/zsh.xml:118
#, xml-text
msgid ""
"The documentation files contain references to zsh configuration files in "
"<filename class='directory'>/etc</filename>, but we'll use <filename "
"class='directory'>/etc/zsh</filename> to hold these configuration files "
"instead. The build system will update those references if the "
"<application>yodl</application> package is available, but it's out of the "
"scope of BLFS. As a result, we need to fix the references manually:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/postlfs/shells/zsh.xml:127
#, no-wrap, xml-text
msgid ""
"<userinput>sed -e 's|/etc/z|/etc/zsh/z|g' \\\n"
"    -i Doc/*.*</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/shells/zsh.xml:139
#, xml-text
msgid ""
"Install <application>zsh</application> by running the following commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/postlfs/shells/zsh.xml:143
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr            \\\n"
"            --sysconfdir=/etc/zsh    \\\n"
"            --enable-etcdir=/etc/zsh \\\n"
"            --enable-cap             \\\n"
"            --enable-gdbm            &amp;&amp;\n"
"make                                 &amp;&amp;\n"
"\n"
"makeinfo  Doc/zsh.texi --html      -o Doc/html &amp;&amp;\n"
"makeinfo  Doc/zsh.texi --plaintext -o zsh.txt  &amp;&amp;\n"
"makeinfo  Doc/zsh.texi --html --no-split --no-headers -o zsh.html</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/shells/zsh.xml:155
#, xml-text
msgid ""
"If you have <xref linkend=\"texlive\"/> installed, you can build the "
"documentation in PDF format by issuing the following command:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/postlfs/shells/zsh.xml:160
#, no-wrap, xml-text
msgid "<userinput>texi2pdf  Doc/zsh.texi -o Doc/zsh.pdf</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/shells/zsh.xml:163
#, xml-text
msgid "To test the results, issue: <command>make check</command>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/shells/zsh.xml:167
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/postlfs/shells/zsh.xml:170
#, no-wrap, xml-text
msgid ""
"<userinput>make install                                                    &amp;&amp;\n"
"make infodir=/usr/share/info install.info                       &amp;&amp;\n"
"make htmldir=/usr/share/doc/zsh-&zsh-version;/html install.html           &amp;&amp;\n"
"install -v -m644 zsh.{html,txt} Etc/FAQ /usr/share/doc/zsh-&zsh-version;</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/shells/zsh.xml:176
#, xml-text
msgid ""
"If you built the PDF format of the documentation, install it by issuing the "
"following command as the <systemitem class=\"username\">root</systemitem> "
"user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/postlfs/shells/zsh.xml:182
#, no-wrap, xml-text
msgid ""
"<userinput>install -v -m644 Doc/zsh.pdf /usr/share/doc/zsh-&zsh-"
"version;</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/postlfs/shells/zsh.xml:187
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/shells/zsh.xml:190
#, xml-text
msgid ""
"<parameter>--sysconfdir=/etc/zsh</parameter> and <parameter>--enable-"
"etcdir=/etc/zsh</parameter>: These parameters are used so that all the "
"<application>zsh</application> configuration files are consolidated into the"
" <filename class='directory'>/etc/zsh</filename> directory. Omit these "
"parameters if you wish to retain historical compatibility by having all the "
"files located in the <filename class='directory'>/etc</filename> directory."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/shells/zsh.xml:200
#, xml-text
msgid ""
"<parameter>--enable-cap</parameter>: This option enables POSIX capabilities."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/shells/zsh.xml:205
#, xml-text
msgid ""
"<parameter>--enable-gdbm</parameter>: This option enables the use of the "
"<application>GDBM</application> library."
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/postlfs/shells/zsh.xml:218
#, xml-text
msgid "Configuring zsh"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><title>
#: blfs-en/blfs-git/postlfs/shells/zsh.xml:221
#, xml-text
msgid "Config Files"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/blfs-git/postlfs/shells/zsh.xml:224
#, xml-text
msgid ""
"There are a whole host of configuration files for "
"<application>zsh</application> including "
"<filename>/etc/zsh/zshenv</filename>, "
"<filename>/etc/zsh/zprofile</filename>, <filename>/etc/zsh/zshrc</filename>,"
" <filename>/etc/zsh/zlogin</filename> and "
"<filename>/etc/zsh/zlogout</filename>.  You can find more information on "
"these in the <ulink role='man' url='&man;zsh.1'>zsh(1)</ulink> and related "
"manual pages."
msgstr ""

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/blfs-git/postlfs/shells/zsh.xml:237
#, xml-text
msgid ""
"The first time zsh is executed, you will be prompted by messages asking "
"several questions. The answers will be used to create a "
"<filename>~/.zshrc</filename> file. If you wish to run these questions "
"again, run <command>zsh /usr/share/zsh/&zsh-version;/functions/zsh-newuser-"
"install -f</command>."
msgstr ""

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/blfs-git/postlfs/shells/zsh.xml:245
#, xml-text
msgid ""
"There are several built-in advanced prompts. In the <command>zsh</command> "
"shell, start advanced prompt support with <command>autoload -U "
"promptinit</command>, then <command>promptinit</command>. Available prompt "
"names are listed with <command>prompt -l</command>. Select a particular one "
"with <command>prompt <literal>&lt;prompt-name&gt;</literal></command>.  "
"Display all available prompts with <command>prompt -p</command>. Except for "
"the list and display commands above, you can insert the other ones in "
"<filename>~/.zshrc</filename> to be automatically executed when the shell "
"starts, with the prompt you chose."
msgstr ""

#. type: Content of: <sect1><sect2><sect3><indexterm><primary>
#: blfs-en/blfs-git/postlfs/shells/zsh.xml:259
#, xml-text
msgid "/etc/zsh/zshenv"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><indexterm><primary>
#: blfs-en/blfs-git/postlfs/shells/zsh.xml:263
#, xml-text
msgid "/etc/zsh/zprofile"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><indexterm><primary>
#: blfs-en/blfs-git/postlfs/shells/zsh.xml:267
#, xml-text
msgid "/etc/zsh/zshrc"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><indexterm><primary>
