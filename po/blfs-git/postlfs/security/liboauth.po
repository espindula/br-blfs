"version;-openssl-1.1.0-3.patch</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/security/liboauth.xml:107
#, xml-text
msgid ""
"Install <application>liboauth</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/postlfs/security/liboauth.xml:111
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr --disable-static &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/security/liboauth.xml:115
#, xml-text
msgid ""
"If you wish to build the documentation (needs <xref linkend=\"doxygen\"/>), "
"issue:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/postlfs/security/liboauth.xml:119
#, no-wrap, xml-text
msgid "<userinput>make dox</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/security/liboauth.xml:122
#, xml-text
msgid "To test the results, issue: <command>make check</command>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/security/liboauth.xml:126
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/postlfs/security/liboauth.xml:129
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/security/liboauth.xml:132
#, xml-text
msgid ""
"If you have previously built the documentation, install it by running the "
"following commands as the <systemitem class=\"username\">root</systemitem> "
"user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/postlfs/security/liboauth.xml:138
#, no-wrap, xml-text
msgid ""
"<userinput>install -v -dm755 /usr/share/doc/liboauth-&liboauth-version; &amp;&amp;\n"
"cp -rv doc/html/* /usr/share/doc/liboauth-&liboauth-version;</userinput>"
msgstr ""

