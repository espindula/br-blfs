#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/postlfs/security/libpwquality.xml:85
#, xml-text
msgid "Installation of libpwquality"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/security/libpwquality.xml:88
#, xml-text
msgid ""
"Install <application>libpwquality</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/postlfs/security/libpwquality.xml:92
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr                      \\\n"
"            --disable-static                   \\\n"
"            --with-securedir=/usr/lib/security \\\n"
"            --disable-python-bindings          &amp;&amp;\n"
"make &amp;&amp;\n"
"&build-wheel-cmd; $PWD/python</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/security/libpwquality.xml:100
#, xml-text
msgid "This package does not come with a test suite."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/security/libpwquality.xml:104
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/postlfs/security/libpwquality.xml:107
#, no-wrap, xml-text
msgid ""
"<userinput>make install &amp;&amp;\n"
"&install-wheel; pwquality</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/postlfs/security/libpwquality.xml:113
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/security/libpwquality.xml:116
#, xml-text
msgid ""
"<parameter>--disable-python-bindings</parameter>: This parameter disables "
"building Python bindings with the deprecated <command>python3 setup.py "
"build</command> command.  The explicit instruction to build the Python 3 "
"binding with the <command>pip3 wheel</command> command is provided."
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/postlfs/security/libpwquality.xml:126
#, xml-text
msgid "Configuring libpwquality"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/security/libpwquality.xml:129
#, xml-text
msgid ""
"<application>libpwquality</application> is intended to be a functional "
"replacement for the now-obsolete <filename>pam_cracklib.so</filename> PAM "
"module. To configure the system to use the "
"<filename>pam_pwquality</filename> module, execute the following commands as"
" the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/postlfs/security/libpwquality.xml:137
#, no-wrap, xml-text
msgid ""
"<userinput>mv /etc/pam.d/system-password{,.orig} &amp;&amp;\n"
"cat &gt; /etc/pam.d/system-password &lt;&lt; \"EOF\"\n"
"<literal># Begin /etc/pam.d/system-password\n"
"\n"
"# check new passwords for strength (man pam_pwquality)\n"
"password  required    pam_pwquality.so   authtok_type=UNIX retry=1 difok=1 \\\n"
"                                         minlen=8 dcredit=0 ucredit=0      \\\n"
"                                         lcredit=0 ocredit=0 minclass=1    \\\n"
"                                         maxrepeat=0 maxsequence=0         \\\n"
"                                         maxclassrepeat=0 gecoscheck=0     \\\n"
"                                         dictcheck=1 usercheck=1           \\\n"
"                                         enforcing=1 badwords=\"\"           \\\n"
"                                         dictpath=/usr/lib/cracklib/pw_dict\n"
"\n"
"# use yescrypt hash for encryption, use shadow, and try to use any\n"
"# previously defined authentication token (chosen password) set by any\n"
"# prior module.\n"
"password  required    pam_unix.so        yescrypt shadow try_first_pass\n"
"\n"
"# End /etc/pam.d/system-password</literal>\n"
"EOF\n"
"</userinput>"
msgstr ""

