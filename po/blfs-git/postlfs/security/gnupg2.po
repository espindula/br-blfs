#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/postlfs/security/gnupg2.xml:124
#, xml-text
msgid "Installation of GnuPG"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/security/gnupg2.xml:135
#, xml-text
msgid ""
"Install <application>GnuPG</application> by running the following commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/postlfs/security/gnupg2.xml:139
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"../configure --prefix=/usr        \\\n"
"             --localstatedir=/var \\\n"
"             --sysconfdir=/etc    \\\n"
"             --docdir=/usr/share/doc/gnupg-&gnupg2-version; &amp;&amp;\n"
"make &amp;&amp;\n"
"\n"
"makeinfo --html --no-split -I doc -o doc/gnupg_nochunks.html ../doc/gnupg.texi &amp;&amp;\n"
"makeinfo --plaintext       -I doc -o doc/gnupg.txt           ../doc/gnupg.texi &amp;&amp;\n"
"make -C doc html</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/security/gnupg2.xml:153
#, xml-text
msgid ""
"If you have <xref linkend=\"texlive\"/> installed and you wish to create "
"documentation in the pdf format, issue the following command:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/postlfs/security/gnupg2.xml:158
#, no-wrap, xml-text
msgid "<userinput>make -C doc pdf</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/security/gnupg2.xml:161
#, xml-text
msgid "To test the results, issue: <command>make check</command>."
msgstr ""

#.       Note that if you have already installed
#.       <application>
#. GnuPG</application>, the instructions below will overwrite
#.       <filename>/usr/share/man/man1/gpg-zip.1</filename>.
#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/security/gnupg2.xml:170
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/postlfs/security/gnupg2.xml:173
#, no-wrap, xml-text
msgid ""
"<userinput>make install &amp;&amp;\n"
"\n"
"install -v -m755 -d /usr/share/doc/gnupg-&gnupg2-version;/html            &amp;&amp;\n"
"install -v -m644    doc/gnupg_nochunks.html \\\n"
"                    /usr/share/doc/gnupg-&gnupg2-version;/html/gnupg.html &amp;&amp;\n"
"install -v -m644    ../doc/*.texi doc/gnupg.txt \\\n"
"                    /usr/share/doc/gnupg-&gnupg2-version; &amp;&amp;\n"
"install -v -m644    doc/gnupg.html/* \\\n"
"                    /usr/share/doc/gnupg-&gnupg2-version;/html</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/security/gnupg2.xml:183
#, xml-text
msgid ""
"If you created the pdf format of the documentation, install them using the "
"following command as the <systemitem class=\"username\">root</systemitem> "
"user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/postlfs/security/gnupg2.xml:189
#, no-wrap, xml-text
msgid ""
"<userinput>install -v -m644 doc/gnupg.pdf \\\n"
"                 /usr/share/doc/gnupg-&gnupg2-version;</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/postlfs/security/gnupg2.xml:195
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/security/gnupg2.xml:203
#, xml-text
msgid ""
"<command>mkdir build &amp;&amp; cd build</command>: the Gnupg2 developers "
"recommend to build the package in a dedicated directory."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/security/gnupg2.xml:208
#, xml-text
msgid ""
"<parameter>--docdir=/usr/share/doc/gnupg-&gnupg2-version;</parameter>: This "
"switch changes the default docdir to <filename "
"class=\"directory\">/usr/share/doc/gnupg-&gnupg2-version;</filename>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/security/gnupg2.xml:220
#, xml-text
msgid ""
"<option>--enable-all-tests</option>: This switch allows more tests to be run"
" with <command>make check</command>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/security/gnupg2.xml:225
#, xml-text
msgid ""
"<option>--enable-g13</option>: This switch enables building the g13 program."
msgstr ""

