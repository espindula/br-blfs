#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/postlfs/security/libcap.xml:82
#, xml-text
msgid "Installation of libcap"
msgstr ""

#. type: Content of: <sect1><sect2><note><para>
#: blfs-en/blfs-git/postlfs/security/libcap.xml:86
#, xml-text
msgid ""
"If you are upgrading libcap from a previous version, use the instructions in"
" <ulink url=\"&lfs-root;/chapter08/libcap.html\"> LFS libcap page </ulink> "
"to upgrade libcap. If <xref linkend=\"linux-pam\"/> has been built, the PAM "
"module will automatically be built too."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/security/libcap.xml:96
#, xml-text
msgid ""
"Install <application>libcap</application> by running the following commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/postlfs/security/libcap.xml:100
#, no-wrap, xml-text
msgid "<userinput>make -C pam_cap</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/security/libcap.xml:103
#, xml-text
msgid "This package does not come with a test suite."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/security/libcap.xml:107
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/postlfs/security/libcap.xml:110
#, no-wrap, xml-text
msgid ""
"<userinput>install -v -m755 pam_cap/pam_cap.so      /usr/lib/security &amp;&amp;\n"
"install -v -m644 pam_cap/capability.conf /etc/security</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/postlfs/security/libcap.xml:116
#, xml-text
msgid "Configuring Libcap"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/security/libcap.xml:119
#, xml-text
msgid ""
"In order to allow <application>Linux-PAM</application> to grant privileges "
"based on POSIX capabilities, you need to add the libcap module to the "
"beginning of the <filename>/etc/pam.d/system-auth</filename> file.  Make the"
" required edits with the following commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/postlfs/security/libcap.xml:125
#, no-wrap, xml-text
msgid ""
"<userinput>mv -v /etc/pam.d/system-auth{,.bak} &amp;&amp;\n"
"cat &gt; /etc/pam.d/system-auth &lt;&lt; \"EOF\" &amp;&amp;\n"
"<literal># Begin /etc/pam.d/system-auth\n"
"\n"
"auth      optional    pam_cap.so</literal>\n"
"EOF\n"
"tail -n +3 /etc/pam.d/system-auth.bak &gt;&gt; /etc/pam.d/system-auth</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/security/libcap.xml:134
#, xml-text
msgid ""
"Additionally, you'll need to modify the "
"<filename>/etc/security/capability.conf</filename> file to grant necessary "
"privileges to users, and utilize the <command>setcap</command> utility to "
"set capabilities on specific utilities as needed. See <command>man 8 "
"setcap</command> and <command>man 3 cap_from_text</command> for additional "
"information."
msgstr ""

