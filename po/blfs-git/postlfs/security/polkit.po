#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/postlfs/security/polkit.xml:171
#, xml-text
msgid "Installation of Polkit"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/security/polkit.xml:174
#, xml-text
msgid ""
"There should be a dedicated user and group to take control of the "
"<command>polkitd</command> daemon after it is started. Issue the following "
"commands as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/postlfs/security/polkit.xml:180
#, no-wrap, xml-text
msgid ""
"<userinput>groupadd -fg 27 polkitd &amp;&amp;\n"
"useradd -c \"PolicyKit Daemon Owner\" -d /etc/polkit-1 -u 27 \\\n"
"        -g polkitd -s /bin/false polkitd</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/security/polkit.xml:185
#, xml-text
msgid ""
"Install <application>Polkit</application> by running the following commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/postlfs/security/polkit.xml:189
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup ..                   \\\n"
"      --prefix=/usr              \\\n"
"      --buildtype=release        \\\n"
"      -D man=true                \\\n"
"      -D session_tracking=logind \\\n"
"      -D tests=true</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/postlfs/security/polkit.xml:199
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup ..                     \\\n"
"      --prefix=/usr                \\\n"
"      --buildtype=release          \\\n"
"      -D man=true                  \\\n"
"      -D session_tracking=elogind  \\\n"
"      -D systemdsystemunitdir=/tmp \\\n"
"      -D tests=true</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/security/polkit.xml:211
#, xml-text
msgid "Build the package:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/postlfs/security/polkit.xml:214
#, no-wrap, xml-text
msgid "<userinput>ninja</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/security/polkit.xml:217
#, xml-text
msgid ""
"To test the results, first ensure that the system "
"<application>D-Bus</application> daemon is running, and both <xref "
"linkend='dbus-python'/> and <xref linkend='python-dbusmock'/> are installed."
"  Then run <command>ninja test</command>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/security/polkit.xml:225
#, xml-text
msgid "Now, as the &root; user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/postlfs/security/polkit.xml:228
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/security/polkit.xml:231
#, xml-text
msgid ""
"Remove some files that aren't useful on a SysV system as the &root; user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/postlfs/security/polkit.xml:234
#, no-wrap, xml-text
msgid ""
"<userinput>rm -v /tmp/*.service                 &amp;&amp;\n"
"rm -rf /usr/lib/{sysusers,tmpfiles}.d </userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/postlfs/security/polkit.xml:240
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/security/polkit.xml:246
#, xml-text
msgid ""
"<parameter>-D tests=true</parameter>: This switch allows to run the test "
"suite of this package.  As <application>Polkit</application> is used for "
"authorizations, its integrity can affect system security.  So it's "
"recommended to run the test suite building this package."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/security/polkit.xml:253
#, xml-text
msgid ""
"<option>-D os_type=lfs</option>: Use this switch if you did not create the "
"<filename>/etc/lfs-release</filename> file or distribution auto detection "
"will fail and you will be unable to use <application>Polkit</application>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/security/polkit.xml:260
#, xml-text
msgid ""
"<option>-D authfw=shadow</option>: This switch enables the package to use "
"the <application>Shadow</application> rather than the <application>Linux "
"PAM</application> Authentication framework. Use it if you have not installed"
" <application>Linux PAM</application>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/security/polkit.xml:267
#, xml-text
msgid ""
"<option>-D introspection=false</option>: Use this option if you are certain "
"that you do not need gobject-introspection files for polkit, or do not have "
"installed <xref linkend='glib2'/> with GObject Introspection."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/security/polkit.xml:273
#, xml-text
msgid ""
"<option>-D man=false</option>: Use this option to disable generating and "
"installing manual pages. This is useful if libxslt is not installed."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/security/polkit.xml:278
#, xml-text
msgid ""
"<option>-D examples=true</option>: Use this option to build the example "
"programs."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/security/polkit.xml:283
#, xml-text
msgid ""
"<option>-D gtk_doc=true</option>: Use this option to enable building and "
"installing the API documentation."
msgstr ""

