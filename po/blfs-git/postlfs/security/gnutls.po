#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/postlfs/security/gnutls.xml:147
#, xml-text
msgid "Installation of GnuTLS"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/security/gnutls.xml:150
#, xml-text
msgid ""
"Install <application>GnuTLS</application> by running the following commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/postlfs/security/gnutls.xml:154
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr \\\n"
"            --docdir=/usr/share/doc/gnutls-&gnutls-version; \\\n"
"            --with-default-trust-store-pkcs11=\"pkcs11:\" &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/security/gnutls.xml:168
#, xml-text
msgid "To test the results, now issue: <command>make check</command>."
