#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/postlfs/security/cyrus-sasl.xml:111
#, xml-text
msgid "Installation of Cyrus SASL"
msgstr ""

#. type: Content of: <sect1><sect2><note><para>
#: blfs-en/blfs-git/postlfs/security/cyrus-sasl.xml:115
#, xml-text
msgid "This package does not support parallel build."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/security/cyrus-sasl.xml:120
#, xml-text
msgid "First, fix the package to be compatible with gcc-15:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/postlfs/security/cyrus-sasl.xml:123
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"pre\">patch -Np1 -i ../cyrus-sasl-2.1.28-gcc15_fixes-1.patch &amp;&amp;\n"
"autoreconf -fiv</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/security/cyrus-sasl.xml:127
#, xml-text
msgid "Also, fix a problem revealed by gcc-14 and later:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/postlfs/security/cyrus-sasl.xml:130
#, no-wrap, xml-text
msgid ""
"<userinput>sed '/saslint/a #include &lt;time.h&gt;'       -i lib/saslutil.c &amp;&amp;\n"
"sed '/plugin_common/a #include &lt;time.h&gt;' -i plugins/cram.c</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/security/cyrus-sasl.xml:134
#, xml-text
msgid ""
"Install <application>Cyrus SASL</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/postlfs/security/cyrus-sasl.xml:138
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr                       \\\n"
"            --sysconfdir=/etc                   \\\n"
"            --enable-auth-sasldb                \\\n"
"            --with-dblib=lmdb                   \\\n"
"            --with-dbpath=/var/lib/sasl/sasldb2 \\\n"
"            --with-sphinx-build=no              \\\n"
"            --with-saslauthd=/var/run/saslauthd &amp;&amp;\n"
"make -j1</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/security/cyrus-sasl.xml:148
#, xml-text
msgid ""
"This package does not come with a test suite. If you are planning on using "
"the GSSAPI authentication mechanism, test it after installing the package "
"using the sample server and client programs which were built in the "
"preceding step. Instructions for performing the tests can be found at <ulink"
" url=\"&hints-root;/downloads/files/cyrus-sasl.txt\"/>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/security/cyrus-sasl.xml:157
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/postlfs/security/cyrus-sasl.xml:160
#, no-wrap, xml-text
msgid ""
"<userinput>make install &amp;&amp;\n"
"install -v -dm755                          /usr/share/doc/cyrus-sasl-&cyrus-sasl-version;/html &amp;&amp;\n"
"install -v -m644  saslauthd/LDAP_SASLAUTHD /usr/share/doc/cyrus-sasl-&cyrus-sasl-version;      &amp;&amp;\n"
"install -v -m644  doc/legacy/*.html        /usr/share/doc/cyrus-sasl-&cyrus-sasl-version;/html &amp;&amp;\n"
"install -v -dm700 /var/lib/sasl</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/postlfs/security/cyrus-sasl.xml:169
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/security/cyrus-sasl.xml:172
#, xml-text
msgid ""
"<parameter>--with-dbpath=/var/lib/sasl/sasldb2</parameter>: This switch "
"forces the <command>sasldb</command> database to be created in <filename "
"class=\"directory\">/var/lib/sasl</filename> instead of <filename "
"class=\"directory\">/etc</filename>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/security/cyrus-sasl.xml:179
#, xml-text
msgid ""
"<parameter>--with-saslauthd=/var/run/saslauthd</parameter>: This switch "
"forces <command>saslauthd</command> to use the FHS compliant directory "
"<filename class=\"directory\">/var/run/saslauthd</filename> for variable "
"run-time data."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/security/cyrus-sasl.xml:186
#, xml-text
msgid ""
"<parameter>--enable-auth-sasldb</parameter>: This switch enables SASLDB "
"authentication backend."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/security/cyrus-sasl.xml:191
#, xml-text
msgid ""
"<option>--with-dblib=gdbm</option>: This switch forces "
"<application>GDBM</application> to be used instead of "
"<application>LMDB</application>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/security/cyrus-sasl.xml:197
#, xml-text
msgid ""
"<option>--with-ldap</option>: This switch enables the "
"<application>OpenLDAP</application> support."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/security/cyrus-sasl.xml:202
#, xml-text
msgid ""
"<option>--enable-ldapdb</option>: This switch enables the LDAPDB "
"authentication backend."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/security/cyrus-sasl.xml:207
#, xml-text
msgid ""
"<option>--enable-login</option>: This option enables unsupported LOGIN "
"authentication."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/security/cyrus-sasl.xml:212
#, xml-text
msgid ""
"<option>--enable-ntlm</option>: This option enables unsupported NTLM "
"authentication."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/security/cyrus-sasl.xml:217
#, xml-text
msgid ""
"<command>install -v -m644 ...</command>: These commands install "
"documentation which is not installed by the <command>make install</command> "
"command."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/security/cyrus-sasl.xml:223
#, xml-text
msgid ""
"<command>install -v -m700 -d /var/lib/sasl</command>: This directory must "
"exist when starting <command>saslauthd</command> or using the sasldb plugin."
" If you're not going to be running the daemon or using the plugins, you may "
"omit the creation of this directory."
msgstr ""

