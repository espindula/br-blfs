#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/postlfs/security/openssh.xml:117
#, xml-text
msgid "Installation of OpenSSH"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/security/openssh.xml:120
#, xml-text
msgid ""
"<application>OpenSSH</application> runs as two processes when connecting to "
"other computers. The first process is a privileged process and controls the "
"issuance of privileges as necessary. The second process communicates with "
"the network. Additional installation steps are necessary to set up the "
"proper environment, which are performed by issuing the following commands as"
" the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/postlfs/security/openssh.xml:128
#, no-wrap, xml-text
msgid ""
"<userinput>install -v -g sys -m700 -d /var/lib/sshd &amp;&amp;\n"
"\n"
"groupadd -g 50 sshd        &amp;&amp;\n"
"useradd  -c 'sshd PrivSep' \\\n"
"         -d /var/lib/sshd  \\\n"
"         -g sshd           \\\n"
"         -s /bin/false     \\\n"
"         -u 50 sshd</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/security/openssh.xml:165
#, xml-text
msgid ""
"Install <application>OpenSSH</application> by running the following "
"commands:"
msgstr ""

#.  -\-with-md5-passwords used to be here, but a comment inside of a <screen>
#.      block leaves an eyesore.
#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/postlfs/security/openssh.xml:171
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr                            \\\n"
"            --sysconfdir=/etc/ssh                    \\\n"
"            --with-privsep-path=/var/lib/sshd        \\\n"
"            --with-default-path=/usr/bin             \\\n"
"            --with-superuser-path=/usr/sbin:/usr/bin \\\n"
"            --with-pid-dir=/run                      &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. One test, <filename>
#. key options</filename>, fails when run in chroot.
#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/security/openssh.xml:197
#, xml-text
msgid "To test the results, issue: <command>make -j1 tests</command>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/security/openssh.xml:220
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/postlfs/security/openssh.xml:223
#, no-wrap, xml-text
msgid ""
"<userinput>make install &amp;&amp;\n"
"install -v -m755    contrib/ssh-copy-id /usr/bin     &amp;&amp;\n"
"\n"
"install -v -m644    contrib/ssh-copy-id.1 \\\n"
"                    /usr/share/man/man1              &amp;&amp;\n"
"install -v -m755 -d /usr/share/doc/openssh-&openssh-version;     &amp;&amp;\n"
"install -v -m644    INSTALL LICENCE OVERVIEW README* \\\n"
"                    /usr/share/doc/openssh-&openssh-version;</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/postlfs/security/openssh.xml:234
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/security/openssh.xml:237
#, xml-text
msgid ""
"<parameter>--sysconfdir=/etc/ssh</parameter>: This prevents the "
"configuration files from being installed in <filename "
"class=\"directory\">/usr/etc</filename>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/security/openssh.xml:243
#, xml-text
msgid ""
"<parameter>--with-default-path=/usr/bin</parameter> and <parameter>--with-"
"superuser-path=/usr/sbin:/usr/bin</parameter>: These set <envar>PATH</envar>"
" consistent with LFS and BLFS <application>Shadow</application> package."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/security/openssh.xml:250
#, xml-text
msgid ""
"<parameter>--with-pid-dir=/run</parameter>: This prevents "
"<application>OpenSSH</application> from referring to deprecated <filename "
"class=\"directory\">/var/run</filename>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/security/openssh.xml:265
#, xml-text
msgid ""
"<option>--with-pam</option>: This parameter enables <application>Linux-"
"PAM</application> support in the build."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/security/openssh.xml:270
#, xml-text
msgid ""
"<option>--with-xauth=$XORG_PREFIX/bin/xauth</option>: Set the default "
"location for the <command>xauth</command> binary for X authentication.  The "
"environment variable <envar>XORG_PREFIX</envar> should be set following "
"<xref linkend='xorg-env'/>. This can also be controlled from "
"<filename>sshd_config</filename> with the XAuthLocation keyword. You can "
"omit this switch if <command>xauth</command> (one of <xref "
"linkend=\"xorg7-app\"/>) is already installed."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/security/openssh.xml:280
#, xml-text
msgid ""
"<option>--with-kerberos5=/usr</option>: This option is used to include "
"Kerberos 5 support in the build."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/security/openssh.xml:285
#, xml-text
msgid ""
"<option>--with-libedit</option>: This option enables line editing and "
"history features for <command>sftp</command>."
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/postlfs/security/openssh.xml:292
#, xml-text
msgid "Configuring OpenSSH"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><title>
#: blfs-en/blfs-git/postlfs/security/openssh.xml:295
#, xml-text
msgid "Config Files"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/blfs-git/postlfs/security/openssh.xml:298
#, xml-text
msgid ""
"<filename>~/.ssh/*</filename>, <filename>/etc/ssh/ssh_config</filename>, and"
" <filename>/etc/ssh/sshd_config</filename>"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><indexterm><primary>
#: blfs-en/blfs-git/postlfs/security/openssh.xml:304
#, xml-text
msgid "~/.ssh/*"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><indexterm><primary>
#: blfs-en/blfs-git/postlfs/security/openssh.xml:308
#, xml-text
msgid "/etc/ssh/ssh_config"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><indexterm><primary>
#: blfs-en/blfs-git/postlfs/security/openssh.xml:312
#, xml-text
msgid "/etc/ssh/sshd_config"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/blfs-git/postlfs/security/openssh.xml:316
#, xml-text
msgid ""
"There are no required changes to any of these files. However, you may wish "
"to view the <filename class='directory'>/etc/ssh/</filename> files and make "
"any changes appropriate for the security of your system. One recommended "
"change is that you disable <systemitem class='username'>root</systemitem> "
"login via <command>ssh</command>. Execute the following command as the "
"<systemitem class='username'>root</systemitem> user to disable <systemitem "
"class='username'>root</systemitem> login via <command>ssh</command>:"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><screen>
#: blfs-en/blfs-git/postlfs/security/openssh.xml:328
#, no-wrap, xml-text
msgid ""
"<userinput>echo \"PermitRootLogin no\" &gt;&gt; "
"/etc/ssh/sshd_config</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/blfs-git/postlfs/security/openssh.xml:331
#, xml-text
msgid ""
"If you want to be able to log in without typing in your password, first "
"create ~/.ssh/id_rsa and ~/.ssh/id_rsa.pub with <command>ssh-"
"keygen</command> and then copy ~/.ssh/id_rsa.pub to ~/.ssh/authorized_keys "
"on the remote computer that you want to log into.  You'll need to change "
"REMOTE_USERNAME and REMOTE_HOSTNAME for the username and hostname of the "
"remote computer and you'll also need to enter your password for the ssh-"
"copy-id command to succeed:"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><screen>
#: blfs-en/blfs-git/postlfs/security/openssh.xml:340
#, no-wrap, xml-text
msgid ""
"<userinput>ssh-keygen &amp;&amp;\n"
"ssh-copy-id -i ~/.ssh/id_ed25519.pub <replaceable>REMOTE_USERNAME</replaceable>@<replaceable>REMOTE_HOSTNAME</replaceable></userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/blfs-git/postlfs/security/openssh.xml:344
#, xml-text
msgid ""
"Once you've got passwordless logins working it's actually more secure than "
"logging in with a password (as the private key is much longer than most "
"people's passwords). If you would like to now disable password logins, as "
"the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><screen>
#: blfs-en/blfs-git/postlfs/security/openssh.xml:351
#, no-wrap, xml-text
msgid ""
"<userinput>echo \"PasswordAuthentication no\" >> /etc/ssh/sshd_config &amp;&amp;\n"
"echo \"KbdInteractiveAuthentication no\" >> /etc/ssh/sshd_config</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/blfs-git/postlfs/security/openssh.xml:355
#, xml-text
msgid ""
"If you added <application>Linux-PAM</application> support and you want ssh "
"to use it then you will need to add a configuration file for "
"<application>sshd</application> and enable use of "
"<application>LinuxPAM</application>. Note, ssh only uses PAM to check "
"passwords, if you've disabled password logins these commands are not needed."
" If you want to use PAM, issue the following commands as the <systemitem "
"class='username'>root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><screen>
#: blfs-en/blfs-git/postlfs/security/openssh.xml:364
#, no-wrap, xml-text
msgid ""
"<userinput>sed 's@d/login@d/sshd@g' /etc/pam.d/login &gt; /etc/pam.d/sshd &amp;&amp;\n"
"chmod 644 /etc/pam.d/sshd &amp;&amp;\n"
"echo \"UsePAM yes\" &gt;&gt; /etc/ssh/sshd_config</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/blfs-git/postlfs/security/openssh.xml:369
#, xml-text
msgid ""
"Additional configuration information can be found in the man pages for "
"<command>sshd</command>, <command>ssh</command> and <command>ssh-"
"agent</command>."
msgstr ""

#. type: Content of: <sect1><sect2><sect3><title>
#: blfs-en/blfs-git/postlfs/security/openssh.xml:376
#, xml-text
msgid ""
"<phrase revision=\"sysv\">Boot Script</phrase> <phrase "
"revision=\"systemd\">Systemd Unit</phrase>"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/blfs-git/postlfs/security/openssh.xml:380
#, xml-text
msgid ""
"To start the SSH server at system boot, install the "
"<filename>/etc/rc.d/init.d/sshd</filename> init script included in the <xref"
" linkend=\"bootscripts\"/> package."
msgstr ""

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/blfs-git/postlfs/security/openssh.xml:386
#, xml-text
msgid ""
"To start the SSH server at system boot, install the "
"<filename>sshd.service</filename> unit included in the <xref "
"linkend=\"systemd-units\"/> package."
msgstr ""

#. type: Content of: <sect1><sect2><sect3><note><para>
#: blfs-en/blfs-git/postlfs/security/openssh.xml:393
#, xml-text
msgid ""
"Changing the setting of <option>ListenAddress</option> in "
"<filename>/etc/sshd/sshd_config</filename> is unsupported with the BLFS sshd"
" <phrase revision='sysv'>bootscript</phrase><phrase "
"revision='systemd'>systemd unit</phrase>."
msgstr ""

