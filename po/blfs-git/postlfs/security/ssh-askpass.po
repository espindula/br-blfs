#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/postlfs/security/ssh-askpass.xml:86
#, xml-text
msgid "Installation of ssh-askpass"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/security/ssh-askpass.xml:89
#, xml-text
msgid ""
"Install <application>ssh-askpass</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/postlfs/security/ssh-askpass.xml:93
#, no-wrap, xml-text
msgid ""
"<userinput>cd contrib &amp;&amp;\n"
"make gnome-ssh-askpass3</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/security/ssh-askpass.xml:97
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/postlfs/security/ssh-askpass.xml:100
#, no-wrap, xml-text
msgid ""
"<userinput>install -v -d -m755                    /usr/libexec/openssh/contrib  &amp;&amp;\n"
"install -v -m755    gnome-ssh-askpass3 /usr/libexec/openssh/contrib  &amp;&amp;\n"
"ln -sv -f contrib/gnome-ssh-askpass3   /usr/libexec/openssh/ssh-askpass</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/security/ssh-askpass.xml:105
#, xml-text
msgid ""
"The use of /usr/libexec/openssh/contrib and a symlink is justified by the "
"eventual necessity of a different program for that service."
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/postlfs/security/ssh-askpass.xml:112
#, xml-text
msgid "Configuring ssh-askpass"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><title>
#: blfs-en/blfs-git/postlfs/security/ssh-askpass.xml:115
#, xml-text
msgid "Configuration Information"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/blfs-git/postlfs/security/ssh-askpass.xml:118
#, xml-text
msgid ""
"As the <systemitem class=\"username\">root</systemitem> user, configure "
"<xref linkend=\"sudo\"/> to use <application>ssh-askpass</application>:"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><screen>
#: blfs-en/blfs-git/postlfs/security/ssh-askpass.xml:122
#, no-wrap, xml-text
msgid ""
"<userinput>cat &gt;&gt; /etc/sudo.conf &lt;&lt; \"EOF\" &amp;&amp;\n"
"<literal># Path to askpass helper program\n"
"Path askpass /usr/libexec/openssh/ssh-askpass</literal>\n"
"EOF\n"
"chmod -v 0644 /etc/sudo.conf</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/blfs-git/postlfs/security/ssh-askpass.xml:129
#, xml-text
msgid ""
"If a given graphical &lt;application&gt; requires administrative privileges,"
" use <command>sudo -A &lt;application&gt;</command> from an x-terminal, from"
" a Window Manager menu and/or replace \"Exec=&lt;application&gt; ...\" by "
"\"Exec=sudo -A &lt;application&gt; ...\" in the &lt;application&gt;.desktop "
"file."
msgstr ""

