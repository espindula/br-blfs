"<xref linkend=\"bind-utils\"/>, <xref linkend='cracklib'/> "
"(<filename>/usr/share/dict/words</filename> referred by some tests), <xref "
"linkend=\"keyutils\"/>, <xref linkend=\"openldap\"/>, <xref "
"linkend=\"valgrind\"/> (used during the test suite), <xref "
"linkend=\"yasm\"/>, <ulink "
"url=\"https://thrysoee.dk/editline/\">libedit</ulink>, <ulink "
