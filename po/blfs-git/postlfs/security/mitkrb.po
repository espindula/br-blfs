#.       implementation of rpc now.
#.       <xref linkend="rpcbind"/>
#.  (used during the test suite),
#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/security/mitkrb.xml:87
#, xml-text
