#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/postlfs/security/nettle.xml:79
#, xml-text
msgid "Installation of Nettle"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/security/nettle.xml:82
#, xml-text
msgid ""
"Install <application>Nettle</application> by running the following commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/postlfs/security/nettle.xml:86
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr --disable-static &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/security/nettle.xml:90
#, xml-text
msgid "To test the results, issue: <command>make check</command>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/security/nettle.xml:94
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/postlfs/security/nettle.xml:97
#, no-wrap, xml-text
msgid ""
"<userinput>make install &amp;&amp;\n"
"chmod   -v   755 /usr/lib/lib{hogweed,nettle}.so &amp;&amp;\n"
"install -v -m755 -d /usr/share/doc/nettle-&nettle-version; &amp;&amp;\n"
"install -v -m644 nettle.{html,pdf} /usr/share/doc/nettle-&nettle-version;</userinput>"
msgstr ""

