#. type: Content of: <sect1><sect2><segmentedlist><seglistitem><seg>
#: blfs-en/blfs-git/postlfs/security/linux-pam.xml:415
#, xml-text
msgid "libpam.so, libpamc.so and libpam_misc.so"
msgstr ""

#. type: Content of: <sect1><sect2><segmentedlist><seglistitem><seg>
#: blfs-en/blfs-git/postlfs/security/linux-pam.xml:418
#, xml-text
msgid ""
"/etc/security, /usr/lib/security, /usr/include/security and "
"/usr/share/doc/Linux-PAM-&linux-pam-version;"
msgstr ""

#. type: Content of: <sect1><sect2><variablelist><bridgehead>
#: blfs-en/blfs-git/postlfs/security/linux-pam.xml:427
#, xml-text
msgid "Short Descriptions"
msgstr ""

#. type: Content of: <sect1><sect2><variablelist>
#: blfs-en/blfs-git/postlfs/security/linux-pam.xml:428
#, xml-text
msgid "<?dbfo list-presentation=\"list\"?> <?dbhtml list-presentation=\"table\"?>"
msgstr ""

#. type: Content of: <sect1><sect2><variablelist><varlistentry><term>
#: blfs-en/blfs-git/postlfs/security/linux-pam.xml:432
