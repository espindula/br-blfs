#, xml-text
msgid "Installation of gpgme"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/security/gpgme.xml:98
#, xml-text
msgid ""
"Install <application>gpgme</application> by running the following commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/postlfs/security/gpgme.xml:102
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"../configure --prefix=/usr       \\\n"
"             --disable-static    &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/security/gpgme.xml:110
#, xml-text
msgid ""
"To test the results, you should have <xref linkend=\"gnupg2\"/> installed. "
"If so, run:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/postlfs/security/gpgme.xml:114
#, no-wrap, xml-text
msgid "<userinput>make -k check</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/security/gpgme.xml:117
#, xml-text
msgid "Now, as the &root; user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/postlfs/security/gpgme.xml:120
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr ""

