#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/postlfs/security/p11-kit.xml:92
#, xml-text
msgid "Installation of p11-kit"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/security/p11-kit.xml:106
#, xml-text
msgid "Prepare the distribution specific anchor hook:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/postlfs/security/p11-kit.xml:109
#, no-wrap, xml-text
msgid ""
"<userinput>sed '20,$ d' -i trust/trust-extract-compat &amp;&amp;\n"
"\n"
"cat &gt;&gt; trust/trust-extract-compat &lt;&lt; \"EOF\"\n"
"<literal># Copy existing anchor modifications to /etc/ssl/local\n"
"/usr/libexec/make-ca/copy-trust-modifications\n"
"\n"
"# Update trust stores\n"
"/usr/sbin/make-ca -r</literal>\n"
"EOF</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/security/p11-kit.xml:120
#, xml-text
msgid ""
"Install <application>p11-kit</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/postlfs/security/p11-kit.xml:124
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir p11-build &amp;&amp;\n"
"cd    p11-build &amp;&amp;\n"
"\n"
"meson setup ..            \\\n"
"      --prefix=/usr       \\\n"
"      --buildtype=release \\\n"
"      -D trust_paths=/etc/pki/anchors &amp;&amp;\n"
"ninja</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/security/p11-kit.xml:134
#, xml-text
msgid "To test the results, issue: <command>ninja test</command>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/security/p11-kit.xml:138
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/postlfs/security/p11-kit.xml:141
#, no-wrap, xml-text
msgid ""
"<userinput>ninja install &amp;&amp;\n"
"ln -sfv /usr/libexec/p11-kit/trust-extract-compat \\\n"
"        /usr/bin/update-ca-certificates</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/postlfs/security/p11-kit.xml:148
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/security/p11-kit.xml:154
#, xml-text
msgid ""
"<parameter>-D trust_paths=/etc/pki/anchors</parameter>: this switch sets the"
" location of trusted certificates used by libp11-kit.so."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/security/p11-kit.xml:159
#, xml-text
msgid ""
"<option>-D hash_impl=freebl</option>: Use this switch if you want to use the"
" Freebl library from <application>NSS</application> for SHA1 and MD5 "
"hashing."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/security/p11-kit.xml:165
#, xml-text
msgid ""
"<option>-D gtk_doc=true</option>: Use this switch if you have installed "
"<xref linkend=\"gtk-doc\"/> and <xref linkend=\"libxslt\"/> and wish to "
"rebuild the documentation and generate manual pages."
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/postlfs/security/p11-kit.xml:173
#, xml-text
msgid "Configuring p11-kit"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/postlfs/security/p11-kit.xml:176
#, xml-text
msgid ""
"The <application>p11-kit</application> trust module "
"(<filename>/usr/lib/pkcs11/p11-kit-trust.so</filename>) can be used as a "
"drop-in replacement for <filename>/usr/lib/libnssckbi.so</filename> to "
"transparently make the system CAs available to "
"<application>NSS</application> aware applications, rather than the static "
"list provided by <filename>/usr/lib/libnssckbi.so</filename>. As the "
"<systemitem class=\"username\">root</systemitem> user, execute the following"
" commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/postlfs/security/p11-kit.xml:186
#, no-wrap, xml-text
msgid ""
"<userinput>ln -sfv ./pkcs11/p11-kit-trust.so "
"/usr/lib/libnssckbi.so</userinput>"
msgstr ""

