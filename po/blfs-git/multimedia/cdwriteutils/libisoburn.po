#, xml-text
msgid "Introduction to libisoburn"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/cdwriteutils/libisoburn.xml:30
#, xml-text
msgid ""
"<application>libisoburn</application> is a frontend for the "
"<application>libburn</application> and <application>libisofs</application> "
"libraries, which enables creation and expansion of ISO-9660 filesystems on "
"all CD/DVD/BD media supported by <application>libburn</application>.  This "
"includes media like DVD+RW, which do not support multi-session management on"
" the media level, and even plain disk files or block devices."
msgstr ""

