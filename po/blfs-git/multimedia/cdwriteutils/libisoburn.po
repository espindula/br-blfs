#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/multimedia/cdwriteutils/libisoburn.xml:92
#, xml-text
msgid "Installation of libisoburn"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/cdwriteutils/libisoburn.xml:95
#, xml-text
msgid ""
"Install <application>libisoburn</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/multimedia/cdwriteutils/libisoburn.xml:99
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr              \\\n"
"            --disable-static           \\\n"
"            --enable-pkg-check-modules &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/cdwriteutils/libisoburn.xml:105
#, xml-text
msgid ""
"If you have installed <application>Doxygen</application> and wish to "
"generate the HTML documentation, issue the following command:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/multimedia/cdwriteutils/libisoburn.xml:109
#, no-wrap, xml-text
msgid "<userinput>doxygen doc/doxygen.conf</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/cdwriteutils/libisoburn.xml:112
#, xml-text
msgid "This package does not come with a test suite."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/cdwriteutils/libisoburn.xml:116
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/multimedia/cdwriteutils/libisoburn.xml:119
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/cdwriteutils/libisoburn.xml:122
#, xml-text
msgid ""
"If you have built the HTML documentation, install it by running the "
"following commands as the <systemitem class=\"username\">root</systemitem> "
"user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/multimedia/cdwriteutils/libisoburn.xml:128
#, no-wrap, xml-text
msgid ""
"<userinput>install -v -dm755 /usr/share/doc/libisoburn-&libisoburn-version; &amp;&amp;\n"
"install -v -m644 doc/html/* /usr/share/doc/libisoburn-&libisoburn-version;</userinput>"
msgstr ""

