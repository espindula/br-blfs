#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/multimedia/cdwriteutils/cdrtools.xml:83
#, xml-text
msgid "Installation of Cdrtools"
msgstr ""

#. type: Content of: <sect1><sect2><note><para>
#: blfs-en/blfs-git/multimedia/cdwriteutils/cdrtools.xml:87
#, xml-text
msgid "This package does not support parallel build."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/cdwriteutils/cdrtools.xml:92
#, xml-text
msgid ""
"Install <application>Cdrtools</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/multimedia/cdwriteutils/cdrtools.xml:96
#, no-wrap, xml-text
msgid ""
"<userinput>sed -i 's|/opt/schily|/usr|g'           DEFAULTS/Defaults.linux &amp;&amp;\n"
"sed -i 's|DEFINSGRP=.*|DEFINSGRP=root|' DEFAULTS/Defaults.linux &amp;&amp;\n"
"sed -i 's|INSDIR=\\s*sbin|INSDIR=bin|'   rscsi/Makefile          &amp;&amp;\n"
"\n"
"export GMAKE_NOWARN=true &amp;&amp;\n"
"export CFLAGS=\"$CFLAGS -std=gnu89 -fno-strict-aliasing\" &amp;&amp;\n"
"\n"
"make -j1 INS_BASE=/usr  \\\n"
"         DEFINSUSR=root \\\n"
"         DEFINSGRP=root \\\n"
"         VERSION_OS=\"LinuxFromScratch\"</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/cdwriteutils/cdrtools.xml:109
#, xml-text
msgid "This package does not come with a test suite."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/cdwriteutils/cdrtools.xml:113
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/multimedia/cdwriteutils/cdrtools.xml:116
#, no-wrap, xml-text
msgid ""
"<userinput>GMAKE_NOWARN=true &amp;&amp;\n"
"\n"
"make INS_BASE=/usr    \\\n"
"     DEFINSUSR=root   \\\n"
"     DEFINSGRP=root   \\\n"
"     MANSUFF_LIB=3cdr \\\n"
"     install          &amp;&amp;\n"
"\n"
"install -v -m755 -d /usr/share/doc/cdrtools-&cdrtools-version; &amp;&amp;\n"
"install -v -m644 README.* READMEs/* ABOUT doc/*.ps \\\n"
"                    /usr/share/doc/cdrtools-&cdrtools-version;</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/multimedia/cdwriteutils/cdrtools.xml:131
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/cdwriteutils/cdrtools.xml:134
#, xml-text
msgid ""
"<command>export GMAKE_NOWARN=true</command>: This variable avoids a warning "
"when using GNU make."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/cdwriteutils/cdrtools.xml:139
#, xml-text
msgid ""
"<parameter>INS_BASE=/usr</parameter>: This parameter moves the install "
"directory from <filename class=\"directory\">/opt/schily</filename> to "
"<filename class=\"directory\">/usr</filename>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/cdwriteutils/cdrtools.xml:145
#, xml-text
msgid ""
"<parameter>DEFINSUSR=root DEFINSGRP=root</parameter>: These parameters "
"install all programs with root:root ownership instead of the default "
"bin:bin."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/cdwriteutils/cdrtools.xml:151
#, xml-text
msgid ""
"<parameter>MANSUFF_LIB=3cdr</parameter>: This parameter prevents "
"<application>Cdrtools</application> from overwriting important pages which "
"are already installed by LFS. The installed man pages of section 3 will have"
" a suffix <literal>3cdr</literal> and can be shown using <command>man 3cdr "
"&lt;manpage&gt;</command>."
msgstr ""

