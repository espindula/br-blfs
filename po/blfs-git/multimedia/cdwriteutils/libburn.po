#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/multimedia/cdwriteutils/libburn.xml:80
#, xml-text
msgid "Installation of libburn"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/cdwriteutils/libburn.xml:83
#, xml-text
msgid "First, fix a problem when building with gcc-15:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/multimedia/cdwriteutils/libburn.xml:86
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"pre\">sed -i 's/catch_int ()/catch_int (int signum)/' "
"test/poll.c</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/cdwriteutils/libburn.xml:89
#, xml-text
msgid ""
"Install <application>libburn</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/multimedia/cdwriteutils/libburn.xml:93
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr --disable-static &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/cdwriteutils/libburn.xml:97
#, xml-text
msgid ""
"If you have installed <application>Doxygen</application> and wish to "
"generate the HTML documentation, issue the following command:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/multimedia/cdwriteutils/libburn.xml:101
#, no-wrap, xml-text
msgid "<userinput>doxygen doc/doxygen.conf</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/cdwriteutils/libburn.xml:104
#, xml-text
msgid "This package does not come with a test suite."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/cdwriteutils/libburn.xml:108
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/multimedia/cdwriteutils/libburn.xml:111
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/cdwriteutils/libburn.xml:114
#, xml-text
msgid ""
"If you have built the HTML documentation, install it by running the "
"following commands as the <systemitem class=\"username\">root</systemitem> "
"user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/multimedia/cdwriteutils/libburn.xml:119
#, no-wrap, xml-text
msgid ""
"<userinput>install -v -dm755 /usr/share/doc/libburn-&libburn-version; &amp;&amp;\n"
"install -v -m644 doc/html/* /usr/share/doc/libburn-&libburn-version;</userinput>"
msgstr ""

