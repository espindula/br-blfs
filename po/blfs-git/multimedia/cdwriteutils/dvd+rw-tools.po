#: blfs-en/blfs-git/multimedia/cdwriteutils/dvd+rw-tools.xml:94
#, xml-text
msgid "Installation of dvd+rw-tools"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/cdwriteutils/dvd+rw-tools.xml:97
#, xml-text
msgid ""
"First, apply a patch that fixes several bugs and fixes compiling with newer "
"versions of glibc and the kernel headers:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/multimedia/cdwriteutils/dvd+rw-tools.xml:101
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"pre\">patch -Np1 -i ../dvd+rw-tools-&dvd-rw-tools-"
"version;-consolidated_fixes-2.patch</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/cdwriteutils/dvd+rw-tools.xml:104
#, xml-text
msgid ""
"Install <application>dvd+rw-tools</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/multimedia/cdwriteutils/dvd+rw-tools.xml:108
#, no-wrap, xml-text
msgid "<userinput>make all rpl8 btcflash</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/cdwriteutils/dvd+rw-tools.xml:111
#, xml-text
msgid "This package does not come with a test suite."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/cdwriteutils/dvd+rw-tools.xml:115
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/multimedia/cdwriteutils/dvd+rw-tools.xml:118
#, no-wrap, xml-text
msgid ""
"<userinput>make prefix=/usr install &amp;&amp;\n"
"install -v -m644 -D index.html \\\n"
"    /usr/share/doc/dvd+rw-tools-&dvd-rw-tools-version;/index.html</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/multimedia/cdwriteutils/dvd+rw-tools.xml:124
#, xml-text
