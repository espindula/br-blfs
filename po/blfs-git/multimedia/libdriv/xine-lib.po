#. <xref linkend="libtheora"/>
#. ,
#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/xine-lib.xml:108
#, xml-text
msgid ""
"<xref linkend=\"aalib\"/>, <xref linkend=\"faad2\"/>, <xref "
"linkend=\"flac\"/>, <xref linkend=\"gdk-pixbuf\"/>, <xref linkend=\"glu\"/>,"
" <xref linkend=\"imagemagick\"/>, <xref linkend=\"liba52\"/>, <xref "
"linkend=\"libdvdcss\"/>, <xref linkend=\"libmad\"/>, <xref "
"linkend=\"libmng\"/>, <xref linkend=\"libnsl\"/>, <xref linkend=\"libva\"/> "
"(requires <xref role=\"nodep\" linkend=\"glu\"/>), <xref "
"linkend=\"libvorbis\"/>, <xref linkend=\"libvpx\"/>, <xref "
"linkend=\"mesa\"/>, <xref linkend=\"samba\"/>, <xref linkend=\"speex\"/>, "
"<xref linkend=\"doxygen\"/> (to create the API documentation), <xref "
"linkend=\"v4l-utils\"/> <ulink "
"url=\"https://pkgs.fedoraproject.org/repo/pkgs/directfb/\">DirectFB</ulink>,"
" <ulink "
"url=\"https://www.videolan.org/developers/libbluray.html\">libbluray</ulink>,"
" <ulink url=\"https://github.com/cacalabs/libcaca\">libcaca</ulink>, <ulink "
"url=\"https://www.videolan.org/developers/libdca.html\">libdca</ulink>, "
"<ulink url=\"https://fame.sourceforge.net\">libFAME</ulink>, <ulink "
"url=\"https://sourceforge.net/projects/modplug-xmms/\">libmodplug</ulink>, "
"<ulink url=\"https://www.theora.org\">libtheora</ulink>, <ulink "
"url=\"https://www.musepack.net/\">musepack</ulink>, <ulink "
"url=\"https://github.com/libsdl-org/sdl12-compat\">SDL1</ulink>, <ulink "
"url=\"&gnu-http;/vcdimager/\">VCDImager</ulink>, and <ulink "
"url=\"https://www.wavpack.com/\">WavPack</ulink>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/multimedia/libdriv/xine-lib.xml:144
#, xml-text
msgid "Installation of Xine Libraries"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/xine-lib.xml:147
#, xml-text
msgid "First, fix building this package with ffmpeg-7.0 and later:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/multimedia/libdriv/xine-lib.xml:150
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"pre\">patch -Np1 -i ../xine-lib-&xine-lib-"
"version;-upstream_fixes-1.patch</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/xine-lib.xml:153
#, xml-text
msgid "Next, fix building this package with gcc-15.x:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/multimedia/libdriv/xine-lib.xml:156
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"pre\">patch -Np1 -i ../xine-lib-&xine-lib-"
"version;-gcc15_fixes-1.patch</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/xine-lib.xml:159
#, xml-text
msgid "Next, fix building this package with ffmpeg-8:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/multimedia/libdriv/xine-lib.xml:162
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"pre\">patch -Np1 -i ../xine-lib-&xine-lib-"
"version;-ffmpeg8.patch</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/xine-lib.xml:165
#, xml-text
msgid ""
"Install <application>Xine Libraries</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/multimedia/libdriv/xine-lib.xml:169
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr          \\\n"
"            --disable-vcd          \\\n"
"            --with-external-dvdnav \\\n"
"            --docdir=/usr/share/doc/xine-lib-&xine-lib-version; &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/xine-lib.xml:176
#, xml-text
msgid ""
"To create the API documentation, <application>Doxygen</application> must be "
"installed and issue the following command:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/multimedia/libdriv/xine-lib.xml:180
#, no-wrap, xml-text
msgid "<userinput>doxygen doc/Doxyfile</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/xine-lib.xml:183
#, xml-text
msgid "This package does not come with a test suite."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/xine-lib.xml:187
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/multimedia/libdriv/xine-lib.xml:190
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><note><para>
#: blfs-en/blfs-git/multimedia/libdriv/xine-lib.xml:194
#, xml-text
msgid ""
"When installing, the Makefile does some additional linking.  If you do not "
"have Xorg in /usr, the LIBRARY_PATH variable needs to be defined for the "
"root user.  If using sudo to assume root, use the -E option to pass your "
"current environment variables for the install process."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/xine-lib.xml:203
#, xml-text
msgid ""
"If you built the API documentation, issue the following commands as the "
"<systemitem class=\"username\">root</systemitem> user to install it:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/multimedia/libdriv/xine-lib.xml:208
#, no-wrap, xml-text
msgid ""
"<userinput>install -v -m755 -d /usr/share/doc/xine-lib-&xine-lib-version;/api &amp;&amp;\n"
"install -v -m644    doc/api/* \\\n"
"                    /usr/share/doc/xine-lib-&xine-lib-version;/api</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/multimedia/libdriv/xine-lib.xml:214
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/xine-lib.xml:217
#, xml-text
msgid ""
"<parameter>--disable-vcd</parameter>: This switch is required to compile "
"<application>Xine Lib</application> without <ulink url=\"&gnu-"
"http;/vcdimager/\">VCDImager</ulink> installed.  Remove this option if you "
"have installed VCDImager."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/xine-lib.xml:224
#, xml-text
msgid ""
"<parameter>--with-external-dvdnav</parameter>: This switch is required, "
"because internal libraries cannot decrypt DVD."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/xine-lib.xml:229
#, xml-text
msgid ""
"<parameter>--docdir=/usr/share/doc/xine-lib-&xine-lib-version;</parameter>: "
"This switch causes the documentation to be installed into a versioned "
"directory instead of the default <filename "
"class=\"directory\">/usr/share/doc/xine-lib</filename>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/xine-lib.xml:236
#, xml-text
msgid ""
"<option>--disable-vaapi</option>: use this switch if <xref "
"linkend=\"libva\"/> is installed and <xref linkend=\"glu\"/> is not, to "
"prevent a build failure."
msgstr ""

