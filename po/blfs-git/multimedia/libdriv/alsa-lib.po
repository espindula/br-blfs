#: blfs-en/blfs-git/multimedia/libdriv/alsa-lib.xml:133
#, xml-text
msgid "ALSA"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/multimedia/libdriv/alsa-lib.xml:139
#, xml-text
msgid "Installation of ALSA Library"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/alsa-lib.xml:142
#, xml-text
msgid ""
"Install <application>ALSA Library</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/multimedia/libdriv/alsa-lib.xml:146
#, no-wrap, xml-text
msgid ""
"<userinput>./configure &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/alsa-lib.xml:150
#, xml-text
msgid ""
"If you have <application>Doxygen</application> installed and you wish to "
"build the library API documentation, run the following commands from the "
"top-level directory of the source tree:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/multimedia/libdriv/alsa-lib.xml:155
#, no-wrap, xml-text
msgid "<userinput>make doc</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/alsa-lib.xml:158
#, xml-text
msgid "To test the results, issue: <command>make check</command>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/alsa-lib.xml:162
#, xml-text
msgid ""
"Now, as the &root; user, install the package and recommended configuration "
"files:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/multimedia/libdriv/alsa-lib.xml:165
#, no-wrap, xml-text
msgid ""
"<userinput>make install &amp;&amp;\n"
"tar -C /usr/share/alsa --strip-components=1 -xf ../alsa-ucm-conf-&alsa-lib-version;.tar.bz2</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/alsa-lib.xml:179
#, xml-text
msgid ""
"To install the API documentation, run the following command as the "
"<systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/multimedia/libdriv/alsa-lib.xml:184
#, no-wrap, xml-text
msgid ""
"<userinput>install -v -d -m755 /usr/share/doc/alsa-lib-&alsa-lib-version;/html/search &amp;&amp;\n"
"install -v -m644 doc/doxygen/html/*.* \\\n"
"                /usr/share/doc/alsa-lib-&alsa-lib-version;/html &amp;&amp;\n"
"install -v -m644 doc/doxygen/html/search/* \\\n"
"                /usr/share/doc/alsa-lib-&alsa-lib-version;/html/search</userinput>"
msgstr ""

