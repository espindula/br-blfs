#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/multimedia/libdriv/gst10-plugins-bad.xml:200
#, xml-text
msgid "Installation of GStreamer Bad Plug-ins"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/gst10-plugins-bad.xml:215
#, xml-text
msgid ""
"Install <application>GStreamer Bad Plug-ins</application> by running the "
"following commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/multimedia/libdriv/gst10-plugins-bad.xml:219
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup ..            \\\n"
"      --prefix=/usr       \\\n"
"      --buildtype=release \\\n"
"      -D gpl=enabled      &amp;&amp;\n"
"ninja</userinput>"
msgstr ""

#.  One test,
#.       <emphasis>
#. elements_dash_mpd</emphasis>, is known to fail.
#.  Upstream issue is
#. https://gitlab.freedesktop.org/gstreamer/gstreamer/-/issues/3124
#.  Upstream issue gst-plugins-bad/#1426
#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/gst10-plugins-bad.xml:229
#, xml-text
msgid ""
"To test the results, issue: <command>ninja test</command>. Several tests "
"need a terminal emulator in a graphical session.  If <xref "
"linkend='gst10-plugins-good'/> is not installed, two tests, "
"<emphasis>elements_rtpsrc</emphasis> and "
"<emphasis>elements_rtpsink</emphasis>, will fail."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/gst10-plugins-bad.xml:241
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/multimedia/libdriv/gst10-plugins-bad.xml:244
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr ""

