#: blfs-en/blfs-git/multimedia/libdriv/pulseaudio.xml:233
#, xml-text
msgid "/etc/pulse/daemon.conf"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><indexterm><primary>
#: blfs-en/blfs-git/multimedia/libdriv/pulseaudio.xml:238
#, xml-text
msgid "/etc/pulse/client.conf"
msgstr ""

