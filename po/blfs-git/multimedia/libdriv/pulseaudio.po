#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/multimedia/libdriv/pulseaudio.xml:119
#, xml-text
msgid "Installation of PulseAudio"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/pulseaudio.xml:129
#, xml-text
msgid ""
"Install <application>PulseAudio</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/multimedia/libdriv/pulseaudio.xml:133
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr       \\\n"
"            --buildtype=release \\\n"
"            -D database=gdbm    \\\n"
"            -D doxygen=false    \\\n"
"            -D bluez5=disabled  \\\n"
"            -D tests=false      \\\n"
"            ..                  &amp;&amp;\n"
"ninja</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/pulseaudio.xml:146
#, xml-text
msgid ""
"To test the results, issue: <command>ninja test</command>.  Only the shipped"
" XML files are validated because other tests need "
"<application>Check</application> that we've removed from LFS."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/pulseaudio.xml:152
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/multimedia/libdriv/pulseaudio.xml:155
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/pulseaudio.xml:158
#, xml-text
msgid ""
"Running PulseAudio as a system-wide daemon is possible but not recommended. "
"See <ulink "
"url=\"https://www.freedesktop.org/wiki/Software/PulseAudio/Documentation/User/SystemWide/\"/>"
" for more information.  While still as the <systemitem "
"class=\"username\">root</systemitem> user, remove the "
"<application>D-Bus</application> configuration file for the system wide "
"daemon to avoid creating unnecessary system users and groups:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/multimedia/libdriv/pulseaudio.xml:168
#, no-wrap, xml-text
msgid ""
"<userinput>rm /usr/share/dbus-1/system.d/pulseaudio-system.conf</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><note><para>
#: blfs-en/blfs-git/multimedia/libdriv/pulseaudio.xml:172
#, xml-text
msgid ""
"If you have installed <xref linkend=\"wireplumber\"/>, make sure to follow "
"the commands to disable the Pulseaudio server to prevent conflicts with "
"Pipewire."
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/multimedia/libdriv/pulseaudio.xml:180
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/pulseaudio.xml:186
#, xml-text
msgid ""
"<parameter>-D bluez5=disabled</parameter>: This switch prevents a runtime "
"error if <xref linkend=\"dbus\"/> and <xref linkend=\"sbc\"/> are both "
"installed but <xref linkend=\"bluez\"/> is not installed.  Remove this if "
"you have installed all three packages."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/pulseaudio.xml:193
#, xml-text
msgid ""
"<parameter>-D doxygen=false</parameter>: This allows the package to compile "
"if <xref linkend=\"doxygen\"/> is not installed. Remove this if you have "
"installed this and wish to build the documentation."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/pulseaudio.xml:199
#, xml-text
msgid ""
"<parameter>-D tests=false</parameter>: This allows the package to compile if"
" <application>Check</application> is not installed.  We've removed "
"<application>Check</application> from LFS."
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/multimedia/libdriv/pulseaudio.xml:213
#, xml-text
msgid "Configuring PulseAudio"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><title>
#: blfs-en/blfs-git/multimedia/libdriv/pulseaudio.xml:216
#, xml-text
msgid "Config Files"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/blfs-git/multimedia/libdriv/pulseaudio.xml:218
#, xml-text
msgid ""
"There are system wide configuration files: "
"<filename>/etc/pulse/daemon.conf</filename>, "
"<filename>/etc/pulse/client.conf</filename>, "
"<filename>/etc/pulse/default.pa</filename>, and user configuration files "
"with the same names in <filename "
"class=\"directory\">~/.config/pulse</filename>. User configuration files "
"take precedence over system wide ones."
msgstr ""

#. type: Content of: <sect1><sect2><sect3><indexterm><primary>
#: blfs-en/blfs-git/multimedia/libdriv/pulseaudio.xml:228
#, xml-text
msgid "~/.config/pulse"
