#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/multimedia/libdriv/libvpx.xml:89
#, xml-text
msgid "Installation of libvpx"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/libvpx.xml:94
#, xml-text
msgid ""
"If upgrading from a previous version of libvpx, update the timestamps of all"
" the files to prevent the build system from retaining the files from the old"
" installation:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/multimedia/libdriv/libvpx.xml:99
#, no-wrap, xml-text
msgid "<userinput>find -type f | xargs touch</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/libvpx.xml:102
#, xml-text
msgid ""
"Install <application>libvpx</application> by running the following commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/multimedia/libdriv/libvpx.xml:106
#, no-wrap, xml-text
msgid ""
"<userinput>sed -i 's/cp -p/cp/' build/make/Makefile &amp;&amp;\n"
"\n"
"mkdir libvpx-build            &amp;&amp;\n"
"cd    libvpx-build            &amp;&amp;\n"
"\n"
"../configure --prefix=/usr    \\\n"
"             --enable-shared  \\\n"
"             --disable-static &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/libvpx.xml:117
#, xml-text
msgid ""
"To test the results, issue: <command>LD_LIBRARY_PATH=. make test</command>."
"  The test suite downloads many files as part of its test process.  A few "
"parts of it will use all available cores."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/libvpx.xml:124
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/multimedia/libdriv/libvpx.xml:127
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/multimedia/libdriv/libvpx.xml:132
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/libvpx.xml:135
#, xml-text
msgid ""
"<command>sed ... </command>: This command corrects the ownership and "
"permissions of installed files."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/libvpx.xml:140
#, xml-text
msgid ""
"<command>mkdir libvpx-build &amp;&amp; cd libvpx-build</command>: The "
"<application>libvpx</application> developers recommend building in a "
"dedicated build directory."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/libvpx.xml:149
#, xml-text
msgid ""
"<option>--disable-vp8</option>: This switch prevents building support for "
"the VP8 codec."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/libvpx.xml:154
#, xml-text
msgid ""
"<option>--disable-vp9</option>: This switch prevents building support for "
"the VP9 codec."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/libvpx.xml:159
#, xml-text
msgid ""
"<option>--target=generic-gnu</option>: This switch disables optimizations "
"specific to x86 and x86-64, allowing to build this package without "
"<command>nasm</command> and <command>yasm</command> installed."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/libvpx.xml:166
#, xml-text
msgid ""
"<command>LD_LIBRARY_PATH=.</command>: This is needed for the test suite to "
"use the library that was just built."
msgstr ""

