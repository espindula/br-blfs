#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/multimedia/libdriv/libmusicbrainz5.xml:96
#, xml-text
msgid "Installation of libmusicbrainz"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/libmusicbrainz5.xml:107
#, xml-text
msgid "First, fix a problem caused by CMake-3.18.0 and later:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/multimedia/libdriv/libmusicbrainz5.xml:110
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"pre\">patch -Np1 -i "
"../libmusicbrainz-&libmusicbrainz5-version;-cmake_fixes-1.patch</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/libmusicbrainz5.xml:113
#, xml-text
msgid "Fix also a problem caused by libxml-2.12.x:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/multimedia/libdriv/libmusicbrainz5.xml:116
#, no-wrap, xml-text
msgid ""
"<userinput>sed -e 's/xmlErrorPtr /const xmlError */'     \\\n"
"    -i src/xmlParser.cc</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/libmusicbrainz5.xml:120
#, xml-text
msgid ""
"Install <application>libmusicbrainz</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/multimedia/libdriv/libmusicbrainz5.xml:124
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr \\\n"
"      -D CMAKE_BUILD_TYPE=Release  \\\n"
"      -D CMAKE_POLICY_VERSION_MINIMUM=3.5 .. &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/libmusicbrainz5.xml:133
#, xml-text
msgid ""
"If you have installed <xref linkend=\"doxygen\"/>, optionally build the API "
"documentation:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/multimedia/libdriv/libmusicbrainz5.xml:137
#, no-wrap, xml-text
msgid "<userinput>doxygen ../Doxyfile</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/libmusicbrainz5.xml:140
#, xml-text
msgid "This package does not come with a test suite."
