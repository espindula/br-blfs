#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/multimedia/libdriv/gavl.xml:89
#, xml-text
msgid "Installation of Gavl"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/gavl.xml:92
#, xml-text
msgid "First, fix an issue with gcc-14 and later:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/multimedia/libdriv/gavl.xml:95
#, no-wrap, xml-text
msgid ""
"<userinput>sed -i \"/stdio/a #include &lt;string.h&gt;\" "
"src/fill_test.c</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/gavl.xml:98
#, xml-text
msgid ""
"Now, install <application>Gavl</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/multimedia/libdriv/gavl.xml:102
#, no-wrap, xml-text
msgid ""
"<userinput>LIBS=-lm                         \\\n"
"./configure --prefix=/usr        \\\n"
"            --without-doxygen    \\\n"
"            --with-cpuflags=none \\\n"
"            --docdir=/usr/share/doc/gavl-&gavl-version; &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/gavl.xml:110
#, xml-text
msgid "This package does not come with a test suite."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/gavl.xml:114
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/multimedia/libdriv/gavl.xml:117
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/multimedia/libdriv/gavl.xml:122
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/gavl.xml:125
#, xml-text
msgid ""
"<envar>LIBS=-lm</envar>: This variable ensures the math library is searched "
"when linking."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/gavl.xml:130
#, xml-text
msgid ""
"<parameter>--without-doxygen</parameter>: This switch disables use of "
"Doxygen. Omit if Doxygen is installed and you wish to build the API "
"documentation."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/gavl.xml:136
#, xml-text
msgid ""
"<parameter>--with-cpuflags=none</parameter>: This switch fixes a problem "
"identifying capabilities of the system architecture."
msgstr ""

