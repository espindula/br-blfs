#, xml-text
msgid "Installation of Speex"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/speex.xml:141
#, xml-text
msgid ""
"This package consists of two separate tarballs.  They need to be extracted "
"and built independently."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/speex.xml:146
#, xml-text
msgid ""
"Install <application>Speex</application> by running the following commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/multimedia/libdriv/speex.xml:150
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr    \\\n"
"            --disable-static \\\n"
"            --docdir=/usr/share/doc/speex-&speex-version; &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/speex.xml:156
#, xml-text
msgid "This package does not come with a test suite."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/speex.xml:160
#, xml-text
msgid "As the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/multimedia/libdriv/speex.xml:163
#: blfs-en/blfs-git/multimedia/libdriv/speex.xml:182
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/speex.xml:166
#, xml-text
msgid "Now extract and install the speexdsp package:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/multimedia/libdriv/speex.xml:169
#, no-wrap, xml-text
msgid ""
"<userinput>cd ..                          &amp;&amp;\n"
"tar -xf speexdsp-&speexdsp-version;.tar.gz &amp;&amp;\n"
"cd speexdsp-&speexdsp-version;             &amp;&amp;\n"
"\n"
"./configure --prefix=/usr    \\\n"
"            --disable-static \\\n"
"            --docdir=/usr/share/doc/speexdsp-&speexdsp-version; &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
