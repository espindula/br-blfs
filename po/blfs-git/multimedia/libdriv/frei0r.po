#: blfs-en/blfs-git/multimedia/libdriv/frei0r.xml:95
#, xml-text
msgid "Installation of frei0r"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/frei0r.xml:98
#, xml-text
msgid ""
"Install <application>Frei0r</application> by running the following commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/multimedia/libdriv/frei0r.xml:102
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir -vp build &amp;&amp;\n"
"cd        build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr \\\n"
"      -D CMAKE_BUILD_TYPE=Release  \\\n"
"      -W no-dev .. &amp;&amp;\n"
"\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/frei0r.xml:112
#, xml-text
msgid "This package does not come with a test suite."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/frei0r.xml:116
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/multimedia/libdriv/frei0r.xml:119
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr ""

