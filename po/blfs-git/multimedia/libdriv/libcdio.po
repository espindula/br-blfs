#. _cdio_generic.c:63:20: error: implicit declaration of function ‘lseek64’
#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/libcdio.xml:97
#, xml-text
msgid ""
"If you are building on an i686 system, fix a build issue caused by large "
"file support:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/multimedia/libdriv/libcdio.xml:102
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"pre\">case $(uname -m) in\n"
"   i?86)\n"
"      sed '/CDIO_LSEEK/s/lseek64/lseek/'  -i lib/driver/_cdio_generic.c &amp;&amp;\n"
"      sed '/CDIO_FSEEK/s/fseeko64/fseek/' -i lib/driver/_cdio_stdio.c   ;;\n"
"esac</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/libcdio.xml:109
#, xml-text
msgid ""
"Install <application>libcdio</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/multimedia/libdriv/libcdio.xml:113
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr --disable-static &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/libcdio.xml:117
#, xml-text
msgid ""
"To test the results, issue: <command>make check -k</command>.  One test "
"named <filename>realpath</filename> is known to fail."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/libcdio.xml:122
#: blfs-en/blfs-git/multimedia/libdriv/libcdio.xml:142
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/multimedia/libdriv/libcdio.xml:125
#: blfs-en/blfs-git/multimedia/libdriv/libcdio.xml:145
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/libcdio.xml:128
#, xml-text
msgid "Now install libcdio-paranoia:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/multimedia/libdriv/libcdio.xml:131
#, no-wrap, xml-text
msgid ""
"<userinput>tar -xf ../&libcdio-paranoia;.tar.bz2 &amp;&amp;\n"
"cd &libcdio-paranoia; &amp;&amp;\n"
"\n"
"./configure --prefix=/usr --disable-static &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/libcdio.xml:138
#, xml-text
msgid "To test the results, issue: <command>make check</command>."
msgstr ""

