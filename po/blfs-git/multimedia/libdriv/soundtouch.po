#. type: Content of: <sect1><sect2><note><para>
#: blfs-en/blfs-git/multimedia/libdriv/soundtouch.xml:76
#, xml-text
msgid ""
"The tarball expands to 'soundtouch' instead of the expected "
"'soundtouch-&soundtouch-version;'"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/soundtouch.xml:81
#, xml-text
msgid ""
"Install <application>SoundTouch</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><caution><para>
#: blfs-en/blfs-git/multimedia/libdriv/soundtouch.xml:87
#, xml-text
msgid ""
"The <command>bootstrap</command> command below fails if the ACLOCAL "
"environment variable is set as specified in <xref linkend=\"xorg7\"/>.  If "
"it is used, ACLOCAL needs to be unset for this package and then reset for "
"other packages."
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/multimedia/libdriv/soundtouch.xml:94
#, no-wrap, xml-text
msgid ""
"<userinput>./bootstrap &amp;&amp;\n"
"./configure --prefix=/usr \\\n"
"            --docdir=/usr/share/doc/soundtouch-&soundtouch-version; &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/soundtouch.xml:100
#, xml-text
msgid "This package does not come with a test suite."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/soundtouch.xml:104
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/multimedia/libdriv/soundtouch.xml:107
#, no-wrap, xml-text
msgid "<userinput>make install </userinput>"
msgstr ""

