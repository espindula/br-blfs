#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/multimedia/libdriv/x265.xml:89
#, xml-text
msgid "Installation of x265"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/x265.xml:92
#, xml-text
msgid ""
"First, remove some CMake policy settings that are no longer compatible with "
"CMake-4.0 and later:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/multimedia/libdriv/x265.xml:96
#, no-wrap, xml-text
msgid ""
"<userinput>sed -r '/cmake_policy.*(0025|0054)/d' -i "
"source/CMakeLists.txt</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/x265.xml:99
#, xml-text
msgid ""
"Install <application>x265</application> by running the following commands:"
msgstr ""

#.  the default build is Release, no need to specify that
#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/multimedia/libdriv/x265.xml:104
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir bld &amp;&amp;\n"
"cd    bld &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr        \\\n"
"      -D GIT_ARCHETYPE=1                  \\\n"
"      -D CMAKE_POLICY_VERSION_MINIMUM=3.5 \\\n"
"      -W no-dev                           \\\n"
"      ../source                           &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/x265.xml:115
#, xml-text
msgid "This package does not come with a test suite."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/x265.xml:143
#, xml-text
msgid ""
"To install the package, first remove any old library versions.  After "
"installation, remove a static library.  As the &root; user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/multimedia/libdriv/x265.xml:148
#, no-wrap, xml-text
msgid ""
"<userinput>make install &amp;&amp;\n"
"rm -vf /usr/lib/libx265.a</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/multimedia/libdriv/x265.xml:154
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/x265.xml:157
#, xml-text
msgid ""
"<parameter>-D GIT_ARCHETYPE=1</parameter>: This switch is needed because the"
" build system will not generate a pkg-config file or install a shared "
"library unless <xref linkend=\"git\"/> is installed. Git isn't required for "
"anything else in this package, so this switch is used to work around it for "
"users who do not want to install Git as a build dependency."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/x265.xml:169
#, xml-text
msgid ""
"<parameter>-W no-dev</parameter>: This switch is used to suppress warnings "
"intended for the package developers."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/x265.xml:174
#, xml-text
msgid ""
"<command>rm -vf /usr/lib/libx265.a</command>: BLFS does not recommend using "
"static libraries."
msgstr ""

