#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/multimedia/libdriv/libcddb.xml:75
#, xml-text
msgid "Installation of libcddb"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/libcddb.xml:78
#, xml-text
msgid ""
"By default this package accesses <systemitem "
"class='domainname'>freedb.org</systemitem>, which is already closed.  Modify"
" the default to use <systemitem "
"class='domainname'>gnudb.gnudb.org</systemitem> instead, and fix two stale "
"test data files:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/multimedia/libdriv/libcddb.xml:85
#, no-wrap, xml-text
msgid ""
"<userinput>sed -e '/DEFAULT_SERVER/s/freedb.org/gnudb.gnudb.org/' \\\n"
"    -e '/DEFAULT_PORT/s/888/&amp;0/'                       \\\n"
"    -i include/cddb/cddb_ni.h                          &amp;&amp;\n"
"sed '/^Genre:/s/Trip-Hop/Electronic/' -i tests/testdata/920ef00b.txt &amp;&amp;\n"
"sed '/DISCID/i# Revision: 42'         -i tests/testcache/misc/12340000</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/libcddb.xml:92
#, xml-text
msgid "Fix a problem building with gcc-14 and later:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/multimedia/libdriv/libcddb.xml:95
#, no-wrap, xml-text
msgid ""
"<userinput>sed -i 's/size_t l;/socklen_t l;/' lib/cddb_net.c</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/libcddb.xml:98
#, xml-text
msgid ""
"Install <application>libcddb</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/multimedia/libdriv/libcddb.xml:102
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr --disable-static &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/libcddb.xml:106
#, xml-text
msgid ""
"To test the results, issue: <command>make check -k</command>.  The test "
"suite needs the Internet connection.  One test fails due to missing test "
"server."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/libcddb.xml:112
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/multimedia/libdriv/libcddb.xml:115
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr ""

