#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/multimedia/libdriv/alsa-utils.xml:107
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --disable-alsaconf \\\n"
"            --disable-bat      \\\n"
"            --disable-xmlto    \\\n"
"            --with-curses=ncursesw &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/alsa-utils.xml:114
#, xml-text
msgid "To test the results, issue: <command>make check</command>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/alsa-utils.xml:118
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/multimedia/libdriv/alsa-utils.xml:121
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/multimedia/libdriv/alsa-utils.xml:126
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/alsa-utils.xml:129
#, xml-text
msgid ""
"<parameter>--disable-alsaconf</parameter>: This switch disables building the"
" <command>alsaconf</command> configuration tool which is incompatible with "
"<application>Udev</application>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/alsa-utils.xml:135
#, xml-text
msgid ""
"<parameter>--disable-xmlto</parameter>: Omit this switch if you have "
"installed <xref linkend=\"xmlto\"/> and wish to regenerate the man pages."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/alsa-utils.xml:140
#, xml-text
msgid ""
"<parameter>--disable-bat</parameter>: Omit this switch if you have installed"
" <xref linkend=\"fftw\"/> and wish to install the Basic Audio Tester (BAT)."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/alsa-utils.xml:146
#, xml-text
msgid ""
"<parameter>--with-curses=ncursesw</parameter>: This switch forces the use of"
" wide-character ncurses libraries."
msgstr ""

