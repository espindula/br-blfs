#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/multimedia/libdriv/alsa-tools.xml:93
#, xml-text
msgid "Installation of ALSA Tools"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/alsa-tools.xml:98
#, xml-text
msgid "First, start a subshell that will exit on error:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/multimedia/libdriv/alsa-tools.xml:101
#, no-wrap, xml-text
msgid "<userinput>bash -e</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/alsa-tools.xml:104
#, xml-text
msgid ""
"Now, remove some tools that need <application>Qt2 or 3</application> or "
"&gtk2;, and also two unneeded files (for the BLFS instructions below):"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/multimedia/libdriv/alsa-tools.xml:108
#, no-wrap, xml-text
msgid ""
"<userinput>rm -rf qlo10k1 echomixer rmedigicontrol Makefile "
"gitcompile</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/alsa-tools.xml:111
#, xml-text
msgid ""
"The <application>ALSA Tools</application> package is only needed by those "
"with advanced requirements for their sound card. The tools can be built all "
"together at once, but if only a subset is needed, you need to "
"<command>cd</command> into the directory of each tool you wish to compile "
"and run the commands. Here, we present instructions to build all tools."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/alsa-tools.xml:119
#, xml-text
msgid ""
"Install all <application>ALSA Tools</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/multimedia/libdriv/alsa-tools.xml:123
#, no-wrap, xml-text
msgid ""
"<userinput>for tool in *\n"
"do\n"
"  case $tool in\n"
"    seq )\n"
"      tool_dir=seq/sbiload\n"
"    ;;\n"
"    * )\n"
"      tool_dir=$tool\n"
"    ;;\n"
"  esac\n"
"\n"
"  pushd $tool_dir\n"
"    ./configure --prefix=/usr\n"
"    make\n"
"    as_root make install\n"
"    as_root /sbin/ldconfig\n"
"  popd\n"
"\n"
"done\n"
"unset tool tool_dir</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/alsa-tools.xml:145
#, xml-text
msgid "Finally, exit the shell that was started earlier:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/multimedia/libdriv/alsa-tools.xml:148
#, no-wrap, xml-text
msgid "<userinput>exit</userinput>"
msgstr ""

