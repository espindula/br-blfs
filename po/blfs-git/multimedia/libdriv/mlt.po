#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/multimedia/libdriv/mlt.xml:106
#, xml-text
msgid "Installation of MLT"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/mlt.xml:109
#, xml-text
msgid ""
"Install <application>MLT</application> by running the following commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/multimedia/libdriv/mlt.xml:112
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr \\\n"
"      -D CMAKE_BUILD_TYPE=Release  \\\n"
"      -D MOD_SOX=OFF               \\\n"
"      -D MOD_MOVIT=OFF             \\\n"
"      -D MOD_VIDSTAB=OFF           \\\n"
"      -D MOD_JACKRACK=OFF          \\\n"
"      -D MOD_RUBBERBAND=OFF        \\\n"
"      -W no-dev .. &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/mlt.xml:126
#, xml-text
msgid ""
"This package does not come with a test suite. However a test .mp4 file can "
"be played in a local graphical environment with <command>./out/bin/melt "
"&lt;filename&gt;.mp4</command>."
msgstr ""

#. type: Content of: <sect1><sect2><note><para>
#: blfs-en/blfs-git/multimedia/libdriv/mlt.xml:133
#, xml-text
msgid ""
"This application uses advanced graphical capabilities.  In some cases, "
"firmware for your specific graphics adaptor may be needed.  See <xref "
"linkend=\"video-firmware\"/> for more information."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/mlt.xml:140
#, xml-text
msgid "Now, as the &root; user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/multimedia/libdriv/mlt.xml:143
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr ""

