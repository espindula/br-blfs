#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/multimedia/libdriv/libplacebo.xml:94
#, xml-text
msgid "Installation of libplacebo"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/libplacebo.xml:99
#, xml-text
msgid "First, fix an incompatibility with Python-3.13.6 and later:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/multimedia/libdriv/libplacebo.xml:102
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"pre\">sed -e '204a\\    tree = ET.parse(xmlfile)'                 \\\n"
"    -e 's/VkXML(ET.parse(xmlfile))/VkXML(tree.getroot())/' \\\n"
"    -i src/vulkan/utils_gen.py</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/libplacebo.xml:107
#, xml-text
msgid ""
"Install <application>libplacebo</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/multimedia/libdriv/libplacebo.xml:111
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup ..            \\\n"
"      --prefix=/usr       \\\n"
"      --buildtype=release \\\n"
"      -D tests=true       \\\n"
"      -D demos=false      &amp;&amp;\n"
"ninja</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/libplacebo.xml:122
#, xml-text
msgid ""
"To test the results, issue: <command>ninja test</command>.  One test, "
"opengl_surfaceless.c, is known to fail."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/libplacebo.xml:127
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/multimedia/libdriv/libplacebo.xml:130
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/multimedia/libdriv/libplacebo.xml:135
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/libplacebo.xml:141
#, xml-text
msgid ""
"<parameter>-D demos=false</parameter>: This switch disables building the "
"demo programs because building <application>plplay</application> is "
"currently broken."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/libplacebo.xml:147
#, xml-text
msgid ""
"<parameter>-D tests=true</parameter>: This switch enables building the code "
"necessary to run the tests."
msgstr ""

