#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/multimedia/libdriv/sdl3.xml:100
#, xml-text
msgid "Installation of SDL3"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/sdl3.xml:103
#, xml-text
msgid ""
"Install <application>SDL3</application> by running the following commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/multimedia/libdriv/sdl3.xml:107
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr \\\n"
"      -D CMAKE_BUILD_TYPE=Release  \\\n"
"      -D SDL_TEST_LIBRARY=OFF      \\\n"
"      -D SDL_STATIC=OFF            \\\n"
"      -D SDL_RPATH=OFF             \\\n"
"      -W no-dev -G Ninja ..       &amp;&amp;\n"
"\n"
"ninja</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/sdl3.xml:120
#, xml-text
msgid "Now, as the &root; user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/multimedia/libdriv/sdl3.xml:123
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/multimedia/libdriv/sdl3.xml:128
#, xml-text
msgid "Testing SDL3"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/sdl3.xml:131
#, xml-text
msgid "If you want to build the tests, issue the following commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/multimedia/libdriv/sdl3.xml:134
#, no-wrap, xml-text
msgid ""
"<literal>mkdir ../build-tests &amp;&amp;\n"
"cd    ../build-tests &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr \\\n"
"      -D CMAKE_BUILD_TYPE=Release  \\\n"
"      -D SDL_STATIC=OFF            \\\n"
"      -D SDL_RPATH=OFF             \\\n"
"      -D SDL_TESTS=ON              \\\n"
"      -D SDL_INSTALL_TESTS=ON      \\\n"
"      -W no-dev -G Ninja ..       &amp;&amp;\n"
"\n"
"ninja &amp;&amp;\n"
"DESTDIR=$PWD/TESTS ninja install</literal>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/sdl3.xml:149
#, xml-text
msgid ""
"Now you will be able to run the tests in <filename "
"class=\"directory\">TESTS/usr/libexec/installed-tests/SDL3</filename>. You "
"will have to run the tests individually. Some of them may need to be "
"manually killed and audio will need to be working so that you can hear from "
"the default audio output."
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/multimedia/libdriv/sdl3.xml:159
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/sdl3.xml:162
#, xml-text
msgid ""
"<parameter>-D SDL_TEST_LIBRARY=OFF</parameter>: This parameter disables "
"building an unnecessary static library meant for the tests. It gets built in"
" the testing section."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/sdl3.xml:168
#, xml-text
msgid ""
"<parameter>-D SDL_STATIC=OFF</parameter>: This parameter disables building "
"static libraries."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/sdl3.xml:173
#, xml-text
msgid ""
"<parameter>-D SDL_RPATH=OFF</parameter>: This parameter disables installing "
"with rpath. It can cause security issues otherwise."
msgstr ""

