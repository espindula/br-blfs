#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/multimedia/libdriv/faac.xml:26
#, xml-text
msgid "Introduction to faac"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/faac.xml:29
#, xml-text
msgid ""
"The <application>faac</application> application is an encoder for a lossy "
"sound compression scheme specified in MPEG-2 Part 7 and MPEG-4 Part 3 "
"standards and known as Advanced Audio Coding (AAC). This encoder is useful "
"for producing files that can be played back on an iPod. Moreover, the iPod "
"does not understand other sound compression schemes used in video files."
msgstr ""

