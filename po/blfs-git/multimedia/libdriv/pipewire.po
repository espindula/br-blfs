#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/multimedia/libdriv/pipewire.xml:133
#, xml-text
msgid "Installation of Pipewire"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/pipewire.xml:136
#, xml-text
msgid ""
"Install <application>pipewire</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/multimedia/libdriv/pipewire.xml:140
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup ..                 \\\n"
"      --prefix=/usr            \\\n"
"      --buildtype=release      \\\n"
"      -D session-managers=\"[]\" &amp;&amp;\n"
"ninja</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/pipewire.xml:150
#, xml-text
msgid "To test the result, issue: <command>ninja test</command>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/pipewire.xml:162
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/multimedia/libdriv/pipewire.xml:165
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/multimedia/libdriv/pipewire.xml:169
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/pipewire.xml:175
#, xml-text
msgid ""
"<parameter>-D session-managers=\"[]\"</parameter>: This switch allows "
"specifying the session managers to build as subprojects.  We specify an "
"empty list to prevent <command>meson</command> from downloading any external"
" copy of the session managers. A Pipewire session manager recommended by the"
" PipeWire developers for general use, <xref linkend=\"wireplumber\" "
"role=\"nodep\"/>, is available as a separate BLFS package.  Build it after "
"installing Pipewire if you need to run the Pipewire daemon (for example in "
"order to support <xref linkend=\"snapshot\" role=\"nodep\"/>)."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/pipewire.xml:187
#, xml-text
msgid ""
"<option>-D docs=true</option>: This switch enables the generation of HTML "
"documentation. The optional dependencies for documentation need to be "
"installed for this to work."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/pipewire.xml:193
#, xml-text
msgid ""
"<option>-D man=true</option>: This switch enables the generation of manual "
"pages. The optional dependencies for documentation need to be installed for "
"this to work."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/pipewire.xml:199
#, xml-text
msgid ""
"<option>-D ffmpeg=enabled</option>: This switch enables using ffmpeg for "
"audio conversion as a SPA backend."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/pipewire.xml:204
#, xml-text
msgid ""
"<option>-D vulkan=enabled</option>: This switch enables using Vulkan for "
"video rendering as a SPA backend."
msgstr ""

