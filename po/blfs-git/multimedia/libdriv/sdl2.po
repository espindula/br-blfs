#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/multimedia/libdriv/sdl2.xml:79
#, xml-text
msgid "Installation of sdl2-compat"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/sdl2.xml:82
#, xml-text
msgid ""
"Install <application>sdl2-compat</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/multimedia/libdriv/sdl2.xml:86
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr   \\\n"
"      -D CMAKE_BUILD_TYPE=Release    \\\n"
"      -D CMAKE_SKIP_INSTALL_RPATH=ON \\\n"
"      -D SDL2COMPAT_STATIC=OFF       \\\n"
"      -D SDL2COMPAT_TESTS=OFF        \\\n"
"      -W no-dev -G Ninja ..         &amp;&amp;\n"
"\n"
"ninja</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/sdl2.xml:99
#, xml-text
msgid "Now, as the &root; user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/multimedia/libdriv/sdl2.xml:102
#, no-wrap, xml-text
msgid ""
"<userinput>ninja install &amp;&amp;\n"
"rm -vf /usr/lib/libSDL2_test.a</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/multimedia/libdriv/sdl2.xml:108
#, xml-text
msgid "Testing sdl2-compat"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/sdl2.xml:111
#, xml-text
msgid "If you want to build the tests, issue the following commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/multimedia/libdriv/sdl2.xml:114
#, no-wrap, xml-text
msgid ""
"<literal>mkdir ../build-tests &amp;&amp;\n"
"cd    ../build-tests &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr   \\\n"
"      -D CMAKE_BUILD_TYPE=Release    \\\n"
"      -D CMAKE_SKIP_INSTALL_RPATH=ON \\\n"
"      -D SDL2COMPAT_INSTALL_TESTS=ON \\\n"
"      -D SDL2COMPAT_STATIC=OFF       \\\n"
"      -D SDL2COMPAT_TESTS=ON         \\\n"
"      -W no-dev -G Ninja ..         &amp;&amp;\n"
"\n"
"ninja &amp;&amp;\n"
"DESTDIR=$PWD/TESTS ninja install</literal>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/sdl2.xml:129
#, xml-text
msgid ""
"Now you will be able to run the tests in <filename "
"class=\"directory\">TESTS/usr/libexec/installed-"
"tests/SDL2_compat</filename>.  You will have to run the tests individually. "
"Some of them may need to be manually killed and audio will need to be "
"working so that you can hear from the default audio output."
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/multimedia/libdriv/sdl2.xml:139
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/sdl2.xml:145
#, xml-text
msgid ""
"<parameter>-D SDL2COMPAT_STATIC=OFF</parameter>: This parameter disables "
"building the static libraries."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/sdl2.xml:150
#, xml-text
msgid ""
"<parameter>-D SDL2COMPAT_TESTS=OFF</parameter>: This parameter disables "
"building the tests."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/sdl2.xml:155
#, xml-text
msgid ""
"<command>rm -vf /usr/lib/libSDL2_test.a</command>: This command removes a "
"useless static library."
msgstr ""

