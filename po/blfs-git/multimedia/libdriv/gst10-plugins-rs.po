#. type: Content of: <sect1><sect2><sect3><title>
#: blfs-en/blfs-git/multimedia/libdriv/gst10-plugins-rs.xml:128
#, xml-text
msgid "Installation of libgstdav1d"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/blfs-git/multimedia/libdriv/gst10-plugins-rs.xml:131
#, xml-text
msgid ""
"Install <application>libgstdav1d</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><screen>
#: blfs-en/blfs-git/multimedia/libdriv/gst10-plugins-rs.xml:135
#, no-wrap, xml-text
msgid ""
"<userinput>cargo build --package gst-plugin-dav1d --release</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/blfs-git/multimedia/libdriv/gst10-plugins-rs.xml:138
#, xml-text
msgid "This package does not come with a test suite."
msgstr ""

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/blfs-git/multimedia/libdriv/gst10-plugins-rs.xml:142
#: blfs-en/blfs-git/multimedia/libdriv/gst10-plugins-rs.xml:165
#, xml-text
msgid "Now, as the &root; user:"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><screen>
#: blfs-en/blfs-git/multimedia/libdriv/gst10-plugins-rs.xml:145
#, no-wrap, xml-text
msgid ""
"<userinput>install -vm755 target/release/libgstdav1d.so "
"/usr/lib/gstreamer-1.0</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><title>
#: blfs-en/blfs-git/multimedia/libdriv/gst10-plugins-rs.xml:150
#, xml-text
msgid "Installation of libgstgtk4"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/blfs-git/multimedia/libdriv/gst10-plugins-rs.xml:153
#, xml-text
msgid ""
"Install <application>libgstgtk4</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><screen>
#: blfs-en/blfs-git/multimedia/libdriv/gst10-plugins-rs.xml:157
#, no-wrap, xml-text
msgid "<userinput>cargo build --package gst-plugin-gtk4 --release</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/blfs-git/multimedia/libdriv/gst10-plugins-rs.xml:160
#, xml-text
msgid ""
"This package does not come with a test suite, but its basic functionality "
"can be tested after installation."
msgstr ""

#. type: Content of: <sect1><sect2><sect3><screen>
#: blfs-en/blfs-git/multimedia/libdriv/gst10-plugins-rs.xml:168
#, no-wrap, xml-text
msgid ""
"<userinput>install -vm755 target/release/libgstgtk4.so "
"/usr/lib/gstreamer-1.0</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/blfs-git/multimedia/libdriv/gst10-plugins-rs.xml:171
#, xml-text
msgid ""
"To test the basic functionality of the package, issue: <command>gst-"
"launch-1.0 videotestsrc num-buffers=60 ! gtk4paintablesink</command> in a "
"graphical terminal emulator.  It should play a test video in a GTK-4 window "
"for 2 seconds."
msgstr ""

