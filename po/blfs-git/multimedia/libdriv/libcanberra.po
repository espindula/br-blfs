#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/multimedia/libdriv/libcanberra.xml:113
#, xml-text
msgid "Installation of libcanberra"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/libcanberra.xml:116
#, xml-text
msgid ""
"First, apply a patch to fix an issue causing some applications to crash in "
"Wayland-based desktop environments:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/multimedia/libdriv/libcanberra.xml:120
#, no-wrap, xml-text
msgid ""
"<userinput>patch -Np1 -i ../libcanberra-0.30-wayland-1.patch</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/libcanberra.xml:123
#, xml-text
msgid ""
"Install <application>libcanberra</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/multimedia/libdriv/libcanberra.xml:127
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr --disable-oss &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/libcanberra.xml:131
#, xml-text
msgid "This package does not come with a test suite."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/libcanberra.xml:135
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/multimedia/libdriv/libcanberra.xml:138
#, no-wrap, xml-text
msgid ""
"<userinput>make docdir=/usr/share/doc/libcanberra-&libcanberra-version; "
"install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/multimedia/libdriv/libcanberra.xml:143
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/libcanberra.xml:146
#, xml-text
msgid ""
"<parameter>--disable-oss</parameter>: disables optional deprecated OSS "
"support"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/libcanberra.xml:151
#, xml-text
msgid "<option>--disable-gtk3</option>: disables optional support for GTK+-3"
msgstr ""

