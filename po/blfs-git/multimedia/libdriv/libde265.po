#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/multimedia/libdriv/libde265.xml:83
#, xml-text
msgid "Installation of libde265"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/libde265.xml:88
#, xml-text
msgid ""
"First, prevent the installation of some programs which are only useful for "
"hacking libde265:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/multimedia/libdriv/libde265.xml:92
#, no-wrap, xml-text
msgid ""
"<userinput>sed '/tools/d' -i Makefile.am &amp;&amp;\n"
"./autogen.sh</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/libde265.xml:96
#, xml-text
msgid ""
"Install <application>libde265</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/multimedia/libdriv/libde265.xml:100
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr         \\\n"
"            --disable-sherlock265 \\\n"
"            --disable-static      &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/libde265.xml:108
#, xml-text
msgid "This package does not come with a test suite."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/libde265.xml:112
#, xml-text
msgid "Now, as the &root; user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/multimedia/libdriv/libde265.xml:115
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/multimedia/libdriv/libde265.xml:119
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/libde265.xml:122
#, xml-text
msgid ""
"<parameter>--disable-sherlock265</parameter>: This switch disables the "
"sherlock265 program because it requires Qt5, which is no longer in BLFS.  "
"The sherlock265 program is mostly useful for users who are editing H.265 "
"videos."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/libde265.xml:129
#, xml-text
msgid ""
"<option>--enable-encoder</option>: This option enables the H.265 encoder, in"
" addition to the decoder.  The encoder is still experimental though so the "
"instructions above do not contain this option."
msgstr ""

