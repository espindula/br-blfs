#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/multimedia/libdriv/taglib.xml:85
#, xml-text
msgid "Installation of Taglib"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/taglib.xml:88
#, xml-text
msgid ""
"Install <application>Taglib</application> by running the following commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/multimedia/libdriv/taglib.xml:92
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr \\\n"
"      -D CMAKE_BUILD_TYPE=Release  \\\n"
"      -D BUILD_SHARED_LIBS=ON \\\n"
"      .. &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/taglib.xml:102
#, xml-text
msgid ""
"The test suite requires <application>Cppunit</application> but it's not a "
"BLFS package."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/taglib.xml:107
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/multimedia/libdriv/taglib.xml:110
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr ""

