#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/multimedia/libdriv/gstreamer10.xml:108
#, xml-text
msgid "Installation of gstreamer"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/gstreamer10.xml:114
#, xml-text
msgid ""
"Install <application>gstreamer</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/multimedia/libdriv/gstreamer10.xml:118
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup ..            \\\n"
"      --prefix=/usr       \\\n"
"      --buildtype=release \\\n"
"      -D gst_debug=false  &amp;&amp;\n"
"ninja</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/gstreamer10.xml:128
#, xml-text
msgid "To test the results, issue: <command>ninja test</command>."
msgstr ""

#. type: Content of: <sect1><sect2><caution><para>
#: blfs-en/blfs-git/multimedia/libdriv/gstreamer10.xml:133
#, xml-text
msgid ""
"If you are reinstalling <application>gstreamer</application> from a previous"
" version, it is best if you remove the prior version, including plugins, "
"before installing the new version.  If there is a mixture of versions "
"installed, using processes may hang or not work properly.  As the "
"<systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><caution><screen>
#: blfs-en/blfs-git/multimedia/libdriv/gstreamer10.xml:140
#, no-wrap, xml-text
msgid ""
"<userinput>rm -rf /usr/bin/gst-* "
"/usr/{lib,libexec}/gstreamer-1.0</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/gstreamer10.xml:144
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/multimedia/libdriv/gstreamer10.xml:147
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr ""

