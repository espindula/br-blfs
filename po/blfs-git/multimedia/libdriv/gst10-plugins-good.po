#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/multimedia/libdriv/gst10-plugins-good.xml:138
#, xml-text
msgid "Installation of GStreamer Good Plug-ins"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/gst10-plugins-good.xml:147
#, xml-text
msgid ""
"Install <application>GStreamer Good Plug-ins</application> by running the "
"following commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/multimedia/libdriv/gst10-plugins-good.xml:151
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup ..            \\\n"
"      --prefix=/usr       \\\n"
"      --buildtype=release &amp;&amp;\n"
"ninja</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/gst10-plugins-good.xml:160
#, xml-text
msgid ""
"To test the results, issue: <command>ninja test</command>.  One test, "
"<filename>elements_flvmux</filename>, is known to fail on some systems."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/gst10-plugins-good.xml:166
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/multimedia/libdriv/gst10-plugins-good.xml:169
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr ""

