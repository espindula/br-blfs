#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/multimedia/libdriv/libaom.xml:101
#, xml-text
msgid "Installation of libaom"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/libaom.xml:104
#, xml-text
msgid ""
"NASM-3 made a change where the help screen now shows different text based on"
" different parameters, instead of displaying all the info upfront. This "
"package depends on all the information being there. Fix how this package "
"gets that information to prevent a configuration failure with only NASM-3 "
"installed:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/multimedia/libdriv/libaom.xml:112
#, no-wrap, xml-text
msgid ""
"<userinput>patch -Np1 -i ../libaom-&libaom-"
"version;-nasm3-1.patch</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/libaom.xml:115
#, xml-text
msgid ""
"Install <application>libaom</application> by running the following commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/multimedia/libdriv/libaom.xml:119
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir aom-build &amp;&amp;\n"
"cd    aom-build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr \\\n"
"      -D CMAKE_BUILD_TYPE=Release  \\\n"
"      -D BUILD_SHARED_LIBS=1       \\\n"
"      -D ENABLE_DOCS=no            \\\n"
"      -G Ninja .. &amp;&amp;\n"
"ninja</userinput>"
msgstr ""

#. To test the results, issue: <command>
#. ninja testdata &amp;&amp; ninja runtests</command>.
#.       Note that the tests take an extremely long time to run.
#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/libaom.xml:130
#, xml-text
msgid "This package does not come with a working test suite."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/libaom.xml:136
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/multimedia/libdriv/libaom.xml:139
#, no-wrap, xml-text
msgid ""
"<userinput>ninja install &amp;&amp;\n"
"rm -v /usr/lib/libaom.a</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/multimedia/libdriv/libaom.xml:145
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/libaom.xml:148
#, xml-text
msgid ""
"<parameter>-D BUILD_SHARED_LIBS=1</parameter>: This switch builds shared "
"versions of the libraries."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/libaom.xml:153
#, xml-text
msgid ""
"<parameter>-D ENABLE_DOCS=no</parameter>: This switch disables building the "
"documentation because it fails due to an incompatibility with the latest "
"version of <xref role=\"nodep\" linkend=\"doxygen\"/>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/libaom.xml:159
#, xml-text
msgid ""
"<option>-D ENABLE_NASM=yes</option>: Use this switch if you have both <xref "
"linkend=\"yasm\"/> and <xref role=\"nodep\" linkend=\"nasm\"/> installed and"
" wish to use nasm instead of yasm."
msgstr ""

