#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/multimedia/libdriv/v4l-utils.xml:103
#, xml-text
msgid "Installation of v4l-utils"
msgstr ""

#. type: Content of: <sect1><sect2><note><para>
#: blfs-en/blfs-git/multimedia/libdriv/v4l-utils.xml:107
#, xml-text
msgid ""
"If you've installed both LLVM and libbpf (not in BLFS), either enable the "
"BPF target (via <option>-D LLVM_TARGETS_TO_BUILD=</option>) when building "
"LLVM, or disable the infrared remote control decoders based on BPF:"
msgstr ""

#.  not "nodump" because it's harmless for BLFS anyway
#. type: Content of: <sect1><sect2><note><screen>
#: blfs-en/blfs-git/multimedia/libdriv/v4l-utils.xml:114
#, no-wrap, xml-text
msgid ""
"<userinput>sed -i '/^ir_bpf_enabled/s/=.*/= false/' "
"utils/keytable/meson.build</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/v4l-utils.xml:118
#, xml-text
msgid ""
"Install <application>v4l-utils</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/multimedia/libdriv/v4l-utils.xml:122
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup ..            \\\n"
"      --prefix=/usr       \\\n"
"      --buildtype=release \\\n"
"      -D gconv=disabled   \\\n"
"      -D doxygen-doc=disabled &amp;&amp;\n"
"ninja</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/v4l-utils.xml:133
#, xml-text
msgid "This package does not come with a test suite."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/v4l-utils.xml:137
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/multimedia/libdriv/v4l-utils.xml:140
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/libdriv/v4l-utils.xml:143
#, xml-text
msgid "If you also wish to install the contrib programs, add:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/multimedia/libdriv/v4l-utils.xml:146
#, no-wrap, xml-text
msgid ""
"<userinput>for prog in v4l2gl v4l2grab\n"
"do\n"
"   cp -v contrib/test/$prog /usr/bin\n"
"done</userinput>"
msgstr ""

