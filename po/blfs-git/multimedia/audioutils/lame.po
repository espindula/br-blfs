#, xml-text
msgid "Installation of LAME"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/audioutils/lame.xml:90
#, xml-text
msgid ""
"Prevent the source code directory from being mistakenly hardcoded as a "
"shared library search path in the installed programs:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/multimedia/audioutils/lame.xml:94
#, no-wrap, xml-text
msgid ""
"<userinput>sed -i -e 's/^\\(\\s*hardcode_libdir_flag_spec\\s*=\\).*/\\1/' "
"configure</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/audioutils/lame.xml:97
#, xml-text
msgid ""
"Install <application>LAME</application> by running the following commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/multimedia/audioutils/lame.xml:101
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr --enable-mp3rtp --disable-static &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/audioutils/lame.xml:105
#, xml-text
msgid ""
"To test the results, issue: <command>LD_LIBRARY_PATH=libmp3lame/.libs make "
"test</command>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/audioutils/lame.xml:110
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/multimedia/audioutils/lame.xml:113
#, no-wrap, xml-text
msgid ""
"<userinput>make pkghtmldir=/usr/share/doc/lame-&lame-version; "
"install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/multimedia/audioutils/lame.xml:118
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/audioutils/lame.xml:121
#, xml-text
msgid ""
"<parameter>--enable-mp3rtp</parameter>: This switch enables building the "
"encode-to-RTP program."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/audioutils/lame.xml:129
#, xml-text
msgid ""
"<option>--enable-nasm</option>: This option enables the use of <xref "
"linkend=\"nasm\"/> to compile optimized assembly routines for 32-bit x86. "
"Note that this has no effect on x86_64."
msgstr ""

