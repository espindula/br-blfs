#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/multimedia/audioutils/pavucontrol.xml:90
#, xml-text
msgid "Installation of pavucontrol"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/audioutils/pavucontrol.xml:93
#, xml-text
msgid ""
"Install <application>pavucontrol</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/multimedia/audioutils/pavucontrol.xml:97
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr --buildtype=release -D lynx=disabled .. &amp;&amp;\n"
"ninja</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/audioutils/pavucontrol.xml:104
#, xml-text
msgid "This package does not come with a test suite."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/audioutils/pavucontrol.xml:108
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/multimedia/audioutils/pavucontrol.xml:111
#, no-wrap, xml-text
msgid ""
"<userinput>ninja install &amp;&amp;\n"
"mv /usr/share/doc/pavucontrol /usr/share/doc/pavucontrol-&pavucontrol-version;\n"
"</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/multimedia/audioutils/pavucontrol.xml:117
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/audioutils/pavucontrol.xml:120
#, xml-text
msgid ""
"<parameter>-D lynx=disabled</parameter>: This switch disables generating the"
" README file in text format. Remove this switch if you want the README file "
"in text format and have <xref linkend=\"lynx\"/> installed."
msgstr ""

