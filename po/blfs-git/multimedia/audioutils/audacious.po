#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/multimedia/audioutils/audacious.xml:168
#, xml-text
msgid "Installation of Audacious"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><title>
#: blfs-en/blfs-git/multimedia/audioutils/audacious.xml:171
#, xml-text
msgid "Installation of the Main Audacious Program"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/blfs-git/multimedia/audioutils/audacious.xml:174
#, xml-text
msgid ""
"Install <application>Audacious</application> by running the following "
"commands (you may wish to change the buildstamp to another string):"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><screen>
#: blfs-en/blfs-git/multimedia/audioutils/audacious.xml:178
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup ..            \\\n"
"      --prefix=/usr       \\\n"
"      --buildtype=release \\\n"
"      -D gtk=true         \\\n"
"      -D qt=true          \\\n"
"      -D buildstamp=BLFS  \\\n"
"      -D libarchive=true  &amp;&amp;\n"
"ninja</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/blfs-git/multimedia/audioutils/audacious.xml:191
#, xml-text
msgid "This package does not come with a test suite."
msgstr ""

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/blfs-git/multimedia/audioutils/audacious.xml:195
#: blfs-en/blfs-git/multimedia/audioutils/audacious.xml:225
#, xml-text
msgid "Now, as the &root; user:"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><screen>
#: blfs-en/blfs-git/multimedia/audioutils/audacious.xml:198
#: blfs-en/blfs-git/multimedia/audioutils/audacious.xml:228
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><title>
#: blfs-en/blfs-git/multimedia/audioutils/audacious.xml:203
#, xml-text
msgid "Installation of Audacious Plugins"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/blfs-git/multimedia/audioutils/audacious.xml:206
#, xml-text
msgid ""
"Install the required plugins package by issuing the following commands:"
msgstr ""

#. type: Content of: <sect1><sect2><sect3><screen>
#: blfs-en/blfs-git/multimedia/audioutils/audacious.xml:209
#, no-wrap, xml-text
msgid ""
"<userinput>tar -xf ../../audacious-plugins-&audacious-plugins-version;.tar.bz2 &amp;&amp;\n"
"cd audacious-plugins-&audacious-plugins-version;                    &amp;&amp;\n"
"\n"
"mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup ..            \\\n"
"      --prefix=/usr       \\\n"
"      --buildtype=release \\\n"
"      -D gtk=true         \\\n"
"      -D qt=true          \\\n"
"      -D opus=false       \\\n"
"      -D wavpack=false    &amp;&amp;\n"
"ninja</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/multimedia/audioutils/audacious.xml:234
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/audioutils/audacious.xml:237
#, xml-text
msgid ""
"<parameter>-D buildstamp=BLFS</parameter>: This switch appends the given "
"text to the version string."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/audioutils/audacious.xml:242
#, xml-text
msgid ""
"<parameter>-D gtk=true</parameter>: This option enables GTK support for the "
"graphical user interface."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/audioutils/audacious.xml:247
#, xml-text
msgid ""
"<parameter>-D qt=true</parameter>: This option enables Qt support for the "
"graphical user interface."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/audioutils/audacious.xml:252
#, xml-text
msgid ""
"<parameter>-D libarchive=true</parameter>: This adds libarchive support, for"
" reading compressed module sets or skins."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/audioutils/audacious.xml:257
#, xml-text
msgid ""
"<option>-D valgrind=true</option>: The option enables Valgrind analysis "
"support."
msgstr ""

