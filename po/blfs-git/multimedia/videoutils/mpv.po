#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/multimedia/videoutils/mpv.xml:119
#, xml-text
msgid "Installation of mpv"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/videoutils/mpv.xml:122
#, xml-text
msgid ""
"Install <application>mpv</application> by running the following commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/multimedia/videoutils/mpv.xml:126
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr       \\\n"
"            --buildtype=release \\\n"
"            -D x11=enabled      \\\n"
"            ..                  &amp;&amp;\n"
"ninja</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/videoutils/mpv.xml:136
#, xml-text
msgid "This package does not come with a test suite."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/videoutils/mpv.xml:140
#, xml-text
msgid "Now, as the &root; user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/multimedia/videoutils/mpv.xml:143
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/multimedia/videoutils/mpv.xml:151
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/videoutils/mpv.xml:154
#, xml-text
msgid ""
"<parameter>-D x11=enabled</parameter>: allows linking to the X11 libraries."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/videoutils/mpv.xml:158
#, xml-text
msgid "<option>-D dvdnav=enabled</option>: enables support for DVD playback."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/videoutils/mpv.xml:162
#, xml-text
msgid "<option>-D cdda=enabled</option>: enables support for CD Audio."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/videoutils/mpv.xml:166
#, xml-text
msgid ""
"<option>-D sdl2=enabled</option>: enables the usage of SDL2 for audio and "
"video output."
msgstr ""

