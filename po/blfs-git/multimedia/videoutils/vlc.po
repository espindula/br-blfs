#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/multimedia/videoutils/vlc.xml:234
#, xml-text
msgid "Installation of VLC"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/videoutils/vlc.xml:237
#, xml-text
msgid "First, fix compiling this package with ffmpeg-8 and later:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/multimedia/videoutils/vlc.xml:240
#, no-wrap, xml-text
msgid ""
"<userinput>patch -Np1 -i ../vlc-&vlc-version;-ffmpeg8-1.patch</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/videoutils/vlc.xml:243
#, xml-text
msgid ""
"Install <application>VLC</application> by running the following commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/multimedia/videoutils/vlc.xml:246
#, no-wrap, xml-text
msgid ""
"<userinput>BUILDCC=gcc ./configure --prefix=/usr --disable-libplacebo &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/videoutils/vlc.xml:250
#, xml-text
msgid "To test the results, issue: <command>make check</command>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/videoutils/vlc.xml:254
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/multimedia/videoutils/vlc.xml:257
#, no-wrap, xml-text
msgid ""
"<userinput>make docdir=/usr/share/doc/vlc-&vlc-version; install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/multimedia/videoutils/vlc.xml:265
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/videoutils/vlc.xml:268
#, xml-text
msgid ""
"<parameter>--disable-libplacebo</parameter>: This switch is required to "
"disable support for using libplacebo as a rendering pipeline because VLC is "
"incompatible with the latest version of libplacebo."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/videoutils/vlc.xml:274
#, xml-text
msgid ""
"<option>--disable-vpx</option>: Use this switch to disable "
"<application>libvpx</application>."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/videoutils/vlc.xml:284
#, xml-text
msgid ""
"<option>--disable-mad</option>: Use this switch if you don't have "
"<application>libmad</application> installed."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/videoutils/vlc.xml:289
#, xml-text
msgid ""
"<option>--disable-avcodec --disable-swscale</option>: Use these switches if "
"you don't have <application>FFmpeg</application> installed."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/videoutils/vlc.xml:294
#, xml-text
msgid ""
"<option>--disable-a52</option>: Use this switch if you don't have "
"<application>liba52</application> installed."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/videoutils/vlc.xml:299
#, xml-text
msgid ""
"<option>--disable-xcb</option>: Use this switch if you don't have "
"<application>X Window System</application> installed."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/videoutils/vlc.xml:304
#, xml-text
msgid ""
"<option>--disable-alsa</option>: Use this switch if you don't have "
"<application>ALSA</application> installed."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/videoutils/vlc.xml:309
#, xml-text
msgid ""
"<option>--disable-libgcrypt</option>: Use this switch if you don't have "
"<application>libgcrypt</application> installed."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/videoutils/vlc.xml:314
#, xml-text
msgid ""
"<option>--disable-sftp</option>: The default is to build the sftp module if "
"<xref linkend=\"libssh2\"/> is installed. Use this switch if you do not want"
" to build this module."
msgstr ""

#. type: Content of: <sect1><sect2><note><para>
#: blfs-en/blfs-git/multimedia/videoutils/vlc.xml:321
#, xml-text
msgid ""
"There are many options to <application>VLC</application>'s "
"<command>configure</command> command. Check the <command>configure "
"--help</command> output for a complete list."
msgstr ""

