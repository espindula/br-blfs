#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/multimedia/videoutils/xine-ui.xml:98
#, xml-text
msgid "Installation of Xine User Interface"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/videoutils/xine-ui.xml:101
#, xml-text
msgid ""
"Install <application>xine User Interface</application> by running the "
"following commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/multimedia/videoutils/xine-ui.xml:105
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr &amp;&amp;\n"
"make CC=\"gcc -std=gnu17\"</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/videoutils/xine-ui.xml:109
#, xml-text
msgid "This package does not come with a test suite."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/videoutils/xine-ui.xml:113
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/multimedia/videoutils/xine-ui.xml:116
#, no-wrap, xml-text
msgid ""
"<userinput>make docsdir=/usr/share/doc/xine-ui-&xine-ui-version; "
"install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/multimedia/videoutils/xine-ui.xml:124
#, xml-text
msgid "Command Explanations"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/multimedia/videoutils/xine-ui.xml:127
#, xml-text
msgid ""
"<parameter>docsdir=/usr/share/doc/xine-ui-&xine-ui-version;</parameter>: "
"This parameter causes the <application>Xine UI</application> documentation "
"to be installed in the versioned directory <filename "
"class=\"directory\">/usr/share/doc/xine-ui-&xine-ui-version;</filename>, "
"rather that the default <filename class=\"directory\">/usr/share/doc/xine-"
"ui</filename>."
msgstr ""

