#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/xfce/core/thunar.xml:105
#, xml-text
msgid "Installation of Thunar"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/xfce/core/thunar.xml:108
#, xml-text
msgid "First prevent the installation of an unneeded systemd file:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/xfce/core/thunar.xml:111
#, no-wrap, xml-text
msgid ""
"<userinput>sed -i 's/\\tinstall-systemd_userDATA/\\t/' Makefile.in\n"
"</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/xfce/core/thunar.xml:115
#, xml-text
msgid ""
"Install <application>Thunar</application> by running the following commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/xfce/core/thunar.xml:119
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr     \\\n"
"            --sysconfdir=/etc \\\n"
"            --docdir=/usr/share/doc/thunar-&thunar-version; &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/xfce/core/thunar.xml:125
#, xml-text
msgid "This package does not come with a test suite."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/xfce/core/thunar.xml:129
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/xfce/core/thunar.xml:132
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr ""

