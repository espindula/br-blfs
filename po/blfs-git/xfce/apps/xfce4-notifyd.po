#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/xfce/apps/xfce4-notifyd.xml:89
#, xml-text
msgid "Installation of the Xfce4 Notification Daemon"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/xfce/apps/xfce4-notifyd.xml:92
#, xml-text
msgid ""
"Install the <application>Xfce4 Notification Daemon</application> by running "
"the following commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/xfce/apps/xfce4-notifyd.xml:96
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr --sysconfdir=/etc &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/xfce/apps/xfce4-notifyd.xml:99
#, no-wrap, xml-text
msgid ""
"<userinput>./configure --prefix=/usr     \\\n"
"            --sysconfdir=/etc \\\n"
"            --disable-systemd &amp;&amp;\n"
"make</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/xfce/apps/xfce4-notifyd.xml:105
#, xml-text
msgid "This package does not come with a test suite."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/xfce/apps/xfce4-notifyd.xml:109
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/xfce/apps/xfce4-notifyd.xml:112
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/xfce/apps/xfce4-notifyd.xml:115
#, xml-text
msgid ""
"You can test the notification daemon with the command <command>notify-"
"send</command>, to be run in a graphical environment:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/xfce/apps/xfce4-notifyd.xml:120
#, no-wrap, xml-text
msgid ""
"<userinput>notify-send -i info Information \"Hi ${USER}, This is a "
"Test\"</userinput>"
msgstr ""

