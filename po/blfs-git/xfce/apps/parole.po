#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/xfce/apps/parole.xml:103
#, xml-text
msgid "Installation of Parole"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/xfce/apps/parole.xml:106
#, xml-text
msgid ""
"Install <application>Parole</application> by running the following commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/xfce/apps/parole.xml:110
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup ..            \\\n"
"      --prefix=/usr       \\\n"
"      --buildtype=release &amp;&amp;\n"
"ninja</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/xfce/apps/parole.xml:119
#, xml-text
msgid "This package does not come with a test suite."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/xfce/apps/parole.xml:123
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/xfce/apps/parole.xml:126
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><title>
#: blfs-en/blfs-git/xfce/apps/parole.xml:143
#, xml-text
msgid "Using Parole"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/xfce/apps/parole.xml:146
#, xml-text
msgid ""
"If you have installed Gstreamer Plugins Ugly with support for libdvdnav and "
"libdvdread and would like to use Parole to play a DVD, click Media&gt; Open "
"location and enter dvd:// into the box."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/xfce/apps/parole.xml:152
#, xml-text
msgid ""
"Similarly, to play a CD, click Media&gt; Open location and enter cdda:// "
"into the box."
msgstr ""

