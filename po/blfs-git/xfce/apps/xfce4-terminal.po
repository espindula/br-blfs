msgid "Installation of Xfce4 Terminal"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/xfce/apps/xfce4-terminal.xml:86
#, xml-text
msgid ""
"Install <application>Xfce4 Terminal</application> by running the following "
"commands:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/xfce/apps/xfce4-terminal.xml:90
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup ..      \\\n"
"      --prefix=/usr \\\n"
"      --buildtype=release &amp;&amp;\n"
"ninja</userinput>"
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/xfce/apps/xfce4-terminal.xml:99
#, xml-text
msgid "This package does not come with a test suite."
msgstr ""

#. type: Content of: <sect1><sect2><para>
#: blfs-en/blfs-git/xfce/apps/xfce4-terminal.xml:103
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/blfs-git/xfce/apps/xfce4-terminal.xml:106
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr ""

