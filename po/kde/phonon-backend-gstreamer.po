#. type: Content of: <sect1><sect2><title>
#: blfs-en/kde/phonon-backend-gstreamer.xml:26
msgid "Introduction to the Phonon-backend-gstreamer"
msgstr "Introdução ao <quote>Phonon-backend-gstreamer</quote>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/kde/phonon-backend-gstreamer.xml:29
msgid ""
"This package provides a <application>Phonon</application> backend which "
"utilizes the <application>GStreamer</application> media framework."
msgstr ""
"Esse pacote fornece uma estrutura de retaguarda do "
"&quot;<application>Phonon</application>&quot; que utiliza a estrutura "
"essencial de suporte de mídia do "
"&quot;<application>GStreamer</application>&quot;."

