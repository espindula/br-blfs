#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/kde/phonon-backend-gstreamer.xml:69
msgid "Phonon-backend-gstreamer Dependencies"
msgstr "Dependências do &quot;Phonon-backend-gstreamer&quot;"

#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/kde/phonon-backend-gstreamer.xml:71
msgid "Required"
msgstr "Exigidas"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/kde/phonon-backend-gstreamer.xml:73
msgid ""
"<xref linkend=\"gstreamer10\"/>, <xref linkend=\"libxml2\"/>, and <xref "
"linkend=\"phonon\"/>"
msgstr ""
"<xref linkend=\"gstreamer10\"/>, <xref linkend=\"libxml2\"/> e <xref "
"linkend=\"phonon\"/>"

#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/kde/phonon-backend-gstreamer.xml:78
msgid "Recommended"
msgstr "Recomendadas"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/kde/phonon-backend-gstreamer.xml:80
msgid ""
"<xref linkend=\"gst10-plugins-base\"/> (needed for output to ALSA), <xref "
"linkend=\"gst10-plugins-good\"/> (needed for output to PulseAudio), <xref "
"linkend=\"gst10-plugins-bad\"/> (needed for AAC/M4A support), and <xref "
"linkend=\"gst10-plugins-ugly\"/> (needed for MP3 support)"
msgstr ""
"<xref linkend=\"gst10-plugins-base\"/> (necessário para saída para o "
"&quot;ALSA&quot;), <xref linkend=\"gst10-plugins-good\"/> (necessário para "
"saída para o &quot;PulseAudio&quot;), <xref linkend=\"gst10-plugins-bad\"/> "
"(necessário para suporte a &quot;AAC&quot;/&quot;M4A&quot;) e <xref "
"linkend=\"gst10-plugins-ugly\"/> (necessário para suporte a &quot;MP3&quot;)"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/kde/phonon-backend-gstreamer.xml:90
msgid "Installation of Phonon-backend-gstreamer"
msgstr "Instalação do <quote>Phonon-backend-gstreamer</quote>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/kde/phonon-backend-gstreamer.xml:93
msgid ""
"Install <application>Phonon-backend-gstreamer</application> by running the "
"following commands:"
msgstr ""
"Instale o &quot;<application>Phonon-backend-gstreamer</application>&quot; "
"executando os seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/kde/phonon-backend-gstreamer.xml:97
#, no-wrap
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -DCMAKE_INSTALL_PREFIX=/usr    \\\n"
"      -DCMAKE_BUILD_TYPE=Release     \\\n"
"      .. &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd     build &amp;&amp;\n"
"\n"
"cmake -DCMAKE_INSTALL_PREFIX=/usr    \\\n"
"      -DCMAKE_BUILD_TYPE=Release     \\\n"
"      .. &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/kde/phonon-backend-gstreamer.xml:106
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/kde/phonon-backend-gstreamer.xml:109
#, no-wrap
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/kde/phonon-backend-gstreamer.xml:114
msgid "Command Explanations"
msgstr "Explicações dos Comandos"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/kde/phonon-backend-gstreamer.xml:117
msgid ""
"<parameter>-DCMAKE_BUILD_TYPE=Release</parameter>: This switch is used to "
"apply higher level of compiler optimizations."
msgstr ""
"<parameter>-DCMAKE_BUILD_TYPE=Release</parameter>: Essa chave é usada para "
"aplicar um nível mais alto de otimização à compilação."

