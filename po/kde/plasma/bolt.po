#. type: Content of: <sect1><sect2><title>
#: blfs-en/kde/plasma/bolt.xml:25
#, xml-text
msgid "Introduction to bolt"
msgstr "Introdução ao bolt"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/kde/plasma/bolt.xml:28
#, xml-text
msgid ""
"The <application>bolt</application> package is a system daemon to enable "
"security levels for Thunderbolt."
msgstr ""
"O pacote <application>bolt</application> é um processo de segundo plano do "
"sistema para habilitar níveis de segurança para Thunderbolt."

