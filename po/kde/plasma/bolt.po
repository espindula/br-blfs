msgstr "Exigidas"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/kde/plasma/bolt.xml:72
#, xml-text
msgid "<xref linkend=\"glib2\"/> and <xref linkend=\"polkit\"/>"
msgstr "<xref linkend=\"glib2\"/> e <xref linkend=\"polkit\"/>"

#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/kde/plasma/bolt.xml:76
#, xml-text
