msgstr "Opcionais"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/kde/plasma/bolt.xml:78
#, xml-text
msgid ""
"<xref linkend=\"umockdev\"/> (for testing), and <xref linkend=\"asciidoc\"/>"
" (for documentation)"
msgstr ""
"<xref linkend=\"umockdev\"/> (para testagem) e <xref linkend=\"asciidoc\"/> "
"(para documentação)"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/kde/plasma/bolt.xml:85
#, xml-text
msgid "Installation of bolt"
msgstr "Instalação do bolt"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/kde/plasma/bolt.xml:88
#, xml-text
msgid ""
"Install <application>bolt</application> by running the following commands:"
msgstr ""
"Instale <application>bolt</application> executando os seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/kde/plasma/bolt.xml:92
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr --buildtype=release .. &amp;&amp;\n"
"ninja</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"meson setup --prefix=/usr --buildtype=release .. &amp;&amp;\n"
"ninja</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/kde/plasma/bolt.xml:99
#, xml-text
msgid ""
"To test the results, issue: <command>ninja test</command>.  One test, "
"test_journal_object, is known to fail."
msgstr ""
"Para testar os resultados, emita: <command>ninja test</command>. Um teste, "
"test_journal_object, é conhecido por falhar."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/kde/plasma/bolt.xml:104
#, xml-text
msgid "Now, as the &root; user:"
msgstr "Agora, como o(a) usante &root;:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/kde/plasma/bolt.xml:107
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr "<userinput>ninja install</userinput>"

