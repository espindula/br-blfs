#. type: Content of: <sect1><sect2><title>
#: blfs-en/kde/plasma/kquickimageeditor.xml:83
#, xml-text
msgid "Installation of kquickimageeditor"
msgstr "Instalação do kquickimageeditor"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/kde/plasma/kquickimageeditor.xml:86
#, xml-text
msgid ""
"Install <application>kquickimageeditor</application> by running the "
"following commands:"
msgstr ""
"Instale <application>kquickimageeditor</application> executando os seguintes"
" comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/kde/plasma/kquickimageeditor.xml:90
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=$KF6_PREFIX \\\n"
"      -D CMAKE_BUILD_TYPE=Release         \\\n"
"      -D BUILD_TESTING=OFF                \\\n"
"      -W no-author ..                     &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=$KF6_PREFIX \\\n"
"      -D CMAKE_BUILD_TYPE=Release         \\\n"
"      -D BUILD_TESTING=OFF                \\\n"
"      -W no-author ..                     &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/kde/plasma/kquickimageeditor.xml:100
#, xml-text
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/kde/plasma/kquickimageeditor.xml:104
#, xml-text
msgid "Now, as the &root; user:"
msgstr "Agora, como o(a) usante &root;:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/kde/plasma/kquickimageeditor.xml:107
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

