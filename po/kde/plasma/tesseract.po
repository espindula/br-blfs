#. type: Content of: <sect1><sect2><title>
#: blfs-en/kde/plasma/tesseract.xml:25
#, xml-text
msgid "Introduction to tesseract"
msgstr "Introdução ao tesseract"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/kde/plasma/tesseract.xml:28
#, xml-text
msgid ""
"The <application>tesseract</application> package provides an Optical "
"Character Recognition (OCR) engine and command-line program used to extract "
"printed text from images."
msgstr "O pacote <application>tesseract</application> fornece um mecanismo de reconhecimento óptico de caracteres (OCR) e um programa de linha de comando usado para extrair texto impresso de imagens."

