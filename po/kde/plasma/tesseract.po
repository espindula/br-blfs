#. type: Content of: <sect1><sect2><title>
#: blfs-en/kde/plasma/tesseract.xml:87
#, xml-text
msgid "Installation of tesseract"
msgstr "Instalação do tesseract"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/kde/plasma/tesseract.xml:90
#, xml-text
msgid ""
"Install <application>tesseract</application> by running the following "
"commands:"
msgstr "Instale <application>tesseract</application> executando os seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/kde/plasma/tesseract.xml:94
#, no-wrap, xml-text
msgid ""
"<userinput>./autogen.sh &amp;&amp;           \n"
"\n"
"./configure --prefix=/usr --disable-static &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>./autogen.sh &amp;&amp;           \n"
"\n"
"./configure --prefix=/usr --disable-static &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/kde/plasma/tesseract.xml:100
#, xml-text
msgid "The package does not come with a test suite."
msgstr "O pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/kde/plasma/tesseract.xml:104
#, xml-text
msgid "Now, as the &root; user:"
msgstr "Agora, como o(a) usante &root;:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/kde/plasma/tesseract.xml:107
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

