#. type: Content of: <sect1><sect2><title>
#: blfs-en/kde/plasma/pulseaudio-qt.xml:25
#, xml-text
msgid "Introduction to pulseaudio-qt"
msgstr "Introdução ao pulseaudio-qt"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/kde/plasma/pulseaudio-qt.xml:28
#, xml-text
msgid ""
"This package is a Qt-based wrapper for <xref linkend='pulseaudio'/>.  It "
"allows for querying and manipulating various PulseAudio objects, including "
"Sinks, Sources, and Streams. It does not wrap the full feature set of "
"libpulse, but rather only what is needed for KDE."
msgstr ""
"Esse pacote é um envolucrador baseado em Qt para <xref "
"linkend='pulseaudio'/>. Ele permite consultar e manipular vários objetos do "
"PulseAudio, incluindo Sinks, Fontes e Fluxos. Ele não envolucra o conjunto "
"completo de recursos da libpulse, mas somente o que for necessário para o "
"KDE."

