#: blfs-en/kde/plasma/corrosion.xml:78
#, xml-text
msgid "Installation of corrosion"
msgstr "Instalação do corrosion"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/kde/plasma/corrosion.xml:81
#, xml-text
msgid ""
"Install <application>corrosion</application> by running the following "
"commands:"
msgstr "Instale <application>corrosion</application> executando os seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/kde/plasma/corrosion.xml:85
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr    \\\n"
"      -D CMAKE_BUILD_TYPE=Release     \\\n"
"      -D CMAKE_INSTALL_LIBEXECDIR=lib \\\n"
"      -D CORROSION_BUILD_TESTS=OFF    \\\n"
"      -W no-author ..                 &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr    \\\n"
"      -D CMAKE_BUILD_TYPE=Release     \\\n"
"      -D CMAKE_INSTALL_LIBEXECDIR=lib \\\n"
"      -D CORROSION_BUILD_TESTS=OFF    \\\n"
"      -W no-author ..                 &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/kde/plasma/corrosion.xml:96
#, xml-text
msgid "The package does not come with a test suite."
msgstr "O pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/kde/plasma/corrosion.xml:100
#, xml-text
msgid "Now, as the &root; user:"
msgstr "Agora, como o(a) usante &root;:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/kde/plasma/corrosion.xml:103
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

