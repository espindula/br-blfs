#. type: Content of: <sect1><sect2><title>
#: blfs-en/kde/plasma/qtkeychain.xml:77
#, xml-text
msgid "Installation of qtkeychain"
msgstr "Instalação do qtkeychain"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/kde/plasma/qtkeychain.xml:80
#, xml-text
msgid ""
"Install <application>qtkeychain</application> by running the following "
"commands:"
msgstr ""
"Instale <application>qtkeychain</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/kde/plasma/qtkeychain.xml:84
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=$QT6DIR \\\n"
"      -D CMAKE_BUILD_TYPE=Release     \\\n"
"      -D BUILD_WITH_QT6=ON            \\\n"
"      -D BUILD_TESTING=OFF            \\\n"
"      -W no-author ..                 &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=$QT6DIR \\\n"
"      -D CMAKE_BUILD_TYPE=Release     \\\n"
"      -D BUILD_WITH_QT6=ON            \\\n"
"      -D BUILD_TESTING=OFF            \\\n"
"      -W no-author ..                 &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/kde/plasma/qtkeychain.xml:95
#, xml-text
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/kde/plasma/qtkeychain.xml:99
#, xml-text
msgid "Now, as the &root; user:"
msgstr "Agora, como o(a) usante &root;:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/kde/plasma/qtkeychain.xml:102
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

