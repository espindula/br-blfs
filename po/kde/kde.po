#. type: Content of: <part><title>
#: blfs-en/kde/kde.xml:8 blfs-en/kde/kde.xml:11
#, xml-text
msgid "KDE"
msgstr "KDE"

#. type: Content of: <part><partintro><para>
#: blfs-en/kde/kde.xml:14
#, xml-text
msgid ""
"<application>KDE</application> is a comprehensive desktop environment with a"
" huge number of applications written for it and a huge amount of users. It "
"is based on the <application>Qt</application> framework."
msgstr ""
"O <application>KDE</application> é um ambiente de área de trabalho "
"abrangente com um grande número de aplicativos escritos para ele e uma "
"grande quantidade de usantes. Ele é baseado na estrutura essencial de "
"suporte <application>Qt</application>."

#. type: Content of: <part><partintro><para>
#: blfs-en/kde/kde.xml:20
#, xml-text
msgid ""
"For more information visit the official KDE project site at <ulink "
"url=\"https://kde.org/\"/>."
msgstr ""
"Para mais informações, visite o sítio oficial do projeto &quot;KDE&quot; em "
"<ulink url=\"https://kde.org/\"/>."
