#. type: Content of: <sect1><sect2><para>
#: blfs-en/kde/kf5-apps/libkdcraw.xml:29
#, xml-text
msgid ""
"<application>Libkdcraw</application> is a KDE wrapper around the <xref "
"linkend=\"libraw\"/> library for manipulating image metadata."
msgstr ""
"<application>Libkdcraw</application> é um involucrador do KDE em torno da "
"biblioteca <xref linkend=\"libraw\"/> para manipular metadados de imagens."

