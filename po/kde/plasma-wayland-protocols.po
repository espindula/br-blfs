#: blfs-en/kde/plasma-wayland-protocols.xml:79
#, xml-text
msgid "Installation of Plasma-wayland-protocols"
msgstr "Instalação do Plasma-wayland-protocols"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/kde/plasma-wayland-protocols.xml:82
#, xml-text
msgid ""
"Install <application>Plasma-wayland-protocols</application> by running the "
"following commands:"
msgstr ""
"Instale o &quot;<application>Plasma-wayland-protocols</application>&quot; "
"executando os seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/kde/plasma-wayland-protocols.xml:86
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr ..</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr ..</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/kde/plasma-wayland-protocols.xml:92
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) &quot;<systemitem "
"class=\"username\">root</systemitem>&quot;:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/kde/plasma-wayland-protocols.xml:95
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

