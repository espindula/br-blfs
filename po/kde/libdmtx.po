#: blfs-en/kde/libdmtx.xml:26
#, xml-text
msgid "Introduction to the libdmtx"
msgstr "Introdução ao the libdmtx"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/kde/libdmtx.xml:29
#, xml-text
msgid ""
"This package is a software library that enables programs to read and write "
"Data Matrix barcodes."
msgstr ""
"Esse pacote é uma biblioteca de software que habilita programas para lerem e"
" escreverem códigos de barras Data Matrix."

