#. type: Content of: <sect1><sect2><title>
#: blfs-en/kde/libdmtx.xml:72
#, xml-text
msgid "Installation of libdmtx"
msgstr "Instalação do libdmtx"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/kde/libdmtx.xml:75
#, xml-text
msgid "First, fix a minor cmake issue:"
msgstr "Primeiro, corrija um problema secundário do cmake:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/kde/libdmtx.xml:78
#, no-wrap, xml-text
msgid "<userinput>sed -i 's/3.5/3.10/' CMakeLists.txt</userinput>"
msgstr "<userinput>sed -i 's/3.5/3.10/' CMakeLists.txt</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/kde/libdmtx.xml:81
#, xml-text
msgid ""
"Install <application>libdmtx</application> by running the following "
"commands:"
msgstr ""
"Instale <application>libdmtx</application> executando os seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/kde/libdmtx.xml:85
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr .. &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr .. &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/kde/libdmtx.xml:92
#, xml-text
msgid "Now, as the &root; user:"
msgstr "Agora, como o(a) usuário(a) &root;:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/kde/libdmtx.xml:95
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

