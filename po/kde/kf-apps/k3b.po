msgstr "Instalação do K3b"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/kde/kf-apps/k3b.xml:143
#, xml-text
msgid ""
"Install <application>K3b</application> by running the following commands:"
msgstr ""
"Instale <application>K3b</application> executando os seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/kde/kf-apps/k3b.xml:147
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=$KF6_PREFIX \\\n"
"      -D CMAKE_BUILD_TYPE=Release         \\\n"
"      -D BUILD_TESTING=OFF                \\\n"
"      -W no-author ..                     &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=$KF6_PREFIX \\\n"
"      -D CMAKE_BUILD_TYPE=Release         \\\n"
"      -D BUILD_TESTING=OFF                \\\n"
"      -W no-author ..                     &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/kde/kf-apps/k3b.xml:157
