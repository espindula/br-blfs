#. type: Content of: <sect1><sect2><para>
#: blfs-en/kde/kf-apps/k3b.xml:98
#, xml-text
msgid ""
"The CD/DVD drive is detected at run time using <xref linkend=\"udisks2\" "
"role=\"runtime\"/>, which must therefore be installed before running "
"<command>k3b</command>."
msgstr ""
"A unidade de &quot;CD&quot;/&quot;DVD&quot; é detectada em tempo de execução"
" usando o &quot;<xref linkend=\"udisks2\" role=\"runtime\"/>&quot;, que "
"precisa, por esse motivo, ser instalado antes de executar o "
"&quot;<command>k3b</command>&quot;."

#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/kde/kf-apps/k3b.xml:103
#, xml-text
msgid "Recommended"
msgstr "Recomendadas"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/kde/kf-apps/k3b.xml:105
#, xml-text
