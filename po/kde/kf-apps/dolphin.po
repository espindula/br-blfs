#. type: Content of: <sect1><sect2><para>
#: blfs-en/kde/kf-apps/dolphin.xml:78
#, xml-text
msgid ""
"<ulink url=\"https://download.kde.org/stable/release-service\">baloo-"
"widgets</ulink> (for the metadata features of Dolphin) and <ulink "
"url=\"https://www.freedesktop.org/software/PackageKit/releases/\">packagekit-"
"qt</ulink>"
msgstr ""
"<ulink url=\"https://download.kde.org/stable/release-service\">baloo-"
"widgets</ulink> (para os recursos de metadados do Dolphin) e <ulink "
"url=\"https://www.freedesktop.org/software/PackageKit/releases/\">packagekit-"
"qt</ulink>"

