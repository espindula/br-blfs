msgstr ""
"<xref role=\"runtime\" linkend=\"kio-extras\"/> (para montar "
"compartilhamentos SMB)"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/kde/kf-apps/dolphin.xml:91
#, xml-text
msgid "Installation of dolphin"
msgstr "Instalação do dolphin"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/kde/kf-apps/dolphin.xml:94
#, xml-text
msgid ""
"Install <application>dolphin</application> by running the following "
"commands:"
msgstr ""
"Instale <application>dolphin</application> executando os seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/kde/kf-apps/dolphin.xml:98
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=$KF6_PREFIX \\\n"
"      -D CMAKE_BUILD_TYPE=Release         \\\n"
"      -D BUILD_TESTING=OFF                \\\n"
"      -W no-author .. &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=$KF6_PREFIX \\\n"
"      -D CMAKE_BUILD_TYPE=Release         \\\n"
"      -D BUILD_TESTING=OFF                \\\n"
"      -W no-author .. &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/kde/kf-apps/dolphin.xml:108
#, xml-text
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/kde/kf-apps/dolphin.xml:112
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr "Agora, como o(a) usante <systemitem class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/kde/kf-apps/dolphin.xml:115
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

