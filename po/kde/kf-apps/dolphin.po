#. type: Content of: <sect1><sect2><para>
#: blfs-en/kde/kf-apps/dolphin.xml:28
#, xml-text
msgid ""
"The <application>dolphin</application> package is a KDE Frameworks-based "
"file manager."
msgstr ""
"O pacote <application>dolphin</application> é um gerenciador de arquivos "
"baseado no KDE Frameworks."

