#. type: Content of: <sect1><sect2><title>
#: blfs-en/kde/kf-apps/okular.xml:98
#, xml-text
msgid "Installation of Okular"
msgstr "Instalação do Okular"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/kde/kf-apps/okular.xml:101
#, xml-text
msgid ""
"Install <application>Okular</application> by running the following commands:"
msgstr ""
"Instale <application>Okular</application> executando os seguintes comandos:"

#. type: Content of: <sect1><sect2><note><para>
#: blfs-en/kde/kf-apps/okular.xml:107
#, xml-text
msgid ""
"If any of the optional dependencies are installed, remove the associated "
"reference in the SKIP_OPTIONAL environment variable."
msgstr ""
"Se quaisquer das dependências opcionais estiverem instaladas, remova a "
"referência associada na variável de ambiente SKIP_OPTIONAL."

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/kde/kf-apps/okular.xml:112
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"SKIP_OPTIONAL='Discount;DjVuLibre;EPub;LibSpectre;LibZip'\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=$KF6_PREFIX \\\n"
"      -D CMAKE_BUILD_TYPE=Release         \\\n"
"      -D BUILD_TESTING=OFF                \\\n"
"      -D FORCE_NOT_REQUIRED_DEPENDENCIES=\"$SKIP_OPTIONAL\" \\\n"
"      -W no-dev .. &amp;&amp;\n"
"make</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"SKIP_OPTIONAL='Discount;DjVuLibre;EPub;LibSpectre;LibZip'\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=$KF6_PREFIX \\\n"
"      -D CMAKE_BUILD_TYPE=Release         \\\n"
"      -D BUILD_TESTING=OFF                \\\n"
"      -D FORCE_NOT_REQUIRED_DEPENDENCIES=\"$SKIP_OPTIONAL\" \\\n"
"      -W no-dev .. &amp;&amp;\n"
"make</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/kde/kf-apps/okular.xml:125
#, xml-text
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/kde/kf-apps/okular.xml:129
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/kde/kf-apps/okular.xml:132
#, no-wrap, xml-text
msgid "<userinput>make install</userinput>"
msgstr "<userinput>make install</userinput>"

