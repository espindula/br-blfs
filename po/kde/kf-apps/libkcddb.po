#. type: Content of: <sect1><sect2><para>
#: blfs-en/kde/kf-apps/libkcddb.xml:29
#, xml-text
msgid ""
"The <application>libkcddb</application> package contains a library used to "
"retrieve audio CD meta data from the internet."
msgstr ""
"O pacote &quot;<application>libkcddb</application>&quot; contém uma "
"biblioteca usada para recuperar metadados de &quot;CD&quot; de áudio a "
"partir da Internet."

