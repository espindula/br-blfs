#. type: Content of: <sect1><sect2><title>
#: blfs-en/kde/kf-apps/ark.xml:26
#, xml-text
msgid "Introduction to Ark"
msgstr "Introdução ao Ark"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/kde/kf-apps/ark.xml:29
#, xml-text
msgid ""
"The <application>Ark</application> package is a KDE Frameworks-based Archive"
" Manager. It is a graphical front end to tar, 7zip, UnRar, and other similar"
" tools."
msgstr ""
"O pacote <application>Ark</application> é um gerenciador de arquivamentos "
"baseado no KDE Frameworks. Ele é uma estrutura gráfica de interação direta "
"com o(a) usuário(a) para o tar, 7zip, UnRar e outras ferramentas "
"semelhantes."

