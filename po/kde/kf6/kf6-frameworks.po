#: blfs-en/kde/kf6/kf6-frameworks.xml:117
#, xml-text
msgid ""
"<xref linkend=\"bluez\"/> (needed to build Bluez-Qt), <ulink "
"url=\"https://libdmtx.sourceforge.net/\">Datamatrix</ulink> (deemed "
"recommended for Prison by upstream), and <ulink "
"url=\"https://github.com/zxing-cpp/zxing-cpp\">zxing-cpp</ulink> (also "
"deemed recommended for Prison by upstream)"
msgstr ""
"<xref linkend=\"bluez\"/> (necessário para construir Bluez-Qt), <ulink "
"url=\"https://libdmtx.sourceforge.net/\">Datamatrix</ulink> (considerado "
"recomendado para Prison pelo fluxo de desenvolvimento) e <ulink "
"url=\"https://github.com/zxing-cpp/zxing-cpp\">zxing-cpp</ulink> (também "
"considerado recomendado para Prison pelo fluxo de desenvolvimento)"

