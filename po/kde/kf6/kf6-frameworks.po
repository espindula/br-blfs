#: blfs-en/kde/kf6/kf6-frameworks.xml:74
#, xml-text
msgid "Required"
msgstr "Exigidas"

#. type: Content of: <sect1><para>
#: blfs-en/kde/kf6/kf6-frameworks.xml:76
#, xml-text
msgid ""
"<xref linkend=\"extra-cmake-modules\"/>, <xref linkend=\"breeze-icons\"/>, "
"<xref linkend=\"DocBook\"/>, <xref linkend=\"docbook-xsl\"/>, <xref "
"linkend=\"libcanberra\"/>, <xref linkend=\"libgcrypt\"/>, <xref "
"linkend=\"libical\"/>, <xref linkend=\"libxslt\"/>, <xref "
"linkend=\"lmdb\"/>, <xref linkend=\"qca\"/>, <xref linkend=\"qrencode\"/>, "
"<xref linkend=\"plasma-wayland-protocols\"/>, <xref linkend=\"PyYAML\"/>, "
"<xref linkend=\"shared-mime-info\"/>, <xref linkend=\"perl-uri\"/>, and "
"<xref linkend=\"wget\"/> (required to download the packages)"
msgstr ""
"<xref linkend=\"extra-cmake-modules\"/>, <xref linkend=\"breeze-icons\"/>, "
"<xref linkend=\"DocBook\"/>, <xref linkend=\"docbook-xsl\"/>, <xref "
"linkend=\"libcanberra\"/>, <xref linkend=\"libgcrypt\"/>, <xref "
"linkend=\"libical\"/>, <xref linkend=\"libxslt\"/>, <xref "
"linkend=\"lmdb\"/>, <xref linkend=\"qca\"/>, <xref linkend=\"qrencode\"/>, "
"<xref linkend=\"plasma-wayland-protocols\"/>, <xref linkend=\"PyYAML\"/>, "
"<xref linkend=\"shared-mime-info\"/>, <xref linkend=\"perl-uri\"/> e <xref "
"linkend=\"wget\"/> (exigido para baixar os pacotes)"

#. type: Content of: <sect1><bridgehead>
#: blfs-en/kde/kf6/kf6-frameworks.xml:94
#, xml-text
msgid "Recommended"
msgstr "Recomendadas"

#. type: Content of: <sect1><para>
#: blfs-en/kde/kf6/kf6-frameworks.xml:96
#, xml-text
msgid ""
"<xref linkend=\"aspell\"/> (Dictionary backend for Sonnet), <xref "
"linkend=\"avahi\"/> (DNS-SD backend for KDNSSD), <xref "
"linkend=\"ModemManager\"/> (needed to build ModemManager-Qt), <xref "
"linkend=\"NetworkManager\"/> (needed to build NetworkManager-Qt), <xref "
"linkend=\"polkit-qt\"/> (Authentication backend for KAuth), <xref "
"linkend=\"vulkan-loader\"/> (Add support for Vulkan graphics drivers), and "
"<xref linkend=\"zxing-cpp\"/> (Add support needed to build spectacle)"
msgstr ""
"<xref linkend=\"aspell\"/> (estrutura de retaguarda de dicionário para "
"Sonnet), <xref linkend=\"avahi\"/> (estrutura de retaguarda de DNS-SD para "
"KDNSSD), <xref linkend=\"ModemManager\"/> (necessário para construir "
"ModemManager-Qt), <xref linkend=\"NetworkManager\"/> (necessário para "
"construir NetworkManager-Qt), <xref linkend=\"polkit-qt\"/> (estrutura de "
"retaguarda de autenticação para KAuth), <xref linkend=\"vulkan-loader\"/> "
"(adiciona suporte para controladores gráficos do Vulkan) e <xref "
"linkend=\"zxing-cpp\"/> (adicionar suporte necessário para construir "
"spectacle)"

#. type: Content of: <sect1><para>
#: blfs-en/kde/kf6/kf6-frameworks.xml:106
#, xml-text
msgid ""
"Furthermore, the instructions below assume that the environment has been set"
" up as described in <xref linkend=\"kf6-intro\"/>."
