#: blfs-en/xsoft/graphweb/epiphany.xml:94
#, xml-text
msgid ""
"<xref role=\"runtime\" linkend=\"gnome-keyring\"/> (for storing passwords) "
"and <xref role=\"runtime\" linkend=\"seahorse\"/> (for managing stored "
"passwords)"
msgstr ""
"<xref role=\"runtime\" linkend=\"gnome-keyring\"/> (para armazenar senhas) e"
" <xref role=\"runtime\" linkend=\"seahorse\"/> (para gerenciar senhas "
"armazenadas)"

