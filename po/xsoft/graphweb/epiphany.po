#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/xsoft/graphweb/epiphany.xml:71
#, xml-text
msgid "Epiphany Dependencies"
msgstr "Dependências do Epiphany"

#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/xsoft/graphweb/epiphany.xml:73
#, xml-text
msgid "Required"
msgstr "Exigidas"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/xsoft/graphweb/epiphany.xml:75
#, xml-text
msgid ""
"<xref linkend=\"blueprint-compiler\"/>, <xref linkend=\"gcr4\"/>, <xref "
"linkend=\"gnome-desktop\"/>, <xref linkend=\"iso-codes\"/>, <xref "
"linkend=\"json-glib\"/>, <xref linkend=\"libadwaita1\"/>, <xref "
"linkend=\"libportal\"/>, <xref linkend=\"nettle\"/>, and <xref "
"linkend=\"webkitgtk\"/> (built with GTK-4)"
msgstr ""
"<xref linkend=\"blueprint-compiler\"/>, <xref linkend=\"gcr4\"/>, <xref "
"linkend=\"gnome-desktop\"/>, <xref linkend=\"iso-codes\"/>, <xref "
"linkend=\"json-glib\"/>, <xref linkend=\"libadwaita1\"/>, <xref "
"linkend=\"libportal\"/>, <xref linkend=\"nettle\"/> e <xref "
"linkend=\"webkitgtk\"/> (construído com GTK-4)"

#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/xsoft/graphweb/epiphany.xml:86
#, xml-text
msgid "Optional"
msgstr "Opcionais"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/xsoft/graphweb/epiphany.xml:88
#, xml-text
msgid ""
"<xref linkend=\"appstream\"/> and <ulink "
"url=\"https://github.com/elementary/granite\">Granite</ulink>"
msgstr ""
"<xref linkend=\"appstream\"/> e <ulink "
"url=\"https://github.com/elementary/granite\">Granite</ulink>"

#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/xsoft/graphweb/epiphany.xml:92
#, xml-text
