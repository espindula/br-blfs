#. type: Content of: <sect1><sect2><title>
#: blfs-en/xsoft/graphweb/epiphany.xml:27
#, xml-text
msgid "Introduction to Epiphany"
msgstr "Introdução ao Epiphany"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/xsoft/graphweb/epiphany.xml:30
#, xml-text
msgid ""
"<application>Epiphany</application> is a simple yet powerful "
"<application>GNOME</application> web browser targeted at non-technical "
"users. Its principles are simplicity and standards compliance."
msgstr ""
"<application>Epiphany</application> é um navegador da web do "
"<application>GNOME</application> simples, mas poderoso, direcionado a "
"usuários(as) não técnicos(as). Os princípios dele são simplicidade e "
"conformidade com padrões."

