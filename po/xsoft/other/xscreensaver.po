#: blfs-en/xsoft/other/xscreensaver.xml:159
#, xml-text
msgid "Linux PAM Configuration"
msgstr "Configuração do Linux PAM"

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/xsoft/other/xscreensaver.xml:162
#, xml-text
msgid ""
"If <application>XScreenSaver</application> has been built with "
"<application>Linux PAM</application> support, you need to create a "
"<application>PAM</application> configuration file, to get it working "
"correctly with BLFS."
msgstr ""
"Se o <application>XScreenSaver</application> tiver sido construído com "
"suporte a <application>Linux PAM</application>, você precisa criar um "
"arquivo de configuração <application>PAM</application>, para fazê-lo "
"funcionar corretamente com o BLFS."

#. type: Content of: <sect1><sect2><sect3><para>
#: blfs-en/xsoft/other/xscreensaver.xml:169
#, xml-text
msgid ""
"Issue the following commands as the <systemitem "
"class=\"username\">root</systemitem> user to create the configuration file "
"for <application>Linux PAM</application>:"
msgstr ""
"Emita os seguintes comandos como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem> para criar o arquivo de configuração "
"para <application>Linux PAM</application>:"

#. type: Content of: <sect1><sect2><sect3><screen>
#: blfs-en/xsoft/other/xscreensaver.xml:174
#, no-wrap, xml-text
msgid ""
"<userinput>cat &gt; /etc/pam.d/xscreensaver &lt;&lt; \"EOF\"\n"
"<literal># Begin /etc/pam.d/xscreensaver\n"
"\n"
"auth    include system-auth\n"
"account include system-account\n"
"\n"
"# End /etc/pam.d/xscreensaver</literal>\n"
"EOF</userinput>"
msgstr ""
"<userinput>cat &gt; /etc/pam.d/xscreensaver &lt;&lt; \"EOF\"\n"
"<literal># Inicia /etc/pam.d/xscreensaver\n"
"\n"
"auth    include system-auth\n"
"account include system-account\n"
"\n"
"# Termina /etc/pam.d/xscreensaver</literal>\n"
"EOF</userinput>"

