#, xml-text
msgid "Introduction to xarchiver"
msgstr "Introdução ao xarchiver"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/xsoft/other/xarchiver.xml:28
#, xml-text
msgid ""
"<application>XArchiver</application> is a <application>GTK+</application> "
"archive manager with support for tar, xz, bzip2, gzip, zip, 7z, rar, lzo and"
" many other archive formats."
msgstr ""
"<application>XArchiver</application> é um gerenciador "
"<application>GTK+</application> de arquivamentos com suporte para tar, xz, "
"bzip2, gzip, zip, 7z, rar, lzo e muitos outros formatos de arquivamento."

#. type: Content of: <sect1><sect2><note><para>
#: blfs-en/xsoft/other/xarchiver.xml:37
#, xml-text
msgid ""
"<application>xarchiver</application> is only a command line or graphical "
"interface to archiving utilities such as <application>tar</application> and "
"<application>zip</application>."
msgstr ""
"<application>xarchiver</application> é somente uma interface de linha de "
"comando ou gráfica para utilitários de arquivamento, como "
"<application>tar</application> e <application>zip</application>."

