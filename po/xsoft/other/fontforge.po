#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/xsoft/other/fontforge.xml:162
#, xml-text
msgid ""
"<parameter>-D CMAKE_BUILD_TYPE=Release</parameter>: This switch is used to "
"create an optimized release without debug information."
msgstr ""
"<parameter>-D CMAKE_BUILD_TYPE=Release</parameter>: Essa chave é usada para "
"criar um lançamento otimizado sem informações de depuração."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/xsoft/other/fontforge.xml:167
#, xml-text
msgid ""
"<parameter>-W no-author</parameter>: This switch is used to suppress "
"warnings intended for the package's developers."
msgstr ""
"<parameter>-W no-author</parameter>: Essa chave é usada para suprimir avisos"
" destinados para desenvolvedores(as) do pacote."

