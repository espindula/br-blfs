#. type: Content of: <sect1><sect2><title>
#: blfs-en/xsoft/other/tigervnc.xml:144
#, xml-text
msgid "Installation of Tigervnc"
msgstr "Instalação do Tigervnc"

#.  Replaces an incompatible PAM file and disables SELinux support
#.            in systemd units. Also modifies the search path for
#.            /usr/libexec/vncserver to include /etc/X11/tigervnc
#. type: Content of: <sect1><sect2><para>
#: blfs-en/xsoft/other/tigervnc.xml:147
#, xml-text
msgid ""
"First, make adjustments to the configuration files to make them compatible "
"with LFS systems:"
msgstr ""
"Primeiro, faça ajustes nos arquivos de configuração para torná-los "
"compatíveis com sistemas LFS:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/xsoft/other/tigervnc.xml:154
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"pre\">patch -Np1 -i ../tigervnc-&tigervnc-"
"version;-configuration_fixes-1.patch</userinput>"
msgstr ""
"<userinput remap=\"pre\">patch -Np1 -i ../tigervnc-&tigervnc-"
"version;-configuration_fixes-1.patch</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/xsoft/other/tigervnc.xml:157
#, xml-text
msgid "Now, make the package consistent with fltk-1.4.1 and later:"
msgstr "Agora, torne o pacote consistente com fltk-1.4.1 e posteriores:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/xsoft/other/tigervnc.xml:160
#, no-wrap, xml-text
msgid ""
"<userinput remap=\"pre\">sed -i \"s/maximize)/::&amp;/\"         vncviewer/DesktopWindow.cxx &amp;&amp;\n"
"sed -i \"/FL_MINOR_VERSION/s/3/4/\" CMakeLists.txt</userinput>"
msgstr ""
"<userinput remap=\"pre\">sed -i \"s/maximize)/::&amp;/\"         vncviewer/DesktopWindow.cxx &amp;&amp;\n"
"sed -i \"/FL_MINOR_VERSION/s/3/4/\" CMakeLists.txt</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/xsoft/other/tigervnc.xml:164
#, xml-text
msgid ""
"Install <application>tigervnc</application> by running the following "
"commands:"
msgstr ""
"Instale o <application>tigervnc</application> executando os seguintes "
"comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/xsoft/other/tigervnc.xml:168
#, no-wrap, xml-text
msgid ""
"<userinput># Put code in place\n"
"mkdir -p unix/xserver &amp;&amp;\n"
"tar -xf ../xorg-server-&xorg-server-version;.tar.xz \\\n"
"    --strip-components=1              \\\n"
"    -C unix/xserver                   &amp;&amp;\n"
"( cd unix/xserver &amp;&amp;\n"
"  patch -Np1 -i ../xserver21.patch ) &amp;&amp;\n"
"\n"
"# Build viewer\n"
"cmake -G \"Unix Makefiles\"          \\\n"
"      -D CMAKE_INSTALL_PREFIX=/usr \\\n"
"      -D CMAKE_BUILD_TYPE=Release  \\\n"
"      -D INSTALL_SYSTEMD_UNITS=OFF \\\n"
"      -W no-dev .                  &amp;&amp;\n"
"make &amp;&amp;\n"
"\n"
"# Build server\n"
"pushd unix/xserver &amp;&amp;\n"
"  autoreconf -fiv  &amp;&amp;\n"
"\n"
"  CPPFLAGS=\"-I/usr/include/drm\"       \\\n"
"  ./configure $XORG_CONFIG            \\\n"
"      --disable-xwayland    --disable-dri        --disable-dmx         \\\n"
"      --disable-xorg        --disable-xnest      --disable-xvfb        \\\n"
"      --disable-xwin        --disable-xephyr     --disable-kdrive      \\\n"
"      --disable-devel-docs  --disable-config-hal --disable-config-udev \\\n"
"      --disable-unit-tests  --disable-selective-werror                 \\\n"
"      --disable-static      --enable-dri3                              \\\n"
"      --without-dtrace      --enable-dri2        --enable-glx          \\\n"
"      --with-pic &amp;&amp;\n"
"  make  &amp;&amp;\n"
"popd</userinput>"
msgstr ""
"<userinput># Put code in place\n"
"mkdir -p unix/xserver &amp;&amp;\n"
"tar -xf ../xorg-server-&xorg-server-version;.tar.xz \\\n"
"    --strip-components=1              \\\n"
"    -C unix/xserver                   &amp;&amp;\n"
"( cd unix/xserver &amp;&amp;\n"
"  patch -Np1 -i ../xserver21.patch ) &amp;&amp;\n"
"\n"
"# Build viewer\n"
"cmake -G \"Unix Makefiles\"          \\\n"
"      -D CMAKE_INSTALL_PREFIX=/usr \\\n"
"      -D CMAKE_BUILD_TYPE=Release  \\\n"
"      -D INSTALL_SYSTEMD_UNITS=OFF \\\n"
"      -W no-dev .                  &amp;&amp;\n"
"make &amp;&amp;\n"
"\n"
"# Build server\n"
"pushd unix/xserver &amp;&amp;\n"
"  autoreconf -fiv  &amp;&amp;\n"
"\n"
"  CPPFLAGS=\"-I/usr/include/drm\"       \\\n"
"  ./configure $XORG_CONFIG            \\\n"
"      --disable-xwayland    --disable-dri        --disable-dmx         \\\n"
"      --disable-xorg        --disable-xnest      --disable-xvfb        \\\n"
"      --disable-xwin        --disable-xephyr     --disable-kdrive      \\\n"
"      --disable-devel-docs  --disable-config-hal --disable-config-udev \\\n"
"      --disable-unit-tests  --disable-selective-werror                 \\\n"
"      --disable-static      --enable-dri3                              \\\n"
"      --without-dtrace      --enable-dri2        --enable-glx          \\\n"
"      --with-pic &amp;&amp;\n"
"  make  &amp;&amp;\n"
"popd</userinput>"

