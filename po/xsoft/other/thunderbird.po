"linkend=\"libevent\"/>, <xref linkend=\"libvpx\"/>, <xref "
"linkend=\"libwebp\"/>, <xref linkend=\"nasm\"/>, <xref linkend=\"nspr\"/>, "
"and <xref linkend=\"nss\"/>"
