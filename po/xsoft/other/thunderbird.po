#, xml-text
#~ msgid ""
#~ "Adapt the shipped <application>rust-bindgen</application> copy for LLVM-18 "
#~ "and later, and tell <command>cargo</command> we've modified the code of "
#~ "<application>rust-bindgen</application> so the checksum verification of this"
#~ " crate should be skipped:"
#~ msgstr ""
#~ "Adapte a cópia enviada do <application>rust-bindgen</application> para "
#~ "LLVM-18 e posterior e informe ao <command>cargo</command> que nós "
#~ "modificamos o código do <application>rust-bindgen</application>, de forma "
#~ "que a verificação da soma de verificação dessa caixa deva ser ignorada:"

#, no-wrap, xml-text
#~ msgid ""
#~ "<userinput>sed -e \"/match cursor.kind()/a                                    \\\n"
#~ "        CXCursor_LinkageSpec => return Err(ParseError::Recurse),\" \\\n"
#~ "    -i third_party/rust/bindgen/ir/item.rs                        &amp;&amp;\n"
#~ "\n"
#~ "cat &gt;&gt; Cargo.toml &lt;&lt; EOF &amp;&amp;\n"
#~ "<literal>[patch.crates-io.bindgen_0_64_0]\n"
#~ "package = \"bindgen\"\n"
#~ "version = \"0.64.0\"\n"
#~ "path = \"third_party/rust/bindgen\"</literal>\n"
#~ "EOF\n"
#~ "\n"
#~ "sed -r '/name = \"bindgen\"/,+5 s/^source|^checksum/#&amp;/' \\\n"
#~ "    -i Cargo.lock</userinput>"
#~ msgstr ""
#~ "<userinput>sed -e \"/match cursor.kind()/a                                    \\\n"
#~ "        CXCursor_LinkageSpec => return Err(ParseError::Recurse),\" \\\n"
#~ "    -i third_party/rust/bindgen/ir/item.rs                        &amp;&amp;\n"
#~ "\n"
#~ "cat &gt;&gt; Cargo.toml &lt;&lt; EOF &amp;&amp;\n"
#~ "<literal>[patch.crates-io.bindgen_0_64_0]\n"
#~ "package = \"bindgen\"\n"
#~ "version = \"0.64.0\"\n"
#~ "path = \"third_party/rust/bindgen\"</literal>\n"
#~ "EOF\n"
#~ "\n"
#~ "sed -r '/name = \"bindgen\"/,+5 s/^source|^checksum/#&amp;/' \\\n"
#~ "    -i Cargo.lock</userinput>"

