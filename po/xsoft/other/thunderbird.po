#, xml-text
#~ msgid ""
#~ "A change in cbindgen-0.24.2 causes a symbol to now be output by cbindgen, "
#~ "but it has already been defined in a header. This sed prevents the build "
#~ "from eventually failing:"
#~ msgstr ""
#~ "Uma mudança em cbindgen-0.24.2 faz com que um símbolo seja agora gerado pelo"
#~ " cbindgen, mas ele já foi definido em um cabeçalho. Este sed evita que a "
#~ "construção eventualmente falhe:"

#, no-wrap, xml-text
#~ msgid ""
#~ "<userinput>sed -i '/ROOT_CLIP_CHAIN/d' "
#~ "gfx/webrender_bindings/webrender_ffi.h</userinput>"
#~ msgstr ""
#~ "<userinput>sed -i '/ROOT_CLIP_CHAIN/d' "
#~ "gfx/webrender_bindings/webrender_ffi.h</userinput>"

