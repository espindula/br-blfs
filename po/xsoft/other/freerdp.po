#. type: Content of: <sect1><sect2><title>
#: blfs-en/xsoft/other/freerdp.xml:110
#, xml-text
msgid "Installation of FreeRDP"
msgstr "Instalação do FreeRDP"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/xsoft/other/freerdp.xml:113
#, xml-text
msgid ""
"Install <application>FreeRDP</application> by running the following "
"commands:"
msgstr ""
"Instale <application>FreeRDP</application> executando os seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/xsoft/other/freerdp.xml:117
#, no-wrap, xml-text
msgid ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr   \\\n"
"      -D CMAKE_SKIP_INSTALL_RPATH=ON \\\n"
"      -D CMAKE_BUILD_TYPE=Release    \\\n"
"      -D WITH_CAIRO=ON               \\\n"
"      -D WITH_CLIENT_SDL=OFF         \\\n"
"      -D WITH_DSP_FFMPEG=ON          \\\n"
"      -D WITH_FFMPEG=ON              \\\n"
"      -D WITH_PCSC=OFF               \\\n"
"      -D WITH_SERVER=ON              \\\n"
"      -D WITH_SERVER_CHANNELS=ON     \\\n"
"      -D DOCBOOKXSL_DIR=/usr/share/xml/docbook/xsl-stylesheets-nons-&docbook-xsl-version; \\\n"
"      -W no-dev                      \\\n"
"      -G Ninja ..                    &amp;&amp;\n"
"ninja</userinput>"
msgstr ""
"<userinput>mkdir build &amp;&amp;\n"
"cd    build &amp;&amp;\n"
"\n"
"cmake -D CMAKE_INSTALL_PREFIX=/usr   \\\n"
"      -D CMAKE_SKIP_INSTALL_RPATH=ON \\\n"
"      -D CMAKE_BUILD_TYPE=Release    \\\n"
"      -D WITH_CAIRO=ON               \\\n"
"      -D WITH_CLIENT_SDL=OFF         \\\n"
"      -D WITH_DSP_FFMPEG=ON          \\\n"
"      -D WITH_FFMPEG=ON              \\\n"
"      -D WITH_PCSC=OFF               \\\n"
"      -D WITH_SERVER=ON              \\\n"
"      -D WITH_SERVER_CHANNELS=ON     \\\n"
"      -D DOCBOOKXSL_DIR=/usr/share/xml/docbook/xsl-stylesheets-nons-&docbook-xsl-version; \\\n"
"      -W no-dev                      \\\n"
"      -G Ninja ..                    &amp;&amp;\n"
"ninja</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/xsoft/other/freerdp.xml:136
#, xml-text
msgid "This package does not come with a test suite."
msgstr "Esse pacote não vem com uma suíte de teste."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/xsoft/other/freerdp.xml:140
#, xml-text
msgid "Now, as the &root; user:"
msgstr "Agora, como o(a) usuário(a) &root;:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/xsoft/other/freerdp.xml:143
#, no-wrap, xml-text
msgid "<userinput>ninja install</userinput>"
msgstr "<userinput>ninja install</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/xsoft/other/freerdp.xml:148
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/xsoft/other/freerdp.xml:154
#, xml-text
msgid ""
"<parameter>-D DOCBOOKXSL_DIR=/usr/share/xml/docbook/xsl-stylesheets-"
"nons-&docbook-xsl-version;</parameter>: This parameter points CMake to the "
"location of the Docbook XSL stylesheets, and is needed because BLFS does not"
" use namespaced versions of the stylesheets. This is needed to create man "
"pages. If you do not want manpages, pass -D WITH_MANPAGES=OFF to CMake "
"instead."
msgstr ""
"<parameter>-D DOCBOOKXSL_DIR=/usr/share/xml/docbook/xsl-stylesheets-"
"nons-&docbook-xsl-version;</parameter>: Esse parâmetro aponta CMake para o "
"local das folhas de estilo XSL do Docbook e é necessário porque o BLFS não "
"usa versões com espaço de nomes das folhas de estilo. Isso é necessário para"
" criar páginas de manual. Se você não quiser páginas de manual, passe -D "
"WITH_MANPAGES=OFF para o CMake."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/xsoft/other/freerdp.xml:162
#, xml-text
msgid ""
"<parameter>-D WITH_CAIRO=ON</parameter>: This parameter uses Cairo for "
"HighDPI and window resizing support."
msgstr ""
"<parameter>-D WITH_CAIRO=ON</parameter>: Esse parâmetro usa Cairo para "
"HighDPI e suporte ao redimensionamento de janelas."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/xsoft/other/freerdp.xml:167
#, xml-text
msgid ""
"<parameter>-D WITH_CLIENT_SDL=OFF</parameter>: This parameter disables using"
" SDL to draw the window when using the FreeRDP client. This is disabled "
"because it depends on <ulink url=\"https://github.com/libsdl-"
"org/SDL_ttf\">SDL_ttf</ulink>.  Remove this switch if you have the SDL_ttf "
"package installed."
msgstr ""
"<parameter>-D WITH_CLIENT_SDL=OFF</parameter>: Esse parâmetro desabilita "
"usar SDL para desenhar a janela ao usar o cliente FreeRDP. Isso é "
"desabilitado porque depende de <ulink url=\"https://github.com/libsdl-"
"org/SDL_ttf\">SDL_ttf</ulink>. Remova essa chave se você tiver o pacote "
"SDL_ttf instalado."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/xsoft/other/freerdp.xml:175
#, xml-text
msgid ""
"<parameter>-D WITH_FFMPEG=ON</parameter>: This parameter enables support for"
" using ffmpeg for the H.264 graphics rendering mode, which is required when "
"connecting via RDP to Windows Server 2012 (or Windows 8) or later hosts."
msgstr ""
"<parameter>-D WITH_FFMPEG=ON</parameter>: Esse parâmetro habilita suporte "
"para usar ffmpeg para o modo de renderização gráfica H.264, o qual é exigido"
" ao conectar-se via RDP a dispositivos Windows Server 2012 (ou Windows 8) ou"
" posteriores."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/xsoft/other/freerdp.xml:182
#, xml-text
msgid ""
"<parameter>-D WITH_DSP_FFMPEG=ON</parameter>: This parameter enables support"
" for using ffmpeg for sound and microphone redirection."
msgstr ""
"<parameter>-D WITH_DSP_FFMPEG=ON</parameter>: Esse parâmetro habilita "
"suporte para usar ffmpeg para redirecionamento de som e microfone."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/xsoft/other/freerdp.xml:187
#, xml-text
msgid ""
"<parameter>-D WITH_PCSC=OFF</parameter>: This parameter disables support for"
" SmartCards since BLFS does not have the required dependency for it."
msgstr ""
"<parameter>-D WITH_PCSC=OFF</parameter>: Esse parâmetro desabilita suporte "
"para SmartCards, pois o BLFS não tem a dependência exigida para ele."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/xsoft/other/freerdp.xml:192
#, xml-text
msgid ""
"<parameter>-D WITH_SERVER=ON</parameter>: This parameter enables building "
"the FreeRDP server components. Remove this parameter if you do not want to "
"use the FreeRDP server."
msgstr ""
"<parameter>-D WITH_SERVER=ON</parameter>: Esse parâmetro habilita construir "
"os componentes do servidor FreeRDP. Remova esse parâmetro se você não quiser"
" usar o servidor FreeRDP."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/xsoft/other/freerdp.xml:198
#, xml-text
msgid ""
"<parameter>-D WITH_SERVER_CHANNELS=ON</parameter>: This parameter builds "
"additional plugins for the FreeRDP server."
msgstr ""
"<parameter>-D WITH_SERVER_CHANNELS=ON</parameter>: Esse parâmetro constrói "
"plugins adicionais para o servidor FreeRDP."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/xsoft/other/freerdp.xml:203
#, xml-text
msgid ""
"<option>-D WITH_LAME=ON</option>: Use this option if you wish to enable "
"support for using LAME to provide MP3 Audio Codec support."
msgstr ""
"<option>-D WITH_LAME=ON</option>: Use essa opção se você desejar habilitar "
"suporte para usar LAME para fornecer suporte ao Codificador/Decodificador de"
" áudio MP3."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/xsoft/other/freerdp.xml:208
#, xml-text
msgid ""
"<option>-D WITH_FAAC=ON</option>: Use this option if you wish to enable "
"support for using FAAC to provide AAC Audio Codec support."
msgstr ""
"<option>-D WITH_FAAC=ON</option>: Use essa opção se você desejar habilitar "
"suporte para usar FAAC para fornecer suporte ao Codificador/Decodificador de"
" áudio AAC."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/xsoft/other/freerdp.xml:213
#, xml-text
msgid ""
"<option>-D WITH_FAAD2=ON</option>: Use this option if you wish to enable "
"support for using FAAD2 to provide AAC Audio Codec support."
msgstr ""
"<option>-D WITH_FAAD2=ON</option>: Use essa opção se você desejar habilitar "
"suporte para usar FAAD2 para fornecer suporte ao Codificador/Decodificador "
"de áudio AAC."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/xsoft/other/freerdp.xml:218
#, xml-text
msgid ""
"<option>-D WITH_FDK_AAC=ON</option>: Use this option if you wish to enable "
"support for using fdk-aac to provide AAC Audio Codec support."
msgstr ""
"<option>-D WITH_FDK_AAC=ON</option>: Use essa opção se você desejar "
"habilitar suporte para usar fdk-aac para fornecer suporte ao "
"Codificador/Decodificador de áudio AAC."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/xsoft/other/freerdp.xml:223
#, xml-text
msgid ""
"<option>-D WITH_MBEDTLS=ON</option>: Use this option if you have the "
"optional dependency <ulink url=\"https://github.com/Mbed-"
"TLS/mbedtls\">mbedTLS</ulink> installed and wish to use it as an alternative"
" to OpenSSL for cryptography support."
msgstr ""
"<option>-D WITH_MBEDTLS=ON</option>: Use essa opção se você tiver a "
"dependência opcional <ulink url=\"https://github.com/Mbed-"
"TLS/mbedtls\">mbedTLS</ulink> instalada e desejar usá-la como uma "
"alternativa ao OpenSSL para suporte de criptografia."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/xsoft/other/freerdp.xml:230
#, xml-text
msgid ""
"<option>-D WITH_OPENCL=ON</option>: Use this option if you have the optional"
" dependency <ulink url=\"https://github.com/OCL-dev/ocl-icd\">ocl-"
"icd</ulink> installed and wish to use OpenCL support."
msgstr ""
"<option>-D WITH_OPENCL=ON</option>: Use essa opção se você tiver a "
"dependência opcional <ulink url=\"https://github.com/OCL-dev/ocl-icd\">ocl-"
"icd</ulink> instalada e desejar usar suporte a OpenCL."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/xsoft/other/freerdp.xml:237
#, xml-text
msgid ""
"<option>-D WITH_OPENH264=ON</option>: Use this option if you have the "
"optional dependency <ulink "
"url=\"https://www.openh264.org/\">openh264</ulink> installed and wish to use"
" it for H.264 support instead of ffmpeg."
msgstr ""
"<option>-D WITH_OPENH264=ON</option>: Use essa opção se você tiver a "
"dependência opcional <ulink "
"url=\"https://www.openh264.org/\">openh264</ulink> instalada e desejar usá-"
"la para suporte a H.264 em vez do ffmpeg."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/xsoft/other/freerdp.xml:244
#, xml-text
msgid ""
"<option>-D WITH_GSM=ON</option>: Use this option if you have the optional "
"dependency <ulink url=\"https://www.quut.com/gsm/\">GSM</ulink> installed "
"and wish to use GSM as an audio codec."
msgstr ""
"<option>-D WITH_GSM=ON</option>: Use essa opção se você tiver a dependência "
"opcional <ulink url=\"https://www.quut.com/gsm/\">GSM</ulink> instalada e "
"desejar usar GSM como um codificador/decodificador de áudio."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/xsoft/other/freerdp.xml:250
#, xml-text
msgid ""
"<option>-D WITH_SOXR=ON</option>: Use this option if you have the optional "
"dependency <ulink url=\"https://github.com/chirlu/soxr\">soxr</ulink> "
"installed and wish to use it instead of ffmpeg for multimedia redirection."
msgstr ""
"<option>-D WITH_SOXR=ON</option>: Use essa opção se você tiver a dependência"
" opcional <ulink url=\"https://github.com/chirlu/soxr\">soxr</ulink> "
"instalada e desejar usá-la em vez do ffmpeg para redirecionamento de "
"multimídia."

