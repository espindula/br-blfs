#.  en can be built without this
#. type: Content of: <sect1><sect2><para>
#: blfs-en/xsoft/other/gimp.xml:117
#, xml-text
msgid ""
"<xref linkend=\"appstream-glib\"/>, <xref linkend=\"gegl\"/>, <xref "
"linkend=\"gexiv2\"/>, <xref linkend=\"glib-networking\"/>, <xref "
"linkend=\"gtk3\"/>, <xref linkend=\"harfbuzz\"/>, <xref "
"linkend=\"libmypaint\"/>, <xref linkend=\"librsvg\"/>, <xref "
"linkend=\"libtiff\"/>, <xref linkend=\"libxml2\"/> (to build the translated "
"help files), <xref linkend=\"lcms2\"/>, <xref linkend=\"mypaint-brushes\"/>,"
" and <xref linkend=\"poppler\"/> (including poppler-data)"
msgstr ""
"<xref linkend=\"appstream-glib\"/>, <xref linkend=\"gegl\"/>, <xref "
"linkend=\"gexiv2\"/>, <xref linkend=\"glib-networking\"/>, <xref "
"linkend=\"gtk3\"/>, <xref linkend=\"harfbuzz\"/>, <xref "
"linkend=\"libmypaint\"/>, <xref linkend=\"librsvg\"/>, <xref "
"linkend=\"libtiff\"/>, <xref linkend=\"libxml2\"/> (para construir os "
"arquivos da ajuda traduzida), <xref linkend=\"lcms2\"/>, <xref "
"linkend=\"mypaint-brushes\"/> e <xref linkend=\"poppler\"/> (incluindo "
"poppler-data)"

#. type: Content of: <sect1><sect2><bridgehead>
#: blfs-en/xsoft/other/gimp.xml:133
#, xml-text
