msgstr "Instalação do rxvt-unicode"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/xsoft/other/rxvt-unicode.xml:103
#, xml-text
msgid "First, remove a function that conflicts with C++23 definitions:"
msgstr "Primeiro, remova uma função que conflita com definições C++23:"

