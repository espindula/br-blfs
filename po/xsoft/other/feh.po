#. type: Content of: <sect1><sect2><title>
#: blfs-en/xsoft/other/feh.xml:133
#, xml-text
msgid "Installation of feh"
msgstr "Instalação do feh"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/xsoft/other/feh.xml:147
#, xml-text
msgid ""
"Install <application>feh</application> by running the following commands:"
msgstr ""
"Instale o <application>feh</application> executando os seguintes comandos:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/xsoft/other/feh.xml:150
#, no-wrap, xml-text
msgid ""
"<userinput>sed -i \"s:doc/feh:&amp;-&feh-version;:\" config.mk &amp;&amp;\n"
"make PREFIX=/usr</userinput>"
msgstr ""
"<userinput>sed -i \"s:doc/feh:&amp;-&feh-version;:\" config.mk &amp;&amp;\n"
"make PREFIX=/usr</userinput>"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/xsoft/other/feh.xml:154
#, xml-text
msgid "To test the results, issue: <command>make test</command>."
msgstr "Para testar os resultados, emita: <command>make test</command>."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/xsoft/other/feh.xml:158
#, xml-text
msgid "Now, as the <systemitem class=\"username\">root</systemitem> user:"
msgstr ""
"Agora, como o(a) usuário(a) <systemitem "
"class=\"username\">root</systemitem>:"

#. type: Content of: <sect1><sect2><screen>
#: blfs-en/xsoft/other/feh.xml:161
#, no-wrap, xml-text
msgid "<userinput>make PREFIX=/usr install</userinput>"
msgstr "<userinput>make PREFIX=/usr install</userinput>"

#. type: Content of: <sect1><sect2><title>
#: blfs-en/xsoft/other/feh.xml:166
#, xml-text
msgid "Command Explanations"
msgstr "Explicações do Comando"

#. type: Content of: <sect1><sect2><para>
#: blfs-en/xsoft/other/feh.xml:169
#, xml-text
msgid ""
"<command>sed -i \"s:doc/feh:&amp;-&feh-version;:\" config.mk</command>: This"
" sed fixes the doc directory to a versioned one, as used in BLFS."
msgstr ""
"<command>sed -i \"s:doc/feh:&amp;-&feh-version;:\" config.mk</command>: Esse"
" sed corrige o diretório de documentação para um versionado, conforme usado "
"no BLFS."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/xsoft/other/feh.xml:174
#, xml-text
msgid ""
"<option>curl=0</option>: Use this make flag if you don't have the cURL "
"package installed."
msgstr ""
"<option>curl=0</option>: Use esse sinalizador do make se você não tiver o "
"pacote cURL instalado."

#. type: Content of: <sect1><sect2><para>
#: blfs-en/xsoft/other/feh.xml:179
#, xml-text
msgid ""
"<option>exif=1</option>: This make flag enables builtin Exif tag display "
"support."
msgstr ""
"<option>exif=1</option>: Esse sinalizador do make habilita suporte integrado"
" à exibição de rótulos Exif."

