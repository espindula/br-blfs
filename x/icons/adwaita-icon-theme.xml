<sect1 id="adwaita-icon-theme" xreflabel="adwaita-icon-theme-&adwaita-icon-theme-version;">
  <?dbhtml filename="adwaita-icon-theme.html"?>

  <title>adwaita-icon-theme-&adwaita-icon-theme-version;</title>

  <indexterm zone="adwaita-icon-theme">
    <primary sortas="a-adwaita-icon-theme">adwaita-icon-theme</primary>
  </indexterm>

  <sect2 role="package">
    <title>Introdução ao Tema de Ícones Adwaita</title>

    <para>
      O pacote <application>Tema de Ícones Adwaita</application> contém um tema de
ícones para aplicativos <application>GTK+ 3</application> e <application>GTK
4</application>.
    </para>

    &lfs121_checked;

    <bridgehead renderas="sect3">Informação do Pacote</bridgehead>
    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Transferência (HTTP): <ulink url="&adwaita-icon-theme-download-http;"/>
        </para>
      </listitem>
      <listitem>
        <para>
          Transferência (FTP): <ulink url="&adwaita-icon-theme-download-ftp;"/>
        </para>
      </listitem>
      <listitem>
        <para>
          Soma de verificação MD5 da transferência: &adwaita-icon-theme-md5sum;
        </para>
      </listitem>
      <listitem>
        <para>
          Tamanho da transferência: &adwaita-icon-theme-size;
        </para>
      </listitem>
      <listitem>
        <para>
          Espaço em disco estimado exigido: &adwaita-icon-theme-buildsize;
        </para>
      </listitem>
      <listitem>
        <para>
          Tempo de construção estimado: &adwaita-icon-theme-time;
        </para>
      </listitem>
    </itemizedlist>

    <bridgehead renderas="sect3">Dependências do &quot;Tema de Ícone Adwaita&quot;</bridgehead>

    <bridgehead renderas="sect4">Required</bridgehead>
    <para role="required">
      <!-- Meson now unconditionally runs gtk-update-icon-cache and
           gtk-encode-symbolic-svg after installing. See
           https://lists.linuxfromscratch.org/sympa/arc/blfs-dev/2023-09/msg00128.html -->
<xref linkend="gtk3"/> ou <xref role="nodep" linkend="gtk4"/> e <xref
linkend="librsvg"/>
      
    </para>

    <bridgehead renderas="sect4">Opcionais</bridgehead>
    <para role="optional">
      <!--
      <xref linkend="gtk4"/>
 or <xref linkend="gtk3"/>
      (if present, <xref linkend="librsvg"/> is also
      required, and <command>gtk-update-icon-cache
      </command> and <command>gtk-encode-symbolic-svg</command> are run
      after installing),
-->
<xref linkend="git"/>, <xref linkend="inkscape"/> e <ulink
url="https://launchpad.net/icontool/">Ferramentas de Ícones</ulink>
    </para>

  </sect2>

  <sect2 role="installation">
    <title>Instalação do Tema de Ícones Adwaita</title>

    <para>
      Instale o &quot;<application>Tema de Ícone Adwaita</application>&quot;
executando os seguintes comandos:
    </para>

<screen><userinput>mkdir build &amp;&amp;
cd    build &amp;&amp;

meson setup --prefix=/usr .. &amp;&amp;
ninja</userinput></screen>

    <para>
      Esse pacote não vem com uma suíte de teste.
    </para>

    <para>
      Agora, como o(a) usuário(a) &quot;<systemitem
class="username">root</systemitem>&quot;:
    </para>

<screen role="root"><userinput>ninja install</userinput></screen>

  </sect2>

