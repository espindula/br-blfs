    <bridgehead renderas="sect3">Dependências de libcairomm-1.16</bridgehead>

    <bridgehead renderas="sect4">Exigidas</bridgehead>
    <para role="required">
      <xref linkend="cairo"/> e <xref linkend="libsigc3"/>
    </para>

    <bridgehead renderas="sect4">Recomendadas</bridgehead>
