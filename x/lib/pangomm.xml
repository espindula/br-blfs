          /usr/include/pangomm-1.4, /usr/lib/pangomm-1.4 e
/usr/share/{devhelp/books/pangomm-1.4,doc/pangomm-&pangomm-version;}
        </seg>
      </seglistitem>
    </segmentedlist>

