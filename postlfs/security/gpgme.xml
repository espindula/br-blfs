  <sect2 role="installation">
    <title>Instalação do gpgme</title>

    <para>
      Instale <application>gpgme</application> executando os seguintes comandos:
    </para>

<screen><userinput>mkdir build &amp;&amp;
cd    build &amp;&amp;

../configure --prefix=/usr --disable-static    &amp;&amp;
make</userinput></screen>

    <para>
      Para testar os resultados, você deveria ter <xref linkend="gnupg2"/>
instalado. Se sim, execute:
    </para>

<screen remap='test'><userinput>make -k check</userinput></screen>

    <para>
      Agora, como o(a) usuário(a) &root;:
    </para>

<screen role="root"><userinput>make install</userinput></screen>

  </sect2>

  <sect2 role="commands">
    <title>Explicações do Comando</title>

    <xi:include xmlns:xi="http://www.w3.org/2001/XInclude"
      href="../../xincludes/static-libraries.xml"/>

    <para>
      <option>--disable-gpg-test</option>: Use essa chave se <xref
linkend="gnupg2"/> não estiver instalado.
    </para>

  </sect2>
  <sect2 role="content">
    <title>Conteúdo</title>

    <segmentedlist>
      <segtitle>Aplicativo Instalado</segtitle>
      <segtitle>Bibliotecas Instaladas</segtitle>
      <segtitle>Diretório Instalado</segtitle>

      <seglistitem>
        <seg>
          gnupg-key-manage, gpgme-json e gpgme-tool
        </seg>
        <seg>
          libgpgme.so
        </seg>
        <seg>
          /usr/share/common-lisp/source/gpgme
        </seg>
      </seglistitem>
    </segmentedlist>

    <variablelist>
      <bridgehead renderas="sect3">Descrições Curtas</bridgehead>
      <?dbfo list-presentation="list"?> <?dbhtml list-presentation="table"?>

      <varlistentry id="gnupg-key-manage">
        <term><command>gnupg-key-manage</command></term>
        <listitem>
          <para>
            realiza uma variedade de operações sobre chaves GPG, incluindo identificar
chaves e deleção delas
          </para>
          <indexterm zone="gpgme gnupg-key-manage">
            <primary sortas="b-gnupg-key-manage">gnupg-key-manage</primary>
          </indexterm>
        </listitem>
      </varlistentry>

      <varlistentry id="gpgme-json">
        <term><command>gpgme-json</command></term>
        <listitem>
          <para>
            gera comandos <application>gpgme</application> no formato JSON
          </para>
          <indexterm zone="gpgme gpgme-json">
            <primary sortas="b-gpgme-json">gpgme-json</primary>
          </indexterm>
        </listitem>
      </varlistentry>

      <varlistentry id="gpgme-tool">
        <term><command>gpgme-tool</command></term>
        <listitem>
          <para>
            é um servidor assuan que expõe operações <application>gpgme</application>,
como impressão de impressões digitais e identificadores de chave com
servidores de chaves
          </para>
          <indexterm zone="gpgme gpgme-tool">
            <primary sortas="b-gpgme-tool">ferramenta gpgme</primary>
          </indexterm>
        </listitem>
      </varlistentry>

      <varlistentry id="libgpgme">
        <term><filename class="libraryfile">libgpgme.so</filename></term>
        <listitem>
          <para>
            contém as funções da API do <application>gpgme</application>
          </para>
          <indexterm zone="gpgme libgpgme">
            <primary sortas="c-libgpgme">libgpgme.so</primary>
          </indexterm>
        </listitem>
      </varlistentry>

    </variablelist>

  </sect2>

</sect1>
