<sect1 id="gedit" xreflabel="Gedit-&gedit-version;">
  <?dbhtml filename="gedit.html"?>

  <title>Gedit-&gedit-version;</title>

  <indexterm zone="gedit">
    <primary sortas="a-Gedit">Gedit</primary>
  </indexterm>

  <sect2 role="package">
    <title>Introdução ao Gedit</title>

    <para>
      O pacote <application>Gedit</application> contém um editor leve de texto
UTF-8 para a área de trabalho do <application>GNOME</application>. Ele
precisa de um grupo de pacotes para ser instalado antes do
<application>Gedit</application> em si. Esta página instalará todos eles.
    </para>

    &lfs130_checked;

    <bridgehead renderas="sect3">Informação do Pacote</bridgehead>
    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Transferência (HTTP): <ulink url="&gedit-download-http;"/>
        </para>
      </listitem>
      <listitem>
        <para>
          Tamanho da transferência: &gedit-size;
        </para>
      </listitem>
      <listitem>
        <para>
          Espaço em disco estimado exigido: &gedit-buildsize;
        </para>
      </listitem>
      <listitem>
        <para>
          Tempo de construção estimado: &gedit-time;
        </para>
      </listitem>
    </itemizedlist>

