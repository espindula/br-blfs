<sect1 id="kate" xreflabel="kate-&kf6apps-version;">
  <?dbhtml filename="kate.html"?>


  <title>kate-&kf6apps-version;</title>

  <indexterm zone="kate">
    <primary sortas="a-Kate">Kate</primary>
  </indexterm>

  <sect2 role="package">
    <title>Introdução ao Kate</title>

    <para>
      O pacote <application>Kate</application> contém um editor de textos, gráfico
e avançado, baseado no KDE Frameworks.
    </para>

    &lfs130_checked;

    <bridgehead renderas="sect3">Informação do Pacote</bridgehead>
    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Transferência (HTTP): <ulink url="&kate-download-http;"/>
        </para>
      </listitem>
      <listitem>
        <para>
          Transferência (FTP): <ulink url="&kate-download-ftp;"/>
        </para>
      </listitem>
      <listitem>
        <para>
          Soma de verificação MD5 da transferência: &kate-md5sum;
        </para>
      </listitem>
      <listitem>
        <para>
          Tamanho da transferência: &kate-size;
        </para>
      </listitem>
      <listitem>
        <para>
          Espaço em disco estimado exigido: &kate-buildsize;
        </para>
      </listitem>
      <listitem>
        <para>
          Tempo de construção estimado: &kate-time;
        </para>
      </listitem>
    </itemizedlist>

    <bridgehead renderas="sect3">Dependências do Kate</bridgehead>

