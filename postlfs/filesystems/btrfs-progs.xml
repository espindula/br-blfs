          <indexterm zone="btrfs-progs btrfs-map-logical">
            <primary sortas="b-btrfs-map-logical">btrfs-map-logical</primary>
          </indexterm>
        </listitem>
      </varlistentry>

      <varlistentry id="btrfs-select-super">
        <term><command>btrfs-select-super</command></term>
