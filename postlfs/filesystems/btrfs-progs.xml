      <varlistentry id="mkfs.btrfs">
        <term><command>mkfs.btrfs</command></term>
        <listitem>
          <para>
            cria um sistema de arquivos btrfs
          </para>
          <indexterm zone="btrfs-progs mkfs.btrfs">
            <primary sortas="b-mkfs.btrfs">mkfs.btrfs</primary>
