      <seglistitem>
        <seg>
          btrfs, btrfs-convert, btrfs-find-root, btrfs-image, btrfs-map-logical,
btrfs-select-super, btrfsck (link para btrfs), btrfstune, fsck.btrfs e
mkfs.btrfs
        </seg>

        <seg>
