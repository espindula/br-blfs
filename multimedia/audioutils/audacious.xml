    <bridgehead renderas="sect4">Exigidas</bridgehead>
    <para role="required">
      <xref role="nodep" linkend="gtk2"/> ou <xref linkend="gtk3"/> ou (<xref
role="nodep" linkend="qt5"/> ou <xref linkend="qt5-components"/> com
qtmultimedia)
    </para>

    <bridgehead renderas="sect4">Recomendadas</bridgehead>
    <para role="optional">
      <xref linkend="libarchive"/>
    </para>

    <bridgehead renderas="sect4">Opcionais</bridgehead>
    <para role="optional">
      <xref linkend="valgrind"/>
    </para>

    <bridgehead renderas="sect4">Recomendadas (para Plugins)</bridgehead>
    <para role="recommended">
      <xref linkend="mpg123"/>, <xref linkend="ffmpeg"/> e <xref linkend="neon"/>
(para mp3 online e rádio ogg)
