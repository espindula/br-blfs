<sect1 id="dav1d" xreflabel="dav1d-&dav1d-version;">
  <?dbhtml filename="dav1d.html"?>

  <title>dav1d-&dav1d-version;</title>

  <indexterm zone="dav1d">
    <primary sortas="a-dav1d">dav1d</primary>
  </indexterm>

  <sect2 role="package">
    <title>Introdução ao dav1d</title>

    <para>
      O pacote dav1d contém um decodificador de AV1.
    </para>

    &lfs130_checked;

    <bridgehead renderas="sect3">Informação do Pacote</bridgehead>
    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Transferência (HTTP): <ulink url="&dav1d-download-http;"/>
        </para>
      </listitem>
      <listitem>
        <para>
          Transferência (FTP): <ulink url="&dav1d-download-ftp;"/>
        </para>
      </listitem>
      <listitem>
        <para>
          Soma de verificação MD5 da transferência: &dav1d-md5sum;
        </para>
      </listitem>
      <listitem>
        <para>
          Tamanho da transferência: &dav1d-size;
        </para>
      </listitem>
      <listitem>
        <para>
          Espaço em disco estimado exigido: &dav1d-buildsize;
        </para>
      </listitem>
      <listitem>
        <para>
          Tempo de construção estimado: &dav1d-time;
        </para>
      </listitem>
    </itemizedlist>

    <bridgehead renderas="sect3">Dependências do dav1d</bridgehead>

    <bridgehead renderas="sect4">Recomendadas</bridgehead>
    <para role="recommended">
      <xref linkend="nasm"/>
    </para>

    <bridgehead renderas="sect4">Opcionais</bridgehead>
    <para role="optional">
      <ulink url="https://xxhash.com/">xxhash</ulink>
    </para>

  </sect2>

  <sect2 role="installation">
    <title>Instalação do dav1d</title>

    <para>
      Instale dav1d executando os seguintes comandos:
    </para>

<screen><userinput>mkdir build &amp;&amp;
cd    build &amp;&amp;

meson setup --prefix=/usr --buildtype=release --wrap-mode=nofallback .. &amp;&amp;
ninja</userinput></screen>

    <para>
      Para testar os resultados, execute <command>ninja test</command>.
    </para>

    <para>
      Agora, como o(a) usante &root;:
    </para>

<screen role="root"><userinput>ninja install</userinput></screen>

  </sect2>

