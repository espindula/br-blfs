<!-- Try to keep the indentation used in this file-->
<sect1 id="libde265" xreflabel="libde265-&libde265-version;">
  <?dbhtml filename="libde265.html"?>

  <title>libde265-&libde265-version;</title>

  <!--Required section-->
<indexterm zone="libde265">
    <primary sortas="a-libde265">libde265</primary>
  </indexterm>

  
  <sect2 role="package">
    <title>Introdução ao libde265</title>

    <para>
      O pacote <application>libde265</application> contém uma implementação de
fonte aberta de codificador/decodificador de vídeo H.265.
    </para>

    &lfs130_checked;

    <bridgehead renderas="sect3">Informação do Pacote</bridgehead>
    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Transferência (HTTP): <ulink url="&libde265-download-http;"/>
        </para>
      </listitem>
      <listitem>
        <para>
          Soma de verificação MD5 da transferência: &libde265-md5sum;
        </para>
      </listitem>
      <listitem>
        <para>
          Tamanho da transferência: &libde265-size;
        </para>
      </listitem>
      <listitem>
        <para>
          Espaço em disco estimado exigido: &libde265-buildsize;
        </para>
      </listitem>
      <listitem>
        <para>
          Tempo de construção estimado: &libde265-time;
        </para>
      </listitem>
    </itemizedlist>

    <bridgehead renderas="sect3">Dependências do libde265</bridgehead>

    <bridgehead renderas="sect4">Exigidas</bridgehead>
    <para role="required">
      <xref linkend="cmake"/>
    </para>

    <bridgehead renderas="sect4">Opcionais</bridgehead>
    <para role="optional">
      <xref linkend="sdl2"/> (para suporte de saída de sobreposição YUV do
<command>dec265</command>), ambos <ulink
url="https://&lfs-domainname;/blfs/view/12.2/x/qt5-components.html">Qt
5</ulink> e <xref linkend="ffmpeg"/> (para construir
<command>sherlock265</command>)
    </para>

    
  <!--  Only use this if you want to note something in the wiki
    <para condition="html" role="usernotes">

      Editor Notes: <ulink url="&blfs-wiki;/libde265"/>
    </para>
    -->
</sect2>

  
  <!--Required section-->
<sect2 role="installation">
    <title>Instalação do libde265</title>

    <para>
      Instale <application>libde265</application> executando os seguintes
comandos:
    </para>

<!-- The README.md file mentions a "testdata" directory but I cannot
         find it in the tarball.  -->
<screen><userinput>mkdir build &amp;&amp;
cd    build &amp;&amp;

cmake -D CMAKE_INSTALL_PREFIX=/usr \
      -D CMAKE_BUILD_TYPE=Release  \
      .. &amp;&amp;
make</userinput></screen>

    
    <para>
      Esse pacote não vem com uma suíte de teste.
    </para>

    <para>
      Agora, como o(a) usuário(a) &root;:
    </para>

<screen role="root"><userinput>make install</userinput></screen>
  </sect2>

