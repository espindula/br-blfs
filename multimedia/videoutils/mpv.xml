<sect1 id="mpv" xreflabel="mpv-&mpv-version;">
  <?dbhtml filename="mpv.html"?>

  <title>mpv-&mpv-version;</title>

  <indexterm zone="mpv">
    <primary sortas="a-mpv">mpv</primary>
  </indexterm>

  <sect2 role="package">
    <title>Introdução ao mpv</title>

    <para>
      <application>mpv</application> é um reprodutor de mídia livre para a linha
de comando. Ele suporta uma ampla variedade de formatos de arquivos de
mídia, codificadores de áudio e vídeo e tipos de legendas.
    </para>

    &lfs131_checked;

    <bridgehead renderas="sect3">Informação do Pacote</bridgehead>
    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Transferência (HTTP): <ulink url="&mpv-download-http;"/>
        </para>
      </listitem>
      <listitem>
        <para>
          Transferência (FTP): <ulink url="&mpv-download-ftp;"/>
        </para>
      </listitem>
      <listitem>
        <para>
          Soma de verificação MD5 da transferência: &mpv-md5sum;
        </para>
      </listitem>
      <listitem>
        <para>
          Tamanho da transferência: &mpv-size;
        </para>
      </listitem>
      <listitem>
        <para>
          Espaço em disco estimado exigido: &mpv-buildsize;
        </para>
      </listitem>
      <listitem>
        <para>
          Tempo de construção estimado: &mpv-time;
        </para>
      </listitem>
    </itemizedlist>

    <bridgehead renderas="sect3">Dependências do mpv</bridgehead>

    <bridgehead renderas="sect4">Exigidas</bridgehead>
    <para role="required">
      <xref linkend="alsa-lib"/>, <xref linkend="ffmpeg"/>, <xref
linkend="libass"/>, <xref linkend="libplacebo"/>, <xref linkend="mesa"/> e
<xref linkend="pulseaudio"/>
    </para>

    <bridgehead renderas="sect4">Recomendadas</bridgehead>
    <para role="recommended">
      <xref linkend="libjpeg"/>, <xref linkend="libva"/>, <xref
linkend="luajit"/>, <xref linkend="uchardet"/> e <xref
linkend="vulkan-loader"/>
    </para>

    <bridgehead renderas="sect4">Controladores e Bibliotecas Opcionais de Entrada</bridgehead>
    <para role="optional">
      <xref linkend="libdvdcss"/>, <xref linkend="libdvdread"/>, <xref
linkend="libdvdnav"/> e <ulink
url="https://www.videolan.org/developers/libbluray.html">libbluray</ulink>
    </para>

    <bridgehead renderas="sect4">Controladores e Bibliotecas Opcionais de Saída de Áudio</bridgehead>
    <para role="optional">
      <xref linkend="pipewire"/>, <xref linkend="sdl2"/>, <ulink
url="https://jackaudio.org/">JACK</ulink> e <ulink
url="https://openal.org/">OpenAL</ulink>
    </para>

    <bridgehead renderas="sect4">Controladores e Bibliotecas Opcionais de Saída de Vídeo</bridgehead>
    <para role="optional">
      <ulink url="https://github.com/cacalabs/libcaca">libcaca</ulink> e <ulink
url="https://www.svgalib.org/">SVGAlib</ulink>
    </para>

    <bridgehead renderas="sect4">Opcionais (para documentação)</bridgehead>
    <para role="optional">
      <xref linkend="docutils"/>
    </para>
  </sect2>

  <sect2 role="installation">
    <title>Instalação do mpv</title>

      <para>
        Instale <application>mpv</application> executando os seguintes comandos:
      </para>

<screen><userinput>mkdir build &amp;&amp;
cd    build &amp;&amp;

meson setup --prefix=/usr       \
            --buildtype=release \
            -D x11=enabled      \
            ..                  &amp;&amp;
ninja</userinput></screen>

      <para>
        Esse pacote não vem com uma suíte de teste.
      </para>

      <para>
        Agora, como o(a) usante &root;:
      </para>

<screen role="root"><userinput>ninja install</userinput></screen>

      <xi:include xmlns:xi="http://www.w3.org/2001/XInclude"
        href="../../xincludes/update-icons-and-desktop.xml"/>

  </sect2>

  <sect2 role="commands">
    <title>Explicações do Comando</title>

    <para>
      <parameter>-D x11=enabled</parameter>: permite vincular com as bibliotecas
do X11.
    </para>

    <para>
      <option>-D dvdnav=enabled</option>: habilita suporte para reprodução de DVD.
    </para>

    <para>
      <option>-D cdda=enabled</option>: habilita suporte para áudio de CD.
    </para>

    <para>
      <option>-D sdl2=enabled</option>: habilita o uso de SDL2 para saída de áudio
e vídeo.
    </para>

  </sect2>

  <sect2 role="configuration">
    <title>Configurando mpv</title>

    <sect3 id="mpv-config">
      <title>Arquivos de Configuração</title>

      <para>
        <filename>/etc/mpv/*</filename> e <filename>~/.config/mpv/*</filename>
      </para>

    </sect3>

  </sect2>

