<sect1 id="qtkeychain" xreflabel="qtkeychain-&qtkeychain-version;">
  <?dbhtml filename="qtkeychain.html"?>

  <title>qtkeychain-&qtkeychain-version;</title>

  <indexterm zone="qtkeychain">
    <primary sortas="g-qtkeychain">qtkeychain</primary>
  </indexterm>

  <sect2 role="package">
    <title>Introdução ao qtkeychain</title>

    <para>
      Esse pacote fornece uma API do Qt para armazenar seguramente senhas e outros
dados secretos.
    </para>

    &lfs130_checked;

    <bridgehead renderas="sect3">Informação do Pacote</bridgehead>
    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Transferência (HTTP): <ulink url="&qtkeychain-download-http;"/>
        </para>
      </listitem>
      <listitem>
        <para>
          Transferência (FTP): <ulink url="&qtkeychain-download-ftp;"/>
        </para>
      </listitem>
      <listitem>
        <para>
          Soma de verificação MD5 da transferência: &qtkeychain-md5sum;
        </para>
      </listitem>
      <listitem>
        <para>
          Tamanho da transferência: &qtkeychain-size;
        </para>
      </listitem>
      <listitem>
        <para>
          Espaço em disco estimado exigido: &qtkeychain-buildsize;
        </para>
      </listitem>
      <listitem>
        <para>
          Tempo de construção estimado: &qtkeychain-time;
        </para>
      </listitem>
    </itemizedlist>

    <bridgehead renderas="sect3">Dependências do qtkeychain</bridgehead>

    <bridgehead renderas="sect4">Exigidas</bridgehead>
    <para role="required">
      <xref linkend="qt6"/>
    </para>

  </sect2>

  <sect2 role="installation">
    <title>Instalação do qtkeychain</title>

    <para>
      Instale <application>qtkeychain</application> executando os seguintes
comandos:
    </para>

<screen><userinput>mkdir build &amp;&amp;
cd    build &amp;&amp;

cmake -D CMAKE_INSTALL_PREFIX=$QT6DIR \
      -D CMAKE_BUILD_TYPE=Release     \
      -D BUILD_WITH_QT6=ON            \
      -D BUILD_TESTING=OFF            \
      -W no-dev ..                    &amp;&amp;
make</userinput></screen>

    <para>
      Esse pacote não vem com uma suíte de teste.
    </para>

    <para>
      Agora, como o(a) usuário(a) &root;:
    </para>

<screen role="root"><userinput>make install</userinput></screen>

  </sect2>

  <sect2 role="content">
    <title>Conteúdo</title>

    <segmentedlist>
      <segtitle>Aplicativos Instalados</segtitle>
      <segtitle>Bibliotecas Instaladas</segtitle>
      <segtitle>Diretórios Instalados</segtitle>

      <seglistitem>
        <seg>Nenhum(a)</seg>
        <seg>libqt6keychain.so</seg>
