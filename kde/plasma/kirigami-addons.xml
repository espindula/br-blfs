      <segtitle>Bibliotecas Instaladas</segtitle>
      <segtitle>Diretórios Instalados</segtitle>

      <seglistitem>
        <seg>Nenhum(a)</seg>
        <seg>Nenhum(a)</seg>
        <seg>
          $KF6_PREFIX/lib/qml/org/kde/kirigamiaddons e
$KF6_PREFIX/lib/cmake/KF6KirigamiAddons
        </seg>
      </seglistitem>
    </segmentedlist>

  </sect2>

