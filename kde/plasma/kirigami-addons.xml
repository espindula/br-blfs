<sect1 id="kirigami-addons" xreflabel="kirigami-addons-&kirigami-addons-version;">
  <?dbhtml filename="kirigami-addons.html"?>

  <title>kirigami-addons-&kirigami-addons-version;</title>

  <indexterm zone="kirigami-addons">
    <primary sortas="g-kirigami-addons">kirigami-addons</primary>
  </indexterm>

  <sect2 role="package">
    <title>Introdução ao kirigami-addons</title>

    <para>
      Esse pacote fornece arquivos qml complementares para a estrutura Kirigami.
    </para>

    &lfs124_checked;

    <bridgehead renderas="sect3">Informação do Pacote</bridgehead>
    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Transferência (HTTP): <ulink url="&kirigami-addons-download-http;"/>
        </para>
      </listitem>
      <listitem>
        <para>
          Transferência (FTP): <ulink url="&kirigami-addons-download-ftp;"/>
        </para>
      </listitem>
      <listitem>
        <para>
          Soma de verificação MD5 da transferência: &kirigami-addons-md5sum;
        </para>
      </listitem>
      <listitem>
        <para>
          Tamanho da transferência: &kirigami-addons-size;
        </para>
      </listitem>
      <listitem>
        <para>
          Espaço em disco estimado exigido: &kirigami-addons-buildsize;
        </para>
      </listitem>
      <listitem>
        <para>
          Tempo de construção estimado: &kirigami-addons-time;
        </para>
      </listitem>
    </itemizedlist>

    <bridgehead renderas="sect3">Dependências do kirigami-addons</bridgehead>

    <bridgehead renderas="sect4">Exigidas</bridgehead>
    <para role="required">
      <xref linkend="kf6-frameworks"/>
    </para>

    <bridgehead renderas="sect4">Recomendadas</bridgehead>
    <para role="recommended">
      <xref linkend="vulkan-loader"/>
    </para>

  </sect2>

  <sect2 role="installation">
    <title>Instalação do kirigami-addons</title>

    <para>
      Instale <application>kirigami-addons</application> executando os seguintes
comandos:
    </para>

<screen><userinput>mkdir build &amp;&amp;
cd    build &amp;&amp;

cmake -D CMAKE_INSTALL_PREFIX=$KF6_PREFIX \
      -D CMAKE_BUILD_TYPE=Release         \
      -D BUILD_TESTING=OFF                \
       ..                                 &amp;&amp;
make</userinput></screen>

    <para>
      Esse pacote não vem com uma suíte de teste.
    </para>

    <para>
      Agora, como o(a) usuário(a) &root;:
    </para>

<screen role="root"><userinput>make install</userinput></screen>

  </sect2>

