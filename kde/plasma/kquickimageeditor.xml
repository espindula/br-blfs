<sect1 id="kquickimageeditor" xreflabel="kquickimageeditor-&kquickimageeditor-version;">
  <?dbhtml filename="kquickimageeditor.html"?>

  <title>kquickimageeditor-&kquickimageeditor-version;</title>

  <indexterm zone="kquickimageeditor">
    <primary sortas="g-kquickimageeditor">kquickimageeditor</primary>
  </indexterm>

  <sect2 role="package">
    <title>Introdução ao kquickimageeditor</title>

    <para>
      Esse pacote fornece um conjunto de componentes QtQuick que fornecem recursos
básicos de edição de imagens.
    </para>

    &lfs130_checked;

    <bridgehead renderas="sect3">Informação do Pacote</bridgehead>
    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Transferência (HTTP): <ulink url="&kquickimageeditor-download-http;"/>
        </para>
      </listitem>
      <listitem>
        <para>
