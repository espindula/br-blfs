<sect1 id="tesseract" xreflabel="tesseract-&tesseract-version;">
  <?dbhtml filename="tesseract.html"?>

  <title>tesseract-&tesseract-version;</title>

  <indexterm zone="tesseract">
    <primary sortas="a-tesseract-&tesseract-version;">tesseract</primary>
  </indexterm>

  <sect2 role="package">
    <title>Introdução ao tesseract</title>

    <para>
      O pacote <application>tesseract</application> fornece um mecanismo de
Reconhecimento Óptico de Caracteres (OCR) e um programa de linha de comando
usados para extrair texto impresso de imagens. 
    </para>

    &lfs131_checked;

    <bridgehead renderas="sect3">Informação do Pacote</bridgehead>
    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Transferência (HTTP): <ulink url="&tesseract-download-http;"/>
        </para>
      </listitem>
      <listitem>
        <para>
          Transferência (FTP): <ulink url="&tesseract-download-ftp;"/>
        </para>
      </listitem>
      <listitem>
        <para>
          Soma de verificação MD5 da transferência: &tesseract-md5sum;
        </para>
      </listitem>
      <listitem>
        <para>
          Tamanho da transferência: &tesseract-size;
        </para>
      </listitem>
      <listitem>
        <para>
          Espaço em disco estimado exigido: &tesseract-buildsize;
        </para>
      </listitem>
      <listitem>
        <para>
          Tempo de construção estimado: &tesseract-time;
        </para>
      </listitem>
    </itemizedlist>

    <bridgehead renderas="sect3">Dependências do tesseract</bridgehead>

    <bridgehead renderas="sect4">Exigidas</bridgehead>
    <para role="requrired">
      <xref linkend="leptonica"/>
    </para>

    <bridgehead renderas="sect4">Recomendadas</bridgehead>
    <para role="recommended">
      <xref linkend="curl"/>, <xref linkend="icu"/>, <xref linkend="libarchive"/>
e <xref linkend="pango"/>
    </para>

  </sect2>

  <sect2 role="installation">
    <title>Instalação do tesseract</title>

    <para>
      Instale <application>tesseract</application> executando os seguintes
comandos:
    </para>

<screen><userinput>./autogen.sh &amp;&amp;           

./configure --prefix=/usr --disable-static &amp;&amp;
make</userinput></screen>

    <para>
      O pacote não vem com uma suíte de teste.
    </para>

    <para>
      Agora, como o(a) usuário(a) &root;:
    </para>

<screen role="root"><userinput>make install</userinput></screen>

  </sect2>

