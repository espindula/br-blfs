      <varlistentry id="phononsettings">
        <term><command>phononsettings</command></term>
        <listitem>
          <para>
            fornece uma interface gráfica para configurar o dispositivo padrão de áudio
para vários tipos de reprodução, inclusive para comunicações, jogos e mais
          </para>
          <indexterm zone="phonon phononsettings">
            <primary sortas="b-phononsettings">phononsettings</primary>
          </indexterm>
        </listitem>
      </varlistentry>

      <varlistentry id="libphonon4qt6">
        <term><filename class="libraryfile">libphonon4qt6.so</filename></term>
        <listitem>
          <para>
            contém funções que fornecem a API multimídia usada pelo KDE
