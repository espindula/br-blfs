<sect1 id="kmix" xreflabel="KMix-&kf6apps-version;">
  <?dbhtml filename="kmix.html"?>


  <title>KMix-&kf6apps-version;</title>

  <indexterm zone="kmix">
    <primary sortas="a-KMix">KMix</primary>
  </indexterm>

  <sect2 role="package">
    <title>Introdução ao KMix</title>

    <para>
      O pacote <application>KMix</application> contém um Misturador de Som,
baseado no KDE Frameworks, que se integra graciosamente com o
<application>Plasma</application>.
    </para>

    &lfs130_checked;

    <bridgehead renderas="sect3">Informação do Pacote</bridgehead>
    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Transferência (HTTP): <ulink url="&kmix-download-http;"/>
        </para>
      </listitem>
      <listitem>
        <para>
          Transferência (FTP): <ulink url="&kmix-download-ftp;"/>
        </para>
      </listitem>
      <listitem>
        <para>
          Soma de verificação MD5 da transferência: &kmix-md5sum;
        </para>
      </listitem>
      <listitem>
        <para>
          Tamanho da transferência: &kmix-size;
        </para>
      </listitem>
      <listitem>
        <para>
          Espaço em disco estimado exigido: &kmix-buildsize;
        </para>
      </listitem>
      <listitem>
        <para>
          Tempo de construção estimado: &kmix-time;
        </para>
      </listitem>
    </itemizedlist>

    <bridgehead renderas="sect3">Dependências do KMix</bridgehead>

    <bridgehead renderas="sect4">Exigidas</bridgehead>
    <para role="required">
      <xref linkend="kf6-frameworks"/>
    </para>

    <bridgehead renderas="sect4">Recomendadas</bridgehead>
    <para role="recommended">
      <xref linkend="alsa-lib"/>
    </para>

    <bridgehead renderas="sect4">Opcionais</bridgehead>
    <para role="optional">
      <xref linkend="libcanberra"/> e <xref linkend="pulseaudio"/>
    </para>

  </sect2>

  <sect2 role="installation">
    <title>Instalação do KMix</title>

    <para>
      Instale <application>KMix</application> executando os seguintes comandos:
    </para>

<screen><userinput>mkdir build &amp;&amp;
cd    build &amp;&amp;

cmake -D CMAKE_INSTALL_PREFIX=$KF6_PREFIX \
      -D CMAKE_BUILD_TYPE=Release         \
      -D BUILD_TESTING=OFF                \
      -W no-author .. &amp;&amp;
make</userinput></screen>

    <para>
      Esse pacote não vem com uma suíte de teste.
    </para>

    <para>
      Agora, como o(a) usuário(a) <systemitem class="username">root</systemitem>:
    </para>

<screen role="root"><userinput>make install</userinput></screen>

  </sect2>

  <sect2 role="content">
    <title>Conteúdo</title>

    <segmentedlist>
      <segtitle>Aplicativos Instalados</segtitle>
      <segtitle>Bibliotecas Instaladas</segtitle>
      <segtitle>Diretórios Instalados</segtitle>

      <seglistitem>
        <seg>
          kmix, kmixctrl e kmixremote
        </seg>
        <seg>
          libkmixcore.so
        </seg>
        <seg>
          $KF6_PREFIX/share/kmix e $KF6_PREFIX/share/doc/HTML/*/kmix
        </seg>
      </seglistitem>
    </segmentedlist>

    <variablelist>
      <bridgehead renderas="sect3">Descrições Curtas</bridgehead>
      <?dbfo list-presentation="list"?> <?dbhtml list-presentation="table"?>

     <varlistentry id="kmix-prog">
        <term><command>kmix</command></term>
        <listitem>
          <para>
            é um pequeno misturador de áudio para KDE que se integra ao Plasma
          </para>
          <indexterm zone="kmix kmix-prog">
            <primary sortas="b-kmix">kmix</primary>
          </indexterm>
        </listitem>
      </varlistentry>

     <varlistentry id="kmixctrl">
        <term><command>kmixctrl</command></term>
        <listitem>
          <para>
            é usado para salvar e(ou) para restaurar os ajustes que
<command>kmix</command> tenha configurado
          </para>
          <indexterm zone="kmix kmixctrl">
            <primary sortas="b-kmixctrl">kmixctrl</primary>
          </indexterm>
        </listitem>
      </varlistentry>

     <varlistentry id="kmixremote">
        <term><command>kmixremote</command></term>
        <listitem>
          <para>
            é um utilitário para silenciar, obter ou configurar níveis de volume no
sistema. Ele pode ser executado via SSH para ajustar o volume em um sistema
remoto
          </para>
          <indexterm zone="kmix kmixremote">
            <primary sortas="b-kmixremote">kmixremote</primary>
          </indexterm>
        </listitem>
      </varlistentry>
    </variablelist>

  </sect2>

