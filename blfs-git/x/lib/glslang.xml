    <!--
    <bridgehead renderas="sect3">
Additional Downloads</bridgehead>
    <para>
       Required patch to ensure the libSPIRV.so library is installed:
       <ulink url="&patch-root;/glslang-&glslang-version;-SPIRV_install-1.patch"/>
