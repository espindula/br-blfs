  <sect2 id="maturin" xreflabel="maturin-&maturin-version;">

    <title>maturin-&maturin-version;</title>

    <indexterm zone="maturin">
      <primary sortas="a-maturin">maturin</primary>
    </indexterm>

    <sect3 role="package">
      <title>Introduction to the maturin Module</title>

      <para>
        The <application>maturin</application> module provides a build system for
rust binaries and crates generated from Python packages.
      </para>

      &lfs124_checked;

      <bridgehead renderas="sect4">Package Information</bridgehead>
      <itemizedlist spacing="compact">
        <listitem>
          <para>
            Download (HTTP): <ulink url="&maturin-download-http;"/>
          </para>
        </listitem>
        <listitem>
          <para>
            Download (FTP): <ulink url="&maturin-download-ftp;"/>
          </para>
        </listitem>
        <listitem>
          <para>
            Download MD5 sum: &maturin-md5sum;
          </para>
        </listitem>
        <listitem>
          <para>
            Download size: &maturin-size;
          </para>
        </listitem>
        <listitem>
          <para>
            Estimated disk space required: &maturin-buildsize;
          </para>
        </listitem>
        <listitem>
          <para>
            Estimated build time: &maturin-time;
          </para>
        </listitem>
      </itemizedlist>

      <bridgehead renderas="sect4">maturin Dependencies</bridgehead>

      <bridgehead renderas="sect5">Required</bridgehead>
      <para role="required">
        <xref linkend="rust"/> and <xref linkend="setuptools_rust"/>
      </para>
    
      <bridgehead renderas="sect5">Optional</bridgehead>
      
      <para role="optional">
        <xref linkend="patchelf"/> and <ulink url="https://ziglang.org/">zig</ulink>
      </para>
      
      <bridgehead renderas="sect5">Optional (for testing)</bridgehead>
      <para role="optional">
        <ulink url="https://pypi.org/project/cffi/">cffi</ulink>, <ulink
url="https://pypi.org/project/pycparser/">pycparser</ulink>, and <ulink
url="https://pypi.org/project/virtualenv/">virtualenv</ulink>
      </para>

    </sect3>

    <sect3 role="installation">
      <title>Installation of maturin</title>

      <para>
        Build the module:
      </para>

&build-wheel;

      <para>
        Now, as the <systemitem class="username">root</systemitem> user:
      </para>

<screen role="root"><userinput>&install-wheel; maturin</userinput></screen>

      <para>
        To test the installation, issue:
      </para>

<screen remap="test"><userinput>python3 -m venv --system-site-packages testenv     &amp;&amp;
testenv/bin/pip3 install cffi pycparser virtualenv &amp;&amp;
PATH=$PWD/testenv/bin:$PATH cargo test</userinput></screen>

      <para>
        Three tests, <filename>integration_cffi_mixed</filename>,
<filename>pyo3_mixed_include_exclude_sdist</filename>, and
<filename>pyo3_no_extension_module</filename>, are known to fail.
      </para>

    </sect3>

    <xi:include xmlns:xi="http://www.w3.org/2001/XInclude"
      href="../../../xincludes/pip3-cmd-explain.xml"/>

