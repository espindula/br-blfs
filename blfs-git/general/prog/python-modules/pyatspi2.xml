      <bridgehead renderas="sect4">PyAtSpi2 Dependencies</bridgehead>

      <bridgehead renderas="sect5">Required</bridgehead>
      <para role="required">
        <xref linkend="dbus-python"/> and <xref linkend="pygobject3"/>
      </para>

