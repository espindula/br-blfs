      <bridgehead renderas="sect4">build Dependencies</bridgehead>

      <bridgehead renderas="sect5">Required</bridgehead>
      <para role="required">
        <xref linkend="pyproject-hooks"/>
      </para>

      <bridgehead renderas="sect5">Optional (for tests)</bridgehead>
      <para role="optional">
        <xref linkend="pytest"/>, <ulink
url="https://pypi.org/project/filelock/">filelock</ulink>, <ulink
url="https://pypi.org/project/pytest-cov/">pytest-cov</ulink>, <ulink
url="https://pypi.org/project/pytest-mock/">pytest-mock</ulink>, <ulink
url="https://pypi.org/project/pytest-rerunfailures/">pytest-rerunfailures</ulink>,
<ulink url="https://pypi.org/project/pytest-xdist/">pytest-xdist</ulink>,
<ulink url="https://pypi.org/project/uv/">uv</ulink>, and <ulink
url="https://pypi.org/project/virtualenv/">virtualenv</ulink>
      </para>

    </sect3>

    <sect3 role="installation">
      <title>Installation of build</title>

      <para>
        Build the package with:
      </para>

&build-wheel;

      <para>
        To install the package run the following as the &root; user:
      </para>

<screen role="root"><userinput>&install-wheel; build</userinput></screen>

      <para>
        Assuming <xref linkend="pytest"/> is installed but the other optional
dependencies are not, the installation can be tested with the following
commands:
      </para>

<screen remap="test"><!-- no && because of a possible error -->
<userinput>python3 -m venv --system-site-packages testenv &amp;&amp;
source testenv/bin/activate                    &amp;&amp;
pip3 install --group test                      &amp;&amp;
python3 -m pytest
deactivate</userinput></screen>

      <para>
        One test in <filename>test_projectbuilder.py</filename> is known to fail due
to a conflict with the system copy of flit_core.
      </para>

    </sect3>

