<sect1 id="hwdata" xreflabel="hwdata-&hwdata-version;">
  <?dbhtml filename="hwdata.html"?>


  <title>hwdata-&hwdata-version;</title>

  <indexterm zone="hwdata">
    <primary sortas="g-hwdata">hwdata</primary>
  </indexterm>

  <sect2 role="package">
    <title>Introdução ao hwdata</title>

    <para>
      O pacote <application>hwdata</application> contém dados atuais de PCI e ID
do fornecedor.
    </para>

    &lfs123_checked;

    <bridgehead renderas="sect3">Informação do Pacote</bridgehead>
    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Transferência (HTTP): <ulink url="&hwdata-download-http;"/>
        </para>
      </listitem>
      <listitem>
        <para>
          Transferência (FTP): <ulink url="&hwdata-download-ftp;"/>
        </para>
      </listitem>
      <listitem>
        <para>
          Soma de verificação MD5 da transferência: &hwdata-md5sum;
        </para>
      </listitem>
      <listitem>
        <para>
          Tamanho da transferência: &hwdata-size;
        </para>
      </listitem>
      <listitem>
        <para>
          Espaço em disco estimado exigido: &hwdata-buildsize;
        </para>
      </listitem>
      <listitem>
        <para>
          Tempo de construção estimado: &hwdata-time;
        </para>
      </listitem>
    </itemizedlist>

  </sect2>

  <sect2 role="installation">
    <title>Instalação do hwdata</title>

    <para>
      Instale <application>hwdata</application> executando os seguintes comandos:
    </para>

<screen><userinput>./configure --prefix=/usr --disable-blacklist</userinput></screen>

    <para>
      Esse pacote não vem com uma suíte de teste.
    </para>

    <para>
      Agora, como o(a) usuário(a) &root;:
    </para>

<screen role="root"><userinput>make install</userinput></screen>

  </sect2>

