<sect1 id="inih" xreflabel="inih-&inih-version;">
  <?dbhtml filename="inih.html"?>

  <title>inih-&inih-version;</title>

  <indexterm zone="inih">
    <primary sortas="a-inih">inih</primary>
  </indexterm>

  <sect2 role="package">
    <title>Introdução ao inih</title>

    <para>
      Esse pacote é um analisador simples de arquivo ".INI" escrito em C.
    </para>

    &lfs131_checked;

    <bridgehead renderas="sect3">Informação do Pacote</bridgehead>
    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Transferência (HTTP): <ulink url="&inih-download-http;"/>
        </para>
      </listitem>
      <listitem>
        <para>
          Transferência (FTP): <ulink url="&inih-download-ftp;"/>
        </para>
      </listitem>
      <listitem>
        <para>
          Soma de verificação MD5 da transferência: &inih-md5sum;
        </para>
      </listitem>
      <listitem>
        <para>
          Tamanho da transferência: &inih-size;
        </para>
      </listitem>
      <listitem>
        <para>
          Espaço em disco estimado exigido: &inih-buildsize;
        </para>
      </listitem>
      <listitem>
        <para>
          Tempo de construção estimado: &inih-time;
        </para>
      </listitem>
    </itemizedlist>

  </sect2>

  <sect2 role="installation">
    <title>Instalação do inih</title>

    <para>
      Instale o <application>inih</application> executando os seguintes comandos:
    </para>

<!-- Note.  There is a tests directory.  If we do:
  cd ../tests
  sh unittest.sh
The tests seem to be run, but there is no output or log.
-->
<screen><userinput>mkdir build &amp;&amp;
cd    build &amp;&amp;

meson setup --prefix=/usr --buildtype=release .. &amp;&amp;
ninja</userinput></screen>


    <para>
      Para testar os resultados, emita: <command>ninja test</command>.
    </para>

    <para>
      Agora, como o(a) usante <systemitem class="username">root</systemitem>:
    </para>

<screen role="root"><userinput>ninja install</userinput></screen>

  </sect2>




