<sect1 id="glibmm2" xreflabel="GLibmm-&glibmm2-version;">
  <?dbhtml filename="glibmm2.html"?>


  <title>GLibmm-&glibmm2-version;</title>

  <indexterm zone="glibmm2">
    <primary sortas="a-GLibmm2">GLibmm</primary>
  </indexterm>

  <sect2 role="package">
    <title>Introdução ao GLibmm</title>

    <para>
      O pacote <application>GLibmm</application> é um conjunto de ligações C++
para <application>GLib</application>. Essa versão é parte de uma nova API
para suporte ao gtkmm-4.
    </para>

    &lfs124_checked;

    <bridgehead renderas="sect3">Informação do Pacote</bridgehead>
    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Transferência (HTTP): <ulink url="&glibmm-download-http;"/>
        </para>
      </listitem>
      <listitem>
        <para>
          Transferência (FTP): <ulink url="&glibmm-download-ftp;"/>
        </para>
      </listitem>
      <listitem>
        <para>
          Soma de verificação MD5 da transferência: &glibmm-md5sum;
        </para>
      </listitem>
      <listitem>
        <para>
          Tamanho da transferência: &glibmm-size;
        </para>
      </listitem>
      <listitem>
        <para>
          Espaço em disco estimado exigido: &glibmm-buildsize;
        </para>
      </listitem>
      <listitem>
        <para>
          Tempo de construção estimado: &glibmm-time;
        </para>
      </listitem>
    </itemizedlist>

    <bridgehead renderas="sect3">Dependências de GLibmm</bridgehead>

    <bridgehead renderas="sect4">Exigidas</bridgehead>
    <para role="required">
      <xref linkend="glib2"/> e <xref linkend="libsigc3"/>
    </para>

    <bridgehead renderas="sect4">Opcionais</bridgehead>
    <para role="optional">
      <xref linkend="doxygen"/>, <xref linkend="glib-networking"/> (para testes),
<xref linkend="gnutls"/> (para testes), <xref linkend="libxslt"/> e <ulink
url="&gnome-download-http;/mm-common">mm-common</ulink>
    </para>

  </sect2>

  <sect2 role="installation">
    <title>Instalação do GLibmm</title>

    <para>
      Instale <application>GLibmm</application> executando os seguintes comandos:
    </para>

<screen><userinput>mkdir bld &amp;&amp;
cd    bld &amp;&amp;

meson setup --prefix=/usr --buildtype=release .. &amp;&amp;
ninja</userinput></screen>

    <para>
      Para testar os resultados, emita: <command>ninja test</command>.
    </para>

    <para>
      Agora, como o(a) usuário(a) <systemitem class="username">root</systemitem>:
    </para>

<screen role="root"><userinput>ninja install</userinput></screen>

  </sect2>

