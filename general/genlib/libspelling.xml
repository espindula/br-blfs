<sect1 id="libspelling" xreflabel="libspelling-&libspelling-version;">
  <?dbhtml filename="libspelling.html"?>

  <title>libspelling-&libspelling-version;</title>

  <indexterm zone="libspelling">
    <primary sortas="a-libspelling">libspelling</primary>
  </indexterm>

  <sect2 role="package">
    <title>Introdução ao libspelling</title>

    <para>
      O pacote <application>libspelling</application> fornece uma biblioteca do
GNOME para verificação ortográfica.
    </para>

    &lfs131_checked;

    <bridgehead renderas="sect3">Informação do Pacote</bridgehead>
    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Transferência (HTTP): <ulink url="&libspelling-download-http;"/>
        </para>
      </listitem>
      <listitem>
        <para>
          Transferência (FTP): <ulink url="&libspelling-download-ftp;"/>
        </para>
      </listitem>
      <listitem>
        <para>
          Soma de verificação MD5 da transferência: &libspelling-md5sum;
        </para>
      </listitem>
      <listitem>
        <para>
          Tamanho da transferência: &libspelling-size;
        </para>
      </listitem>
      <listitem>
        <para>
          Espaço em disco estimado exigido: &libspelling-buildsize;
        </para>
      </listitem>
      <listitem>
        <para>
          Tempo de construção estimado: &libspelling-time;
        </para>
      </listitem>
    </itemizedlist>

    <bridgehead renderas="sect3">Dependências do libspelling</bridgehead>

    <bridgehead renderas="sect4">Exigidas</bridgehead>
    <para role="required">
      <xref linkend="gtksourceview5"/>
    </para>


    <bridgehead renderas="sect4">Recomendadas</bridgehead>
    <para role="recommended">
      <xref linkend="enchant"/>, <xref linkend="icu"/> e <xref linkend="vala"/>
    </para>

    <bridgehead renderas="sect4">Opcionais</bridgehead>
    <para role="optional">
      <xref linkend="gi-docgen"/> e <ulink url="www.sysprof.com">sysprof</ulink>
    </para>

  </sect2>

  <sect2 role="installation">
    <title>Instalação do libspelling</title>

    <para>
      Instale <application>libspelling</application> executando os seguintes
comandos:
    </para>

<screen><userinput>mkdir build &amp;&amp;
cd    build &amp;&amp;

meson setup --prefix=/usr       \
            --buildtype=release \
            -D docs=false       \
            -D sysprof=false    \
            ..                  &amp;&amp;
ninja</userinput></screen>

    <para>
      Para testar os resultados, emita: <command>ninja test</command>. 
    </para>

    <para>
      Agora, como o(a) usuário(a) &root;:
    </para>

<screen role="root"><userinput>ninja install</userinput></screen>

 </sect2>

  <sect2 role="commands">
    <title>Explicações do Comando</title>

    <para>
      <parameter>-D docs=false</parameter>: Impede construir a
documentação. Remova isso se você tiver o
<application>gi-docgen</application> instalado e desejar construir a
documentação.
    </para>

    <para>
      <parameter>-D sysprof=false</parameter>: Impede construir com dados de
perfilamento. Remova isso se você tiver o <application>sysprof</application>
instalado e desejar gerar dados para perfilamento de desempenho.
    </para>
  </sect2>

