    <para>
      <emphasis role="strong">Remendo para Seleção de Nível de Registro
(Opcional)</emphasis>
    </para>
    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Remendo opcional: <ulink url="&patch-root;/glib-skip_warnings-1.patch"/>
