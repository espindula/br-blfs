<sect1 id="libgusb" xreflabel="libgusb-&libgusb-version;">
  <?dbhtml filename="libgusb.html"?>


  <title>libgusb-&libgusb-version;</title>

  <indexterm zone="libgusb">
    <primary sortas="a-libgusb">libgusb</primary>
  </indexterm>

  <sect2 role="package">
    <title>Introdução ao libgusb</title>

    <para>
      O pacote <application>libgusb</application> contém os amarradores GObject
para a <application>libusb-1.0</application> que tornam fácil fazer controle
assíncrono, transferências em massa e de interrupções com cancelamento
adequado e integração em um loop principal.
    </para>

    &lfs131_checked;

    <bridgehead renderas="sect3">Informação do Pacote</bridgehead>
    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Transferência (HTTP): <ulink url="&libgusb-download-http;"/>
        </para>
      </listitem>
      <listitem>
        <para>
          Transferência (FTP): <ulink url="&libgusb-download-ftp;"/>
        </para>
      </listitem>
      <listitem>
        <para>
          Soma de verificação MD5 da transferência: &libgusb-md5sum;
        </para>
      </listitem>
      <listitem>
        <para>
          Tamanho da transferência: &libgusb-size;
        </para>
      </listitem>
      <listitem>
        <para>
          Espaço em disco estimado exigido: &libgusb-buildsize;
        </para>
      </listitem>
      <listitem>
        <para>
          Tempo de construção estimado: &libgusb-time;
        </para>
      </listitem>
    </itemizedlist>

    <bridgehead renderas="sect3">Dependências do libgusb</bridgehead>

    <bridgehead renderas="sect4">Exigidas</bridgehead>
    <para role="required">
      <xref linkend="json-glib"/> e <xref linkend="libusb"/>
    </para>

    <bridgehead renderas="sect4">Recomendadas</bridgehead>
    <para role="recommended">
      &gobject-introspection;, <xref linkend="hwdata"/> (para arquivo de dados
<filename>usb.ids</filename>, que também é exigido para os testes) e <xref
linkend="vala"/>
    </para>

    <bridgehead renderas="sect4">Opcionais</bridgehead>
    <para role="optional">
      <xref linkend="gi-docgen"/> e <xref linkend="umockdev"/> (para cobertura
completa de teste)
    </para>

  </sect2>

  <sect2 role="installation">
    <title>Instalação do libgusb</title>

    <para>
      Instale <application>libgusb</application> executando os seguintes comandos:
    </para>

    <screen><userinput>mkdir build &amp;&amp;
cd    build &amp;&amp;

meson setup ..            \
      --prefix=/usr       \
      --buildtype=release \
      -D docs=false       &amp;&amp;
ninja</userinput></screen>

    <para>
      Se você tiver <xref linkend='gi-docgen'/> instalado e desejar construir a
documentação da API para esse pacote, emita:
    </para>

<screen role='nodump'><userinput>sed -E "/output|install_dir/s/('libgusb)'/\1-&libgusb-version;'/" \
    -i ../docs/meson.build                            &amp;&amp;
meson configure -D docs=true                          &amp;&amp;
ninja</userinput></screen>

    <para>Para testar os resultados, execute:</para>

<screen remap='test'><userinput>sed -e 's/pkg_resources/packaging.version/'  \
    -e 's/parse_version/parse/g'             \
    -i ../contrib/generate-version-script.py &amp;&amp;
ninja test</userinput></screen>

    <para>
      Agora, como o(a) usante &root;:
    </para>

<screen role="root"><userinput>ninja install</userinput></screen>
  </sect2>

  <sect2 role="commands">
    <title>Explicações do Comando</title>

    <xi:include xmlns:xi="http://www.w3.org/2001/XInclude"
      href="../../xincludes/meson-buildtype-release.xml"/>

    <para>
      <parameter>-D docs=false</parameter>: &gi-doc-disable;
    </para>

  </sect2>

