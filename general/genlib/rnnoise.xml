<sect1 id="rnnoise" xreflabel="rnnoise-&rnnoise-version;">
  <?dbhtml filename="rnnoise.html"?>


  <title>rnnoise-&rnnoise-version;</title>

  <indexterm zone="rnnoise">
    <primary sortas="a-rnnoise">rnnoise</primary>
  </indexterm>

  <sect2 role="package">
    <title>Introdução ao rnnoise</title>

    <para>
      <application>rnnoise</application> é uma biblioteca de supressão de ruído
baseada em uma rede de intercomunicação neural recorrente.
    </para>

    &lfs131_checked;

    <bridgehead renderas="sect3">Informação do Pacote</bridgehead>
    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Transferência (HTTP): <ulink url="&rnnoise-download-http;"/>
        </para>
      </listitem>
      <listitem>
        <para>
          Transferência (FTP): <ulink url="&rnnoise-download-ftp;"/>
        </para>
      </listitem>
      <listitem>
        <para>
          Soma de verificação MD5 da transferência: &rnnoise-md5sum;
        </para>
      </listitem>
      <listitem>
        <para>
          Tamanho da transferência: &rnnoise-size;
        </para>
      </listitem>
      <listitem>
        <para>
          Espaço em disco estimado exigido: &rnnoise-buildsize;
        </para>
      </listitem>
      <listitem>
        <para>
          Tempo de construção estimado: &rnnoise-time;
        </para>
      </listitem>
    </itemizedlist>

  </sect2>

  <sect2 role="installation">
    <title>Instalação do rnnoise</title>

    <para>
      Instale <application>rnnoise</application> executando os seguintes comandos:
    </para>

<screen><userinput>./configure --prefix=/usr \
            --disable-static \
            --docdir=/usr/share/doc/rnnoise-&rnnoise-version; &amp;&amp;
make</userinput></screen>

    <para>
      Esse pacote não vem com uma suíte de teste.
    </para>

    <para>
      Agora, como o(a) usante <systemitem class="username">root</systemitem>:
    </para>

<screen role="root"><userinput>make install</userinput></screen>

  </sect2>

