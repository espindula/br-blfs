    <para role="required">
      <xref linkend="glib2"/> e <xref linkend="libxml2"/>
    </para>

    <bridgehead renderas="sect4">Recomendadas</bridgehead>
    <para role="recommended">
      <xref linkend="gdk-pixbuf"/> (Para construir
<command>gsf-office-thumbnailer</command>)
    </para>

