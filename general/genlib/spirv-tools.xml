<sect1 id="spirv-tools" xreflabel="SPIRV-Tools-&spirv-tools-version;">
  <?dbhtml filename="spirv-tools.html"?>

  <title>SPIRV-Tools-&spirv-tools-version;</title>

  <indexterm zone="spirv-tools">
    <primary sortas="a-spirv-tools">SPIRV-Tools</primary>
  </indexterm>

  <sect2 role="package">
    <title>Introdução ao SPIRV-Tools</title>

    <para>
      O pacote <application>SPIRV-Tools</application> contém bibliotecas e
utilitários para processar módulos SPIR-V.
    </para>

    &lfs122_checked;

    <bridgehead renderas="sect3">Informação do Pacote</bridgehead>
    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Transferência (HTTP): <ulink url="&spirv-tools-download-http;"/>
        </para>
      </listitem>
      <listitem>
        <para>
          Transferência (FTP): <ulink url="&spirv-tools-download-ftp;"/>
        </para>
      </listitem>
      <listitem>
        <para>
          Soma de verificação MD5 da transferência: &spirv-tools-md5sum;
        </para>
      </listitem>
      <listitem>
        <para>
          Tamanho da transferência: &spirv-tools-size;
        </para>
      </listitem>
      <listitem>
        <para>
          Espaço em disco estimado exigido: &spirv-tools-buildsize;
        </para>
      </listitem>
      <listitem>
        <para>
          Tempo de construção estimado: &spirv-tools-time;
        </para>
      </listitem>
    </itemizedlist>

    <bridgehead renderas="sect3">Dependências do SPIRV-Tools</bridgehead>

    <bridgehead renderas="sect4">Exigidas</bridgehead>
    <para role="required">
      <xref linkend="cmake"/> e <xref linkend="spirv-headers"/>
    </para>

  </sect2>

  <sect2 role="installation">
    <title>Instalação do SPIRV-Tools</title>

    <note>
      <para>
        Esse tarball <filename>SPIRV-Tools-&spirv-tools-version;.tar.gz</filename>
extrairá para o diretório <filename
class="directory">SPIRV-Tools-vulkan-sdk-&spirv-tools-version;</filename>.
      </para>
    </note>

    <para>
      Instale <application>SPIRV-Tools</application> executando os seguintes
comandos:
    </para>

<screen><userinput>mkdir build &amp;&amp;
cd    build &amp;&amp;

cmake -D CMAKE_INSTALL_PREFIX=/usr     \
      -D CMAKE_BUILD_TYPE=Release      \
      -D SPIRV_WERROR=OFF              \
      -D BUILD_SHARED_LIBS=ON          \
      -D SPIRV_TOOLS_BUILD_STATIC=OFF  \
      -D SPIRV-Headers_SOURCE_DIR=/usr \
      -G Ninja .. &amp;&amp;
ninja</userinput></screen>

    <para>
      Para testar os resultados, emita: <command>ninja test</command>.
    </para>

    <para>
      Agora, como o(a) usuário(a) &root;:
    </para>

<screen role="root"><userinput>ninja install</userinput></screen>

  </sect2>

  <sect2 role="commands">
    <title>Explicações do Comando</title>

    <para>
      <parameter>-D SPIRV_WERROR=OFF</parameter>: Essa chave impede que o sistema
de construção trate avisos como erros.
    </para>

    <para>
      <parameter>-D BUILD_SHARED_LIBS=ON</parameter>: Essa chave força o sistema
de construção a instalar bibliotecas compartilhadas em vez de bibliotecas
estáticas.
    </para>
    
    <para>
      <parameter>-D SPIRV_TOOLS_BUILD_STATIC=OFF</parameter>: Essa chave
desabilita construir versões estáticas das bibliotecas.
    </para>

    <para>
      <parameter>-D SPIRV-Headers_SOURCE_DIR</parameter>: Essa chave informa ao
sistema de construção que <xref linkend="spirv-headers" role="nodep"/> está
instalado em /usr. Isso é necessário porque o sistema de construção tenta
usar uma cópia em <filename
class='directory'>external/spirv-headers</filename> no diretório do fonte
por padrão e a cópia não é enviada (ou seja, você precisa extrair
manualmente <xref linkend="spirv-headers" role="nodep"/> para lá se quiser
construir com a cópia).
    </para>

  </sect2>

  <sect2 role="content">
    <title>Conteúdo</title>

    <segmentedlist>
      <segtitle>Aplicativos Instalados</segtitle>
      <segtitle>Bibliotecas Instaladas</segtitle>
      <segtitle>Diretórios Instalados</segtitle>

      <seglistitem>
        <seg>
          spirv-as, spirv-cfg, spirv-dis, spirv-lesspipe.sh, spirv-link, spirv-lint,
spirv-objdump, spirv-opt, spirv-reduce e spirv-val
        </seg>
        <seg>
          libSPIRV-Tools-diff.so, libSPIRV-Tools-link.so, libSPIRV-Tools-lint.so,
libSPIRV-Tools-opt.so, libSPIRV-Tools-reduce.so, libSPIRV-Tools-shared.so e
libSPIRV-Tools.so
        </seg>
        <seg>
          /usr/include/spirv-tools e /usr/lib/cmake/SPIRV-Tools
        </seg>
      </seglistitem>
    </segmentedlist>

    <variablelist>
      <bridgehead renderas="sect3">Descrições Curtas</bridgehead>
      <?dbfo list-presentation="list"?> <?dbhtml list-presentation="table"?>

      <varlistentry id="spirv-as">
        <term><command>spirv-as</command></term>
        <listitem>
          <para>
            cria um módulo binário SPIR-V a partir de texto de montagem do SPIR-V
          </para>
          <indexterm zone="spirv-tools spirv-as">
            <primary sortas="b-spirv-as">spirv-as</primary>
          </indexterm>
        </listitem>
      </varlistentry>

      <varlistentry id="spirv-cfg">
        <term><command>spirv-cfg</command></term>
        <listitem>
          <para>
            mostra o gráfico do fluxo de controle no formato "dot"
          </para>
          <indexterm zone="spirv-tools spirv-cfg">
            <primary sortas="b-spirv-cfg">spirv-cfg</primary>
          </indexterm>
        </listitem>
      </varlistentry>

      <varlistentry id="spirv-dis">
        <term><command>spirv-dis</command></term>
        <listitem>
          <para>
            desmonta um módulo binário SPIR-V
          </para>
          <indexterm zone="spirv-tools spirv-dis">
            <primary sortas="b-spirv-dis">spirv-dis</primary>
          </indexterm>
        </listitem>
      </varlistentry>

      <varlistentry id="spirv-lesspipe.sh">
        <term><command>spirv-lesspipe.sh</command></term>
        <listitem>
          <para>
            desmonta automaticamente um arquivo .SPV para 'less'
          </para>
          <indexterm zone="spirv-tools spirv-lesspipe.sh">
            <primary sortas="b-spirv-lesspipe.sh">spirv-lesspipe.sh</primary>
          </indexterm>
        </listitem>
      </varlistentry>

      <varlistentry id="spirv-link">
        <term><command>spirv-link</command></term>
        <listitem>
          <para>
            vincula arquivos binários SPIR-V
          </para>
          <indexterm zone="spirv-tools spirv-link">
            <primary sortas="b-spirv-link">spirv-link</primary>
          </indexterm>
        </listitem>
      </varlistentry>

      <varlistentry id="spirv-lint">
        <term><command>spirv-lint</command></term>
        <listitem>
          <para>
            verifica um módulo binário SPIR-V para erros
          </para>
          <indexterm zone="spirv-tools spirv-lint">
            <primary sortas="b-spirv-lint">spirv-lint</primary>
          </indexterm>
        </listitem>
      </varlistentry>

      <varlistentry id="spirv-objdump">
        <term><command>spirv-objdump</command></term>
        <listitem>
          <para>
            despeja informações a partir de um binário SPIR-V
          </para>
          <indexterm zone="spirv-tools spirv-objdump">
            <primary sortas="b-spirv-objdump">spirv-objdump</primary>
          </indexterm>
        </listitem>
      </varlistentry>

      <varlistentry id="spirv-opt">
        <term><command>spirv-opt</command></term>
        <listitem>
          <para>
            realiza otimizações em arquivos binários SPIR-V
          </para>
          <indexterm zone="spirv-tools spirv-opt">
            <primary sortas="b-spirv-opt">spirv-opt</primary>
          </indexterm>
        </listitem>
      </varlistentry>

      <varlistentry id="spirv-reduce">
        <term><command>spirv-reduce</command></term>
        <listitem>
          <para>
            reduz um arquivo binário SPIR-V
          </para>
          <indexterm zone="spirv-tools spirv-reduce">
            <primary sortas="b-spirv-reduce">spirv-reduce</primary>
          </indexterm>
        </listitem>
      </varlistentry>

      <varlistentry id="spirv-val">
        <term><command>spirv-val</command></term>
        <listitem>
          <para>
            valida um arquivo binário SPIR-V
          </para>
          <indexterm zone="spirv-tools spirv-val">
            <primary sortas="b-spirv-val">spirv-val</primary>
          </indexterm>
        </listitem>
      </varlistentry>

      <varlistentry id="libSPIRV-Tools">
        <term><filename class="libraryfile">libSPIRV-Tools.so</filename></term>
        <listitem>
          <para>
            contém funções para processamento de módulos SPIR-V
          </para>
          <indexterm zone="spirv-tools libSPIRV-Tools">
            <primary sortas="c-libSPIRV-Tools">libSPIRV-Tools.so</primary>
          </indexterm>
        </listitem>
      </varlistentry>
    </variablelist>
  </sect2>
</sect1>
