<sect1 id="libdisplay-info" xreflabel="libdisplay-info-&libdisplay-info-version;">
  <?dbhtml filename="libdisplay-info.html"?>

  <title>libdisplay-info-&libdisplay-info-version;</title>

  <indexterm zone="libdisplay-info">
    <primary sortas="a-libdisplay-info">libdisplay-info</primary>
  </indexterm>

  <sect2 role="package">
    <title>Introdução ao libdisplay-info</title>

    <para>
      O pacote <application>libdisplay-info</application> fornece um conjunto de
funções de alto e baixo nível para acessar informações detalhadas de
Extended Display Identification Data (EDID).
    </para>

    &lfs122_checked;

    <bridgehead renderas="sect3">Informação do Pacote</bridgehead>
    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Transferência (HTTP): <ulink url="&libdisplay-info-download-http;"/>
        </para>
      </listitem>
      <listitem>
        <para>
          Transferência (FTP): <ulink url="&libdisplay-info-download-ftp;"/>
        </para>
      </listitem>
      <listitem>
        <para>
          Soma de verificação MD5 da transferência: &libdisplay-info-md5sum;
        </para>
      </listitem>
      <listitem>
        <para>
          Tamanho da transferência: &libdisplay-info-size;
        </para>
      </listitem>
      <listitem>
        <para>
          Espaço em disco estimado exigido: &libdisplay-info-buildsize;
        </para>
      </listitem>
      <listitem>
        <para>
          Tempo de construção estimado: &libdisplay-info-time;
        </para>
      </listitem>
    </itemizedlist>

   <bridgehead renderas="sect3">Dependências de libdisplay-info</bridgehead>

    <bridgehead renderas="sect4">Exigidas</bridgehead>
    <para role="required">
      <xref linkend="hwdata"/>
    </para>

  </sect2>

  <sect2 role="installation">
    <title>Instalação do libdisplay-info</title>

    <para>
      Instale <application>libdisplay-info</application> executando os seguintes
comandos:
    </para>

<screen><userinput>mkdir build &amp;&amp;
cd    build &amp;&amp;

meson setup --prefix=/usr --buildtype=release .. &amp;&amp;
ninja</userinput></screen>

    <para>
      Para testar os resultados, execute <command>ninja test</command>.
    </para>

    <para>
      Agora, como o(a) usuário(a) &root;:
    </para>

<screen role="root"><userinput>ninja install</userinput></screen>

  </sect2>

