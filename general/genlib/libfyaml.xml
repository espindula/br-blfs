          fy-compose (linque para fy-tool), fy-dump (linque para fy-tool), fy-filter
(linque para fy-tool), fy-join (linque para fy-tool), fy-testsuite (linque
para fy-tool), fy-tool e fy-ypath (linque para fy-tool)
        </seg>
        <seg>
          libfyaml.so
        </seg>
        <seg>
          Nenhum(a)
        </seg>
      </seglistitem>
    </segmentedlist>

    <variablelist>
      <bridgehead renderas="sect3">Descrições Curtas</bridgehead>
      <?dbfo list-presentation="list"?> <?dbhtml list-presentation="table"?>

      <varlistentry id="fy-tool">
        <term><command>fy-tool</command></term>
        <listitem>
          <para>
            manipula arquivos YAML até a versão 1.3 do padrão
          </para>
          <indexterm zone="libfyaml fy-tool">
            <primary sortas="b-fy-tool">fy-tool</primary>
          </indexterm>
        </listitem>
      </varlistentry>

      <varlistentry id="lib-libfyaml">
        <term><filename class="libraryfile">libfyaml.so</filename></term>
        <listitem>
          <para>
            contém funções que conseguem analisar e emitir arquivos YAML até a versão
1.3 do padrão
          </para>
          <indexterm zone="libfyaml lib-libfyaml">
            <primary sortas="c-lib-libfyaml">libfyaml.so</primary>
          </indexterm>
        </listitem>
      </varlistentry>

    </variablelist>

  </sect2>

