  <sect2 role="installation">
    <title>Instalação do SCons</title>

    <para>
      Construa o pacote:
    </para>

    &build-wheel;

    <para>
      Como o(a) usuário(a) &root;, instale o pacote:
    </para>

    <screen role='root'><userinput>&install-wheel; SCons &amp;&amp;
install -v -m664 *.1 /usr/share/man/man1</userinput></screen>
  </sect2>

  <sect2 role="content">
    <title>Conteúdo</title>

    <segmentedlist>
      <segtitle>Aplicativos Instalados</segtitle>
      <segtitle>Bibliotecas Instaladas</segtitle>
      <segtitle>Diretório Instalado</segtitle>

      <seglistitem>
        <seg>
          scons, scons-configure-cache e sconsign
        </seg>
        <seg>
          Nenhum(a)
        </seg>
        <seg>
          /usr/lib/python&python3-majorver;/site-packages/SCons{,-&scons-version;.dist-info}
        </seg>
      </seglistitem>
    </segmentedlist>

    <variablelist>
      <bridgehead renderas="sect3">Descrições Curtas</bridgehead>
      <?dbfo list-presentation="list"?> <?dbhtml list-presentation="table"?>

      <varlistentry id="scons-prog">
        <term><command>scons</command></term>
        <listitem>
          <para>
            é uma ferramenta de construção de logiciário
          </para>
          <indexterm zone="scons scons-prog">
            <primary sortas="b-scons">scons</primary>
          </indexterm>
        </listitem>
      </varlistentry>

      <varlistentry id="scons-configure-cache">
        <term><command>scons-configure-cache</command></term>
        <listitem>
          <para>
            mostra ou converte a configuração de um diretório de cache do
&quot;<application>SCons</application>&quot;
          </para>
          <indexterm zone="scons scons-configure-cache">
            <primary sortas="b-scons-configure-cache">scons-configure-cache</primary>
          </indexterm>
        </listitem>
      </varlistentry>

      <varlistentry id="sconsign">
        <term><command>sconsign</command></term>
        <listitem>
          <para>
            imprime informações do arquivo <filename>.sconsign</filename> do
<application>SCons</application>
          </para>
          <indexterm zone="scons sconsign">
            <primary sortas="b-sconsign">sconsign</primary>
          </indexterm>
        </listitem>
      </varlistentry>

    </variablelist>

  </sect2>

