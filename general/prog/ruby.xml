            <primary sortas="b-erb">erb</primary>
          </indexterm>
        </listitem>
      </varlistentry>

      <varlistentry id="gem">
        <term><command>gem</command></term>
        <listitem>
          <para>
            é o comando para &quot;RubyGems&quot;, que é um sofisticado gerenciador de
