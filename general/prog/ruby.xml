          <indexterm zone="ruby gem">
            <primary sortas="b-gem">gem</primary>
          </indexterm>
        </listitem>
      </varlistentry>

      <varlistentry id="irb">
        <term><command>irb</command></term>
        <listitem>
          <para>
            é a interface interativa para &quot;<application>Ruby</application>&quot;
