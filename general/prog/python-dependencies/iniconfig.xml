  <sect2 id="iniconfig" xreflabel="iniconfig-&iniconfig-version;">

    <title>Iniconfig-&iniconfig-version;</title>

    <indexterm zone="iniconfig">
      <primary sortas="a-iniconfig">iniconfig</primary>
    </indexterm>

    <sect3 role="package">
      <title>Introdução ao Módulo Iniconfig</title>

      <para>
        <application>Iniconfig</application> é um módulo analisador de arquivo
&quot;INI&quot; pequeno e simples.
      </para>

      &lfs130_checked;

      <bridgehead renderas="sect4">Informação do Pacote</bridgehead>
      <itemizedlist spacing="compact">
        <listitem>
          <para>
            Transferência (HTTP): <ulink url="&iniconfig-download-http;"/>
          </para>
        </listitem>
        <listitem>
          <para>
            Transferência (FTP): <ulink url="&iniconfig-download-ftp;"/>
          </para>
        </listitem>
        <listitem>
          <para>
            Soma de verificação MD5 da transferência: &iniconfig-md5sum;
          </para>
        </listitem>
        <listitem>
          <para>
            Tamanho da transferência: &iniconfig-size;
          </para>
        </listitem>
        <listitem>
          <para>
            Espaço em disco estimado exigido: &iniconfig-buildsize;
          </para>
        </listitem>
        <listitem>
          <para>
            Tempo de construção estimado: &iniconfig-time;
          </para>
        </listitem>
      </itemizedlist>

      <bridgehead renderas="sect4">Dependências do Iniconfig</bridgehead>

      <bridgehead renderas="sect5">Exigidas</bridgehead>
      <para role="required">
        <xref linkend="setuptools_scm"/>
      </para>

      <bridgehead renderas="sect5">Opcionais (para testagem)</bridgehead>
      <para role="optional">
        <xref linkend="pytest"/>
      </para>

    </sect3>

    <sect3 role="installation">
      <title>Instalação do Iniconfig</title>

    <para>Construa o módulo: </para>

<!--
    <para>

      This package does not come with a test suite.
    </para>
-->
&build-wheel;



    <para>
      Agora, como o(a) usuário(a) &quot;<systemitem
class="username">root</systemitem>&quot;:
    </para>

<screen role="root"><userinput>&install-wheel; iniconfig</userinput></screen>

     <para>
       Para testar os resultados, emita: <command>pytest</command>
     </para>

    </sect3>

