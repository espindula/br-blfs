<sect1 id="imath" xreflabel="Imath-&Imath-version;">
  <?dbhtml filename="imath.html"?>

  <title>Imath-&Imath-version;</title>

  <indexterm zone="imath">
    <primary sortas="a-Imath-&Imath-version;">Imath</primary>
  </indexterm>

  <sect2 role="package">
    <title>Introdução ao Imath</title>

    <para>
      <application>Imath</application> é uma biblioteca em C++ e Python de
operações vetoriais, matriciais e matemáticas em 2D e 3D para computação
gráfica.
    </para>

    &lfs130_checked;

    <bridgehead renderas="sect3">Informação do Pacote</bridgehead>
    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Transferência (HTTP): <ulink url="&Imath-download-http;"/>
        </para>
      </listitem>
      <listitem>
        <para>
          Transferência (FTP): <ulink url="&Imath-download-ftp;"/>
        </para>
      </listitem>
      <listitem>
        <para>
          Soma de verificação MD5 da transferência: &Imath-md5sum;
        </para>
      </listitem>
      <listitem>
        <para>
          Tamanho da transferência: &Imath-size;
        </para>
      </listitem>
      <listitem>
        <para>
          Espaço em disco estimado exigido: &Imath-buildsize;
        </para>
      </listitem>
      <listitem>
        <para>
          Tempo de construção estimado: &Imath-time;
        </para>
      </listitem>
    </itemizedlist>

    <bridgehead renderas="sect3">Dependências do Imath</bridgehead>

    <bridgehead renderas="sect4">Exigidas</bridgehead>
    <para role="required">
      <xref linkend="cmake"/>
    </para>

    <bridgehead renderas="sect4">Recomendadas</bridgehead>
    <para role="recommended">
      <xref linkend="boost"/> e <xref linkend="numpy"/>
    </para>

  </sect2>

  <sect2 role="installation">
    <title>Instalação do Imath</title>

    <para>
      Instale <application>Imath</application> executando os seguintes comandos:
    </para>

<screen><userinput>mkdir build &amp;&amp;
cd    build &amp;&amp;

cmake -D CMAKE_INSTALL_PREFIX=/usr \
      -D CMAKE_BUILD_TYPE=Release  \
      -D PYTHON=ON                 \
      ..  &amp;&amp;
make</userinput></screen>

    <para>
      Para testar os resultados, emita: <command>make test</command>.
    </para>

    <para>
      Agora, como o(a) usante <systemitem class="username">root</systemitem>:
    </para>

<screen role="root"><userinput>make install</userinput></screen>

  </sect2>

  <sect2 role="commands">
    <title>Explicações do Comando</title>

    <para>
      <parameter>-D PYTHON=ON</parameter>: Essa opção habilita construir os
módulos Python. Ela pode ser desabilitada se <xref linkend="numpy"/> não
estiver instalado.
    </para>

  </sect2>

  <sect2 role="content">
    <title>Conteúdo</title>

    <segmentedlist>
      <segtitle>Aplicativos Instalados</segtitle>
      <segtitle>Biblioteca Instalada</segtitle>
      <segtitle>Diretórios Instalados</segtitle>

      <seglistitem>
        <seg>None</seg>
        <seg>
          libImath.so, libImath-3_2.so, libPyImath.so e libPyImath_Python3_14-3_2.so
        </seg>
        <seg>
          /usr/include/Imath e /usr/lib/cmake/Imath
        </seg>
      </seglistitem>
    </segmentedlist>



