<sect1 id="libheif" xreflabel="libheif-&libheif-version;">
  <?dbhtml filename="libheif.html"?>

  <title>libheif-&libheif-version;</title>

  <!--Required section-->
<indexterm zone="libheif">
    <primary sortas="a-libheif">libheif</primary>
  </indexterm>

  
  <sect2 role="package">
    <title>Introdução ao libheif</title>

    <para>
      O pacote <application>libheif</application> é um decodificador e codificador
de formatos de arquivo HEIF e AVIF.
    </para>

    &lfs124_checked;

    <bridgehead renderas="sect3">Informação do Pacote</bridgehead>
    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Transferência (HTTP): <ulink url="&libheif-download-http;"/>
        </para>
      </listitem>
      <listitem>
        <para>
          Soma de verificação MD5 da transferência: &libheif-md5sum;
        </para>
      </listitem>
      <listitem>
        <para>
          Tamanho da transferência: &libheif-size;
        </para>
      </listitem>
      <listitem>
        <para>
          Espaço em disco estimado exigido: &libheif-buildsize;
        </para>
      </listitem>
      <listitem>
        <para>
          Tempo de construção estimado: &libheif-time;
        </para>
      </listitem>
    </itemizedlist>

    <bridgehead renderas="sect3">Dependências do libheif</bridgehead>

    <bridgehead renderas="sect4">Recomendadas</bridgehead>
    <para>
      <xref linkend='libaom'/>, <xref linkend='libde265'/> e <xref
linkend='x265'/>
    </para>

    <bridgehead renderas="sect4">Opcionais</bridgehead>
    <para role="optional">
      <xref linkend='brotli'/>, <xref linkend='dav1d'/>, <xref
linkend='doxygen'/>, <xref linkend='ffmpeg'/>, <xref linkend='gdk-pixbuf'/>,
<xref linkend='libjpeg'/>, <xref linkend='libpng'/>, <xref
linkend='libtiff'/>, <xref linkend='libwebp'/>, <xref linkend='openjpeg2'/>,
<xref linkend='sdl2'/>, <xref linkend='svt-av1'/>, <xref linkend='x264'/>,
<ulink url="https://github.com/ultravideo/kvazaar">kvaaar</ulink>, <ulink
url="https://www.openh264.org/">openh264</ulink>, <ulink
url="https://github.com/aous72/OpenJPH">openjph</ulink>, <ulink
url="https://github.com/ultravideo/uvg266">uvg266</ulink>, <ulink
url="https://github.com/fraunhoferhhi/vvdec">vvdec</ulink>, <ulink
url="https://github.com/fraunhoferhhi/vvenc">vvenc</ulink> e <ulink
url="https://github.com/xiph/rav1e">rav1e</ulink>
    </para>

    
  <!--  Only use this if you want to note something in the wiki
