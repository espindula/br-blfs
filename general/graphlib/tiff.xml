<sect1 id="tiff" xreflabel="tiff-&tiff-version;">
  <?dbhtml filename="tiff.html"?>

  <title>tiff-&tiff-version;</title>

  <indexterm zone="tiff">
    <primary sortas="a-tiff">tiff</primary>
  </indexterm>

  <sect2 role="package">
    <title>Introdução ao tiff</title>

    <para>
      O pacote <application>tiff</application> contém as bibliotecas TIFF e
utilitários associados. As bibliotecas são usadas por muitos programas para
ler e escrever arquivos TIFF, e os utilitários são usados para tarefas
gerais com arquivos TIFF.
    </para>

    &lfs130_checked;

    <bridgehead renderas="sect3">Informação do Pacote</bridgehead>
    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Transferência (HTTP): <ulink url="&tiff-download-http;"/>
        </para>
      </listitem>
      <listitem>
        <para>
          Transferência (FTP): <ulink url="&tiff-download-ftp;"/>
        </para>
      </listitem>
      <listitem>
        <para>
          Soma de verificação MD5 da transferência: &tiff-md5sum;
        </para>
      </listitem>
      <listitem>
        <para>
          Tamanho da transferência: &tiff-size;
        </para>
      </listitem>
      <listitem>
        <para>
          Espaço em disco estimado exigido: &tiff-buildsize;
        </para>
      </listitem>
      <listitem>
        <para>
          Tempo de construção estimado: &tiff-time;
        </para>
      </listitem>
    </itemizedlist>



