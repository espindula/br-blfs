<sect1 id="pdfio" xreflabel="pdfio-&pdfio-version;">
  <?dbhtml filename="pdfio.html"?>

  <title>pdfio-&pdfio-version;</title>

  <indexterm zone="pdfio">
    <primary sortas="a-pdfio">pdfio</primary>
  </indexterm>

  <sect2 role="package">
    <title>Introdução ao pdfio</title>

    <para>
      O pacote <application>pdfio</application> contém uma biblioteca C simples
para leitura e escrita de arquivos PDF.
    </para>

    &lfs130_checked;

    <bridgehead renderas="sect3">Informação do Pacote</bridgehead>
    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Transferência (HTTP): <ulink url="&pdfio-download-http;"/>
        </para>
      </listitem>
      <listitem>
        <para>
          Transferência (FTP): <ulink url="&pdfio-download-ftp;"/>
        </para>
      </listitem>
      <listitem>
        <para>
          Soma de verificação MD5 da transferência: &pdfio-md5sum;
        </para>
      </listitem>
      <listitem>
        <para>
          Tamanho da transferência: &pdfio-size;
        </para>
      </listitem>
      <listitem>
        <para>
          Espaço em disco estimado exigido: &pdfio-buildsize;
        </para>
      </listitem>
      <listitem>
        <para>
          Tempo de construção estimado: &pdfio-time;
        </para>
      </listitem>
    </itemizedlist>

    <bridgehead renderas="sect3">Dependências do pdfio</bridgehead>

    <bridgehead renderas="sect4">Recomendadas</bridgehead>
    <para role="recommended">
      <xref linkend="libpng"/>
    </para>

  </sect2>

  <sect2 role="installation">
    <title>Instalação do pdfio</title>

    <para>
      Instale <application>pdfio</application> executando os seguintes comandos:
    </para>

<screen><userinput>./configure --prefix=/usr    \
            --disable-static \
            --enable-shared  &amp;&amp;
make</userinput></screen>

    <para>
      Esse pacote não vem com uma suíte de teste.
    </para>

    <para>
      Agora, como o(a) usante <systemitem class="username">root</systemitem>:
    </para>

<screen role="root"><userinput>make install &amp;&amp;
mv -v /usr/share/doc/pdfio{,-&pdfio-version;}
</userinput></screen>

  </sect2>

