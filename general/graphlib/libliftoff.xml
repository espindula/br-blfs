    <primary sortas="a-libliftoff">libliftoff</primary>
  </indexterm>

  <sect2 role="package">
    <title>Introdução ao libliftoff</title>

    <para>
      O pacote libliftoff fornece uma biblioteca que lida com planos KMS.
    </para>

    &lfs130_checked;

    <bridgehead renderas="sect3">Informação do Pacote</bridgehead>
    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Transferência (HTTP): <ulink url="&libliftoff-download-http;"/>
        </para>
      </listitem>
      <listitem>
        <para>
          Soma de verificação MD5 da transferência: &libliftoff-md5sum;
        </para>
      </listitem>
      <listitem>
        <para>
          Tamanho da transferência: &libliftoff-size;
        </para>
      </listitem>
      <listitem>
        <para>
          Espaço em disco estimado exigido: &libliftoff-buildsize;
        </para>
      </listitem>
      <listitem>
        <para>
          Tempo de construção estimado: &libliftoff-time;
        </para>
      </listitem>
    </itemizedlist>

    <bridgehead renderas="sect3">Dependências do libliftoff</bridgehead>

    <bridgehead renderas="sect4">Recomendadas</bridgehead>
    <para role="recommended">
      <xref linkend="libdrm"/>
    </para>
  </sect2>

  <sect2 role="installation">
    <title>Instalação do libliftoff</title>

    <para>
      Instale libliftoff executando os seguintes comandos:
    </para>

<screen><userinput>mkdir build &amp;&amp;
cd    build &amp;&amp;

meson setup --prefix=/usr --buildtype=release .. &amp;&amp;
ninja</userinput></screen>

    <para>
      Para executar a suíte de teste, emita: <command>ninja test</command>.
    </para>

    <para>
      Agora, como o(a) usuário(a) &root;:
    </para>

<screen role="root"><userinput>ninja install</userinput></screen>

  </sect2>

