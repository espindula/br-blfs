<sect1 id="xdg-user-dirs" xreflabel="Xdg-user-dirs-&xdg-user-dirs-version;">
  <?dbhtml filename="xdg-user-dirs.html"?>

  <title>Xdg-user-dirs-&xdg-user-dirs-version;</title>

  <indexterm zone="xdg-user-dirs">
