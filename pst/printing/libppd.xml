<sect1 id="libppd" xreflabel="libppd-&libppd-version;">
  <?dbhtml filename="libppd.html"?>


  <title>libppd-&libppd-version;</title>

  <indexterm zone="libppd">
    <primary sortas="a-libppd">libppd</primary>
  </indexterm>

  <sect2 role="package">
    <title>Introdução ao libppd</title>

    <para>
      A biblioteca <application>libppd</application> contém funções para lidar com
impressoras legadas usando arquivos de descrição PPD.
    </para>

    &lfs123_checked;

    <bridgehead renderas="sect3">Informação do Pacote</bridgehead>
    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Transferência (HTTP): <ulink url="&libppd-download-http;"/>
        </para>
      </listitem>
      <listitem>
        <para>
          Transferência (FTP): <ulink url="&libppd-download-ftp;"/>
        </para>
      </listitem>
      <listitem>
        <para>
          Soma de verificação MD5 da transferência: &libppd-md5sum;
        </para>
      </listitem>
      <listitem>
        <para>
          Tamanho da transferência: &libppd-size;
        </para>
      </listitem>
      <listitem>
        <para>
          Espaço em disco estimado exigido: &libppd-buildsize;
        </para>
      </listitem>
      <listitem>
        <para>
          Tempo de construção estimado: &libppd-time;
        </para>
      </listitem>
    </itemizedlist>

    <bridgehead renderas="sect3">Dependências do libppd</bridgehead>

    <bridgehead renderas="sect4">Exigidas</bridgehead>
    <para role="required">
      <xref linkend="libcupsfilters"/>
    </para>

  </sect2>

  <sect2 role="installation">
    <title>Instalação do libppd</title>

    <para>
      Instale <application>libppd</application> executando os seguintes comandos:
    </para>

<screen><userinput>./configure --prefix=/usr                \
            --disable-static             \
            --with-cups-rundir=/run/cups \
            --enable-ppdc-utils          \
            --docdir=/usr/share/doc/libppd-&libppd-version; &amp;&amp;
make</userinput></screen>

    <para>
      Para testar os resultados, emita <command>make check</command>.
    </para>

    <para>
      Agora, como o(a) usuário(a) <systemitem class="username">root</systemitem>:
    </para>

<screen role="root"><userinput>make install</userinput></screen>

  </sect2>

  <sect2 role="commands">
    <title>Explicações do Comando</title>

    <xi:include xmlns:xi="http://www.w3.org/2001/XInclude"
      href="../../xincludes/static-libraries.xml"/>

    <para>
      <parameter>--with-cups-rundir=/run/cups</parameter>: Define o diretório que
contém dados transitórios de impressão. O padrão <filename
class="directory">/var/run/cups</filename> está obsoleto.
    </para>

    <para>
      <!-- This is not required until cups v3 is out, since those utilities
      are also installed by cups v2. But since cups v3 should be out before
      our next release, I put it here. Pierre -->
<parameter>--enable-ppdc-utils</parameter>: Permite construir utilitários
para manipular arquivos <emphasis>.ppd</emphasis>.
      
    </para>

  </sect2>

  <sect2 role="content">
    <title>Conteúdo</title>

    <segmentedlist>
      <segtitle>Aplicativos Instalados</segtitle>
      <segtitle>Bibliotecas Instaladas</segtitle>
      <segtitle>Diretórios Instalados</segtitle>

      <seglistitem>
        <seg>
          ppdc, ppdhtml, ppdi, ppdmerge e ppdpo
        </seg>
        <seg>
          libppd.so
        </seg>
        <seg>
          /usr/include/ppd, /usr/share/ppdc e /usr/share/doc/libppd-&libppd-version;
        </seg>
      </seglistitem>
    </segmentedlist>

    <variablelist>
      <bridgehead renderas="sect3">Descrições Curtas</bridgehead>
      <?dbfo list-presentation="list"?> <?dbhtml list-presentation="table"?>

      <varlistentry id="libppd-ppdc">
        <term><command>ppdc</command></term>
        <listitem>
          <para>
            compila arquivos fonte PPDC em um ou mais arquivos PPD
          </para>
          <indexterm zone="libppd libppd-ppdc">
            <primary sortas="b-ppdc">ppdc</primary>
          </indexterm>
        </listitem>
      </varlistentry>

      <varlistentry id="libppd-ppdhtml">
        <term><command>ppdhtml</command></term>
        <listitem>
          <para>
            lê um arquivo de informações do controlador e produz uma página HTML de
resumo que lista todos os controladores em um arquivo e as opções suportadas
          </para>
          <indexterm zone="libppd libppd-ppdhtml">
            <primary sortas="b-ppdhtml">ppdhtml</primary>
          </indexterm>
        </listitem>
      </varlistentry>

      <varlistentry id="libppd-ppdi">
        <term><command>ppdi</command></term>
        <listitem>
          <para>
            importa um ou mais arquivos PPD para um arquivo fonte de compilador de PPD
          </para>
          <indexterm zone="libppd libppd-ppdi">
            <primary sortas="b-ppdi">ppdi</primary>
          </indexterm>
        </listitem>
      </varlistentry>

      <varlistentry id="libppd-ppdmerge">
        <term><command>ppdmerge</command></term>
        <listitem>
          <para>
            mescla dois ou mais arquivos PPD em um arquivo PPD multilíngue
          </para>
          <indexterm zone="libppd libppd-ppdmerge">
            <primary sortas="b-ppdmerge">ppdmerge</primary>
          </indexterm>
        </listitem>
      </varlistentry>

      <varlistentry id="libppd-ppdpo">
        <term><command>ppdpo</command></term>
        <listitem>
          <para>
            extrai sequências de caracteres de UI a partir de arquivos fonte PPDC e
atualiza um arquivo fonte de catálogo de mensagens em formato de sequências
de caracteres ou GNU gettext ou Mac OS X para tradução
          </para>
          <indexterm zone="libppd libppd-ppdpo">
            <primary sortas="b-ppdpo">ppdpo</primary>
          </indexterm>
        </listitem>
      </varlistentry>

      <varlistentry id="libppd-lib">
        <term><filename class="libraryfile">libppd.so</filename></term>
        <listitem>
          <para>
            contém funções de API para manipular arquivos <emphasis>.ppd</emphasis>
          </para>
          <indexterm zone="libppd libppd-lib">
            <primary sortas="c-libppd">libppd.so</primary>
          </indexterm>
        </listitem>
      </varlistentry>

    </variablelist>

  </sect2>

</sect1>
