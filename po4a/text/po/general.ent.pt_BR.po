"                         </para></note>\">\n"
"-->\n"
"<!-- Fim entidades especiais acerca de compatibilidade do LFS -->\n"

#. type: Plain text
#: text/upstream/general.ent:151
#, no-wrap
msgid ""
"<!ENTITY as_root \"<note><para>When installing multiple packages in a "
"script,\n"
"  the installation needs to be done as the root user. There are three "
"general\n"
"  options that can be used to do this:</para>\n"
msgstr ""
"<!ENTITY as_root \"<note><para>Quando se instalar múltiplos pacotes em\n"
"                 um conjunto de comandos sequênciais, a instalação\n"
"                 precisa ser feita como o(a) usuário(a) root. Existem\n"
"                 três opções gerais que podem ser usadas para se fazer\n"
"                 isso:</para>\n"

#. type: Plain text
#: text/upstream/general.ent:153
#, no-wrap
msgid "  <orderedlist>\n"
msgstr "  <orderedlist>\n"

#. type: Plain text
#: text/upstream/general.ent:156
#, no-wrap
msgid ""
"  <listitem><para>Run the entire script as the root user (not\n"
"  recommended).</para></listitem>\n"
msgstr ""
"  <listitem><para>Executar o conjunto inteiro de comandos sequênciais\n"
"  como o(a) usuário(a) root (não recomendado).</para></listitem>\n"

#. type: Plain text
#: text/upstream/general.ent:159
#, no-wrap
msgid ""
"  <listitem><para>Use the <command>sudo</command> command from the <xref\n"
"  linkend='sudo'/> package.</para></listitem>\n"
msgstr ""
"  <listitem><para>Usar-se o comando <command>sudo</command> originário\n"
"  do pacote <xref linkend='sudo'/>.</para></listitem>\n"

#. type: Plain text
#: text/upstream/general.ent:163
#, no-wrap
msgid ""
"  <listitem><para>Use <command>su -c &quot;command "
"arguments&quot;</command>\n"
"  (quotes required) which will ask for the root  password for every "
"iteration\n"
"  of the loop.</para></listitem>\n"
msgstr ""
"  <listitem><para>Usar-se <command>su -c &quot;argumentos do\n"
"  comando&quot;</command> (aspas exigidas), que solicitará a senha\n"
"  do(a) root para cada interação do ciclo.</para></listitem>\n"

#. type: Plain text
#: text/upstream/general.ent:165
#, no-wrap
msgid "  </orderedlist>\n"
msgstr "  </orderedlist>\n"

#. type: Plain text
#: text/upstream/general.ent:170
#, no-wrap
msgid ""
"  <para>One way to handle this situation is to create a short\n"
"  <command>bash</command> function that automatically selects the "
"appropriate\n"
"  method.  Once the command is set in the environment, it does not need to "
"be\n"
"  set again.</para>\n"
msgstr ""
"  <para>Uma maneira para se lidar com essa situação é a de se criar\n"
"  uma função curta do <command>bash</command> que automaticamente\n"
"  selecione o método apropriado. Uma vez que o comando esteja\n"
"  configurado no ambiente, não se precisa configurá-lo\n"
"  novamente.</para>\n"

#. type: Plain text
#: text/upstream/general.ent:178
#, no-wrap
msgid ""
"  <screen><userinput>as_root()\n"
"{\n"
"  if   [ $EUID = 0 ];        then $*\n"
"  elif [ -x /usr/bin/sudo ]; then sudo $*\n"
"  else                            su -c \\\\&quot;$*\\\\&quot;\n"
"  fi\n"
"}\n"
msgstr ""
"  <screen><userinput>as_root()\n"
"{\n"
"  if   [ $EUID = 0 ];        then $*\n"
"  elif [ -x /usr/bin/sudo ]; then sudo $*\n"
"  else                            su -c \\\\&quot;$*\\\\&quot;\n"
"  fi\n"
"}\n"

#. type: Plain text
#: text/upstream/general.ent:181
msgid "export -f as_root</userinput></screen> </note>\">"
msgstr "export -f as_root</userinput></screen> </note>\">"

