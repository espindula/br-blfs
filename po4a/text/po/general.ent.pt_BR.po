#. type: Plain text
#: text/upstream/general.ent:191
#, no-wrap
msgid ""
"<!ENTITY parallel_issues \"<note><para>This package may occasionally fail "
"when\n"
"                          building with multiple processors.  See <xref\n"
"                          linkend='parallel-builds'/> for more "
"information.</para></note>\">\n"
msgstr ""
"<!ENTITY parallel_issues \"<note><para>Esse pacote possível e\n"
"                         ocasionalmente falhe ao construir com\n"
"                         múltiplos processadores. Veja-se\n"
"                         <xref linkend='parallel-builds'/> para\n"
"                         mais informações.</para></note>\">\n"

#. type: Plain text
#: text/upstream/general.ent:196
#, no-wrap
msgid ""
"<!ENTITY shell-env \"<note><para>If installing in the chroot environment, "
"be\n"
"                    sure to export the <envar>SHELL</envar> environment\n"
"                    variable or configuration of the package will\n"
"                    fail.</para></note>\">\n"
msgstr ""
"<!ENTITY shell-env \"<note><para>Se instalar no ambiente chroot,\n"
"                   assegure-se de exportar a variável de ambiente\n"
"                   <envar>SHELL</envar> ou a configuração do pacote\n"
"                   falhará.</para></note>\">\n"

#. type: Plain text
#: text/upstream/general.ent:203
#, no-wrap
msgid ""
"<!ENTITY gi-doc-disable\n"
"         \"Allow building this package without <xref linkend='gi-docgen'/>\n"
"          installed.  If you have <xref linkend='gi-docgen'/> installed and\n"
"          you wish to rebuild and install the API documentation, a\n"
"          <command>meson configure</command> command will reset this\n"
"          option.\">\n"
msgstr ""
"<!ENTITY gi-doc-disable\n"
"         \"Permitir construir esse pacote sem <xref linkend='gi-docgen'/>\n"
"         instalado. Se você tiver <xref linkend='gi-docgen'/> instalado e\n"
"         desejar reconstruir e instalar a documentação da API, um comando\n"
"         <command>meson configure</command> reconfigurará essa opção.\">\n"

#. type: Plain text
#: text/upstream/general.ent:211
#, no-wrap
msgid ""
"<!-- \"Required\" may not be true here, but in 2025 we should really just\n"
"     consider SSL required for the Internet.  -->\n"
"<!ENTITY build-use-internet\n"
"         \"<note><para>An Internet connection is needed for building this\n"
"          package.  The system certificate store may need to be set up with\n"
"          <xref role='required' linkend='make-ca'/> before building this\n"
"          package.</para></note>\">\n"
msgstr ""
"<!-- \"Exigido\" possivelmente não seja verdade aqui, porém em 2025 nós\n"
"     deveríamos realmente somente considerar SSL como exigido para a\n"
"     Internet.  -->\n"
"<!ENTITY build-use-internet\n"
"         \"<note><para>Uma conexão com a Internet é necessária para se\n"
"         construir esse pacote. A loja de certificados do sistema\n"
"         possivelmente precise estar configurada com\n"
"         <xref role='required' linkend='make-ca'/> antes de se construir\n"
"         esse pacote.</para></note>\">\n"

#. type: Plain text
#: text/upstream/general.ent:217
#, no-wrap
msgid ""
"<!ENTITY test-use-internet\n"
"         \"<note><para>An Internet connection is needed for some tests of\n"
"          this package.  The system certificate store may need to be set up\n"
"          with <xref role='optional' linkend='make-ca'/> before testing "
"this\n"
"          package.</para></note>\">\n"
msgstr ""
"<!ENTITY test-use-internet\n"
"         \"<note><para>Uma conexão com Internet é necessária para alguns\n"
"         testes desse pacote. A loja de certificados do sistema\n"
"         possivelmente precise estar configurada com\n"
"         <xref role='optional' linkend='make-ca'/> antes da testagem\n"
"         desse pacote.</para></note>\">\n"

