#. type: Plain text
#: text/upstream/general.ent:151
#, no-wrap
msgid ""
"<!ENTITY as_root \"<note><para>When installing multiple packages in a script,\n"
"  the installation needs to be done as the root user. There are three general\n"
"  options that can be used to do this:</para>\n"
msgstr ""

#. type: Plain text
#: text/upstream/general.ent:153
#, no-wrap
msgid "  <orderedlist>\n"
msgstr ""

#. type: Plain text
#: text/upstream/general.ent:156
#, no-wrap
msgid ""
"  <listitem><para>Run the entire script as the root user (not\n"
"  recommended).</para></listitem>\n"
msgstr ""

#. type: Plain text
#: text/upstream/general.ent:159
#, no-wrap
msgid ""
"  <listitem><para>Use the <command>sudo</command> command from the <xref\n"
"  linkend='sudo'/> package.</para></listitem>\n"
msgstr ""

#. type: Plain text
#: text/upstream/general.ent:163
#, no-wrap
msgid ""
"  <listitem><para>Use <command>su -c &quot;command arguments&quot;</command>\n"
"  (quotes required) which will ask for the root  password for every iteration\n"
"  of the loop.</para></listitem>\n"
msgstr ""

#. type: Plain text
#: text/upstream/general.ent:165
#, no-wrap
msgid "  </orderedlist>\n"
msgstr ""

#. type: Plain text
#: text/upstream/general.ent:170
#, no-wrap
msgid ""
"  <para>One way to handle this situation is to create a short\n"
"  <command>bash</command> function that automatically selects the appropriate\n"
"  method.  Once the command is set in the environment, it does not need to be\n"
"  set again.</para>\n"
msgstr ""

#. type: Plain text
#: text/upstream/general.ent:178
#, no-wrap
msgid ""
"  <screen><userinput>as_root()\n"
"{\n"
"  if   [ $EUID = 0 ];        then $*\n"
"  elif [ -x /usr/bin/sudo ]; then sudo $*\n"
"  else                            su -c \\\\&quot;$*\\\\&quot;\n"
"  fi\n"
"}\n"
msgstr ""

#. type: Plain text
#: text/upstream/general.ent:181
msgid "export -f as_root</userinput></screen> </note>\">"
msgstr ""

