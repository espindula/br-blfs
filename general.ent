<!-- Fim versões do LFS -->

<!ENTITY blfs-bootscripts-version     "20251220">
<!ENTITY systemd-units-version        "20251204">

<!ENTITY blfs-wiki                    "https://wiki.&lfs-domainname;/blfs/wiki">

<!-- Estas entidades são usadas para anotar a atual situação de um pacote,
     conforme se relacione com a versão do LFS em relação à qual
     construirá/funcionará -->


<!ENTITY lfs130_checked  "<note><para>Versões de desenvolvimento do BLFS
                          possivelmente não construam ou executem alguns
                          pacotes adequadamente se o LFS, ou dependências,
                          tiver sido atualizado desde as versões estáveis
                          mais recentes dos livros.</para></note>">

<!ENTITY lfs131_checked  "<note><para>
                         <phrase revision='systemd'> This package is known to build 
                         and work properly using an LFS 13.1 platform.</phrase>
                         <phrase revision='sysv'>This version of BLFS may not build or run
                         some packages properly if LFS or dependencies have been updated
                         since the most recent stable version of the System V books.</phrase>
                         </para></note>">

<!-- Fim das entidades especiais acerca de compatibilidade do LFS -->

<!ENTITY as_root "<note><para>Quando se instalar múltiplos pacotes em
                 um conjunto de comandos sequênciais, a instalação
                 precisa ser feita como o(a) usuário(a) root. Existem
                 três opções gerais que podem ser usadas para se fazer
                 isso:</para>

  <orderedlist>

  <listitem><para>Executar o conjunto inteiro de comandos sequênciais
  como o(a) usuário(a) root (não recomendado).</para></listitem>

  <listitem><para>Usar-se o comando <command>sudo</command> originário
  do pacote <xref linkend='sudo'/>.</para></listitem>

  <listitem><para>Usar-se <command>su -c &quot;argumentos do
  comando&quot;</command> (aspas exigidas), que solicitará a senha
  do(a) root para cada interação do ciclo.</para></listitem>

  </orderedlist>

  <para>Uma maneira para se lidar com essa situação é a de se criar
  uma função curta do <command>bash</command> que automaticamente
  selecione o método apropriado. Uma vez que o comando esteja
  configurado no ambiente, não se precisa configurá-lo
  novamente.</para>

  <screen><userinput>as_root()
{
  if   [ $EUID = 0 ];        then $*
  elif [ -x /usr/bin/sudo ]; then sudo $*
  else                            su -c \\&quot;$*\\&quot;
  fi
}

export -f as_root</userinput></screen> </note>">

<!ENTITY not-katamari         "<para>Esse pacote é fornecido para
                              testagem da instalação completa do
                              Xorg.</para>">

<!ENTITY % package-entities SYSTEM      "packages.ent">
%package-entities;

<!ENTITY parallel_issues "<note><para>Esse pacote possível e
                         ocasionalmente falhe ao construir com
                         múltiplos processadores. Veja-se
                         <xref linkend='parallel-builds'/> para
                         mais informações.</para></note>">

<!ENTITY shell-env "<note><para>Se instalar no ambiente chroot,
                   assegure-se de exportar a variável de ambiente
                   <envar>SHELL</envar> ou a configuração do pacote
                   falhará.</para></note>">

<!ENTITY gi-doc-disable
         "Permitir construir esse pacote sem <xref linkend='gi-docgen'/>
         instalado. Se você tiver <xref linkend='gi-docgen'/> instalado e
         desejar reconstruir e instalar a documentação da API, um comando
         <command>meson configure</command> reconfigurará essa opção.">

<!-- "Exigido" possivelmente não seja verdade aqui, porém em 2025 nós
     deveríamos realmente somente considerar SSL como exigido para a
     Internet.  -->
<!ENTITY build-use-internet
         "<note><para>Uma conexão com a Internet é necessária para se
         construir esse pacote. A loja de certificados do sistema
         possivelmente precise estar configurada com
         <xref role='required' linkend='make-ca'/> antes de se construir
         esse pacote.</para></note>">

<!ENTITY test-use-internet
         "<note><para>Uma conexão com Internet é necessária para alguns
         testes desse pacote. A loja de certificados do sistema
         possivelmente precise estar configurada com
         <xref role='optional' linkend='make-ca'/> antes da testagem
         desse pacote.</para></note>">

<!ENTITY logind
         "<phrase revision='sysv'><xref linkend='elogind'/></phrase>
          <phrase revision='systemd'><xref linkend='systemd'/></phrase>">

<!ENTITY build-wheel-cmd "pip3 wheel -w dist --no-build-isolation --no-deps
--no-cache-dir"> <!ENTITY build-wheel "<screen><userinput>&build-wheel-cmd;
$PWD</userinput></screen>">

<!ENTITY install-wheel "pip3 install --no-index --find-links dist
--no-user">

<!ENTITY berkeley-db "<ulink
url='https://anduin.linuxfromscratch.org/BLFS/bdb/db-5.3.28.tar.gz'>Berkeley
DB</ulink> (obsoleto)">

<!ENTITY gobject-introspection "<xref linkend='glib2'/> (com GObject
Introspection)">

<!ENTITY github-lfs-fork "<note><para>No GitHub, nós bifurcamos o
repositório do fluxo de desenvolvimento em nosso próprio espaço de nomes do
<literal>lfs-book</literal> e recriamos uma etiqueta para o lançamento. Isso
foi feito para garantir que o nome do arquivo do tarball baixado esteja
correto e consistente (ou seja, ele não deveria mudar ao se usar o navegador
em vez de uma ferramenta como <command>wget</command>). Nossa etiqueta e a
etiqueta de lançamento do fluxo de desenvolvimento estão na mesma submissão,
de forma que não introduzimos nenhuma mudança no conteúdo do tarball, exceto
o nome do diretório dele de nível superior (que o Git não
rastreia).</para></note>">
