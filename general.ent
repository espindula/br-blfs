<!-- End special entities about LFS compatibility -->

<!ENTITY as_root "<note><para>Quando instalar múltiplos pacotes em um
conjunto de comandos sequenciais, a instalação precisa ser feita como
o(a) usuário(a) root. Existem três opções gerais que podem ser usadas
para se fazer isso:</para>

  <orderedlist>

  <listitem><para>Executar o conjunto inteiro de comandos sequenciais
  como o(a) usuário(a) root (não recomendado).</para></listitem>

  <listitem><para>Usar o comando <command>sudo</command> oriundo do
  pacote <xref linkend='sudo'/>.</para></listitem>

  <listitem><para>Usar
<command>su -c &quot;argumentos do comando&quot;</command> (aspas exigidas),
  que solicitará a senha do(a) root para cada interação do
  loop.</para></listitem>

  </orderedlist>

  <para>Uma maneira de se lidar com essa situação é a de se criar uma
  função curta do <command>bash</command> que selecione automaticamente
  o método apropriado. Uma vez que o comando esteja configurado no
  ambiente, ele não precisa ser configurado novamente.</para>

  <screen><userinput>as_root()
{
  if   [ $EUID = 0 ];        then $*
  elif [ -x /usr/bin/sudo ]; then sudo $*
  else                            su -c \\&quot;$*\\&quot;
  fi
}

export -f as_root</userinput></screen>
</note>">

<!ENTITY not-katamari "<para>Esse pacote é fornecido para testar a
instalação completa do Xorg.</para>">

<!ENTITY % package-entities SYSTEM      "packages.ent">
%package-entities;

<!ENTITY parallel_issues "<note><para>Esse pacote ocasionalmente pode
falhar ao se construir com múltiplos processadores. Veja-se
<xref linkend='parallel-builds'/> para mais informações.</para></note>">

<!ENTITY shell-env "<note><para>Se instalar no ambiente chroot,
certifique-se de exportar a variável de ambiente <envar>SHELL</envar> ou
a configuração do pacote falhará.</para></note>">

<!ENTITY gi-doc-disable
         "Permite construir esse pacote sem <xref linkend='gi-docgen'/>
         instalado. Se você tiver <xref linkend='gi-docgen'/> instalado
         e desejar reconstruir e instalar a documentação da API, um
         comando <command>meson configure</command> reconfigurará essa
         opção.">

<!ENTITY build-use-internet
         "<note><para>Uma conexão com a Internet é necessária para
         construir esse pacote.</para></note>">

<!ENTITY test-use-internet
         "<note><para>Uma conexão com a Internet é necessária para
         alguns testes desse pacote.</para></note>">

<!ENTITY logind
         "<phrase revision='sysv'><xref linkend='elogind'/></phrase>
          <phrase revision='systemd'><xref linkend='systemd'/></phrase>">

<!ENTITY qt5-deps "<xref linkend='qt5-components'/>">

<!ENTITY build-wheel-cmd "pip3 wheel -w dist --no-build-isolation --no-deps --no-cache-dir">
<!ENTITY build-wheel "<screen><userinput>&build-wheel-cmd; $PWD</userinput></screen>">

<!ENTITY install-wheel "pip3 install --no-index --find-links=dist --no-cache-dir --no-user">

