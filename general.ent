<!-- Editar até a linha do ==== deveria ser suficiente para gerar um
     livro para desenvolvimento, lançamento ou rc-->
<!ENTITY % development "IGNORE"><!-- configurar para INCLUDE para 
desenvolvimento; configurar para IGNORE para lançamento ou rc -->
<!ENTITY % release "INCLUDE"> <!-- configurar para INCLUDE para 
lançamento; configurar para IGNORE para desenvolvimento ou rc -->
<!ENTITY % relyear    "2024">
<!ENTITY % relnum     "12.1">
<!ENTITY % reldate    "1º de março de 2024">
<!ENTITY % relpubdate "2024-03-01">
<!-- ================================================================== -->
<!-- Não mude nada abaixo, a menos que os esquemas www ou livro mudem -->

<!-- Gerado automaticamente pelo git-version.sh. Usado para lançamento 
ou desenvolvimento -->
<!ENTITY % conditional-entities SYSTEM "conditional.ent">
%conditional-entities;

<![ %development; [
<!-- informação de versão gerada automaticamente pelo git -->
<!ENTITY % version-entities SYSTEM "version.ent">
%version-entities;
<![ %sysv; [
<!ENTITY lfs-version   "development">
<!ENTITY blfs-version  "svn">
<!ENTITY patch-version "svn">
]]>
<![ %systemd; [
<!ENTITY lfs-version   "systemd">
<!ENTITY blfs-version  "systemd">
<!ENTITY patch-version "svn">
]]>
]]><!-- Fim %development -->

<![ %release; [
<![ %sysv; [
<!ENTITY lfs-version   "%relnum;">
<!ENTITY blfs-version  "%relnum;">
<!ENTITY patch-version "%relnum;">
]]>
<![ %systemd; [
<!ENTITY lfs-version   "%relnum;-systemd">
<!ENTITY blfs-version  "%relnum;-systemd">
<!ENTITY patch-version "%relnum;">
]]>

<!ENTITY year           "%relyear;">
<!ENTITY version        "%relnum;">
<!ENTITY releasedate    "%reldate;">
<!ENTITY pubdate        "%relpubdate;">
]]><!-- Fim %release -->

