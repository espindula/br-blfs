  <sect2 role="package">
    <title>Introdução ao Balsa</title>

    <para>
      O pacote <application>Balsa</application> contém um cliente leve de
mensagens baseado em <application>GTK+</application>.
    </para>

    &lfs124_checked;

    <bridgehead renderas="sect3">Informação do Pacote</bridgehead>
    <itemizedlist spacing="compact">
      <listitem>
        <para>
          Transferência (HTTP): <ulink url="&balsa-download-http;"/>
        </para>
      </listitem>
      <listitem>
        <para>
          Transferência (FTP): <ulink url="&balsa-download-ftp;"/>
        </para>
      </listitem>
      <listitem>
        <para>
          Soma de verificação MD5 da transferência: &balsa-md5sum;
        </para>
      </listitem>
      <listitem>
        <para>
          Tamanho da transferência: &balsa-size;
        </para>
      </listitem>
      <listitem>
        <para>
          Espaço em disco estimado exigido: &balsa-buildsize;
        </para>
      </listitem>
      <listitem>
        <para>
          Tempo de construção estimado: &balsa-time;
        </para>
      </listitem>
    </itemizedlist>



