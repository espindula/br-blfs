  <sect2 role="content">
    <title>Conteúdo</title>

    <segmentedlist>
      <segtitle>Aplicativos Instalados</segtitle>
      <segtitle>Bibliotecas Instaladas</segtitle>
      <segtitle>Diretórios Instalados</segtitle>

      <seglistitem>
        <seg>
          gimp-2.99, gimp-console-2.99, gimptool-2.99, gimp-test-clipboard-2.99 e
gimp-script-fu-interpreter-3.0
        </seg>
        <seg>
          libgimp-3.0.so, libgimp-scriptfu-3.0, libgimpbase-3.0.so,
libgimpcolor-3.0.so, libgimpconfig-3.0.so, libgimpmath-3.0.so,
libgimpmodule-3.0.so, libgimpui-3.0.so e libgimpwidgets-3.0.so
        </seg>
        <seg>
          /etc/gimp, /usr/include/gimp-3.0, /usr/lib/gimp-3.0, /usr/lib/gimp/3.0,
